	<queryString>
		<![CDATA[select
bool_or(a.lulus) as lulus,
max(c.no_ijazah1) as no_ijazah1,
max(c.nama) as nama_mahasiswa,
max(e.nama) as nama_fakultas,
max(c.tempatlahir) as tempatlahir,
max(c.waktu_kuliah) as waktu_kuliah,
max(c.nim) as nim,
max(c.tempatlahir) || ', ' || max(c.tanggallahir) as tanggal_lahir,
max(c.kelamin) as kelamin,
max(c.tahunangkatan)  as tahunmasuk,
max(g.nama) as jenjang,
max(d.nama) as nama_jurusan,
max(f.kode) as kode_matakuliah,
max(f.nama) as nama_matakuliah,
max(f.sks) as sks,
min(a.nilai_huruf) as nilai_huruf,
max(a.nilai_ip) as nilai_ipk,
max(a.total_nilai) as total_nilai,
max(c.tanggal_lulus) as tanggal_lulus,
max(l.judul) as judul,
max(l1.nama) as pembimbing1,
max(l2.nama) as pembimbing2,
max(a.semester) as semester,
max(d.no_sk_akreditasi) as no_sk_akreditasi,
max(d.nama) as nama_jurusan,
case when upper(trim(min(a.nilai_huruf))) = 'A' or upper(trim(min(a.nilai_huruf))) = 'B' or upper(trim(min(a.nilai_huruf))) = 'C' then 'LULUS' else 'TIDAK LULUS' end as status,


case when max(a.semester) % 2 = 0 then ((max(c.tahunangkatan)-(max(c.pindahkekampusinimasuksemester)/2))+(max(a.semester/2)-1)) || '/' || ((max(c.tahunangkatan)-(max(c.pindahkekampusinimasuksemester)/2))+(max(a.semester/2))) else ((max(c.tahunangkatan)-(max(c.pindahkekampusinimasuksemester)/2))+(max((a.semester+1)/2)-1)) || '/' || ((max(c.tahunangkatan)-(max(c.pindahkekampusinimasuksemester)/2))+(max((a.semester+1)/2))) end as tahun_ajaran,



max(c.tahunangkatan)  as tahunangkatan,
max(d1.nama) as dosen_pa,
max(d1.code) as nip_dosen_pa,
max(c.program) as program,
max(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
max(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
max(case when j.code is null then k.nip else i.code end) as nip_dekan,
max(case when j.nama is null then k.nama else i.nama end) as nama_dekan

from mahasiswa c
left join dosen d1 on (c.dosen = d1.id)
left join skripsi l on (c.id = l.mahasiswa)
left join dosen l1 on (l.pembimbing = l1.id)
left join dosen l2 on (l.pembimbing2 = l2.id)
left join detailperkuliahan a  on (a.mahasiswa = c.id)
left join perkuliahan b on (a.perkuliahan = b.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join
(
	select aa.id as id,
	max(case when cc.id is null then aa.kode else cc.kode end) as kode,
	max(case when cc.id is null then aa.nama else cc.nama end) as nama,
	max(case when cc.id is null then aa.sks else cc.sks end) as sks
	from matakuliah aa
	left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
	left join matakuliah cc on(bb.matakuliah = cc.id) where (aa.extrakulikuler is null or aa.extrakulikuler = false)
	group by aa.id
) f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
left join jenjang g on (g.id = c.jenjang)
left join (
	select aa.nama, aa.nip, aa.jurusan
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kaprodi%'
) h on (h.jurusan = c.jurusan)
left join dosen i on (d.kaprodi = i.id)
left join dosen j on (e.dekan = j.id)
left join (
	select aa.nama, aa.nip, aa.fakultas
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%dekan%'
) k on (k.fakultas = e.id)
where a.mahasiswa = $P{mahasiswa}
	and a.id in (select max(aaa.id) from detailperkuliahan aaa left join perkuliahan bbb on (aaa.perkuliahan=bbb.id) inner join matakuliah ccc on (ccc.id=bbb.matakuliah or aaa.matakuliah_konversi=ccc.id) where aaa.mahasiswa = $P{mahasiswa} and aaa.persetujuan = 1 group by ccc.kode)
and a.semester >= 0 and a.total_nilai >= 1.0 and a.total_nilai is not null and a.nilai_huruf is not null and trim(a.nilai_huruf) != ''
and a.persetujuan = 1 and a.ikuti_perkuliahan is null
group by f.id
order by semester ]]>
	</queryString>

	<parameter name="qr_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
a.nim,
a.nama,
a.telp,
a.email,
b.nama as jurusan,
f.nama as nama_fakultas,
ff.nama as nama_perguruan_tinggi,
ff.alamat1,
ff.alamat2,
ff.telepon,
ff.faksimili,
a.nama as kelas

from mahasiswa a
left join jurusan b on (a.jurusan = b.id)
inner join fakultas f on (b.fakultas = f.id)
left join perguruan_tinggi ff on (f.perguruan_tinggi = ff.id)
where a.id = $P{mahasiswa}]]>
	</queryString>

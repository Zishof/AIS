	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
d.KelompokNama,
e.KelompokSubKode,
e.KelompokSubNama,
c.FormasiNama,
c.FormasiKode,
f.JenjangDidikNama,
g.KualifikasiPendidikanKode,
g.KualifikasiPendidikanNama,
sum((case a.PesertaJenisKelamin when 'L' then 1 else 0 end)) as jumlahLaki,
sum((case a.PesertaJenisKelamin when 'P' then 1 else 0 end)) as jumlahPerempuan,
count(a.PesertaSekolahTertinggiJenjang) as jumlahTotal,
max(aa.jumlahLaki) as totalLaki,
max(aa.jumlahPerempuan) as totalPerempuan,
max(aa.jumlahTotal) as totalTotal
FROM tbmPelamar as a
INNER JOIN tbtFormasi as b on(a.PesertaKodeKelompol = b.FormasiKode)
INNER JOIN tbrLowongan as c on (b.FormasiLowonganKode = c.FormasiKode)
INNER JOIN tbrLowonganKelompok as d on (c.FormasiKelompok = d.KelompokKode)
INNER JOIN tbrLowonganKelompokSub as e on (c.FormasiKelompokSub = e.KelompokSubKode)
INNER JOIN tbrKualifikasiPendidikan g on (b.FormasiKualifikasiPendidikanKode = g.KualifikasiPendidikanKode)
INNER JOIN tbrJenjangPendidikan as f on (a.PesertaSekolahTertinggiJenjang = f.JenjangDidikKode)
, (
	SELECT
	sum((case a.PesertaJenisKelamin when 'L' then 1 else 0 end)) as jumlahLaki,
	sum((case a.PesertaJenisKelamin when 'P' then 1 else 0 end)) as jumlahPerempuan,
	count(a.PesertaSekolahTertinggiJenjang) as jumlahTotal
	FROM tbmPelamar as a
) as aa


GROUP BY d.KelompokNama, e.KelompokSubKode, e.KelompokSubNama, c.FormasiNama, c.FormasiKode, f.JenjangDidikNama, g.KualifikasiPendidikanKode, g.KualifikasiPendidikanNama
ORDER BY d.KelompokNama, e.KelompokSubKode, e.KelompokSubNama, c.FormasiNama, c.FormasiKode, f.JenjangDidikNama, g.KualifikasiPendidikanKode, g.KualifikasiPendidikanNama]]>
	</queryString>

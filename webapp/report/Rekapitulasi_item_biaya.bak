		 bottomMargin="20"
		 whenNoDataType="AllSectionsNoDetail"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="df" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer("1")]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" isForPrompting="true" class="java.lang.String"/>
	<parameter name="logo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="item_biaya" isForPrompting="true" class="java.lang.String"/>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select b.nim,b.nama,b.tahunangkatan,a.tahun_akademik,a.semster,c.nama as nama_jurusan,d.nama as nama_fakultas,a.program,
	e.nama as nama_item_biaya

from kegiatan a
left join mahasiswa b on a.mahasiswa=b.id
left join jurusan c on b.jurusan=c.id
left join fakultas d on c.fakultas=d.id
left join detail_biaya f on b.jurusan = f.jurusan and c.fakultas = f.fakultas
left join item_biaya e on f.item_biaya = e.id
left join jenis_kegiatan_detail g on b.jurusan = g.jurusan and c.fakultas = g.fakultas
left join jenis_kegiatan h on h.id = g.jenis_kegiatan

where a.mahasiswa=b.id and h.nama_kegiatan = $P{item_biaya}]]></queryString>


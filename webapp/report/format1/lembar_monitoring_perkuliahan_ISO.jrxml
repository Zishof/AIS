	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Jakarta"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="perkuliahan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[436L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.pertemuan_ke,
a.tanggal,
a.waktu_mulai || '-' || a.waktu_selesai as waktu,
a.topik as materi,
a.metode_pembelajaran as metode,
'' as paraf,
b.ganjil_genap as jenis_semester,
c.nama as nama_dosen,
c.code as code_dosen,
d.nama as matakuliah,
e.nama as jur,
d.sks,
trim((case when a.buku_rujukan1 is not null or trim(a.buku_rujukan1) != '' then a.buku_rujukan1 || ' ' else '' end) || (case when a.buku_rujukan2 is not null or trim(a.buku_rujukan2) != '' then a.buku_rujukan2 else '' end)) as buku_rujukan,
e.nama as nama_jurusan,
f.nama as fakultas,
b.*,g.kode_ruangan,
max(case when i.code is null then h.nip else i.code end) as nip_kaprodi,max(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi

from pertemuan a
inner join perkuliahan b on (a.perkuliahan = b.id)
left join dosen c on (b.dosen1 = c.id)
left join matakuliah d on (b.matakuliah = d.id)
left join jurusan e on e.id = b.jurusan
left join fakultas f on f.id = e.fakultas
left join ruang g on b.ruang=g.id
left join (
	select aa.nama, aa.nip, aa.jurusan
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kaprodi%'
) h on (h.jurusan = c.jurusan)
left join dosen i on (e.kaprodi = i.id)

where a.perkuliahan = $P{perkuliahan}
group by a.pertemuan_ke,a.tanggal,a.waktu_mulai,a.waktu_selesai,a.topik,a.metode_pembelajaran,b.semester,c.nama,c.code,d.nama,d.sks,a.buku_rujukan1,a.buku_rujukan2,e.nama,f.nama,b.id,g.kode_ruangan,b.hari
order by a.pertemuan_ke,a.tanggal]]>
	</queryString>

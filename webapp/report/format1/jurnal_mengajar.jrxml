	<summary>
		<band height="250" splitType="Stretch">
			<!-- Info lokasi (kanan atas) -->
			<staticText>
				<reportElement x="494" y="8" width="120" height="16" uuid="dd100001-0000-0000-0000-000000000001"/>
				<textElement><font size="9"/></textElement>
				<text><![CDATA[DITETAPKAN DI]]></text>
			</staticText>
			<textField>
				<reportElement x="614" y="8" width="198" height="16" uuid="dd100002-0000-0000-0000-000000000001"/>
				<textElement><font size="9"/></textElement>
				<textFieldExpression><![CDATA[": " + ($P{label_kota} == null ? "" : $P{label_kota}.toUpperCase())]]></textFieldExpression>

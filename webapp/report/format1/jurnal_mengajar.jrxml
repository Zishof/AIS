<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="jurnal_mengajar" language="groovy" pageWidth="842" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="812" leftMargin="15" rightMargin="15" topMargin="15" bottomMargin="15" uuid="74372a88-aa5c-415c-bc73-53cb6abdb1cd">
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Jakarta"]]></defaultValueExpression>
	</parameter>
	<parameter name="perkuliahan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[436L]]></defaultValueExpression>
	</parameter>
	<parameter name="paralelId" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pertemuans" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.id as pertemuan_id,
a.pertemuan_ke,
a.tanggal,
(case
	when coalesce(trim(a.topik), '') = '' then coalesce(a.indikator, '')
	when coalesce(trim(a.indikator), '') = '' then a.topik
	else a.topik || chr(10) || chr(10) || a.indikator
end) as indikator,
b.capaianpembelajaranprodi,
b.deskripsipembelajaran,
COALESCE(a.waktu_mulai,'') || CASE WHEN a.waktu_mulai IS NOT NULL AND a.waktu_selesai IS NOT NULL THEN '-' ELSE '' END || COALESCE(a.waktu_selesai,'') as waktu,
coalesce(nullif(trim(a.buku_rujukan1), ''), '') as materi,
a.metode_pembelajaran as metode,
a.waktupembelajaran,
'' as paraf,
b.ganjil_genap as jenis_semester,
(case when c.nama is null then '' else c.nama end)
|| (case when c2.nama is null then '' else ', '||c2.nama end)
|| (case when c3.nama is null then '' else ', '||c3.nama end)
|| (case when c4.nama is null then '' else ', '||c4.nama end)
|| (case when c5.nama is null then '' else ', '||c5.nama end)
as nama_dosen,
c.code as code_dosen,
d.nama as matakuliah,
d.sks,
(case when a.buku_rujukan1 is not null or trim(a.buku_rujukan1) != '' then a.buku_rujukan1 || ' ' else '' end) as buku_rujukan,
(case when a.buku_rujukan2 is not null or trim(a.buku_rujukan2) != '' then a.buku_rujukan2 else '' end) as buku_ref,
e.nama as nama_jurusan,
f.nama as fakultas,
b.tahun_ajaran,
b.kelas,
i.nidn as nip_kaprodi,
i.nama as nama_kaprodi,
a.pengalamanbelajar,
a.tugasdanpenilaian,
c.nidn, b.tanggalmulaiperkuliahan, i.nidn as nidn_kaprodi, c.nidn as nidn_dosen, c.nama as nama_dosen1

from pertemuan a
inner join perkuliahan b on (a.perkuliahan = b.id)
left join dosen c on (b.dosen1 = c.id)
left join dosen c2 on (b.dosen2 = c2.id)
left join dosen c3 on (b.dosen3 = c3.id)
left join dosen c4 on (b.dosen4 = c4.id)
left join dosen c5 on (b.dosen5 = c5.id)
left join matakuliah d on (b.matakuliah = d.id)
left join jurusan e on e.id = b.jurusan
left join fakultas f on f.id = e.fakultas
left join dosen i on (e.kaprodi = i.id)

where (a.perkuliahan = $P{perkuliahan} or
case when $X{IN,-1,paralelId} then  false else $X{IN,a.perkuliahan,paralelId} end)
and case when $X{IN,-1,pertemuans} then false else $X{IN,a.id,pertemuans} end
order by a.tanggal nulls last,coalesce(a.waktu_mulai,''),a.pertemuan_ke nulls last,a.id]]>
	</queryString>

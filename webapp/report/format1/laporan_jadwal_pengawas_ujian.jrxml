	<queryString>
		<![CDATA[select
a2.tanggal as hari,
a2.waktu_mulai || '-' || a2.waktu_selesai as waktu,
a.semester,
case when a1.kode_ruangan is null then a1.nama else a1.kode_ruangan end as ruang,
b.nama,
(case when b1.id is null then b.golongan else b1.nama || '/' || b.golongan end) as golongan,
c.nama as matakuliah,
c.kode as kode_matakuliah,
c.sks,
a.kelas,
(case a.semester%2 when 1 then 'Ganjil' else 'Genap' end) as jenis_semester,
a.tahun_ajaran,
e.nama as fakultas,
d.nama as jurusan,
f.nama as petugas

from perkuliahan a
left join (
	select max(tanggal) as tanggal, max(waktu_mulai) as waktu_mulai, max(waktu_selesai) as waktu_selesai,max(ruang) as ruang,perkuliahan,max(petugas) as petugas,max(petugas2) as petugas2,max(petugas3) as petugas3 from pertemuan where status_pertemuan = $P{id_jenis_ujian} group by perkuliahan
) a2 on (a.id = a2.perkuliahan)
left join ruang a1 on (a1.id = a2.ruang)
left join dosen b on (a.dosen1 = b.id)
left join jabatan b1 on (b.spesifikasi_jabatan = b1.id)
left join matakuliah c on (a.matakuliah = c.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)
left join pegawai f on (a2.petugas=f.id or a2.petugas2=f.id or a2.petugas3=f.id)

where f.id is not null
and case  $P{semester} when '-1' then true else a.ganjil_genap=$P{semester} end
and case $P{tahun_akademik} when '-1' then true else a.tahun_ajaran = $P{tahun_akademik} end
and case $P{jurusan} when -1 then true else a.jurusan = $P{jurusan} end
and case $P{fakultas} when -1 then true else a.jurusan in (select id from jurusan where fakultas = $P{fakultas}) end
order by a2.tanggal,
to_number(a2.waktu_mulai,'99999,99'),to_number(a2.waktu_selesai,'99999,99'),f.nama,c.nama]]>
	</queryString>

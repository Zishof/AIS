	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Jakarta"]]></defaultValueExpression>
	</parameter>
	<parameter name="kelas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="masa_perkuliahan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="semester_pendek" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="ekstrakurikuler" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
(b.id) as id,
(b.nama) as nama,
(case when b1.id is null then b.golongan else b1.nama || '/' || b.golongan end) as golongan,
c.nama as matakuliah,
c.kode as kode_matakuliah,
c.sks,
(a.kelas) as kelas,
(case a.semester%2 when 1 then 'Ganjil' else 'Genap' end) as jenis_semester,
(a.tahun_ajaran) as tahun_ajaran,
(e.nama) as fakultas,
(d.nama) as jurusan,
((select count(*) from detailperkuliahan where perkuliahan=a.id and persetujuan=1)) as qty,
(a.jumlahdosen) as qty_dosen

from perkuliahan a
left join dosen b on (a.dosen1 = b.id or a.dosen2 = b.id or a.dosen3 = b.id or a.dosen4 = b.id or a.dosen5 = b.id or a.dosen6 = b.id or a.dosen7 = b.id or a.dosen8 = b.id or a.dosen9 = b.id or a.dosen10 = b.id)
left join jabatan b1 on (b.spesifikasi_jabatan = b1.id)
left join matakuliah c on (a.matakuliah = c.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)

where b.id is not null
and case  $P{semester} when '-1' then true else a.ganjil_genap=$P{semester} end
and case $P{tahun_akademik} when '-1' then true else a.tahun_ajaran = $P{tahun_akademik} end
and case $P{masa_perkuliahan} when -1 then true else a.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then a.status_semesterpendek is null else a.status_semesterpendek = $P{semester_pendek} end
and case $P{ekstrakurikuler} when -1 then c.extrakulikuler = false else c.extrakulikuler end
and case $P{jurusan} when -1 then true else a.jurusan = $P{jurusan} end
and case $P{fakultas} when -1 then true else a.jurusan in (select id from jurusan where fakultas = $P{fakultas}) end
and case when $P{kelas} = '-1' then true else a.kelas ilike $P{kelas} end
order by (b.nama),c.nama]]>
	</queryString>

		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="perkuliahan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[436L]]></defaultValueExpression>
	</parameter>
	<parameter name="paralelId" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pertemuans" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.pertemuan_ke,
a.tanggal,
a.indikator,
b.capaianpembelajaranprodi,
b.deskripsipembelajaran,
a.waktu_mulai || '-' || a.waktu_selesai as waktu,
a.topik as materi,
a.metode_pembelajaran as metode,
a.waktupembelajaran,
'' as paraf,
(case b.semester%2 when 1 then 'Ganjil' else 'Genap' end) as jenis_semester,
c.nama as nama_dosen,
c.code as code_dosen,
d.nama as matakuliah,
d.sks,
(case when a.buku_rujukan1 is not null or trim(a.buku_rujukan1) != '' then a.buku_rujukan1 || ' ' else '' end) as buku_rujukan,
(case when a.buku_rujukan2 is not null or trim(a.buku_rujukan2) != '' then a.buku_rujukan2 else '' end) as buku_ref,
e.nama as nama_jurusan,
f.nama as fakultas,
b.tahun_ajaran,
b.kelas,
i.nidn as nip_kaprodi,
i.nama as nama_kaprodi,
a.pengalamanbelajar,
a.tugasdanpenilaian,
c.nidn, b.tanggalmulaiperkuliahan, i.nidn as nidn_kaprodi, c.nidn as nidn_dosen

from pertemuan a
inner join perkuliahan b on (a.perkuliahan = b.id)
left join dosen c on (b.dosen1 = c.id)
left join matakuliah d on (b.matakuliah = d.id)
left join jurusan e on e.id = b.jurusan
left join fakultas f on f.id = e.fakultas
left join dosen i on (e.kaprodi = i.id)

where (a.perkuliahan = $P{perkuliahan} or
case when $X{IN,-1,paralelId} then  false else $X{IN,a.perkuliahan,paralelId} end)
and case when $X{IN,-1,pertemuans} then false else $X{IN,a.id,pertemuans} end
order by a.tanggal,a.pertemuan_ke]]>
	</queryString>

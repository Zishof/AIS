		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.pertemuan_ke,
a.tanggal,
a.waktu_mulai || '-' || a.waktu_selesai as waktu,
a.metode_pembelajaran as metode,
'' as paraf,
b.ganjil_genap as jenis_semester,
c.id as id_dosen,
c.nama as nama_dosen,
c.code as code_dosen,
d.nama as matakuliah,
d.sks,
trim((case when a.buku_rujukan1 is not null or trim(a.buku_rujukan1) != '' then a.buku_rujukan1 || ' ' else '' end)) as materi,
trim((case when a.buku_rujukan2 is not null or trim(a.buku_rujukan2) != '' then a.buku_rujukan2 else '' end)) as buku_rujukan,
e.nama as nama_jurusan,
f.nama as fakultas,
b.tahun_ajaran,
b.kelas,
i.id as id_kaprodi,
i.code as nip_kaprodi,
i.nama as nama_kaprodi, b.tanggalmulaiperkuliahan, i.nidn as nidn_kaprodi, c.nidn as nidn_dosen

from pertemuan a
inner join perkuliahan b on (a.perkuliahan = b.id)
left join dosen c on (b.dosen1 = c.id)
left join matakuliah d on (b.matakuliah = d.id)
left join jurusan e on e.id = b.jurusan
left join fakultas f on f.id = e.fakultas
left join dosen i on (e.kaprodi = i.id)

where a.perkuliahan = $P{perkuliahan}
and case when $X{IN,-1,pertemuans} then false else $X{IN,a.id,pertemuans} end
order by a.pertemuan_ke,a.tanggal]]>
	</queryString>

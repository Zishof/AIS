			</staticText>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-17" x="3" y="0" width="230" height="20" uuid="2248120b-c8fe-4be1-bf66-3d76f0fa7ef8"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>

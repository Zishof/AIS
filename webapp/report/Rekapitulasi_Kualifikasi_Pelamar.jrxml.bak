<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Rekapitulasi_Kualifikasi_Pelamar"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
d.KelompokNama,
e.KelompokSubKode,
e.KelompokSubNama,
c.FormasiNama,
c.FormasiKode,
g.KualifikasiPendidikanNama,
g.KualifikasiPendidikanKode,
sum((case a.PesertaJenisKelamin when 'L' then 1 else 0 end)) as jumlahLaki,
sum((case a.PesertaJenisKelamin when 'P' then 1 else 0 end)) as jumlahPerempuan,
count(a.PesertaSekolahTertinggiJenjang) as jumlahTotal
FROM tbmPelamar as a
INNER JOIN tbtFormasi as b on(a.PesertaKodeKelompol = b.FormasiKode)
INNER JOIN tbrLowongan as c on (b.FormasiLowonganKode = c.FormasiKode)
INNER JOIN tbrLowonganKelompok as d on (c.FormasiKelompok = d.KelompokKode)
INNER JOIN tbrLowonganKelompokSub as e on (c.FormasiKelompokSub = e.KelompokSubKode)
INNER JOIN tbrJenjangPendidikan as f on (a.PesertaSekolahTertinggiJenjang = f.JenjangDidikKode)
INNER JOIN tbrKualifikasiPendidikan as g on (b.FormasiKualifikasiPendidikanKode = g.KualifikasiPendidikanKode)
GROUP BY d.KelompokNama, e.KelompokSubKode, e.KelompokSubNama, c.FormasiNama, c.FormasiKode, g.KualifikasiPendidikanNama, g.KualifikasiPendidikanKode
ORDER BY d.KelompokNama, e.KelompokSubKode, e.KelompokSubNama, c.FormasiNama, c.FormasiKode, g.KualifikasiPendidikanNama, g.KualifikasiPendidikanKode]]></queryString>

	<field name="KelompokNama" class="java.lang.String"/>
	<field name="KelompokSubKode" class="java.lang.String"/>
	<field name="KelompokSubNama" class="java.lang.String"/>
	<field name="FormasiNama" class="java.lang.String"/>
	<field name="FormasiKode" class="java.lang.String"/>
	<field name="KualifikasiPendidikanNama" class="java.lang.String"/>
	<field name="KualifikasiPendidikanKode" class="java.lang.String"/>
	<field name="jumlahLaki" class="java.lang.Long"/>
	<field name="jumlahPerempuan" class="java.lang.Long"/>
	<field name="jumlahTotal" class="java.lang.Long"/>

	<variable name="jumlahTotalLaki" class="java.lang.Long" resetType="Group" resetGroup="Kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlahLaki}]]></variableExpression>
	</variable>
	<variable name="jumlahTotalPerempuan" class="java.lang.Long" resetType="Group" resetGroup="Kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlahPerempuan}]]></variableExpression>
	</variable>
	<variable name="jumlahTotalSemua" class="java.lang.Long" resetType="Group" resetGroup="Kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlahTotal}]]></variableExpression>
	</variable>
	<variable name="jumlahTotalLakiAll" class="java.lang.Long" resetType="None" calculation="Sum">
		<variableExpression><![CDATA[$V{jumlahTotalLaki}]]></variableExpression>
	</variable>
	<variable name="jumlahTotalPerempuanAll" class="java.lang.Long" resetType="None" calculation="Sum">
		<variableExpression><![CDATA[$V{jumlahTotalPerempuan}]]></variableExpression>
	</variable>
	<variable name="jumlahTotalSemuaAll" class="java.lang.Long" resetType="None" calculation="Sum">

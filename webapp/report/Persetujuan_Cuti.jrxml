				<textFieldExpression><![CDATA["1. Cuti studi diberikan maksimal 2 (dua) semester;\n"+
"2. Selama mengikuti cuti studi tidak dibenarkan mengikuti kegiatan akademik;\n"+
"3. Setelah habis masa cuti studi, yang bersangkutan harus melaporkan sebagai mahasiswa aktif;\n"+
"4. Bila tidak melapor dikenakan sangsi atau pemberhentian dari mahasiswa;\n"]]></textFieldExpression>

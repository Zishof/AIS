				<textFieldExpression><![CDATA["Berdasarkan surat permohonan dari yang bersangkutan tanggal "+(new SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format($F{tanggal}))+" perihal permohonan izin cuti studi, maka "+($P{REPORT_PARAMETERS_MAP}.get( "label_rektor" )==null||$P{REPORT_PARAMETERS_MAP}.get( "label_rektor" ).toString().isEmpty()?"Rektor":$P{REPORT_PARAMETERS_MAP}.get( "label_rektor" ))+" "+$P{REPORT_PARAMETERS_MAP}.get( "label_universitas" )+" memberi izin cuti studi tahun akademik "+$F{tahun_akademik}+" dengan ketentuan:"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField" x="51" y="120" width="485" height="29" uuid="aab6bdd1-d88d-4fb7-a7f0-deff6904621f"/>
				<textFieldExpression><![CDATA["Yang bertanda tangan di bawah ini "+($P{REPORT_PARAMETERS_MAP}.get( "label_rektor" )==null||$P{REPORT_PARAMETERS_MAP}.get( "label_rektor" ).toString().isEmpty()?"Rektor":$P{REPORT_PARAMETERS_MAP}.get( "label_rektor" ))+" "+$P{REPORT_PARAMETERS_MAP}.get( "label_universitas" )+
" menerangkan bahwa :"]]></textFieldExpression>
			</textField>

	<queryString>
		<![CDATA[select a.*,b.nim,b.nama as nama_mahasiswa,c.nama as jur,d.nama as fak from nilai_toefl_toafl_mahasiswa a
left join mahasiswa b on a.mahasiswa=b.id
left join jurusan c on b.jurusan=c.id
left join fakultas d on c.fakultas = d.id

where
case when $P{jenistest} = -1 then true else a.jenis_toefl = $P{jenistest} end
and case when $P{mahasiswa} = -1 then true else b.id = $P{mahasiswa} end
ORDER BY
b.nama,  b.nim]]>
	</queryString>

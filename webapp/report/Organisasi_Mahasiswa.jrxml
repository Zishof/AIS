	<queryString>
		<![CDATA[select
c.nama,
c.tempatlahir,
c.tanggallahir,
c.nim,
c1.nama as jurusan,
b.nama as nama_kegiatan,
a.mulai,
a.sampai,
d.nama as jabatan,
a.keterangan,
ff.nama as dosen_pa,
ff.code as nip_dosen_pa
from organisasi_intra_kampus_punya_mahasiswa a
inner join organisasi_intra_kampus b on (a.organisasi_intra_kampus=b.id)
inner join mahasiswa c on (a.mahasiswa=c.id)
inner join jurusan c1 on (c.jurusan=c1.id)
left join jabatan_organisasi_intra_kampus d on (a.jabatan_organisasi_intra_kampus=d.id)

left join dosen ff on (ff.id = c.dosen)
where c.id=$P{mahasiswa_id}
and a.persetujuan
order by a.mulai ]]>
	</queryString>

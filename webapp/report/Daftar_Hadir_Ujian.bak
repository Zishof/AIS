<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Daftar_Hadir_Ujian"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="35"
		 rightMargin="10"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="perkuliahan" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(7)]]></defaultValueExpression>
	</parameter>
	<parameter name="hari" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Senin"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["20 Desember 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="waktu" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["14.00 - 13.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="ruang" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["B051"]]></defaultValueExpression>
	</parameter>
	<parameter name="pudek_1" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Hj. Harimurti, SH, MH."]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_dibuat" isForPrompting="false" class="java.lang.String"/>
	<parameter name="tampil_nilai" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nip" isForPrompting="false" class="java.lang.String"/>
	<parameter name="jenis_semester" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
(case $P{tampil_nilai} when 1 then ((select aa.jumlah AS jumlah from ((nilai aa join formatnilai bb on((aa.formatnilai = bb.id))) join status_pertemuan cc on((bb.status_pertemuan = cc.id))) where ((aa.detailperkuliahan = b.id) and (cc.nama = 'UTS')))) else null end) AS nilai,

e.nim AS nim,
e.nama AS nama,
c.nama as dosen,
c.nidn as nidn_dosen,
d.kode as kode_matakuliah,
d.nama as nama_matakuliah,
a.ruang,a.dosen1 as dsnay,
d.sks,
(case (a.semester % 2) when 0 then 'Genap' else 'Ganjil' end) AS jenis_semester,
a.tahun_ajaran AS tahun_ajaran,
h.nama AS fakultas,
g.nama as jurusan,
a.semester,
j.nama as jenjang,
a.kelas

from perkuliahan a
left join detailperkuliahan b on (a.id = b.perkuliahan)
left join dosen c on (c.id = a.dosen1)
left join matakuliah d on (d.id = a.matakuliah)
left join mahasiswa e on b.mahasiswa = e.id 
left join jurusan g on g.id = a.jurusan 
left join fakultas h on g.fakultas = h.id 
left join jenjang j on e.jenjang = j.id

where a.id = $P{perkuliahan}
and b.persetujuan = 1
-- group by e.id
order by e.nim]]></queryString>


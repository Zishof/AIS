	<queryString>
		<![CDATA[select
c.nama,
c.tempatlahir,
c.tanggallahir,
c.nim,
c1.nama as jurusan,
d.nama as kelompok_kegiatan_kemahasiswaan,
sum(h.nilai) nilai,
d.bobot,
d.nilaiminimal,
max(ff.nama) as dosen_pa,
max(ff.code) as nip_dosen_pa
from kegiatan_kemahasiswaan_punya_mahasiswa a
inner join kegiatan_kemahasiswaan b on (a.kegiatan_kemahasiswaan=b.id)
inner join mahasiswa c on (a.mahasiswa=c.id)
inner join jurusan c1 on (c.jurusan=c1.id)
inner join kelompok_kegiatan_kemahasiswaan d on (b.kelompok_kegiatan_kemahasiswaan=d.id)
inner join detail_kelompok_kegiatan_kemahasiswaan e on (e.id=b.detail_kelompok_kegiatan_kemahasiswaan)
left join jabatan_kegiatan_kemahasiswaan f on (f.id=a.jabatan_kegiatan_kemahasiswaan)
inner join skala_kegiatan_kemahasiswaan g on (g.id=a.skala_kegiatan_kemahasiswaan)
left join nilai_kegiatan_kemahasiswaan h on (h.skala_kegiatan_kemahasiswaan=a.skala_kegiatan_kemahasiswaan and (case when a.jabatan_kegiatan_kemahasiswaan is not null then h.jabatan_kegiatan_kemahasiswaan=a.jabatan_kegiatan_kemahasiswaan else a.jabatan_kegiatan_kemahasiswaan is null end) and h.detail_kelompok_kegiatan_kemahasiswaan=b.detail_kelompok_kegiatan_kemahasiswaan)

left join dosen ff on (ff.id = c.dosen)
where c.id=$P{mahasiswa_id}
and b.status='Disetujui' and a.persetujuan
and d.aktif
and e.aktif
group by c1.id,c.id,d.id]]>
	</queryString>

	<property name="ireport.zoom" value="1.4641000000000035"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_mahasiswa" class="java.lang.Long"/>
	<parameter name="id_pkl" class="java.lang.Long"/>
	<parameter name="logo1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a.mahasiswa,b.nim as nim, b.nama as nama,c.nama as pkl,
a.tanggal_daftar,e.nama as nama_kelompok,case when d.diterima then 'Disetujui' else 'Belum Disetujui' end as status_pendaftaran

FROM mahasiswa_daftar_pkl a
left JOIN mahasiswa b on a.mahasiswa=b."id"
left join pkl c on a.pkl = c."id"
left join mahasiswa_dapat_kelompok_kelompok_pkl d on (d.mahasiswa=a.mahasiswa)
left join kelompok_pkl e on (e.id=d.kelompok_pkl and e.pkl=a.pkl)

where b.id = $P{id_mahasiswa}
and c.id = $P{id_pkl}]]>
	</queryString>
	<field name="mahasiswa" class="java.lang.Long"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="pkl" class="java.lang.String"/>
	<field name="tanggal_daftar" class="java.sql.Timestamp"/>
	<field name="nama_kelompok" class="java.lang.String"/>
	<field name="status_pendaftaran" class="java.lang.String"/>

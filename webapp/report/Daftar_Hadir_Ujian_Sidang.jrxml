	</parameter>
	<parameter name="fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_ajaran" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2009/2010"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2009-12-30"]]></defaultValueExpression>
	</parameter>
	<parameter name="konsentrasi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="hari_dan_tanggal" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Rabu, 22 Desember 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_dibuat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["22 Juni 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="pudek1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
(case $P{konsentrasi} when -1 then '-' else d.nama end) as konsentrasi,
a.waktu_sidang || ' - ' || a.waktu_sampai_sidang as waktu,
b.nim,
b.nama,
c.nama as pembimbing
from skripsi a
left join mahasiswa b on (a.mahasiswa = b.id)
left join dosen c on (a.pembimbing = c.id)
left join konsentrasi d on (d.id = b.konsentrasi)
where b.konsentrasi = (case $P{konsentrasi} when -1 then b.konsentrasi else $P{konsentrasi} end)
and date(a.tanggal_sidang) = date($P{tanggal})]]>
	</queryString>
	<field name="konsentrasi" class="java.lang.String"/>
	<field name="waktu" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="pembimbing" class="java.lang.String"/>

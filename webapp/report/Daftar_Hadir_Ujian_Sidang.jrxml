				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["DAFTAR HADIR UJIAN SIDANG SKRIPSI TAHUN AKADEMIK "+$P{tahun_ajaran}.toUpperCase()+" "+$P{jenis_semester}.toUpperCase()]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">

	<field name="sks" class="java.lang.Integer"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="lulus" class="java.lang.Object"/>
	<field name="nilai_ipk" class="java.lang.Long"/>
	<field name="skn" class="java.lang.Long"/>
	<field name="kumulatifSKS" class="java.math.BigDecimal"/>
	<field name="kumulatifSKN" class="java.math.BigDecimal"/>
	<field name="kumulatifIPK" class="java.math.BigDecimal"/>
	<field name="nilaiIPK" class="java.math.BigDecimal"/>
	<variable name="jumlah_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="jumlah_skn" class="java.lang.Long" calculation="Sum">

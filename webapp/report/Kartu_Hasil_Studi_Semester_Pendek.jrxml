	<style name="StatusLulusMerah">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{lulus} != null && (Boolean.FALSE.equals($F{lulus}) || "TIDAK LULUS".equalsIgnoreCase(String.valueOf($F{lulus}).trim()) || "TIDAK".equalsIgnoreCase(String.valueOf($F{lulus}).trim()) || "FALSE".equalsIgnoreCase(String.valueOf($F{lulus}).trim()) || "0".equals(String.valueOf($F{lulus}).trim()))]]></conditionExpression>
			<style forecolor="#D32F2F" isBold="true"/>
		</conditionalStyle>
	</style>
	<parameter name="logo" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_ajaran" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2009/2010"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false"/>
	<parameter name="tanggal" class="java.lang.String" isForPrompting="false"/>
	<parameter name="pembantu_dekan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Nursva. A. SH. MH."]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="nip" class="java.lang.String" isForPrompting="false"/>
	<parameter name="kaprodi" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
(cc.lulus) as lulus,
c.nama as nama_mahasiswa,
e.nama as nama_fakultas,
c.waktu_kuliah,
c.nim,
d.nama as nama_jurusan,
(14-$P{semester}) as sisa_masa_studi,
f.kode as kode_matakuliah,
f.nama as nama_matakuliah,
f.sks,
a.nilai_huruf,
a.total_nilai,
a.nilai_ip as nilai_ipk,
(select sum(aa.sks) as kumulatifSKS from matakuliah aa inner join perkuliahan bb on (aa.id = bb.matakuliah) inner join detailperkuliahan cc on (cc.perkuliahan = bb.id) where cc.mahasiswa = $P{mahasiswa} and cc.semester = $P{semester}) as kumulatifSKS,
(select sum(cc.nilai_ip*aa.sks)/sum(aa.sks) as kumulatifIPK from matakuliah aa inner join perkuliahan bb on (aa.id = bb.matakuliah) inner join detailperkuliahan cc on (cc.perkuliahan = bb.id) where cc.mahasiswa = $P{mahasiswa} and cc.semester = $P{semester}) as nilaiIPK

from detailperkuliahan a
left join perkuliahan b on (a.perkuliahan = b.id)
left join mahasiswa c on (a.mahasiswa = c.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join matakuliah f on (f.id = b.matakuliah)

where a.mahasiswa = $P{mahasiswa}
and b.ganjil_genap = $P{semester}]]>
	</queryString>

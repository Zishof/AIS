	<queryString>
		<![CDATA[select
juara,nama,tempat,penyelenggara,tanggal,nomorsertifikat

from prestasi_mahasiswa a
where a.mahasiswa=$P{mahasiswa_id}
and status='Disetujui']]>
	</queryString>

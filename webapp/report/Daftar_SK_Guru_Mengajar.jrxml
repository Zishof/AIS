	<queryString>
		<![CDATA[select
c.id as guruid,
a.waktu_mulai,
a.waktu_selesai,
b.nama as mk,
c.nama as guru,
c.pangkat,
a.semester,
b.sks,
a.kelas,
cc.nama as ruang,
e.nama as yayasan,
a.hari,
(case when z.hari is not null then  z.hari||', '||z.waktu_mulai||'-'||z.waktu_selesai else '' end) as paralel,
z.id as id_paralel,
zz.peserta
from perkuliahan a
left join matakuliah b on (a.matakuliah = b.id)
left join ruang cc on (a.ruang = cc.id)
inner join guru c on (a.guru1 = c.id or a.guru2 = c.id  or a.guru3 = c.id  or a.guru4 = c.id  or a.guru5 = c.id  or a.guru6 = c.id  or a.guru7 = c.id  or a.guru8 = c.id  or a.guru9 = c.id or a.guru10 = c.id)
left join sekolah d on (d.id = a.sekolah)
left join yayasan e on (e.id = d.yayasan)
left join kurikulum_punya_matakuliah dd on (dd.id=a.kurikulum_punya_matakuliah)
left join perkuliahan z on (z.perkuliahan_paralel=a.id)
left join (select count(*) as peserta, zz.perkuliahan from detailperkuliahan zz where zz.perkuliahan is not null group by zz.perkuliahan) as zz on (zz.perkuliahan = a.id or zz.perkuliahan = z.id)
where
case when $P{guru} = -1 then true else c.id = $P{guru} end
and (a.semester % 2) = (CASE $P{genapGanjil} when 'Genap' then 0 else 1 end)
and case when  $P{program} = 'Semua' then true else a.program = $P{program} end
and case when $P{jenis_semester} = 'Semua' then true else a.semester % 2 = (case $P{jenis_semester} when 'Genap' then 0 else 1 end) end
and a.tahun_ajaran=$P{tahun_ajaran}
and case when $P{sekolah} = -1 then true else d.id = $P{sekolah} end
and case when $P{yayasan} = -1 then true else e.id = $P{yayasan} end
and case when $P{kelas} = '-1' then true else a.kelas ilike $P{kelas} end
and case when $P{tahap} = -1 then true else dd.tahap = $P{tahap} end
and case $P{masa_perkuliahan} when -1 then true else a.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then a.status_semesterpendek is null else a.status_semesterpendek = $P{semester_pendek} end
and case $P{ekstrakurikuler} when -1 then b.extrakulikuler = false else b.extrakulikuler end
and case $P{paralel} when -1 then a.perkuliahan_paralel is null else true end
order by
c.nama||c.id,
(case a.hari when 'Senin' then 1 when 'Selasa' then 2 when 'Rabu' then 3 when 'Kamis' then 4 when 'Jumat' then 5  when $P{jumat} then 5 when 'Sabtu' then 6 when 'Minggu' then 7 end),(a.waktu_mulai_d)]]>
	</queryString>

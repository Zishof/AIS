	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select m.nim, m.nama, 
	j.nama as jurusan, f.nama as fakultas, pw.no_kursi
from pendaftaran_wisuda pw
inner join mahasiswa m on (pw.mahasiswa = m.id)
inner join jurusan j on (m.jurusan = j.id)
inner join fakultas f on (j.fakultas = f.id)
where pw.mahasiswa=$P{mahasiswa}]]></queryString>


		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="angkatan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="current_ta" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2016/2017"]]></defaultValueExpression>
	</parameter>
	<parameter name="current_semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String"/>
	<parameter name="status" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jadwal" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[(select
'Pembimbing I' as pembimbing,
a.dosen1 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.status,
a.judul,
m.kelamin,
a.totalnilai,
a.nilaihuruf

from mahasiswa_request_tugas_akhir a
left join jadwal_seminar_tugas_akhir b on (b.id=a.jadwal_seminar_tugas_akhir)
inner join dosen d on a.dosen1 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.dosen1 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_seminar_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.dosen1,j.nama,m.nim
)

union all

(
select
'Pembimbing II' as pembimbing,
a.dosen2 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.status,
a.judul,
m.kelamin,
a.totalnilai,
a.nilaihuruf

from mahasiswa_request_tugas_akhir a
left join jadwal_seminar_tugas_akhir b on (b.id=a.jadwal_seminar_tugas_akhir)
inner join dosen d on a.dosen2 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.dosen2 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_seminar_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.dosen2,j.nama,m.nim
)

union all

(
select
'Pembimbing III' as pembimbing,
a.dosen3 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.status,
a.judul,
m.kelamin,
a.totalnilai,
a.nilaihuruf

from mahasiswa_request_tugas_akhir a
left join jadwal_seminar_tugas_akhir b on (b.id=a.jadwal_seminar_tugas_akhir)
inner join dosen d on a.dosen3 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.dosen3 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_seminar_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.dosen3,j.nama,m.nim
)

union all

(
select
'Penguji I' as pembimbing,
a.dosen4 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.status,
a.judul,
m.kelamin,
a.totalnilai,
a.nilaihuruf

from mahasiswa_request_tugas_akhir a
left join jadwal_seminar_tugas_akhir b on (b.id=a.jadwal_seminar_tugas_akhir)
inner join dosen d on a.dosen4 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.dosen4 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_seminar_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.dosen4,j.nama,m.nim
)

union all

(
select
'Penguji II' as pembimbing,
a.dosen5 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.status,
a.judul,
m.kelamin,
a.totalnilai,
a.nilaihuruf

from mahasiswa_request_tugas_akhir a
left join jadwal_seminar_tugas_akhir b on (b.id=a.jadwal_seminar_tugas_akhir)
inner join dosen d on a.dosen5 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.dosen5 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_seminar_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.dosen5,j.nama,m.nim
)



union all

(
select
'Belum ada dosen pembimbing' as pembimbing,
-1 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
null as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.status,
a.judul,
m.kelamin,
a.totalnilai,
a.nilaihuruf

from mahasiswa_request_tugas_akhir a
left join jadwal_seminar_tugas_akhir b on (b.id=a.jadwal_seminar_tugas_akhir)
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and a.dosen1 is null
and a.dosen2 is null
and a.dosen3 is null
and a.dosen4 is null
and a.dosen5 is null
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_seminar_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end
and case when $P{program} = '-1' then true else b.program = $P{program} end
order by j.nama,m.nim
)]]>
	</queryString>

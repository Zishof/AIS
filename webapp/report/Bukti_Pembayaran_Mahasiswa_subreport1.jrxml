	</parameter>
	<parameter name="lampirans" class="net.sf.jasperreports.engine.JRDataSource" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
('Bayar ke-' || a.ke)  as ke,
a.tanggal,
a.nilai,
a.keterangan,
c.nama as item_biaya,
b.pengurangan,
a.denda,
((b.amount+b.amount_terhutang)-abs(b.pengurangan)-b.denda) as total,
((b.amount+b.amount_terhutang)-b.denda) as tagihan
from cicilan_pembayaran a
inner join kegiatan b on (a.kegiatan = b.id)
left join item_biaya c on (a.item_biaya = c.id)
where (a.nilai != 0.0) and a.kegiatan = $P{kegiatan}
order by a.tanggal,a.ke]]>
	</queryString>
	<field name="ke" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="nilai" class="java.lang.Double"/>
	<field name="keterangan" class="java.lang.String"/>
	<field name="item_biaya" class="java.lang.String"/>
	<field name="pengurangan" class="java.lang.Double"/>
	<field name="denda" class="java.lang.Double"/>
	<field name="total" class="java.lang.Double"/>
	<field name="tagihan" class="java.lang.Double"/>
	<variable name="totalNilai" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai}]]></variableExpression>
	</variable>
	<variable name="totalDenda" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{denda}==null?0.0:$F{denda}]]></variableExpression>
	</variable>

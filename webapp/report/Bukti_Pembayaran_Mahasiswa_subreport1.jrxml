	<parameter name="kegiatan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[38L]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">

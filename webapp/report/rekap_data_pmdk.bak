	</parameter>
	<queryString><![CDATA[select a.nama, a.no_registrasi,a.asal_sma,a.tempat_lahir,
a.tanggal_lahir,j.nama as jurusan

from biodata_calon_mahasiswa a
left join jurusan j on a.prodi_1 = j.id

where jenis_seleksi=4

order by a.no_registrasi]]></queryString>


<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Biodata_Nim" pageWidth="595" pageHeight="550" orientation="Landscape" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="0.7513148009015777"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="nim" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String"/>
	<parameter name="foto" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.nim,a.nama,e.nama as jenis_seleksi,a.tempatlahir,a.tanggallahir,a.kelamin,
d.nama as jenjang,a.program,b.nama as jurusan, c.nama as fakultas

from mahasiswa a
left join biodata_mahasiswa t on t.mahasiswa = a.id
left join jurusan b on a.jurusan = b.id
left join fakultas c on b.fakultas = c.id
left join jenjang d on a.jenjang = d.id
left join jenis_seleksi e on a.jenis_seleksi = e.id

where a.nim=$P{nim}]]>
	</queryString>
	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jenis_seleksi" class="java.lang.String"/>
	<field name="tempatlahir" class="java.lang.String"/>
	<field name="tanggallahir" class="java.sql.Date"/>
	<field name="kelamin" class="java.lang.String"/>
	<field name="jenjang" class="java.lang.String"/>
	<field name="program" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<variable name="Tanggal" class="java.util.Date">
		<variableExpression><![CDATA[new java.util.Date()]]></variableExpression>
	</variable>

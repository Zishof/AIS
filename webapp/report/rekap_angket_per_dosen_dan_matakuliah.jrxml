	<field name="nilai4" class="java.lang.Long"/>
	<field name="nilai5" class="java.lang.Long"/>
	<field name="total" class="java.lang.Long"/>
	<variable name="rata_rata" class="java.lang.Double" resetType="Group" resetGroup="dosen">
		<variableExpression><![CDATA[(($V{nilai 1}*1+
$V{nilai 2}*2+
$V{nilai 3}*3+
$V{nilai 4}*4+
$V{nilai 5}*5)*100.0)/($V{total}*Integer.parseInt($P{jumlah_pilihan_checklist_penilaian_dosen_oleh_mahasiswa}))]]></variableExpression>
	</variable>
	<variable name="nilai 1" class="java.lang.Long" resetType="Group" resetGroup="dosen" calculation="Sum">

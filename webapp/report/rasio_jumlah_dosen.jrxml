	<queryString>
		<![CDATA[select
c.nama as fakultas,
b.nama as jurusan,
a.jumlah as mahasiswa,
d.jumlah as dosen
from jurusan b
inner join fakultas c on (b.fakultas = c.id)
left join (
	select count(*) as jumlah, jurusan
	from (
  select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
  where (case when 'Ganjil' = $P{semester} then semester % 2 != 0 else semester % 2 = 0 end)
  and tahunakademik = $P{tahunAkademik}
  group by mahasiswa
) as history
inner join mahasiswa as mhs on (mhs.id=history.mahasiswa)
inner join status_mahasiswa d on (d.id = history.status_mahasiswa)
where upper(trim(d.kode_epsbed)) = 'A' or upper(trim(d.kode_epsbed)) = 'C' or upper(trim(d.kode_epsbed)) = 'N' group by jurusan
) a on (a.jurusan = b.id)
left join (
	select count(a.*) as jumlah, a.jurusan from dosen a inner join status_pegawai b on (a.status_pegawai = b.id) where a.jurusan is not null and a.aktif and (b.nama ilike 'Aktif' or b.nama ilike 'TUGAS BELAJAR'  or b.nama ilike 'IJIN BELAJAR'  or b.nama ilike 'Cuti') group by jurusan
) d on (d.jurusan = b.id)
where
case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{fakultas} = -1 then true else b.fakultas = $P{fakultas} end
and b.aktif
order by fakultas, jurusan]]>
	</queryString>

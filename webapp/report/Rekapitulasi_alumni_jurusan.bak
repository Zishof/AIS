		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="df" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer("1")]]></defaultValueExpression>
	</parameter>
	<parameter name="dari" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="logo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="sampai" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT b.nama as jurusan,count(a.nim) as jumlah,c.nama as fakultas
 
FROM 
mahasiswa a
left join jurusan b on a.jurusan=b.id
left join fakultas c on b.fakultas=c.id

where a.status = 3 and a.tahunangkatan>=2007 and a.tahunangkatan<=2009

group by b.id,b.nama,c.nama]]></queryString>

	<field name="jurusan" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Long"/>
	<field name="fakultas" class="java.lang.String"/>

	<variable name="angka" class="java.lang.Integer" resetType="None" calculation="Count">

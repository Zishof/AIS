	<style name="Detail" fontSize="12"/>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2010/2011"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
d.nama as fakultas,
c.nama as jurusan,
a.semester,
sum(case when a.kegiatan is null then 0 else 1 end) as jmlh_sudah,
sum(case when a.kegiatan is null then 1 else 0 end) as jmlh_belum,
count(b.id) as jmlh,
sum(case when a.kegiatan is null then a.jumlah_tunggakan else 0.0 end) as jumlah_tunggakan,
sum(case when a.kegiatan is null then 0.0 else e.amount end) as jumlah_tunggakan_terbayar,
sum(case when a.kegiatan is null then a.jumlah_tunggakan else 0.0 end) - sum(case when a.kegiatan is null then 0.0 else e.amount end) as jumlah_tunggakan_total

from tunggakan_mahasiswa a
left join mahasiswa b on (a.mahasiswa = b.id)
left join jurusan c on (c.id = b.jurusan)
left join fakultas d on (c.fakultas = d.id)
left join kegiatan e on (a.kegiatan = e.id)
where a.tahun_akademik = $P{tahun_akademik}
and case when $P{jenis_semester} = 'Ganjil' then a.semester % 2 = 1 else a.semester % 2 = 0 end
group by d.nama, c.nama, a.semester
having sum(a.jumlah_tunggakan) >= 1.0
order by d.nama, c.nama, a.semester]]>
	</queryString>

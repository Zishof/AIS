	<parameter name="ruang" class="java.lang.Long"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggalKe" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ungaran"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.id as jadwal_id,b.nama as jadwal_ujian_pmb,b.waktumulai,b.waktusampai,ruang,no_ujian,pendaftar,a.paket,gedung,tahunakademik,tanggalujian,gelombang_pendaftaran,
pilihan,program,calon_mahasiswa
from
(
select a.calon_mahasiswa,aa.id as ujian_pmb, b.nama as ruang,c.no_ujian, c.nama as pendaftar,d.nama as paket,
e.nama as gedung,
aa.tahunakademik,
(
case
when $P{tanggalKe} = 1 then aa.tanggalujian1
when $P{tanggalKe} = 2 then aa.tanggalujian2
when $P{tanggalKe} = 3 then aa.tanggalujian3
when $P{tanggalKe} = 4 then aa.tanggalujian4
when $P{tanggalKe} = 5 then aa.tanggalujian5
when $P{tanggalKe} = 6 then aa.tanggalujian6
when $P{tanggalKe} = 7 then aa.tanggalujian7
when $P{tanggalKe} = 8 then aa.tanggalujian8
when $P{tanggalKe} = 9 then aa.tanggalujian9
when $P{tanggalKe} = 10 then aa.tanggalujian10
else aa.tanggalujian1 end
) as tanggalujian,
bbb.nama as gelombang_pendaftaran,
b.paket as paket_id,
((case when j1.nama is null then '' else j1.nama end) || (case when j2.nama is null then '' else ', '||j2.nama end)) as pilihan,
c.program, b.id as id_ruang_pmb
from ruang_paket_pmb a
left join ruang_pmb b on a.ruang_pmb = b.id
left join ujian_pmb aa on (b.ujian_pmb = aa.id)
left join gelombang_pendaftaran bbb on (aa.gelombang_pendaftaran = bbb.id)
left join biodata_calon_mahasiswa c on a.calon_mahasiswa = c.id
left join paket d on b.paket = d.id
left join gedung e on b.gedung = e.id
left join jurusan j1 on (c.prodi_1=j1.id)
left join jurusan j2 on (c.prodi_2=j2.id)
where a.ruang_pmb=$P{ruang}
order by c.no_ujian
) a
left join jadwal_ujian_pmb b on (date(a.tanggalujian) = date(b.waktumulai) and a.ujian_pmb = b.ujian_pmb and (b.paket=a.paket_id or b.paket is null))
where ruanganYgIkut='' or ruanganYgIkut ilike '%'||id_ruang_pmb||'%'
order by b.waktumulai,a.no_ujian]]>
	</queryString>
	<field name="jadwal_id" class="java.lang.Long"/>
	<field name="jadwal_ujian_pmb" class="java.lang.String"/>
	<field name="waktumulai" class="java.sql.Timestamp"/>
	<field name="waktusampai" class="java.sql.Timestamp"/>

		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<variable name="jumlah_total" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>

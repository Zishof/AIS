	</parameter>
	<queryString>
		<![CDATA[select *
from
(
SELECT
     count(*) jumlah,
     'Surat Masuk' AS surat_jenis,
     surat."tanggal" AS surat_tanggal_surat
FROM
     surat.surat_masuk surat
     inner join surat.klasifikasi_surat_masuk c on (surat.klasifikasi_surat_masuk = c.id)
where 1=1
and case $P{jenis} when -1 then true else surat.klasifikasi_surat_masuk = $P{jenis} end
and date(surat."tanggal") >= date($P{mulai}) and date(surat."tanggal") <= (date($P{sampai})+integer '1')
group by surat."tanggal"

union all

SELECT
     count(*) jumlah,
     'Surat Keluar' AS surat_jenis,
     surat."tanggal" AS surat_tanggal_surat
FROM
     surat.surat_keluar surat
     inner join surat.klasifikasi_surat_keluar c on (surat.klasifikasi_surat_keluar = c.id)
where 1=1
and case $P{jenis} when -1 then true else surat.klasifikasi_surat_keluar = $P{jenis} end
and date(surat."tanggal") >= date($P{mulai}) and date(surat."tanggal") <= (date($P{sampai})+integer '1')
group by surat."tanggal"
) a
order by surat_jenis,surat_tanggal_surat]]>
	</queryString>

	<variable name="semester" class="java.lang.Integer">
		<variableExpression><![CDATA[]]></variableExpression>
		<initialValueExpression><![CDATA[$P{bulan} <= 5 ? (($P{tahun} - $F{tahunangkatan}) * 2) : ((($P{tahun} - $F{tahunangkatan}) * 2) + 1)]]></initialValueExpression>
	</variable>
	<background>
		<band height="802">
			<printWhenExpression><![CDATA[$F{status_mahasiswa} == null || $F{status_mahasiswa}.trim().toLowerCase().contains("lulus")]]></printWhenExpression>
			<textField>
				<reportElement x="0" y="39" width="483" height="104" forecolor="#FF0033"/>
				<textElement textAlignment="Center">
					<font size="18" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Anda tidak bisa mencetak surat ini, karena surat ini hanya untuk mahasiswa yang aktif kuliah"]]></textFieldExpression>
			</textField>
		</band>
	</background>
	<title>
		<band height="802" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{status_mahasiswa} != null && !$F{status_mahasiswa}.trim().toLowerCase().contains("lulus")]]></printWhenExpression>
			<textField>
				<reportElement x="0" y="131" width="483" height="50"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["SURAT KETERANGAN \n"+
"Nomor : Un.01/B.1/PP.01.5/"+$F{nomor}+"/"+$P{tahun}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="66" y="199" width="417" height="50"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["\tRektor Universitas Islam Negeri (UIN) Syarif Hidayatullah Jakarta, dengan ini menerangkan bahwa :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="66" y="375" width="417" height="150"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["benar yang bersangkutan mahasiswa Fakultas "+$F{nama_fakultas}+" Program Studi "+$F{nama_jurusan}+", terdaftar sebagai mahasiswa Program "+$F{nama_jenjang}+" Tahun Akademik "+($P{bulan} <= 5 ? (($P{tahun}-1)+"/"+$P{tahun}) : ($P{tahun}+"/"+($P{tahun}+1)))+". \n\n\tSurat keterangan ini dibuat untuk mengajukan magang di tempat yang Bapak/Ibu pimpin."+
"\n\n\tDemikian, surat keterangan ini dibuat sebagaimana mestinya"]]></textFieldExpression>
			</textField>

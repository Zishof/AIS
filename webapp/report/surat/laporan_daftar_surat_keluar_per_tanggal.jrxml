<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_daftar_surat_per_jenis" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e98a6908-dcdb-4c99-98b7-a42f1fb6d5b0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mulai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sampai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     c."nama" AS surat_jenis,
     surat."kode" AS surat_nomor,
     surat."tanggal" AS surat_tanggal_surat,
     (case when a1.id is not null then a1.nim||' '||a1.nama||' (Mahasiswa)'
     when a2.id is not null then a2.nama || ' (Dosen)'
     when a3.id is not null then a3.nama || ' (Pegawai)' else '' end) as diajukan_oleh
FROM
     surat.surat_keluar surat
     inner join surat.klasifikasi_surat_keluar c on (surat.klasifikasi_surat_keluar = c.id)
     left join mahasiswa a1 on (surat.mahasiswa = a1.id)
     left join dosen a2 on (surat.dosen = a2.id)
     left join pegawai a3 on (surat.pegawai = a3.id)
where 1=1
and case $P{jenis} when -1 then true else surat.klasifikasi_surat_keluar = $P{jenis} end
and date(surat."tanggal") >= date($P{mulai}) and date(surat."tanggal") <= (date($P{sampai})+integer '1')
order by surat."tanggal",surat.id ]]>
	</queryString>
	<field name="surat_jenis" class="java.lang.String"/>
	<field name="surat_nomor" class="java.lang.String"/>
	<field name="surat_tanggal_surat" class="java.sql.Date"/>
	<field name="diajukan_oleh" class="java.lang.String"/>
	<group name="tanggal">
		<groupExpression><![CDATA[$F{surat_tanggal_surat}]]></groupExpression>

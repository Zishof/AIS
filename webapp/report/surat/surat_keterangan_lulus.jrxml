					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["benar yang bersangkutan lulusan Fakultas "+$F{nama_fakultas}+" Program Studi "+$F{nama_jurusan}+", terdaftar dalam Program "+$F{nama_jenjang}+"."+
"\n\n\tDemikian, surat keterangan ini dibuat sebagaimana mestinya"]]></textFieldExpression>

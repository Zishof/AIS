	<field name="nip_staff" class="java.lang.String"/>
	<background>
		<band height="802">
			<printWhenExpression><![CDATA[$F{status_mahasiswa} == null || !$F{status_mahasiswa}.trim().toLowerCase().contains("lulus")]]></printWhenExpression>
			<textField>
				<reportElement x="0" y="39" width="483" height="104" forecolor="#FF0033"/>
				<textElement textAlignment="Center">
					<font size="18" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Anda tidak bisa mencetak surat ini, karena anda belum lulus"]]></textFieldExpression>
			</textField>
		</band>
	</background>
	<title>
		<band height="802" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{status_mahasiswa} != null && $F{status_mahasiswa}.trim().toLowerCase().contains("lulus")]]></printWhenExpression>
			<textField>
				<reportElement x="0" y="131" width="483" height="50"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["SURAT KETERANGAN \n"+
"Nomor : Un.01/B.1/PP.01.5/"+$F{nomor}+"/"+$P{tahun}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="66" y="199" width="417" height="50"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["\tRektor Universitas Islam Negeri (UIN) Syarif Hidayatullah Jakarta, dengan ini menerangkan bahwa :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="66" y="399" width="417" height="105"/>

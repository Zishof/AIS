		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="id_va" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="id_bsi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="terbilang" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
p.jenis_biaya_sekolah_id as jenis_biaya_id,
c.nama as jenis_biaya,
(case when b.nomor_induk is null then cs.nomor_induk else b.nomor_induk end) as nomor_induk,
(case when b.nama_siswa is null then cs.nama_siswa else b.nama_siswa end) as nama_siswa,
a.tanggal,
f.bulan,
f.tahun,
a.sekolah_id,
a.id as id_transaksi,
e.nama as item_biaya,
d.nominal,
b1.nama as kelas,
case when b4.nama is null then '-' else b4.nama end as asrama,
(case when b2.nama is null then b3.nama_pembayaran else b2.nama end) as cara,
a.tambahan_deposit AS tambahan_deposit,
a.tanggal,
a.validator,
f.bayarke,
h.dibayarsebayak,
bni.deposit as bni_deposit,
f.denda

from sekolah.pembayaran_siswa a
left join sekolah.siswa b on (a.siswa_id = b.id)
left join sekolah.calon_siswa cs on (a.calon_siswa_id = cs.id)
left join sekolah.asrama b4 on (b4.id = b.asrama_id)
left join bank_host b2 on (b2.id = a.bank_host_id)
left join sekolah.akun_pembayaran_siswa b3 on (b3.id = a.akun_pembayaran_siswa_id)

inner join sekolah.pembayaran_siswa_detail d on (a.id = d.pembayaran_siswa_id)
inner join sekolah.item_biaya_sekolah e on (e.id = d.item_biaya_id)
inner join sekolah.tagihan f on (f.pembayaran_siswa_detail_id=d.id)
left join sekolah.kelas b1 on (b1.id=f.kelas_siswa_id)
inner join sekolah.nominal_biaya h on (f.nominal_biaya_id=h.id)
inner join sekolah.pengaturan_biaya p on (p.id=pengaturan_biaya_id)
left join sekolah.jenis_biaya_sekolah c on (c.id = p.jenis_biaya_sekolah_id)
left join bni_request bni on (bni.id=a.bni_request_id)

where case when $P{id_pembayaran}=-1 then true else a.id=$P{id_pembayaran} end
and case when $P{id_bri}=-1 then true else a.bri_request_id=$P{id_bri} end
and case when $P{id_bni}=-1 then true else a.bni_request_id=$P{id_bni} end
and case when $P{id_va}=-1 then true else a.virtual_account_bank=$P{id_va} end
order by p.jenis_biaya_sekolah_id, f.tahunbulan]]>
	</queryString>

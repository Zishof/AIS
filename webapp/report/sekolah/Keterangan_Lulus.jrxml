	<queryString>
		<![CDATA[select
a.sekolah_id,
a.nama_siswa as nama,
a.jenis_kelamin,a.tempat_lahir,a.tanggal_lahir,
a.alamat_siswa as alamat,a.sekolah_asal as asal_sma,b.nama as prodi_1,c.nama as prodi_2,a.nomor_induk as no_registrasi,a.tanggal_lahir,
b.nama as p1,c.nama as p2, g.nama as jenjang,
f.keterangan as info,

f.tanggalujian1,
f.tanggalujian2,
f.tanggalujian3,
f.tanggalujian4,
f.tanggalujian5,
f.tanggalujian6,
f.tanggalujian7,
f.tanggalujian8,
f.tanggalujian9,
f.tanggalujian10,
f.lokasi,
f.tampilkanjadwalujiandikartuujian,
e.tahun_ajaran as tahunakademik,
y.ujian_psb as ujian,
b1.nama as penjurusan_sekolah,
e.nama as nama_gelombang

from sekolah.calon_siswa a
left join sekolah.ruang_gelombang_psb z on (z.calon_siswa=a.id)
left join sekolah.ruang_psb y on z.ruang_psb = y.id
left join sekolah.sekolah b on a.sekolah_id=b.id
left join sekolah.penjurusan_sekolah b1 on a.penjurusan_sekolah_id=b1.id
left join sekolah.yayasan c on a.yayasan_id=c.id
left join sekolah.jenis_sekolah d on b.jenis_sekolah_id=d.id
left join sekolah.gelombang_pendaftaran_psb e on (a.current_gelombang_pendaftaran_psb_id=e.id)
left join sekolah.ujian_psb f on (y.ujian_psb=f.id)
left join sekolah.penjurusan_sekolah g on (a.penjurusan_sekolah_id = g.id)

where a.id=$P{biodata_id}
limit 1]]>
	</queryString>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="surat_peryataan_ortu" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="17c63559-c9a7-4d75-87ef-a92782305779">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ta" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2022/2023"]]></defaultValueExpression>
	</parameter>
	<parameter name="sekolah" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["SMK Karsa Mulya Palangka Raya"]]></defaultValueExpression>
	</parameter>
	<title>
		<band height="802" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="555" height="57" uuid="73050d56-1cd3-4ea6-b8f5-68816998307b"/>
				<textElement textAlignment="Center">
					<font size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["SURAT PERNYATAAN"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="76" width="488" height="26" uuid="f840b645-ceae-4ff4-9705-16ad1487f6e5"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Yang bertanda tangan di bawah ini saya : "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="107" y="102" width="448" height="91" uuid="9c80424b-93b2-4b01-ad22-f0960f935aa5"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Nama Siswa	\t\t: "+$P{REPORT_PARAMETERS_MAP}.get( "siswa" )+"\n"+
"Tempat tanggal lahir \t: "+$P{REPORT_PARAMETERS_MAP}.get( "ttl" )+"\n"+
"Kelas \t\t\t\t: "+$P{REPORT_PARAMETERS_MAP}.get( "kelas" )+"\n"+
"Nama Orang tua \t\t: "+$P{REPORT_PARAMETERS_MAP}.get( "ortu" )+"\n"+
"Alamat Tinggal\t\t: "+$P{REPORT_PARAMETERS_MAP}.get( "alamat" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="193" width="488" height="18" uuid="70a1453d-f09b-4e81-acd7-df42518367c3"/>
				<textElement>
					<font size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Menyatakan bahwa : "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="211" width="22" height="33" uuid="7c6bb727-2670-4387-95d7-842295d39421"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["1."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="211" width="466" height="33" uuid="5f57429c-8cbe-4783-94ac-d7d289cc5b24"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Tanpa paksaan, menyetujui dan menyepakati semua jenis ketentuan yang berlaku di "+$P{REPORT_PARAMETERS_MAP}.get( "sekolah" )+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="244" width="22" height="47" uuid="cc59a519-b955-45cd-a289-0a22f5a89f3a"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["2."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="244" width="466" height="47" uuid="68ebbd4c-80b7-46c6-8280-1033cb9734cb"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Bersedia dan taat pada aturan tata tertib dan segala bentuk proses pendidikan dan pembelajaran yang berlaku dan menjadi kegiatan rutin pada "+$P{REPORT_PARAMETERS_MAP}.get( "sekolah" )+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="291" width="466" height="47" uuid="e9ca281b-7683-4235-a2d1-6721c8224492"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Tidak membuat onar, mengancam, mengganggu, memancing emosi, mengejek, berkelahi, tawuran, memprovokasi dan sejenisnya baik di lingkungan sekolah maupun di luar sekolah."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="291" width="22" height="47" uuid="7d3a587f-f3c6-407c-93fa-24bd157c1edd"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["3."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="432" width="488" height="44" uuid="42c3c7f7-b59b-43af-904c-7be7bd39eb1a"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Demikian pernyataan ini kami buat dan tanda tangani dengan sadar dan tanpa paksaan dari pihak manapun. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="315" y="494" width="240" height="151" uuid="0bab8f0c-ff3c-4160-b4b6-34d95c94eb2d"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "label_kota" )+", "+(new SimpleDateFormat("dd MMMMMM yyyy",$P{REPORT_LOCALE})).format(new Date())+"\n"+
"Yang Menyatakan,\n\nMaterai 10000\n\n\n"+
"………………………………………………"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="338" width="22" height="16" uuid="2bd71fd5-73cd-42aa-86b1-583066621141"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["4."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="338" width="466" height="16" uuid="0e270ef8-ba60-4659-b99b-324b966bba26"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Ber ETIKET baik, SOPAN, SANTUN dan DISIPLIN"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="354" width="22" height="31" uuid="e7efd437-83a2-4162-a593-bb091c6d5c7e"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["5."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="354" width="466" height="31" uuid="26d8b364-b97f-4918-8d70-bd14e9e31f12"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Tidak membawa, memakai, mengedarkan ataupun bentuk lainnya obat-obatan terlarang dan sejenisnya, narkoba dan bentuk sejenisnya"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="385" width="22" height="47" uuid="010be4ca-2e41-4094-b44f-dc831f4a68d1"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["6."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="385" width="466" height="47" uuid="fe578f40-3601-42a1-b5d4-870064c0de5b"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Jika melakukan pelanggaran antara lain seperti tersebut diatas maka saya bersedia untuk ditindak secara tegas dan di kembalikan kepada orang tua, tanpa peringatan tertulis sebelumnya."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="494" width="228" height="151" uuid="2eda5efd-7a9e-4ddb-a76f-468e298a0b12"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Mengetahui dan menyetujui :\n"+
"Orang tua siswa,\n\n\n\n\n"+
"………………………………………………"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="187" y="651" width="228" height="151" uuid="df936d61-ab26-4750-97f9-e24296860058"/>
				<textElement markup="html">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Mengetahui :<br>"+
"Kepala Sekolah,<br><br><br><br><br>"+
"<u><strong>"+$P{REPORT_PARAMETERS_MAP}.get( "nama_kepala_sekolah" )+"</strong></u><br>"+
$P{REPORT_PARAMETERS_MAP}.get( "nip_kepala_sekolah" )]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>

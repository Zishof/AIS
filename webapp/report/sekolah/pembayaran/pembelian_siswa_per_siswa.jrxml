	</parameter>
	<parameter name="siswa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="asrama" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="kelas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="angkatan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="anaks" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
c.id as  kantin_id,
c.nama as kantin,
b.nomor_induk,
b.nama_siswa,
a.waktu tanggal,
a.hargajual nominal,
a.kode as id_transaksi,
e.nama as produk,
e.keterangan,
f.nama as kelas,
b.id as id_siswa

from koperasi.pembelian a
left join sekolah.siswa b on (a.siswa = b.id)
inner join koperasi.toko c on (c.id = a.toko)
inner join koperasi.produk e on (e.id = a.produk)
left join sekolah.kelas f on (b1.id =f.id)

where date(a.waktu) between date($P{mulai}) and date($P{sampai})
and case when $P{siswa} = '' then true else (b.nomor_induk ilike '%'||$P{siswa}||'%' or b.nama_siswa ilike '%'||$P{siswa}||'%') end
and case when $P{sekolah} = -1 then true else b.sekolah_id = $P{sekolah} end
and case when $P{kantin} = -1 then true else a.toko = $P{kantin} end
and case when $P{kelas} = -1 then true else b1.id = $P{kelas} end
and case when $P{asrama} = -1 then true else b.asrama_id = $P{asrama} end
and case when $P{angkatan} = -1 then true else (b.tahun_masuk = $P{angkatan}) end
and (b.aktif or b.aktif is null)
and b.yayasan_id = $P{yayasan}
and case when $X{IN,-1,anaks} then true else $X{IN,a.siswa,anaks} end

order by c.id,b.id,a.waktu]]>
	</queryString>

		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="semua" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Tidak"]]></defaultValueExpression>
	</parameter>
	<parameter name="siswa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="angkatan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="anaks" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select *,bb.nama as sekolah
from
(
	select
	a.sekolah_id,
	date($P{mulai})- interval '1 minute' as tanggal,
	a.id,
	a.nomor_induk,
	a.nama_siswa,
	'Saldo Awal' as deskripsi,
	case when b.nominal is null then 0 else b.nominal end as pemasukan,
	(case when c.nominal is null then 0 else c.nominal end)+(case when d.nominal is null then 0 else d.nominal end) as pengeluaran

	from sekolah.siswa a
	left join (select max(bbb.id) as id,max(bbb.nama) as nama,aaa.siswa_id from sekolah.asrama_punya_siswa aaa inner join sekolah.asrama bbb
	on (aaa.asrama_id=bbb.id) group by aaa.siswa_id) b2 on (b2.siswa_id = a.id)
	left join (
		select siswa_id,sum(nominal) as nominal from sekolah.deposit_siswa aa
		inner join sekolah.siswa bb on (aa.siswa_id = bb.id)
		where date(aa.waktu) < date($P{mulai})
		and case when $P{siswa} = '' then true else (bb.nomor_induk ilike '%'||$P{siswa}||'%' or bb.nama_siswa ilike '%'||$P{siswa}||'%') end
		and case when $P{sekolah} = -1 then true else bb.sekolah_id = $P{sekolah} end
		and case when $P{yayasan} = -1 then true else bb.yayasan_id = $P{yayasan} end
		group by siswa_id
	)  b on (a.id = b.siswa_id)
	left join (
		select siswa_id,sum(nominal) as nominal from sekolah.pembayaran_siswa aa
		inner join sekolah.siswa bb on (aa.siswa_id = bb.id)
		where date(aa.tanggal) < date($P{mulai})
		and case when $P{siswa} = '' then true else (bb.nomor_induk ilike '%'||$P{siswa}||'%' or bb.nama_siswa ilike '%'||$P{siswa}||'%') end
		and case when $P{sekolah} = -1 then true else bb.sekolah_id = $P{sekolah} end
		and case when $P{yayasan} = -1 then true else bb.yayasan_id = $P{yayasan} end
		group by siswa_id
	)  c on (a.id = c.siswa_id)
	left join (
		select siswa as siswa_id,sum(hargajual) as nominal from koperasi.pembelian aa
		inner join sekolah.siswa bb on (aa.siswa = bb.id)
		where date(aa.waktu) < date($P{mulai})
		and case when $P{siswa} = '' then true else (bb.nomor_induk ilike '%'||$P{siswa}||'%' or bb.nama_siswa ilike '%'||$P{siswa}||'%') end
		and case when $P{sekolah} = -1 then true else bb.sekolah_id = $P{sekolah} end
		and case when $P{yayasan} = -1 then true else bb.yayasan_id = $P{yayasan} end
		group by siswa_id
	)  d on (a.id = d.siswa_id)
	where case when  $P{semua} = 'Tidak' then true else (a.aktif is null or a.aktif) end
	and case when $P{kelas} = -1 then true else a.current_kelas_id = $P{kelas} end
	and case when $P{angkatan} = -1 then true else (a.tahun_masuk = $P{angkatan}) end
	and case when $P{asrama} = -1 then true else b2.id = $P{asrama} end
	and case when $X{IN,-1,anaks} then true else $X{IN,a.id,anaks} end

	union all


	select
	a.sekolah_id,
	b.waktu as tanggal,
	a.id,
	a.nomor_induk,
	a.nama_siswa,
	b.keterangan || ' senilai '||b.nominal||' via '||(case when b31.nama_pembayaran is null then '' else b31.nama_pembayaran end) as deskripsi,
	b.nominal as pemasukan,
	0 as pengeluaran

	from sekolah.siswa a
	left join (select max(bbb.id) as id,max(bbb.nama) as nama,aaa.siswa_id from sekolah.asrama_punya_siswa aaa inner join sekolah.asrama bbb
	on (aaa.asrama_id=bbb.id) group by aaa.siswa_id) b2 on (b2.siswa_id = a.id)
	inner join sekolah.deposit_siswa b on (a.id = b.siswa_id)
	left join sekolah.akun_pembayaran_siswa b31 on (b31.id = b.akun_pembayaran_siswa_id)
	where date(b.waktu) between date($P{mulai}) and date($P{sampai})
	and case when $P{siswa} = '' then true else (a.nomor_induk ilike '%'||$P{siswa}||'%' or a.nama_siswa ilike '%'||$P{siswa}||'%') end
	and case when $P{sekolah} = -1 then true else a.sekolah_id = $P{sekolah} end
	and case when $P{yayasan} = -1 then true else a.yayasan_id = $P{yayasan} end
	and case when  $P{semua} = 'Tidak' then true else (a.aktif is null or a.aktif) end
	and case when $P{kelas} = -1 then true else a.current_kelas_id = $P{kelas} end
	and case when $P{angkatan} = -1 then true else (a.tahun_masuk = $P{angkatan}) end
	and case when $P{asrama} = -1 then true else b2.id = $P{asrama} end
	and case when $X{IN,-1,anaks} then true else $X{IN,a.id,anaks} end


	union all

	select
	a.sekolah_id,
	b.tanggal as tanggal,
	a.id,
	a.nomor_induk,
	a.nama_siswa,
	'Pembayaran '||c.nama||' '||(case when b.bulan is null then '' else 'bulan '||b.bulan end)||(case when b.tahun is null then '' else ' tahun '||b.tahun end)||' senilai '||b.nominal||' via '||(case when b31.nama_pembayaran is null then '' else b31.nama_pembayaran end) as deskripsi,
	0 as pemasukan,
	cc.nominal as pengeluaran

	from sekolah.siswa a
	left join (select max(bbb.id) as id,max(bbb.nama) as nama,aaa.siswa_id from sekolah.asrama_punya_siswa aaa inner join sekolah.asrama bbb
	on (aaa.asrama_id=bbb.id) group by aaa.siswa_id) b2 on (b2.siswa_id = a.id)
	inner join sekolah.pembayaran_siswa b on (a.id = b.siswa_id)
	left join sekolah.akun_pembayaran_siswa b31 on (b31.id = b.akun_pembayaran_siswa_id)
	inner join sekolah.pembayaran_siswa_detail cc on (cc.pembayaran_siswa_id=b.id)
	inner join sekolah.item_biaya_sekolah c on (cc.item_biaya_id=c.id)
	where date(b.tanggal) between date($P{mulai}) and date($P{sampai})
	and case when $P{siswa} = '' then true else (a.nomor_induk ilike '%'||$P{siswa}||'%' or a.nama_siswa ilike '%'||$P{siswa}||'%') end
	and case when $P{sekolah} = -1 then true else a.sekolah_id = $P{sekolah} end
	and case when $P{yayasan} = -1 then true else a.yayasan_id = $P{yayasan} end
	and case when  $P{semua} = 'Tidak' then true else (a.aktif is null or a.aktif) end
	and case when $P{kelas} = -1 then true else a.current_kelas_id = $P{kelas} end
	and case when $P{angkatan} = -1 then true else (a.tahun_masuk = $P{angkatan}) end
	and case when $P{asrama} = -1 then true else b2.id = $P{asrama} end
	and case when $X{IN,-1,anaks} then true else $X{IN,a.id,anaks} end

	union all

	select
	a.sekolah_id,
	b.waktu as tanggal,
	a.id,
	a.nomor_induk,
	a.nama_siswa,
	p.nama || ' ' || b.keterangan ||' senilai '||b.hargajual|| ' di ' || c.nama as deskripsi,
	0 as pemasukan,
	b.hargajual as pengeluaran

	from sekolah.siswa a
	left join (select max(bbb.id) as id,max(bbb.nama) as nama,aaa.siswa_id from sekolah.asrama_punya_siswa aaa inner join sekolah.asrama bbb
	on (aaa.asrama_id=bbb.id) group by aaa.siswa_id) b2 on (b2.siswa_id = a.id)
	inner join koperasi.pembelian b on (a.id = b.siswa)
	left join koperasi.toko c on (c.id = b.toko)
	left join koperasi.produk p on (p.id = b.produk)
	where date(b.waktu) between date($P{mulai}) and date($P{sampai})
	and case when $P{siswa} = '' then true else (a.nomor_induk ilike '%'||$P{siswa}||'%' or a.nama_siswa ilike '%'||$P{siswa}||'%') end
	and case when $P{sekolah} = -1 then true else a.sekolah_id = $P{sekolah} end
	and case when $P{yayasan} = -1 then true else a.yayasan_id = $P{yayasan} end
	and case when $P{angkatan} = -1 then true else (a.tahun_masuk = $P{angkatan}) end
	and case when  $P{semua} = 'Tidak' then true else (a.aktif is null or a.aktif) end
	and case when $P{kelas} = -1 then true else a.current_kelas_id = $P{kelas} end
	and case when $P{asrama} = -1 then true else b2.id = $P{asrama} end
	and case when $X{IN,-1,anaks} then true else $X{IN,a.id,anaks} end

) aa
inner join sekolah.sekolah bb on (aa.sekolah_id=bb.id)
where (aa.pengeluaran+aa.pemasukan) != 0
and case when -1 = -1 then true else (aa.pengeluaran+aa.pemasukan)<=-1 end

order by aa.sekolah_id,aa.id,aa.tanggal,aa.deskripsi]]>
	</queryString>

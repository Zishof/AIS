		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
tanggal.tanggal,
b.nomor_induk,
b.nama_siswa,
sum(case when a.nominal is null then 0.0 else a.nominal end) as deposit,
sum(case when a1.nominal is null then 0.0 else a1.nominal end) as pembayaran,
sum(case when a2.hargajual is null then 0.0 else a2.hargajual end) as pembelian,

sum((case when a.nominal is null then 0.0 else a.nominal end)-
((case when a1.nominal is null then 0.0 else a1.nominal end)+(case when a2.hargajual is null then 0.0 else a2.hargajual end))) as nominal,
max(b1.nama) as kelas,
s.nama as sekolah,
s.id sekolah_id


from sekolah.siswa b

inner join (
	select
	tgl.siswa_id, tgl.tanggal
	from (
		select siswa_id,date(waktu) as tanggal
		from sekolah.deposit_siswa
		where date(waktu) between date($P{mulai}) and date($P{sampai})
		group by siswa_id,date(waktu)

		union all

		select siswa_id,date(tanggal) as tanggal
		from sekolah.pembayaran_siswa
		where date(tanggal) between date($P{mulai}) and date($P{sampai})
		group by siswa_id,date(tanggal)

		union all

		select siswa as siswa_id,date(waktu) as tanggal
		from koperasi.pembelian
		where date(waktu) between date($P{mulai}) and date($P{sampai})
		group by siswa,date(waktu)
	) tgl
	group by tgl.siswa_id, tgl.tanggal
) tanggal on (tanggal.siswa_id = b.id)

left join sekolah.deposit_siswa a on (a.siswa_id = b.id and date(tanggal.tanggal)=date(a.waktu))
left join sekolah.pembayaran_siswa a1 on (a1.siswa_id = b.id and date(tanggal.tanggal)=date(a1.tanggal))
left join koperasi.pembelian a2 on (a2.siswa = b.id and date(tanggal.tanggal)=date(a2.waktu))

left join (select max(bbb.id) as id,max(bbb.nama) as nama,max(bbb.tingkat) as tingkat,aaa.siswa_id from sekolah.kelas_punya_siswa aaa inner join sekolah.kelas bbb on (aaa.kelas_id=bbb.id) group by aaa.siswa_id) b1 on (b1.siswa_id = b.id)
left join sekolah.sekolah s on (a.sekolah_id=s.id)
where
case when $P{sekolah} = -1 then true else (a.sekolah_id = $P{sekolah} or a1.sekolah_id = $P{sekolah} ) end
and (a.yayasan_id = $P{yayasan} or a1.yayasan_id = $P{yayasan} )
and (b.aktif or b.aktif is null)
and case when $P{siswa} = '' then true else b.nomor_induk ilike '%'||$P{siswa}||'%' or b.nama_siswa ilike '%'||$P{siswa}||'%' end
and case when $P{kelas} = -1 then true else b1.id = $P{kelas} end
and case when $P{asrama} = -1 then true else b.asrama_id = $P{asrama} end
and case when $P{angkatan} = -1 then true else (b.tahun_masuk = $P{angkatan}) end
and case when $X{IN,-1,anaks} then true else $X{IN,b.id,anaks} end
group by s.id,tanggal.tanggal,b.id
order by s.nama,max(b1.tingkat),max(b1.nama),tanggal.tanggal,b.nomor_induk]]>
	</queryString>

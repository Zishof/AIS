	</parameter>
	<parameter name="jenisBiayaSekolah" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="kelas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="asrama" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="angkatan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="anaks" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.nomor_induk,
b.nama_siswa,
a.waktu as tanggal,
a.nominal,
case when b1.nama is null then '-' else b1.nama end as kelas,
b3.nama_pembayaran as cara,
s.nama as sekolah,
a.sekolah_id,
a.keterangan


from sekolah.deposit_siswa a
left join sekolah.siswa b on (a.siswa_id = b.id)
left join sekolah.calon_siswa cs on (a.calon_siswa_id = cs.id)
left join (select max(bbb.id) as id,max(bbb.nama) as nama,max(bbb.tingkat) as tingkat,aaa.siswa_id from sekolah.kelas_punya_siswa aaa inner join sekolah.kelas bbb on (aaa.kelas_id=bbb.id) group by aaa.siswa_id) b1 on (b1.siswa_id = b.id)
left join sekolah.akun_pembayaran_siswa b3 on (b3.id = a.akun_pembayaran_siswa_id)
left join sekolah.sekolah s on (a.sekolah_id=s.id)
where date(a.tanggal_bayar) between date($P{mulai}) and date($P{sampai})
and case when $P{sekolah} = -1 then true else a.sekolah_id = $P{sekolah} end
and case when $P{yayasan} = -1 then true else a.yayasan_id = $P{yayasan} end
and case when $P{siswa} = '' then true else (b.nomor_induk ilike '%'||$P{siswa}||'%' or b.nama_siswa ilike '%'||$P{siswa}||'%' or cs.nomor_induk ilike '%'||$P{siswa}||'%' or cs.nama_siswa ilike '%'||$P{siswa}||'%') end
and case when $P{akunPembayaranSiswa} = -1 then true else a.akun_pembayaran_siswa_id = $P{akunPembayaranSiswa} end
and case when $P{kelas} = -1 then true else b1.id = $P{kelas} end
and case when $P{asrama} = -1 then true else b.asrama_id = $P{asrama} end
and case when $P{angkatan} = -1 then true else (b.tahun_masuk = $P{angkatan} or cs.tahun_masuk = $P{angkatan}) end
and (b.aktif or b.aktif is null)
and a.nominal > 0.1

and case when $X{IN,-1,anaks} then true else $X{IN,a.siswa_id,anaks} end

order by s.nama,b1.tingkat,b1.nama,a.waktu]]>
	</queryString>

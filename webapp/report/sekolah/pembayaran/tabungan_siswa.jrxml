	<queryString>
		<![CDATA[select
b1.tingkat,
b.nomor_induk,
b.nama_siswa,
(((case when z.nominal is null then 0.0 else z.nominal end)-
((case when z1.nominal is null then 0.0 else z1.nominal end)+(case when z2.nominal is null then 0.0 else z2.nominal end)))) as saldo_awal,
(case when a.nominal is null then 0.0 else a.nominal end) as deposit,
(case when a1.nominal is null then 0.0 else a1.nominal end) as pembayaran,
(case when a2.nominal is null then 0.0 else a2.nominal end) as pembelian,

(
(((case when z.nominal is null then 0.0 else z.nominal end)-
((case when z1.nominal is null then 0.0 else z1.nominal end)+(case when z2.nominal is null then 0.0 else z2.nominal end))))
+
((case when a.nominal is null then 0.0 else a.nominal end)-
((case when a1.nominal is null then 0.0 else a1.nominal end)+(case when a2.nominal is null then 0.0 else a2.nominal end)))) as nominal,
b1.nama as kelas,
s.nama as sekolah,
a.sekolah_id


from sekolah.siswa b
left join (
	select siswa_id,max(sekolah_id)sekolah_id,max(yayasan_id)yayasan_id,sum(nominal) nominal
	from sekolah.deposit_siswa
	where date(waktu) between date($P{mulai}) and date($P{sampai})
	and case when $P{akunPembayaranSiswa} = -1 then true else akun_pembayaran_siswa_id = $P{akunPembayaranSiswa} end
	group by siswa_id) a
on (a.siswa_id = b.id)
left join (
	select siswa_id,max(sekolah_id)sekolah_id,max(yayasan_id)yayasan_id,sum(nominal) nominal
	from sekolah.pembayaran_siswa
	where date(tanggal) between date($P{mulai}) and date($P{sampai})
	and case when $P{akunPembayaranSiswa} = -1 then true else akun_pembayaran_siswa_id = $P{akunPembayaranSiswa} end
	group by siswa_id) a1
on (a1.siswa_id = b.id)
left join (
	select siswa as siswa_id,max(sekolah_id)sekolah_id,max(yayasan_id)yayasan_id,sum(hargajual) nominal
	from koperasi.pembelian aa
	inner join sekolah.siswa bb on (aa.siswa = bb.id)
	where date(waktu) between date($P{mulai}) and date($P{sampai}) group by siswa_id) a2
on (a2.siswa_id = b.id)


left join (
	select siswa_id,max(sekolah_id)sekolah_id,max(yayasan_id)yayasan_id,sum(nominal) nominal
	from sekolah.deposit_siswa
	where date(waktu) < date($P{mulai}) group by siswa_id) z
on (z.siswa_id = b.id)
left join (
	select siswa_id,max(sekolah_id)sekolah_id,max(yayasan_id)yayasan_id,sum(nominal) nominal
	from sekolah.pembayaran_siswa
	where date(tanggal) < date($P{mulai}) group by siswa_id) z1
on (z1.siswa_id = b.id)
left join (
	select siswa as siswa_id,max(sekolah_id)sekolah_id,max(yayasan_id)yayasan_id,sum(hargajual) nominal
	from koperasi.pembelian aa
	inner join sekolah.siswa bb on (aa.siswa = bb.id)
	where date(waktu) < date($P{mulai}) group by siswa_id) z2
on (z2.siswa_id = b.id)

left join (select max(bbb.id) as id,max(bbb.nama) as nama,max(bbb.tingkat) as tingkat,aaa.siswa_id from sekolah.kelas_punya_siswa aaa inner join sekolah.kelas bbb on (aaa.kelas_id=bbb.id) group by aaa.siswa_id) b1 on (b1.siswa_id = b.id)
left join sekolah.sekolah s on (a.sekolah_id=s.id)
where
case when $P{sekolah} = -1 then true else (a.sekolah_id = $P{sekolah} or a1.sekolah_id = $P{sekolah} or a2.sekolah_id = $P{sekolah} ) end
and (a.yayasan_id = $P{yayasan} or a1.yayasan_id = $P{yayasan} or a2.yayasan_id = $P{yayasan})
and (b.aktif or b.aktif is null)
and case when $P{siswa} = '' then true else b.nomor_induk ilike '%'||$P{siswa}||'%' or b.nama_siswa ilike '%'||$P{siswa}||'%' end
and case when $P{kelas} = -1 then true else b1.id = $P{kelas} end
and case when $P{asrama} = -1 then true else b.asrama_id = $P{asrama} end
and case when $P{angkatan} = -1 then true else (b.tahun_masuk = $P{angkatan}) end
and case when $X{IN,-1,anaks} then true else $X{IN,b.id,anaks} end

order by s.nama,b1.tingkat,b1.nama,b.nomor_induk]]>
	</queryString>

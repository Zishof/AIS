	<queryString>
		<![CDATA[select
s.id as id_sekolah,
a4.id as  jenis_biaya_id,
a4.nama as jenis_biaya,
(case when b.nomor_induk is null then c.nomor_induk else b.nomor_induk end) as nomor_induk,
(case when b.nama_siswa is null then c.nama_siswa else b.nama_siswa end) as nama_siswa,
a.bulan,
a.tahun,
(a.nominal-a.diskon) as nominal,
(case when b1.nama is null then '(tanpa kelas)' else b1.nama end) as kelas,
a3.nama as itembiaya,
s.nama as sekolah,
a.bayarke,
1 as dibayarsebayak,
a.tahunbulan


from sekolah.tagihan a
inner join sekolah.pengaturan_biaya a2 on (a2.id = a.pengaturan_biaya)
inner join sekolah.item_biaya_sekolah a3 on (a3.id = a.item_biaya_id)
inner join sekolah.jenis_biaya_sekolah a4 on (a4.id = a2.jenis_biaya_sekolah_id)
left join sekolah.siswa b on (a.siswa_id = b.id)
left join sekolah.calon_siswa c on (a.calon_siswa_id = c.id)

left join sekolah.kelas b1 on (b1.id = a.kelas_siswa_id)

left join sekolah.sekolah s on (s.id = a2.sekolah_id)

left join (select max(bbb.id) as id,max(bbb.nama) as nama,aaa.siswa_id from sekolah.asrama_punya_siswa aaa inner join sekolah.asrama bbb on (aaa.asrama_id=bbb.id) group by aaa.siswa_id) b2 on (b2.siswa_id = b.id)


where case when $P{semua} = 'Tidak' then true else (b.aktif or b.aktif is null or c.aktif or c.aktif is null) end
and case when $P{sekolah} = -1 then true else a2.sekolah_id = $P{sekolah} end
and case when $P{jenisBiaya} = -1 then true else a2.jenis_biaya_sekolah_id = $P{jenisBiaya} end
and case when $P{kelas} = -1 then true else b1.id = $P{kelas} end
and case when $P{asrama} = -1 then true else b2.id = $P{asrama} end
and case when a4.periode='Bulanan' then a.tahunbulan <= $P{tahunbulan} when a4.periode='Tahunan' then a.tahun <= $P{tahun} else true end

and case when $P{yayasan} = -1 then true else a2.yayasan_id = $P{yayasan} end
and case when $P{siswa} = '' then true else (b.nomor_induk ilike '%'||$P{siswa}||'%' or b.nama_siswa ilike '%'||$P{siswa}||'%' or c.nomor_induk ilike '%'||$P{siswa}||'%' or c.nama_siswa ilike '%'||$P{siswa}||'%') end
and case when $P{jenisBiayaSekolah} = -1 then true else a2.jenis_biaya_sekolah_id = $P{jenisBiayaSekolah} end
and case when $P{angkatan} = -1 then true else (b.tahun_masuk = $P{angkatan} or c.tahun_masuk = $P{angkatan}  ) end
and a.nominal > 0
and a.pembayaran_siswa_detail_id is null
and (a.aktif or a.aktif is null)
and (a2.aktif or a2.aktif is null)
and case when $X{IN,-1,anaks} then true else $X{IN,a.siswa_id,anaks} end

order by b.sekolah_id,a4.id,b1.tingkat,b1.nama,b.id,a.tahunbulan]]>
	</queryString>

	<queryString>
		<![CDATA[select
c.id as  jenis_biaya_id,
c.nama as jenis_biaya,
(case when b.nomor_induk is null then cs.nomor_induk else b.nomor_induk end) as nomor_induk,
(case when b.nama_siswa is null then cs.nama_siswa else b.nama_siswa end) as nama_siswa,
date(a.tanggal) as tanggal,
t.bulan,
t.tahun,
cc.nominal,
case when b1.nama is null then '-' else b1.nama end as kelas,
c1.nama||'-'||(case when b2.nama is null then b3.nama_pembayaran else b2.nama end) as cara,
s.nama as sekolah,
a.sekolah_id,
t.bayarke,
n.dibayarsebayak

from sekolah.pembayaran_siswa a
left join sekolah.siswa b on (a.siswa_id = b.id)
left join sekolah.calon_siswa cs on (a.calon_siswa_id = cs.id)
left join bank_host b2 on (b2.id = a.bank_host_id)
left join sekolah.akun_pembayaran_siswa b3 on (b3.id = a.akun_pembayaran_siswa_id)
inner join sekolah.pembayaran_siswa_detail cc on (cc.pembayaran_siswa_id=a.id)
inner join sekolah.item_biaya_sekolah c1 on (cc.item_biaya_id=c1.id)
inner join sekolah.tagihan t on (t.pembayaran_siswa_detail_id=cc.id)
left join sekolah.kelas b1 on (b1.id = t.kelas_siswa_id)
inner join sekolah.nominal_biaya n on (t.nominal_biaya_id = n.id)
inner join sekolah.pengaturan_biaya p on (n.pengaturan_biaya_id = p.id)
inner join sekolah.jenis_biaya_sekolah c on (p.jenis_biaya_sekolah_id=c.id)
left join sekolah.sekolah s on (a.sekolah_id=s.id)
where date(a.tanggal) between date($P{mulai}) and date($P{sampai})
and case when $P{sekolah} = -1 then true else a.sekolah_id = $P{sekolah} end
and case when $P{yayasan} = -1 then true else a.yayasan_id = $P{yayasan} end
and case when $P{siswa} = '' then true else (b.nomor_induk ilike '%'||$P{siswa}||'%' or b.nama_siswa ilike '%'||$P{siswa}||'%' or cs.nomor_induk ilike '%'||$P{siswa}||'%' or cs.nama_siswa ilike '%'||$P{siswa}||'%') end
and case when $P{jenisBiayaSekolah} = -1 then true else a.jenis_biaya_id = $P{jenisBiayaSekolah} end
and case when $P{akunPembayaranSiswa} = -1 then true else a.akun_pembayaran_siswa_id = $P{akunPembayaranSiswa} end
and case when $P{tahun} = -1 then true else a.tahun = $P{tahun} end
and case when $P{bulan} = -1 then true else a.bulan = $P{bulan} end
and case when $P{angkatan} = -1 then true else (b.tahun_masuk = $P{angkatan} or cs.tahun_masuk = $P{angkatan}) end
and case when $P{kelas} = -1 then true else b1.id = $P{kelas} end
and case when $P{asrama} = -1 then true else b.asrama_id = $P{asrama} end
and (b.aktif or b.aktif is null)
and (p.aktif or p.aktif is null)
and a.nominal > 0.1
and case when $X{IN,-1,anaks} then true else $X{IN,a.siswa_id,anaks} end

order by s.nama,date(a.tanggal),b1.tingkat,b1.nama,c.id,t.tahun,t.bulan]]>
	</queryString>

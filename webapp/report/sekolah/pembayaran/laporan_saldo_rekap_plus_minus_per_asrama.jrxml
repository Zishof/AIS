	</variable>
	<variable name="plus" class="java.lang.String">
		<variableExpression><![CDATA[($F{pemasukan}+$F{pengeluaran})>0.0?"Daftar Siswa dengan saldo plus" : "Daftar Siswa dengan saldo minus"]]></variableExpression>
	</variable>

	</parameter>
	<parameter name="sampai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2017-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="sekolah" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="yayasan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="nis" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="maksimal" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="kelas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="asrama" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="semua" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Tidak"]]></defaultValueExpression>
	</parameter>
	<parameter name="anaks" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select *, (case when (aa.pemasukan-aa.pengeluaran) > 0 then 'plus' else 'minus' end) as plus_minus
from
(
	select
	date($P{mulai})- interval '1 minute' as tanggal,
	a.id,
	a.nomor_induk,
	a.nama_siswa,
	(case when a1.nama is null then 'Tanpa Asrama' else a1.nama end) as kelas,
	'Saldo Awal' as deskripsi,
	case when b.nominal is null then 0 else b.nominal end as pemasukan,
	(case when c.nominal is null then 0 else c.nominal end)+(case when d.nominal is null then 0 else d.nominal end) as pengeluaran

	from siswa a
	left join (select max(bbb.id) as id,max(bbb.nama_asrama) as nama,aaa.siswa_id from asrama_siswa aaa inner join asrama bbb
	on (aaa.asrama_daftar_siswa_id=bbb.id) group by aaa.siswa_id) b211 on (b211.siswa_id = a.id)
	left join (select bbb.nama_asrama as nama,aaa.siswa_id from asrama_siswa aaa inner join asrama bbb on (aaa.asrama_daftar_siswa_id=bbb.id) group by bbb.id,aaa.siswa_id) a1 on (a.id = a1.siswa_id)

	left join (
		select siswa_id,sum(nominal) as nominal from deposit_siswa aa
		inner join siswa bb on (aa.siswa_id = bb.id)
		where date(aa.waktu) <= date($P{sampai})
		and case when $P{nis} = '' then true else bb.nomor_induk ilike '%'||$P{nis}||'%' end
		and case when $P{sekolah} = -1 then true else bb.sekolah_id = $P{sekolah} end
		and bb.yayasan_id = $P{yayasan}
		group by siswa_id
	)  b on (a.id = b.siswa_id)
	left join (
		select siswa_id,sum(nominal) as nominal from pembayaran_siswa aa
		inner join siswa bb on (aa.siswa_id = bb.id)
		where date(aa.tanggal) <= date($P{sampai})
		and case when $P{nis} = '' then true else bb.nomor_induk ilike '%'||$P{nis}||'%' end
		and case when $P{sekolah} = -1 then true else bb.sekolah_id = $P{sekolah} end
		and bb.yayasan_id = $P{yayasan}
		group by siswa_id
	)  c on (a.id = c.siswa_id)
	left join (
		select siswa_id,sum(nominal) as nominal from pembelian_siswa aa
		inner join siswa bb on (aa.siswa_id = bb.id)
		where date(aa.tanggal) <= date($P{sampai})
		and case when $P{nis} = '' then true else bb.nomor_induk ilike '%'||$P{nis}||'%' end
		and case when $P{sekolah} = -1 then true else bb.sekolah_id = $P{sekolah} end
		and bb.yayasan_id = $P{yayasan}
		group by siswa_id
	)  d on (a.id = d.siswa_id)
	where case when $P{semua} = 'Tidak' then true else (a.aktif is null or a.aktif) end
	and case when $P{kelas} = -1 then true else a.current_kelas_id = $P{kelas} end
	and case when $P{asrama} = -1 then true else b211.id = $P{asrama} end
	and case when $X{IN,-1,anaks} then true else $X{IN,a.id,anaks} end
) aa
where (aa.pengeluaran+aa.pemasukan) != 0
and case when $P{maksimal} = -1 then true else aa.pemasukan<=$P{maksimal} end
order by (case when (aa.pemasukan-aa.pengeluaran) > 0 then 'plus' else 'minus' end),aa.kelas,aa.nomor_induk,aa.tanggal]]>
	</queryString>

	<queryString>
		<![CDATA[select UPPER(a.nama_siswa) as nama,
a.nama_ayah, a.nama_ibu,
a.jenis_kelamin,UPPER(a.tempat_lahir) as tempat_lahir,a.tanggal_lahir,
UPPER(a.alamat_siswa) as alamat,UPPER(a.sekolah_asal) as asal_sma,a.nomor_induk as no_registrasi,a.noujian as no_ujian,
b.nama as p1,
c.nama as p2,

e.nama as paket,y.nama as ruang,gd.nama as gedung,

f.keterangansetelahbayar as info,

f.tanggalujian1,
f.tanggalujian2,
f.tanggalujian3,
f.tanggalujian4,
f.tanggalujian5,
f.tanggalujian6,
f.tanggalujian7,
f.tanggalujian8,
f.tanggalujian9,
f.tanggalujian10,
f.tampilkanjadwalujiandikartuujian,
f.lokasi,
e.tahun_ajaran as tahunakademik,
f.id as ujian,
a.current_gelombang_pendaftaran_psb_id as id_paket,
e.nama as nama_paket,
b1.nama as penjurusan_sekolah

from sekolah.ruang_gelombang_psb z
left join sekolah.calon_siswa a on z.calon_siswa = a.id
left join sekolah.ruang_psb y on z.ruang_psb = y.id
left join gedung gd on y.gedung = gd.id

left join sekolah.sekolah b on a.sekolah_id=b.id
left join sekolah.penjurusan_sekolah b1 on a.penjurusan_sekolah_id=b1.id
left join sekolah.yayasan c on a.yayasan_id=c.id

left join sekolah.gelombang_pendaftaran_psb e on a.current_gelombang_pendaftaran_psb_id = e.id

left join sekolah.ujian_psb f on (f.id = y.ujian_psb)

where a.id=$P{biodata_id}

order by f.id desc]]>
	</queryString>

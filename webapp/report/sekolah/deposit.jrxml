<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="struk_pembayaran" language="groovy" pageWidth="360" pageHeight="822" columnWidth="320" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="da1a1e13-e601-45e6-91b6-e0eb9a15c402">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_deposit" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[219L]]></defaultValueExpression>
	</parameter>
	<parameter name="id_bri" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="id_bni" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
(case when b.nomor_induk is null then cs.nomor_induk else b.nomor_induk end) as nomor_induk,
(case when b.nama_siswa is null then cs.nama_siswa else b.nama_siswa end) as nama_siswa,
a.waktu as tanggal,
a.sekolah_id,
a.id as id_transaksi,
a.nominal,
case when b1.nama is null then '-' else b1.nama end as kelas,
case when b4.nama is null then '-' else b4.nama end as asrama,
(case when b3.nama_pembayaran is null then '-' else b3.nama_pembayaran end) as cara,
a.waktu tanggal

from sekolah.deposit_siswa a
left join sekolah.siswa b on (a.siswa_id = b.id)
left join sekolah.calon_siswa cs on (a.calon_siswa_id = cs.id)
left join (select max(bbb.id) as id,max(bbb.nama) as nama,max(bbb.tingkat) as tingkat,aaa.siswa_id from sekolah.kelas_punya_siswa aaa inner join sekolah.kelas bbb on (aaa.kelas_id=bbb.id) group by aaa.siswa_id) b1 on (b1.siswa_id = b.id)
left join sekolah.asrama b4 on (b4.id = b.asrama_id)
left join sekolah.akun_pembayaran_siswa b3 on (b3.id = a.akun_pembayaran_siswa_id)

where case when $P{id_deposit}=-1 then true else a.id=$P{id_deposit} end]]>
	</queryString>
	<field name="nomor_induk" class="java.lang.String"/>
	<field name="nama_siswa" class="java.lang.String"/>
	<field name="tanggal" class="java.util.Date"/>
	<field name="sekolah_id" class="java.lang.Long"/>
	<field name="id_transaksi" class="java.lang.Long"/>
	<field name="nominal" class="java.lang.Double"/>
	<field name="kelas" class="java.lang.String"/>
	<field name="asrama" class="java.lang.String"/>
	<field name="cara" class="java.lang.String"/>
	<variable name="total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nominal}]]></variableExpression>
	</variable>

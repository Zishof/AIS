	<parameter name="parameter1" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
a.pertemuan_ke,
a.tanggal,
a.indikator,
b.capaianpembelajaranprodi,
b.deskripsipembelajaran,
a.waktu_mulai || '-' || a.waktu_selesai as waktu,
a.topik as materi,
a.metode_pembelajaran as metode,
a.waktupembelajaran,
'' as paraf,
(case b.semester%2 when 1 then 'Ganjil' else 'Genap' end) as jenis_semester,
c.nama_guru as nama_dosen,
c.kode as code_dosen,
d.nama as matakuliah,
(case when a.buku_rujukan1 is not null or trim(a.buku_rujukan1) != '' then a.buku_rujukan1 || ' ' else '' end) as buku_rujukan,
(case when a.buku_rujukan2 is not null or trim(a.buku_rujukan2) != '' then a.buku_rujukan2 else '' end) as buku_ref,
b.tahun_ajaran,
e.nama as kelas,
a.pengalamanbelajar,
a.tugasdanpenilaian

from pertemuan a
inner join sekolah.jadwal_pelajaran b on (a.jadwal_pelajaran = b.id)
left join sekolah.guru c on (b.guru_id = c.id)
left join sekolah.matapelajaran d on (b.matapelajaran_id = d.id)
left join sekolah.kelas e on (b.kelas_id = e.id)

where a.jadwal_pelajaran = $P{jadwalPelajaran}
order by a.tanggal,a.pertemuan_ke]]>
	</queryString>

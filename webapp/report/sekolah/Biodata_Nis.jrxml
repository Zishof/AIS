<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Biodata_Nim" pageWidth="595" pageHeight="550" orientation="Landscape" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="2cfd83d4-9fb1-4320-a3ab-ed9cb4cf9f8e">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.771561000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="nim" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String"/>
	<parameter name="foto" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="biodata_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[313L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.sekolah_id,
a.nama_siswa as nama,
a.jenis_kelamin,a.tempat_lahir,a.tanggal_lahir,
a.alamat_siswa as alamat,a.sekolah_asal as asal_sma,b.nama as prodi_1,c.nama as prodi_2,a.nomor_induk as no_registrasi,a.tanggal_lahir,
b.nama as p1,c.nama as p2, d.nama as jenjang,
f.keterangan as info,

f.tanggalujian1,
f.tanggalujian2,
f.tanggalujian3,
f.tanggalujian4,
f.tanggalujian5,
f.tanggalujian6,
f.tanggalujian7,
f.tanggalujian8,
f.tanggalujian9,
f.tanggalujian10,
f.lokasi,
f.tampilkanjadwalujiandikartuujian,
e.tahun_ajaran as tahunakademik

from sekolah.calon_siswa a

left join sekolah.sekolah b on a.sekolah_id=b.id
left join sekolah.yayasan c on a.yayasan_id=c.id
left join sekolah.jenis_sekolah d on b.jenis_sekolah_id=d.id
left join sekolah.gelombang_pendaftaran_psb e on (a.current_gelombang_pendaftaran_psb_id=e.id)

left join (select aaa.tahunakademik,aaa.gelombang_pendaftaran_psb,
	max(aaa.keterangan) as keterangan,
	max(aaa.tanggalujian1) as tanggalujian1,
	max(aaa.tanggalujian2) as tanggalujian2,
	max(aaa.tanggalujian3) as tanggalujian3,
	max(aaa.tanggalujian4) as tanggalujian4,
	max(aaa.tanggalujian5) as tanggalujian5,
	max(aaa.tanggalujian6) as tanggalujian6,
	max(aaa.tanggalujian7) as tanggalujian7,
	max(aaa.tanggalujian8) as tanggalujian8,
	max(aaa.tanggalujian9) as tanggalujian9,
	max(aaa.tanggalujian10) as tanggalujian10,
	aaa.tampilkanjadwalujiandikartuujian,
	max(aaa.lokasi) as lokasi
from sekolah.ujian_psb aaa
inner join sekolah.ruang_psb bbb on (aaa.id=bbb.ujian_psb)
group by aaa.tahunakademik,aaa.gelombang_pendaftaran_psb,aaa.tampilkanjadwalujiandikartuujian) f on (f.gelombang_pendaftaran_psb = a.current_gelombang_pendaftaran_psb_id)

where a.id=$P{biodata_id}
limit 1]]>
	</queryString>

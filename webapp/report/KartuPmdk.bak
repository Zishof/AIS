	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="biodata_id" isForPrompting="true" class="java.lang.Long"/>
	<parameter name="foto" isForPrompting="false" class="java.io.InputStream"/>
	<queryString><![CDATA[select a.nama,a.jenis_kartu_identitas_mahasiswa_baru,
a.no_identitas,a.jenis_kelamin,a.tempat_lahir,a.tanggal_lahir,
a.alamat,a.asal_sma,a.prodi_1,a.prodi_2,a.no_registrasi,a.foto,
b.nama as p1,c.nama as p2, d.nama as kartu

from biodata_calon_mahasiswa a

left join jurusan b on a.prodi_1=b.id
left join jurusan c on a.prodi_1=c.id

left join jenis_kartu_identitas_mahasiswa_baru d on a.jenis_kartu_identitas_mahasiswa_baru=d.id

where a.id=$P{biodata_id}]]></queryString>


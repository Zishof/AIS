	<queryString>
		<![CDATA[select
a.nim,
a.nama,
a.telp,
a.email,
b.nama as jurusan,
f.nama as nama_fakultas,
ff.nama as nama_perguruan_tinggi,
ff.alamat1,
ff.alamat2,
ff.telepon,
ff.faksimili,
a.kelas as kelas

from mahasiswa a
left join jurusan b on (a.jurusan = b.id)
left join fakultas f on (b.fakultas = f.id)
left join perguruan_tinggi ff on (f.perguruan_tinggi = ff.id)
where a.id = $P{mahasiswa}

union all

select
a.nidn as nim,
a.nama,
a.telp,
a.email,
b.nama as jurusan,
f.nama as nama_fakultas,
ff.nama as nama_perguruan_tinggi,
ff.alamat1,
ff.alamat2,
ff.telepon,
ff.faksimili,
a.mycode as kelas

from dosen a
left join jurusan b on (a.jurusan = b.id)
left join fakultas f on (a.fakultas = f.id)
left join perguruan_tinggi ff on (a.perguruan_tinggi = ff.id)
where a.id = $P{dosen}



union all

select
a.nomor_induk as nim,
a.nama_siswa as nama,
a.telepon_siswa as telp,
a.alamat_email as email,
b.nama as jurusan,
f.nama as nama_fakultas,
b.nama as nama_perguruan_tinggi,
b.alamat as alamat1,
b.alamat as alamat2,
b.telp as telepon,
b.fax as faksimili,
ff.nama as kelas

from sekolah.siswa a
left join sekolah.sekolah b on (a.sekolah_id = b.id)
left join sekolah.yayasan f on (a.yayasan_id = f.id)
left join sekolah.kelas ff on (a.current_kelas_id = ff.id)
where a.id = $P{siswa}


union all

select
a.kode as nim,
a.nama_guru as nama,
a.telepon_guru as telp,
a.alamat_email as email,
b.nama as jurusan,
f.nama as nama_fakultas,
b.nama as nama_perguruan_tinggi,
b.alamat as alamat1,
b.alamat as alamat2,
b.telp as telepon,
b.fax as faksimili,
'' as kelas

from sekolah.guru a
left join sekolah.sekolah b on (a.sekolah_id = b.id)
left join sekolah.yayasan f on (a.yayasan_id = f.id)
where a.id = $P{guru}]]>
	</queryString>

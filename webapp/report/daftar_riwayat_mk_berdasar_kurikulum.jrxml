	<variable name="sum_sks" class="java.lang.Integer" resetType="Group" resetGroup="semester" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_val" class="java.lang.Double" resetType="Group" resetGroup="semester" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_nilai" class="java.lang.Double" resetType="Group" resetGroup="semester" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>
	<variable name="sum_nilai_sks" class="java.lang.Double" resetType="Group" resetGroup="semester" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_sks_total" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_val_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="KTN" class="java.lang.Double" resetType="Group" resetGroup="semester" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}.doubleValue()*$F{nilai_ipk}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="ktn_total" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}.doubleValue()*$F{nilai_ipk}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_sks_total_1" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}>0.1 ? $F{sks} : 0.0]]></variableExpression>
	</variable>
	<variable name="sum_sks_total_pilihan" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_matakuliah}!=null&&$F{jenis_matakuliah}.toLowerCase().contains( "pilihan" ) ? $F{sks} : 0.0]]></variableExpression>
	</variable>
	<variable name="sum_sks_total_wajib" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_matakuliah}!=null&&$F{jenis_matakuliah}.toLowerCase().contains( "wajib" ) ? $F{sks} : 0.0]]></variableExpression>
	</variable>
	<variable name="sum_sks_mk" class="java.lang.Integer" resetType="Group" resetGroup="semester" calculation="Sum">
		<variableExpression><![CDATA[$F{sks_mk}]]></variableExpression>
	</variable>
	<variable name="sum_sks_total_wajib_1" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_mk}!=null&&$F{jenis_mk}.toLowerCase().contains( "wajib" ) ? $F{sks_mk} : 0.0]]></variableExpression>
	</variable>
	<variable name="sum_sks_total_pilihan_1" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_mk}!=null&&$F{jenis_mk}.toLowerCase().contains( "pilihan" ) ? $F{sks_mk} : 0.0]]></variableExpression>
	</variable>
	<variable name="sum_sks_total_1_2" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks_mk}]]></variableExpression>
	</variable>

	<queryString>
		<![CDATA[select
bool_or(aaa.lulus) as lulus,
a.*, c.sks as sks_mk, c.kode as kode_mk,c.nama as nama_mk, c.status as jenis_mk,b.semester,
(case when jj.code is null or jj.code = '' then 'NIDN: '||jj.nidn else 'NIP: '||jj.code end) as nip_pudek1,
(jj.nama) as nama_pudek1,
(case when ii.code is null or ii.code = '' then 'NIDN: '||ii.nidn else 'NIP: '||ii.code end) as nip_kaprodi,
(ii.nama) as nama_kaprodi

from kurikulum_punya_matakuliah b
inner join matakuliah c on (b.matakuliah=c.id)
left join kurikulum k on (b.kurikulum=k.id)
left join jurusan j on (k.jurusan = j.id)
left join fakultas f on (f.id = j.fakultas)

left join dosen ii on (j.kaprodi = ii.id)
left join dosen jj on (f.pudek1 = jj.id)
left join (

select

(c.nama) as nama_mahasiswa,
(e.nama) as nama_fakultas,
(c.waktu_kuliah) as waktu_kuliah,
(f.jenis_matakuliah) as jenis_matakuliah,
(c.nim) as nim,
(c.tempatlahir) || ', ' || (c.tanggallahir) as tanggal_lahir,
(c.kelamin) as kelamin,
(g.nama) as jenjang,
(d.nama) as nama_jurusan,
(f.kode) as kode_matakuliah,
(f.nama) as nama_matakuliah,
(f.sks) as sks,
(a.nilai_huruf) as nilai_huruf,
(a.nilai_ip) as nilai_ipk,
(a.total_nilai) as total_nilai,
(c.tanggal_lulus) as tanggal_lulus,
(l.judul) as judul,
case when upper(trim((a.nilai_huruf))) = 'A' or upper(trim((a.nilai_huruf))) = 'B' or upper(trim((a.nilai_huruf))) = 'C' then 'LULUS' else 'TIDAK LULUS' end as status,


(a.tahunakademik) as tahun_ajaran,

(c.tahunangkatan)  as tahunangkatan,
(d1.nama) as dosen_pa,
(d1.code) as nip_dosen_pa,
(c.program) as program,
(select count(*) from detailperkuliahan aaa inner join perkuliahan bbb on (aaa.perkuliahan=bbb.id) inner join matakuliah ccc on (bbb.matakuliah=ccc.id) where aaa.mahasiswa=c.id and ccc.kode=f.kode and aaa.id!=a.id and aaa.semester<a.semester) as ngulang

from mahasiswa c
left join dosen d1 on (c.dosen = d1.id)
left join skripsi l on (c.id = l.mahasiswa)
left join detailperkuliahan a  on (a.mahasiswa = c.id)
left join perkuliahan b on (a.perkuliahan = b.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join
(
	select aa.id as id,
	max(case when cc.id is null then aa.kode else cc.kode end) as kode,
	max(case when cc.id is null then aa.status else cc.status end) as jenis_matakuliah,
	max(case when cc.id is null then aa.nama else cc.nama end) as nama,
	max(case when cc.id is null then aa.sks else cc.sks end) as sks
	from matakuliah aa
	left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
	left join matakuliah cc on(bb.matakuliah = cc.id) where (aa.extrakulikuler is null or aa.extrakulikuler = false)
	group by aa.id
) f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
left join jenjang g on (g.id = c.jenjang)
left join (
	select aa.nama, aa.nip, aa.jurusan
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kaprodi%'
) h on (h.jurusan = c.jurusan)
where a.mahasiswa = $P{mahasiswa}
) as a on (trim(upper(a.kode_matakuliah)) = trim(upper(c.kode)))
where b.kurikulum=$P{kurikulum}
and b.aktif
order by b.semester,c.nama]]>
	</queryString>

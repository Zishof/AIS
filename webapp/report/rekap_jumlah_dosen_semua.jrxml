	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Reguler"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2010/2011"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(b.nama) as fakultas,
max(c.nama) as jurusan,
sum(case when a.tetap = '1' and a.kelamin ilike 'Laki-laki' then 1 else 0 end) as tetaplk,
sum(case when a.tetap = '1' and a.kelamin ilike 'Perempuan' then 1 else 0 end) as tetappr,
sum(case when a.tetap = '0' and a.kelamin ilike 'Laki-laki' then 1 else 0 end) as tdktetaplk,
sum(case when a.tetap = '0' and a.kelamin ilike 'Perempuan' then 1 else 0 end) as tdktetappr,
sum(case when (a.tetap = '1' or a.tetap = '0') and (a.kelamin ilike 'Perempuan' or a.kelamin ilike 'Laki-laki') then 1 else 0 end) as total
from
(

select max(a.nama) as nama
,max(a.fakultas) as fakultas,
max(a.jurusan) as jurusan,
max(a.tetap) as tetap,
max(a.kelamin) as kelamin
from perkuliahan aa
inner join dosen a on (aa.dosen1 = a.id or aa.dosen2 = a.id  or aa.dosen3 = a.id  or aa.dosen4 = a.id  or aa.dosen5 = a.id  or aa.dosen6 = a.id  or aa.dosen7 = a.id  or aa.dosen8 = a.id  or aa.dosen9 = a.id or aa.dosen10 = a.id)
where case $P{semester} when '-1' then true when 'Ganjil' then aa.ganjil_genap = 'Ganjil' else aa.ganjil_genap = 'Genap' end
and case $P{tahun_akademik} when '-1' then true else aa.tahun_ajaran = $P{tahun_akademik} end
group by a.id
) a
left join fakultas b on (a.fakultas=b.id)
left join jurusan c on (a.jurusan=c.id)
where
case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{fakultas} = -1 then true else c.fakultas = $P{fakultas} end
group by a.jurusan
order by max(b.nama), max(c.nama)]]>
	</queryString>

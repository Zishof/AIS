	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="ta" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2016/2017"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
aaa.id_dosen,
max(aaa.dosen) as dosen,
aaa.bidang_kinerja,
aaa.subbidang,
aaa.judul as judul,
avg(aaa.sks_beban) as sks_beban,
avg(aaa.sks_nilai) as sks
from (
	select
	a.bidang as bidang_kinerja,
 	a.spesifikasi as subbidang,
 	a1.dosen id_dosen,
	a1.nama as dosen,
 	a2.nama as asesor,
 	a2.id as asesor_id,
	a3.sks_kinerja sks_nilai,
	a.sks_beban,

 	a.keterangan as judul

 	from asesemen_penilaian a
	inner join pegawai a1 on (a.pegawai=a1.id)
	left join penilaian_asesor a3 on (a3.asesemen_penilaian = a.id)
	left join asesor a4 on (a3.asesor = a4.id)
	left join asesor_penunjang_kinerja_dosen a2 on (a4.asesor_penunjang_kinerja_dosen=a2.id)

	where a2.aktif and a.aktif
	and a.tahunakademik=$P{ta}
	and a.semester=$P{semester}
	and case when $P{dosen}=-1 then true else a.pegawai=$P{dosen} end
) aaa
group by aaa.id_dosen,aaa.bidang_kinerja,aaa.subbidang,aaa.judul
order by aaa.id_dosen,aaa.bidang_kinerja,aaa.subbidang,aaa.judul]]>
	</queryString>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Kursi_Wisuda" pageWidth="396" pageHeight="340" orientation="Landscape" columnWidth="356" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select m.nim, m.nama,
	j.nama as jurusan, f.nama as fakultas, pw.no_kursi, pw.no_registrasi_wisuda, w.wisuda_ke
from pendaftaran_wisuda pw
inner join mahasiswa m on (pw.mahasiswa = m.id)
inner join jurusan j on (m.jurusan = j.id)
inner join fakultas f on (j.fakultas = f.id)
left join wisuda w on (w.id = pw.wisuda)
where pw.mahasiswa=$P{mahasiswa}]]>
	</queryString>
	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="no_kursi" class="java.lang.String"/>
	<field name="no_registrasi_wisuda" class="java.lang.String"/>
	<field name="wisuda_ke" class="java.lang.Integer"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="259" splitType="Stretch">
			<image>
				<reportElement key="image-1" x="0" y="0" width="69" height="66"/>
				<imageExpression class="java.lang.String"><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-2" x="0" y="82" width="356" height="22"/>
				<textElement textAlignment="Left">
					<font size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Selamat, Anda telah terdaftar di Wisuda ke "+$F{wisuda_ke}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement key="staticText-1" x="0" y="104" width="90" height="18"/>
				<textElement/>

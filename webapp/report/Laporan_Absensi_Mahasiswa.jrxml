	<queryString>
		<![CDATA[select
max(a.nim) as nim,
max(a.nama) as nama,
sum(case when b.statusabsensi = 1 then 1 else 0 end) as masuk,
sum(case when b.statusabsensi = 2 then 1 else 0 end) as alpa,
sum(case when b.statusabsensi = 3 then 1 else 0 end) as sakit,
sum(case when b.statusabsensi = 4 then 1 else 0 end) as izin,
sum(case when b.statusabsensi = 5 then 1 else 0 end) as belum,

'Matakuliah: ' || max(a3.nama) || ', Dosen: ' || max(a5.nama) || (case when max(a6.nama) is null then '' else ', ' || max(a6.nama) end) || ', Ruang: ' || max(a7.nama) as matakuliah,
max(c.nama) as jurusan,
max(d.nama) as fakultas

from mahasiswa a
inner join detailperkuliahan a1 on (a.id = a1.mahasiswa)
inner join perkuliahan a2 on (a1.perkuliahan = a2.id)
inner join matakuliah a3 on (a3.id = a2.matakuliah)
inner join pertemuan a4 on (a2.id = a4.perkuliahan)

left join dosen a5 on (a5.id = a2.dosen1)
left join dosen a6 on (a6.id = a2.dosen2)
left join ruang a7 on (a7.id = a2.ruang)

left join statuskehadiran b on (a.id = b.mahasiswa and a4.id = b.pertemuan)
left join jurusan c on (a.jurusan = c.id)
left join fakultas d on (c.fakultas = d.id)


where 1=1
and case when $P{fakultas} = -1 then true else c.fakultas = $P{fakultas} end
and case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{dosen} = -1 then true else (a2.dosen1 = $P{dosen} or  a2.dosen2 = $P{dosen}) end
group by a2.id,a.id
having max(a2.tahun_ajaran) = $P{tahun_akademik}
and max(a2.semester) = $P{semester}
order by fakultas,jurusan,matakuliah,nim]]>
	</queryString>

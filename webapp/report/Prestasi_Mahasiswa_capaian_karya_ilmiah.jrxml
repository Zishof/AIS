	<queryString>
		<![CDATA[select
a.nama,
a.judul_skripsi,
a.tempatlahir,
a.tanggallahir,
a.nim,
a.tanggal_masuk,
a.tanggal_lulus,
b.gelar,
b.nama as jurusan,
a.no_ijazah1,
c.nama as karya,c.nomorsertifikat,c.tahun,c.tanggal, c.capaian, c.tanggalselesai,
d.nama as kategori,
e.pembimbing, e.ketua_sidang,
a.jurusan as jurusan_id,
a.tahunlulus
from mahasiswa a
left join skripsi e on (e.mahasiswa = a.id)
inner join jurusan b on (a.jurusan=b.id)
inner join prestasi_mahasiswa c on (c.mahasiswa=a.id)
inner join cabang_prestasi_mahasiswa d on (c.cabang_prestasi_mahasiswa=d.id)
where  a.id=$P{mahasiswa_id} and d.nama='Karya Ilmiah'
and c.status='Disetujui']]>
	</queryString>

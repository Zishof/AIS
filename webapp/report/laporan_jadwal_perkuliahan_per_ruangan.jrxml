	<parameter name="jumat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Jum'at"]]></defaultValueExpression>
	</parameter>
	<parameter name="masa_perkuliahan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="semester_pendek" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="ekstrakurikuler" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.hari,
a.waktu_mulai || '-' || a.waktu_selesai as waktu,
(case when m.id is null then '' else m.nama end) as waktu_perkuliahan,
a.semester,
case when (case when a1.kode_ruangan is null then a1.nama else a1.kode_ruangan end) is null then 'Tanpa Ruang' else (case when a1.kode_ruangan is null then a1.nama else a1.kode_ruangan end) end as ruang,
b.nama || (case when b2.nama is null then '' else ', ' || b2.nama end) as nama,
(case when b1.id is null then b.golongan else b1.nama || '/' || b.golongan end) as golongan,
c.nama as matakuliah,
c.kode as kode_matakuliah,
c.sks,
a.kelas,
a.ganjil_genap as jenis_semester,
a.tahun_ajaran,
e.nama as fakultas,
d.nama as jurusan

from perkuliahan a
left join ruang a1 on (a1.id = a.ruang)
left join dosen b on (a.dosen1 = b.id)
left join dosen b2 on (a.dosen2 = b2.id)
left join jabatan b1 on (b.spesifikasi_jabatan = b1.id)
left join matakuliah c on (a.matakuliah = c.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)
left join masa_perkuliahan m on (a.masa_perkuliahan=m.id)

where case  $P{semester} when '-1' then true else a.ganjil_genap=$P{semester} end
and case $P{tahun_akademik} when '-1' then true else a.tahun_ajaran = $P{tahun_akademik} end
and case $P{masa_perkuliahan} when -1 then true else a.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then a.status_semesterpendek is null else a.status_semesterpendek = $P{semester_pendek} end
and case $P{ekstrakurikuler} when -1 then c.extrakulikuler = false else c.extrakulikuler end
and case $P{jurusan} when -1 then true else a.jurusan = $P{jurusan} end
and case $P{fakultas} when -1 then true else a.jurusan in (select id from jurusan where fakultas = $P{fakultas}) end
and case $P{ruang} when -1 then true else a.ruang = $P{ruang} end
order by case when a1.kode_ruangan is null then a1.nama else a1.kode_ruangan end, case a.hari when 'Senin' then 1 when 'Selasa' then 2 when 'Rabu' then 3 when 'Kamis' then 4 when 'Jumat' then 5  when $P{jumat} then 5 when 'Sabtu' then 6 when 'Minggu' then 7 end,
a.waktu_mulai_d,a.waktu_selesai_d,c.nama]]>
	</queryString>

		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Reguler"]]></defaultValueExpression>
	</parameter>
	<parameter name="tampilkanHanyaYangSudahDisetujui" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.wisuda_ke,
c.nim,
c.nama,
b.no_registrasi_wisuda,
b.no_kursi,
d.nama as jurusan,
e.nama as fakultas

from wisuda a
left join pendaftaran_wisuda b on (a.id = b.wisuda)
left join mahasiswa c on (b.mahasiswa = c.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (d.fakultas = e.id)


where a.id = $P{wisuda}
and case when $P{fakultas} = -1 then true else d.fakultas = $P{fakultas} end
and case when $P{jurusan} = -1 then true else c.jurusan = $P{jurusan} end
and case when $P{tampilkanHanyaYangSudahDisetujui} = 0 then true else b.persetujuan_wisuda end
order by e.nama,d.nama,c.nim]]>
	</queryString>

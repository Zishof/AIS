		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="semester_pendek" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="ekstrakurikuler" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
c.id as dosenid,
a.waktu_mulai,
a.waktu_selesai,
b.nama as mk,
c.nama as dosen,
c.pangkat,
a.semester,
b.sks,
a.kelas,
cc.nama as ruang,
e.nama as nama_fakultas,
e.nama as fakultas,
d.nama as jurusan,
a.hari,
z.id as id_paralel,
zz.peserta
from perkuliahan a
left join matakuliah b on (a.matakuliah = b.id)
left join ruang cc on (a.ruang = cc.id)
inner join dosen c on (a.dosen1 = c.id or a.dosen2 = c.id  or a.dosen3 = c.id  or a.dosen4 = c.id  or a.dosen5 = c.id  or a.dosen6 = c.id  or a.dosen7 = c.id  or a.dosen8 = c.id  or a.dosen9 = c.id or a.dosen10 = c.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)
left join perkuliahan z on (z.perkuliahan_paralel=a.id)
left join (select count(*) as peserta, zz.perkuliahan from detailperkuliahan zz where zz.perkuliahan is not null group by zz.perkuliahan) as zz on (zz.perkuliahan = a.id or zz.perkuliahan = z.id)
where
case when $P{dosen} = -1 then true else c.id = $P{dosen} end
and CASE $P{genapGanjil} when 'Semua' then true else a.ganjil_genap = $P{genapGanjil} end
and case when  $P{program} = 'Semua' then true else a.program = $P{program} end
and case when $P{jenis_semester} = 'Semua' then true else a.ganjil_genap = $P{jenis_semester} end
and a.tahun_ajaran=$P{tahun_ajaran}
and case when $P{jurusan} = -1 then true else d.id = $P{jurusan} end
and case when $P{fakultas} = -1 then true else e.id = $P{fakultas} end
and case when $P{kelas} = '-1' then true else a.kelas ilike $P{kelas} end
and case $P{masa_perkuliahan} when -1 then true else a.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then a.status_semesterpendek is null else a.status_semesterpendek = $P{semester_pendek} end
and case $P{ekstrakurikuler} when -1 then b.extrakulikuler = false else b.extrakulikuler end
order by
d.fakultas,a.jurusan,
c.nama||c.id,
(case a.hari when 'Senin' then 1 when 'Selasa' then 2 when 'Rabu' then 3 when 'Kamis' then 4 when 'Jumat' then 5  when $P{jumat} then 5 when 'Sabtu' then 6 when 'Minggu' then 7 end),(a.waktu_mulai_d)]]>
	</queryString>

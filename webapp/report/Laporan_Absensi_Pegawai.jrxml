	<queryString>
		<![CDATA[select
max(a.code) as nip,
max(a.nama) as nama,
sum(case when b.statusabsensi = 1 then 1 else 0 end) as masuk,
sum(case when b.statusabsensi = 2 then 1 else 0 end) as alpa,
sum(case when b.statusabsensi = 3 then 1 else 0 end) as sakit,
sum(case when b.statusabsensi = 4 then 1 else 0 end) as izin,
sum(case when b.statusabsensi = 5 then 1 else 0 end) as belum,
max(d.nama) as satuan_kerja

from pegawai a
left join status_kehadiran_karyawan_harian b on (a.id = b.pegawai)
left join rab.satuan_kerja d on (a.satuan_kerja = d.id)

where 1=1
and case when $P{pegawai} = -1 then true else a.id = $P{pegawai} end
and case when $P{satuan_kerja} = -1 then true else a.satuan_kerja = $P{satuan_kerja} end
and b.bulan = $P{bulan}
and b.tahun = $P{tahun}
and b.minggu in ($P{hari1},$P{hari2},$P{hari3},$P{hari4},$P{hari5},$P{hari6},$P{hari7})
group by a.id
order by satuan_kerja,nama]]>
	</queryString>

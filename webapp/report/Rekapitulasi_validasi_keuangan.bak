		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="df" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer("1")]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" isForPrompting="true" class="java.lang.Long"/>
	<parameter name="tahun_akademik" isForPrompting="true" class="java.lang.String"/>
	<parameter name="tahun_angkatan" isForPrompting="false" class="java.lang.Integer"/>
	<parameter name="logo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select b.nama,b.tahunangkatan,c.nama as jurusan,d.nama as fakultas,a.tahun_akademik,b.jurusan,
b.nim,f.nama_kegiatan,a.tanggal

from kegiatan a
left join mahasiswa b on a.mahasiswa=b.id
left join jurusan c on b.jurusan=c.id
left join fakultas d on c.fakultas=d.id
left join jenis_kegiatan_detail e on a.jenis_kegiatan_detail=e.id
left join jenis_kegiatan f on e.jenis_kegiatan=f.id

where a.validated=1 and b.jurusan=$P{jurusan}
and a.tahun_akademik=$P{tahun_akademik}]]></queryString>

	<field name="nama" class="java.lang.String"/>
	<field name="tahunangkatan" class="java.lang.Integer"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="tahun_akademik" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_kegiatan" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>


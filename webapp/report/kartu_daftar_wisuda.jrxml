<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="kartu_daftar_beasiswa" language="groovy" pageWidth="595" pageHeight="868" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="5" bottomMargin="5" uuid="e4f71ccf-8b58-44a4-9db4-0b3f76db9bb6">
	<property name="ireport.zoom" value="1.4641000000000133"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="476"/>
	<parameter name="id_mahasiswa" class="java.lang.Long"/>
	<parameter name="id_pendaftaran_wisuda" class="java.lang.Long"/>
	<parameter name="logo1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="current_ta" class="java.lang.String"/>
	<parameter name="current_semester" class="java.lang.String"/>
	<parameter name="semester" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="judisium" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT a.mahasiswa,
b.nim as nim,
b.nama as nama,
b.tempatlahir as tempatlahir,
b.tanggallahir as tanggallahir,
b.tanggal_masuk,
b.kelamin as kelamin,
b.tahunangkatan as tahunangkatan,
b.email,
b.telp,
b.alamat,
b.batas_studi,
i.rt, i.rw,i.dusun, i.kelurahan, j.nama as kecamatan, k.nama as kota,
concat(b.alamat, i.dusun,', RT ' ,i.rt, ' RW ', i.rw, ', ' , i.kelurahan, ', ' , j.nama, ', ', k.nama )as alamat_lengkap,

e.nama as jurusan,
d.nama as fakultas,

b.ktp as ktp ,
c.moto as wisuda,
c.wisuda_ke,
b.predikat_kelulusan,
f.judisium as yudisium,
f.nilai_mulai as yudisium_nilai_mulai,

b.tanggal_yudisium,
b.no_akta1 as sk1,
b.no_akta2 as sk2,
b.skDo as no_sk,
coalesce(b.tanggal_lulus, m.tanggal_sidang, js.mulai) as tanggal_lulus,
case
	when b.tanggal_masuk is null
		or coalesce(b.tanggal_lulus, m.tanggal_sidang, js.mulai) is null
		or coalesce(b.tanggal_lulus, m.tanggal_sidang, js.mulai)::date < b.tanggal_masuk::date
	then ''
	else concat(
		extract(year from age(coalesce(b.tanggal_lulus, m.tanggal_sidang, js.mulai)::date, b.tanggal_masuk::date))::int, ' tahun ',
		extract(month from age(coalesce(b.tanggal_lulus, m.tanggal_sidang, js.mulai)::date, b.tanggal_masuk::date))::int, ' bulan ',
		extract(day from age(coalesce(b.tanggal_lulus, m.tanggal_sidang, js.mulai)::date, b.tanggal_masuk::date))::int, ' hari'
	)
end as masa_studi,
m.judul as judul_skripsi,
h.nama as asal_sekolah,
i.nama_ayah,
i.nama_ibu,
(select kl.ipk
	from krs_mahasiswa kl
	where kl.mahasiswa = b.id
		and kl.semester = case when b.semesterlulus is not null then b.semesterlulus else 9 end
	order by kl.id desc
	limit 1) as ipk,
d1.nama as pembimbing1,
m.pembimbing as id_pembimbing1,
m.pembimbing2 as id_pembimbing2,
m.pembimbing3 as id_pembimbing3,
m.pembimbing4 as id_pembimbing4,
m.pembimbing5 as id_pembimbing5,
m.penguji1 as id_penguji1,
m.penguji2 as id_penguji2,
m.penguji3 as id_penguji3,
m.penguji4 as id_penguji4,
d2.nama as pembimbing2,

a.tanggal_daftar_wisuda as tanggal_daftar,
a.no_kursi as no_kursi,
a.no_registrasi_wisuda as no_registrasi_wisuda,

case when a.persetujuan_wisuda then 'Disetujui' else 'Belum Disetujui' end as status_pendaftaran,
case when a.status_persetujuan_administrasi=1 then 'Disetujui' else 'Belum Disetujui' end as status_persetujuan_administrasi,
case when a.status_persetujuan_keuangan=1 then 'Disetujui' else 'Belum Disetujui' end as status_persetujuan_keuangan,
case when a.status_persetujuan_administrasi_fakultas=1 then 'Disetujui' else 'Belum Disetujui' end as status_persetujuan_administrasi_fakultas,
case when a.status_persetujuan_perpustakaan_fakultas=1 then 'Disetujui' else 'Belum Disetujui' end as status_persetujuan_perpustakaan_fakultas,
case when a.status_persetujuan_perpustakaan=1 then 'Disetujui' else 'Belum Disetujui' end as status_persetujuan_perpustakaan


FROM pendaftaran_wisuda a
left JOIN mahasiswa b on a.mahasiswa=b."id"
left join wisuda c on a.wisuda = c."id"
left join jurusan e on b.jurusan = e."id"
left join fakultas d on e.fakultas = d."id"
left join judisium f on  f.id = b.predikat_kelulusan
left join biodata_calon_mahasiswa g on b.biodata_calon_mahasiswa_long = g.id
left join biodata_mahasiswa i on i.id = (
	select max(bm.id) from biodata_mahasiswa bm where bm.mahasiswa = b.id
)
left join nama_sekolah_asal h on i.nama_sekolah_asal = h.id
left join wilayah j on i.kecamatan_wilayah = j.id
left join Kota k on i.kota = k.id
left join skripsi m on m.id = coalesce(a.skripsi, (
	select sm.id
	from skripsi sm
	where sm.mahasiswa = b.id
	order by case when sm.tanggal_sidang is null then 1 else 0 end,
		sm.tanggal_sidang desc nulls last,
		sm.id desc
	limit 1
))
left join jadwal_sidang_tugas_akhir js on js.id = m.jadwal_sidang_tugas_akhir
left join dosen d1 on d1.id = m.pembimbing
left join dosen d2 on d2.id = m.ketua_sidang

where a.id = $P{id_pendaftaran_wisuda}]]>
	</queryString>

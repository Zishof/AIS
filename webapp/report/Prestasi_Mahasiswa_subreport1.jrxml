	<parameter name="mahasiswa_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select a.nama,
	a.id,
	b.nama as jenjang from mahasiswa a left join jenjang b on a.jenjang = b.id where a.id=$P{mahasiswa_id}]]>
	</queryString>

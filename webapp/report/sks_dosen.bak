	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="jumlah_sks" class="java.lang.Long"/>
	<field name="jabatan" class="java.lang.String"/>
	<field name="eq_sks" class="java.lang.Integer"/>
	<field name="fakultas_dosen" class="java.lang.String"/>

	<variable name="sum_sks" class="java.lang.Long" resetType="Group" resetGroup="dosen1" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_sks}]]></variableExpression>
	</variable>


	<queryString>
		<![CDATA[select
max(a.code) as nip,
max(a.nama) as nama,
sum(case when b.statusabsensi = 1 then 1 else 0 end) as masuk,
sum(case when b.statusabsensi = 2 then 1 else 0 end) as alpa,
sum(case when b.statusabsensi = 3 then 1 else 0 end) as sakit,
sum(case when b.statusabsensi = 4 then 1 else 0 end) as izin,
sum(case when b.statusabsensi = 5 then 1 else 0 end) as belum,

max(c.nama) as jurusan,
max(d.nama) as fakultas

from dosen a
left join status_kehadiran_karyawan_harian b on (a.id = b.dosen)
left join jurusan c on (a.jurusan = c.id)
left join fakultas d on (a.fakultas = d.id)


where 1=1
and case when $P{fakultas} = -1 then true else a.fakultas = $P{fakultas} end
and case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{dosen} = -1 then true else a.id = $P{dosen} end
and b.bulan = $P{bulan}
and b.tahun = $P{tahun}
and b.minggu in ($P{hari1},$P{hari2},$P{hari3},$P{hari4},$P{hari5},$P{hari6},$P{hari7})
group by a.id
order by fakultas,jurusan,nama]]>
	</queryString>

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="595" pageHeight="900" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="589"/>
	<subDataset name="dataset1"/>
	<parameter name="menimbang" class="java.lang.String"/>
	<parameter name="mengingat" class="java.lang.String"/>
	<parameter name="memperhatikan" class="java.lang.String"/>
	<parameter name="idkenaikan" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT
     pegawai."id" AS pegawai_id,
     pegawai."alamat" AS pegawai_alamat,
     pegawai."code" AS pegawai_code,
     pegawai."email" AS pegawai_email,
     pegawai."golongan" AS pegawai_golongan,
     pegawai."jabatan" AS pegawai_jabatan,
     pegawai."kelamin" AS pegawai_kelamin,
     pegawai."mycode" AS pegawai_mycode,
     pegawai."nama" AS pegawai_nama,
     pegawai."pangkat" AS pegawai_pangkat,
     pegawai."spesialisasi1" AS pegawai_spesialisasi1,
     pegawai."spesialisasi2" AS pegawai_spesialisasi2,
     pegawai."spesialisasi3" AS pegawai_spesialisasi3,
     pegawai."tanggal_dirubah" AS pegawai_tanggal_dirubah,
     pegawai."tanggallahir" AS pegawai_tanggallahir,
     pegawai."telp" AS pegawai_telp,
     pegawai."tempatlahir" AS pegawai_tempatlahir,
     pegawai."tetap" AS pegawai_tetap,
     pegawai."fakultas" AS pegawai_fakultas,
     pegawai."jurusan" AS pegawai_jurusan,
     pegawai."spesifikasi_jabatan" AS pegawai_spesifikasi_jabatan,
     pegawai."ktp" AS pegawai_ktp,
     pegawai."status_pegawai" AS pegawai_status_pegawai,
     pegawai."unit_kerja" AS pegawai_unit_kerja,
     pegawai."satuan_kerja" AS pegawai_satuan_kerja,
     kenaikan_pangkat."masa_kerja_bulan" AS kenaikan_pangkat_masa_kerja_bulan,
     kenaikan_pangkat."masa_kerja_tahun" AS kenaikan_pangkat_masa_kerja_tahun,
     kenaikan_pangkat."no_surat_usul" AS kenaikan_pangkat_no_surat_usul,
     kenaikan_pangkat."tanggal_surat_usul" AS kenaikan_pangkat_tanggal_surat_usul,
     kenaikan_pangkat."tanggal_dirubah" AS kenaikan_pangkat_tanggal_dirubah,
     golongan."nama" AS golongan_nama,
     gaji_pokok."gaji" AS gaji_pokok_gaji,
     gaji_pokok."masakerja" AS gaji_pokok_masakerja
FROM
     "public"."pegawai" pegawai INNER JOIN "employ"."kenaikan_pangkat" kenaikan_pangkat ON pegawai."id" = kenaikan_pangkat."pegawai"
     INNER JOIN "employ"."golongan" golongan ON pegawai."golongan_pegawai" = golongan."id"
     INNER JOIN "employ"."gaji_pokok" gaji_pokok ON golongan."id" = gaji_pokok."golongan"
WHERE kenaikan_pangkat.Id = $P{idkenaikan};]]>
	</queryString>

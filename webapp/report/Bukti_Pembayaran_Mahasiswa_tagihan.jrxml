	</parameter>
	<queryString>
		<![CDATA[select
(b.kode) as kode,
max(b.nama) item_biaya,
max(a1.biaya) as tagihan,
max(a1.diskon) as diskon,
max(a1.biaya - a1.diskon) as biaya,
max(d.nim) as nim,
max(d.nama) as nama_mahasiswa,
max(e.nama) as nama_jurusan,
max(f.nama) as nama_fakultas,
max(c.semster) as semester,
max(c.tahun_akademik) as tahun_ajaran,
max(g.nama_kegiatan) as nama_kegiatan,
max(c.ref_number) as ref_number,
max(c.program) as program,
max(c.validator) as validator,
max(a1.keterangan || (case when a1.uraian is null or trim(a1.uraian)='' then '' else ' '||a1.uraian end)) as keterangan1,
max(c.keterangan) as keterangan

from detail_kegiatan a1
left join detail_biaya a on (a.id = a1.detail_biaya)
left join item_biaya b on (a.item_biaya = b.id)
left join kegiatan c on (a1.kegiatan = c.id)
left join mahasiswa d on (c.mahasiswa = d.id)
left join jurusan e on (d.jurusan = e.id)
left join fakultas f on (e.fakultas = f.id)
left join jenis_kegiatan g on (c.jenis_kegiatan = g.id)

where c.id = $P{kegiatan}
and case when $X{IN,-1,detailKegiatans} then false else $X{IN,a1.id,detailKegiatans} end
and (a1.biaya != 0.0)
group by b.kode]]>
	</queryString>

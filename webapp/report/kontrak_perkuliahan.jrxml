	</parameter>
	<queryString>
		<![CDATA[select
a.pertemuan_ke,
a.tanggal,
a.waktu_mulai || '-' || a.waktu_selesai as waktu,
a.topik as materi,
a.catatan as catatan,
a.metode_pembelajaran as metode,
'' as paraf,
(case b.semester%2 when 1 then 'Ganjil' else 'Genap' end) as jenis_semester,
c.nama||(case when c1.nama is not null then ', '||c1.nama else '' end) as nama_dosen,
c.code||(case when c1.code is not null then ', '||c1.code else '' end) as code_dosen,
d.nama as mahasiswa,
trim((case when a.buku_rujukan1 is not null or trim(a.buku_rujukan1) != '' then a.buku_rujukan1 || ' ' else '' end) || (case when a.buku_rujukan2 is not null or trim(a.buku_rujukan2) != '' then a.buku_rujukan2 else '' end)) as buku_rujukan,
e.nama as nama_jurusan,
f.nama as fakultas,
b.tahun_akademik tahun_ajaran,
i.code as nip_kaprodi,
i.nama as nama_kaprodi,
b.judul

from pertemuan a
inner join mahasiswa_request_tugas_akhir b on (a.mahasiswa_request_tugas_akhir = b.id)
inner join mahasiswa d on (b.mahasiswa=d.id)
left join dosen c on (b.dosen1 = c.id)
left join dosen c1 on (b.dosen2 = c1.id)
left join jurusan e on e.id = d.jurusan
left join fakultas f on f.id = e.fakultas
left join dosen i on (e.kaprodi = i.id)

where a.mahasiswa_request_tugas_akhir = $P{perkuliahan}
order by a.tanggal,a.pertemuan_ke]]>
	</queryString>

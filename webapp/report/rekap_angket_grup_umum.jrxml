	<parameter name="grupKuesionerUmum" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.id as checklist,b.isi, b.diperuntukkan, c.tbmuser, tb.usernama
from jadwal_checklist_penilaian_umum a
inner join grup_checklist_penilaian_umum b on (a.grup_penilaian_umum=b.id)
inner join grup_kuosioner_umum_detail c on (a.grup_kuesioner_umum = c.grup_kuesioner_umum)
inner join tbmuser tb on (tb.userid=c.tbmuser)
where (b.aktif or b.aktif is null) and a.tahunakademik=$P{tahun_akademik} and a.semester=$P{genapGanjil}
and a.grup_kuesioner_umum is not null
and case when $P{grupKuesionerUmum}=-1 then true else a.grup_kuesioner_umum=$P{grupKuesionerUmum} end
 and (b.aktif or b.aktif is null)
order by c.tbmuser]]>
	</queryString>

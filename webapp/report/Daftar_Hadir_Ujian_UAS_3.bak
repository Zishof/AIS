		<defaultValueExpression ><![CDATA["Siti"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nip" isForPrompting="false" class="java.lang.String"/>
	<parameter name="kode_matakuliah" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nip_dosen" isForPrompting="false" class="java.lang.String"/>
	<parameter name="jurusan" isForPrompting="false" class="java.lang.String"/>
	<parameter name="kelas" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["A"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
a.nim,
a.nama,
jg.nama as jenjang,

(case $P{tampil_nilai} when 1 then a.nilai_uts else null end) as nilai_3,
(case $P{tampil_nilai} when 1 then a.nilai_uas else null end) as nilai_4,
(case $P{tampil_nilai} when 1 then a.nilai_tugas else null end) as nilai_2,
(case $P{tampil_nilai} when 1 then a.nilai_kehadiran else null end) as nilai_1,
(case $P{tampil_nilai} when 1 then a.total_nilai else null end) as nilai,
(case $P{tampil_nilai} when 1 then a.nilai_huruf else null end) as nilai_huruf,
c.nama as nama_matakuliah,
c.kode as kode_matakuliah,
b.nama as dosen,
a.jenis_semester,
a.tahun_ajaran,
a.fakultas


from view_absensi_dan_nilai a
left join dosen b on a.dosen1 = b.id
left join matakuliah c on c.id = a.matakuliah
where a.perkuliahan = $P{perkuliahan}
group by a.nim
order by a.nama]]></queryString>


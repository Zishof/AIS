	</parameter>
	<parameter name="logo" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.nama,b.tahunangkatan,c.nama as jurusan,d.nama as fakultas,a.tahun_akademik,b.jurusan,
b.nim,f.nama_kegiatan,a.tanggal

from kegiatan a
left join mahasiswa b on a.mahasiswa=b.id
left join jurusan c on b.jurusan=c.id
left join fakultas d on c.fakultas=d.id
left join jenis_kegiatan f on a.jenis_kegiatan=f.id

where a.validated=1 and b.jurusan=$P{jurusan}
and a.tahun_akademik=$P{tahun_akademik}]]>
	</queryString>
	<field name="nama" class="java.lang.String"/>
	<field name="tahunangkatan" class="java.lang.Integer"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="tahun_akademik" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_kegiatan" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<variable name="angka" class="java.lang.Integer" resetType="None" calculation="Count">
		<variableExpression><![CDATA[$V{angka}]]></variableExpression>
	</variable>

		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
bool_or(a.lulus) as lulus,
max(c.nama) as nama_mahasiswa,
max(e.nama) as nama_fakultas,
max(c.waktu_kuliah) as waktu_kuliah,
max(c.nim) as nim,
max(d.nama) as nama_jurusan,
(14-$P{semester}) as sisa_masa_studi,
max(f.kode) as kode_matakuliah,
max(f.nama) as nama_matakuliah,
max(f.sks) as sks,
max(a.total_nilai) as total_nilai,
min(a.nilai_huruf) as nilai_huruf,
max(a.nilai_ip) as nilai_ipk,

case when max(a.semester) % 2 = 0 then (max(c.tahunangkatan)+(max(a.semester/2)-1)) || '/' || (max(c.tahunangkatan)+(max(a.semester/2))) else (max(c.tahunangkatan)+(max((a.semester+1)/2)-1)) || '/' || (max(c.tahunangkatan)+(max((a.semester+1)/2))) end as tahun_ajaran,

max(c.tahunangkatan) as tahunangkatan,
max(d2.nama) as dosen_pa,
max(d2.code) as nip_dosen_pa,
max(c.program) as program,
max(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
max(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
max(e.nama) as fakultas,
max(d1.nama) as jenjang,
max(d1.keterangan) as keterangan_jenjang


from detailperkuliahan a
left join perkuliahan b on (a.perkuliahan = b.id)
left join mahasiswa c on (a.mahasiswa = c.id)
left join dosen d2 on (c.dosen = d2.id)
left join jurusan d on (c.jurusan = d.id)
left join jenjang d1 on (d.jenjang = d1.id)
left join fakultas e on (e.id = d.fakultas)
left join
(
	select aa.id as id,
	max(case when cc.id is null then aa.kode else cc.kode end) as kode,
	max(case when cc.id is null then aa.nama else cc.nama end) as nama,
	max(case when cc.id is null then aa.sks else cc.sks end) as sks
	from matakuliah aa
	left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
	left join matakuliah cc on(bb.matakuliah = cc.id)
	group by aa.id
) f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
left join (
	select aa.nama, aa.nip, aa.jurusan
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kaprodi%'
) h on (h.jurusan = c.jurusan)
left join dosen i on (d.kaprodi = i.id)
where a.mahasiswa = $P{mahasiswa}
and a.persetujuan = 1
and a.nilai_ip >= (case when $P{nilai_0_tidak_masuk_dalam_perhitungan_ipk} = 'tidak aktif' then  0.0 else 0.3 end)
and a.semester = $P{semester}
group by f.id ]]>
	</queryString>
	<field name="nama_mahasiswa" class="java.lang.String"/>
	<field name="nama_fakultas" class="java.lang.String"/>
	<field name="waktu_kuliah" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_jurusan" class="java.lang.String"/>
	<field name="sisa_masa_studi" class="java.lang.Integer"/>
	<field name="kode_matakuliah" class="java.lang.String"/>
	<field name="nama_matakuliah" class="java.lang.String"/>
	<field name="sks" class="java.lang.Integer"/>
	<field name="total_nilai" class="java.lang.Double"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="lulus" class="java.lang.Object"/>
	<field name="nilai_ipk" class="java.lang.Double"/>
	<field name="tahun_ajaran" class="java.lang.String"/>
	<field name="tahunangkatan" class="java.lang.Integer"/>
	<field name="dosen_pa" class="java.lang.String"/>
	<field name="nip_dosen_pa" class="java.lang.String"/>
	<field name="program" class="java.lang.String"/>
	<field name="nip_kaprodi" class="java.lang.String"/>
	<field name="nama_kaprodi" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="jenjang" class="java.lang.String"/>
	<field name="keterangan_jenjang" class="java.lang.String"/>
	<variable name="sum_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$P{nilai_0_tidak_masuk_dalam_perhitungan_ipk}.equals( "tidak aktif" ) ? $F{sks} : ($F{total_nilai} < 0.1 ? 0 : $F{sks})]]></variableExpression>
	</variable>
	<variable name="sum_val" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$P{nilai_0_tidak_masuk_dalam_perhitungan_ipk}.equals( "tidak aktif" ) ? ($F{nilai_ipk}*$F{sks}) : ($F{nilai_ipk}*($F{total_nilai} < 0.1 ? 0.0 : $F{sks}))]]></variableExpression>
	</variable>

	<queryString>
		<![CDATA[select
b.kode as isbn,
b.nama,
a.jumlah,
a.hargabeli,
(case when c.ppn then c.persenppn else 0.0 end) as ppn,
a.hargapotongan,
c.kode,
c.tanggal_persetujuan,
c.disetujui_oleh,
c.keterangan as perpustakaan,
f.nama as penyedia,
j.nama as jenis_pemesanan_pengadaan_asset,
case when e.userid is null then 'Belum disetujui' else 'Disetujui oleh ' || (e.userid || ' (' || e.usernama || ') pada tanggal') end as status_persetujuan


from asset.pemesanan_pengadaan_master_asset_detail a
inner join asset.master_asset b on (a.masterasset = b.id)
inner join asset.pemesanan_pengadaan_master_asset c on (c.id = a.pemesanan_pengadaan_master_asset)
inner join asset.penyedia_asset f on (f.id = c.penyedia)
left join tbmuser e on (e.userid = c.disetujui_oleh)
left join asset.jenis_pemesanan_pengadaan_asset j on (j.id=c.jenis_pemesanan_pengadaan_asset)
where c.id = $P{id}]]>
	</queryString>

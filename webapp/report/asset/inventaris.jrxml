	</parameter>
	<queryString>
		<![CDATA[select
b.merk,
b.nama,
count(*) as jumlah,
d.nama as pemilik_asset,
d1.nama as lokasi,
d2.nama as ruang,
max(h.nama) as kelompok_asset,
(b.lebar || 'x' || b.panjang || 'x' || b.tinggi || ' ' || b.unit) as dimensi,
(b.berat || ' ' || b.unitberat) as berat,
f.nama as status,
max(g1.nama) as satuan

from asset.asset_detail a
left join asset.asset c on (c.id = a.asset)
left join asset.master_asset b on (c.master_asset = b.id)
left join asset.pemilik_asset d on (d.id = a.pemilik_asset)
left join asset.lokasi d1 on (d1.id = a.lokasi)
left join ruang d2 on (d2.id = a.ruang)
left join asset.kelompok_asset h on (h.id = b.kelompok_asset)
left join tbmuser e on (e.userid = c.disetujui_oleh)
left join asset.status_asset f on (a.status_asset = f.id)

left join asset.satuan_master_asset g1 on (b.satuan_master_asset = g1.id)
where 1=1
and case $P{pemilikAsset} when -1 then true else a.pemilik_asset = $P{pemilikAsset} end
and case $P{lokasi} when -1 then true else a.lokasi = $P{lokasi} end
and case $P{ruang} when -1 then true else a.ruang = $P{ruang} end
and case $P{status} when -1 then true else f.id = $P{status} end
and date(tanggalbeli) between date($P{mulai}) and date($P{sampai})
and case $P{jenis} when -1 then true else b.jenis_asset =  $P{jenis} end
and case $P{kelompok} when -1 then true else b.kelompok_asset = $P{kelompok} end
group by b.id,d.id,d1.id,d2.id,f.id
order by b.nama,d.nama,d1.nama,d2.nama,f.nama]]>
	</queryString>

	<parameter name="kode_barcode" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
b.merk,
b.nama,
a.jumlah,
c.kode,
c.tanggal_persetujuan,
c.disetujui_oleh,
d.nama as pemilik_asset,
f.nama as lokasi,
g.nama as ruang,
h.nama as kelompok_asset,
(b.lebar || 'x' || b.panjang || 'x' || b.tinggi || ' ' || b.unit) as dimensi,
(b.berat || ' ' || b.unitberat) as berat,
case when e.userid is null then 'Belum disetujui' else 'Disetujui oleh ' || (e.userid || ' (' || e.usernama || ') pada tanggal') end as status_persetujuan,
g1.nama as satuan

from asset.pemakaian_master_asset_detail a
inner join asset.master_asset b on (a.master_asset = b.id)
inner join asset.pemakaian_master_asset c on (c.id = a.pemakaian_master_asset)
left join asset.pemilik_asset d on (d.id = c.pemilik_asset)
left join tbmuser e on (e.userid = c.disetujui_oleh)
left join asset.lokasi f on (f.id = c.lokasi)
left join ruang g on (g.id = c.ruang)
left join asset.kelompok_asset h on (h.id = b.kelompok_asset)
left join asset.satuan_master_asset g1 on (b.satuan_master_asset = g1.id)
where c.id = $P{id}]]>
	</queryString>

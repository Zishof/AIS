	</parameter>
	<parameter name="lokasi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="ruang" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="mulai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sampai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="kelompok" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.merk,
b.nama,
sum(a.jumlah) as jumlah,
sum(a.harga) as harga,
d.nama as pemilik_asset,
d1.nama as lokasi,
d2.nama as ruang,
max(h.nama) as kelompok_asset,
(b.lebar || 'x' || b.panjang || 'x' || b.tinggi || ' ' || b.unit) as dimensi,
(b.berat || ' ' || b.unitberat) as berat,
max(g.nama) as satuan

from asset.saldo_awal_master_asset_detail a
inner join asset.master_asset b on (a.master_asset = b.id)
inner join asset.saldo_awal_master_asset c on (c.id = a.saldo_awal_master_asset)
left join asset.pemilik_asset d on (d.id = c.pemilik_asset)
left join asset.lokasi d1 on (d1.id = c.lokasi)
left join ruang d2 on (d2.id = c.ruang)
left join asset.kelompok_asset h on (h.id = b.kelompok_asset)
left join tbmuser e on (e.userid = c.disetujui_oleh)
left join asset.satuan_master_asset g on (b.satuan_master_asset = g.id)
where 1=1
and case $P{pemilikAsset} when -1 then true else d.id = $P{pemilikAsset} end
and case $P{lokasi} when -1 then true else d1.id = $P{lokasi} end
and case $P{ruang} when -1 then true else d2.id = $P{ruang} end
and date(tanggal_persetujuan) >= date($P{mulai}) and date(tanggal_persetujuan) <= (date($P{sampai})+integer '1')
and case $P{jenis} when -1 then true else b.jenis_asset =  $P{jenis} end
and case $P{kelompok} when -1 then true else b.kelompok_asset = $P{kelompok} end
group by b.id,d.id,d1.id,d2.id
order by d.nama,d1.nama,d2.nama]]>
	</queryString>

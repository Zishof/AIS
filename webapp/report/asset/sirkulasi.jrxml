	<queryString>
		<![CDATA[select
b.merk,
b.nama,
awal.jumlah as jumlah_awal,
masuk.jumlah as jumlah_masuk,
keluar.jumlah as jumlah_keluar,
akhir.jumlah as jumlah_akhir,
h.nama as kelompok_asset,
(b.lebar || 'x' || b.panjang || 'x' || b.tinggi || ' ' || b.unit) as dimensi,
(b.berat || ' ' || b.unitberat) as berat,
g.nama as satuan,
b.jenis_asset jenis_master_asset,
k.nama nama_jenis_master_asset

from asset.master_asset b

left join (
	select oo.masterasset, sum(oo.qty*pp.jenis) as jumlah
	from asset.detail_transaksi_asset oo
	inner join library.kode_transaksi pp on (oo.kode_transaksi = pp.id)
	where 1=1
	and case $P{pemilikAsset} when -1 then true else oo.pemilik_asset =  $P{pemilikAsset} end
	and case $P{lokasi} when -1 then true else oo.lokasi = $P{lokasi} end
	and case $P{ruang} when -1 then true else oo.ruang = $P{ruang} end
	and tanggal < date($P{mulai})
	group by oo.masterasset
) as awal on (awal.masterasset = b.id)

left join (
	select oo.masterasset, sum(oo.qty*pp.jenis) as jumlah
	from asset.detail_transaksi_asset oo
	inner join library.kode_transaksi pp on (oo.kode_transaksi = pp.id)
	where 1=1 and pp.jenis > 0
	and case $P{pemilikAsset} when -1 then true else oo.pemilik_asset =  $P{pemilikAsset} end
	and case $P{lokasi} when -1 then true else oo.lokasi = $P{lokasi} end
	and case $P{ruang} when -1 then true else oo.ruang = $P{ruang} end
	and tanggal between date($P{mulai}) and date($P{sampai})
	group by oo.masterasset
) as masuk on (masuk.masterasset = b.id)

left join (
	select oo.masterasset, abs(sum(oo.qty*pp.jenis)) as jumlah
	from asset.detail_transaksi_asset oo
	inner join library.kode_transaksi pp on (oo.kode_transaksi = pp.id)
	where 1=1 and pp.jenis < 0
	and case $P{pemilikAsset} when -1 then true else oo.pemilik_asset =  $P{pemilikAsset} end
	and case $P{lokasi} when -1 then true else oo.lokasi = $P{lokasi} end
	and case $P{ruang} when -1 then true else oo.ruang = $P{ruang} end
	and tanggal between date($P{mulai}) and date($P{sampai})
	group by oo.masterasset
) as keluar on (keluar.masterasset = b.id)

left join (
	select oo.masterasset, sum(oo.qty*pp.jenis) as jumlah
	from asset.detail_transaksi_asset oo
	inner join library.kode_transaksi pp on (oo.kode_transaksi = pp.id)
	where 1=1
	and case $P{pemilikAsset} when -1 then true else oo.pemilik_asset =  $P{pemilikAsset} end
	and case $P{lokasi} when -1 then true else oo.lokasi = $P{lokasi} end
	and case $P{ruang} when -1 then true else oo.ruang = $P{ruang} end
	and date(tanggal) <= date($P{sampai})
	group by oo.masterasset
) as akhir on (akhir.masterasset = b.id)

left join asset.kelompok_asset h on (h.id = b.kelompok_asset)
left join asset.satuan_master_asset g on (b.satuan_master_asset = g.id)
left join asset.jenis_asset k on (b.jenis_asset = k.id)
where 1=1
and ((awal.jumlah is not null and awal.jumlah != 0.0) or (masuk.jumlah is not null and masuk.jumlah != 0.0) or
(keluar.jumlah is not null and keluar.jumlah != 0.0) or (akhir.jumlah is not null and akhir.jumlah != 0.0))
and case $P{jenis} when -1 then true else b.jenis_asset =  $P{jenis} end
and case $P{kelompok} when -1 then true else b.kelompok_asset = $P{kelompok} end
order by k.nama,b.nama]]>
	</queryString>

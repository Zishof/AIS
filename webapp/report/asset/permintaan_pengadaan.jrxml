	<queryString>
		<![CDATA[select
b.kode as isbn,
b.nama,
a.jumlah,
a.hargabeli,
c.kode,
c.tanggal_persetujuan,
c.disetujui_oleh,
c.keterangan as perpustakaan,
case when e.userid is null then 'Belum disetujui' else 'Disetujui oleh ' || (e.userid || ' (' || e.usernama || ') pada tanggal') end as status_persetujuan


from asset.permintaan_pengadaan_master_asset_detail a
inner join asset.master_asset b on (a.masterasset = b.id)
inner join asset.permintaan_pengadaan_master_asset c on (c.id = a.permintaan_pengadaan_master_asset)
left join tbmuser e on (e.userid = c.disetujui_oleh)
where c.id = $P{id}]]>
	</queryString>

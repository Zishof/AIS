	</parameter>
	<queryString>
		<![CDATA[select

c.barcode, c.nama as nama, c.tanggalbeli beli,
a.id as asset,
a.nama as jenis_aktiva,
max(a.umurekonomis) as umur,
c.hargabeli as total_beli,
abs((date_part('year',age(date($P{mulai}), c.tanggalbeli))*12)+date_part('month',age(date($P{mulai}), c.tanggalbeli))) as tahunke,
max(case when abs((date_part('year',age(date($P{mulai}), c.tanggalbeli))*12)+date_part('month',age(date($P{mulai}), c.tanggalbeli)))=d.tahun_ke and c.status_asset=1 then d.nilaibuku else 0 end) as akumulasi_penyusutan,
max(case when abs((date_part('year',age(date($P{mulai}), c.tanggalbeli))*12)+date_part('month',age(date($P{mulai}), c.tanggalbeli)))=d.tahun_ke and c.status_asset=1 then d.nilaipenyusutan else 1 end) as nilai_buku,

(case when c.tanggalbeli between date($P{mulai}) and date($P{sampai}) and c.status_asset=1 then c.hargabeli else 0 end) as penambahan,
(case when c.tanggalbeli between date($P{mulai}) and date($P{sampai}) and c.status_asset!=1 then c.hargabeli else 0 end) as pengurangan,

max(case when abs((date_part('year',age(date($P{sampai}), c.tanggalbeli))*12)+date_part('month',age(date($P{sampai}), c.tanggalbeli)))=d.tahun_ke and c.status_asset=1 then d.nilaibuku else 0 end) as akumulasi_penyusutan_2,
max(case when abs((date_part('year',age(date($P{sampai}), c.tanggalbeli))*12)+date_part('month',age(date($P{sampai}), c.tanggalbeli)))=d.tahun_ke and c.status_asset=1 then d.nilaibuku else 0 end) as nilai_buku_2,

max(dd.nama) as pemilik_asset,
max(d1.nama) as lokasi,
max(d2.nama) as ruang,
max(h.nama) as kelompok_asset

from asset.master_asset a
inner join asset.asset b on (a.id=b.master_asset)
inner join asset.asset_detail c on (c.asset = b.id)
inner join asset.penyusutan_asset d on (d.asset_detail=c.id)

left join asset.pemilik_asset dd on (dd.id = b.pemilik_asset)
left join asset.lokasi d1 on (d1.id = b.lokasi)
left join ruang d2 on (d2.id = b.ruang)
left join asset.kelompok_asset h on (h.id = b.kelompok_asset)

where d.pertanggal <= date($P{sampai})

and case $P{pemilikAsset} when -1 then true else dd.id = $P{pemilikAsset} end
and case $P{lokasi} when -1 then true else d1.id = $P{lokasi} end
and case $P{ruang} when -1 then true else b.ruang = $P{ruang} end
and case $P{jenis} when -1 then true else a.jenis_asset =  $P{jenis} end
and case $P{kelompok} when -1 then true else a.kelompok_asset = $P{kelompok} end
group by c.id,a.id
order by a.nama]]>
	</queryString>

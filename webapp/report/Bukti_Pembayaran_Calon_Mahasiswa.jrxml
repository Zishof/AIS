	<queryString>
		<![CDATA[select
b.kode,
b.nama as item_biaya,
sum(a1.nilai) biaya,
max(d.nim) as nim,
max(d.nama) as nama_mahasiswa,
max(e.nama) as nama_jurusan,
max(f.nama) as nama_fakultas,
max(c.semster) as semester,
max(c.tahun_akademik) as tahun_ajaran,
max(g.nama_kegiatan) as nama_kegiatan,
max(c.ref_number) as ref_number,
max(c.program) as program,
max(c.validator) as validator,
max(c.bulan) as bulan,
max(d.no_registrasi||(case when dd.id is not null then ' (NIM: '||dd.nim||')' else '' end )) as no_registrasi,
max(a1.keterangan) as keterangan1,
max(c.keterangan) as keterangan



from cicilan_pembayaran a1
inner join pengaturan_pembayaran_bulanan a2 on (a1.pengaturan_pembayaran_bulanan = a2.id)
left join detail_biaya a on (a.id = a2.detail_biaya)
left join item_biaya b on (a.item_biaya = b.id)
left join kegiatan c on (a1.kegiatan = c.id)
left join biodata_calon_mahasiswa d on (c.calon_mahasiswa = d.id)
left join mahasiswa dd on (d.mahasiswa = dd.id)
left join jurusan e on (case when d.prodi_lulus is null then case when d.prodi_1 is null then d.prodi_2 else d.prodi_1 end else d.prodi_lulus end = e.id)
left join fakultas f on (e.fakultas = f.id)
left join jenis_kegiatan g on (c.jenis_kegiatan = g.id)

where c.id = $P{kegiatan}
group by b.id]]>
	</queryString>

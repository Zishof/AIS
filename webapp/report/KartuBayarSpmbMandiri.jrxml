	<parameter name="logo1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="biodata_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[313L]]></defaultValueExpression>
	</parameter>
	<parameter name="foto" class="java.io.InputStream" isForPrompting="false"/>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011/2012"]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.nama,
a.no_identitas,a.jenis_kelamin,a.tempat_lahir,a.tanggal_lahir,
a.alamat,a.asal_sma,a.prodi_1,a.prodi_2,a.no_registrasi,a.tanggal_lahir,
b.nama as p1,c.nama as p2, e.nama as jenjang,
(case when b.nama is null then '' else b.nama end) || (case when c.nama is null then '' else ', '||c.nama end) || (case when c1.nama is null then '' else ', '||c1.nama end)  || (case when c2.nama is null then '' else ', '||c2.nama end)  || (case when c3.nama is null then '' else ', '||c3.nama end) || ' / '||a.program as prodi_pilihan,

f.keterangan as info,

f.tanggalujian1,
f.tanggalujian2,
f.tanggalujian3,
f.tanggalujian4,
f.tanggalujian5,
f.tanggalujian6,
f.tanggalujian7,
f.tanggalujian8,
f.tanggalujian9,
f.tanggalujian10,
f.lokasi,
f.tampilkanjadwalujiandikartuujian,
a.tahunakademik,
dd.nama as gelombang,
UPPER(a.asal_sma) as asal

from biodata_calon_mahasiswa a
inner join gelombang_pendaftaran dd on (a.gelombang_pendaftaran=dd.id)
left join jurusan b on a.prodi_1=b.id
left join jurusan c on a.prodi_2=c.id
left join jurusan c1 on a.prodi3=c1.id
left join jurusan c2 on a.prodi4=c2.id
left join jurusan c3 on a.prodi5=c3.id
left join jenjang e on b.jenjang = e.id

left join (select aaa.tahunakademik,aaa.gelombang_pendaftaran,
	max(aaa.keterangan) as keterangan,
	max(aaa.tanggalujian1) as tanggalujian1,
	max(aaa.tanggalujian2) as tanggalujian2,
	max(aaa.tanggalujian3) as tanggalujian3,
	max(aaa.tanggalujian4) as tanggalujian4,
	max(aaa.tanggalujian5) as tanggalujian5,
	max(aaa.tanggalujian6) as tanggalujian6,
	max(aaa.tanggalujian7) as tanggalujian7,
	max(aaa.tanggalujian8) as tanggalujian8,
	max(aaa.tanggalujian9) as tanggalujian9,
	max(aaa.tanggalujian10) as tanggalujian10,
	aaa.tampilkanjadwalujiandikartuujian,
	max(aaa.lokasi) as lokasi,
	bbb.paket
from ujian_pmb aaa inner join ruang_pmb bbb on (aaa.id=bbb.ujian_pmb) group by aaa.tahunakademik,aaa.gelombang_pendaftaran,aaa.tampilkanjadwalujiandikartuujian,bbb.paket) f on (f.tahunakademik = a.tahunakademik and f.gelombang_pendaftaran = a.gelombang_pendaftaran and (a.paket_registrasi_mahasiswa=f.paket or f.paket is null))


where a.id=$P{biodata_id}
limit 1]]>
	</queryString>

		<defaultValueExpression ><![CDATA["Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_ajaran" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["2009/2010"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["2009-12-30"]]></defaultValueExpression>
	</parameter>
	<parameter name="konsentrasi" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="hari_dan_tanggal" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Rabu, 22 Desember 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_dibuat" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["22 Juni 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="pudek1" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select
(case $P{konsentrasi} when -1 then '-' else d.nama end) as konsentrasi,
a.waktu_sidang || ' - ' || a.waktu_sampai_sidang as waktu,
b.nim,
b.nama,
c.nama as pembimbing
from skripsi a
left join mahasiswa b on (a.mahasiswa = b.id)
left join dosen c on (a.pembimbing = c.id)
left join konsentrasi d on (d.id = b.konsentrasi)
where b.konsentrasi = (case $P{konsentrasi} when -1 then b.konsentrasi else $P{konsentrasi} end)
and date(a.tanggal_sidang) = date($P{tanggal})]]></queryString>


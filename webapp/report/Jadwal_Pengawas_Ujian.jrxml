	</parameter>
	<queryString>
		<![CDATA[select * from (
select
		pk.semester,
		pk.tahun_ajaran,
		mk.kode as kode_mata_kuliah,
		mk.nama as mata_kuliah,
		mk.sks,
		pk.kelas,
		pk.ruang,
		pk.hari,
		pk.waktu_mulai,
		waktu.ruangan as ruangan,
(case when d.nama is not null and e.nama is not null then (d.nama || ', ' || e.nama) when  d.nama is not null then d.nama else '' end) as dosen,
waktu.waktu,
waktu.tanggal,
waktu.catatan,
waktu.petugas


from  perkuliahan pk
left join (
	select
	tanggal,
	waktu_mulai||' s.d '||waktu_selesai as waktu,
	aa.catatan,
	aa.perkuliahan,
	r.kode_ruangan as ruangan,
	(case when p1.nama is null then '' else p1.nama end)
	|| (case when p2.nama is null then '' else ', '||p2.nama end)
	|| (case when p3.nama is null then '' else ', '||p3.nama end) as petugas,
	aa.petugas as p1,aa.petugas2 as p2, aa.petugas3 as p3
	from pertemuan aa
	left join pegawai p1 on (aa.petugas=p1.id)
	left join pegawai p2 on (aa.petugas2=p2.id)
	left join pegawai p3 on (aa.petugas3=p3.id)
	left join ruang r on aa.ruang = r.id
	inner join status_pertemuan bb on (aa.status_pertemuan = bb.id)
	where bb.nama ilike '%'||$P{jenis}||'%'
) waktu on (waktu.perkuliahan = pk.id)
inner join matakuliah mk on (pk.matakuliah = mk.id)
left join dosen d on (pk.dosen1 = d.id)
left join dosen e on (pk.dosen2 = e.id)
left join pegawai pet on (waktu.p1=pet.id or waktu.p2=pet.id or waktu.p3=pet.id )
where pk.tahun_ajaran=$P{tahun_akademik}
and pk.ganjil_genap=$P{jenis_semester}
and case when $P{pengawas}=-1 then true else pet.id=$P{pengawas} end
and case when $P{semester_pendek} is null then pk.status_semesterpendek is null else pk.status_semesterpendek = $P{semester_pendek} end
order by waktu.tanggal,waktu.waktu) a]]>
	</queryString>

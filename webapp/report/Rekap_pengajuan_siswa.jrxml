	<parameter name="mulai" class="java.util.Date" isForPrompting="false"/>
	<parameter name="sampai" class="java.util.Date" isForPrompting="false"/>
	<queryString>
		<![CDATA[select dpa.jenis_pengajuan as asrama_id,m.nomor_induk_nasional nim,m.nama,d.nama as asrama,j.nama as jur,f.nama as fak,
m.tahunangkatan, m.kelamin

from pengajuan_siswa dpa
left join jenis_pengajuan d on dpa.jenis_pengajuan = d.id
left join sekolah.siswa m on dpa.siswa = m.id
left join sekolah.sekolah j on m.sekolah = j.id
left join sekolah.yayasan f on j.yayasan = f.id
where persetujuan = true
and case when $P{yayasan} = -1 then true else f.id = $P{yayasan} end
and case when $P{asrama} = -1 then true else dpa.jenis_pengajuan = $P{asrama} end
and case when $P{siswa} = -1 then true else dpa.siswa = $P{siswa} end
and case when $P{sekolah} = -1 then true else j.id = $P{sekolah} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end
and date(dpa.tanggal) between date($P{mulai}) and date($P{sampai})
order by dpa.jenis_pengajuan,j.nama,m.nomor_induk_nasional]]>
	</queryString>

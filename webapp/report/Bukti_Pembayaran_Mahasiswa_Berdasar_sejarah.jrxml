	<parameter name="lampirans" class="net.sf.jasperreports.engine.JRDataSource" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
b.kode,
b.nama as item_biaya,
(a1.nilai) biaya,
(d.nim) as nim,
(d.nama) as nama_mahasiswa,
(e.nama) as nama_jurusan,
(f.nama) as nama_fakultas,
(c.semster) as semester,
(c.tahun_akademik) as tahun_ajaran,
(g.nama_kegiatan) as nama_kegiatan,
(c.ref_number) as ref_number,
(c.program) as program,
(a1.validator) as validator,
(d.nim) as no_registrasi,
a1.tanggal as tanggal,
a2.nama as jenis_pembayaran,
a1.keterangan,
to_char(a1.tanggal, 'DD-MM-YY  HH24:MI') as group_tgl



from cicilan_pembayaran a1
left join jenis_pembayaran a2 on (a1.jenis_pembayaran=a2.id)
left join item_biaya b on (a1.item_biaya = b.id)
left join kegiatan c on (a1.kegiatan = c.id)
left join mahasiswa d on (c.mahasiswa = d.id)
left join jurusan e on (e.id=d.jurusan)
left join fakultas f on (e.fakultas = f.id)
left join jenis_kegiatan g on (c.jenis_kegiatan = g.id)

where c.id = $P{kegiatan}
order by a1.tanggal desc]]>
	</queryString>

	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ruang" isForPrompting="true" class="java.lang.Long"/>
	<queryString><![CDATA[select b.nama,b.no_ujian

from ruang_paket_pmb a
left join biodata_calon_mahasiswa b on a.calon_mahasiswa = b.id

where 
a.ruang_pmb = $P{ruang}
]]></queryString>

	<field name="nama" class="java.lang.String"/>
	<field name="no_ujian" class="java.lang.String"/>


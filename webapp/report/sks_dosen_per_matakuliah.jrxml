		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.id as dosen1,
max(trim(b.nama)) as nama_dosen,
a.semester,
max(d.nama) as jurusan,
max(e.nama) as fakultas,
sum((c.sks*1.0)/(a.jumlahdosen*1.0)) as jumlah_sks,
max(c.nama) as matakuliah,
max(j.nama) as jabatan,
max(j.eq_sks) as eq_sks,
max(f.nama) as fakultas_dosen


from perkuliahan a
left join dosen b on (a.dosen1 = b.id or a.dosen2 = b.id or a.dosen3 = b.id or a.dosen4 = b.id or a.dosen5 = b.id
or a.dosen6 = b.id  or a.dosen7 = b.id  or a.dosen8 = b.id  or a.dosen9 = b.id  or a.dosen10 = b.id)
left join jabatan j on (j.id = b.spesifikasi_jabatan)
left join matakuliah c on (a.matakuliah = c.id)
left join jurusan d on (a.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join fakultas f on (f.id = b.fakultas)
where b.nama is not null
and case when $P{tahun_akademik} = 'Semua' then true else a.tahun_ajaran = $P{tahun_akademik} end
and case when $P{semester} = 'Semua' then true else a.ganjil_genap = $P{semester} end
and case when $P{fakultas} = -1 then true else d.fakultas = $P{fakultas} end
and case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{dosen} = -1 then true else b.id = $P{dosen} end
and case $P{masa_perkuliahan} when -1 then true else a.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then a.status_semesterpendek is null else a.status_semesterpendek = $P{semester_pendek} end
and case $P{ekstrakurikuler} when -1 then c.extrakulikuler = false else c.extrakulikuler end
group by b.id, d.fakultas, a.jurusan, a.semester, a.matakuliah
order by max(trim(b.nama)) asc, d.fakultas, a.jurusan, a.semester asc]]>
	</queryString>

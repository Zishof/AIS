<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Registrasi_Wisuda" pageWidth="368" pageHeight="311" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="308" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select m.nim, m.nama,
	j.nama as jurusan, f.nama as fakultas, pw.no_registrasi_wisuda
from pendaftaran_wisuda pw
inner join mahasiswa m on (pw.mahasiswa = m.id)
inner join jurusan j on (m.jurusan = j.id)
inner join fakultas f on (j.fakultas = f.id)
where pw.mahasiswa=$P{mahasiswa}]]>
	</queryString>
	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="no_registrasi_wisuda" class="java.lang.String"/>

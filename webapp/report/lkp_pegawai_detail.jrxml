	<variable name="waktu" class="java.lang.Double" resetType="Group" resetGroup="pegawai" calculation="Sum">
		<variableExpression><![CDATA[$F{waktu_detail}]]></variableExpression>
	</variable>
	<variable name="waktu_realisasi" class="java.lang.Double" resetType="Group" resetGroup="pegawai" calculation="Sum">
		<variableExpression><![CDATA[$F{waktu_detail}]]></variableExpression>
	</variable>
	<variable name="avg_kuantitas" class="java.lang.Double" resetType="Group" resetGroup="pegawai" calculation="Average">
		<variableExpression><![CDATA[($F{realisasi_kuantitas}*100.0)/$F{kuantitas}]]></variableExpression>
	</variable>
	<variable name="avg_kualitas" class="java.lang.Double" resetType="Group" resetGroup="pegawai" calculation="Average">
		<variableExpression><![CDATA[($F{kualitasrealisasi}*100.0)/$F{kualitas}]]></variableExpression>
	</variable>
	<variable name="avg_waktu" class="java.lang.Double" resetType="Group" resetGroup="pegawai" calculation="Average">
		<variableExpression><![CDATA[($F{realisasi_waktu}*100.0)/$F{waktu}]]></variableExpression>
	</variable>

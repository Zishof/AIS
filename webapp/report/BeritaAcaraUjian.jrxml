	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="ruang" class="java.lang.Long"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\nih ye\\report\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select  MIN(c.no_ujian),MAX(c.no_ujian),b.nama as ruang,d.nama as paket,
e.nama as gedung,b.kapasitas_ruangan as kapasitas,
b.tahunakademik,
bb.lokasi,
bbb.nama as gelombang_pendaftaran,
f.nama as jadwal_ujian
from ruang_paket_pmb a
left join ruang_pmb b on a.ruang_pmb = b.id
left join ujian_pmb bb on (b.ujian_pmb = bb.id)
left join gelombang_pendaftaran bbb on (bb.gelombang_pendaftaran = bbb.id)
left join biodata_calon_mahasiswa c on a.calon_mahasiswa = c.id
left join paket d on b.paket = d.id
left join gedung e on b.gedung = e.id
left join jadwal_ujian_pmb f on f.ujian_pmb = bb.id
where a.ruang_pmb=$P{ruang}
group by b.nama,d.nama, e.nama, b.kapasitas_ruangan, b.tahunakademik, bb.lokasi, bbb.nama, f.nama
order by max(f.waktumulai)]]>
	</queryString>

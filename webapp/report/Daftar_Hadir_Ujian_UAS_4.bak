		<defaultValueExpression ><![CDATA["Siti"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select 
(case $P{tampil_nilai} when 1 then b.total_nilai else null end) as nilai,
(case $P{tampil_nilai} when 1 then (select aa.nilai_huruf AS nilai_huruf from nilai_huruf aa where ((aa.mulai <= b.total_nilai) and (aa.sampai >= b.total_nilai))) else null end) AS nilai_huruf,
(case $P{tampil_nilai} when 1 then ((select aa.jumlah AS jumlah from ((nilai aa join formatnilai bb on((aa.formatnilai = bb.id))) join status_pertemuan cc on((bb.status_pertemuan = cc.id))) where ((aa.detailperkuliahan = b.id) and (cc.nama = 'UAS')))) else null end) AS nilai_4,
(case $P{tampil_nilai} when 1 then ((select aa.jumlah AS jumlah from ((nilai aa join formatnilai bb on((aa.formatnilai = bb.id))) join status_pertemuan cc on((bb.status_pertemuan = cc.id))) where ((aa.detailperkuliahan = b.id) and (cc.nama = 'UTS')))) else null end) AS nilai_3,
(case $P{tampil_nilai} when 1 then ((select aa.jumlah AS jumlah from ((nilai aa join formatnilai bb on((aa.formatnilai = bb.id))) join status_pertemuan cc on((bb.status_pertemuan = cc.id))) where ((aa.detailperkuliahan = b.id) and (cc.nama = 'Tugas')))) else null end) AS nilai_2,
(case $P{tampil_nilai} when 1 then ((select aa.jumlah AS jumlah from ((nilai aa join formatnilai bb on((aa.formatnilai = bb.id))) join status_pertemuan cc on((bb.status_pertemuan = cc.id))) where ((aa.detailperkuliahan = b.id) and (cc.nama = 'Kehadiran')))) else null end) AS nilai_1,
(select aa.tanggal AS tanggal from (pertemuan aa join status_pertemuan bb on((aa.status_pertemuan = bb.id))) where ((bb.nama = 'UTS') and (aa.id = b.id))) AS tanggal_uts,
(select aa.tanggal AS tanggal from (pertemuan aa join status_pertemuan bb on((aa.status_pertemuan = bb.id))) where ((bb.nama = 'UAS') and (aa.id = b.id))) AS tanggal_uas,
(select aa.tanggal AS tanggal from (pertemuan aa join status_pertemuan bb on((aa.status_pertemuan = bb.id))) where ((bb.nama = 'Tugas') and (aa.id = b.id))) AS tanggal_tugas,
(select aa.tanggal AS tanggal from (pertemuan aa join status_pertemuan bb on((aa.status_pertemuan = bb.id))) where ((bb.nama = 'Absen') and (aa.id = b.id))) AS tanggal_Kehadiran,



e.nim AS nim,
e.nama AS nama,
c.nama as nama_dosen,
d.nama as nama_matakuliah,
a.ruang,
d.sks,
(case (a.semester % 2) when 0 then _latin1'GENAP' else _latin1'GANJIL' end) AS jenis_semester,
a.tahun_ajaran AS tahun_ajaran,
h.nama AS fakultas

from perkuliahan a
left join detailperkuliahan b on (a.id = b.perkuliahan)
left join dosen c on (c.id = a.dosen1)
left join matakuliah d on (d.id = a.matakuliah)
left join mahasiswa e on b.mahasiswa = e.id 
left join jurusan g on g.id = a.jurusan 
left join fakultas h on g.fakultas = h.id 

where a.id = $P{perkuliahan}

group by e.id
order by e.nim]]></queryString>

	<field name="nilai" class="java.lang.Double"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="nilai_4" class="java.lang.Double"/>

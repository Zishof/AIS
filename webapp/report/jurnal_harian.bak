	<parameter name="bulan" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select
a.kode as kode_transaksi,
a.tanggal_transaksi,
b.kode as kode_akun,
b.nama as nama_akun,
a.keterangan as keterangan_transaksi,
a.debet,
a.kredit



from transaksi a
left join akun b on (a.akun = b.id)
where a.bulan = $P{bulan}
order by a.kode]]></queryString>


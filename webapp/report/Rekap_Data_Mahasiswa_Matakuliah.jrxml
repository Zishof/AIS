	<parameter name="kodeMatakuliah" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tahunAkademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2015/2016"]]></defaultValueExpression>
	</parameter>
	<parameter name="matakuliah" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>

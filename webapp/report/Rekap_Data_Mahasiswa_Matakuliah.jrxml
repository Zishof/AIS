	<parameter name="jenisSemester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.nim as nim, a.nama as namamahasiswa, a.tahunangkatan as tahunangkatan, b.nama as prodi,
'' as statusmahasiswa, d.nama as namafakultas, a.kelamin as namakonsentrasi,
cc.kode as kode_matkul,cc.nama as nama_matkul,aa.semester,aa.tahunakademik,

a.tempatlahir,a.tanggallahir

from detailperkuliahan aa
left join perkuliahan bb on (aa.perkuliahan=bb.id)
inner join matakuliah cc on (bb.matakuliah=cc.id or aa.matakuliah_konversi=cc.id)
inner join mahasiswa a on (a.id = aa.mahasiswa)
left join jurusan b on (b.id = a.jurusan)
left join fakultas d on (d.id = b.fakultas)

where
aa.tahunakademik = $P{tahunAkademik}
and case $P{jenisSemester} when 'Ganjil' then aa.semester%2=1 else aa.semester%2=0 end
and b.id = (case $P{jurusan} when -1 then b.id else $P{jurusan} end)
and case $P{matakuliah} when -1 then true else cc.id = $P{matakuliah} end
and case when $P{kelamin} = '-1' then true else a.kelamin = $P{kelamin} end
and case when $P{program} = '-1' then true else a.program =  $P{program} end
and a.tahunangkatan = (case $P{tahunangkatan} when -1 then a.tahunangkatan else $P{tahunangkatan} end)
and d.id = (case $P{fakultas} when -1 then d.id else $P{fakultas} end)
order by cc.kode,a.jurusan, a.tahunangkatan, a.nim
limit 10000]]>
	</queryString>

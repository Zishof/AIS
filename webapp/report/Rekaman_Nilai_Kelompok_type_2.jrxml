	<variable name="sum_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_val" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_nilai" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>
	<variable name="sum_nilai_sks" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_sks_total" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_val_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="KTN" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}.doubleValue()*$F{nilai_ipk}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="ktn_total" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}.doubleValue()*$F{nilai_ipk}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_ipk" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>

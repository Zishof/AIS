	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="ruang" class="java.lang.Long"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.nama as ruang,c.no_ujian, c.nama as pendaftar,d.nama as paket,
e.nama as gedung

from ruang_paket_pmb a
left join ruang_pmb b on a.ruang_pmb = b.id
left join biodata_calon_mahasiswa c on a.calon_mahasiswa = c.id
left join paket d on b.paket = d.id
left join gedung e on b.gedung = e.id
where a.ruang_pmb=$P{ruang}
order by c.no_ujian ]]>
	</queryString>
	<field name="ruang" class="java.lang.String"/>
	<field name="no_ujian" class="java.lang.String"/>
	<field name="pendaftar" class="java.lang.String"/>
	<field name="paket" class="java.lang.String"/>
	<field name="gedung" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>

		<band height="50" splitType="Stretch">
			<staticText>
				<reportElement key="staticText-1" x="0" y="0" width="535" height="50"/>
				<textElement textAlignment="Center">
					<font size="12"/>
				</textElement>
				<text><![CDATA[ABSENSI UJIAN SPMB MANDIRI
UIN SYARIF HIDAYATULLAH JAKARTA
2012/2013]]></text>
			</staticText>
			<image>
				<reportElement key="image-1" x="23" y="0" width="46" height="50"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<line>
				<reportElement key="line-1" x="0" y="48" width="535" height="1"/>
			</line>
		</band>
	</title>

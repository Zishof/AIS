				</textElement>
				<text><![CDATA[Ruang]]></text>
			</staticText>
			<line>
				<reportElement key="line-1" x="0" y="40" width="535" height="1"/>
			</line>
			<staticText>
				<reportElement key="staticText-5" x="0" y="43" width="40" height="18"/>
				<box leftPadding="5">
					<pen lineWidth="0.5" lineStyle="Solid"/>
					<topPen lineWidth="0.5" lineStyle="Solid"/>
					<leftPen lineWidth="0.5" lineStyle="Solid"/>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PengumumanRuang" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="2"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\JOBS\\Workspace_AIS\\ais\\web\\report\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="paket" class="java.lang.Long"/>
	<parameter name="tahun" class="java.lang.Integer"/>
	<parameter name="barcode" class="java.lang.String"/>
	<queryString>
		<![CDATA[select b.nama as ruang,c.nama as paket, a.ruang_pmb as ruangpar

from ruang_paket_pmb a
left join ruang_pmb b on a.ruang_pmb = b.id
left join paket c on b.paket = c.id
left join biodata_calon_mahasiswa d on a.calon_mahasiswa = d.id

where c.id = $P{paket}
and d.tahun =$P{tahun}

group by a.ruang_pmb,b.nama,c.nama]]>
	</queryString>
	<field name="ruang" class="java.lang.String"/>
	<field name="paket" class="java.lang.String"/>
	<field name="ruangpar" class="java.lang.Long"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="59" splitType="Stretch">
			<staticText>
				<reportElement key="staticText-1" x="0" y="0" width="535" height="19"/>

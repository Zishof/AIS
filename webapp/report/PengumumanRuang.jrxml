				</textElement>
				<text><![CDATA[No Ujian]]></text>
			</staticText>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<image scaleImage="RetainShape" vAlign="Middle">
				<reportElement key="image-1" x="0" y="0" width="300" height="20"/>

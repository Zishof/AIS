	<queryString>
		<![CDATA[select
z.ruang_pmb,
UPPER(a.nama) as nama,a.jenis_kartu_identitas_mahasiswa_baru,
a.no_identitas,a.jenis_kelamin,UPPER(a.tempat_lahir) as tempat_lahir,a.tanggal_lahir,
UPPER(a.alamat) as alamat,UPPER(a.asal_sma) as asal_sma,a.no_registrasi,a.no_ujian,
b.nama as p1,
c.nama as p2,
c1.nama as p3,
c2.nama as p4,
c3.nama as p5,
(case when d.nama is null then 'KTP' else d.nama end) as kartu,
e.nama as paket,y.nama as ruang,gd.nama as gedung,

f.keterangansetelahbayar as info,

f.tanggalujian1,
f.tanggalujian2,
f.tanggalujian3,
f.tanggalujian4,
f.tanggalujian5,
f.tanggalujian6,
f.tanggalujian7,
f.tanggalujian8,
f.tanggalujian9,
f.tanggalujian10,
f.tampilkanjadwalujiandikartuujian,
f.lokasi,
a.tahunakademik,
f.id as ujian,
a.paket_registrasi_mahasiswa as id_paket,
e.nama as nama_paket,
g.nama as gelombang

from biodata_calon_mahasiswa a
left join ruang_paket_pmb z on z.calon_mahasiswa = a.id
left join gelombang_pendaftaran g on (g.id=a.gelombang_pendaftaran)
left join ruang_pmb y on z.ruang_pmb = y.id
left join gedung gd on y.gedung = gd.id

left join jurusan b on a.prodi_1=b.id
left join jurusan c on a.prodi_2=c.id
left join jurusan c1 on a.prodi3=c1.id
left join jurusan c2 on a.prodi4=c2.id
left join jurusan c3 on a.prodi5=c3.id

left join paket e on a.paket_registrasi_mahasiswa = e.id

left join jenis_kartu_identitas_mahasiswa_baru d on a.jenis_kartu_identitas_mahasiswa_baru=d.id


left join ujian_pmb f on (f.id = y.ujian_pmb)

where a.id=$P{biodata_id}

order by f.id desc]]>
	</queryString>

	<parameter name="gelombangPendaftaran" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
c.nama as fakultas,
b.nama as jurusan,
d.nama as item_biaya,
a.nilai_biaya,
a.semester,
a.tahun_akademik
from detail_biaya a
inner join jurusan b on (a.jurusan = b.id)
inner join fakultas c on (b.fakultas = c.id)
inner join item_biaya d on (a.item_biaya = d.id)

where nilai_biaya > 0.0
and  (case when $P{nilaiTambahan1} = '' then a.nilaitambahan1 is null else a.nilaitambahan1=$P{nilaiTambahan1}  end)
and  (case when $P{nilaiTambahan2} = '' then a.nilaitambahan2 is null else a.nilaitambahan2=$P{nilaiTambahan2}  end)
and  (case when $P{nilaiTambahan3} = '' then a.nilaitambahan3 is null else a.nilaitambahan3=$P{nilaiTambahan3}  end)
and a.angkatan = $P{angkatan}
and a.program = $P{program}
and a.wna_atau_wni = $P{warganegara}
and a.mulai_belajar_di_semester = $P{semester_mulai}
and (case when $P{jenisKegiatan} = -1 then true else a.jenis_kegiatan=$P{jenisKegiatan} end)
and (case when $P{jenisSeleksi} = -1 then true else a.jenis_seleksi=$P{jenisSeleksi}  end)
and  (case when $P{jenjang} = -1 then true else a.jenjang=$P{jenjang}  end)
and  (case when $P{statusMahasiswa} = -1 then true else a.status_mahasiswa=$P{statusMahasiswa}  end)
and  (case when $P{gelombangPendaftaran} = -1 then a.gelombang_pendaftaran is null else a.gelombang_pendaftaran=$P{gelombangPendaftaran}  end)
and  (case when $P{paket} = -1 then true else a.paket=$P{paket}  end)
and  (case when $P{statusAwalMahasiswa} = -1 then true else a.status_awal_mahasiswa=$P{statusAwalMahasiswa}  end)
and a.semester between $P{jenisKegiatanMin} and $P{jenisKegiatanMax}
order by c.nama,b.nama,semester,d.nama]]>
	</queryString>
	<field name="fakultas" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="item_biaya" class="java.lang.String"/>
	<field name="nilai_biaya" class="java.lang.Double"/>
	<field name="semester" class="java.lang.Integer"/>
	<field name="tahun_akademik" class="java.lang.String"/>

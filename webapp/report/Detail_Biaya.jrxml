	</parameter>
	<parameter name="nilaiTambahan1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nilaiTambahan3" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="jenisKegiatanMax" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[8]]></defaultValueExpression>
	</parameter>

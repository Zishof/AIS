	<parameter name="jumlah_pilihan_checklist_penilaian_dosen_oleh_mahasiswa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["5"]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select cc.keterangan,perkuliahan,cc.dosen,(f.nim||' '||f.nama) as mahasiswa,
				(c.nama||' '||b.kelas||' '||(case when b.hari is null then '' else b.hari end)||' '||(case when b.waktu_mulai is null then '' else b.waktu_mulai end)||' '||(case when b.waktu_selesai is null then '' else b.waktu_selesai end)) as nama_perkuliahan,e.nama as nama_dosen,
e.id as id_dosen,
masukan
				from
				checklist_baru_penilaian_dosen_oleh_mahasiswa cc
				inner join perkuliahan b on (cc.perkuliahan=b.id)
				inner join matakuliah c on (b.matakuliah=c.id)
				inner join jurusan d on (b.jurusan=d.id)
				inner join dosen e on (e.id = cc.dosen)
				inner join mahasiswa f on (f.id = cc.mahasiswa)
				where b.tahun_ajaran=$P{tahun_akademik}
				and b.ganjil_genap = (case $P{genapGanjil} when 'Semua' then b.ganjil_genap else $P{genapGanjil} end)
				and case when $P{jurusan}=-1 then true else b.jurusan=$P{jurusan} end
				and case when $P{fakultas}=-1 then true else d.fakultas=$P{fakultas} end
				and case when $P{dosen}=-1 then true else cc.dosen=$P{dosen} end
				and case when $P{program}='-1' then true else b.program=$P{program} end
and masukan is not null and masukan != ''
order by b.id]]>
	</queryString>

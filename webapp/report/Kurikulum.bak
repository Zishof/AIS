	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Ilmu Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="jenis" isForPrompting="true" class="java.lang.Long"/>
	<queryString><![CDATA[select max(semester) as semester,(kode) as kode,max(nama) as nama,max(sks) as sks,max(status) as status,max(prasyarat) as prasyarat from 
(
(
select 
a.id,
a.semester,
a.kode,
a.nama,
a.sks,
a.status,
'' as prasyarat,
-1 as id_prasyarat
from matakuliah a 
left join kurikulum_punya_matakuliah b on (b.matakuliah = a.id)
where b.kurikulum = $P{jenis}
and a.id not in (select matakuliah from matakuliah_prasyarat)
order by a.semester
)   
union all 
(
select 
a.id,
a.semester,
a.kode,
a.nama,
a.sks,
a.status,
c.nama as prasyarat,
c.id as id_prasyarat
from matakuliah_prasyarat z
left join matakuliah a on (z.matakuliah = a.id)
left join matakuliah c on (z.matakuliah_prasyarat = c.id)
left join kurikulum_punya_matakuliah b on (b.matakuliah = a.id)
where b.kurikulum = $P{jenis}
order by a.semester
) 
) a
group by kode
order by nama,prasyarat]]></queryString>


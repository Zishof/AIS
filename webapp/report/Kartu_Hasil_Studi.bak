<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Kartu_Hasil_Studi"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="AllSectionsNoDetail"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.zoom" value="2.0" />
	<property name="ireport.x" value="0" />
	<property name="ireport.y" value="0" />
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="logo" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_ajaran" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["2009/2010"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" isForPrompting="false" class="java.lang.String"/>
	<parameter name="pembantu_dekan" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Nursva. A. SH. MH."]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nip" isForPrompting="false" class="java.lang.String"/>
	<parameter name="kaprodi" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select
c.nama as nama_mahasiswa,
e.nama as nama_fakultas,
c.waktu_kuliah,
c.nim,
d.nama as nama_jurusan,
(14-$P{semester}) as sisa_masa_studi,
f.kode as kode_matakuliah,
f.nama as nama_matakuliah,
f.sks,
a.nilai_huruf,
a.total_nilai,
a.nilai_ip as nilai_ipk,
(select sum(aa.sks) as kumulatifSKS from matakuliah aa left join perkuliahan bb on (aa.id = bb.matakuliah) left join detailperkuliahan cc on (cc.perkuliahan = bb.id or aa.id = cc.matakuliah_konversi)  where cc.mahasiswa = $P{mahasiswa} and cc.semester = $P{semester}) as kumulatifSKS,
(select sum(cc.nilai_ip*aa.sks)/sum(aa.sks) as kumulatifIPK from matakuliah aa left join perkuliahan bb on (aa.id = bb.matakuliah) left join detailperkuliahan cc on (cc.perkuliahan = bb.id or aa.id = cc.matakuliah_konversi)  where cc.mahasiswa = $P{mahasiswa} and cc.semester = $P{semester}) as nilaiIPKTotal 


from detailperkuliahan a
left join perkuliahan b on (a.perkuliahan = b.id)
left join mahasiswa c on (a.mahasiswa = c.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join matakuliah f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
where a.mahasiswa = $P{mahasiswa}
and a.semester = $P{semester}]]></queryString>


	<field name="kumulatifsks" class="java.lang.Long"/>
	<field name="nilaiipktotal" class="java.lang.Double"/>

	<variable name="jumlah_sks" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="jumlah_ipk" class="java.lang.Double" resetType="Report" calculation="Average">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>

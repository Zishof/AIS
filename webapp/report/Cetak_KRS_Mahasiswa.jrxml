	<parameter name="remedial" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(ngulang) as ngulang,
max(nama) as nama,
max(nim) as nim,
max(jurusan) as jurusan,
max(jenjang) as jenjang,
max(semester) as semester,
max(semester_pk) as semester_pk,
max(tahun_ajaran) as tahun_ajaran,
max(kode_mata_kuliah) as kode_mata_kuliah,
max(mata_kuliah) as mata_kuliah,
max(sks) as sks,
max(kelas) as kelas,
max(ruang) as ruang,
max(hari) as hari,
max(waktu_mulai) as waktu_mulai,
max(waktu_selesai) as waktu_selesai,
max(ruangan) as ruangan,
max(dosen_pa) as dosen_pa,
max(nip_dosen_pa) as nip_dosen_pa,
max(nip_kaprodi) as nip_kaprodi,
max(nama_kaprodi) as nama_kaprodi,
max(dosen) as dosen,
max(catatan) as catatan,
max(nama_fakultas) as nama_fakultas,
merupakan_paralel as merupakan_paralel,max(keteranganjadwal) as keteranganjadwal
from
(
select
(select count(*) from detailperkuliahan aaa inner join perkuliahan bbb on (aaa.perkuliahan=bbb.id) inner join matakuliah ccc on (bbb.matakuliah=ccc.id) where aaa.mahasiswa=m.id and ccc.kode=mk.kode and aaa.id!=dk.id) as ngulang,
m.nama,
		m.nim,
		j.nama as jurusan,
		f.nama as fakultas,
		jg.nama as jenjang,
		dk.semester,
pk.semester as semester_pk,
		pk.tahun_ajaran,
		mk.kode as kode_mata_kuliah,
		mk.nama as mata_kuliah,
		mk.id as id_mk,
		mk.sks,
		pk.kelas,
		pk.ruang,
		pk.hari,
		pk.waktu_mulai,
pk.waktu_selesai,
		r.kode_ruangan as ruangan,
d1.nama as dosen_pa,
d1.code as nip_dosen_pa,
(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
(case when d.nama is not null and e.nama is not null then (d.nama || ', ' || e.nama) when  d.nama is not null then d.nama else '' end) as dosen,
(select max(catatan) from krs_mahasiswa cc where cc.mahasiswa=m.id and case when $P{tahapan}<=0 then cc.semester=$P{semester} else cc.tahapan=$P{tahapan} end) as catatan,
f.nama as nama_fakultas,
pk.merupakan_paralel,pk.keteranganjadwal


from mahasiswa m
inner join jurusan j on (m.jurusan = j.id)
inner join fakultas f on (j.fakultas = f.id)
inner join jenjang jg on (m.jenjang = jg.id)
inner join detailperkuliahan dk on (dk.mahasiswa = m.id)
left join perkuliahan pk on (dk.perkuliahan = pk.id or dk.perkuliahan = pk.perkuliahan_paralel)
left join kurikulum_punya_matakuliah kur on (pk.kurikulum_punya_matakuliah = kur.id)
inner join matakuliah mk on (pk.matakuliah = mk.id  or dk.matakuliah_konversi = mk.id)
left join dosen d1 on (m.dosen = d1.id)
left join dosen d on (pk.dosen1 = d.id)
left join dosen e on (pk.dosen2 = e.id)
left join ruang r on pk.ruang = r.id
left join (
	select aa.nama, aa.nip, aa.jurusan
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kaprodi%'
) h on (h.jurusan = m.jurusan)
left join dosen i on (j.kaprodi = i.id)
where m.id=$P{mahasiswa}
and (case when $P{konversi_masuk_akumulasi_jumlah_sks_pengambilan_krs}='tidak aktif' then dk.matakuliah_konversi is null else true end)
and (case when $P{tahapan}<=0 then dk.semester=$P{semester} else true end)
and (case when $P{tahapan}<=0 then true else (dk.tahap=$P{tahapan}) end)
and case when $P{semester_pendek} is null then pk.status_semesterpendek is null else pk.status_semesterpendek = $P{semester_pendek} end
and case when $P{remedial} then pk.merupakanremedial = true else pk.merupakanremedial = false or pk.merupakanremedial is null end
order by mk.kode
) cc group by cc.id_mk,merupakan_paralel]]>
	</queryString>

	<queryString>
		<![CDATA[select
a.nama,
a.tempatlahir,
a.tanggallahir,
a.nim,
a.tanggal_masuk,
a.tanggal_lulus,
b.gelar,
b.nama as jurusan,
a.no_ijazah1,
c.juara,c.nama as prestasi,c.tempat,c.penyelenggara,c.tanggal,c.nomorsertifikat,
a.jurusan as jurusan_id,
a.tahunlulus
from mahasiswa a
inner join jurusan b on (a.jurusan=b.id)
inner join prestasi_mahasiswa c on (c.mahasiswa=a.id)
where a.id=$P{mahasiswa_id}
and c.status='Disetujui']]>
	</queryString>

	<queryString>
		<![CDATA[select
a.mahasiswa
from detailperkuliahan a
inner join mahasiswa b on (a.mahasiswa = b.id)
left join perkuliahan bb on (bb.id = a.perkuliahan)
inner join kelompok_matakuliah_punya_matakuliah c on (c.matakuliah = a.matakuliah_konversi or c.matakuliah = bb.matakuliah)
where a.semester = $P{semester}
and b.tahunangkatan = $P{tahunangkatan}
and b.jurusan = $P{jurusan}
and a.persetujuan = 1 and a.ikuti_perkuliahan is null 
and a.semester >= 0 and a.total_nilai >= 1.0 and a.total_nilai is not null and a.nilai_huruf is not null and trim(a.nilai_huruf) != ''
group by a.mahasiswa
order by max(b.nim)]]>
	</queryString>
	<field name="mahasiswa" class="java.lang.Long"/>

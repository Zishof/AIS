		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jadwal" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[(select
'Pembimbing I' as pembimbing,
a.pembimbing as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_ketua_sidang status_sidang,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf,
a.tanggal_sidang,
a.awal_bimbingan,
a.akhir_bimbingan

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
inner join dosen d on a.pembimbing = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.pembimbing = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.pembimbing,j.nama,m.nim
)

union all

(
select
'Pembimbing II' as pembimbing,
a.ketua_sidang as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_pembimbing status_sidang,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf,
a.tanggal_sidang,
a.awal_bimbingan,
a.akhir_bimbingan

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
inner join dosen d on a.ketua_sidang = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.ketua_sidang = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.ketua_sidang,j.nama,m.nim
)

union all

(
select
'Penguji I' as pembimbing,
a.penguji1 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_penguji1 status_sidang,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf,
a.tanggal_sidang,
a.awal_bimbingan,
a.akhir_bimbingan

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
inner join dosen d on a.penguji1 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.penguji1 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.penguji1,j.nama,m.nim
)

union all

(
select
'Penguji II' as pembimbing,
a.penguji2 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_penguji2 status_sidang,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf,
a.tanggal_sidang,
a.awal_bimbingan,
a.akhir_bimbingan

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
inner join dosen d on a.penguji2 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.penguji2 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by a.penguji2,j.nama,m.nim
)

union all

(
select
'Penguji III' as pembimbing,
a.penguji3 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_penguji_3 status_sidang,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf,
a.tanggal_sidang,
a.awal_bimbingan,
a.akhir_bimbingan

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
inner join dosen d on a.penguji3 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.penguji3 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end

order by a.penguji3,j.nama,m.nim
)


union all

(
select
'Penguji IV' as pembimbing,
a.penguji4 as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d.nama as dosen,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_penguji_4 status_sidang,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf,
a.tanggal_sidang,
a.awal_bimbingan,
a.akhir_bimbingan

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
inner join dosen d on a.penguji4 = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else a.penguji4 = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end

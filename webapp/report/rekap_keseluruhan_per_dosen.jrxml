	<variable name="nilai 1" class="java.lang.Long" resetType="Group" resetGroup="grup" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai 1}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="nilai 2" class="java.lang.Long" resetType="Group" resetGroup="grup" calculation="Sum">

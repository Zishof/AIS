	</variable>
	<variable name="nilai 2_1" class="java.lang.Long" resetType="Group" resetGroup="dosen" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai 2}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="nilai 3_1" class="java.lang.Long" resetType="Group" resetGroup="dosen" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai 3}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="nilai 4_1" class="java.lang.Long" resetType="Group" resetGroup="dosen" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai 4}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="nilai 5_1" class="java.lang.Long" resetType="Group" resetGroup="dosen" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai 5}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="total_1" class="java.lang.Long" resetType="Group" resetGroup="dosen" calculation="Sum">
		<variableExpression><![CDATA[$F{total}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="total" class="java.lang.Long" resetType="Group" resetGroup="grup" calculation="Sum">
		<variableExpression><![CDATA[$F{total}/$F{bobot}]]></variableExpression>
	</variable>
	<variable name="ip_dosen" class="java.lang.Double" resetType="Group" resetGroup="dosen" calculation="Sum">
		<variableExpression><![CDATA[((0.2*$F{bobot}*$F{nilai 1})+(0.4*$F{bobot}*$F{nilai 2})+(0.6*$F{bobot}*$F{nilai 3})+(0.8*$F{bobot}*$F{nilai 4})+(1*$F{bobot}*$F{nilai 5}))/($F{nilai 1}+$F{nilai 2}+$F{nilai 3}+$F{nilai 4}+$F{nilai 5})]]></variableExpression>
	</variable>
	<variable name="total_nilai_1_1" class="java.lang.Double" resetType="Group" resetGroup="grup" calculation="Average">
		<variableExpression><![CDATA[((0.2*$F{bobot}*$F{nilai 1})+(0.4*$F{bobot}*$F{nilai 2})+(0.6*$F{bobot}*$F{nilai 3})+(0.8*$F{bobot}*$F{nilai 4})+(1*$F{bobot}*$F{nilai 5}))/($F{nilai 1}+$F{nilai 2}+$F{nilai 3}+$F{nilai 4}+$F{nilai 5})]]></variableExpression>
	</variable>
	<variable name="total_bobot_1_1" class="java.lang.Double" resetType="Group" resetGroup="grup" calculation="Average">
		<variableExpression><![CDATA[(0.2*$F{bobot}*$F{nilai 1})+(0.4*$F{bobot}*$F{nilai 2})+(0.6*$F{bobot}*$F{nilai 3})+(0.8*$F{bobot}*$F{nilai 4})+(1*$F{bobot}*$F{nilai 5})]]></variableExpression>
	</variable>
	<variable name="total_nilai_1_1_2" class="java.lang.Double" resetType="Group" resetGroup="dosen" calculation="Average">
		<variableExpression><![CDATA[((0.2*$F{bobot}*$F{nilai 1})+(0.4*$F{bobot}*$F{nilai 2})+(0.6*$F{bobot}*$F{nilai 3})+(0.8*$F{bobot}*$F{nilai 4})+(1*$F{bobot}*$F{nilai 5}))/($F{nilai 1}+$F{nilai 2}+$F{nilai 3}+$F{nilai 4}+$F{nilai 5})]]></variableExpression>
	</variable>
	<variable name="total_bobot_1_1_2" class="java.lang.Double" resetType="Group" resetGroup="dosen" calculation="Average">
		<variableExpression><![CDATA[(0.2*$F{bobot}*$F{nilai 1})+(0.4*$F{bobot}*$F{nilai 2})+(0.6*$F{bobot}*$F{nilai 3})+(0.8*$F{bobot}*$F{nilai 4})+(1*$F{bobot}*$F{nilai 5})]]></variableExpression>
	</variable>

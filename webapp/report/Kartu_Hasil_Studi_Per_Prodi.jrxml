	<queryString>
		<![CDATA[select
c.id as id_mahasiswa,
c.nim

from mahasiswa c
where c.tahunangkatan = $P{tahunangkatan}
and c.jurusan = $P{jurusan}
and case when $P{kelas}='' then true else c.kelas ilike $P{kelas} end
and case when $X{IN,'-1',nims} then true else $X{IN,c.nim,nims} end
order by nim]]>
	</queryString>
	<field name="id_mahasiswa" class="java.lang.Long"/>
	<field name="nim" class="java.lang.String"/>

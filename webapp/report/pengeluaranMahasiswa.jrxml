	<queryString>
		<![CDATA[(select
a.mahasiswa,
b.nim,
b.nama,
a.tanggal,
a.deposit,
a.keterangan
from(
	select
	a.waktu as tanggal,
	a.mahasiswa,
	a.nominal as deposit,
	a.keterangan
	from deposit a

	union all

	select
	a.tanggal,
	b.mahasiswa,
	-(a.deposit) as deposit,
	a.keterangan
	from cicilan_pembayaran a
	inner join kegiatan b on (a.kegiatan=b.id)
	where a.deposit > 0.1 and b.mahasiswa is not null
) a
inner join mahasiswa b on (a.mahasiswa=b.id)
where case when $P{mahasiswa}=-1 then true else b.id=$P{mahasiswa} end
and case when $P{mulai}='' then true else date(a.tanggal)>=date($P{mulai}) end
and case when $P{sampai}='' then true else date(a.tanggal)<=date($P{sampai}) end
)

union all

(
select
a.mahasiswa,
b.no_registrasi as nim,
b.nama,
a.tanggal,
a.deposit,
a.keterangan
from(
	select
	a.waktu as tanggal,
	a.biodata_calon_mahasiswa as mahasiswa,
	a.nominal as deposit,
	a.keterangan
	from deposit a

	union all

	select
	a.tanggal,
	b.calon_mahasiswa as mahasiswa,
	-(a.deposit) as deposit,
	a.keterangan
	from cicilan_pembayaran a
	inner join kegiatan b on (a.kegiatan=b.id)
	where a.deposit > 0.1 and b.calon_mahasiswa is not null
) a
inner join biodata_calon_mahasiswa b on (a.mahasiswa=b.id)
where case when $P{calonMahasiswa}=-1 then true else b.id=$P{calonMahasiswa} end
and case when $P{mulai}='' then true else date(a.tanggal)>=date($P{mulai}) end
and case when $P{sampai}='' then true else date(a.tanggal)<=date($P{sampai}) end

)

order by mahasiswa,tanggal

]]>
	</queryString>

	<parameter name="logo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="fakultas" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<parameter name="status" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<parameter name="tahunangkatan" isForPrompting="false" class="java.lang.Integer"/>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="konsentrasi" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select a.nim as nim, a.nama as namamahasiswa, a.tahunangkatan as tahunangkatan, b.nama as prodi, 
c.nama as statusmahasiswa, d.nama as namafakultas, e.nama as namakonsentrasi from mahasiswa a 
left join jurusan b on (b.id = a.jurusan) 
left join status_mahasiswa c on (c.id = a.status) 
left join fakultas d on (d.id = b.fakultas)
left join jurusan e on (e.id = b.id) 

where b.id = (case $P{jurusan} when -1 then b.id else $P{jurusan} end)
and a.tahunangkatan = (case $P{tahunangkatan} when -1 then a.tahunangkatan else $P{tahunangkatan} end)
and c.id = (case $P{status} when -1 then c.id else $P{status} end)
and d.id = (case $P{fakultas} when -1 then d.id else $P{fakultas} end)
and e.id = (case $P{konsentrasi} when -1 then e.id else $P{konsentrasi} end)
or e.prodi_dari_jurusan = (case $P{jurusan} when -1 then e.prodi_dari_jurusan else $P{jurusan} end)
order by a.jurusan]]></queryString>


		<defaultValueExpression><![CDATA["2014/2015"]]></defaultValueExpression>
	</parameter>
	<parameter name="genapGanjil" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_dosen" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Andri"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jumlah_pilihan_checklist_penilaian_dosen_oleh_mahasiswa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["5"]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select *
from (
select
e.nama as dosen,
e.id as id_dosen,
min(coalesce(a.nomor_urut, 2147483647)) as urut_checklist,
(((sum(x.nilai1)*1)+(sum(x.nilai2)*2)+(sum(x.nilai3)*3)+(sum(x.nilai4)*4)+(sum(x.nilai5)*5))*100)/(sum(x.total)*max(b1.jumlahPilihan)*1.00) as "total"
from rekap_angket_dosen x
inner join checklist_penilaian_dosen a on (a.id=x.checklist_penilaian_dosen)
inner join grup_checklist_penilaian_dosen b on (a.grup_checklist_penilaian_dosen=b.id)
inner join angket_penilaian_dosen b1 on (b.angket_penilaian_dosen=b1.id)
inner join perkuliahan c on (x.perkuliahan=c.id)
inner join jurusan d on (c.jurusan=d.id)
inner join dosen e on (x.dosen=e.id)
where c.tahun_ajaran=$P{tahun_akademik}
and c.ganjil_genap = (case $P{genapGanjil} when 'Semua' then c.ganjil_genap else $P{genapGanjil} end)
and case when $P{jurusan}=-1 then true else c.jurusan=$P{jurusan} end
and case when $P{fakultas}=-1 then true else d.fakultas=$P{fakultas} end
and case when $P{program}='-1' then true else c.program=$P{program} end
and (a.aktif or a.aktif is null) and (b.aktif or b.aktif is null)
GROUP BY e.id
) xx order by total desc,urut_checklist,id_dosen]]>
	</queryString>
	<field name="dosen" class="java.lang.String"/>
	<field name="id_dosen" class="java.lang.Long"/>
	<field name="urut_checklist" class="java.lang.Integer"/>
	<field name="total" class="java.math.BigDecimal"/>

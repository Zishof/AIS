	<queryString>
		<![CDATA[select b.nama,b.nim,a.semester,a.tahun_akademik,b.tempatlahir,b.alamat,b.tanggallahir,a.keterangan as alasan, c.nama as nama_jurusan, d.nama as nama_fakultas, f.nama as nama_dosen, b.nama as nama_mahasiswa, i.nama as nama_kaprodi, i.mycode as nip_kaprodi, ba.nama as jenis_pengajuan
from pengajuan_mahasiswa a
inner join jenis_pengajuan ba on (a.jenis_pengajuan = ba.id)
inner join mahasiswa b on (a.mahasiswa = b.id)
inner join jurusan c on (b.jurusan = c.id)
inner join fakultas d on (c.fakultas = d.id)
left join dosen f on (f.id = b.dosen)
left join dosen i on (c.kaprodi = i.id)
where a.id = $P{id}]]>
	</queryString>

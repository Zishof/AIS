	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="ta" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2016/2017"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Jakarta"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.*,
b.nomorsertifikasi,
b.mycode as nip,
b.nidn as nidn,
b.nama,
c.nama as perguruan_tinggi,
(case when c.alamat1 is null then '' else c.alamat1 end)||' '||(case when c.alamat2 is null then '' else c.alamat2 end) as alamat_perguruan_tinggi,
d.nama as fakultas,
e.nama as jurusan,
f.nama as jabatan_fungsional_dosen,
g.nama as golongan_pegawai,
b.pendidikans1,
b.pendidikans2,
b.pendidikans3,
(case when b.spesialisasi1 is null then '' else b.spesialisasi1 end)||' '||(case when b.spesialisasi2 is null then '' else b.spesialisasi2 end)||' '||(case when b.spesialisasi3 is null then '' else b.spesialisasi3 end) as bidang_ilmu,
trim((case when b.telp is null then '' else b.telp||' ' end)||(case when b1.hp is null then '' else b1.hp end)) as telp,
b.email,
d2.nama as atasan,
d2.mycode as nip_atasan,
b.atasanlangsung,
b.id as id_dosen_asli

from (
	select
	aaa.id_dosen,
	max(aaa.dosen) as dosen,
	aaa.bidang_kinerja,
	max(aaa.judul) as judul,
	max(aaa.bukti) as bukti,
	max(aaa.masatugas) as masatugas,
	avg(aaa.sks_beban) as sks_beban,
	avg(aaa.sks_nilai) as sks
	from (
		select
	a.bidang as bidang_kinerja,
 	a.spesifikasi as subbidang,
	a.masatugas,
	a3.bukti,
 	a1.id id_dosen,
	a1.nama as dosen,
 	a2.nama as asesor,
 	a2.id as asesor_id,
	a3.sks_kinerja sks_nilai,
	a.sks_beban,

 	a.keterangan as judul

 	from asesemen_penilaian a
	inner join pegawai a1 on (a.pegawai=a1.id)
	left join penilaian_asesor a3 on (a3.asesemen_penilaian = a.id)
	left join asesor a4 on (a3.asesor = a4.id)
	left join asesor_penunjang_kinerja_dosen a2 on (a4.asesor_penunjang_kinerja_dosen=a2.id)


	where a2.aktif and a.aktif
	and (a.sks_beban > 0.1 or a3.sks_kinerja > 0.1)
	and a.tahunakademik=$P{ta}
	and a.semester=$P{semester}
	and case when $P{dosen}=-1 then true else a.pegawai=$P{dosen} end
	) aaa
	group by aaa.id_dosen,aaa.bidang_kinerja,aaa.judul
	order by aaa.id_dosen,aaa.bidang_kinerja,aaa.judul
) a
left join pegawai peg on (a.id_dosen=peg.id)
left join dosen b on (peg.dosen=b.id)
left join dosen d2 on (d2.id = b.atasanlangsung)
left join biodata_dosen b1 on (b.id=b1.dosen)
left join perguruan_tinggi c on (b.perguruan_tinggi=c.id)
left join fakultas d on (b.fakultas=d.id)
left join jurusan e on (b.jurusan=e.id)
left join jabatan_fungsional_dosen f on (b.jabatan_fungsional_dosen=f.id)
left join employ.golongan g on (b.golongan_pegawai=g.id)]]>
	</queryString>

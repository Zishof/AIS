	</parameter>
	<parameter name="SUBREPORT_DIR_UJIAN" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{SUBREPORT_DIR} + "Cetak_KUAS_Mahasiswa.jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
aa.mahasiswa,
m.nama as namamahasiswa,
case when $P{jenis_ujian}='uts' then k.nouts else k.nouas end as nomoujian,
f.nama as namafakultas


from detailperkuliahan aa
inner join perkuliahan a on (aa.perkuliahan=a.id)
inner join mahasiswa m on (aa.mahasiswa=m.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas f on (d.fakultas=d.id)
inner join krs_mahasiswa k on (aa.mahasiswa=k.mahasiswa and aa.semester=k.semester and semesterpendek is null)

where d.fakultas is not null
and case $P{kelas} when '' then true else m.kelas ilike '%'||$P{kelas}||'%' end
and case $P{semester} when -1 then true else aa.semester=$P{semester} end
and case $P{tahun_akademik} when '-1' then true else a.tahun_ajaran = $P{tahun_akademik} end
and case $P{jurusan} when -1 then true else a.jurusan = $P{jurusan} end
and case $P{fakultas} when -1 then true else d.fakultas=$P{fakultas} end
order by m.nim ]]>
	</queryString>
	<field name="mahasiswa" class="java.lang.Long"/>
	<field name="namamahasiswa" class="java.lang.String"/>
	<field name="nomoujian" class="java.lang.String"/>
	<field name="namafakultas" class="java.lang.String"/>

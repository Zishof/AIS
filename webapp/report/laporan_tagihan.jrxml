					</subreportParameter>
					<subreportParameter name="foto">
						<subreportParameterExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "current_local_url" )+"/AmbilMedia?id="+$F{mahasiswa}+"&name=nama&foto=foto&clazz=ais.database.model.file.FotoMahasiswa&property=mahasiswa&var=3"]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter name="kelas">
						<subreportParameterExpression><![CDATA[$P{kelas}]]></subreportParameterExpression>
					</subreportParameter>

	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="ruang" class="java.lang.Long"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggalKe" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ungaran"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select aa.id as ujian_pmb, b.nama as ruang,c.noujian as no_ujian, c.nama_siswa as pendaftar,
e.nama as gedung,
bbb.nama as gelombang_pendaftaran,
b.tahunakademik,
aa.tanggalujian1
from sekolah.ruang_gelombang_psb a
left join sekolah.ruang_psb b on a.ruang_psb = b.id
left join sekolah.ujian_psb aa on (b.ujian_psb = aa.id)
left join sekolah.gelombang_pendaftaran_psb bbb on (aa.gelombang_pendaftaran_psb = bbb.id)
left join sekolah.calon_siswa c on a.calon_siswa = c.id
left join gedung e on b.gedung = e.id
where a.ruang_psb=$P{ruang}
order by c.noujian]]>
	</queryString>
	<field name="ujian_pmb" class="java.lang.Long"/>
	<field name="ruang" class="java.lang.String"/>
	<field name="no_ujian" class="java.lang.String"/>
	<field name="pendaftar" class="java.lang.String"/>
	<field name="gedung" class="java.lang.String"/>
	<field name="gelombang_pendaftaran" class="java.lang.String"/>
	<field name="tahunakademik" class="java.lang.String"/>
	<field name="tanggalujian1" class="java.sql.Timestamp"/>
	<background>
		<band splitType="Stretch"/>
	</background>

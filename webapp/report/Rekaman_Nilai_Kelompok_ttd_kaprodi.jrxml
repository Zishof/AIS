					<font size="8" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "ttd_transkrip_akademik_mhs" )==null?$F{nama_kaprodi}:$P{pembantu_rektor}]]></textFieldExpression>

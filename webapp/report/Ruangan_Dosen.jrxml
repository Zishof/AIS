	<queryString>
		<![CDATA[select
nidn, mycode, a.nama, c.nama as status, d.nama as jabatan, b.id as id_ruang, b.nama as nama_ruang
from dosen a
left join ruang b on (a.ruang = b.id)
left join status_kepegawaian c on (a.status_kepegawaian=c.id)
left join jabatan_fungsional_dosen d on (a.jabatan_fungsional_dosen=d.id)
where a.aktif
and case when $P{fakultas}=-1 then true else a.fakultas=$P{fakultas} end
and case when $P{jurusan}=-1 then true else a.jurusan=$P{jurusan} end
and case when $P{dosen}='' then true else a.nama ilike '%'||$P{dosen}||'%' end
order by nama_ruang asc]]>
	</queryString>

			<staticText><reportElement x="0" y="21" width="511" height="20" uuid="9c5b04b2-1088-4cd8-813b-e0b4aa962207"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="12" isBold="true"/></textElement><text><![CDATA[REKAPITULASI NILAI]]></text></staticText>

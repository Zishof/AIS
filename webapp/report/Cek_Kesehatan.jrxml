	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="no_ujian" class="java.lang.String" isForPrompting="false"/>
	<parameter name="cek_kesehatan" class="java.lang.Long"/>
	<parameter name="foto" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.nama as nama_lengkap,b.jenis_kelamin,b.tempat_lahir,b.tanggal_lahir,
b.alamat,b.kecamatan_calon,b.keluarahan_calon,d.nama as kota,b.kode_pos,c.nama as jenis_seleksi,

a.status_sehat,a.penyakit_1,a.penyakit_2,a.penyakit_3,a.penyakit_4,a.penyakit_5,a.no__urut no_urut,
a.tekanan_darah,a.buta_warna,a.narkoba,
a.rontgen_1,a.rontgen_2,a.rontgen_3,
a.sehat_terbatas_1,a.sehat_terbatas_2,a.sehat_terbatas_3,a.sehat_terbatas_4,b.no_ujian,
e.nama as jurusan, f.nama as fakultas

from cek_kesehatan a
left join biodata_calon_mahasiswa b on a.calon_mahasiswa=b.id
left join jenis_seleksi c on b.jenis_seleksi=c.id
left join kota d on b.kota_calon=d.id
left join jurusan e on b.prodi_lulus = e.id
left join fakultas f on e.fakultas = f.id
where a.id=$P{cek_kesehatan}]]>
	</queryString>

	<queryString>
		<![CDATA[select
a.hari,
a.waktu_mulai,
a.waktu_selesai,
UPPER(b.nama) as mk,
(case when c.nama is null then '' else c.nama end)||
(case when c2.nama is null then '' else ', '||c2.nama end)||
(case when c3.nama is null then '' else ', '||c3.nama end)||
(case when c4.nama is null then '' else ', '||c4.nama end)||
(case when c5.nama is null then '' else ', '||c5.nama end)||
(case when c6.nama is null then '' else ', '||c6.nama end)||
(case when c7.nama is null then '' else ', '||c7.nama end)||
(case when c8.nama is null then '' else ', '||c8.nama end)||
(case when c9.nama is null then '' else ', '||c9.nama end)||
(case when c10.nama is null then '' else ', '||c10.nama end)

 as dosen,
a.semester,
a.kelas as kelas,
b.sks,
f.nama as ruang,
e.nama as fakultas,
d.nama as jurusan,
a.tahun_ajaran
from perkuliahan a
left join matakuliah b on (a.matakuliah = b.id)
left join dosen c on (a.dosen1 = c.id)
left join dosen c2 on (a.dosen2 = c2.id)
left join dosen c3 on (a.dosen3 = c3.id)
left join dosen c4 on (a.dosen4 = c4.id)
left join dosen c5 on (a.dosen5 = c5.id)
left join dosen c6 on (a.dosen6 = c6.id)
left join dosen c7 on (a.dosen7 = c7.id)
left join dosen c8 on (a.dosen8 = c8.id)
left join dosen c9 on (a.dosen9 = c9.id)
left join dosen c10 on (a.dosen10 = c10.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)
left join ruang f on (f.id = a.ruang)

where 1=1
and a.dosen1 is not null
and case when  $P{hari} = 'Semua' then true else a.hari = $P{hari} end
and case when  $P{program} = 'Semua' then true else a.program = $P{program} end
and case when  $P{tahun_akademik} = 'Semua' then true else a.tahun_ajaran = $P{tahun_akademik} end
and case when $P{jenis_semester} = 'Semua' then true else a.semester % 2 = (case $P{jenis_semester} when 'Genap' then 0 else 1 end) end
and case when $P{jurusan} = -1 then true else d.id = $P{jurusan} end
and case when $P{fakultas} = -1 then true else e.id = $P{fakultas} end
and case when $P{kelas} = '-1' then true else a.kelas ilike $P{kelas} end
and case $P{masa_perkuliahan} when -1 then true else a.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then a.status_semesterpendek is null else a.status_semesterpendek = $P{semester_pendek} end
and case $P{ekstrakurikuler} when -1 then b.extrakulikuler = false else b.extrakulikuler end
order by
case a.hari when 'Senin' then 1 when 'Selasa' then 2 when 'Rabu' then 3 when 'Kamis' then 4 when 'Jum\''at' then 5 when 'Sabtu' then 6 when 'Minggu' then 7 end,
CAST(a.waktu_mulai as double precision) asc,
CAST(a.waktu_selesai as double precision) asc, c.nama]]>
	</queryString>

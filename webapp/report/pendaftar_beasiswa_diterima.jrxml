<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="penerima-beasiswa" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_beasiswa" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="logo1" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
b.nama as nama_mhs,
b.nim as nim_mhs,
d.nama as jurusan,
e.nama as fakultas,

c.nama as nama_beasiswa,
c.tahun as tahun_beasiswa,
c.instansi as instansi_beasiswa


FROM mahasiswa_daftar_beasiswa a
LEFT JOIN mahasiswa b on a.mahasiswa = b."id"
LEFT JOIN beasiswa c on a.beasiswa = c."id"

left join jurusan d on b.jurusan = d."id"
LEFT JOIN fakultas e on d.fakultas = e."id"

WHERE c."id" = $P{id_beasiswa}
AND a.terima=1



order by b.nim]]>
	</queryString>
	<field name="nama_mhs" class="java.lang.String"/>
	<field name="nim_mhs" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="nama_beasiswa" class="java.lang.String"/>
	<field name="tahun_beasiswa" class="java.lang.Integer"/>
	<field name="instansi_beasiswa" class="java.lang.String"/>

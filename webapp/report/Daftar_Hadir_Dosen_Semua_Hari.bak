	<parameter name="hari" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Senin"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["12 Januari 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="waktu" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["SEMUA"]]></defaultValueExpression>
	</parameter>
	<parameter name="dekan" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Prof. DR. Yudha Bhakti. SH. MH"]]></defaultValueExpression>
	</parameter>
	<parameter name="pembantu_dekan" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Nursva. A. SH. MH."]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="pudek1" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_dibuat" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["22 Juni 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(100040)]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_ajaran" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["2010/2011"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="genapGanjil" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="program" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Reguler"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
a.waktu_mulai,
a.waktu_selesai,
b.nama as mk,
c.nama as dosen,
c.pangkat,
a.semester,
b.sks,
a.kelas,
cc.nama as ruang,
e.nama as fakultas,
a.hari
from perkuliahan a
left join matakuliah b on (a.matakuliah = b.id)
left join ruang cc on (a.ruang = cc.id)
left join dosen c on (a.dosen1 = c.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)
where 
c.id = $P{dosen}
and (a.semester % 2) = (CASE $P{genapGanjil} when 'Genap' then 0 else 1 end)
and a.tahun_ajaran = $P{tahun_ajaran}
and a.program = $P{program}
order by 

(case a.hari when 'Senin' then 1 when 'Selasa' then 2 when 'Rabu' then 3 when 'Kamis' then 4 when 'Jumat' then 5 when 'Sabtu' then 6 when 'Minggu' then 7 end),(a.waktu_mulai_d) ]]></queryString>


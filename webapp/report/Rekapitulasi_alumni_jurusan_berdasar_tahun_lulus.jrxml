	<queryString>
		<![CDATA[SELECT b.nama as jurusan,count(a.nim) as jumlah,c.nama as fakultas,
a.tahunlulus tahunangkatan, date(a.tahunlulus||'-06-06') as tanggal_lulus
FROM
mahasiswa a
left join jurusan b on a.jurusan=b.id
left join fakultas c on b.fakultas=c.id
where  a.tahunlulus>=$P{dari} and a.tahunlulus<=$P{sampai} and a.tahunlulus is not null
group by a.tahunlulus,b.id,c.id
order by a.tahunlulus,b.nama,c.nama]]>
	</queryString>
	<field name="jurusan" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Long"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="tahunangkatan" class="java.lang.Integer"/>
	<field name="tanggal_lulus" class="java.sql.Date"/>
	<variable name="angka" class="java.lang.Integer" resetType="None" calculation="Count">
		<variableExpression><![CDATA[$V{angka}]]></variableExpression>
	</variable>
	<variable name="total" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<variable name="total_angkatan" class="java.lang.Long" resetType="Group" resetGroup="angkatan" calculation="Sum">

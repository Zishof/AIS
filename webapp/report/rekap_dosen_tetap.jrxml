	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String"/>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(a.code) as code, max(a.nidn) as nidn, max(a.nama) as nama, max(a.tempatlahir) as tempatlahir, max(a.tanggallahir) as tanggallahir, max(a.alamat) as alamat, max(a.pangkat) as pangkat, max(a.golongan) as golongan, max(a.jabatan) as jabatan,
max(a.spesialisasi1 || ' ' || a.spesialisasi2 || ' ' || a.spesialisasi3) as spesialisasi,
max(b.nama) as jurusan,
max(a.kelamin) as kelamin,
max(c.nama) as status_pegawai
from perkuliahan aa
inner join dosen a on (aa.dosen1 = a.id or aa.dosen2 = a.id  or aa.dosen3 = a.id  or aa.dosen4 = a.id  or aa.dosen5 = a.id  or aa.dosen6 = a.id  or aa.dosen7 = a.id  or aa.dosen8 = a.id  or aa.dosen9 = a.id or aa.dosen10 = a.id)
left join jurusan b on (a.jurusan = b.id)
left join status_pegawai c on (c.id = a.status_pegawai)
where a.tetap = 1
and case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{fakultas} = -1 then true else b.fakultas = $P{fakultas} end
and case  $P{semester} when '-1' then true when 'Ganjil' then aa.semester%2 = 1 else aa.semester%2 = 0 end
and case $P{tahun_akademik} when '-1' then true else aa.tahun_ajaran = $P{tahun_akademik} end
group by a.id
order by max(a.nama)]]>
	</queryString>

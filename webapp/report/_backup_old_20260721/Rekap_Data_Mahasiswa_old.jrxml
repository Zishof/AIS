	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Reguler"]]></defaultValueExpression>
	</parameter>
	<parameter name="kelamin" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Laki-laki"]]></defaultValueExpression>
	</parameter>
	<parameter name="current_ta" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2016/2017"]]></defaultValueExpression>
	</parameter>
	<parameter name="current_semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahunAkademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2016/2017"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.nim as nim, a.nama as namamahasiswa, a.tahunangkatan as tahunangkatan, b.nama as prodi,
c.nama as statusmahasiswa, d.nama as namafakultas, a.kelamin as namakonsentrasi
from mahasiswa a
left join jurusan b on (b.id = a.jurusan)
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{tahunAkademik}
	and semester%2=(case when $P{semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.id=b1.mahasiswa)
left join status_mahasiswa c on (c.id = b1.status_mahasiswa)
left join fakultas d on (d.id = b.fakultas)
left join jurusan e on (e.id = b.id)

where b.id = (case $P{jurusan} when -1 then b.id else $P{jurusan} end)
and case when $P{kelamin} = '-1' then true else a.kelamin = $P{kelamin} end
and case when $P{program} = '-1' then true else a.program =  $P{program} end
and a.tahunangkatan = (case $P{tahunangkatan} when -1 then a.tahunangkatan else $P{tahunangkatan} end)
and c.id = (case $P{status} when -1 then c.id else $P{status} end)
and d.id = (case $P{fakultas} when -1 then d.id else $P{fakultas} end)
order by a.jurusan, a.tahunangkatan, a.nim]]>
	</queryString>

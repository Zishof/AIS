				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "ttd_transkrip_akademik_mhs" )==null?"Ka. Prodi":$P{REPORT_PARAMETERS_MAP}.get( "ttd_transkrip_akademik_mhs" )]]></textFieldExpression>

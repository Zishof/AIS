	<variable name="jumlah_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="jumlah_ipk" class="java.lang.Double" calculation="Average">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>
	<variable name="sum_val" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>

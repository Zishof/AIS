	<queryString>
		<![CDATA[select
a.kode as kode_transaksi,
a.tanggal_transaksi,
b.kode as kode_akun,
b.nama as nama_akun,
a.keterangan as keterangan_transaksi,
a.debet,
a.kredit



from akunting.transaksi a
left join akunting.akun b on (a.akun = b.id)

where case when $P{grup_id}=-1 then true else grup_transaksi=$P{grup_id} end
and case when $X{IN,-1,grup_ids} then true else $X{IN,a.grup_transaksi,grup_ids} end
order by a.kode]]>
	</queryString>

	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[9L]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Documents\\My Project\\Academic Information System\\AIS\\ais\\web\\report\\employ\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="peg_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dos_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.id as dosen1,
b.nama as nama_dosen,
a.judul,
a1.tahun,
a.jumlahdana,
d.nama as sumber_dana,
a.masapenugasan,
a1.sks


from penelitiandanpengabdian.pengajuan_penelitian_dan_pengabdian a
inner join penelitiandanpengabdian.penelitian_dan_pengabdian a1 on (a.penelitian_dan_pengabdian=a1.id)
inner join tbmuser a2 on (a2.userid=a.tbmuser)
inner join dosen b on (a2.dosen = b.id)
inner join penelitiandanpengabdian.pengajuan_has_sumber_dana c on (c.pengajuan=a.id)
inner join penelitiandanpengabdian.sumber_dana_penelitian_dan_pengabdian d on (c.sumber_dana=d.id)
inner join penelitiandanpengabdian.tipe_penelitian_dan_pengabdian e on (e.id=a1.tipe_penelitian_dan_pengabdian)
where b.id=$P{dos_id} and e.isi = 'Pengabdian Masyarakat'  and a.status='Disetujui']]>
	</queryString>
	<field name="dosen1" class="java.lang.Long"/>
	<field name="nama_dosen" class="java.lang.String"/>
	<field name="judul" class="java.lang.String"/>
	<field name="tahun" class="java.lang.Integer"/>
	<field name="jumlahdana" class="java.lang.Double"/>
	<field name="sumber_dana" class="java.lang.String"/>
	<field name="masapenugasan" class="java.lang.String"/>
	<field name="sks" class="java.lang.Integer"/>

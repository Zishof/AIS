<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Rekapitulasi_Daftar_Hadir_Tenaga_Kependidikan_Report" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="086eaa24-d4d5-4561-ae75-c2c1f0ad687c">
	<property name="ireport.zoom" value="1.3310000000000177"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nama_biro_uauk" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Drs. H. Yasrizal, M.A"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.nama,
b.mycode as nip,
max(f.nama) as golongan,
max(d.nama) as fungsi,
max(e.nama) as jabatan,
sum(case when a.minggu not in (6,7) then 1 else 0 end) as hari_kerja,
sum(case when a.statusabsensi=2 then 1 else 0 end) as alpa,
sum(case when a.statusabsensi=1 then 1 else 0 end) as masuk,
sum(case when a.statusabsensi=3 then 1 else 0 end) as sakit,
sum(case when a.statusabsensi=4 then 1 else 0 end) as izin,
sum(case when a.statusabsensi in (6,7) then 1 else 0 end) as cuti,
sum(case when a.statusabsensi=8 then 1 else 0 end) as dinas_luar,
sum(case when a.masuk_jam is null then 1 else 0 end) as tidak_absen_masuk,
sum(case when a.pulang_jam is null then 1 else 0 end) as tidak_absen_pulang,
sum(case when a.jumlahterlambat>0.1 then 1 else 0 end) as jumlah_hari_terlambat,
sum(a.waktuterlambat) as waktu_terlambat,
sum(case when a.jumlahcepatkeluar>0.1 then 1 else 0 end) as jumlah_hari_cepat_pulang,
sum(a.waktucepatkeluar) as waktu_cepat_pulang

from pegawai b
left join status_kehadiran_karyawan_harian a on (a.pegawai = b.id)
left join dosen c on (b.dosen=c.id)
left join jenis_tenaga_kependidikan d on (d.id = b.jenis_tenaga_kependidikan)
left join jabatan_fungsional_dosen e on (e.id = c.jabatan_fungsional_dosen)
left join employ.golongan f on (b.golongan_pegawai = f.id)

where a.bulan=6 and a.tahun=2019

group by b.id
order by b.nama]]>
	</queryString>

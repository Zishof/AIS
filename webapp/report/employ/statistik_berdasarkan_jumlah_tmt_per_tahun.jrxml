<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="statistik" language="groovy" pageWidth="611" pageHeight="234" columnWidth="611" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[select
count(id) as jumlah,
date_part('year',tanggalmasuk) || '' as tahun
from pegawai
where tanggalmasuk is not null
group by date_part('year',tanggalmasuk)
order by tahun]]>
	</queryString>
	<field name="jumlah" class="java.lang.Long"/>
	<field name="tahun" class="java.lang.String"/>
	<title>
		<band height="234">
			<staticText>
				<reportElement x="0" y="0" width="611" height="39"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Statistik Berdasarkan Jumlah TMT Per Tahun]]></text>
			</staticText>
			<lineChart>
				<chart evaluationTime="Report" theme="aegean">
					<reportElement x="0" y="39" width="611" height="195"/>
					<chartTitle/>
					<chartSubtitle/>
					<chartLegend/>
				</chart>
				<categoryDataset>
					<categorySeries>
						<seriesExpression><![CDATA["TMT"]]></seriesExpression>
						<categoryExpression><![CDATA[$F{tahun}+" - "+$F{jumlah}]]></categoryExpression>
						<valueExpression><![CDATA[$F{jumlah}]]></valueExpression>
					</categorySeries>
				</categoryDataset>
				<linePlot>
					<plot/>
				</linePlot>
			</lineChart>
		</band>
	</title>
</jasperReport>

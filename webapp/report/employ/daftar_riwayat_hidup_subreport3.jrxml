	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Documents\\My Project\\Academic Information System\\AIS\\ais\\web\\report\\employ\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.*,
case when b.keterangan is null then '' else b.keterangan end as golongan_pangkat,
case when b.nama is null then '' else b.nama end as golongan_ruang,
c.gaji,
d.nama as nama_peraturan
from employ.kenaikan_pangkat a
left join employ.golongan b on (a.golongan = b.id)
left join employ.gaji_pokok c on (c.id = a.gaji_pokok)
left join employ.peraturan d on (d.id = a.peraturan)
where a.pegawai = $P{id} and status and not kenaikanjabatan
order by a.mulai asc ]]>
	</queryString>

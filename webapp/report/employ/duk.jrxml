<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="duk" language="groovy" pageWidth="1224" pageHeight="612" orientation="Landscape" columnWidth="1184" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fe0a7741-e6d3-4780-b5e5-2ef80ec3c7b4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="513"/>
	<property name="ireport.y" value="0"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="statusPegawai" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select nama, nip, tempat_lahir, tanggal_lahir, jk, pangkat, golongan, tmt, jabatan, tmt_jabatan, (masa_kerja_tahun || 'thn ' || masa_kerja_bulan || 'bln' )as masa_kerja, diklat, tahun_diklat, pendidikan, tempat_pendidikan, tahun_pendidikan, usia, unit_kerja, status_pegawai
from(
	select
		case when a.gelarbelakang is null or a.gelarbelakang='' then trim(a.gelardepan || ' ' || a.nama) else trim(a.gelardepan || ' ' || a.nama || ', ' || a.gelarbelakang) end as nama,
		a.mycode as nip,
		a.tempatlahir as tempat_lahir,
		to_char(a.tanggallahir, 'dd/mm/yy') as tanggal_lahir,
		upper(substr(a.kelamin, 1,1)) as jk,
		a.pangkat as pangkat,
		a.golongan as golongan,
		to_char(a.tanggalmasuk, 'dd/mm/yy') as tmt,
		case when a.jabatan_struktural is null then g.nama else f.nama end as jabatan,
		to_char(a.tmt_jabatan, 'dd/mm/yy') as tmt_jabatan,
		extract(year from age(a.tanggalmasuk)) as masa_kerja_tahun,
		extract(month from age(a.tanggalmasuk)) as masa_kerja_bulan,
		'' as diklat,
		'' as tahun_diklat,
		e.id as id_pendidikan,
		e.nama as pendidikan,
		d.nama_sekolah as tempat_pendidikan,
		d.tahun_lulus as tahun_pendidikan,
		extract(year from age(a.tanggallahir)) || ',' || extract(month from age(a.tanggallahir)) as usia,
		case a.unit_kerja when null then null else b.nama end as unit_kerja,
		h.id status_pegawai
	from pegawai a
	left join employ.unit_kerja b on (a.unit_kerja=b.id)
	left join (
		select aa.id,(select id from employ.riwayat_pendidikan_pegawai where pegawai = aa.id order by tahun_lulus desc limit 1) as riwayat_pendidikan from pegawai as aa
	) as c on c.id = a.id
	left join employ.riwayat_pendidikan_pegawai d on (c.riwayat_pendidikan=d.id)
	left join employ.pendidikan e on (d.pendidikan=e.id)
	left join employ.jabatan_struktural f on (a.jabatan_struktural=f.id)
	left join employ.jabatan_fungsional g on (a.jabatan_fungsional=g.id)
	left join status_pegawai h on (a.status_pegawai=h.id)
) as duk
where 1=1
and case when $P{statusPegawai} = -1 then true else duk.status_pegawai = $P{statusPegawai} end

order by golongan desc, masa_kerja_tahun desc, masa_kerja_bulan desc, id_pendidikan desc, usia desc]]>
	</queryString>

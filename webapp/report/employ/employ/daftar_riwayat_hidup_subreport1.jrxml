	</parameter>
	<queryString>
		<![CDATA[select a.*, b.nama as nma_pendidikan
from employ.riwayat_pendidikan_pegawai a
left join employ.pendidikan b on (a.pendidikan = b.id)
where a.pegawai = $P{id} and status
order by tahun_lulus asc]]>
	</queryString>

	<parameter name="foto" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[10L]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="peg_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dos_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.*,ds.nidn as nidn_dosen,
case when b.keterangan is null then '' else b.keterangan end as golongan_pangkat,
case when b.nama is null then '' else b.nama end as golongan_ruang,
c.nama as nama_agama
from pegawai a
left join employ.golongan b on (a.golongan_pegawai = b.id)
left join agama c on (a.agama = c.id)
left join dosen ds on (ds.id = a.dosen)
where a.id = $P{peg_id} and ds.id = $P{dos_id}]]>
	</queryString>

	</background>
	<title>
		<band height="110" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="802" height="99"/>
				<textElement verticalAlignment="Bottom">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["DAFTAR PEGAWAI"+
($P{statusPegawai}.equals(-1L) ? "" : "\nSTATUS PEGAWAI : "+$F{status_pegawai})+
($P{golongan}.equals(-1L) ? "" : "\nGOLONGAN : "+$F{gol_ruangan})+
($P{jenisPelatihan}.equals(-1L) ? "" : "\nPELATIHAN : "+$F{status_pelatihan})+
($P{jenisTandaJasa}.equals(-1L) ? "" : "\nTANDA JASA : "+$F{jenis_tanda_jasa})+
($P{pendidikan}.equals(-1L) ? "" : "\nPENDIDIKAN TERAKHIR : "+$F{pendidikan})+
($P{kelamin}.equals("") ? "" : "\nJENIS KELAMIN : "+$P{kelamin})+
($P{statusPerkawinan}.equals("") ? "" : "\nSTATUS PERKAWINAN : "+$P{statusPerkawinan})]]></textFieldExpression>
			</textField>
		</band>
	</title>

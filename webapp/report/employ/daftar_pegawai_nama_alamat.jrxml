<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="daftar_pegawai_nama_alamat" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true"/>
	<style name="SubTitle" fontSize="18"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="golongan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="kelamin" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="statusPerkawinan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="statusPegawai" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="pendidikan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jenisPelatihan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jenisTandaJasa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.code as nip,
a.nama,a.alamat,
b.keterangan as pangkat,
b.nama as gol_ruangan,
case when c.nama is not null then c.nama when d.nama is not null then d.nama else e.nama end as jabatan,
replace(replace(replace(replace(age(a.tanggalmasuk)||'','year', 'tahun'),'mon', 'bulan'),'day', 'hari'),'s','') as masa_kerja,
replace(replace(replace(replace(age(a.tanggallahir + usiapensiun * interval '1 year', CURRENT_DATE) ||'','year', 'tahun'),'mon', 'bulan'),'day', 'hari'),'s','') as masa_pensiun,
f.nama as status_pegawai,
h.nama as pendidikan,
j.nama as status_pelatihan,
l.nama as jenis_tanda_jasa

from pegawai a
left join employ.golongan b on (a.golongan_pegawai = b.id)
left join employ.jabatan_struktural c on (a.jabatan_struktural = c.id)
left join employ.jabatan_fungsional d on (a.jabatan_fungsional = d.id)
left join jabatan e on (a.spesifikasi_jabatan = e.id)
left join status_pegawai f on (a.status_pegawai = f.id)
left join (
	select aa.id,(select pendidikan from employ.riwayat_pendidikan_pegawai where pegawai = aa.id and status order by tahun_lulus desc limit 1) as pendidikan from pegawai as aa
) as g on g.id = a.id
left join employ.pendidikan h on (g.pendidikan = h.id)

left join (
	select aa.jenis_pelatihan, aa.pegawai from employ.riwayat_pelatihan_pegawai as aa
	where aa.jenis_pelatihan = $P{jenisPelatihan}  and aa.status
) as i on i.pegawai = a.id
left join employ.jenis_pelatihan j on ($P{jenisPelatihan} = j.id)

left join (
	select aa.jenis_tanda_jasa, aa.pegawai from employ.riwayat_tanda_jasa_pegawai as aa
	where aa.jenis_tanda_jasa = $P{jenisTandaJasa}  and aa.status
) as k on k.pegawai = a.id
left join employ.jenis_tanda_jasa l on ($P{jenisTandaJasa} = l.id)


where 1=1
and case when $P{golongan} = -1 then true else b.id = $P{golongan} end
and case when $P{jenisPelatihan} = -1 then true else i.jenis_pelatihan = $P{jenisPelatihan} end
and case when $P{jenisTandaJasa} = -1 then true else k.jenis_tanda_jasa = $P{jenisTandaJasa} end
and case when $P{pendidikan} = -1 then true else g.pendidikan = $P{pendidikan} end
and case when $P{statusPegawai} = -1 then true else a.status_pegawai = $P{statusPegawai} end
and case when $P{kelamin} = '' then true else a.kelamin = $P{kelamin} end
and case when $P{statusPerkawinan} = '' then true else a.statusperkawinan = $P{statusPerkawinan} end
order by b.id, a.nama]]>
	</queryString>
	<field name="nip" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="pangkat" class="java.lang.String"/>
	<field name="gol_ruangan" class="java.lang.String"/>
	<field name="jabatan" class="java.lang.String"/>
	<field name="masa_kerja" class="java.lang.String"/>
	<field name="masa_pensiun" class="java.lang.String"/>
	<field name="status_pegawai" class="java.lang.String"/>
	<field name="pendidikan" class="java.lang.String"/>
	<field name="status_pelatihan" class="java.lang.String"/>
	<field name="jenis_tanda_jasa" class="java.lang.String"/>
	<background>

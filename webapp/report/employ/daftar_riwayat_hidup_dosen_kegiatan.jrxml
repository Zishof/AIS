	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[9L]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Documents\\My Project\\Academic Information System\\AIS\\ais\\web\\report\\employ\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="peg_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dos_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.id as dosen1,
max(trim(b.nama)) as nama_dosen,
a.semester,
max(d.nama) as jurusan,
max(e.nama) as fakultas,
sum((c.sks*1.0)/(a.jumlahdosen*1.0)) as jumlah_sks,
max(c.nama) as matakuliah,
max(j.nama) as jabatan,
max(j.eq_sks) as eq_sks,
max(f.nama) as fakultas_dosen,
a.tahun_ajaran


from perkuliahan a
left join dosen b on (a.dosen1 = b.id or a.dosen2 = b.id or a.dosen3 = b.id or a.dosen4 = b.id or a.dosen5 = b.id
or a.dosen6 = b.id  or a.dosen7 = b.id  or a.dosen8 = b.id  or a.dosen9 = b.id  or a.dosen10 = b.id)
left join jabatan j on (j.id = b.spesifikasi_jabatan)
left join matakuliah c on (a.matakuliah = c.id)
left join jurusan d on (a.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join fakultas f on (f.id = b.fakultas)
where b.id=$P{dos_id}
group by b.id, d.fakultas, a.jurusan, a.semester, a.tahun_ajaran, a.matakuliah]]>
	</queryString>
	<field name="dosen1" class="java.lang.Long"/>
	<field name="nama_dosen" class="java.lang.String"/>
	<field name="semester" class="java.lang.Integer"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="fakultas" class="java.lang.String"/>
	<field name="jumlah_sks" class="java.math.BigDecimal"/>
	<field name="matakuliah" class="java.lang.String"/>
	<field name="jabatan" class="java.lang.String"/>
	<field name="eq_sks" class="java.lang.Integer"/>
	<field name="fakultas_dosen" class="java.lang.String"/>
	<field name="tahun_ajaran" class="java.lang.String"/>

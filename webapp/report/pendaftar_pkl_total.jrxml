<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="penerima-beasiswa" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ff5bddaa-df6b-42c3-97e7-e7584fce1c8c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="status" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2016]]></defaultValueExpression>
	</parameter>
	<parameter name="logo1" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_pkl" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(d.nama) as fakultas,
max(c.nama) as jurusan,
sum(case when b.kelamin ilike 'Perempuan' then 0 else 1 end) as laki,
sum(case when b.kelamin ilike 'Perempuan' then 1 else 0 end) as perempuan,
count(*) as total

from mahasiswa_daftar_pkl a
inner join mahasiswa b on (a.mahasiswa = b.id)
inner join jurusan c on (c.id = b.jurusan)
inner join fakultas d on (d.id = c.fakultas)
inner join pkl e on (e.id = a.pkl)

where terima = (case when $P{status} = -1 then terima else $P{status} end)
and date_part('year',e.tanggal_mulai)=(case when $P{tahun} = -1 then date_part('year',e.tanggal_mulai) else $P{tahun} end)
group by d.id,c.id
order by d.id,c.id]]>
	</queryString>
	<field name="fakultas" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="laki" class="java.lang.Long"/>
	<field name="perempuan" class="java.lang.Long"/>
	<field name="total" class="java.lang.Long"/>
	<variable name="laki" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{laki}]]></variableExpression>
	</variable>
	<variable name="perempuan" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{perempuan}]]></variableExpression>
	</variable>
	<variable name="total" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>

		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="no_ujian" class="java.lang.String" isForPrompting="false"/>
	<parameter name="cek_kesehatan" class="java.lang.Long"/>

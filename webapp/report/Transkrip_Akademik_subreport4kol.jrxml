	</parameter>
	<parameter name="ambilDariKurikulum" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="kurikulum" class="java.lang.Long"/>
	<parameter name="nilai_0_tidak_masuk_dalam_perhitungan_ipk" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Aktif"]]></defaultValueExpression>
	</parameter>
	<parameter name="nilai_huruf_yg_tidak_masuk_perhitungan_ip" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nilai_minimal_tidak_masuk_dalam_perhitungan_ipk" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0.1"]]></defaultValueExpression>
	</parameter>
	<parameter name="detailsperkuliahans" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
bool_or(a.lulus) as lulus,
max(coalesce(f.kode, '')) as kode_matakuliah,
max(coalesce(f.nama, '')) as nama_matakuliah,
max(coalesce(f.sks, 0)) as sks,
coalesce(min(a.nilai_huruf), '') as nilai_huruf,
max(coalesce(a.nilai_ip, 0.0)) as nilai_ipk,
(case when $P{ambilDariKurikulum} then max(case when f.semester is null then a.semester else f.semester end) else max(a.semester) end) as semester

from mahasiswa c
left join detailperkuliahan a on (a.mahasiswa = c.id)
left join jurusan d on (c.jurusan = d.id)
left join perkuliahan b on (a.perkuliahan = b.id)
left join
(
	select aa.id as id,
	max(case when cc.id is null then aa.kode else cc.kode end) as kode,
	max(case when cc.id is null then aa.nama else cc.nama end) as nama,
	max(case when cc.id is null then aa.sks else cc.sks end) as sks,
	max(kk.semester) as semester,
	max(dd.tahun) as tahun
	from matakuliah aa
	left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
	left join matakuliah cc on(bb.matakuliah = cc.id)
	left join kurikulum_punya_matakuliah kk on ((case when cc.id is null then aa.id else cc.id end) = kk.matakuliah)
	left join kurikulum dd on (dd.id = kk.kurikulum)
	where (aa.extrakulikuler is null or aa.extrakulikuler = false)
	group by aa.id
) f on ((f.id = b.matakuliah or a.matakuliah_konversi = f.id))
where a.mahasiswa = $P{mahasiswa}
and f.id is not null
and coalesce(trim(f.nama), '') <> ''
and case when $X{IN,-1,detailsperkuliahans} then false else $X{IN,a.id,detailsperkuliahans} end
group by f.id
order by semester, nama_matakuliah]]>
	</queryString>

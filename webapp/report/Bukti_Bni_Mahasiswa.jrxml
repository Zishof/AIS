	<field name="ref_number" class="java.lang.String"/>
	<field name="program" class="java.lang.String"/>
	<field name="validator" class="java.lang.String"/>
	<field name="bulan" class="java.lang.Integer"/>
	<variable name="sum_total" class="java.lang.Double" calculation="Sum">

	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select a.nim,a.nama,
b.nama as nama_dosen,
c.nama as nama_matakuliah,
a.ruang
from view_absensi a
left join dosen b on a.dosen1 = b.id
left join matakuliah c on c.id = a.matakuliah
where a.perkuliahan = $P{perkuliahan}
group by a.nim]]></queryString>


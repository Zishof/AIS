		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="ruang" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\nih ye\\report\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select  MIN(c.noujian) min_no_ujian,MAX(c.noujian) as no_ujian,b.nama as ruang,
e.nama as gedung,b.kapasitas_ruangan as kapasitas,
b.tahunakademik,
bbb.nama as gelombang_pendaftaran,
f.nama as jadwal_ujian,
aa.lokasi
from sekolah.ruang_gelombang_psb a
left join sekolah.ruang_psb b on a.ruang_psb = b.id
left join sekolah.ujian_psb aa on (b.ujian_psb = aa.id)
left join sekolah.gelombang_pendaftaran_psb bbb on (aa.gelombang_pendaftaran_psb = bbb.id)
left join sekolah.calon_siswa c on a.calon_siswa = c.id
left join gedung e on b.gedung = e.id
left join sekolah.jadwal_ujian_psb f on (f.ujian_psb = aa.id)
where a.ruang_psb=$P{ruang}
group by b.nama,e.nama, b.kapasitas_ruangan, aa.lokasi,b.tahunakademik, bbb.nama, f.nama
order by max(f.waktumulai)]]>
	</queryString>
	<field name="min_no_ujian" class="java.lang.String"/>
	<field name="no_ujian" class="java.lang.String"/>
	<field name="ruang" class="java.lang.String"/>
	<field name="gedung" class="java.lang.String"/>
	<field name="kapasitas" class="java.lang.Integer"/>
	<field name="tahunakademik" class="java.lang.String"/>
	<field name="gelombang_pendaftaran" class="java.lang.String"/>
	<field name="jadwal_ujian" class="java.lang.String"/>
	<field name="lokasi" class="java.lang.String"/>

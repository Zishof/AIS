					<font isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<text><![CDATA[Tahun Akademik 2012 / 2013]]></text>
			</staticText>
			<textField isBlankWhenNull="false">
				<reportElement key="textField" x="472" y="6" width="62" height="36"/>

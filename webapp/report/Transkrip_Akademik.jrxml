	<queryString>
		<![CDATA[select
max(c.nama) as nama_mahasiswa,
max(e.nama) as nama_fakultas,
max(c.waktu_kuliah) as waktu_kuliah,
max(c.nim) as nim,
max(c.tempatlahir) as tempatlahir,
max(c.tanggallahir) as tanggal_lahir,
max(c.kelamin) as kelamin,
max(g.nama) as jenjang,
max(d.nama) as nama_jurusan,
max(coalesce(f.kode, '')) as kode_matakuliah,
max(coalesce(f.nama, '')) as nama_matakuliah,
max(coalesce(f.sks, 0)) as sks,
max(z.tanggal) as tanggal_wisuda,
min(a.nilai_huruf) as nilai_huruf,
max(a.nilai_ip) as nilai_ipk,
max(c.tanggal_lulus) as tanggal_lulus,
max(l.tanggal_sidang) as sidang,
max(l.judul) as judul,
max(a.total_nilai) as total_nilai,
max(d1.nama) as dosen_pa,
max(d1.code) as nip_dosen_pa

from mahasiswa c
left join dosen d1 on (c.dosen = d1.id)
left join skripsi l on (c.id = l.mahasiswa)
left join detailperkuliahan a  on (a.mahasiswa = c.id)
left join perkuliahan b on (a.perkuliahan = b.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join pendaftaran_wisuda h on (h.mahasiswa = c.id)
left join wisuda z on (h.wisuda=z.id)
left join matakuliah f on ((f.id = b.matakuliah or a.matakuliah_konversi = f.id))
left join jenjang g on (g.id = c.jenjang)
where a.mahasiswa = $P{mahasiswa}
and f.id is not null
and coalesce(trim(f.nama), '') <> ''
and case when $X{IN,-1,detailsperkuliahans} then false else $X{IN,a.id,detailsperkuliahans} end
group by f.id]]>
	</queryString>
	<field name="nama_mahasiswa" class="java.lang.String"/>
	<field name="nama_fakultas" class="java.lang.String"/>
	<field name="waktu_kuliah" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="tempatlahir" class="java.lang.String"/>
	<field name="tanggal_lahir" class="java.sql.Date"/>
	<field name="kelamin" class="java.lang.String"/>
	<field name="jenjang" class="java.lang.String"/>
	<field name="nama_jurusan" class="java.lang.String"/>
	<field name="kode_matakuliah" class="java.lang.String"/>
	<field name="nama_matakuliah" class="java.lang.String"/>
	<field name="sks" class="java.lang.Integer"/>
	<field name="tanggal_wisuda" class="java.sql.Date"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="nilai_ipk" class="java.lang.Double"/>
	<field name="tanggal_lulus" class="java.sql.Date"/>
	<field name="sidang" class="java.sql.Date"/>
	<field name="judul" class="java.lang.String"/>
	<field name="total_nilai" class="java.lang.Double"/>
	<field name="dosen_pa" class="java.lang.String"/>
	<field name="nip_dosen_pa" class="java.lang.String"/>
	<variable name="sum_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$P{nilai_0_tidak_masuk_dalam_perhitungan_ipk}.equals( "tidak aktif" ) ? $F{sks} : ($F{total_nilai} < 0.1 ? 0 : $F{sks})]]></variableExpression>
	</variable>
	<variable name="sum_val" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$P{nilai_0_tidak_masuk_dalam_perhitungan_ipk}.equals( "tidak aktif" ) ? ($F{nilai_ipk}*$F{sks}) : ($F{nilai_ipk}*($F{total_nilai} < 0.1 ? 0.0 : $F{sks}))]]></variableExpression>
	</variable>
	<variable name="ipk" class="java.lang.Double">
		<variableExpression><![CDATA[($V{sum_val}/$V{sum_sks})*100]]></variableExpression>
	</variable>

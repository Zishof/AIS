						<font size="8" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{kelompok_matakuliah} == null ? "-" : $F{kelompok_matakuliah}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<title>
		<band height="190" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement key="textField" x="145" y="106" width="136" height="18" uuid="f4a99aaf-fc32-431e-96e2-af016faa86d2"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{nama_mahasiswa}==null ? "" : $F{nama_mahasiswa}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField" x="145" y="124" width="136" height="18" uuid="bf77629d-76fd-4191-a228-b34bde837daf"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement key="staticText-7" x="135" y="124" width="10" height="18" uuid="f128649e-db7f-461a-bd28-71b4866d5855"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[:]]></text>
			</staticText>
			<staticText>
				<reportElement key="staticText-12" x="427" y="106" width="10" height="18" uuid="a8d24438-9129-4924-a8ed-30dd10d185bc"/>

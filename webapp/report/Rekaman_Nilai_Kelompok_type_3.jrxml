	<parameter name="foto_lulus" class="java.lang.String" isForPrompting="false"/>
	<parameter name="ipk" class="java.lang.Double" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
bool_or(a.lulus) as lulus,
*
from (
		select
	max(c.nama) as nama_mahasiswa,
	max(e.nama) as nama_fakultas,
	max(c.waktu_kuliah) as waktu_kuliah,
	max(c.nim) as nim,
	max(c.tempatlahir) || ', ' || max(c.tanggallahir) as tanggal_lahir,
	max(c.kelamin) as kelamin,
	max(g.nama) as jenjang,
          max(g.keterangan) as jenjang_keterangan,
	max(d.nama) as nama_jurusan,
	max(f.kode) as kode_matakuliah,
	max(f.nama) as nama_matakuliah,
	max(f.sks) as sks,
	min(a.nilai_huruf) as nilai_huruf,
	max(a.nilai_ip) as nilai_ipk,
          (max(a.nilai_ip )*max(f.sks)) as nilai,
	max(a.total_nilai) as total_nilai,
	max(c.tanggal_lulus) as tanggal_lulus,
	max(l.judul) as judul,
	max(l1.nama) as pembimbing1,
	max(l2.nama) as pembimbing2,
	max(a.semester) as semester,
	case when upper(trim(min(a.nilai_huruf))) = 'A' or upper(trim(min(a.nilai_huruf))) = 'B' or upper(trim(min(a.nilai_huruf))) = 'C' then 'LULUS' else 'TIDAK LULUS' end as status,


	(case when max(a.semester) % 2 = 0 then (max(c.tahunangkatan)+(max(a.semester/2)-1)) || '/' || (max(c.tahunangkatan)+(max(a.semester/2))) else (max(c.tahunangkatan)+(max((a.semester+1)/2)-1)) || '/' || (max(c.tahunangkatan)+(max((a.semester+1)/2))) end) as tahun_ajaran,


	max(c.tahunangkatan) as tahunangkatan,
	max(d1.nama) as dosen_pa,
max(d1.code) as nip_dosen_pa,
	max(c.program) as program,
	max(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
	max(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
	max(ff.kelompok_matakuliah) as kelompok_matakuliah,
	max(d.akreditasi) as status_akreditasi,
	max(ee.nama) dekan,
	max(ee.code) dekan_nip

	from mahasiswa c
	left join dosen d1 on (c.dosen = d1.id)
	left join skripsi l on (c.id = l.mahasiswa)
	left join dosen l1 on (l.pembimbing = l1.id)
	left join dosen l2 on (l.pembimbing2 = l2.id)
	left join detailperkuliahan a  on (a.mahasiswa = c.id)
	left join perkuliahan b on (a.perkuliahan = b.id)
	left join jurusan d on (c.jurusan = d.id)
	left join jenjang_program_studi dd on (dd.jurusan = d.id)
	left join fakultas e on (e.id = d.fakultas)
	left join dosen ee on (e.dekan = ee.id)
	left join
	(
		select
		aa.matakuliah,
		max(bb.nama) as kelompok_matakuliah,
		max(bb.nomorurut) as nomorurut,
		bb.berlakumulaitahunangkatan
		from kelompok_matakuliah_punya_matakuliah aa
		inner join kelompok_matakuliah bb on (aa.kelompok_matakuliah = bb.id)
		group by aa.matakuliah, bb.berlakumulaitahunangkatan
	) ff on ((b.matakuliah = ff.matakuliah or a.matakuliah_konversi = ff.matakuliah)  and c.tahunangkatan >= ff.berlakumulaitahunangkatan)
	left join
	(
		select aa.id as id,
		max(case when cc.id is null then aa.kode else cc.kode end) as kode,
		max(case when cc.id is null then aa.nama else cc.nama end) as nama,
		max(case when cc.id is null then aa.sks else cc.sks end) as sks
		from matakuliah aa
		left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
		left join matakuliah cc on(bb.matakuliah = cc.id) where (aa.extrakulikuler is null or aa.extrakulikuler = false)
		group by aa.id
	) f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
	left join jenjang g on (g.id = c.jenjang)
	left join (
		select aa.nama, aa.nip, aa.jurusan
		from staff aa
		left join jabatan bb on (aa.jabatan = bb.id)
		where bb.nama ilike '%kaprodi%'
	) h on (h.jurusan = c.jurusan)
	left join dosen i on (d.kaprodi = i.id)
	where a.mahasiswa = $P{mahasiswa}
		and a.id in (select max(aaa.id) from detailperkuliahan aaa left join perkuliahan bbb on (aaa.perkuliahan=bbb.id) inner join matakuliah ccc on (ccc.id=bbb.matakuliah or aaa.matakuliah_konversi=ccc.id) where aaa.mahasiswa = $P{mahasiswa} and aaa.persetujuan = 1 group by ccc.kode)
	and a.semester >= 0 and a.total_nilai >= 1.0 and a.total_nilai is not null and a.nilai_huruf is not null and trim(a.nilai_huruf) != ''
	and a.persetujuan = 1 and a.ikuti_perkuliahan is null
          and f.nama is not null
	-- and c.tahunangkatan >= ff.berlakumulaitahunangkatan
	group by ff.nomorurut,f.id
	order by ff.nomorurut,max(f.kode)
) a
union all
select
'Jumlah' nama_mahasiswa,
null nama_fakultas,
null waktu_kuliah,
null nim,
null tanggal_lahir,
null kelamin,
null jenjang,
null jenjang_keterangan,
null nama_jurusan,
null kode_matakuliah,
'Jumlah' nama_matakuliah,
sum(sks) sks,
null nilai_huruf,
sum(nilai_ipk*(0.0+sks)) nilai_ipk,
sum(nilai) as nilai,
null total_nilai,
null tanggal_lulus,
null judul,
null pembimbing1,
null pembimbing2,
null semester,
null status,
null tahun_ajaran,
null tahunangkatan,
max(dosen_pa) dosen_pa,
max(nip_dosen_pa) nip_dosen_pa,
null myprogram,
null nip_kaprodi,
null nama_kaprodi,
'' kelompok_matakuliah,
'' status_akreditasi,
max(dekan) as dekan,
max(dekan_nip) as dekan_nip
from (
		select
	max(c.nama) as nama_mahasiswa,
	max(e.nama) as nama_fakultas,
	max(c.waktu_kuliah) as waktu_kuliah,
	max(c.nim) as nim,
	max(c.tempatlahir) || ', ' || max(c.tanggallahir) as tanggal_lahir,
	max(c.kelamin) as kelamin,
	max(g.nama) as jenjang,
max(g.keterangan) as jenjang_keterangan,
	max(d.nama) as nama_jurusan,
	max(f.kode) as kode_matakuliah,
	max(f.nama) as nama_matakuliah,
	max(f.sks) as sks,
	min(a.nilai_huruf) as nilai_huruf,
	max(a.nilai_ip) as nilai_ipk,
	(max(a.nilai_ip )*max(f.sks)) as nilai,
	max(a.total_nilai) as total_nilai,
	max(c.tanggal_lulus) as tanggal_lulus,
	max(l.judul) as judul,
	max(l1.nama) as pembimbing1,
	max(l2.nama) as pembimbing2,
	max(a.semester) as semester,
	case when upper(trim(min(a.nilai_huruf))) = 'A' or upper(trim(min(a.nilai_huruf))) = 'B' or upper(trim(min(a.nilai_huruf))) = 'C' then 'LULUS' else 'TIDAK LULUS' end as status,


	(case when max(a.semester) % 2 = 0 then (max(c.tahunangkatan)+(max(a.semester/2)-1)) || '/' || (max(c.tahunangkatan)+(max(a.semester/2))) else (max(c.tahunangkatan)+(max((a.semester+1)/2)-1)) || '/' || (max(c.tahunangkatan)+(max((a.semester+1)/2))) end) as tahun_ajaran,


	max(c.tahunangkatan) as tahunangkatan,
	max(d1.nama) as dosen_pa,
	max(d1.code) as nip_dosen_pa,
	max(c.program) as program,
	max(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
	max(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
	max(ff.kelompok_matakuliah) as kelompok_matakuliah,
	max(dd.status_akreditasi) as status_akreditasi,
	max(ee.nama) dekan,
	max(ee.code) dekan_nip

	from mahasiswa c
	left join dosen d1 on (c.dosen = d1.id)
	left join skripsi l on (c.id = l.mahasiswa)
	left join dosen l1 on (l.pembimbing = l1.id)
	left join dosen l2 on (l.pembimbing2 = l2.id)
	left join detailperkuliahan a  on (a.mahasiswa = c.id)
	left join perkuliahan b on (a.perkuliahan = b.id)
	left join jurusan d on (c.jurusan = d.id)
	left join jenjang_program_studi dd on (dd.jurusan = d.id)
	left join fakultas e on (e.id = d.fakultas)
	left join dosen ee on (e.dekan = ee.id)
	left join
	(
		select
		aa.matakuliah,
		max(bb.nama) as kelompok_matakuliah,
		max(bb.nomorurut) as nomorurut,
		bb.berlakumulaitahunangkatan
		from kelompok_matakuliah_punya_matakuliah aa
		inner join kelompok_matakuliah bb on (aa.kelompok_matakuliah = bb.id)
		group by aa.matakuliah, bb.berlakumulaitahunangkatan
	) ff on ((b.matakuliah = ff.matakuliah or a.matakuliah_konversi = ff.matakuliah)  and c.tahunangkatan >= ff.berlakumulaitahunangkatan)
	left join
	(
		select aa.id as id,
		max(case when cc.id is null then aa.kode else cc.kode end) as kode,
		max(case when cc.id is null then aa.nama else cc.nama end) as nama,
		max(case when cc.id is null then aa.sks else cc.sks end) as sks
		from matakuliah aa
		left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
		left join matakuliah cc on(bb.matakuliah = cc.id) where (aa.extrakulikuler is null or aa.extrakulikuler = false)
		group by aa.id
	) f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
	left join jenjang g on (g.id = c.jenjang)
	left join (
		select aa.nama, aa.nip, aa.jurusan
		from staff aa
		left join jabatan bb on (aa.jabatan = bb.id)
		where bb.nama ilike '%kaprodi%'
	) h on (h.jurusan = c.jurusan)
	left join dosen i on (d.kaprodi = i.id)
	where a.mahasiswa = $P{mahasiswa}
	and a.semester >= 0 and a.total_nilai >= 1.0 and a.total_nilai is not null and a.nilai_huruf is not null and trim(a.nilai_huruf) != ''
	and a.persetujuan = 1 and a.ikuti_perkuliahan is null
	-- and c.tahunangkatan >= ff.berlakumulaitahunangkatan
	group by ff.nomorurut,f.id
	order by ff.nomorurut,max(f.kode)
) a ]]>
	</queryString>
	<field name="nama_mahasiswa" class="java.lang.String"/>
	<field name="nama_fakultas" class="java.lang.String"/>
	<field name="waktu_kuliah" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="tanggal_lahir" class="java.lang.String"/>
	<field name="kelamin" class="java.lang.String"/>
	<field name="jenjang" class="java.lang.String"/>
	<field name="jenjang_keterangan" class="java.lang.String"/>
	<field name="nama_jurusan" class="java.lang.String"/>
	<field name="kode_matakuliah" class="java.lang.String"/>
	<field name="nama_matakuliah" class="java.lang.String"/>
	<field name="sks" class="java.lang.Long"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="lulus" class="java.lang.Object"/>
	<field name="nilai_ipk" class="java.lang.Double"/>
	<field name="nilai" class="java.lang.Double"/>
	<field name="total_nilai" class="java.lang.Double"/>
	<field name="tanggal_lulus" class="java.sql.Date"/>
	<field name="judul" class="java.lang.String"/>
	<field name="pembimbing1" class="java.lang.String"/>
	<field name="pembimbing2" class="java.lang.String"/>
	<field name="semester" class="java.lang.Integer"/>
	<field name="status" class="java.lang.String"/>
	<field name="tahun_ajaran" class="java.lang.String"/>
	<field name="tahunangkatan" class="java.lang.Integer"/>
	<field name="dosen_pa" class="java.lang.String"/>
	<field name="nip_dosen_pa" class="java.lang.String"/>
	<field name="program" class="java.lang.String"/>
	<field name="nip_kaprodi" class="java.lang.String"/>
	<field name="nama_kaprodi" class="java.lang.String"/>
	<field name="kelompok_matakuliah" class="java.lang.String"/>
	<field name="status_akreditasi" class="java.lang.String"/>
	<field name="dekan" class="java.lang.String"/>
	<field name="dekan_nip" class="java.lang.String"/>
	<variable name="sum_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_val" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_nilai" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>
	<variable name="sum_nilai_sks" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_sks_total" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="sum_val_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}*$F{sks}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="KTN" class="java.lang.Double" resetType="Group" resetGroup="kelompok" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}.doubleValue()*$F{nilai_ipk}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="ktn_total" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}.doubleValue()*$F{nilai_ipk}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="sum_ipk" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_ipk}]]></variableExpression>
	</variable>
	<group name="kelompok">
		<groupExpression><![CDATA[$F{kelompok_matakuliah}]]></groupExpression>
		<groupHeader>
			<band height="14">
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="0" width="289" height="14" uuid="cd0706a5-0da1-4684-8504-9bfd16207535"/>
					<box leftPadding="6">
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>

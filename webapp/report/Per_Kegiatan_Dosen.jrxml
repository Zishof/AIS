	<queryString>
		<![CDATA[select
b.kode as kode_organisasi,
c.nama,
c.tempatlahir,
c.tanggallahir,
c.nidn,
c1.nama as jurusan,
b.nama as nama_kegiatan,
case when a.mulai is null then b.mulai else a.mulai end as mulai,
case when a.sampai is null then b.sampai else a.sampai end sampai,
d.nama as jabatan,
e.nama as skala,
a.keterangan,
a.persetujuan,
b1.nama as kelompok,
b2.nama as detail_kelompok,
b2.id as id_detail,
b1.nama||' ('||b2.nama||')' as nama_kelompok
from kegiatan_kedosenan_punya_dosen a
inner join kegiatan_kedosenan b on (a.kegiatan_kedosenan=b.id)
inner join kelompok_kegiatan_kedosenan b1 on (b.kelompok_kegiatan_kedosenan=b1.id)
inner join detail_kelompok_kegiatan_kedosenan b2 on (b.detail_kelompok_kegiatan_kedosenan=b2.id)
inner join dosen c on (a.dosen=c.id)
inner join jurusan c1 on (c.jurusan=c1.id)
left join jabatan_kegiatan_kedosenan d on (a.jabatan_kegiatan_kedosenan=d.id)
inner join skala_kegiatan_kedosenan e on (a.skala_kegiatan_kedosenan=e.id)

where case when $P{nama}='' then true else b.nama ilike '%'||$P{nama}||'%' end
and case when $P{hanyaAktif} then a.persetujuan else true end
and case when $P{hanyaTidakAktif} then a.persetujuan=false else true end
order by b1.nama||' ('||b2.nama||')',b.kode,c.nidn]]>
	</queryString>

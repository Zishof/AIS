	<queryString>
		<![CDATA[select UPPER(a.nama) as nama,
a.jenis_kartu_identitas_mahasiswa_baru,
a.no_identitas,
a.jenis_kelamin,
UPPER(a.tempat_lahir) as tempat_lahir,
a.tanggal_lahir,
UPPER(a.alamat) as alamat,
UPPER(a.asal_sma) as asal_sma,
a.no_registrasi,
a.no_ujian,
b.nama as p1,
c.nama as p2,
c1.nama as p3,
c2.nama as p4,
c3.nama as p5,
d.nama as kartu,
a.nama_ayah,
a.tahunakademik,
lulus.nama as lulus,
lulusfakultas.nama as lulusfakultas,
g.nama gelombang_pendaftaran,
p.nama as nama_perguruan_tinggi,
a.program,
g.tanggaldaftarulangberakhir,
a.nomor_surat_kelulusan,
a.tanggalsuratkelulusan

from  biodata_calon_mahasiswa a

left join jurusan b on a.prodi_1=b.id
left join jurusan c on a.prodi_2=c.id
left join jurusan c1 on a.prodi3=c1.id
left join jurusan c2 on a.prodi4=c2.id
left join jurusan c3 on a.prodi5=c3.id
left join jurusan lulus on a.prodi_lulus=lulus.id
left join fakultas lulusfakultas on lulus.fakultas = lulusfakultas.id
left join jenis_kartu_identitas_mahasiswa_baru d on a.jenis_kartu_identitas_mahasiswa_baru=d.id
left join gelombang_pendaftaran g on (g.id = a.gelombang_pendaftaran)
left join fakultas f on (b.fakultas=f.id)
left join perguruan_tinggi p on (p.id=f.perguruan_tinggi)

where a.id=$P{biodata_id}

order by a.id desc
limit 1]]>
	</queryString>

	</parameter>
	<queryString>
		<![CDATA[select *
from (
select
max(b.tanggal) as tanggal,
max(b.isbn) as isbn,
max(b.nama) as nama,
sum(a.jumlah) as jumlah,
max(d.nama) as perpustakaan,
d.id as id_perpus,
b.id as id_item,
max(case when f.id is not null then f.nama else b.deweydecimalclass end) as ddc,
max(b.pengarangs) as pengarang,
max(g.nama) as penerbit,
b.tahun,
jur.nama as jurusan,
jur.id as id_jur

from library.saldo_awal_detail a
inner join library.item b on (a.item = b.id)
inner join library.saldo_awal c on (c.id = a.saldo_awal)
inner join library.perpustakaan d on (d.id = c.perpustakaan)
left join jurusan jur on (b.jurusan=jur.id)
left join tbmuser e on (e.userid = c.disetujui_oleh)
left join library.ddc_item f on (b.ddc_item=f.id)
left join library.penerbit g on (b.penerbit=g.id)
group by jur.id,d.id,b.id

union all

select
max(b.tanggal) as tanggal,
max(b.isbn) as isbn,
max(b.nama) as nama,
sum(a.jumlah) as jumlah,
max(d.nama) as perpustakaan,
d.id as id_perpus,
b.id as id_item,
max(case when f.id is not null then f.nama else b.deweydecimalclass end) as ddc,
max(b.pengarangs) as pengarang,
max(g.nama) as penerbit,
b.tahun,
jur.nama as jurusan,
jur.id as id_jur

from library.penerimaan_pengadaan_item_detail a
inner join library.item b on (a.item = b.id)
inner join library.penerimaan_pengadaan_item c on (c.id = a.penerimaan_pengadaan_item)
inner join library.perpustakaan d on (d.id = c.perpustakaan)
left join jurusan jur on (b.jurusan=jur.id)
left join tbmuser e on (e.userid = c.disetujui_oleh)
left join library.ddc_item f on (b.ddc_item=f.id)
left join library.penerbit g on (b.penerbit=g.id)
group by jur.id,d.id,b.id
) aa where case when $P{id}=-1 then true else aa.id_perpus = $P{id} end
and case when $P{isbn}='' then true else isbn ilike '%'||$P{isbn}||'%' end
and case when $P{judul}='' then true else nama ilike '%'||$P{judul}||'%' end
and case when $P{klasifikasi}='' then true else ddc ilike '%'||$P{klasifikasi}||'%' end
order by ddc,id_jur,aa.id_perpus,aa.nama]]>
	</queryString>

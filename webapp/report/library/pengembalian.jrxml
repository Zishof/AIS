				<textFieldExpression><![CDATA["Kode pengembalian\t: "+$F{kode}+
"\nPeminjam\t\t: "+$F{kode_anggota}+" - "+$F{anggota}]]></textFieldExpression>
			</textField>
		</band>
	</title>

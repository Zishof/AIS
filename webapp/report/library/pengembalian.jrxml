<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="peminjaman" language="groovy" pageWidth="286" pageHeight="363" whenNoDataType="AllSectionsNoDetail" columnWidth="286" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="9b32af95-e9a1-40d1-90c3-d24e83e4290d">
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[20L]]></defaultValueExpression>
	</parameter>
	<parameter name="kode_barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="info" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
b.isbn,
b.nama,
a.dikembali as jumlah,
c.kode,
c.tanggal_persetujuan,
c.disetujui_oleh,
d.nama as perpustakaan,
e.nama as anggota,
e.kode as kode_anggota,
a.denda,
d1.dendaketerlambatanperitem,
d1.dendaketerlambatan,
d1.dendatotal,
c.diskondenda,
barcode.barcode
from library.kembali_pengadaan_item_detail a
left join library.item_punya_barcode barcode on (barcode.id = a.item_punya_barcode)
left join library.item b on (a.item = b.id)
left join library.kembali_pengadaan_item c on (c.id = a.kembali_pengadaan_item)
left join library.perpustakaan d on (d.id = c.perpustakaan)
left join library.peminjaman_pengadaan_item d1 on (d1.id = c.peminjaman_pengadaan_item)
left join library.anggota e on (e.id = d1.anggota)
where a.kembali_pengadaan_item = $P{id}]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="kode" class="java.lang.String"/>
	<field name="tanggal_persetujuan" class="java.sql.Timestamp"/>
	<field name="disetujui_oleh" class="java.lang.String"/>
	<field name="perpustakaan" class="java.lang.String"/>
	<field name="anggota" class="java.lang.String"/>
	<field name="kode_anggota" class="java.lang.String"/>
	<field name="denda" class="java.lang.Double"/>
	<field name="dendaketerlambatanperitem" class="java.lang.Double"/>
	<field name="dendaketerlambatan" class="java.lang.Double"/>
	<field name="dendatotal" class="java.lang.Double"/>
	<field name="diskondenda" class="java.lang.Double"/>
	<field name="barcode" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="57" splitType="Stretch">
			<image hAlign="Center" vAlign="Middle">
				<reportElement key="image-1" x="0" y="-16" width="75" height="71" uuid="f6c998cb-2b7a-4bea-9888-1d4520ae18e8"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-14" x="75" y="-13" width="216" height="35" uuid="d4d6eaff-ef6a-415e-9760-8c58218af340"/>

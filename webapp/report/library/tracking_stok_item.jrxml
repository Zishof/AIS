		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.item,
max(c.isbn) as isbn,
max(c.nama) as nama,
max(d.nama) as perpustakaan,
max(b.nama) || (case when max(a.oleh) is not null then ' oleh ' || max(a.oleh) else '' end)
|| (case when max(e.nama) is not null then ' anggota ' || max(e.nama || ' ' || e.kode) else '' end)
 ||' '|| (case when( min(case when b1.id is null then '' else b1.barcode end)=max(case when b1.id is null then '' else b1.barcode end)) then ' barcode : '||min(case when b1.id is null then '' else b1.barcode end) else (min(case when b1.id is null then '' else ' barcode : '|| b1.barcode end) ||' '|| max(case when b1.id is null then '' else ' s.d ' || b1.barcode end)) end) as transaksi,
max(a.keterangan) as keterangan,
a.tanggaldanwaktu as tanggal,
sum(case when b.jenis = 1 then (a.qty+a.qtybonus) else 0 end) as penambahan,
sum(case when b.jenis = -1 then (a.qty+a.qtybonus) else 0 end) as pengurangan,
(select sum((aa.qty+aa.qtybonus)*bb.jenis) as saldo from library.detail_transaksi aa inner join library.kode_transaksi bb on (aa.kode_transaksi = bb.id) where aa.item = a.item and a.perpustakaan = aa.perpustakaan and aa.tanggaldanwaktu <= a.tanggaldanwaktu) as saldo

from library.detail_transaksi a
left join library.item_punya_barcode b1 on (a.item_punya_barcode = b1.id)
inner join library.kode_transaksi b on (a.kode_transaksi = b.id)
left join library.item c on (c.id = a.item)
left join library.perpustakaan d on (d.id = a.perpustakaan)
left join library.anggota e on (e.id = a.anggota)
where a.perpustakaan = $P{perpustakaan}
and $X{IN,c.id,items}
and date(a.tanggaldanwaktu) between date($P{mulai}) and date($P{sampai})
group by a.item, a.perpustakaan, a.tanggaldanwaktu
having (sum(case when b.jenis = 1 then (a.qty+a.qtybonus) else 0 end) - sum(case when b.jenis = -1 then (a.qty+a.qtybonus) else 0 end)) != 0
order by a.item, a.perpustakaan,a.tanggaldanwaktu]]>
	</queryString>

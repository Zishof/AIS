	</parameter>
	<queryString>
		<![CDATA[select a.kode, a.nama,
b.alamat,
b.telp,
(case when b.tanggal_masuk is not null then b.tanggal_masuk else CURRENT_DATE end) + interval '5 year' as tanggal_kadaluarsa

from library.anggota a
left join mahasiswa b on (a.mahasiswa = b.id)
where a.id = $P{id}]]>
	</queryString>
	<field name="kode" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>

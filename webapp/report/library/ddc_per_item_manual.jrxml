	<queryString>
		<![CDATA[select
b.isbn,
b.nama,
b.deweydecimalclass,
b.pengarangs

from library.item b
join (
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1 union all
select 1
) aa on (1=1)
where b.id = $P{id}]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="deweydecimalclass" class="java.lang.String"/>
	<field name="pengarangs" class="java.lang.String"/>
	<background>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="peminjaman" language="groovy" pageWidth="286" pageHeight="363" whenNoDataType="AllSectionsNoDetail" columnWidth="286" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="35277930-65b5-444b-a40e-d5e84c07f96f">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[20L]]></defaultValueExpression>
	</parameter>
	<parameter name="kode_barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="info" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
b.isbn,
b.nama,
a.jumlah,
c.kode,
c.tanggal_persetujuan,
c.disetujui_oleh,
d.nama as perpustakaan,
e.nama as anggota,
e.kode as kode_anggota,
barcode.barcode
from library.peminjaman_pengadaan_item_detail a
left join library.item_punya_barcode barcode on (barcode.id = a.item_punya_barcode)
left join library.item b on (a.item = b.id)
left join library.peminjaman_pengadaan_item c on (c.id = a.peminjaman_pengadaan_item)
left join library.perpustakaan d on (d.id = c.perpustakaan)
left join library.anggota e on (e.id = c.anggota)
where a.peminjaman_pengadaan_item = $P{id}]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="kode" class="java.lang.String"/>
	<field name="tanggal_persetujuan" class="java.sql.Timestamp"/>
	<field name="disetujui_oleh" class="java.lang.String"/>
	<field name="perpustakaan" class="java.lang.String"/>
	<field name="anggota" class="java.lang.String"/>
	<field name="kode_anggota" class="java.lang.String"/>
	<field name="barcode" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="56" splitType="Stretch">
			<image hAlign="Center" vAlign="Middle">
				<reportElement key="image-1" x="0" y="-16" width="79" height="71" uuid="62b2da8a-6027-4f49-ab0e-6849b897623d"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-14" x="79" y="-15" width="207" height="35" uuid="40df4453-ccbd-40f3-b65b-2742a698eaf7"/>
				<textElement textAlignment="Center">
					<font size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{perpustakaan}.toUpperCase()+"\n"+
"BUKTI PEMINJAMAN"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="79" y="20" width="207" height="33" uuid="ea8d1911-1861-4b0a-9399-40a78530a99e"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Kode peminjaman\t: "+$F{kode}+
"\nPeminjam\t\t: "+$F{kode_anggota}+" - "+$F{anggota}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="18">
			<textField>
				<reportElement x="0" y="0" width="79" height="18" uuid="0dfeb98f-a11b-47c9-8aee-9c834931f85e"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Barcode"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="79" y="0" width="207" height="18" uuid="38d0c8bf-9386-4d72-9cb4-e28b31d07f5c"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Judul"]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="12">
			<textField>
				<reportElement x="0" y="0" width="79" height="12" uuid="51fea582-b265-4a05-8c70-eef9ccbde970"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{barcode}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="79" y="0" width="207" height="12" uuid="37b92006-a485-4d66-b034-56f9196e222d"/>
				<box leftPadding="2">
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="211">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-16" x="164" y="4" width="122" height="37" uuid="dd069cbe-3974-42c6-9a03-47bb852fa462"/>
				<textElement textAlignment="Right">
					<font isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{label_kota}+", "+new java.text.SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format($F{tanggal_persetujuan})+
"\n"+$F{disetujui_oleh}.toUpperCase()]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
				<reportElement x="0" y="4" width="164" height="37" uuid="a8de593f-0938-461d-80ac-98f5b78beff8"/>
				<imageExpression><![CDATA[$P{kode_barcode}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="0" y="41" width="286" height="170" uuid="af1965bd-37f8-46c7-a3f3-e501da40ac28"/>
				<box leftPadding="2">
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement markup="html">
					<font size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{info}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>

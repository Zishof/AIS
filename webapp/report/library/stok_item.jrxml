	<queryString>
		<![CDATA[select a.item,
max(c.isbn) as isbn,
max(c.nama) as nama,
max(a.tanggal) as tanggal_terakhir_pengadaan,
max(ee.stok) as stok_awal,
max(ff.stok-ee.stok) as stok_selisih,
max(ff.stok) as stok_akhir,
max(d.nama) as perpustakaan,
max(c.pengarangs) as pengarang
from library.detail_transaksi a
inner join library.kode_transaksi b on (a.kode_transaksi = b.id)
left join library.item c on (a.item = c.id)
left join library.perpustakaan d on (a.perpustakaan = d.id)
left join (
	select
	sum((aa.qty+aa.qtybonus)*bb.jenis) as stok,
	aa.perpustakaan,aa.item
	from library.detail_transaksi aa
	inner join library.kode_transaksi bb on (aa.kode_transaksi = bb.id)
	where 1=1
	and aa.perpustakaan = $P{perpustakaan}
	and case when $P{item}=-1 then true else aa.item=$P{item} end
	and date(aa.tanggal) < date($P{mulai})
	group by aa.perpustakaan,aa.item
) ee on (ee.perpustakaan=a.perpustakaan and ee.item=a.item)
left join (
	select
	sum((aa.qty+aa.qtybonus)*bb.jenis) as stok,
	aa.perpustakaan,aa.item
	from library.detail_transaksi aa
	inner join library.kode_transaksi bb on (aa.kode_transaksi = bb.id)
	where 1=1
	and aa.perpustakaan = $P{perpustakaan}
	and case when $P{item}=-1 then true else aa.item=$P{item} end
	and date(aa.tanggal) <= date($P{sampai})
	group by aa.perpustakaan,aa.item
) ff on (ff.perpustakaan=a.perpustakaan and ff.item=a.item)
where 1=1
and a.perpustakaan = $P{perpustakaan}
and case when $P{item}=-1 then true else a.item=$P{item} end
and date(a.tanggal) between date($P{mulai}) and date($P{sampai})
group by a.perpustakaan,a.item order by max(ff.stok) asc]]>
	</queryString>

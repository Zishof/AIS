<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="peminjaman" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[2L]]></defaultValueExpression>
	</parameter>
	<parameter name="kode_barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="mulai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="sampai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="perpustakaan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(b.isbn) as isbn,
max(b.nama) as nama,
sum(a.dikembalikan) as jumlah,
max(d.nama) as perpustakaan,
max(f.nama) as penyedia,
date(c.tanggal_persetujuan) as tanggal

from library.retur_pengadaan_item_detail a
inner join library.item b on (a.item = b.id)
inner join library.retur_pengadaan_item c on (c.id = a.retur_pengadaan_item)
inner join library.perpustakaan d on (d.id = c.perpustakaan)
inner join library.penyedia f on (f.id = c.penyedia)
left join tbmuser e on (e.userid = c.disetujui_oleh)
where date(c.tanggal_persetujuan) between date($P{mulai}) and date($P{sampai})
and c.tanggal_persetujuan is not null
and d.id = $P{perpustakaan}
group by b.id, f.id, date(c.tanggal_persetujuan)
having sum(a.dikembalikan) > 0
order by penyedia, nama, tanggal]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="perpustakaan" class="java.lang.String"/>
	<field name="penyedia" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Date"/>
	<group name="penyedia">
		<groupExpression><![CDATA[$F{penyedia}]]></groupExpression>
		<groupHeader>
			<band height="40">
				<textField>
					<reportElement x="0" y="21" width="117" height="18"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center"/>
					<textFieldExpression><![CDATA["ISBN"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="117" y="21" width="250" height="18"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center"/>
					<textFieldExpression><![CDATA["Judul"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="455" y="21" width="100" height="18"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center"/>
					<textFieldExpression><![CDATA["Jumlah"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="0" width="555" height="21"/>
					<textElement/>
					<textFieldExpression><![CDATA["Penyedia\t: "+$F{penyedia}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="367" y="21" width="88" height="18"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center"/>
					<textFieldExpression><![CDATA["Tanggal"]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="95" splitType="Stretch">
			<image hAlign="Center" vAlign="Middle">
				<reportElement key="image-1" x="0" y="-16" width="555" height="71"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-14" x="0" y="55" width="555" height="35"/>
				<textElement textAlignment="Center">
					<font size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{perpustakaan}.toUpperCase()+"\n"+
"RETUR "+
(new java.text.SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format(new java.text.SimpleDateFormat("yyyy-MM-dd").parse($P{mulai}))+
" s.d "+
new java.text.SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format(new java.text.SimpleDateFormat("yyyy-MM-dd").parse($P{sampai}))).toUpperCase()]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<detail>
		<band height="26">
			<textField>
				<reportElement x="0" y="0" width="117" height="26"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{isbn}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="117" y="0" width="250" height="26"/>
				<box leftPadding="2">
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0;-#,##0">
				<reportElement x="455" y="0" width="100" height="26"/>
				<box rightPadding="3">
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{jumlah}]]></textFieldExpression>
			</textField>
			<textField pattern="dd MMMMM yyyy">
				<reportElement x="367" y="0" width="88" height="26"/>
				<box rightPadding="3">
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="41">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-16" x="339" y="4" width="216" height="37"/>
				<textElement textAlignment="Right">
					<font isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{label_kota}+", "+new java.text.SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format(new Date())]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
				<reportElement x="0" y="4" width="193" height="37"/>
				<imageExpression><![CDATA[$P{kode_barcode}]]></imageExpression>
			</image>
		</band>
	</summary>
</jasperReport>

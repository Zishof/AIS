				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{punggungklasifikasi}+"\n"+
$F{punggungpengarang}+"\n"+
$F{punggungjudul}+
($F{punggungedisi} == null || $F{punggungedisi}.trim().isEmpty() ? "" : "\n"+$F{punggungedisi})]]></textFieldExpression>
			</textField>
			<textField>

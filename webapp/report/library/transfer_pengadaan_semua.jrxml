	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[2L]]></defaultValueExpression>
	</parameter>
	<parameter name="kode_barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="mulai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="sampai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="perpustakaan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(b1.barcode) barcode,
max(b.isbn) as isbn,
max(b.nama) as nama,
max(a.jumlah) as jumlah,
max(d.nama) as perpustakaan,
max(f.nama) as perpustakaan_tujuan,
date(c.tanggal_persetujuan) as tanggal

from library.transfer_pengadaan_item_detail a
inner join library.item b on (a.item = b.id)
left join library.item_punya_barcode b1 on (a.item_punya_barcode=b1.id)
inner join library.transfer_pengadaan_item c on (c.id = a.transfer_pengadaan_item)
inner join library.perpustakaan d on (d.id = c.perpustakaan)
inner join library.perpustakaan f on (f.id = c.perpustakaan_tujuan)
left join library.terima_pengadaan_item g on (g.id = c.terima_pengadaan_item)
left join tbmuser e on (e.userid = c.disetujui_oleh)
where date(c.tanggal_persetujuan) between date($P{mulai}) and date($P{sampai})
and c.tanggal_persetujuan is not null
and d.id = $P{perpustakaan}
group by b.id, d.id, f.id, date(c.tanggal_persetujuan), barcode
order by perpustakaan_tujuan, nama, tanggal, barcode]]>
	</queryString>

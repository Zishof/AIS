	</parameter>
	<parameter name="sampai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="perpustakaan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="anggota" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(b.isbn) as isbn,
max(b.nama) as nama,
sum(a.jumlah - (case when k.dikembali is null then 0 else k.dikembali end)) as jumlah,
max(d.nama) as perpustakaan,
max(f.nama || ' (' || f.kode || ')') as anggota,
date(c.tanggal_persetujuan) as tanggal,
date(a.batas_waktu_pengembalian) as batas_waktu_pengembalian,
max(ff.nama||' - '||j.nama) as jurusan


from library.peminjaman_pengadaan_item_detail a
inner join library.item b on (a.item = b.id)
inner join library.peminjaman_pengadaan_item c on (c.id = a.peminjaman_pengadaan_item)
inner join library.perpustakaan d on (d.id = c.perpustakaan)
inner join library.anggota f on (f.id = c.anggota)
left join mahasiswa m on (f.mahasiswa=m.id)
left join jurusan j on (j.id=m.jurusan)
left join fakultas ff on (ff.id=j.fakultas)
left join library.kembali_pengadaan_item_detail k on (k.peminjaman_pengadaan_item_detail = a.id)
left join tbmuser e on (e.userid = c.disetujui_oleh)
where date(c.tanggal_persetujuan) between date($P{mulai}) and date($P{sampai})
and c.tanggal_persetujuan is not null
and d.id = $P{perpustakaan}
and case when $P{anggota} = -1 then true else f.id = $P{anggota} end
and (c.kembali_pengadaan_item is null or k.dikembali = 0)
group by b.id, f.id, date(c.tanggal_persetujuan), date(a.batas_waktu_pengembalian)
order by anggota, nama, tanggal, max(ff.nama||' - '||j.nama)]]>
	</queryString>

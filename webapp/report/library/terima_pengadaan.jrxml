					<font size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{perpustakaan}.toUpperCase()+"\n"+
"TERIMA ITEM"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="90" width="555" height="52" uuid="63299e66-8889-4912-9a22-e4bf56fe9dff"/>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="peminjaman" language="groovy" columnCount="2" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="277" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[5L]]></defaultValueExpression>
	</parameter>
	<parameter name="kode_barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="perpustakaan" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
b.isbn,
b.nama,
e.kode as kode,
e.nama as nama_,
f.kode as kode_parent,
c.tanggal_dirubah,
b.pengarangs

from library.data_udc_item_detail a
inner join library.item b on (a.item = b.id)
inner join library.data_udc_item c on (c.id = a.data_udc_item)
inner join library.udc_item e on (e.id = c.udc_item)
left join library.udc_item f on (f.id = e.parent)
where c.id = $P{id}]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="kode" class="java.lang.String"/>
	<field name="nama_" class="java.lang.String"/>
	<field name="kode_parent" class="java.lang.String"/>
	<field name="tanggal_dirubah" class="java.sql.Timestamp"/>
	<field name="pengarangs" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="133" splitType="Stretch">
			<image hAlign="Center" vAlign="Middle">
				<reportElement key="image-1" x="0" y="-16" width="555" height="71"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-14" x="0" y="55" width="555" height="35"/>
				<textElement textAlignment="Center">
					<font size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression><![CDATA["Universal Decimal Clasification (UDC)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="90" width="555" height="43"/>
				<textElement/>
				<textFieldExpression><![CDATA["Kode UDC\t: "+$F{kode}+
"\nNama UDC\t: "+$F{nama_}+
"\nWaktu dibuat\t: "+(new java.text.SimpleDateFormat("dd MMMMM yyyy HH:mm:ss", $P{REPORT_LOCALE}).format($F{tanggal_dirubah}))]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<detail>
		<band height="136">
			<rectangle>
				<reportElement x="0" y="6" width="272" height="121"/>
			</rectangle>
			<textField>
				<reportElement x="0" y="6" width="272" height="51"/>
				<box>
					<bottomPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Bottom">
					<font size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["PERPUSTAKAAN"+
"\n"+$P{perpustakaan}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="57" width="272" height="58"/>
				<box>
					<bottomPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{kode}+
"\n"+
($F{pengarangs}.length() > 3 ? $F{pengarangs}.substring( 0, 3 ).toUpperCase() : $F{pengarangs}.toUpperCase())+
"\n"+
($F{nama}.length() > 1 ? $F{nama}.substring( 0, 1 ).toLowerCase() : $F{nama}.toLowerCase())]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="115" width="272" height="12"/>
				<box rightPadding="3">
					<bottomPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="3" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{kode}+" - "+$F{nama_}+" - "+$F{isbn}+" - "+$F{nama}+" - "+$F{pengarangs}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="41">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-16" x="339" y="4" width="216" height="37"/>
				<textElement textAlignment="Right">
					<font isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{label_kota}+", "+new java.text.SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format($F{tanggal_dirubah})]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
				<reportElement x="0" y="4" width="193" height="37"/>
				<imageExpression><![CDATA[$P{kode_barcode}]]></imageExpression>
			</image>
		</band>
	</summary>
</jasperReport>

	<queryString>
		<![CDATA[select
b.isbn,
b.nama,
b.deweydecimalclass,
b.pengarangs,
cs.barcode

from library.item b
inner join library.item_punya_barcode cs on (b.id=cs.item)
where b.id = $P{id}]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>

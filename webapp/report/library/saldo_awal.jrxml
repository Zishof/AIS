			</textField>
		</band>
	</detail>
	<summary>
		<band height="41">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-16" x="339" y="4" width="216" height="37" uuid="3ff87659-2286-4da1-9cdd-3d4d296ddfec"/>
				<textElement textAlignment="Right">
					<font isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{label_kota}+", "+new java.text.SimpleDateFormat("dd MMMMM yyyy",$P{REPORT_LOCALE}).format($F{tanggal_persetujuan})+
"\n"+$F{disetujui_oleh}.toUpperCase()]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
				<reportElement x="0" y="4" width="193" height="37" uuid="10e91446-6791-4a5d-a7d1-79035f6dce23"/>
				<imageExpression><![CDATA[$P{kode_barcode}]]></imageExpression>
			</image>
		</band>
	</summary>

				<box leftPadding="2">
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0;-#,##0">
				<reportElement x="455" y="0" width="100" height="15" uuid="088986a4-2852-45f1-ac5b-4fe8eb1ac153"/>
				<box rightPadding="3">
					<topPen lineWidth="0.5"/>

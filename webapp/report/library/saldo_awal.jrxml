					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["ISBN"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="117" y="0" width="338" height="18" uuid="d5a8b913-3200-417f-a4ec-5a21cdc9f883"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Judul"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="455" y="0" width="100" height="18" uuid="a6ba5019-e740-4e2a-95b4-b43cf50a5b0e"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Jumlah"]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="15">
			<textField>
				<reportElement x="0" y="0" width="117" height="15" uuid="06521c8f-2cf1-4069-bac7-0aede7e04da4"/>
				<box>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center">
					<font size="8"/>
				</textElement>

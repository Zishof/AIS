			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="26">
			<textField>
				<reportElement x="0" y="0" width="117" height="26" uuid="6644fc4b-4fd1-4481-b62e-29217ab4eba9"/>
				<box>

"\nTujuan Transfer\t\t: "+$F{perpustakaan_tujuan}+
"\nStatus\t\t\t: "+$F{status_persetujuan}+" "+(new java.text.SimpleDateFormat("dd MMMMM yyyy HH:mm:ss", $P{REPORT_LOCALE}).format($F{tanggal_persetujuan}))+
"\n\t\t\t: "+$F{status_penerimaan}]]></textFieldExpression>

	<queryString>
		<![CDATA[select
max(b.isbn) as isbn,
max(b.nama) as nama,
sum(a.jumlah) as jumlah,
max(d.nama) as perpustakaan,
max(case when f.id is not null then f.nama else b.deweydecimalclass end) as ddc,
max(b.pengarangs) as pengarang,
max(g.nama) as penerbit

from library.saldo_awal_detail a
inner join library.item b on (a.item = b.id)
inner join library.saldo_awal c on (c.id = a.saldo_awal)
inner join library.perpustakaan d on (d.id = c.perpustakaan)
left join library.ddc_item f on (b.ddc_item=f.id)
left join library.penerbit g on (b.penerbit=g.id)
left join tbmuser e on (e.userid = c.disetujui_oleh)
where case when $P{id}=-1 then true else c.id = $P{id} end
group by b.id]]>
	</queryString>
	<field name="isbn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="perpustakaan" class="java.lang.String"/>
	<field name="ddc" class="java.lang.String"/>
	<field name="pengarang" class="java.lang.String"/>
	<field name="penerbit" class="java.lang.String"/>
	<variable name="jumlah" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>

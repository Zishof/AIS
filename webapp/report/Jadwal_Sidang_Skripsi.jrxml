<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Jadwal_Sidang_Skripsi" language="groovy" pageWidth="612" pageHeight="432" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="fakultas" class="java.lang.String"/>
	<parameter name="mahasiswa" class="java.lang.Long"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="waktu_sidang" class="java.lang.String" isForPrompting="false"/>
	<parameter name="ruang_sidang" class="java.lang.String" isForPrompting="false"/>
	<parameter name="tanggal_sidang" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select b.nim as nim,
b.nama as nama,
e.nama as prodi,
a.judul,
c.nama as pembimbing1,
d.nama as pembimbing2,
a.tanggal_sidang

from skripsi a

left join mahasiswa b on a.mahasiswa = b.id
left join dosen c on a.pembimbing = c.id
left join dosen d on a.ketua_sidang = d.id
left join jurusan e on b.jurusan = e.id

where mahasiswa = $P{mahasiswa}]]>
	</queryString>
	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="prodi" class="java.lang.String"/>
	<field name="judul" class="java.lang.String"/>
	<field name="pembimbing1" class="java.lang.String"/>
	<field name="pembimbing2" class="java.lang.String"/>
	<field name="tanggal_sidang" class="java.sql.Date"/>

			<textField isBlankWhenNull="false">
				<reportElement key="textField-1" x="63" y="10" width="232" height="46"/>
				<textElement textAlignment="Left">
					<font size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["FAKULTAS "+$P{fakultas}.toUpperCase()+"\nUNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH\nJAKARTA"]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>

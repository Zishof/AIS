				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["JADWAL UJIAN SKRIPSI\n"+"FAKULTAS "+$P{fakultas}.toUpperCase()+" \n UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="46" width="567" height="1"/>
				<graphicElement>

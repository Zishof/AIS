	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="smt" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.id,
b.semester,
a.kode,
a.nama,
a.sks,
a.status,
e.nama as prasyarat,
d.matakuliah_prasyarat as id_prasyarat,
c.tahun
from matakuliah a
left join kurikulum_punya_matakuliah b on (b.matakuliah = a.id)
left join kurikulum c on (b.kurikulum = c.id)
left join matakuliah_prasyarat d on (d.matakuliah = a.id)
left join matakuliah e on (d.matakuliah_prasyarat = e.id)
where b.kurikulum = $P{jenis}
and b.aktif
and (case when $P{smt} = -1 then true else b.semester=$P{smt} end)
order by b.semester, substr(a.kode,4),a.kode]]>
	</queryString>

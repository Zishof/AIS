	</parameter>
	<queryString>
		<![CDATA[select
max(c.nama) as fakultas,
max(b.nama) as jurusan,
sum(case when upper(trim(d.kode_epsbed)) = 'A' and a.kelamin ilike '%Laki-Laki%' then 1 else 0 end) as aktif_lk,
sum(case when upper(trim(d.kode_epsbed)) = 'A' and a.kelamin ilike '%Perempuan%' then 1 else 0 end) as aktif_pr,
sum(case when upper(trim(d.kode_epsbed)) = 'A' and ( a.kelamin ilike '%Laki-Laki%' or a.kelamin ilike '%Perempuan%') then 1 else 0 end) as aktif_total,
sum(case when upper(trim(d.kode_epsbed)) = 'C' and a.kelamin ilike '%Laki-Laki%' then 1 else 0 end) as cuti_lk,
sum(case when upper(trim(d.kode_epsbed)) = 'C' and a.kelamin ilike '%Perempuan%' then 1 else 0 end) as cuti_pr,
sum(case when upper(trim(d.kode_epsbed)) = 'C' and ( a.kelamin ilike '%Laki-Laki%' or a.kelamin ilike '%Perempuan%') then 1 else 0 end) as cuti_total,
sum(case when upper(trim(d.kode_epsbed)) = 'L' and a.kelamin ilike '%Laki-Laki%' then 1 else 0 end) as lulus_lk,
sum(case when upper(trim(d.kode_epsbed)) = 'L' and a.kelamin ilike '%Perempuan%' then 1 else 0 end) as lulus_pr,
sum(case when upper(trim(d.kode_epsbed)) = 'L' and ( a.kelamin ilike '%Laki-Laki%' or a.kelamin ilike '%Perempuan%') then 1 else 0 end) as lulus_total,
sum(case when upper(trim(d.kode_epsbed)) = 'D' and a.kelamin ilike '%Laki-Laki%' then 1 else 0 end) as do_lk,
sum(case when upper(trim(d.kode_epsbed)) = 'D' and a.kelamin ilike '%Perempuan%' then 1 else 0 end) as do_pr,
sum(case when upper(trim(d.kode_epsbed)) = 'D' and ( a.kelamin ilike '%Laki-Laki%' or a.kelamin ilike '%Perempuan%') then 1 else 0 end) as do_total,
sum(case when upper(trim(d.kode_epsbed)) = 'N' and a.kelamin ilike '%Laki-Laki%' then 1 else 0 end) as ta_lk,
sum(case when upper(trim(d.kode_epsbed)) = 'N' and a.kelamin ilike '%Perempuan%' then 1 else 0 end) as ta_pr,
sum(case when upper(trim(d.kode_epsbed)) = 'N' and ( a.kelamin ilike '%Laki-Laki%' or a.kelamin ilike '%Perempuan%') then 1 else 0 end) as ta_total

from (
  select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
  where (case when 'Ganjil' = $P{semester} then semester % 2 != 0 else semester % 2 = 0 end)
  and tahunakademik = $P{tahunAkademik}
  group by mahasiswa
) as history
inner join mahasiswa a on (history.mahasiswa = a.id)
inner join jurusan b on (a.jurusan = b.id)
inner join fakultas c on (b.fakultas = c.id)
inner join status_mahasiswa d on (d.id = history.status_mahasiswa)
where
case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{fakultas} = -1 then true else b.fakultas = $P{fakultas} end
and case when $P{program} = '-1' then true else a.program =  $P{program} end
and case when $P{statusMahasiswaAwal} = -1 then true else a.status_awal_mahasiswa = $P{statusMahasiswaAwal}  end
group by c.id, b.id
order by fakultas, jurusan]]>
	</queryString>

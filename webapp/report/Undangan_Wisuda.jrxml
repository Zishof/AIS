	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_ayah" class="java.lang.String" isForPrompting="false"/>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select m.nim, m.nama, bm.nama_ayah,
	j.nama as jurusan, f.nama as fakultas, pw.no_registrasi_wisuda,pw.no_kursi
from pendaftaran_wisuda pw
inner join mahasiswa m on (pw.mahasiswa = m.id)
inner join jurusan j on (m.jurusan = j.id)
inner join fakultas f on (j.fakultas = f.id),
biodata_mahasiswa bm
where pw.mahasiswa=$P{mahasiswa}]]>
	</queryString>

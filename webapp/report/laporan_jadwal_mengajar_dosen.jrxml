	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2010/2011"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[9L]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="kelas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	b.nama nama_dosen_1,
	b.code nip_dosen_1,
	c.nama nama_dosen_2,
	c.code nip_dosen_2,
	d.kode kode_mk,
	d.nama matakuliah,
	d.sks sks,
	a.program,
	a.waktu,
	a.semester semester,
	a.kelas kelas,
	a.hari hari,
	(a.waktu_mulai || ' - ' || a.waktu_selesai) jam_mengajar,
	(e.nama || ' - ' || e.kode_ruangan) ruang,
	f.nama jurusan,
	h.nama fakultas,
	i.jumlah_mahasiswa as jumlah_mhswa,
	(case a.hari when 'Minggu' then 1 when 'Senin' then 2 when 'Selasa' then 3 when 'Rabu' then 4 when 'Kamis' then 5 when 'Sabtu' then 7 else 6 end) as hari_ke
from perkuliahan a
left join dosen b on (a.dosen1=b.id)
left join dosen c on (a.dosen2=c.id)
left join matakuliah d on (a.matakuliah=d.id)
left join ruang e on (a.ruang=e.id)
left join jurusan f on (a.jurusan=f.id)
left join fakultas h on (h.id=f.fakultas)
left join (
	select
	perkuliahan,
	count(id) as jumlah_mahasiswa
	from detailperkuliahan
	where persetujuan = 1
	group by perkuliahan
) i on (i.perkuliahan = a.id)
where a.tahun_ajaran=$P{tahun_akademik} and a.semester%2= (case when $P{semester} = 'Ganjil' then 1 else 0 end) and case when $P{fakultas} = -1 then true else f.fakultas=$P{fakultas} end
and case when $P{kelas} = '-1' then true else a.kelas ilike $P{kelas} end
order by hari_ke,a.waktu_mulai_d,a.waktu_selesai_d,d.nama]]>
	</queryString>

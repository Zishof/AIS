	<queryString>
		<![CDATA[select
m.id as mahasiswa,
m.nama as namamahasiswa,
case when $P{jenis_ujian}='uts' then k.nouts else k.nouas end as nomoujian,
f.nama as namafakultas


from mahasiswa m
left join jurusan d on (d.id = m.jurusan)
left join fakultas f on (d.fakultas=d.id)
inner join krs_mahasiswa k on (m.id=k.mahasiswa and k.semester=$P{semester} and semesterpendek is null)

where d.fakultas is not null

and case $P{kelas} when '' then true else m.kelas ilike '%'||$P{kelas}||'%' end
and case $P{semester} when -1 then true else k.semester=$P{semester} end
and case $P{tahun_akademik} when '-1' then true else k.tahunakademik = $P{tahun_akademik} end
and case $P{jurusan} when -1 then true else m.jurusan = $P{jurusan} end
and case $P{fakultas} when -1 then true else d.fakultas=$P{fakultas} end
and case when $X{IN,-1234567899999999999,nims} then true else $X{IN,m.id,nims} end
order by m.nim]]>
	</queryString>

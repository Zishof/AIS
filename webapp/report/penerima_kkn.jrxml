	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_kkn" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="logo1" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
b.nama as nama_mhs,
b.nim as nim_mhs,
d.nama as jurusan,
e.nama as fakultas,
b.kelamin,
c.nama as nama_beasiswa,
b.alamat,
b.telp as hp

FROM mahasiswa_daftar_kkn a
LEFT JOIN mahasiswa b on a.mahasiswa = b."id"
LEFT JOIN kkn c on a.kkn = c."id"



left join jurusan d on b.jurusan = d."id"
LEFT JOIN fakultas e on d.fakultas = e."id"

WHERE a.terima = 1
AND
c."id" = $P{id_kkn}

order by b.nim]]>
	</queryString>
	<field name="nama_mhs" class="java.lang.String"/>
	<field name="nim_mhs" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>

	<parameter name="tahunangkatan" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select a.*,b.nim,b.nama,c.nama as jur,d.nama as fak from nilai_toefl_toafl_mahasiswa a
left join mahasiswa b on a.mahasiswa=b.id
left join jurusan c on b.jurusan=c.id
left join fakultas d on c.fakultas = d.id

 where
case when $P{fakultas} = -1 then true else d.id = $P{fakultas} end
and case when $P{jurusan} = -1 then true else c.id = $P{jurusan} end
and case when $P{jenistest} = -1 then true else a.jenis_toefl = $P{jenistest} end
and case when $P{tahunangkatan} = -1 then true else b.tahunangkatan = $P{tahunangkatan} end
ORDER BY
b.nama,  b.nim]]>
	</queryString>

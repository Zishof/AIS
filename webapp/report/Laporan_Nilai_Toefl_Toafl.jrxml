+"\n"+$P{label_jurusan}.toUpperCase()+" "+($P{jurusan}.equals(-1L) ? "Semua".toUpperCase() : $F{jur}.toUpperCase())
+"\nTahun Angkatan ".toUpperCase()+($P{angkatan}.equals(-1) ? "Semua".toUpperCase() : $P{angkatan})]]></textFieldExpression>

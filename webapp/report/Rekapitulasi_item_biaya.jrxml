	</parameter>
	<parameter name="mulai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sampai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="mulai_s" class="java.lang.String" isForPrompting="false"/>
	<parameter name="sampai_s" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select case when b.nim is null then b1.no_registrasi else b.nim end as nim,
case when b.nama is null then b1.nama else b.nama end as nama,
case when b.tahunangkatan is null then b1.tahun else b.tahunangkatan end as tahunangkatan,
a.tahun_akademik,
a.semster,
c.nama as nama_jurusan,
d.nama as nama_fakultas,
a.program,
e.nama as nama_item_biaya,
h.nama_kegiatan,
a1.nilai nominal

from cicilan_pembayaran a1
inner join kegiatan a on (a.id = a1.kegiatan)
left join mahasiswa b on a.mahasiswa=b.id
left join biodata_calon_mahasiswa b1 on a.calon_mahasiswa=b1.id
left join jurusan c on (b.jurusan=c.id or b1.prodi_lulus = c.id)
left join fakultas d on c.fakultas=d.id
left join item_biaya e on a1.item_biaya = e.id
left join jenis_kegiatan h on h.id = a.jenis_kegiatan

where a.tahun_akademik = $P{tahun_akademik}
and date(a1.tanggal) between date($P{mulai_s}) and date($P{sampai_s})
and case when $P{item_biaya} = -1 then true else a.jenis_kegiatan = $P{item_biaya} end
order by (case when b.nim is null then b1.no_registrasi else b.nim end)]]>
	</queryString>

	<queryString>
		<![CDATA[select
id,
max(tipe_penelitian_dan_pengabdian) as tipe_penelitian_dan_pengabdian,
max(tipe) as tipe,
userid,
max(nama) as nama,
max(jabatan) as jabatan,
max(judul) as judul,
max(kluster) as kluster,
max(tujuan) as tujuan,
max(tahun) as tahun,
max(jumlahdana) as jumlahdana,
max(homebase) as homebase,
max(sumberdana) as sumberdana
from (
	select
	a.id,
	a1.tipe_penelitian_dan_pengabdian,
	a2.isi as tipe,
	(case when b.userid is not null then b.userid else c.nim end) as userid,
	(case when b1.nama is not null then b1.nama when b.usernama is not null then b.usernama else c.nama end) as nama,
	'Ketua' as jabatan,
	a.judul,
	a1.judul as kluster,
	a.tujuan,
	a1.tahun,
	a.jumlahdana,
	(case when j.nama is null then 'Tanpa Homebase' else j.nama end) as homebase,
	(select string_agg(cc.nama, E',') as sumberdana from penelitiandanpengabdian.sumber_dana_penelitian_dan_pengabdian cc inner join penelitiandanpengabdian.pengajuan_has_sumber_dana dd on (cc.id=dd.sumber_dana) where dd.pengajuan=a.id)

	from penelitiandanpengabdian.pengajuan_penelitian_dan_pengabdian a
	inner join penelitiandanpengabdian.penelitian_dan_pengabdian a1 on (a.penelitian_dan_pengabdian = a1.id)
	inner join penelitiandanpengabdian.tipe_penelitian_dan_pengabdian a2 on (a1.tipe_penelitian_dan_pengabdian=a2.id)
	left join tbmuser b on (b.userid = a.tbmuser)
	left join dosen b1 on (b.dosen = b1.id)
	left join mahasiswa c on (a.mahasiswa = c.id)
	left join jurusan j on (b1.jurusan=j.id or c.jurusan=j.id)
	where (b1.nama is not null or c.nama is not null or b.usernama is not null)
	and a.status = 'Disetujui'

	union all

	select
	a.id,
	a1.tipe_penelitian_dan_pengabdian,
	a3.isi as tipe,
	(case when b.userid is not null then b.userid else c.nim end) as userid,
	(case when b1.nama is not null then b1.nama when b.usernama is not null then b.usernama else c.nama end) as nama,
	'Anggota' as jabatan,
	a.judul,
	a1.judul as kluster,
	a.tujuan,
	a1.tahun,
	a.jumlahdana,
	(case when j.nama is null then 'Tanpa Homebase' else j.nama end) as homebase,
	(select string_agg(cc.nama, E',') as sumberdana from penelitiandanpengabdian.sumber_dana_penelitian_dan_pengabdian cc inner join penelitiandanpengabdian.pengajuan_has_sumber_dana dd on (cc.id=dd.sumber_dana) where dd.pengajuan=a.id)

	from penelitiandanpengabdian.pengajuan_penelitian_dan_pengabdian a
	inner join penelitiandanpengabdian.penelitian_dan_pengabdian a1 on (a.penelitian_dan_pengabdian = a1.id)
	inner join penelitiandanpengabdian.tipe_penelitian_dan_pengabdian a3 on (a1.tipe_penelitian_dan_pengabdian=a3.id)
	inner join penelitiandanpengabdian.anggota_pengajuan_penelitian_dan_pengabdian a2 on (a2.pengajuan_penelitian_dan_pengabdian=a.id)
	left join tbmuser b on (b.userid = a2.tbmuser)
	left join dosen b1 on (b.dosen = b1.id)
	left join mahasiswa c on (a2.mahasiswa = c.id)
	left join jurusan j on (b1.jurusan=j.id or c.jurusan=j.id)
	where (b1.nama is not null or c.nama is not null or b.usernama is not null)
	and case when $P{jurusan} = -1 then true else j.id=$P{jurusan} end
	and case when $P{fakultas} = -1 then true else j.fakultas=$P{fakultas} end
	and a.status = 'Disetujui'
) a
where case when $P{userid} = '' then true else userid ilike '%'||$P{userid}||'%' end
and case when $P{judul} = '' then true else judul ilike '%'||$P{judul}||'%' end
and case when $P{tipePenelitianDanPengabdian} = -1 then true else  a.tipe_penelitian_dan_pengabdian=$P{tipePenelitianDanPengabdian} end
group by id,userid
order by homebase,userid,tahun,jabatan desc]]>
	</queryString>

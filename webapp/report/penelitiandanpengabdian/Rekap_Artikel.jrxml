	</parameter>
	<parameter name="tipePenelitianDanPengabdian" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="namaTipePenelitianDanPengabdian" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Penelitian dan Pengabdian"]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	a.id,
	(case when b.userid is not null then b.userid else c.nim end) as userid,
	(case when b1.nama is not null then b1.nama when b.usernama is not null then b.usernama else c.nama end) as nama,
	a1.judul as jurnal,
	a.issn,
	a.eissn,
	a.vol,
	a.nomor,
	a.path,
	a.judul,
	a.tahun,
	a.copyrightholder,
	(case when j.nama is null then 'Tanpa Homebase' else j.nama end) as homebase,
	(select string_agg(cc.nama, E',') as tingkat_publikasi from penelitiandanpengabdian.tingkat_publikasi cc inner join penelitiandanpengabdian.pengajuan_has_sumber_dana dd on (cc.id=dd.sumber_dana) where dd.pengajuan=a.id)

	from penelitiandanpengabdian.artikel a
	inner join penelitiandanpengabdian.jurnal_penelitian a1 on (a.jurnal_penelitian = a1.id)
	left join tbmuser b on (b.userid = a.tbmuser)
	left join dosen b1 on (b.dosen = b1.id)
	left join mahasiswa c on (a.mahasiswa = c.id)
	left join jurusan j on (b1.jurusan=j.id or c.jurusan=j.id)
	where (b1.nama is not null or c.nama is not null or b.usernama is not null)
and case when $P{userid} = '' then true else userid ilike '%'||$P{userid}||'%' or b.usernama ilike '%'||$P{userid}||'%' end
and case when $P{judul} = '' then true else a.judul ilike '%'||$P{judul}||'%' end
and case when $P{jurusan} = -1 then true else j.id=$P{jurusan} end
and case when $P{fakultas} = -1 then true else j.fakultas=$P{fakultas} end
order by j.nama,userid,a.tahun,id desc, jabatan desc]]>
	</queryString>

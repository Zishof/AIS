		<defaultValueExpression><![CDATA[2018]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.nama, a.nama_en, a.nomorurut, b.nama as nama_jenis, b.keterangan keterangan_jenis, b.nomorurut as no_urut_jenis from capaian_jurusan a
left join jenis_capaian_jurusan b on a.jenis_capaian_jurusan_id = b.id
where jurusan=(select jurusan from mahasiswa where id=$P{mahasiswa_id})
and (a.tahunlulus=$P{tahunlulus} or a.tahunlulus is null) and a.aktif
order by no_urut_jenis, nomorurut, nama]]>
	</queryString>

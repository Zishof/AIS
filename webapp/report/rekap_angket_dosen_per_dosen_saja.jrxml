	<queryString>
		<![CDATA[select max(a.grup_checklist_penilaian_dosen) as grup_id,
max(b.isi) as grup,
max(a.isi) as isi,
max(e.nama) as dosen,
e.id as id_dosen,
max(a.bobot) as bobot,
sum(x.nilai1) as "nilai 1",
sum(x.nilai2) as "nilai 2",
sum(x.nilai3) as "nilai 3",
sum(x.nilai4) as "nilai 4",
sum(x.nilai5) as "nilai 5",
sum(x.nilai1+x.nilai2+x.nilai3+x.nilai4+x.nilai5) as "total",
max(x.pemilih) as pemilih
from rekap_angket_dosen x
inner join checklist_penilaian_dosen a on (a.id=x.checklist_penilaian_dosen)
inner join grup_checklist_penilaian_dosen b on (a.grup_checklist_penilaian_dosen=b.id)
inner join perkuliahan c on (x.perkuliahan=c.id)
inner join jurusan d on (c.jurusan=d.id)
inner join dosen e on (x.dosen=e.id)
where c.tahun_ajaran=$P{tahun_akademik}
and c.semester%2 = (case $P{genapGanjil} when 'Semua' then c.semester%2 when 'Ganjil' then 1 else 0 end)
and case when $P{jurusan}=-1 then true else c.jurusan=$P{jurusan} end
and case when $P{fakultas}=-1 then true else d.fakultas=$P{fakultas} end
and case when $P{dosen}=-1 then true else x.dosen=$P{dosen} end
and case when $P{program}='-1' then true else c.program=$P{program} end
and (c.aktif=true or c.aktif is null)
and x.dosen in (c.dosen1,c.dosen2,c.dosen3,c.dosen4,c.dosen5,c.dosen6,c.dosen7,c.dosen8,c.dosen9,c.dosen10)
and case when $P{aktif} then (a.aktif=true or a.aktif is null) else true end
and case when $P{aktif} then (b.aktif=true or b.aktif is null) else true end
and case $P{masa_perkuliahan} when -1 then true else c.masa_perkuliahan = $P{masa_perkuliahan} end
and case $P{semester_pendek} when -1 then c.status_semesterpendek is null else c.status_semesterpendek = $P{semester_pendek} end

GROUP BY e.id,b.id,a.id
order by e.id,b.id,max(a.isi),a.id]]>
	</queryString>

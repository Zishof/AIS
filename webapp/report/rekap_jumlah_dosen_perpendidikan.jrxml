<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rekap_jumlah_mahasiswa_semua" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="26" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="SubTitle" forecolor="#666666" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Reguler"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2010/2011"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.nama as fakultas,
c.nama as jurusan,
max(d.nama) as pendidikan,
count(a.id) as jumlah
from (
	select
	a.id as id,a.fakultas,a.jurusan,
	(select aa.jenjang_pendidikan from riwayat_pendidikan_dosen aa where aa.dosen = a.id order by aa.tahun_keluar desc limit 1) as id_pendidikan
	from (
select
a.*
from perkuliahan aa
inner join dosen a on (aa.dosen1 = a.id or aa.dosen2 = a.id  or aa.dosen3 = a.id  or aa.dosen4 = a.id  or aa.dosen5 = a.id  or aa.dosen6 = a.id  or aa.dosen7 = a.id  or aa.dosen8 = a.id  or aa.dosen9 = a.id or aa.dosen10 = a.id)
and case $P{semester} when '-1' then true when 'Ganjil' then aa.ganjil_genap = 'Ganjil' else aa.ganjil_genap = 'Genap' end
and case $P{tahun_akademik} when '-1' then true else aa.tahun_ajaran = $P{tahun_akademik} end
) a
	) as a


left join jurusan c on (a.jurusan=c.id)
left join fakultas b on (c.fakultas=b.id)
left join jenjang d on (a.id_pendidikan = d.id)

where
a.id_pendidikan is not null and case when $P{jurusan} = -1 then true else a.jurusan = $P{jurusan} end
and case when $P{fakultas} = -1 then true else c.fakultas = $P{fakultas} end
group by b.nama, c.nama,a.id_pendidikan
order by b.nama, c.nama]]>
	</queryString>
	<field name="fakultas" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="pendidikan" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Long"/>
	<variable name="total_pendidik" class="java.lang.Integer" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<group name="fakultas">
		<groupExpression><![CDATA[$F{fakultas}]]></groupExpression>

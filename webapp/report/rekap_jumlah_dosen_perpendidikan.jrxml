				</textElement>
				<textFieldExpression><![CDATA[(!$P{tahun_akademik}.equals("-1") ? "Tahun Akademik "+$P{tahun_akademik} : "")+( !$P{semester}.equals("-1") ? " semester "+$P{semester} : "")]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>

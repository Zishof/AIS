<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Cetak_KRS_Mahasiswa" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[14009L]]></defaultValueExpression>
	</parameter>
	<parameter name="semester" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="tanggal" class="java.lang.String" isForPrompting="false"/>
	<parameter name="kaprodi" class="java.lang.String" isForPrompting="false"/>
	<parameter name="nip" class="java.lang.String" isForPrompting="false"/>
	<parameter name="dosenpa" class="java.lang.String" isForPrompting="false"/>
	<parameter name="namamahasiswa" class="java.lang.String" isForPrompting="false"/>
	<parameter name="namafakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Hukum"]]></defaultValueExpression>
	</parameter>
	<parameter name="nipdosenpa" class="java.lang.String" isForPrompting="false"/>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_kota" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ciputat"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_ka_prodi" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ka. Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="semester_pendek" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select m.nama,
		m.nim,
		j.nama as jurusan,
		f.nama as fakultas,
		jg.nama as jenjang,
		dk.semester,
		pk.tahun_ajaran,
		mk.kode as kode_mata_kuliah,
		mk.nama as mata_kuliah,
		mk.sks,
		pk.kelas,
		pk.ruang,
		pk.hari,
		pk.waktu_mulai,
		r.kode_ruangan as ruangan,
d1.nama as dosen_pa,
d1.code as nip_dosen_pa,
(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
(case when d.nama is not null and e.nama is not null then (d.nama || ', ' || e.nama) when  d.nama is not null then d.nama else '' end) as dosen


from mahasiswa m
inner join jurusan j on (m.jurusan = j.id)
inner join fakultas f on (j.fakultas = f.id)
inner join jenjang jg on (m.jenjang = jg.id)
inner join detailperkuliahan dk on (dk.mahasiswa = m.id)
inner join perkuliahan pk on (dk.perkuliahan = pk.id)
inner join matakuliah mk on (pk.matakuliah = mk.id)
left join dosen d1 on (m.dosen = d1.id)
left join dosen d on (pk.dosen1 = d.id)
left join dosen e on (pk.dosen2 = e.id)
left join ruang r on pk.ruang = r.id
left join (
	select aa.nama, aa.nip, aa.jurusan, aa.fakultas
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kajur%'
) h on (h.fakultas = f.id)
left join dosen i on (h.nip = i.code)
where m.id=$P{mahasiswa}
and dk.semester=$P{semester}
and case when $P{semester_pendek} is null then pk.status_semesterpendek is null else pk.status_semesterpendek = $P{semester_pendek} end
order by mk.kode]]>
	</queryString>

		 whenResourceMissingType="Empty">
	<property name="ireport.zoom" value="3.0" />
	<property name="ireport.x" value="0" />
	<property name="ireport.y" value="0" />
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="sampai" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(30)]]></defaultValueExpression>
	</parameter>
	<parameter name="mulai" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(145981)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select
max(f.kode) as kode_matakuliah,
max(f.nama) as nama_matakuliah,
max(f.sks) as sks,
max(a.nilai_huruf) as nilai_huruf,
a.semester

from detailperkuliahan a
left join perkuliahan b on (a.perkuliahan = b.id)
left join mahasiswa c on (a.mahasiswa = c.id)
left join matakuliah f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
where a.mahasiswa = $P{mahasiswa}
group by f.id, a.semester
order by max(a.semester), max(f.nama)
limit $P{sampai} offset $P{mulai}]]></queryString>

	<field name="kode_matakuliah" class="java.lang.String"/>
	<field name="nama_matakuliah" class="java.lang.String"/>
	<field name="sks" class="java.lang.Integer"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="semester" class="java.lang.Integer"/>

	<variable name="nomor" class="java.lang.Integer" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($P{mulai}.intValue()+$V{REPORT_COUNT}.intValue())]]></variableExpression>

	</parameter>
	<queryString>
		<![CDATA[select
'Pembimbing I' as pembimbing,
a.pembimbing as dosen_id,
b.id id_jadwal,
b.nama,
b.mulai,
b.sampai,
m.nim,
m.nama as nama_mhs,
d1.nama as dosen1,
d2.nama as dosen2,
d3.nama as dosen3,
d4.nama as dosen4,
d5.nama as dosen5,
j.nama as jur,
f.nama as fak,
m.tahunangkatan,
a.nilai_ketua_sidang status,
a.judul,
m.kelamin,
a.total_nilai as totalnilai,
a.nilai_huruf as nilaihuruf

from skripsi a
left join jadwal_sidang_tugas_akhir b on (b.id=a.jadwal_sidang_tugas_akhir)
left join dosen d1 on a.pembimbing = d1.id
left join dosen d2 on a.ketua_sidang = d2.id
left join dosen d3 on a.penguji1 = d3.id
left join dosen d4 on a.penguji2 = d4.id
left join dosen d5 on a.penguji3 = d5.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (a.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on a.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else (a.pembimbing = $P{dosen} or a.ketua_sidang = $P{dosen} or a.penguji1 = $P{dosen} or a.penguji2 = $P{dosen} or a.penguji3 = $P{dosen}) end
and case when $P{mahasiswa} = -1 then true else a.mahasiswa = $P{mahasiswa} end
and case when $P{jadwal} = -1 then true else a.jadwal_sidang_tugas_akhir = $P{jadwal} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end
and case when $P{program} = '-1' then true else b.program = $P{program} end
order by a.pembimbing,j.nama,m.nim]]>
	</queryString>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Rekapitulasi_Uang_Makan_Report" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="33f2464b-8c44-4ed3-973c-9600effea22f">
	<property name="ireport.zoom" value="1.4641000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nama_rektor" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Dr. H. Kasmuri, M.A"]]></defaultValueExpression>
	</parameter>
	<parameter name="bulan_str" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Juni"]]></defaultValueExpression>
	</parameter>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[6]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2019]]></defaultValueExpression>
	</parameter>
	<parameter name="statusDosen" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="statusKepegawaian" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jenisTenagaKependidikan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.nama,
b.mycode as nip,
max(f.nama) as golongan,
max(case when c.jabatan_fungsional_dosen is not null then e.nama else d.nama end) as jabatan,
sum(case when a.statusabsensi=1 then 1 else 0 end) as uang_makan_hari

from pegawai b
left join status_kehadiran_karyawan_harian a on (a.pegawai = b.id)
left join dosen c on (b.dosen=c.id)
left join jenis_tenaga_kependidikan d on (d.id = b.jenis_tenaga_kependidikan)
left join jabatan_fungsional_dosen e on (e.id = c.jabatan_fungsional_dosen)
left join employ.golongan f on (b.golongan_pegawai = f.id)

where a.bulan=$P{bulan} and a.tahun=$P{tahun}
	and case when $P{statusKepegawaian} = -1 then true else b.status_kepegawaian = $P{statusKepegawaian} end
			and case when $P{statusDosen}='Semua' then true when $P{statusDosen}='Dosen' then b.dosen is not null else b.dosen is null end
and case when $P{jenisTenagaKependidikan} = -1 then true else b.jenis_tenaga_kependidikan = $P{statusKepegawaian} end
group by b.id
order by b.nama]]>
	</queryString>
	<field name="nama" class="java.lang.String"/>
	<field name="nip" class="java.lang.String"/>
	<field name="golongan" class="java.lang.String"/>
	<field name="jabatan" class="java.lang.String"/>
	<field name="uang_makan_hari" class="java.lang.Long"/>

	<queryString>
		<![CDATA[select
a.id,
a.mycode as nip,
a.nama as nama,
c.id as dept,
c.nama as nama_dept,
b.tanggal,
d.nama as shift,
b.masuk_jam::time as masuk_jam,
b.pulang_jam::time as pulang_jam,
b.waktujammasuk jumlahjammasuk,
b.waktuterlambat jumlahterlambat,
b.waktucepatkeluar jumlahcepatkeluar,
b.waktulemburmasuk jumlahlemburmasuk,
b.secondjammasuk,
b.secondterlambat,
b.secondcepatkeluar,
b.secondlemburmasuk,
b.keterangan

from pegawai a
left join status_kehadiran_karyawan_harian b on (a.id = b.pegawai)
left join payroll.departemen c on (c.id = a.departemen)
left join payroll.detail_jenis_shift_pegawai d on (d.id = b.detail_jenis_shift_pegawai)

where 1=1
and b.bulan = $P{bulan}
and b.tahun = $P{tahun}
and b.minggu in ($P{hari1},$P{hari2},$P{hari3},$P{hari4},$P{hari5},$P{hari6},$P{hari7})
and a.nama is not null
and b.jumlahlemburmasuk > 0.0
order by c.nama,a.nama,b.tanggal]]>
	</queryString>

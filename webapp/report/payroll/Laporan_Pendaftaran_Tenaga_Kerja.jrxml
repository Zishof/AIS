	<queryString>
		<![CDATA[select
a.mycode as kode,
a.jamsostek,
a.nama,
a.tanggallahir,
a.kelamin as jeniskelamin,
b1.nilai as b1
from pegawai a
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GP' and cc.bulan = $P{bulan} and cc.tahun = $P{tahun}
) b1 on (b1.pegawai = a.id)

order by a.nama]]>
	</queryString>

	<queryString>
		<![CDATA[select
a.id,
a.mycode as nip,
a.nama as nama,
(c.id) as dept,
(c.nama) as nama_dept,
b.nilai

from pegawai a
left join payroll.departemen c on (c.id = a.departemen)
left join (
	select aa.pegawai, to_number(bb.nama,'9999999') as nilai
	from payroll.gaji_tabahan_detail aa
	inner join payroll.gaji_tabahan bb on (aa.gaji_tabahan = bb.id)
	where bb.kode = 'V_NILAI_LEM'
) b on (b.pegawai = a.id)

where c.nama is not null
order by c.nama,a.nama]]>
	</queryString>

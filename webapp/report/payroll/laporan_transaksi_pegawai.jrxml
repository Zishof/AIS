	<queryString>
		<![CDATA[select
	a.satuan_kerja sekolah_id,
	b.tanggal as tanggal,
	a.id,
	a.mycode as nomor_induk,
	a.nama as nama_siswa,
	b31.nama || ' senilai '||b.nilai as deskripsi,

	case when b31.jenistransaksi=1 then b.nilai else 0 end as pemasukan,
	case when b31.jenistransaksi=1 then 0 else b.nilai end as pengeluaran

	from pegawai a
	inner join  payroll.transaksi_pegawai b on (a.id = b.pegawai)
	left join payroll.jenis_transaksi_pegawai b31 on (b31.id = b.jenis_transaksi_pegawai)
	where date(b.tanggal) between date($P{mulai}) and date( $P{sampai})
	and case when $P{siswa} = '' then true else (a.mycode ilike '%'||$P{siswa}||'%' or a.nama ilike '%'||$P{siswa}||'%') end]]>
	</queryString>
	<field name="sekolah_id" class="java.lang.Long"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="id" class="java.lang.Long"/>
	<field name="nomor_induk" class="java.lang.String"/>
	<field name="nama_siswa" class="java.lang.String"/>
	<field name="deskripsi" class="java.lang.String"/>
	<field name="pemasukan" class="java.lang.Double"/>
	<field name="pengeluaran" class="java.lang.Double"/>
	<variable name="saldo" class="java.lang.Double" resetType="Group" resetGroup="siswa" calculation="Sum">
		<variableExpression><![CDATA[$F{pemasukan}-$F{pengeluaran}]]></variableExpression>
	</variable>
	<variable name="pemasukan" class="java.lang.Double" resetType="Group" resetGroup="siswa" calculation="Sum">

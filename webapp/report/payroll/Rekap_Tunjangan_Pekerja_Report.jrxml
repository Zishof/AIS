	<parameter name="bulan_str" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Juni"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2019]]></defaultValueExpression>
	</parameter>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[6]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_biro_uauk" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Drs. H. Yasrizal, M.A"]]></defaultValueExpression>
	</parameter>
	<parameter name="statusKepegawaian" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="statusDosen" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenisTenagaKependidikan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
cc.*,
total_potongan,
((tunjangankinerja*total_potongan)/100.0) as potongan,
tunjangankinerja-((tunjangankinerja*total_potongan)/100.0) as diterima
from
(
	select
	bb.*,
	(jumlah_potongan_terlambat1+jumlah_potongan_terlambat2+jumlah_potongan_terlambat3+jumlah_potongan_terlambat4+
	jumlah_potongan_cepat1+jumlah_potongan_cepat2+jumlah_potongan_cepat3+jumlah_potongan_cepat4+jumlah_potongan_tidak_masuk) as total_potongan
	from
	(
		select
		aa.*,
		(aa.pot_terlambat_1*hari_terlambat_1) jumlah_potongan_terlambat1,
		(aa.pot_terlambat_2*hari_terlambat_2) jumlah_potongan_terlambat2,
		(aa.pot_terlambat_3*hari_terlambat_3) jumlah_potongan_terlambat3,
		(aa.pot_terlambat_4*hari_terlambat_4) jumlah_potongan_terlambat4,
		(aa.pot_cepat_1*hari_cepat_1) jumlah_potongan_cepat1,
		(aa.pot_cepat_2*hari_cepat_2) jumlah_potongan_cepat2,
		(aa.pot_cepat_3*hari_cepat_3) jumlah_potongan_cepat3,
		(aa.pot_cepat_4*hari_cepat_4) jumlah_potongan_cepat4,
		(aa.potongantidakmasuk*hari_tidak_masuk) jumlah_potongan_tidak_masuk
		from
		(
			select
			b.nama,
			b.mycode as nip,
			max(d.nama) as golongan,
			(case when b.tunjangankinerja is null then 0 else b.tunjangankinerja end) tunjangankinerja,
			max(case when c.potongantelat1 is null then 0 else c.potongantelat1 end) as pot_terlambat_1,
			sum(case when a.statusabsensi=1 and (60*a.jumlahterlambat) between 0.1 and c.menittelat1 then 1 else 0 end) as hari_terlambat_1,
			max(case when c.potongantelat2 is null then 0 else c.potongantelat2 end) as pot_terlambat_2,
			sum(case when a.statusabsensi=1 and (60*a.jumlahterlambat) between c.menittelat1+0.1 and c.menittelat2 then 1 else 0 end) as hari_terlambat_2,
			max(case when c.potongantelat3 is null then 0 else c.potongantelat3 end) as pot_terlambat_3,
			sum(case when a.statusabsensi=1 and (60*a.jumlahterlambat) between c.menittelat2+0.1 and c.menittelat3 then 1 else 0 end) as hari_terlambat_3,
			max(case when c.potongantelat4 is null then 0 else c.potongantelat4 end) as pot_terlambat_4,
			sum(case when a.statusabsensi=1 and (60*a.jumlahterlambat) between c.menittelat3+0.1 and c.menittelat4 then 1 else 0 end) as hari_terlambat_4,

			max(case when c.potongancepat1 is null then 0 else c.potongancepat1 end) as pot_cepat_1,
			sum(case when a.statusabsensi=1 and (60*a.jumlahcepatkeluar) between 0.1 and c.menitcepat1 then 1 else 0 end) as hari_cepat_1,
			max(case when c.potongancepat2 is null then 0 else c.potongancepat2 end) as pot_cepat_2,
			sum(case when a.statusabsensi=1 and (60*a.jumlahcepatkeluar) between c.menitcepat1+0.1 and c.menitcepat2 then 1 else 0 end) as hari_cepat_2,
			max(case when c.potongancepat3 is null then 0 else c.potongancepat3 end) as pot_cepat_3,
			sum(case when a.statusabsensi=1 and (60*a.jumlahcepatkeluar) between c.menitcepat2+0.1 and c.menitcepat3 then 1 else 0 end) as hari_cepat_3,
			max(case when c.potongancepat4 is null then 0 else c.potongancepat4 end) as pot_cepat_4,
			sum(case when a.statusabsensi=1 and (60*a.jumlahcepatkeluar) between c.menitcepat3+0.1 and c.menitcepat4 then 1 else 0 end) as hari_cepat_4,

			max(case when c.potongantidakmasuk is null then 0 else c.potongantidakmasuk end) as potongantidakmasuk,
			sum(case when a.statusabsensi not in (1) then 1 else 0 end) as hari_tidak_masuk

			from pegawai b
			left join status_kehadiran_karyawan_harian a on (a.pegawai = b.id)
			left join payroll.detail_jenis_shift_pegawai c on (a.detail_jenis_shift_pegawai = c.id)
			left join employ.golongan d on (b.golongan_pegawai = d.id)

			where a.bulan=$P{bulan} and a.tahun=$P{tahun}
			and case when $P{statusKepegawaian} = -1 then true else b.status_kepegawaian = $P{statusKepegawaian} end
			and case when $P{statusDosen}='Semua' then true when $P{statusDosen}='Dosen' then b.dosen is not null else b.dosen is null end
			and case when $P{jenisTenagaKependidikan} = -1 then true else b.jenis_tenaga_kependidikan = $P{statusKepegawaian} end
			group by b.id
			order by b.nama
		) aa
	) bb
) cc]]>
	</queryString>

	<field name="jumlah_potongan_cepat4" class="java.lang.Double"/>
	<field name="jumlah_potongan_tidak_masuk" class="java.lang.Double"/>
	<field name="total_potongan" class="java.lang.Double"/>
	<field name="potongan" class="java.lang.Double"/>
	<field name="diterima" class="java.lang.Double"/>
	<variable name="potongan_1" class="java.lang.Double" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{potongan}]]></variableExpression>
	</variable>
	<variable name="diterima_1" class="java.lang.Double" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{diterima}]]></variableExpression>
	</variable>

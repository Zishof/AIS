	<queryString>
		<![CDATA[select
a.id,
a.mycode as nip,
a.nama as nama,
max(c.id) as dept,
max(c.nama) as nama_dept,

sum(b.secondjammasuk) secondjammasuk,
sum(b.secondterlambat) secondterlambat,
sum(b.secondcepatkeluar) secondcepatkeluar,
sum(b.secondlemburmasuk) secondlemburmasuk,

sum(case when b.statusabsensi = 1 then 1 else 0 end) as masuk,
sum(case when e.libur = false and f.id is null then 1 else 0 end) as jadwal,
sum(case when e.libur = false and f.id is not null then 1 else 0 end) as libur,
sum(case when b.statusabsensi = 2 and e.libur = false and f.id is null then 1 else 0 end) as alpa,
sum(case when b.statusabsensi = 3 and e.libur = false and f.id is null then 1 else 0 end) as sakit,
sum(case when b.statusabsensi = 4 and e.libur = false and f.id is null then 1 else 0 end) as izin,
sum(case when b.statusabsensi = 6 and e.libur = false and f.id is null then 1 else 0 end) as cuti,
sum(case when b.statusabsensi = 7 and e.libur = false and f.id is null then 1 else 0 end) as cuti_hamil

from pegawai a
left join status_kehadiran_karyawan_harian b on (a.id = b.pegawai)
left join payroll.departemen c on (c.id = a.departemen)
left join payroll.detail_jenis_shift_pegawai d on (d.id = b.detail_jenis_shift_pegawai)
left join payroll.libur_rutin e on (e.id = b.libur_rutin)
left join payroll.libur_nasional f on (f.id = b.libur_nasional)


where 1=1
and b.bulan = $P{bulan}
and b.tahun = $P{tahun}
and a.nama is not null
group by a.id
order by max(c.nama), a.nama]]>
	</queryString>

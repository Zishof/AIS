	<queryString>
		<![CDATA[select
a.id,
a.mycode as nip,
a.nama as nama,
(c.id) as dept,
(c.nama) as nama_dept,
a.tempatlahir,
a.tanggallahir,
a.alamat,
a.telp,
d.nama as agama,
a.kelamin as jeniskelamin,
a.statusperkawinan,
a.jumlahanak,
e.nama as level_jabatan,
a.jamsostek,
a.ditransferke as bank,
f.nama as pendidikan,
a.tanggalmasuk

from pegawai a
left join rab.satuan_kerja c on (c.id = a.satuan_kerja)
left join agama d on (a.agama = d.id)
left join payroll.level_jabatan e on (e.id = a.level_jabatan)
left join employ.pendidikan f on (a.pendidikan = f.id)

where c.nama is not null and a.aktif and a.status_pegawai=1
order by c.nama,a.nama]]>
	</queryString>

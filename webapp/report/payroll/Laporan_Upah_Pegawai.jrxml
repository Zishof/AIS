	<queryString>
		<![CDATA[select
a.mycode as kode,
a.nama,
b.id as dept,
b.nama as nama_dept,
b1.nilai as b1,
b2.nilai as b2,
b3.nilai as b3,
b4.nilai as b4,
b5.nilai as b5,
b6.nilai as b6,
b7.nilai as b7,
b8.nilai as b8,
b9.nilai as b9,
b10.nilai as b10,
b11.nilai as b11,
b12.nilai as b12,
b13.nilai as b13

from pegawai a
inner join payroll.departemen b on (a.departemen = b.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 1 and cc.tahun = $P{tahun}
) b1 on (b1.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 2 and cc.tahun = $P{tahun}
) b2 on (b2.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 3 and cc.tahun = $P{tahun}
) b3 on (b3.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 4 and cc.tahun = $P{tahun}
) b4 on (b4.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 5 and cc.tahun = $P{tahun}
) b5 on (b5.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 6 and cc.tahun = $P{tahun}
) b6 on (b6.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 7 and cc.tahun = $P{tahun}
) b7 on (b7.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 8 and cc.tahun = $P{tahun}
) b8 on (b8.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 9 and cc.tahun = $P{tahun}
) b9 on (b9.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 10 and cc.tahun = $P{tahun}
) b10 on (b10.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 11 and cc.tahun = $P{tahun}
) b11 on (b11.pegawai = a.id)
left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.bulan = 12 and cc.tahun = $P{tahun}
) b12 on (b12.pegawai = a.id)

left join (
	select
	bb.pegawai, aa.nilai
	from payroll.pembayaran_item_gaji_pegawai aa
	inner join payroll.pembayaran_gaji_punya_pegawai bb on (aa.pembayaran_gaji_punya_pegawai = bb.id)
	inner join payroll.pembayaran_gaji cc on (bb.pembayaran_gaji = cc.id)
	where kode = 'GB' and cc.tahun = $P{tahun}
) b13 on (b13.pegawai = a.id)

order by b.nama,a.nama]]>
	</queryString>

				<text><![CDATA[16]]></text>
			</staticText>
			<staticText>
				<reportElement key="staticText-31" x="721" y="29" width="61" height="20" uuid="9bbc2b50-b558-4707-b5a9-84e8401ad0ab"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>

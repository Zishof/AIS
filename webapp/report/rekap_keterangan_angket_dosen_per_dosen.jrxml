		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select x.grup_id,max(x.grup) as grup,
max(x.isi) as isi,
max(x.nama_dosen) as nama_dosen,
x.id_dosen as dosen,
x.id_dosen,
mahasiswa,
max(bobot) as bobot,
max(x.nilai) as nilai,
x.perkuliahan,
max(nama_perkuliahan) as nama_perkuliahan

from(
	select
	b1.id grup_id,
	b1.isi as grup,
	b.id,
	b.isi,
	b.bobot,
	nama_dosen as nama_dosen,
	mahasiswa,
	dosen as id_dosen,
	x.nilai,
	x.perkuliahan,
	x.nama_perkuliahan
	from(
		select
		to_number(checklist_penilaian_dosen,'999999999') as checklist_penilaian_dosen,
		dosen,
		mahasiswa,
		nama_dosen,
		nilai as nilai,
		perkuliahan,
		nama_perkuliahan
		from
		(
			select
			split_part(regexp_split_to_table(x.keterangan,'DATA'),';',1) as checklist_penilaian_dosen,
			x.dosen as dosen,
			x.mahasiswa as mahasiswa,
			x.nama_dosen,
			replace(trim(split_part(split_part(regexp_split_to_table(x.keterangan,';'),'<>',2),'DATA',1)),'___','') as nilai,
			x.perkuliahan,nama_perkuliahan
			from (
				select cc.keterangan,perkuliahan,cc.dosen,(f.nim||' '||f.nama) as mahasiswa,
				(c.nama||' '||b.kelas||' '||(case when b.hari is null then '' else b.hari end)||' '||(case when b.waktu_mulai is null then '' else b.waktu_mulai end)||' '||(case when b.waktu_selesai is null then '' else b.waktu_selesai end)) as nama_perkuliahan,e.nama as nama_dosen
				from
				checklist_baru_penilaian_dosen_oleh_mahasiswa cc
				inner join perkuliahan b on (cc.perkuliahan=b.id)
				inner join matakuliah c on (b.matakuliah=c.id)
				inner join jurusan d on (b.jurusan=d.id)
				inner join dosen e on (e.id = cc.dosen)
				inner join mahasiswa f on (f.id = cc.mahasiswa)
				where b.tahun_ajaran=$P{tahun_akademik}
				and b.semester%2 = (case $P{genapGanjil} when 'Semua' then b.semester%2 when 'Ganjil' then 1 else 0 end)
				and case when $P{jurusan}=-1 then true else b.jurusan=$P{jurusan} end
				and case when $P{fakultas}=-1 then true else d.fakultas=$P{fakultas} end
				and case when $P{dosen}=-1 then true else cc.dosen=$P{dosen} end
				and case when $P{program}='-1' then true else b.program=$P{program} end
			) x
		) a
		where a.checklist_penilaian_dosen is not null and trim(a.checklist_penilaian_dosen) != '' and a.nilai not ilike '%DATA%' and a.nilai is not null and trim(a.nilai) != ''
		and a.checklist_penilaian_dosen not ilike '%<>%'


	) x
	inner JOIN checklist_penilaian_dosen b on x.checklist_penilaian_dosen=b.id
	inner JOIN grup_checklist_penilaian_dosen b1 on b.grup_checklist_penilaian_dosen=b1.id
	where nilai != '___' and nilai is not null
	and (b.aktif or b.aktif is null) and (b1.aktif or b1.aktif is null)
) x
GROUP BY x.id_dosen,x.grup_id,x.perkuliahan,mahasiswa,x.id
order by x.id_dosen,x.grup_id,x.perkuliahan,mahasiswa,x.id ]]>
	</queryString>

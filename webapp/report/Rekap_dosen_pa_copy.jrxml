		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="angkatan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2010]]></defaultValueExpression>
	</parameter>
	<parameter name="current_ta" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2016/2017"]]></defaultValueExpression>
	</parameter>
	<parameter name="current_semester" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Ganjil"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String"/>
	<parameter name="status" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select m.dosen as dosen_id,m.nim,m.nama,d.nama as dosen,j.nama as jur,f.nama as fak,
m.tahunangkatan, b2.nama as status_mahasiswa,m.kelamin

from mahasiswa m
left join dosen d on m.dosen = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (m.id=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where
case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{dosen} = -1 then true else m.dosen = $P{dosen} end
and case when $P{mahasiswa} = -1 then true else m.id = $P{mahasiswa} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end

order by m.dosen,j.nama,m.nim ]]>
	</queryString>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rekap_angket_dosen_per_dosen_subreport" language="groovy" pageWidth="555" pageHeight="802" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="5631bd41-2684-473e-9c97-784d7081b04a">
	<property name="ireport.zoom" value="1.464100000000003"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="checklist" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2015/2016"]]></defaultValueExpression>
	</parameter>
	<parameter name="genapGanjil" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.isi,
bobot,
sum(case when x.nilai=1 then bobot else 0 end) as "nilai 1",
sum(case when x.nilai=2 then bobot else 0 end) as "nilai 2",
sum(case when x.nilai=3 then bobot else 0 end) as "nilai 3",
sum(case when x.nilai=4 then bobot else 0 end) as "nilai 4",
sum(case when x.nilai=5 then bobot else 0 end) as "nilai 5"

from checklist_penilaian_dosen_oleh_mahasiswa x
inner JOIN checklist_penilaian_dosen b on x.checklist_penilaian_dosen=b.id
where x.dosen=$P{dosen}
and b.grup_checklist_penilaian_dosen=$P{checklist}
and x.tahun_akademik=( case $P{tahun_akademik} when 'Semua' then x.tahun_akademik else $P{tahun_akademik} end)
and x.semester%2 = (case $P{genapGanjil} when 'Semua' then x.semester%2 when 'Ganjil' then 1 else 0 end)
and (b.aktif or b.aktif is null or cs.aktif or cs.aktif is null)
GROUP BY b.id
order by
case
when trim(b.isi) ~ '^[0-9]+' then substring(trim(b.isi) from '^[0-9]+')::integer
else 2147483647
end,
lower(trim(b.isi)),b.id
]]>
	</queryString>
	<field name="isi" class="java.lang.String"/>
	<field name="bobot" class="java.lang.Double"/>
	<field name="nilai 1" class="java.lang.Double"/>
	<field name="nilai 2" class="java.lang.Double"/>
	<field name="nilai 3" class="java.lang.Double"/>
	<field name="nilai 4" class="java.lang.Double"/>
	<field name="nilai 5" class="java.lang.Double"/>

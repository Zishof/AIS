<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="LaporanAbsensi"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="perkuliahan" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(6)]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="tampil_nilai" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="kaprodi" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nip" isForPrompting="false" class="java.lang.String"/>
	<parameter name="tanggal" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select 

((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 1)) as p1,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 2)) as p2,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 3)) as p3,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 4)) as p4,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 5)) as p5,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 6)) as p6,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 7)) as p7,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 8)) as p8,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 9)) as p9,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 10)) as p10,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 11)) as p11,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 12)) as p12,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 13)) as p13,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 14)) as p14,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 15)) as p15,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and cc.pertemuan_ke = 16)) as p16,

((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and ff.nama = 'Tugas')) as Tugas,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and ff.nama = 'UTS')) as UTS,
((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.mahasiswa = e.id and cc.perkuliahan = a.id and ff.nama = 'UAS')) as UAS,

e.nim AS nim,
e.nama AS nama,
c.nama as nama_dosen1,
i.nama as nama_dosen2,
d.nama as nama_matakuliah,
cc.nama as ruang,
d.sks,
(case (a.semester % 2) when 0 then 'Genap' else 'Ganjil' end) AS jenis_semester,
a.tahun_ajaran AS tahun_ajaran,
h.nama AS fakultas,
a.kelas,
g.nama as nama_jurusan

from perkuliahan a
left join detailperkuliahan b on (a.id = b.perkuliahan)
left join dosen c on (c.id = a.dosen1)
left join matakuliah d on (d.id = a.matakuliah)
left join mahasiswa e on b.mahasiswa = e.id 
left join jurusan g on g.id = a.jurusan 
left join fakultas h on g.fakultas = h.id 
left join ruang cc on (a.ruang = cc.id)
left join dosen i on (i.id = a.dosen2)

where a.id = $P{perkuliahan}
and b.persetujuan = 1
-- group by e.id
order by e.nim]]></queryString>


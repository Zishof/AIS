			</staticText>
			<staticText>
				<reportElement key="staticText-19" x="752" y="29" width="30" height="20" uuid="94371bfa-ae48-4859-8dfe-c4d1604e3e39"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">

				<text><![CDATA[KET.]]></text>
			</staticText>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-17" x="3" y="0" width="230" height="20" uuid="4a46042f-53bb-4cc5-bb22-013893a97d77"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>

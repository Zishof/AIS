<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rekap_data_pmdk" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="2"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="tahunakademik" class="java.lang.Integer"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.nama, a.no_registrasi,a.asal_sma,a.tempat_lahir,
a.tanggal_lahir,j.nama as jurusan

from biodata_calon_mahasiswa a
left join jurusan j on a.prodi_1 = j.id

where jenis_seleksi=4
and a.tahun=$P{tahunakademik}

order by a.no_registrasi]]>
	</queryString>
	<field name="nama" class="java.lang.String"/>
	<field name="no_registrasi" class="java.lang.String"/>
	<field name="asal_sma" class="java.lang.String"/>
	<field name="tempat_lahir" class="java.lang.String"/>
	<field name="tanggal_lahir" class="java.sql.Date"/>
	<field name="jurusan" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="77" splitType="Stretch">
			<staticText>
				<reportElement key="staticText-1" x="67" y="13" width="468" height="22"/>
				<textElement textAlignment="Center">
					<font size="14"/>
				</textElement>
				<text><![CDATA[REKAPITULASI PESERTA PMDK UIN SYARIF HIDAYATULLAH]]></text>
			</staticText>
			<textField>
				<reportElement key="staticText-2" x="67" y="35" width="468" height="22"/>
				<textElement textAlignment="Center" markup="none">
					<font size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["TAHUN "+$P{tahunakademik}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement key="line-1" x="0" y="70" width="535" height="1"/>
				<graphicElement>
					<pen lineWidth="2.0" lineStyle="Double"/>
				</graphicElement>
			</line>
			<image>
				<reportElement key="image-1" x="6" y="0" width="67" height="70"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="26" splitType="Stretch">

	<queryString>
		<![CDATA[select
c.id as id_mahasiswa,
c.nim

from mahasiswa c
where c.tahunangkatan = $P{tahunangkatan}
and c.jurusan = $P{jurusan}

order by nim]]>
	</queryString>

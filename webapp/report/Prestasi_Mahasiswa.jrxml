			<textField>
				<reportElement x="-1" y="219" width="535" height="19" uuid="d007bf09-8121-479e-9034-de7ed8f45730"/>
				<box leftPadding="0"/>
				<textElement verticalAlignment="Middle">
					<font size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["1. IDENTITAS DIRI "]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="-1" y="124" width="535" height="46" uuid="165f7d58-1dc2-48a6-9cf9-67a4a4f1586b"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Surat Keterangan Pendamping Ijazah mengacu pada Kerangka Kualifikasi Nasional Indonesia (KKNI) tentang pengakuan Studi, Ijazah dan Gelar pendidikan tinggi. Tujuan dari SKPI ini adalah menjadi dokumen yang menyatakan kemampuan kerja, penguasaan pengetahuan, dan sikap/moral pemegangnya. "]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="-1" y="170" width="535" height="48" uuid="86bfc855-1e0e-4e75-8047-5cdcf20b362d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font size="10" isBold="false" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["This Diploma Supplement refers to Indonesia qualification framework on the recognition of studies, Diplomas dan Degree in Higher Education. The purpose of the supplement is to provide a description of the nature, level, context and status of the studies that were pursued and successfully completed by the individual named on the original qualification to which this supplement is appended"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="11" y="238" width="523" height="14" uuid="d8ca1421-ba00-4c4a-84ab-0653c4a8e014"/>
				<box leftPadding="0"/>
				<textElement verticalAlignment="Top">
					<font size="10" isBold="false" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["PERSONAL INFORMATION"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="135" y="-15" width="400" height="19" uuid="53dcafbe-4d01-448d-ae58-cce920828dea"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">

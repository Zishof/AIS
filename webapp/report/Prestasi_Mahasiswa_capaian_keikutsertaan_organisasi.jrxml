	<queryString>
		<![CDATA[select
a.nama,
a.tempatlahir,
a.tanggallahir,
a.nim,
a.tanggal_masuk,
a.tanggal_lulus,
b.gelar,
b.nama as jurusan,
a.no_ijazah1,
c.mulai,c.sampai,c.tahun, c.keterangan,
d.nama as nama_organisasi,
e.nama as jabatan,
a.jurusan as jurusan_id,
a.tahunlulus
from mahasiswa a
inner join jurusan b on (a.jurusan=b.id)
inner join organisasi_intra_kampus_punya_mahasiswa c on (c.mahasiswa=a.id)
inner join organisasi_intra_kampus d on (c.organisasi_intra_kampus=d.id)
inner join jabatan_organisasi_intra_kampus e on (c.jabatan_organisasi_intra_kampus=e.id)
where a.id=$P{mahasiswa_id}
and c.persetujuan=true]]>
	</queryString>

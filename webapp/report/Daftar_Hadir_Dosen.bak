		<defaultValueExpression ><![CDATA["Prof. DR. Yudha Bhakti. SH. MH"]]></defaultValueExpression>
	</parameter>
	<parameter name="pembantu_dekan" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Nursva. A. SH. MH."]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="genapGanjil" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl_m" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl_s" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(-1L)]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nama_fakultas" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_jurusan" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_semester" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["2010/2011"]]></defaultValueExpression>
	</parameter>
	<parameter name="program" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Reguler"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
a.waktu_mulai,
a.waktu_selesai,
UPPER(b.nama) as mk,
UPPER(c.nama) as dosen,
a.semester,
a.kelas as kelas,
b.sks,
f.nama as ruang,
e.nama as fakultas,
d.nama as jurusan,
a.tahun_ajaran
from perkuliahan a
left join matakuliah b on (a.matakuliah = b.id)
left join dosen c on (a.dosen1 = c.id)
left join jurusan d on (d.id = a.jurusan)
left join fakultas e on (e.id = d.fakultas)
left join ruang f on (f.id = a.ruang)

where 
a.hari = $P{hari}
and a.program = $P{program}
and a.tahun_ajaran = $P{tahun_akademik}
and a.semester % 2 = (case $P{jenis_semester} when 'Genap' then 0 else 1 end)
and d.id = (case $P{jurusan} when -1 then d.id else $P{jurusan} end)
and e.id = (case $P{fakultas} when -1 then e.id else $P{fakultas} end)  
order by 
CAST(a.waktu_mulai as double precision) asc, 
CAST(a.waktu_selesai as double precision) asc, c.nama]]></queryString>


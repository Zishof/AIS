<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rekap_angket_dosen_per_dosen_subreport" language="groovy" pageWidth="802" pageHeight="555" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="772" leftMargin="30" rightMargin="0" topMargin="0" bottomMargin="0" uuid="6503a762-338a-42bb-8f61-069f6d16c743">
	<property name="ireport.zoom" value="2.3579476910000063"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="checklist" class="java.lang.Long" isForPrompting="false"/>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false"/>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false"/>
	<parameter name="genapGanjil" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="grupKuesionerUmum" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jumlah_pilihan_checklist_penilaian_dosen_oleh_mahasiswa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["5"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tbmuser_dinilai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="diperuntukkan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.isi,
sum(case when x.nilai=1 then 1 else 0 end) as "nilai 1",
sum(case when x.nilai=2 then 1 else 0 end) as "nilai 2",
sum(case when x.nilai=3 then 1 else 0 end) as "nilai 3",
sum(case when x.nilai=4 then 1 else 0 end) as "nilai 4",
sum(case when x.nilai=5 then 1 else 0 end) as "nilai 5",
sum(case when x.nilai=1 or x.nilai=2 or x.nilai=3 or x.nilai=4 or x.nilai=5 then 1 else 0 end) as "total",
bb.isi as nama_grup,
aa.nama as sub_grup

from checklist_hasil_penilaian_umum x
inner JOIN checklist_penilaian_umum b on x.checklist_penilaian_umum=b.id
inner JOIN grup_checklist_penilaian_umum bb on b.grup_checklist_penilaian_umum=bb.id
left join sub_grup_checklist_penilaian_umum aa on (b.sub_grup_checklist_penilaian_umum=aa.id)
where 1=1
and b.grup_checklist_penilaian_umum=$P{checklist}
and x.tahun_akademik=$P{tahun_akademik}
and x.semesterstr = $P{genapGanjil}
and case when $P{tbmuser_dinilai}  = '-1' then x.tbmuser_dinilai is null else x.tbmuser_dinilai=$P{tbmuser_dinilai} end
and (b.aktif or b.aktif is null) and (bb.aktif or bb.aktif is null)
and case when $P{diperuntukkan}='Semua' then true else bb.diperuntukkan=$P{diperuntukkan} end
GROUP BY bb.id,aa.id,b.id
order by aa.nama,coalesce(b.nomor_urut, 2147483647),b.isi,b.id]]>
	</queryString>

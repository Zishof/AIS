	((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.dosen = e.id and cc.perkuliahan = a.id and ff.nama = 'Tugas')) as Tugas,
	((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.dosen = e.id and cc.perkuliahan = a.id and ff.nama = 'UTS')) as UTS,
	((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.dosen = e.id and cc.perkuliahan = a.id and ff.nama = 'UAS')) as UAS,

	'Dosen 9' AS nim,
	e.nama AS nama,
	c.nama as nama_dosen1,
c.nidn as nidn_dosen1,
i.nama as nama_dosen2,
	d.nama as nama_matakuliah,
	cc.nama as ruang,
	d.sks,
	(case (a.semester % 2) when 0 then 'Genap' else 'Ganjil' end) AS jenis_semester,
	a.tahun_ajaran AS tahun_ajaran,
	h.nama AS fakultas,
	a.kelas,
	g.nama as nama_jurusan,
	a.semester,
	(case when ii.code is null then hh.nip else ii.code end) as nip_kaprodi,
	(case when ii.nama is null then hh.nama else ii.nama end) as nama_kaprodi,
a.hari,
(a.waktu_mulai || ' s.d ' || a.waktu_selesai) as jam,
gg.nama as jenjang,
g.nama as jurusan,
h.nama as fakultas,
hhh.nama as perguruan_tinggi


	from perkuliahan a
	left join matakuliah d on (d.id = a.matakuliah)
	inner join dosen e on a.dosen9 = e.id
	left join jurusan g on g.id = a.jurusan
	left join fakultas h on g.fakultas = h.id
	left join perguruan_tinggi hhh on hhh.id = h.perguruan_tinggi
	left join jenjang gg on gg.id = g.jenjang
	left join ruang cc on (a.ruang = cc.id)
	left join dosen c on (c.id = a.dosen1)
	left join dosen i on (i.id = a.dosen2)
	left join (
		select aa.nama, aa.nip, aa.jurusan
		from staff aa
		left join jabatan bb on (aa.jabatan = bb.id)
		where bb.nama ilike '%kaprodi%'
	) hh on (hh.jurusan = e.jurusan)
	left join dosen ii on (g.kaprodi = ii.id)

	where a.id = $P{perkuliahan}
)



union all

(
	select


((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 1)) as tgl1,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 2)) as tgl2,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 3)) as tgl3,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 4)) as tgl4,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 5)) as tgl5,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 6)) as tgl6,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 7)) as tgl7,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 8)) as tgl8,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 9)) as tgl9,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 10)) as tgl10,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 11)) as tgl11,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 12)) as tgl12,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 13)) as tgl13,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 14)) as tgl14,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 15)) as tgl15,
((select cc.tanggal from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 16)) as tgl16,


	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 1)) as p1,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 2)) as p2,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 3)) as p3,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 4)) as p4,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 5)) as p5,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 6)) as p6,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 7)) as p7,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 8)) as p8,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 9)) as p9,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 10)) as p10,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 11)) as p11,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 12)) as p12,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 13)) as p13,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 14)) as p14,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 15)) as p15,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 16)) as p16,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 17)) as p17,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 18)) as p18,
	((select substr(max(cc.absensi),position(e.id||',' in max(cc.absensi))+length(e.id||',')+2,1) from pertemuan cc where cc.perkuliahan = a.id and cc.pertemuan_ke = 19)) as p19,

	((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.dosen = e.id and cc.perkuliahan = a.id and ff.nama = 'Tugas')) as Tugas,
	((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.dosen = e.id and cc.perkuliahan = a.id and ff.nama = 'UTS')) as UTS,
	((select max(bb.kode) from statuskehadiran aa inner join statusabsensi bb on (aa.statusabsensi = bb.id) inner join pertemuan cc on (aa.pertemuan = cc.id) inner join status_pertemuan ff on (cc.status_pertemuan = ff.id) where aa.dosen = e.id and cc.perkuliahan = a.id and ff.nama = 'UAS')) as UAS,

	'Dosen 10' AS nim,
	e.nama AS nama,
	c.nama as nama_dosen1,
c.nidn as nidn_dosen1,
i.nama as nama_dosen2,
	d.nama as nama_matakuliah,
	cc.nama as ruang,
	d.sks,
	(case (a.semester % 2) when 0 then 'Genap' else 'Ganjil' end) AS jenis_semester,
	a.tahun_ajaran AS tahun_ajaran,
	h.nama AS fakultas,
	a.kelas,
	g.nama as nama_jurusan,
	a.semester,
	(case when ii.code is null then hh.nip else ii.code end) as nip_kaprodi,
	(case when ii.nama is null then hh.nama else ii.nama end) as nama_kaprodi,
a.hari,
(a.waktu_mulai || ' s.d ' || a.waktu_selesai) as jam,
gg.nama as jenjang,
g.nama as jurusan,
h.nama as fakultas,
hhh.nama as perguruan_tinggi


	from perkuliahan a
	left join matakuliah d on (d.id = a.matakuliah)
	inner join dosen e on a.dosen10 = e.id
	left join jurusan g on g.id = a.jurusan
	left join fakultas h on g.fakultas = h.id
	left join perguruan_tinggi hhh on hhh.id = h.perguruan_tinggi
	left join jenjang gg on gg.id = g.jenjang
	left join ruang cc on (a.ruang = cc.id)
	left join dosen c on (c.id = a.dosen1)
	left join dosen i on (i.id = a.dosen2)
	left join (
		select aa.nama, aa.nip, aa.jurusan
		from staff aa
		left join jabatan bb on (aa.jabatan = bb.id)
		where bb.nama ilike '%kaprodi%'
	) hh on (hh.jurusan = e.jurusan)
	left join dosen ii on (g.kaprodi = ii.id)

	where a.id = $P{perkuliahan}
)]]>
	</queryString>
	<field name="tgl1" class="java.util.Date"/>

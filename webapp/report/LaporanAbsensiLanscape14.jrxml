	inner join dosen e on a.dosen2 = e.id
	left join jurusan g on g.id = a.jurusan
	left join fakultas h on g.fakultas = h.id
	left join perguruan_tinggi hhh on hhh.id = h.perguruan_tinggi
	left join jenjang gg on gg.id = g.jenjang
	left join ruang cc on (a.ruang = cc.id)
	left join dosen c on (c.id = a.dosen1)
	left join dosen i on (i.id = a.dosen2)

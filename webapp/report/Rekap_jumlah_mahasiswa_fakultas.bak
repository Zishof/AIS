	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="fakultas" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select count(a.id),b.nama,c.nama as fak,cwe.jc


from
mahasiswa a left join jurusan b on a.jurusan = b.id
left join fakultas c on b.fakultas = c.id,

(select count(a.id) as jc from mahasiswa a 
where a.kelamin='Perempuan') as cwe

where
c.id=4

group by b.nama,c.nama,cwe.jc]]></queryString>

	<field name="count" class="java.lang.Long"/>
	<field name="nama" class="java.lang.String"/>
	<field name="fak" class="java.lang.String"/>
	<field name="jc" class="java.lang.Long"/>


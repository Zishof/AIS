		<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
bool_or(a.lulus) as lulus,
max(c.nama) as nama_mahasiswa,
max(e.nama) as nama_fakultas,
max(c.waktu_kuliah) as waktu_kuliah,
max(c.nim) as nim,
max(d.nama) as nama_jurusan,
(14-$P{semester}) as sisa_masa_studi,
max(f.kode) as kode_matakuliah,
max(f.nama) as nama_matakuliah,
max(f.sks) as sks,
max(a.total_nilai) as total_nilai,
min(a.nilai_huruf) as nilai_huruf,
max(a.nilai_ip) as nilai_ipk,
max(a.tahunakademik) as tahun_ajaran,

max(c.tahunangkatan)  as tahunangkatan,
max(d1.nama) as dosen_pa,
max(d1.code) as nip_dosen_pa,
max(c.program) as program,
max(case when i.code is null then h.nip else i.code end) as nip_kaprodi,
max(case when i.nama is null then h.nama else i.nama end) as nama_kaprodi,
(select max(catatan_khs) from krs_mahasiswa cc where cc.mahasiswa=max(a.mahasiswa) and case when $P{tahapan}<=0 then cc.semester=$P{semester} else cc.tahapan=$P{tahapan} end) as catatan

from detailperkuliahan a
left join perkuliahan b on (a.perkuliahan = b.id)
left join kurikulum_punya_matakuliah kur on (b.kurikulum_punya_matakuliah = kur.id)
left join mahasiswa c on (a.mahasiswa = c.id)
left join dosen d1 on (c.dosen = d1.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join
(
	select aa.id as id,
	max(case when cc.id is null then aa.kode else cc.kode end) as kode,
	max(case when cc.id is null then aa.nama else cc.nama end) as nama,
	max(case when cc.id is null then aa.sks else cc.sks end) as sks,
	max(bb.khusus_untuk_nim) as khusus_untuk_nim
	from matakuliah aa
	left join matakuliah_ekivalen bb on (aa.id = bb.matakuliah_ekivalen)
	left join matakuliah cc on(bb.matakuliah = cc.id) where (aa.extrakulikuler is null or aa.extrakulikuler = false)
	group by aa.id
) f on (f.id = b.matakuliah or a.matakuliah_konversi = f.id)
left join (
	select aa.nama, aa.nip, aa.jurusan
	from staff aa
	left join jabatan bb on (aa.jabatan = bb.id)
	where bb.nama ilike '%kaprodi%'
) h on (h.jurusan = c.jurusan)
left join dosen i on (d.kaprodi = i.id)
where a.mahasiswa = $P{mahasiswa}
and (f.khusus_untuk_nim is null or f.khusus_untuk_nim='' or f.khusus_untuk_nim ilike '%'||c.nim||'%')
and a.persetujuan = 1 and a.ikuti_perkuliahan is null
and a.ikuti_perkuliahan is null
and a.total_nilai >= (case when $P{nilai_0_tidak_masuk_dalam_perhitungan_ipk} = 'tidak aktif' then  0.0 else $P{nilai_minimal_tidak_masuk_dalam_perhitungan_ipk}::double precision end )
and a.nilai_huruf != $P{nilai_huruf_yg_tidak_masuk_perhitungan_ip}
and (case when $P{tahapan}<=0 then a.semester=$P{semester} else true end)
and (case when $P{tahapan}<=0 then true else (a.tahap=$P{tahapan}) end)
and case when $P{semester_pendek} is null then b.status_semesterpendek is null else b.status_semesterpendek = $P{semester_pendek} end
and case when $P{remedial} then b.merupakanremedial = true else b.merupakanremedial = false or b.merupakanremedial is null end
group by f.id]]>
	</queryString>
	<field name="nama_mahasiswa" class="java.lang.String"/>
	<field name="nama_fakultas" class="java.lang.String"/>
	<field name="waktu_kuliah" class="java.lang.String"/>

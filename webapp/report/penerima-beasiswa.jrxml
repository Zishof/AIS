<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="penerima-beasiswa" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_beasiswa" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="logo1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_jurusan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Prodi"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_fakultas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Fakultas"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select max(d.nama) as nama, max(c.nama) as jurusan, "count"(a."id"),e.nama as beasiswa,e.tahun

FROM mahasiswa_daftar_beasiswa a

left JOIN mahasiswa b on a.mahasiswa=b."id"

left join jurusan c on b.jurusan=c."id"

left join fakultas d on c.fakultas=d."id"
left JOIN beasiswa e on a.beasiswa=e."id"

WHERE a.beasiswa=$P{id_beasiswa}


GROUP BY c.id,d.id,e.nama,e.tahun]]>
	</queryString>
	<field name="nama" class="java.lang.String"/>
	<field name="jurusan" class="java.lang.String"/>
	<field name="count" class="java.lang.Long"/>
	<field name="beasiswa" class="java.lang.String"/>
	<field name="tahun" class="java.lang.Integer"/>

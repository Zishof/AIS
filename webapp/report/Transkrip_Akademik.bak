		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="barcode" isForPrompting="false" class="java.lang.String"/>
	<parameter name="foto" isForPrompting="false" class="java.io.InputStream"/>
	<queryString><![CDATA[select
c.nama as nama_mahasiswa,
e.nama as nama_fakultas,
c.waktu_kuliah,
c.nim,
c.tempatlahir || ', ' || c.tanggallahir as tanggal_lahir,
c.kelamin,
g.nama as jenjang,
d.nama as nama_jurusan,
f.kode as kode_matakuliah,
f.nama as nama_matakuliah,
f.sks,
a.nilai_huruf,
a.nilai_ip as nilai_ipk,
(select sum(aa.sks) as kumulatifSKS from matakuliah aa left join perkuliahan bb on (aa.id = bb.matakuliah) left join detailperkuliahan cc on (cc.perkuliahan = bb.id or aa.id = cc.matakuliah_konversi)  where cc.mahasiswa = c.id) as kumulatifSKS,
(select sum(cc.nilai_ip*aa.sks)/sum(aa.sks) as kumulatifIPK from  matakuliah aa left join perkuliahan bb on (aa.id = bb.matakuliah) left join detailperkuliahan cc on (cc.perkuliahan = bb.id or aa.id = cc.matakuliah_konversi)  where cc.mahasiswa = c.id) as nilaiIPKTotal,
c.tanggal_lulus, l.judul

from mahasiswa c 
left join skripsi l on (c.id = l.mahasiswa)
left join detailperkuliahan a  on (a.mahasiswa = c.id)
left join perkuliahan b on (a.perkuliahan = b.id)
left join jurusan d on (c.jurusan = d.id)
left join fakultas e on (e.id = d.fakultas)
left join matakuliah f on (f.id = b.matakuliah)
left join jenjang g on (g.id = c.jenjang)
where a.mahasiswa = $P{mahasiswa}]]></queryString>


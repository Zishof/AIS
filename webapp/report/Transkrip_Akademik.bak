	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(145981)]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["12 Januari 2009"]]></defaultValueExpression>
	</parameter>
	<parameter name="dekan" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>

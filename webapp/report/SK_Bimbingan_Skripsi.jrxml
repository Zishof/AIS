	<queryString>
		<![CDATA[select b.nama,b.nim,a.semester,a.tahun_akademik,b.tempatlahir,b.alamat,b.tanggallahir,a.keterangan as alasan, c.nama as nama_jurusan, d.nama as nama_fakultas, f.nama as nama_dosen, b.nama as nama_mahasiswa, i.nama as nama_kaprodi, i.mycode as nip_kaprodi, a.judul, a.tanggalakhirbimbingan, a.tanggalawalbimbingan, j.nama as pudek, j.mycode as nip_pudek,aa.nama format_nilai_proposal_skripsi
from mahasiswa_request_tugas_akhir a
left join format_nilai_proposal_skripsi aa on (a.format_nilai_proposal_skripsi = aa.id)
inner join mahasiswa b on (a.mahasiswa = b.id)
inner join jurusan c on (b.jurusan = c.id)
inner join fakultas d on (c.fakultas = d.id)
left join dosen f on (f.id = b.dosen)
left join dosen i on (c.kaprodi = i.id)

left join dosen j on (d.pudek1 = j.id)

where a.id = $P{id}]]>
	</queryString>

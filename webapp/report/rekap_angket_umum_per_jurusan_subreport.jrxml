	<queryString>
		<![CDATA[select b.isi,
sum(case when x.nilai=1 then 1 else 0 end) as "nilai 1",
sum(case when x.nilai=2 then 1 else 0 end) as "nilai 2",
sum(case when x.nilai=3 then 1 else 0 end) as "nilai 3",
sum(case when x.nilai=4 then 1 else 0 end) as "nilai 4",
sum(case when x.nilai=5 then 1 else 0 end) as "nilai 5",
sum(case when x.nilai=1 or x.nilai=2 or x.nilai=3 or x.nilai=4 or x.nilai=5 then 1 else 0 end) as "total",
j.id as jurusan,
f.id as fakultas,
j.nama as nama_jurusan,
f.nama as nama_fakultas,
bb.isi as nama_grup

from checklist_hasil_penilaian_umum x
left JOIN checklist_penilaian_umum b on x.checklist_penilaian_umum=b.id
left JOIN grup_checklist_penilaian_umum bb on b.grup_checklist_penilaian_umum=bb.id
left join mahasiswa m on (m.id=x.mahasiswa)
left join dosen m1 on (m1.id=x.dosen)
left join tbmuser m2 on (m2.userid=x.tbmuser)
left join jurusan j on (j.id = m.jurusan or j.id = m1.jurusan or j.id = m2.jurusan)
left join fakultas f on (f.id=j.fakultas)
where 1=1
and b.grup_checklist_penilaian_umum=$P{checklist}
and x.tahun_akademik=$P{tahun_akademik}
and x.semesterstr = $P{genapGanjil}
and (b.aktif or b.aktif is null) and (bb.aktif or bb.aktif is null)
and case when $P{jurusan}=-1 then true else m.jurusan=$P{jurusan} end
and case when $P{fakultas}=-1 then true else j.fakultas=$P{fakultas} end
and (b.aktif or b.aktif is null)
and (bb.aktif or bb.aktif is null)
and x.tbmuser_dinilai is null
and case when $P{diperuntukkan}='Semua' then true else bb.diperuntukkan=$P{diperuntukkan} end
GROUP BY bb.id,b.id,j.id,f.id
order by f.id,j.id,b.isi]]>
	</queryString>

	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="fakultas" isForPrompting="false" class="java.lang.String"/>
	<parameter name="logo" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select m.nim,m.nama,d.nama as dosen,j.nama as jur,f.nama as fak

from
dosen_pembimbing_akademik dpa
left join dosen d on dpa.dosen = d.id

left join mahasiswa m on dpa.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where f.nama = $P{fakultas}

order by j.nama,m.nim]]></queryString>

	<field name="nim" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="dosen" class="java.lang.String"/>
	<field name="jur" class="java.lang.String"/>
	<field name="fak" class="java.lang.String"/>


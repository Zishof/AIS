	</parameter>
	<queryString>
		<![CDATA[SELECT
MAX(c.nama) as jenis_penyakit,
sum(case when date(a.tanggal) between date($P{mg1}) and date($P{mg1_1}) then 1 else 0 end) as minggu1,
sum(case when date(a.tanggal) between date($P{mg2}) and date($P{mg2_1}) then 1 else 0 end) as minggu2,
sum(case when date(a.tanggal) between date($P{mg3}) and date($P{mg3_1}) then 1 else 0 end) as minggu3,
sum(case when date(a.tanggal) between date($P{mg4}) and date($P{mg4_1}) then 1 else 0 end) as minggu4,
sum(case when date(a.tanggal) between date($P{mg5}) and date($P{mg5_1}) then 1 else 0 end) as minggu5,
count(a.id) as jumlah


from diagnosa_penyakit a
inner join pasien cc on (a.pasien = cc.id and cc.jenis_pasien = $P{jenis_pasien})
inner join jenis_penyakit c on (c.id = a.jenis_penyakit)
where date(a.tanggal) between date($P{mg1}) and  date($P{mg5_1})
and a.apakah_menular = $P{menular}
and a.instalasi = $P{instalasi}
and c.id is not null
group by c.id
order by jumlah desc
limit 10;]]>
	</queryString>

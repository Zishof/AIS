	</parameter>
	<parameter name="statusPerkawinan" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2011]]></defaultValueExpression>
	</parameter>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[6]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
trim(a.kode) as kode_pasien,
trim(a.nama) as nama_pasien,
a.tanggal_lahir,
a.jenis_kelamin,
(trim(a.alamat) || (case b1.nama when b1.nama then ' ' || b1.nama else '' end) || (case b.nama when b.nama then ' ' || b.nama else '' end) || (case c.nama when c.nama then ' ' || c.nama else '' end) || (case d.nama when d.nama then ' ' || d.nama else '' end)) as alamat,
trim((case a.no_hp when a.no_hp then ' ' || a.no_hp || ' ' else '' end) || (case a.no_telp when a.no_telp then ' ' || a.no_telp || ' ' else '' end)) as telp,
a1.nama as agama,
a.pekerjaan,
a2.nama as pendidikan,
to_number(to_char(current_timestamp,'YYYY'),'9999') - to_number(to_char(a.tanggal_lahir,'YYYY'),'9999') as umur,
a3.nama as jenis_pasien,
a.tanggal_registrasi

from pasien a
left join agama a1 on (a.agama = a1.id)
left join pendidikan a2 on (a.pendidikan = a2.id)
left join jenis_pasien a3 on (a.jenis_pasien = a3.id)
left join kelurahan b1 on (a.kelurahan = b1.id)
left join kecamatan b on (a.kecamatan = b.id)
left join kota c on (a.kota = c.id)
left join propinsi d on (a.propinsi = d.id)
where a.kode is not null
and to_number(to_char(a.tanggal_registrasi,'MM'),'9999999') = $P{bulan}
and to_number(to_char(a.tanggal_registrasi,'YYYY'),'9999999') = $P{tahun}
and a.kode ilike $P{mr}
and a.nama ilike $P{nama}
and (d.nama ilike $P{alamat} or c.nama ilike $P{alamat} or c.nama ilike $P{alamat}
or b.nama ilike $P{alamat} or b1.nama ilike $P{alamat} or a.alamat ilike $P{alamat})
and (a.no_hp ilike $P{telp} or a.no_telp ilike $P{telp})

and case when $P{jenisKelamin} = '' then true else a.jenis_kelamin = $P{jenisKelamin} end
and case when $P{pekerjaan} = '' then true else a.pekerjaan = $P{pekerjaan} end
and case when $P{statusPerkawinan} = '' then true else a.status_perkawinan = $P{statusPerkawinan} end

and case when $P{pendidikan} = -1 then true else a.pendidikan = $P{pendidikan} end
and case when $P{jenisPasien} = -1 then true else a.jenis_pasien = $P{jenisPasien} end
and case when $P{satker} = -1 then true else a.satker = $P{satker} end
and case when $P{asuransi} = -1 then true else a.asuransi = $P{asuransi} end
and case when $P{agama} = -1 then true else a.agama = $P{agama} end

order by a.id asc
-- limit 100]]>
	</queryString>

				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "nama_instansi" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="109" y="-18" width="430" height="33"/>
				<textElement>
					<font size="24" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "dinas_instansi" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="80" width="540" height="29"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["HASIL TINDAKAN "+$P{REPORT_PARAMETERS_MAP}.get( "sumber" )]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<detail>

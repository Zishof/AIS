						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font isBold="true"/>
					</textElement>
					<text><![CDATA[Jenis Detail Tindakan]]></text>
				</staticText>
				<staticText>
					<reportElement x="200" y="40" width="107" height="17"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font isBold="true"/>
					</textElement>
					<text><![CDATA[Nilai Uji]]></text>
				</staticText>
				<staticText>
					<reportElement x="307" y="40" width="129" height="17"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font isBold="true"/>
					</textElement>
					<text><![CDATA[Nilai Normal]]></text>
				</staticText>
				<staticText>
					<reportElement x="436" y="40" width="104" height="17"/>
					<box>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font isBold="true"/>
					</textElement>
					<text><![CDATA[Satuan]]></text>
				</staticText>
				<textField>
					<reportElement x="0" y="0" width="539" height="40"/>
					<textElement>
						<font size="12" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["Hasil  : "+$F{tindakan}+"\nWaktu Uji : "+(new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm:ss", new java.util.Locale("ID","id")).format($F{tanggaltindakan}))]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="178" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="125" width="40" height="20"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Nama]]></text>
			</staticText>
			<textField>
				<reportElement x="40" y="125" width="218" height="20"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[": "+$F{nama_pasien}.trim()]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="307" y="141" width="32" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[MR]]></text>
			</staticText>
			<textField>
				<reportElement x="339" y="141" width="201" height="16"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[": "+($F{kode_pasien} == null ? "" : $F{kode_pasien}.trim())]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="145" width="40" height="20"/>
				<textElement>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="transaksi_item" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="539" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28">
	<property name="ireport.zoom" value="1.128947860107555"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[47L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
aa.nilai,
cc.nama as tindakan,
bb.nama as jenis_uji,
bb.normal,
bb.satuan,
dd.tanggaltindakan,
b.kode,
dd.tanggal,
f.nama as lokasi,
cc.nama as item,
b.nama as nama_pasien,
b.alamat as alamat_pasien,
e.kode as kode_pasien

from transaksi_tindakan_lab_detail aa
inner join tindakan_lab_detail bb on (aa.tindakan_lab_detail = bb.id)
inner join tindakan cc on (cc.id = bb.tindakan)
inner join transaksi_detail dd on (aa.transaksi_detail = dd.id)
inner join transaksi b on (dd.transaksi = b.id)
left join satuan_item d on (cc.satuan = d.id)
left join pasien e on (b.pasien = e.id)
left join lokasi f on (b.lokasi = f.id)
where dd.transaksi = $P{id}
order by cc.nama, bb.nama]]>
	</queryString>
	<field name="kode" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="item" class="java.lang.String"/>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="alamat_pasien" class="java.lang.String"/>
	<field name="kode_pasien" class="java.lang.String"/>
	<field name="nilai" class="java.lang.String"/>
	<field name="tindakan" class="java.lang.String"/>
	<field name="jenis_uji" class="java.lang.String"/>
	<field name="normal" class="java.lang.String"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="tanggaltindakan" class="java.sql.Timestamp"/>

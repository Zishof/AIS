			</staticText>
			<textField>
				<reportElement x="41" y="109" width="217" height="16"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[": "+$F{kode}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="307" y="109" width="32" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Wkt]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy HH.mm.ss">
				<reportElement x="339" y="109" width="200" height="16"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[": "+(new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm:ss", new java.util.Locale("ID","id")).format($F{tanggal}))]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="307" y="125" width="32" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Lokasi]]></text>
			</staticText>
			<textField>
				<reportElement x="339" y="125" width="200" height="16"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[": "+($F{lokasi} == null ? "" : $F{lokasi})]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
				<reportElement x="0" y="-16" width="109" height="96"/>
				<imageExpression><![CDATA["logo.jpg"]]></imageExpression>
			</image>
			<textField>
				<reportElement x="109" y="38" width="430" height="42"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "alamat_instansi" )]]></textFieldExpression>
			</textField>
			<textField>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hpp" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontName="Times New Roman" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontName="Arial" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="Detail" fontName="Arial" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="lokasi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-09-09"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(b.nama) as item,
sum((a.qty+a.qty_bonus)*c.jenis) as qty,
max(b1.nama) as satuan,
max(d.harga_jual) as harga_jual_normal,
max(e.harga_beli) as harga_beli,
max(f.harga_beli) as hpp,
(sum((a.qty+a.qty_bonus)*c.jenis) * max(d.harga_jual)) nilai_jual,
(sum((a.qty+a.qty_bonus)*c.jenis) * max(e.harga_beli)) nilai_beli,
(sum((a.qty+a.qty_bonus)*c.jenis) * max(f.harga_beli)) nilai_hpp,
max(b2.nama) as lokasi

from detail_transaksi a
inner join item b on (a.item = b.id)
left join satuan_item b1 on (b1.id = b.satuan_item)
left join lokasi b2 on (a.lokasi = b2.id)
inner join kode_transaksi c on (a.kode_transaksi = c.id)
left join (
	select
	item,
	max(harga_jual) as harga_jual
	from harga_jual_item
	where kelas_perawatan = 0
	group by item
) d on (d.item = a.item)
left join (
	select
	item,
	(sum(amount)/sum(qty)) as harga_beli
	from detail_transaksi
	where kode_transaksi = 2
	group by item
) e on (e.item = a.item)
left join (
	select
	item,
	(sum(amount)/sum(qty)) as harga_beli
	from detail_transaksi
	where kode_transaksi = 2 or kode_transaksi = 1
	group by item
) f on (f.item = a.item)
where a.lokasi = (case $P{lokasi} when -1 then a.lokasi else $P{lokasi} end) and date(a.tanggal) <= date($P{tgl})
group by a.item
order by item]]>
	</queryString>
	<field name="item" class="java.lang.String"/>
	<field name="qty" class="java.lang.Double"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="harga_jual_normal" class="java.lang.Double"/>
	<field name="harga_beli" class="java.lang.Double"/>
	<field name="hpp" class="java.lang.Double"/>
	<field name="nilai_jual" class="java.lang.Double"/>
	<field name="nilai_beli" class="java.lang.Double"/>
	<field name="nilai_hpp" class="java.lang.Double"/>
	<field name="lokasi" class="java.lang.String"/>
	<variable name="sum_qty" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="nilai_jual" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_jual}]]></variableExpression>
	</variable>
	<variable name="nilai_beli" class="java.lang.Double" calculation="Sum">

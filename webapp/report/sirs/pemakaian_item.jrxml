<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="saldo_awal" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[2L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
c.kode,
c.nama as nama_barang,
a.jumlah,
a.stok,
a.stokmenjadi,
e.nama as satuan,
(case when b.disetujui_oleh = b.disetujui_oleh then 'Telah Disetujui oleh ' || g.nama || ' pada tanggal ' || to_char(b.tanggal_persetujuan,'DD-MM-YYYY') else 'Belum disetujui' end) as status_persetujuan,
b.kode as kd,
h.nama as lokasi,
a.harga,
(a.harga * a.jumlah) as jumlah_total,
i.nama as nama_pegawai,
b.keperluan

from pemakaian_item_detail a
left join pemakaian_item b on (a.pemakaian_item = b.id)
left join item c on (a.item = c.id)
left join satuan_item e on (c.satuan_item = e.id)
left join tbmuser f on (f.userId = b.disetujui_oleh)
left join pegawai g on (f.pegawai = g.id)
left join lokasi h on (b.lokasi = h.id)
left join pegawai i on (i.id = b.pegawai)
where a.pemakaian_item = $P{id}
order by c.nama]]>
	</queryString>
	<field name="kode" class="java.lang.String"/>
	<field name="nama_barang" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="stok" class="java.lang.Double"/>
	<field name="stokmenjadi" class="java.lang.Double"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="status_persetujuan" class="java.lang.String"/>
	<field name="kd" class="java.lang.String"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="harga" class="java.lang.Double"/>
	<field name="jumlah_total" class="java.lang.Double"/>
	<field name="nama_pegawai" class="java.lang.String"/>
	<field name="keperluan" class="java.lang.String"/>
	<variable name="jml_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_total}]]></variableExpression>
	</variable>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="saldo_awal" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="BlankPage" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="tgl1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="lokasi1" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(c.kode) as kode,
max(c.nama) as nama_barang,
sum(a.jumlah) as jumlah,
sum(case when a.jumlah_bonus is null then 0.0 else a.jumlah_bonus end) as jumlah_bonus,
max(e.nama) as satuan,
max(b.kode) as kd,
max(h.nama) as lokasi,
sum(a.harga_beli) as harga,
sum(case when a.harga_diskon is null then 0.0 else a.harga_diskon end) as harga_diskon,
sum(case when a.harga_pajak is null then 0.0 else a.harga_pajak end) as harga_pajak,
sum((a.harga_beli * a.jumlah) -
(case when a.harga_diskon is null then 0.0 else a.harga_diskon end) +
(case when a.harga_pajak is null then 0.0 else a.harga_pajak end)) as jumlah_total

from penerimaan_order_detail a
left join penerimaan_order b on (a.penerimaan_order = b.id)
left join pesanan_pembelian bb on (b.pesanan_pembelian = bb.id)
left join item c on (a.item = c.id)
left join satuan_item e on (a.satuan_item = e.id)
left join tbmuser f on (f.userId = b.disetujui_oleh)
left join pegawai g on (f.pegawai = g.id)
left join lokasi h on (b.lokasi = h.id)
left join vendor i on (i.id = bb.vendor)
where b.tanggal_persetujuan is not null
and date(b.tanggal_persetujuan) between date($P{tgl1}) and date($P{tgl2})
and b.lokasi = (case when $P{lokasi1} = -1 then b.lokasi else $P{lokasi1} end)
group by c.id
order by nama_barang]]>
	</queryString>
	<field name="kode" class="java.lang.String"/>
	<field name="nama_barang" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="jumlah_bonus" class="java.lang.Double"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="kd" class="java.lang.String"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="harga" class="java.lang.Double"/>
	<field name="harga_diskon" class="java.lang.Double"/>
	<field name="harga_pajak" class="java.lang.Double"/>
	<field name="jumlah_total" class="java.lang.Double"/>
	<variable name="jml_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_total}]]></variableExpression>
	</variable>
	<variable name="jml_total_diskon" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{harga_diskon}]]></variableExpression>
	</variable>
	<variable name="jml_total_pajak" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{harga_pajak}]]></variableExpression>
	</variable>
	<variable name="jml_total_bonus" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_bonus}]]></variableExpression>
	</variable>

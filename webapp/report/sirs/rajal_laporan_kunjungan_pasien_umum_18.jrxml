	<queryString>
		<![CDATA[select
1 as minggu,
min(m.tanggal_mulai) as tanggal_mulai,
max(m.tanggal_sampai) as tanggal_sampai,
sum(case aa.poly when $P{poli1} then 1 else 0 end) as poli_1,
sum(case aa.poly when $P{poli2} then 1 else 0 end) as poli_2,
sum(case aa.poly when $P{poli3} then 1 else 0 end) as poli_3,
sum(case aa.poly when $P{poli4} then 1 else 0 end) as poli_4,
sum(case aa.poly when $P{poli5} then 1 else 0 end) as poli_5,
sum(case aa.poly when $P{poli6} then 1 else 0 end) as poli_6,
sum(case aa.poly when $P{poli7} then 1 else 0 end) as poli_7,
sum(case aa.poly when $P{poli8} then 1 else 0 end) as poli_8,
sum(case aa.poly when $P{poli9} then 1 else 0 end) as poli_9,
sum(case aa.poly when $P{poli10} then 1 else 0 end) as poli_10,
sum(case aa.poly when $P{poli11} then 1 else 0 end) as poli_11,
sum(case aa.poly when $P{poli12} then 1 else 0 end) as poli_12,
sum(case aa.poly when $P{poli13} then 1 else 0 end) as poli_13,
sum(case aa.poly when $P{poli14} then 1 else 0 end) as poli_14,
sum(case aa.poly when $P{poli15} then 1 else 0 end) as poli_15,
sum(case aa.poly when $P{poli16} then 1 else 0 end) as poli_16,
sum(case aa.poly when $P{poli17} then 1 else 0 end) as poli_17,
sum(case aa.poly when $P{poli18} then 1 else 0 end) as poli_18,
sum(case aa.poly when $P{poli19} then 1 else 0 end) as poli_19,
sum(case aa.poly when $P{poli20} then 1 else 0 end) as poli_20,
sum(case aa.poly when $P{poli21} then 1 else 0 end) as poli_21,
(select nama from poly where id = $P{poli1}) as poly1,
(select nama from poly where id = $P{poli2}) as poly2,
(select nama from poly where id = $P{poli3}) as poly3,
(select nama from poly where id = $P{poli4}) as poly4,
(select nama from poly where id = $P{poli5}) as poly5,
(select nama from poly where id = $P{poli6}) as poly6,
(select nama from poly where id = $P{poli7}) as poly7,
(select nama from poly where id = $P{poli8}) as poly8,
(select nama from poly where id = $P{poli9}) as poly9,
(select nama from poly where id = $P{poli10}) as poly10,
(select nama from poly where id = $P{poli11}) as poly11,
(select nama from poly where id = $P{poli12}) as poly12,
(select nama from poly where id = $P{poli13}) as poly13,
(select nama from poly where id = $P{poli14}) as poly14,
(select nama from poly where id = $P{poli15}) as poly15,
(select nama from poly where id = $P{poli16}) as poly16,
(select nama from poly where id = $P{poli17}) as poly17,
(select nama from poly where id = $P{poli18}) as poly18,
(select nama from poly where id = $P{poli19}) as poly19,
(select nama from poly where id = $P{poli20}) as poly20,
(select nama from poly where id = $P{poli21}) as poly21,
1
from minggu m
left join pendaftaran aa on (date(aa.tanggalpendaftaran) between date(m.tanggal_mulai) and date(m.tanggal_sampai))
inner join pasien cc on (aa.pasien = cc.id and cc.jenis_pasien = $P{jenis_pasien})
where aa.jenis = 'Rawat Jalan'
and m.tbmuser = $P{tbmuser}
group by m.tanggal_mulai
order by min(aa.tanggalpendaftaran)]]>
	</queryString>

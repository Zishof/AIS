<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="data_pasien_rawat_inap" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="0.7513148009015781"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2011]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(trim(a.nama)) as ruang,
count(b.id) as jumlah_pasien,
max(z.jumlah_tempat_tidur) as tt_tersedia,
count(DISTINCT(b.tempat_tidur)) as tt_terpakai,
sum(date(case when c.tanggal_pulang is null then current_timestamp else c.tanggal_pulang end)-date(b.tanggalpendaftaran)) as hari_rawat,
sum(case when c.status_pulang in (5, 6, 7) then 1 else 0 end) as hidup,
sum(case when c.status_pulang in (10) then 1 else 0 end) as mati,
sum(case when c.status_pulang in (8) then 1 else 0 end) as rujuk,
28 as hari_periode,
0.0 as bor,
0.0 as alos,
0.0 as toi,
0.0 as bto,
0.0 as gdr


from ruang a
left join pendaftaran b on (a.id = b.ruang_perawatan)
left join data_pasien_keluar c on (c.pendaftaran = b.id)
inner join (
	select count(id) as jumlah_tempat_tidur,
	ruang
	from tempat_tidur
	where kamar is not null
	group by ruang
) z on (z.ruang = a.id)
where b.jenis = 'Rawat Inap'
and to_number(to_char(b.tanggalpendaftaran,'MM'),'9999999') = $P{bulan}
and to_number(to_char(b.tanggalpendaftaran,'YYYY'),'9999999') = $P{tahun}
group by a.id
order by a.id]]>
	</queryString>
	<field name="ruang" class="java.lang.String"/>
	<field name="jumlah_pasien" class="java.lang.Long"/>
	<field name="tt_tersedia" class="java.lang.Long"/>
	<field name="tt_terpakai" class="java.lang.Long"/>
	<field name="hari_rawat" class="java.lang.Long"/>
	<field name="hidup" class="java.lang.Long"/>
	<field name="mati" class="java.lang.Long"/>
	<field name="rujuk" class="java.lang.Long"/>
	<field name="hari_periode" class="java.lang.Integer"/>
	<field name="bor" class="java.math.BigDecimal"/>
	<field name="alos" class="java.math.BigDecimal"/>
	<field name="toi" class="java.math.BigDecimal"/>
	<field name="bto" class="java.math.BigDecimal"/>
	<field name="gdr" class="java.math.BigDecimal"/>
	<variable name="bor" class="java.lang.Double">
		<variableExpression><![CDATA[$F{tt_tersedia}.doubleValue()/$F{tt_terpakai}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="alos" class="java.lang.Double">
		<variableExpression><![CDATA[(($F{hidup} != null) && ($F{hidup} > 0) ?  $F{tt_tersedia}.doubleValue()*$F{hari_rawat}.doubleValue()/$F{hidup}.doubleValue() : 0.0)]]></variableExpression>
	</variable>
	<variable name="toi" class="java.lang.Double">
		<variableExpression><![CDATA[(($F{hidup} != null) && ($F{hidup} > 0) ?  ($F{tt_tersedia}.doubleValue()-$F{tt_terpakai}.doubleValue())*$F{hari_rawat}.doubleValue()/$F{hidup}.doubleValue() : 0.0)]]></variableExpression>
	</variable>
	<variable name="bto" class="java.lang.Double">
		<variableExpression><![CDATA[$F{hidup}.doubleValue()/$F{tt_tersedia}.doubleValue()]]></variableExpression>
	</variable>

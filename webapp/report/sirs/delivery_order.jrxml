	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[3L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
i.nama as vendor,
c.kode,
c.nama as nama_barang,
a.jumlah,
case when a.jumlah_bonus is null then 0.0 else a.jumlah_bonus end as jumlah_bonus,
e.nama as satuan,
(case when b.disetujui_oleh = b.disetujui_oleh then 'Telah Disetujui oleh ' || g.nama || ' pada tanggal ' || to_char(b.tanggal_persetujuan,'DD-MM-YYYY') else 'Belum disetujui' end) as status_persetujuan,
b.kode as kd,
h.nama as lokasi,
a.harga_beli as harga,
(case when a.harga_diskon is null then 0.0 else a.harga_diskon end) as harga_diskon,
(case when a.harga_pajak is null then 0.0 else a.harga_pajak end) as harga_pajak,
(a.harga_beli * a.jumlah) -
(case when a.harga_diskon is null then 0.0 else a.harga_diskon end) +
(case when a.harga_pajak is null then 0.0 else a.harga_pajak end) as jumlah_total

from penerimaan_order_detail a
left join penerimaan_order b on (a.penerimaan_order = b.id)
left join pesanan_pembelian bb on (b.pesanan_pembelian = bb.id)
left join item c on (a.item = c.id)
left join satuan_item e on (a.satuan_item = e.id)
left join tbmuser f on (f.userId = b.disetujui_oleh)
left join pegawai g on (f.pegawai = g.id)
left join lokasi h on (b.lokasi = h.id)
left join vendor i on (i.id = bb.vendor)
where a.penerimaan_order = $P{id}
order by c.nama]]>
	</queryString>

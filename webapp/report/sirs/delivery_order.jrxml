	</variable>
	<variable name="jml_total_pajak" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{harga_pajak}]]></variableExpression>
	</variable>
	<variable name="jml_total_bonus" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_bonus}]]></variableExpression>
	</variable>

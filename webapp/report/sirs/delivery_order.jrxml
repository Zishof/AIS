	<field name="harga_pajak" class="java.lang.Double"/>
	<field name="jumlah_total" class="java.lang.Double"/>
	<variable name="jml_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_total}]]></variableExpression>
	</variable>
	<variable name="jml_total_diskon" class="java.lang.Double" calculation="Sum">

	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="jenisTindakan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.kode,
a.nama as tindakan,
c.nama as jenis_barang,
d.nama as akun,
(case when b1.biaya is null then 0 else b1.biaya end) as harga_normal,
(case when b2.biaya is null then 0 else b2.biaya end) as svip,
(case when b3.biaya is null then 0 else b3.biaya end) as vip,
(case when b4.biaya is null then 0 else b4.biaya end) as kelas1,
(case when b5.biaya is null then 0 else b5.biaya end) as kelas2,
(case when b6.biaya is null then 0 else b6.biaya end) as kelas3,
(case when b7.biaya is null then 0 else b7.biaya end) as intermediate

from tindakan a
left join jenis_tindakan c on (c.id = a.jenis_tindakan)
left join akun d on (a.akun = d.id)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 0
	group by tindakan
) b1 on (a.id = b1.tindakan)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 9
	group by tindakan
) b2 on (a.id = b2.tindakan)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 10
	group by tindakan
) b3 on (a.id = b3.tindakan)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 11
	group by tindakan
) b4 on (a.id = b4.tindakan)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 12
	group by tindakan
) b5 on (a.id = b5.tindakan)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 13
	group by tindakan
) b6 on (a.id = b6.tindakan)
left join (
	select
	tindakan,
	max(biaya) biaya
	from biaya_tindakan_per_kelas
	where kelas_perawatan = 14
	group by tindakan
) b7 on (a.id = b7.tindakan)
where a.jenis_tindakan = (case when $P{jenisTindakan} = -1 then a.jenis_tindakan else $P{jenisTindakan} end)
order by a.nama]]>
	</queryString>

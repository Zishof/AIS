	<parameter name="pasien" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[906868L]]></defaultValueExpression>
	</parameter>
	<parameter name="pendaftaran" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[217693L]]></defaultValueExpression>
	</parameter>
	<parameter name="transaksi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_pasien" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Abdullah"]]></defaultValueExpression>
	</parameter>
	<parameter name="mr" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["4634347"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[(
	select
	'Biaya' as jenis_trx,
	d.kode as nota,
	max(b.kode) as kode,
	max(b.nama) as nama_barang,
	(sum(a.qty)) as qty,
	max(b2.nama) as satuan,
	sum(a.amount*(a.qty*(-a1.jenis))) as harga,
sum(a.qty * a.diskon) as diskon,
sum(a.qty * a.pajak) as pajak,
	max(a.tanggal) as tanggal,
	max(b1.nama) as jenis
	from detail_transaksi a
	inner join kode_transaksi a1 on (a.kode_transaksi = a1.id)
	left join item b on (a.item = b.id)
	left join satuan_item b2 on (b.satuan_item = b2.id)
	left join jenis_barang b1 on (b.jenis_item = b1.id)
	left join transaksi_detail c on (a.transaksi_detail = c.id)
	left join transaksi d on (c.transaksi = d.id)
	where (a.pasien = $P{pasien} or c.transaksi = $P{transaksi} or d.pendaftaran = $P{pendaftaran})
	and (a.lunas = false or a.lunas is null)
	and a.transaksi_detail is not null
	group by d.kode,a.item
	having sum(a.qty) > 0.0
	order by tanggal
)
union all
(
select
	'Biaya' as jenis_trx,
	e.kode as nota,
	max(case when d.kode is null then b.kode else d.kode end) as kode,
	max(case when d.nama is null then b.nama else d.nama end) as nama_barang,
	sum(a.qty) as qty,
	max(d2.nama) as satuan,
	sum(a.qty * a.amount) as harga,
sum(a.qty * a.diskon) as diskon,
sum(a.qty * a.pajak) as pajak,
	max(a.tanggal) as tanggal,
	max(case when d1.nama is null then '-' else d1.nama end) as jenis
	from detail_transaksi_layanan a
	left join alat_medis b on (b.id = a.alat_medis)
	left join tindakan d on (d.id = a.tindakan)
	left join jenis_tindakan d1 on (d.jenis_tindakan = d1.id)
	left join satuan_item d2 on (d.satuan = d2.id)
	left join pendaftaran e on (e.id = a.pendaftaran)
	where (a.pasien = $P{pasien} or a.pendaftaran = $P{pendaftaran})
	and (a.lunas = false or a.lunas is null)
	group by e.kode,a.tindakan,a.alat_medis
	having sum(a.qty) > 0.0
	order by tanggal
)
union all
(
	select
	'Retur' as jenis_trx,
	d1.kode as nota,
	max(b.kode) as kode,
	max(b.nama) as nama_barang,
	(sum(a.qty)) as qty,
	max(b2.nama) as satuan,
	sum(a.amount*(a.qty*(-a1.jenis))) as harga,
sum(a.qty * a.diskon) as diskon,
sum(a.qty * a.pajak) as pajak,
	max(a.tanggal) as tanggal,
	max(b1.nama) as jenis
	from detail_transaksi a
	inner join kode_transaksi a1 on (a.kode_transaksi = a1.id)
	left join item b on (a.item = b.id)
	left join satuan_item b2 on (b.satuan_item = b2.id)
	left join jenis_barang b1 on (b.jenis_item = b1.id)
	left join transaksi_retur_detail c1 on (a.transaksi_retur_detail = c1.id)
	left join transaksi_retur d1 on (c1.transaksi_retur = d1.id)
	left join transaksi d2 on (d1.transaksi = d2.id)
	where (a.pasien = $P{pasien} or d1.transaksi = $P{transaksi} or d2.pendaftaran = $P{pendaftaran})
	and (a.lunas = false or a.lunas is null)
	and a.transaksi_retur_detail is not null
	group by d1.kode,a.item
	having sum(a.qty) > 0.0
	order by tanggal
)]]>
	</queryString>
	<field name="jenis_trx" class="java.lang.String"/>
	<field name="nota" class="java.lang.String"/>
	<field name="kode" class="java.lang.String"/>
	<field name="nama_barang" class="java.lang.String"/>
	<field name="qty" class="java.lang.Double"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="harga" class="java.lang.Double"/>
	<field name="diskon" class="java.lang.Double"/>
	<field name="pajak" class="java.lang.Double"/>

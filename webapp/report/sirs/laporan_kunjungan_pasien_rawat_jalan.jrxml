				<imageExpression><![CDATA["logo.jpg"]]></imageExpression>
			</image>
			<textField>
				<reportElement x="2" y="86" width="800" height="31"/>
				<textElement/>
				<textFieldExpression><![CDATA["LAPORAN KUNJUNGAN PASIEN RAWAT JALAN "+$P{nama_jenis_pasien}.toUpperCase()+"\nPer : "+(new java.text.SimpleDateFormat("dd MMMMM yyyy", new java.util.Locale("in", "ID")).format($P{tanggalMulai}))+" - "+(new java.text.SimpleDateFormat("dd MMMMM yyyy", new java.util.Locale("in", "ID")).format($P{tanggalSelesai}))]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="74" y="21" width="728" height="23"/>

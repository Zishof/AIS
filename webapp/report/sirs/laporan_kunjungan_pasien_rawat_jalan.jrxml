					<font size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "alamat_instansi" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="74" y="-12" width="728" height="33"/>
				<textElement>
					<font size="24" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}.get( "dinas_instansi" )]]></textFieldExpression>
			</textField>
		</band>

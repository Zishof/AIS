<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="daftar_harga_jual_item" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="jenisItem" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[15L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.kode,
a.nama as item,
c.nama as jenis_barang,
(case when b1.harga_jual is null then 0 else b1.harga_jual end) as harga_normal,
(case when b2.harga_jual is null then 0 else b2.harga_jual end) as svip,
(case when b3.harga_jual is null then 0 else b3.harga_jual end) as vip,
(case when b4.harga_jual is null then 0 else b4.harga_jual end) as kelas1,
(case when b5.harga_jual is null then 0 else b5.harga_jual end) as kelas2,
(case when b6.harga_jual is null then 0 else b6.harga_jual end) as kelas3,
(case when b7.harga_jual is null then 0 else b7.harga_jual end) as intermediate

from item a
left join jenis_barang c on (c.id = a.jenis_item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 0
	group by item
) b1 on (a.id = b1.item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 9
	group by item
) b2 on (a.id = b2.item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 10
	group by item
) b3 on (a.id = b3.item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 11
	group by item
) b4 on (a.id = b4.item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 12
	group by item
) b5 on (a.id = b5.item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 13
	group by item
) b6 on (a.id = b6.item)
left join (
	select
	item,
	max(harga_jual) harga_jual
	from harga_jual_item
	where kelas_perawatan = 14
	group by item
) b7 on (a.id = b7.item)
where a.jenis_item = (case when $P{jenisItem} = -1 then a.jenis_item else $P{jenisItem} end)
order by a.nama]]>
	</queryString>

	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="lokasi1" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="rajalRanap" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_pasien" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="satker" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="bebas" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<parameter name="lunas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(b.kode) as kode,
max(b.nama) as nama_barang,
sum(case when d.id is not null then (a.qty+a.qty_bonus) else 0.0 end) as pemakaian,
sum(case when f.id is not null then (a.qty+a.qty_bonus) else 0.0 end) as retur,
sum((a.qty+a.qty_bonus)*(-a1.jenis)) as total,
max(g.nama) as satuan,
sum(case when d.id is not null then (a.amount) else 0.0 end) as harga_pemakaian,
sum(case when f.id is not null then (a.amount) else 0.0 end) as harga_retur,
sum((a.amount)*(-a1.jenis)) as harga_total,
max(j.nama) as lokasi,
max(k.nama) as jenis_pasien,
max(l.nama) as satker
from detail_transaksi a
inner join kode_transaksi a1 on (a1.id = a.kode_transaksi)
inner join item b on (a.item = b.id)
left join transaksi_detail c on (a.transaksi_detail = c.id)
left join transaksi d on (c.transaksi = d.id)
left join transaksi_retur_detail e on (a.transaksi_retur_detail = e.id)
left join transaksi_retur f on (e.transaksi_retur = f.id)
left join satuan_item g on (g.id = b.satuan_item)
left join pasien h on (h.id = d.pasien)
left join pendaftaran i on (i.id = d.pendaftaran)
left join lokasi j on (j.id = a.lokasi)
left join jenis_pasien k on (k.id = h.jenis_pasien)
left join satker l on (l.id = h.satker)
where (d.id is not null or f.id is not null)
and (case $P{rajalRanap} when '-1' then 1=1 else i.jenis = $P{rajalRanap} end)
and (case $P{lunas} when '-1' then 1=1 else d.lunas = (case $P{lunas} when 'Lunas' then true else false end) end)
and (case $P{jenis_pasien} when -1 then 1=1 else h.jenis_pasien = $P{jenis_pasien} end)
and (case $P{satker} when -1 then 1=1 else h.satker = $P{satker} end)
and (case $P{lokasi1} when -1 then 1=1 else a.lokasi = $P{lokasi1} end)
and (case $P{bebas} when -1 then 1=1 else d.bebas = (case $P{bebas} when 1 then false else true end) end)
and date(a.tanggal) between date($P{tgl1}) and date($P{tgl2})
group by a.item
order by total desc]]>
	</queryString>
	<field name="kode" class="java.lang.String"/>
	<field name="nama_barang" class="java.lang.String"/>
	<field name="pemakaian" class="java.lang.Double"/>
	<field name="retur" class="java.lang.Double"/>
	<field name="total" class="java.lang.Double"/>
	<field name="satuan" class="java.lang.String"/>

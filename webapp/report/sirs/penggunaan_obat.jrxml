	<field name="harga_retur" class="java.lang.Double"/>
	<field name="harga_total" class="java.lang.Double"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="jenis_pasien" class="java.lang.String"/>
	<field name="satker" class="java.lang.String"/>

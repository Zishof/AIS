		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua_retur" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{harga_retur}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{harga_total}]]></variableExpression>
	</variable>

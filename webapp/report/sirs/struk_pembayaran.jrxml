	<parameter name="pasien" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[16573L]]></defaultValueExpression>
	</parameter>
	<parameter name="pendaftaran" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="transaksi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_pasien" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Abdullah"]]></defaultValueExpression>
	</parameter>
	<parameter name="mr" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["4634347"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[34L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.*,
a.*
from sirs.pembayaran a
inner join
(
	(
		select
		(case when d.kode is null then d2.kode else d.kode end) as nota,
		max(b.kode) as kode_trx,
		max(b.nama) as nama_barang,
		(sum(a.qty*(-a1.jenis))) as qty,
		max(b2.nama) as satuan,
		sum(a.amount*(a.qty*(-a1.jenis))) as harga,
		sum(a.qty * a.diskon) as diskon,
sum(a.qty * a.pajak) as pajak,
		max(a.tanggal) as tanggal,
		max(b1.nama) as jenis,
		a.pembayaran
		from sirs.detail_transaksi_pasien a
		inner join sirs.kode_transaksi_medis a1 on (a.kode_transaksi = a1.id)
		left join sirs.item_medis b on (a.item = b.id)
		left join sirs.satuan_item b2 on (b.satuan_item = b2.id)
		left join sirs.jenis_barang_medis b1 on (b.jenis_item = b1.id)
		left join sirs.transaksi_medis_detail c on (a.transaksi_detail = c.id)
		left join sirs.transaksi_medis d on (c.transaksi = d.id)
		left join sirs.transaksi_retur_detail c1 on (a.transaksi_retur_detail = c1.id)
		left join sirs.transaksi_retur d1 on (c1.transaksi_retur = d1.id)
		left join sirs.transaksi_medis d2 on (d1.transaksi = d2.id)
		where (a.lunas = true and a.pembayaran = $P{id})
		group by a.pembayaran,(case when d.kode is null then d2.kode else d.kode end),a.item
		having sum(a.qty*(-a1.jenis)) > 0.0
		order by tanggal
	)
	union all
	(
		select
		e.kode as nota,
	max(case when d.kode is null then b.kode else d.kode end) as kode,
	max(case when d.nama is null then b.nama else d.nama end) as nama_barang,
	sum(a.qty) as qty,
	max(d2.nama) as satuan,
	sum(a.qty * a.amount) as harga,
sum(a.qty * a.diskon) as diskon,
sum(a.qty * a.pajak) as pajak,
	max(a.tanggal) as tanggal,
	max(case when d1.nama is null then '-' else d1.nama end) as jenis,
	a.pembayaran
	from sirs.detail_transaksi_layanan a
	left join sirs.alat_medis b on (b.id = a.alat_medis)
	left join sirs.tindakan d on (d.id = a.tindakan)
	left join sirs.jenis_tindakan d1 on (d.jenis_tindakan = d1.id)
	left join sirs.satuan_item d2 on (d.satuan = d2.id)
	left join sirs.pendaftaran e on (e.id = a.pendaftaran)
		where (a.lunas = true and a.pembayaran = $P{id})
		group by a.pembayaran,e.kode,a.tindakan,a.alat_medis
	having sum(a.qty) > 0.0
	order by tanggal
	)
) b on (a.id = b.pembayaran)
where a.id = $P{id}]]>
	</queryString>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_kiup" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="tanggalMulai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggalSelesai" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_pasien" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_jenis_pasien" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["PASIEN UMUM"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
trim(a.kode) as kode_pasien,
trim(a.nama) as nama_pasien,
a.tanggal_lahir,
a.jenis_kelamin,
(trim(a.alamat) || (case b.nama when b.nama then ' ' || b.nama else '' end) || (case c.nama when c.nama then ' ' || c.nama else '' end) || (case d.nama when d.nama then ' ' || d.nama else '' end)) as alamat,
trim((case a.no_hp when a.no_hp then ' ' || a.no_hp || '\n' else '' end) || (case a.no_telp when a.no_telp then ' ' || a.no_telp || '\n' else '' end)) as telp


from pasien a
left join kecamatan b on (a.kecamatan = b.id)
left join kota c on (a.kota = c.id)
left join propinsi d on (a.propinsi = d.id)
where a.kode is not null
and a.jenis_pasien = $P{jenis_pasien}
and date(a.tanggal_registrasi) between date($P{tanggalMulai}) and date($P{tanggalSelesai})
order by to_number(trim(a.kode), '9999999999') asc
-- limit 100]]>
	</queryString>
	<field name="kode_pasien" class="java.lang.String"/>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="tanggal_lahir" class="java.sql.Date"/>
	<field name="jenis_kelamin" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="telp" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="117" splitType="Stretch">
			<image>
				<reportElement x="1" y="-19" width="163" height="105"/>
				<imageExpression class="java.lang.String"><![CDATA["logo.jpg"]]></imageExpression>
			</image>
			<staticText>
				<reportElement style="Title" x="110" y="1" width="263" height="31"/>
				<textElement verticalAlignment="Middle">
					<font size="24" pdfFontName="Times-Roman"/>
				</textElement>
				<text><![CDATA[PUSREHAB KEMHAN]]></text>
			</staticText>
			<staticText>
				<reportElement style="SubTitle" x="110" y="32" width="196" height="23" forecolor="#000000"/>
				<textElement>
					<font pdfFontName="Times-Roman"/>
				</textElement>
				<text><![CDATA[Rs. Dr. SUYOTO]]></text>
			</staticText>
			<staticText>
				<reportElement x="110" y="55" width="383" height="31"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<text><![CDATA[Jl. RC Veteran No. 178 Bintaro Jakarta Selatan]]></text>
			</staticText>
			<textField>
				<reportElement x="2" y="86" width="555" height="31"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA["LAPORAN PENDAFTARAN PASIEN "+$P{nama_jenis_pasien}.toUpperCase()+"\nPer : "+(new java.text.SimpleDateFormat("dd MMMMM yyyy", new java.util.Locale("in", "ID")).format($P{tanggalMulai}))+" - "+(new java.text.SimpleDateFormat("dd MMMMM yyyy", new java.util.Locale("in", "ID")).format($P{tanggalSelesai}))]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="16" splitType="Stretch">
			<line>
				<reportElement positionType="FixRelativeToBottom" x="0" y="15" width="802" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#999999"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement style="Column header" x="33" y="0" width="77" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[No. RM]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column header" x="110" y="0" width="189" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Nama Pasien]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column header" x="299" y="0" width="85" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Tanggal Lahir]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column header" x="384" y="0" width="83" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Jenis Kelamin]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column header" x="467" y="0" width="243" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Alamat]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column header" x="710" y="0" width="88" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Telp.]]></text>
			</staticText>
			<staticText>
				<reportElement style="Column header" x="0" y="0" width="33" height="16" forecolor="#736343"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[No.]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="21" splitType="Stretch">
			<frame>
				<reportElement style="Row" mode="Opaque" x="0" y="0" width="802" height="21"/>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement style="Detail" x="33" y="0" width="77" height="21"/>
					<textElement textAlignment="Center">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{kode_pasien}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement style="Detail" x="110" y="0" width="189" height="21"/>
					<box leftPadding="3" rightPadding="1"/>
					<textElement>
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{nama_pasien}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" pattern="dd MMM yyyy" isBlankWhenNull="true">
					<reportElement style="Detail" x="299" y="0" width="85" height="21"/>
					<textElement textAlignment="Center">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.util.Date"><![CDATA[$F{tanggal_lahir}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement style="Detail" x="384" y="0" width="83" height="21"/>
					<textElement>
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{jenis_kelamin}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement style="Detail" x="467" y="0" width="243" height="21"/>
					<box leftPadding="3" rightPadding="3"/>
					<textElement>
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{alamat}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement style="Detail" x="710" y="0" width="88" height="21"/>
					<textElement textAlignment="Center">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{telp}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement style="Detail" x="0" y="0" width="33" height="21"/>
					<textElement>
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>
	<columnFooter>
		<band height="6" splitType="Stretch">
			<line>
				<reportElement positionType="FixRelativeToBottom" x="0" y="3" width="802" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#999999"/>
				</graphicElement>
			</line>
		</band>
	</columnFooter>
	<pageFooter>
		<band height="25" splitType="Stretch">
			<frame>
				<reportElement mode="Opaque" x="-21" y="1" width="843" height="24" forecolor="#D0B48E" backcolor="#F2EBDF"/>
				<textField evaluationTime="Report">
					<reportElement style="Column header" x="783" y="1" width="40" height="20" forecolor="#736343"/>
					<textElement verticalAlignment="Middle">
						<font size="10" isBold="false"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement style="Column header" x="703" y="1" width="80" height="20" forecolor="#736343"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font size="10" isBold="false"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA["Page "+$V{PAGE_NUMBER}+" of"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="21" y="2" width="88" height="20"/>
					<textElement verticalAlignment="Middle"/>
					<textFieldExpression class="java.lang.String"><![CDATA["Tanggal Dicetak"]]></textFieldExpression>
				</textField>
				<textField pattern="EEEEE, dd MMMMM yyyy">
					<reportElement style="Column header" x="109" y="2" width="216" height="20" forecolor="#736343"/>
					<textElement verticalAlignment="Middle">
						<font size="10" isBold="false"/>
					</textElement>
					<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
				</textField>
			</frame>

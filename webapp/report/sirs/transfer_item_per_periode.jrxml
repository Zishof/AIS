<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="saldo_awal" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="lokasi1" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="lokasi2" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[2L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(c.kode) as kode,
max(c.nama) as nama_barang,
sum(a.jumlah) as jumlah,
sum(a.jumlah_diterima) as jumlah_diterima,
sum(a.selisih) as selisih,
max(e.nama) as satuan,
max(b.kode) as kd,
max(h.nama) as lokasi,
max(i.nama) as lokasi_tujuan,
max(a.harga_jual) as harga,
sum(a.jumlah*a.harga_jual) as jumlah_total,
sum(a.jumlah_diterima*a.harga_jual) as jumlah_total_diterima,
sum(a.selisih*a.harga_jual) as jumlah_total_selisih

from transfer_item_detail a
left join transfer_item b on (a.transfer_item = b.id)
left join item c on (a.item = c.id)
left join satuan_item e on (a.satuan_item = e.id)
left join tbmuser f on (f.userId = b.disetujui_oleh)
left join pegawai g on (f.pegawai = g.id)
left join lokasi h on (b.lokasi = h.id)
left join lokasi i on (b.lokasi_tujuan = i.id)
left join tbmuser j on (j.userId = b.diterima_oleh)
left join pegawai k on (j.pegawai = k.id)
where b.tanggal_penerimaan is not null
and date(b.tanggal_penerimaan) between date($P{tgl1}) and date($P{tgl2})
and b.lokasi = (case when $P{lokasi1} = -1 then b.lokasi else $P{lokasi1} end)
and b.lokasi_tujuan = (case when $P{lokasi2} = -1 then b.lokasi_tujuan else $P{lokasi2} end)
group by c.id
order by nama_barang]]>
	</queryString>

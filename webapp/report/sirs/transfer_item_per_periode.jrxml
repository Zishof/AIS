	<field name="nama_barang" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Double"/>
	<field name="jumlah_diterima" class="java.lang.Double"/>
	<field name="selisih" class="java.lang.Double"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="kd" class="java.lang.String"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="lokasi_tujuan" class="java.lang.String"/>
	<field name="harga" class="java.lang.Double"/>
	<field name="jumlah_total" class="java.lang.Double"/>
	<field name="jumlah_total_diterima" class="java.lang.Double"/>
	<field name="jumlah_total_selisih" class="java.lang.Double"/>
	<variable name="jml_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_total}]]></variableExpression>
	</variable>
	<variable name="jml_total_terima" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_diterima}]]></variableExpression>
	</variable>
	<variable name="jml_total_selisih" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{selisih}]]></variableExpression>
	</variable>
	<variable name="jml_total_semua_diterima" class="java.lang.Double" calculation="Sum">

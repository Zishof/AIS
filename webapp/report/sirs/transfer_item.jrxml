	</variable>
	<variable name="jml_total_semua" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_total}]]></variableExpression>
	</variable>
	<variable name="jml_total_terima" class="java.lang.Double" calculation="Sum">

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_ranap_pasien_dinas" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2010]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(c.nama) as jenis_pasien,
sum(case when a.ruang_perawatan = 1 then 1 else 0 end) as "ALAMANDA",
sum(case when a.ruang_perawatan = 2 then 1 else 0 end) as "CEMPAKA",
sum(case when a.ruang_perawatan = 3 then 1 else 0 end) as "DAHLIA",
sum(case when a.ruang_perawatan = 4 then 1 else 0 end) as "ANGGREK",
sum(case when a.ruang_perawatan = 5 then 1 else 0 end) as "KENANGA",
sum(case when a.ruang_perawatan = 6 then 1 else 0 end) as "ANYELIR",
sum(case when a.ruang_perawatan = 7 then 1 else 0 end) as "ICU",
sum(case when a.ruang_perawatan = 8 then 1 else 0 end) as "INTERMEDIATE",
sum(case when a.ruang_perawatan = 9 then 1 else 0 end) as "VK",
count(a.id) as total

from pendaftaran a
inner join pasien b on (a.pasien = b.id)
inner join satker c on (b.satker = c.id)

where a.jenis = 'Rawat Inap'
and to_number(to_char(a.tanggalpendaftaran,'MM'),'9999999') = $P{bulan}
and to_number(to_char(a.tanggalpendaftaran,'YYYY'),'9999999') = $P{tahun}
group by c.id
order by total desc;]]>
	</queryString>
	<field name="jenis_pasien" class="java.lang.String"/>
	<field name="ALAMANDA" class="java.lang.Long"/>
	<field name="CEMPAKA" class="java.lang.Long"/>
	<field name="DAHLIA" class="java.lang.Long"/>
	<field name="ANGGREK" class="java.lang.Long"/>
	<field name="KENANGA" class="java.lang.Long"/>
	<field name="ANYELIR" class="java.lang.Long"/>
	<field name="ICU" class="java.lang.Long"/>
	<field name="INTERMEDIATE" class="java.lang.Long"/>
	<field name="VK" class="java.lang.Long"/>
	<field name="total" class="java.lang.Long"/>

	</parameter>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2011]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_jenis_pasien" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["PASIEN UMUM"]]></defaultValueExpression>
	</parameter>
	<parameter name="tbmuser" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
1 as minggu,
min(m.tanggal_mulai) as tanggal_mulai,
max(m.tanggal_sampai) as tanggal_sampai,
sum(case when aa.poly = $P{poli1} or aa.subpoly = $P{poli1} then 1 else 0 end) as poli_1,
sum(case when aa.poly = $P{poli2} or aa.subpoly = $P{poli2} then 1 else 0 end) as poli_2,
sum(case when aa.poly = $P{poli3} or aa.subpoly = $P{poli3} then 1 else 0 end) as poli_3,
sum(case when aa.poly = $P{poli4} or aa.subpoly = $P{poli4} then 1 else 0 end) as poli_4,
sum(case when aa.poly = $P{poli5} or aa.subpoly = $P{poli5} then 1 else 0 end) as poli_5,
(select nama from poly where id = $P{poli1}) as poly1,
(select nama from poly where id = $P{poli2}) as poly2,
(select nama from poly where id = $P{poli3}) as poly3,
(select nama from poly where id = $P{poli4}) as poly4,
(select nama from poly where id = $P{poli5}) as poly5

from minggu m
left join pendaftaran aa on (date(aa.tanggalpendaftaran) between date(m.tanggal_mulai) and date(m.tanggal_sampai))
inner join pasien cc on (aa.pasien = cc.id and cc.jenis_pasien = $P{jenis_pasien})
where aa.jenis = 'Rawat Jalan'
and m.tbmuser = $P{tbmuser}
group by m.tanggal_mulai
order by min(aa.tanggalpendaftaran)]]>
	</queryString>
	<field name="minggu" class="java.lang.Integer"/>
	<field name="tanggal_mulai" class="java.sql.Date"/>
	<field name="tanggal_sampai" class="java.sql.Date"/>
	<field name="poli_1" class="java.lang.Long"/>
	<field name="poli_2" class="java.lang.Long"/>
	<field name="poli_3" class="java.lang.Long"/>
	<field name="poli_4" class="java.lang.Long"/>

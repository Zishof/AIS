	<parameter name="poli1" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="poli2" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[2L]]></defaultValueExpression>
	</parameter>
	<parameter name="poli3" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[3L]]></defaultValueExpression>
	</parameter>
	<parameter name="poli4" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[4L]]></defaultValueExpression>
	</parameter>
	<parameter name="poli5" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[5L]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis_pasien" class="java.lang.Long" isForPrompting="false">

	<parameter name="jenisItem" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[15L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_8" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_1" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_2" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[2L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_3" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[3L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_4" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_5" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_6" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="p_7" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.kode,
a.nama as item,
c.nama as jenis_barang,
(case when b1.harga_beli is null then 0 else b1.harga_beli end) as h1,
(case when b2.harga_beli is null then 0 else b2.harga_beli end) as h2,
(case when b3.harga_beli is null then 0 else b3.harga_beli end) as h3,
(case when b4.harga_beli is null then 0 else b4.harga_beli end) as h4,
(case when b5.harga_beli is null then 0 else b5.harga_beli end) as h5,
(case when b6.harga_beli is null then 0 else b6.harga_beli end) as h6,
(case when b7.harga_beli is null then 0 else b7.harga_beli end) as h7,
(case when b8.harga_beli is null then 0 else b8.harga_beli end) as h8,

(select nama from vendor where id = $P{p_1}) as v1,
(select nama from vendor where id = $P{p_2}) as v2,
(select nama from vendor where id = $P{p_3}) as v3,
(select nama from vendor where id = $P{p_4}) as v4,
(select nama from vendor where id = $P{p_5}) as v5,
(select nama from vendor where id = $P{p_6}) as v6,
(select nama from vendor where id = $P{p_7}) as v7,
(select nama from vendor where id = $P{p_8}) as v8

from item a
left join jenis_barang c on (c.id = a.jenis_item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_1}
	group by item
) b1 on (a.id = b1.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_2}
	group by item
) b2 on (a.id = b2.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_3}
	group by item
) b3 on (a.id = b3.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_4}
	group by item
) b4 on (a.id = b4.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_5}
	group by item
) b5 on (a.id = b5.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_6}
	group by item
) b6 on (a.id = b6.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_7}
	group by item
) b7 on (a.id = b7.item)
left join (
	select
	item,
	max(harga_beli) harga_beli
	from harga_beli_item
	where vendor = $P{p_8}
	group by item
) b8 on (a.id = b8.item)
where a.jenis_item = (case when $P{jenisItem} = -1 then a.jenis_item else $P{jenisItem} end)
order by a.nama]]>
	</queryString>

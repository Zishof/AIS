<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pasien_kemhan" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="bulan" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[2011]]></defaultValueExpression>
	</parameter>
	<parameter name="jenis" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Rawat Jalan"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
max(c.nama) as nama_satker,
count(a.id) as jumlah

from pendaftaran a
inner join pasien b on (a.pasien = b.id and (trim(b.jenis_pasien_dinas) = '1' or trim(b.jenis_pasien_dinas) = '2' or trim(b.jenis_pasien_dinas) = '3'))
left join satker c on (b.satker = c.id)
where c.id is not null
and to_number(to_char(a.tanggalpendaftaran,'MM'),'9999999') = $P{bulan}
and to_number(to_char(a.tanggalpendaftaran,'YYYY'),'9999999') = $P{tahun}
and trim(a.jenis) = $P{jenis}
group by c.id
order by jumlah desc]]>
	</queryString>
	<field name="nama_satker" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Long"/>
	<variable name="total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="132" splitType="Stretch">
			<image>
				<reportElement x="0" y="-20" width="163" height="105"/>
				<imageExpression class="java.lang.String"><![CDATA["logo.jpg"]]></imageExpression>
			</image>
			<staticText>
				<reportElement style="Title" x="109" y="0" width="263" height="31"/>
				<textElement verticalAlignment="Middle">
					<font size="24" pdfFontName="Times-Roman"/>
				</textElement>
				<text><![CDATA[PUSREHAB KEMHAN]]></text>
			</staticText>
			<staticText>
				<reportElement style="SubTitle" x="109" y="31" width="196" height="23" forecolor="#000000"/>
				<textElement>
					<font pdfFontName="Times-Roman"/>
				</textElement>
				<text><![CDATA[Rs. Dr. SUYOTO]]></text>
			</staticText>
			<staticText>
				<reportElement x="109" y="54" width="383" height="31"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<text><![CDATA[Jl. RC Veteran No. 178 Bintaro Jakarta Selatan]]></text>
			</staticText>
			<textField>
				<reportElement x="1" y="85" width="555" height="47"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA["KUNJUNGAN "+$P{jenis}.toUpperCase()+"\nPASIEN U.O. KEMHAN & MABES TNI\nBulan : "+$P{bulan}+" - "+$P{tahun}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="16" splitType="Stretch">

				<textFieldExpression><![CDATA["LAPORAN PENDAPATAN KASIR PER SHIFT\nPERIODE\t: "+$P{tgl1}+" s.d "+$P{tgl2}+"\nLOKASI \t\t: "+($P{lokasi1}.equals(-1L) ? "Semua" : $F{lokasi})]]></textFieldExpression>
			</textField>
			<textField>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="transaksi_item" language="groovy" pageWidth="198" pageHeight="425" columnWidth="198" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[12L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b1.kode,
a.tanggal,
f.nama as lokasi,
(case when c.nama is null then c1.nama else c.nama end) as item,
(a.qty || ' ' || (case when d.nama is null then 'Racikan' else d.nama end)) as qty,
b.nama as nama_pasien,
b.alamat as alamat_pasien,
e.kode as kode_pasien
from transaksi_retur_detail a
inner join transaksi_detail a1 on (a.transaksi_detail = a1.id)
inner join transaksi_retur b1 on (a.transaksi_retur = b1.id)
inner join transaksi b on (b1.transaksi = b.id)
left join item c on (a.item = c.id)
left join racikan c1 on (a1.racikan = c1.id)
left join satuan_item d on (c.satuan_item = d.id)
left join pasien e on (b.pasien = e.id)
left join lokasi f on (b1.lokasi = f.id)
where b1.id = $P{id}]]>
	</queryString>
	<field name="kode" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="item" class="java.lang.String"/>
	<field name="qty" class="java.lang.String"/>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="alamat_pasien" class="java.lang.String"/>
	<field name="kode_pasien" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>

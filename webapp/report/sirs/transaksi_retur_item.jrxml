				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Almt]]></text>
			</staticText>
			<textField>
				<reportElement x="39" y="115" width="155" height="50"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{alamat_pasien}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="7" y="31" width="31" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Trx]]></text>
			</staticText>
			<textField>
				<reportElement x="38" y="31" width="155" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{kode}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="7" y="47" width="32" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Wkt]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy HH.mm.ss">
				<reportElement x="39" y="47" width="154" height="16"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{tanggal}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="7" y="63" width="32" height="16"/>
				<textElement>
					<font size="9"/>

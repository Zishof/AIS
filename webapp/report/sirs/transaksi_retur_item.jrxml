			</staticText>
			<textField>
				<reportElement x="39" y="95" width="155" height="20"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nama_pasien}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="7" y="79" width="32" height="16"/>
				<textElement>

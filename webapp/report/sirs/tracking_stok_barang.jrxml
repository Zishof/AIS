	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="tgl1" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="tgl2" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="lokasi1" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="item" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(c.nama) as item,
max(d.nama) as lokasi,
max(b.nama) as transaksi,
max(a.keterangan) as keterangan,
date(a.tanggal) as tanggal,
sum(case when b.jenis = 1 then (a.qty+a.qty_bonus) else 0 end) as penambahan,
sum(case when b.jenis = -1 then (a.qty+a.qty_bonus) else 0 end) as pengurangan,
(select sum((aa.qty+aa.qty_bonus)*bb.jenis) as saldo from detail_transaksi aa inner join kode_transaksi bb on (aa.kode_transaksi = bb.id) where aa.item = a.item and a.lokasi = aa.lokasi and (aa.tanggal) <= max((a.tanggal))) as saldo,
(select sum((aa.qty+aa.qty_bonus)*bb.jenis) as saldo from detail_transaksi aa inner join kode_transaksi bb on (aa.kode_transaksi = bb.id) where aa.item = a.item and (aa.tanggal) <= max((a.tanggal))) as saldo_total

from detail_transaksi a
inner join kode_transaksi b on (a.kode_transaksi = b.id)
left join item c on (c.id = a.item)
left join lokasi d on (d.id = a.lokasi)
where a.lokasi = (case $P{lokasi1} when -1 then a.lokasi else $P{lokasi1} end)
and a.item = (case $P{item} when -1 then a.item else $P{item} end)
and date(a.tanggal) between date($P{tgl1}) and date($P{tgl2})
group by a.item, a.lokasi,a.kode_transaksi, date(a.tanggal)
order by item,max(a.tanggal)]]>
	</queryString>
	<field name="item" class="java.lang.String"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="transaksi" class="java.lang.String"/>
	<field name="keterangan" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Date"/>
	<field name="penambahan" class="java.lang.Double"/>
	<field name="pengurangan" class="java.lang.Double"/>
	<field name="saldo" class="java.lang.Double"/>
	<field name="saldo_total" class="java.lang.Double"/>
	<variable name="sum_penambahan" class="java.lang.Double" resetType="Group" resetGroup="item" calculation="Sum">
		<variableExpression><![CDATA[$F{penambahan}]]></variableExpression>
	</variable>

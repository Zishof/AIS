	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="jenis_pasien" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_jenis_pasien" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["PASIEN UMUM"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_mulai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-06-26"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_sampai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2011-07-30"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
max(a.nama) as nama_poly,
sum(case b.baru when true then 1 else 0 end) as baru,
sum(case b.baru when true then 0 else 1 end) as lama,
count(b.id) as total

from poly a
inner join pendaftaran b on ((a.id = b.poly or a.id = b.subpoly) and b.jenis = 'Rawat Jalan')
inner join pasien cc on (b.pasien = cc.id)
where b.tanggalpendaftaran between date($P{tanggal_mulai}) and date($P{tanggal_sampai})
and case when $P{jenis_pasien} = -1 then true else cc.jenis_pasien = $P{jenis_pasien} end
and a.poly_dari is null

group by a.id
order by a.id]]>
	</queryString>
	<field name="nama_poly" class="java.lang.String"/>
	<field name="baru" class="java.lang.Long"/>
	<field name="lama" class="java.lang.Long"/>
	<field name="total" class="java.lang.Long"/>
	<variable name="total_baru" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{baru}]]></variableExpression>
	</variable>
	<variable name="total_lama" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{lama}]]></variableExpression>
	</variable>
	<variable name="total_semua" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>

				<textFieldExpression><![CDATA["LAPORAN KUNJUNGAN "+($P{nama_jenis_pasien}.equals("") ? "PASIEN" : $P{nama_jenis_pasien}.toUpperCase())+"\nBERDASARKAN KASUS BARU LAMA\nPERTANGGAL : "+$P{tanggal_mulai}+" - "+$P{tanggal_sampai}]]></textFieldExpression>
			</textField>

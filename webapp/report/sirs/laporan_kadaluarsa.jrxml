<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_stok" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" fontSize="50" isBold="true" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#736343" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontSize="12" isBold="true"/>
	<style name="Detail" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="tanggal" class="java.util.Date" isForPrompting="false"/>
	<parameter name="lokasi" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
1 as no,
max(c.nama) as nama_item,
max(e.nama) as satuan,
max(f.nama) as jenis,
max(d.nama) as lokasi,
max(a.tanggal_kadaluarsa) as tanggal_kadaluarsa,
(date(max(a.tanggal_kadaluarsa)) - date(current_timestamp)) as hari

from kadaluarsa a
left join item c on (a.item = c.id)
left join lokasi d on (a.lokasi = d.id)
left join satuan_item e on (c.satuan_item = e.id)
left join jenis_barang f on (f.id = c.jenis_item)
left join
(select item, (case when max(harga_jual) is null then 0 else max(harga_jual) end)
as harga_jual from harga_jual_item where kelas_perawatan = 0 group by item )
h on (h.item = a.item)
where a.lokasi = (case $P{lokasi} when -1 then a.lokasi else  $P{lokasi} end)
group by a.lokasi,a.item
order by a.lokasi,tanggal_kadaluarsa asc]]>
	</queryString>
	<field name="no" class="java.lang.Integer"/>
	<field name="nama_item" class="java.lang.String"/>
	<field name="satuan" class="java.lang.String"/>
	<field name="jenis" class="java.lang.String"/>
	<field name="lokasi" class="java.lang.String"/>
	<field name="tanggal_kadaluarsa" class="java.sql.Date"/>
	<field name="hari" class="java.lang.Integer"/>

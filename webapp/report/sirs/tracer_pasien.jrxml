	<parameter name="pendaftaran" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(1000)]]></defaultValueExpression>
	</parameter>
	<parameter name="mybarcode" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.kode as no_reg,
a.tanggalpendaftaran,
b.kode as mr,
b.nama as nama_pasien,
c.nama as nama_poli,
a.nomor_antrian,
d.nama as nama_dokter


from pendaftaran a
left join pasien b on (a.pasien = b.id)
left join poly c on (a.poly = c.id)
left join dokter d on (a.dokter = d.id)
where a.id = $P{pendaftaran}]]>
	</queryString>
	<field name="no_reg" class="java.lang.String"/>
	<field name="tanggalpendaftaran" class="java.util.Date"/>
	<field name="mr" class="java.lang.String"/>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="nama_poli" class="java.lang.String"/>
	<field name="nomor_antrian" class="java.lang.Integer"/>
	<field name="nama_dokter" class="java.lang.String"/>

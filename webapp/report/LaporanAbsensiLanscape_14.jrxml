				<reportElement key="textField-18" x="233" y="0" width="74" height="29" uuid="0f040146-702e-4074-b616-9ffdc6d65f12"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.0"/>

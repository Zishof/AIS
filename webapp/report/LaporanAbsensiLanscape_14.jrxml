			<textField isBlankWhenNull="false">
				<reportElement key="textField-20" x="307" y="0" width="475" height="29" uuid="1f97fedc-46de-403e-b30f-9f7203b014f2"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["SEMESTER / KELAS / RUANG : "+($F{semester} == null ? "" : $F{semester}) + " / "+($F{kelas} == null ? "" : $F{kelas}) + " / " + ($F{ruang} == null ? "" : $F{ruang})]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-17" x="3" y="0" width="230" height="29" uuid="e8f48137-4da0-4664-9fc4-79ce64435f8e"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="penerima-beasiswa" language="groovy" columnCount="2" printOrder="Horizontal" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="277" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fb5c2167-97ab-444d-bfab-7d1244e28d7a">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="118"/>
	<parameter name="id_pkl" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="logo1" class="java.lang.String">
		<defaultValueExpression><![CDATA["logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="label_universitas" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["UNIVERSITAS ISLAM NEGERI SYARIF HIDAYATULLAH JAKARTA"]]></defaultValueExpression>
	</parameter>
	<parameter name="diterima" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="belumDiterima" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="nim" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
b.id,
b.nama as nama_mhs,
b.kelamin,
b.nim as nim_mhs,
d.nama as jurusan,
e.nama as fakultas,
b.telp,
b.email,
c.nama as nama_beasiswa,
cc.nama as nama_kelompok,
c1.nama as dosen1,
c2.nama as dosen2,
c3.nama as dosen3,
c4.nama as dosen4,
c5.nama as dosen5,
cc.alamat,
a.totalnilai,
a.nilaihuruf,
a.diterima,
a.nilaihuruf,
a.diterima

FROM mahasiswa_dapat_kelompok_kelompok_pkl a
LEFT JOIN mahasiswa b on a.mahasiswa = b."id"

LEFT JOIN kelompok_pkl cc on cc.id = a.kelompok_pkl
LEFT JOIN pkl c on cc.pkl = c."id"

LEFT JOIN dosen c1 on cc.dosen_pembimbing1 = c1."id"
LEFT JOIN dosen c2 on cc.dosen_pembimbing2 = c2."id"
LEFT JOIN dosen c3 on cc.dosen_pembimbing3 = c3."id"
LEFT JOIN dosen c4 on cc.dosen_pembimbing4 = c4."id"
LEFT JOIN dosen c5 on cc.dosen_pembimbing5 = c5."id"

left join jurusan d on b.jurusan = d."id"
LEFT JOIN fakultas e on d.fakultas = e."id"

WHERE a.kelompok_pkl = $P{id_pkl}
and case when $P{diterima}=0 then true else diterima end
and case when $P{belumDiterima}=1 then diterima = false else true end
and case when $P{nim} != '' then b.nim ilike '%'||$P{nim}||'%' or b.nama ilike '%'||$P{nim}||'%' else true end
order by b.nim]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="nama_mhs" class="java.lang.String"/>

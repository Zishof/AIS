		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="dosen" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[302L]]></defaultValueExpression>
	</parameter>
	<parameter name="tahun_akademik" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2014/2015"]]></defaultValueExpression>
	</parameter>
	<parameter name="genapGanjil" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Genap"]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_dosen" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Andri"]]></defaultValueExpression>
	</parameter>
	<parameter name="fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jurusan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="jumlah_pilihan_checklist_penilaian_dosen_oleh_mahasiswa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["5"]]></defaultValueExpression>
	</parameter>
	<parameter name="program" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
e.nama as dosen,
e.id as id_dosen,
c1.kode as kode_mk,
c1.sks,
max(c1.nama||' '||c.kelas||' '||(case when c.hari is null then '' else c.hari end)||' '||(case when c.waktu_mulai is null then '' else c.waktu_mulai end)||' '||(case when c.waktu_selesai is null then '' else c.waktu_selesai end)) as nama_perkuliahan,
case when sum(x.total) <0.1 then 0.0 else (((sum(x.nilai1)*1)+(sum(x.nilai2)*2)+(sum(x.nilai3)*3)+(sum(x.nilai4)*4)+(sum(x.nilai5)*5))*1.0)/(sum(x.total)) end as "total",
avg(case when (x.total) < 0.1 then 0.0 else ((((x.nilai1)*1)+((x.nilai2)*2)+((x.nilai3)*3)+((x.nilai4)*4)+((x.nilai5)*5))*1.0)/((x.total)) end) as "rata_rata"
from rekap_angket_dosen x

inner join checklist_penilaian_dosen a on (a.id=x.checklist_penilaian_dosen)
inner join grup_checklist_penilaian_dosen b on (a.grup_checklist_penilaian_dosen=b.id)
inner join perkuliahan c on (x.perkuliahan=c.id)
inner join matakuliah c1 on (c.matakuliah=c1.id)
inner join jurusan d on (c.jurusan=d.id)
inner join dosen e on (x.dosen=e.id)
where c.tahun_ajaran=$P{tahun_akademik}
and c.semester%2 = (case $P{genapGanjil} when 'Semua' then c.semester%2 when 'Ganjil' then 1 else 0 end)
and case when $P{jurusan}=-1 then true else c.jurusan=$P{jurusan} end
and case when $P{fakultas}=-1 then true else d.fakultas=$P{fakultas} end
and case when $P{program}='-1' then true else c.program=$P{program} end
and case when $P{dosen}=-1 then true else x.dosen=$P{dosen} end
and (a.aktif=true or a.aktif is null)
and (b.aktif=true or b.aktif is null)
GROUP BY e.id,c.id,c1.id
order by e.id,c.id,c1.id]]>
	</queryString>
	<field name="dosen" class="java.lang.String"/>
	<field name="id_dosen" class="java.lang.Long"/>
	<field name="kode_mk" class="java.lang.String"/>
	<field name="sks" class="java.lang.Integer"/>
	<field name="nama_perkuliahan" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="rata_rata" class="java.math.BigDecimal"/>
	<variable name="rata_rata" class="java.lang.Double" resetType="Group" resetGroup="dosen" calculation="Average">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<group name="dosen">
		<groupExpression><![CDATA[$F{dosen}]]></groupExpression>
	</group>

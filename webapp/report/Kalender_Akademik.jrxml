				<textFieldExpression><![CDATA[(new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal_selesai})).equals((new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal_mulai}))) ? (new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal_mulai})) : (new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal_mulai}))+"\n s.d \n"+(new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal_selesai}))]]></textFieldExpression>

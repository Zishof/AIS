	<parameter name="hanya_fakultas" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select

tanggal_mulai,
tanggal_selesai,
nama_kegiatan_akademik,
descripsi_kegiatan_akademik
from kalender_akademik
where tahun_ajaran = (case when tahun_ajaran = '-1' then tahun_ajaran else $P{tahun_ajaran} end)
and (case when $P{semester} = '-1' then true else ganjil_genap=$P{semester} end)
and (case when $P{program}='-1' then true else $P{program}=program or program is null end)
and (case when $P{fakultas_id}=-1 then true else $P{fakultas_id}=fakultas or fakultas is null end)
and (case when $P{jurusan_id}=-1 then true else $P{jurusan_id}=jurusan or jurusan is null end)
and (case when $P{hanya_jurusan}=0 then true else jurusan is not null end)
and (case when $P{hanya_fakultas}=0 then true else fakultas is not null end)
order by tanggal_mulai]]>
	</queryString>
	<field name="tanggal_mulai" class="java.sql.Date"/>
	<field name="tanggal_selesai" class="java.sql.Date"/>
	<field name="nama_kegiatan_akademik" class="java.lang.String"/>
	<field name="descripsi_kegiatan_akademik" class="java.lang.String"/>

	</parameter>
	<queryString>
		<![CDATA[select b.id as checklist,b.isi, b.diperuntukkan
from jadwal_checklist_penilaian_umum a
inner join grup_checklist_penilaian_umum b on (a.grup_penilaian_umum=b.id)
where (b.aktif or b.aktif is null) and a.tahunakademik=$P{tahun_akademik} and a.semester=$P{genapGanjil}
and a.grup_kuesioner_umum is null
and case when $P{diperuntukkan}='Semua' then true else b.diperuntukkan=$P{diperuntukkan} end]]>
	</queryString>
	<field name="checklist" class="java.lang.Long"/>
	<field name="isi" class="java.lang.String"/>
	<field name="diperuntukkan" class="java.lang.String"/>

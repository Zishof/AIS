					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["telah menyelesaikan dengan baik dan memenuhi segala syarat Pendidikan "+$P{REPORT_PARAMETERS_MAP}.get( "jenjang" )+"<br>"+

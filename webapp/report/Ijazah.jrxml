					<font size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["Lahir di "+$P{REPORT_PARAMETERS_MAP}.get( "tempat" )+" tanggal "+$P{REPORT_PARAMETERS_MAP}.get( "tanggal_lahir" )]]></textFieldExpression>

		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="asrama" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="mulai" class="java.util.Date" isForPrompting="false"/>
	<parameter name="sampai" class="java.util.Date" isForPrompting="false"/>
	<queryString>
		<![CDATA[select d.nama as asrama,m.nim,m.nama, count(*) as jumlah

from pengajuan_mahasiswa dpa
left join jenis_pengajuan d on dpa.jenis_pengajuan = d.id
left join (
	select mahasiswa,max(status_mahasiswa) as status_mahasiswa from history_status_mahasiswa
	where tahunakademik=$P{current_ta}
	and semester%2=(case when $P{current_semester}='Ganjil' then 1 else 0 end)
	group by mahasiswa
) b1 on (dpa.mahasiswa=b1.mahasiswa)
left join status_mahasiswa b2 on (b2.id = b1.status_mahasiswa)
left join mahasiswa m on dpa.mahasiswa = m.id
left join jurusan j on m.jurusan = j.id
left join fakultas f on j.fakultas = f.id
where persetujuan = true
and case when $P{fakultas} = -1 then true else f.id = $P{fakultas} end
and case when $P{asrama} = -1 then true else dpa.jenis_pengajuan = $P{asrama} end
and case when $P{mahasiswa} = -1 then true else dpa.mahasiswa = $P{mahasiswa} end
and case when $P{jurusan} = -1 then true else j.id = $P{jurusan} end
and case when $P{status} = -1 then true else b1.status_mahasiswa = $P{status} end
and case when $P{angkatan} = -1 then true else m.tahunangkatan = $P{angkatan} end
and date(dpa.tanggal) between date($P{mulai}) and date($P{sampai})
group by m.id,d.id]]>
	</queryString>

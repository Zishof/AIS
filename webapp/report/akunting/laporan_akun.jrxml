	</parameter>
	<queryString>
		<![CDATA[select
abs(sum(debet-kredit)) as nilai,
b.kode,
b.nama as akun,
c.nama as grup_akun

from akunting.transaksi a
inner join akunting.akun b on (a.akun = b.id)
inner join akunting.grup_akun c on (b.grup_akun = c.id)

inner join akunting.grup_transaksi c1 on (c1.id=a.grup_transaksi)

where a.posting_history is not null
and date(a.tanggal_transaksi) between date($P{mulai}) and date($P{sampai})
and a.posting_history is not null
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=c1.satuan_kerja end
group by c.id,b.id
having abs(sum(debet-kredit)) > 0
order by c.nama,b.kode]]>
	</queryString>

	<queryString>
		<![CDATA[select
a.kode as kode_transaksi,
c.tanggal_transaksi,
b.kode as kode_akun,
b.nama as nama_akun,
a.keterangan as keterangan_transaksi,
a.debet,
a.kredit



from akunting.transaksi a
left join akunting.akun b on (a.akun = b.id)

inner join akunting.grup_transaksi c on (c.id=a.grup_transaksi)

where c.posting_history is not null
and date(c.tanggal_transaksi) between date($P{mulai}) and date($P{sampai})
and a.akun is not null
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=c.satuan_kerja end
and case when $X{IN,-1,groupUp} then false else $X{IN,a.grup_transaksi,groupUp} end
order by a.kode]]>
	</queryString>

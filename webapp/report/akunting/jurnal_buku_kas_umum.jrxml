	</parameter>
	<parameter name="sumberDana" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<parameter name="satuan_kerja" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
a.kode as kode_transaksi,
a.tanggal_transaksi,
b.kode as kode_akun,
b.nama as nama_akun,
case when trim(i.keperluan) = '' then trim(i.keterangan) else trim(i.keperluan) end as keterangan_transaksi,
a.debet,
a.kredit,
b.kode,
j.nama as mitra,
i.nomortagihan


from akunting.transaksi a
left join akunting.akun b on (a.akun = b.id)
left join akunting.workspace_has_transaksi g on (g.transaksi = a.id)
left join rab.workspace h on (h.id = g.workspace)
left join akunting.grup_transaksi i on (i.id = a.grup_transaksi)
left join rab.mitra j on (j.id = i.mitra)

where a.bulan between $P{bulan} and $P{bulan1}
and a.tahun = $P{tahun}
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=i.satuan_kerja end
and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,h.satuan_kerja,satuanKerjas} end
and case when $P{sumberDana} = -1 then true else h.sumber_dana = $P{sumberDana} end

and b.kode = '111611'

--and a.status_posting = 1
order by
b.kode,
a.tanggal_transaksi]]>
	</queryString>

	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-29','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-29') and date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-29') then (debet-kredit) else 0 end) as hr29,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-30','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-30') and date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-30') then (debet-kredit) else 0 end) as hr30


	from akunting.transaksi a
	inner join akunting.akun b on (a.akun = b.id)
	inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
	where b.id =  $P{akun}
	and a.posting_history is not null
	and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
	and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,a1.satuan_kerja,satuanKerjas} end
	and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end

	union all

	select

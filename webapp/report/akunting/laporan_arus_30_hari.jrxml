	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-25'),'DD-MM-IYYY') then (kredit) else 0 end) as hr25,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-26'),'DD-MM-IYYY') then (kredit) else 0 end) as hr26,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-27'),'DD-MM-IYYY') then (kredit) else 0 end) as hr27,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-28','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-28') and to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-28'),'DD-MM-IYYY') then (kredit) else 0 end) as hr28,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-29','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-29') and to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-29'),'DD-MM-IYYY') then (kredit) else 0 end) as hr29,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-30','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-30') and to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-30'),'DD-MM-IYYY') then (kredit) else 0 end) as hr30


	from akunting.transaksi a
	inner join akunting.akun b on (a.akun = b.id)
	inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
	inner join (
		select
		a.kode
		from akunting.transaksi a
		inner join akunting.akun b on (a.akun = b.id)
		where b.id =  $P{akun}
	) c on (c.kode = a.kode)
	where b.id !=  $P{akun} and b.debit_credit = -1

	and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
	and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,a1.satuan_kerja,satuanKerjas} end
	and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end
	and a.posting_history is not null
	group by a.akun


	union all

	select
	max(a.id) as id,
	'Kas Keluar' as jenis_jurnal,
	max(b.nama) as keterangan,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-01'),'DD-MM-IYYY') then -(debet) else 0 end) as hr1,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-02'),'DD-MM-IYYY') then -(debet) else 0 end) as hr2,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-03'),'DD-MM-IYYY') then -(debet) else 0 end) as hr3,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-04'),'DD-MM-IYYY') then -(debet) else 0 end) as hr4,

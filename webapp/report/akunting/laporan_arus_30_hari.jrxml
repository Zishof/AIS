	<queryString>
		<![CDATA[select
id,
case when jenis_jurnal = 'Kas Masuk' then 'Masuk' else 'Keluar' end jenis_jurnal,
keterangan,
hr1,
hr2,
hr3,
hr4,
hr5,
hr6,
hr7,
hr8,
hr9,
hr10,
hr11,
hr12,
hr13,
hr14,
hr15,
hr16,
hr17,
hr18,
hr19,
hr20,
hr21,
hr22,
hr23,
hr24,
hr25,
hr26,
hr27,
hr28,
hr29,
hr30,
(select nama from akunting.akun where id =  $P{akun}) as akun

from
(
	select
	-1 as id,
	'Kas Masuk' as jenis_jurnal,
	'Saldo' as keterangan,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-01') then (debet-kredit) else 0 end) as hr1,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-02') then (debet-kredit) else 0 end) as hr2,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-03') then (debet-kredit) else 0 end) as hr3,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-04') then (debet-kredit) else 0 end) as hr4,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-05') then (debet-kredit) else 0 end) as hr5,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-06') then (debet-kredit) else 0 end) as hr6,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-07') then (debet-kredit) else 0 end) as hr7,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-08') then (debet-kredit) else 0 end) as hr8,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-09') then (debet-kredit) else 0 end) as hr9,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-10') then (debet-kredit) else 0 end) as hr10,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-11') then (debet-kredit) else 0 end) as hr11,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-12') then (debet-kredit) else 0 end) as hr12,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-13') then (debet-kredit) else 0 end) as hr13,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-14') then (debet-kredit) else 0 end) as hr14,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-15') then (debet-kredit) else 0 end) as hr15,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-16') then (debet-kredit) else 0 end) as hr16,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-17') then (debet-kredit) else 0 end) as hr17,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-18') then (debet-kredit) else 0 end) as hr18,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-19') then (debet-kredit) else 0 end) as hr19,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-20') then (debet-kredit) else 0 end) as hr20,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-21') then (debet-kredit) else 0 end) as hr21,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-22') then (debet-kredit) else 0 end) as hr22,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-23') then (debet-kredit) else 0 end) as hr23,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-24') then (debet-kredit) else 0 end) as hr24,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-25') then (debet-kredit) else 0 end) as hr25,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-26') then (debet-kredit) else 0 end) as hr26,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-' || $P{bulan1} || '-27') then (debet-kredit) else 0 end) as hr27,

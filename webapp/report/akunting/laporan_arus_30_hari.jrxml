	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-09'),'DD-MM-IYYY') then -(debet) else 0 end) as hr9,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-10'),'DD-MM-IYYY') then -(debet) else 0 end) as hr10,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-11'),'DD-MM-IYYY') then -(debet) else 0 end) as hr11,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-12'),'DD-MM-IYYY') then -(debet) else 0 end) as hr12,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-13'),'DD-MM-IYYY') then -(debet) else 0 end) as hr13,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-14'),'DD-MM-IYYY') then -(debet) else 0 end) as hr14,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-15'),'DD-MM-IYYY') then -(debet) else 0 end) as hr15,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-16'),'DD-MM-IYYY') then -(debet) else 0 end) as hr16,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-17'),'DD-MM-IYYY') then -(debet) else 0 end) as hr17,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-18'),'DD-MM-IYYY') then -(debet) else 0 end) as hr18,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-19'),'DD-MM-IYYY') then -(debet) else 0 end) as hr19,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-20'),'DD-MM-IYYY') then -(debet) else 0 end) as hr20,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-21'),'DD-MM-IYYY') then -(debet) else 0 end) as hr21,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-22'),'DD-MM-IYYY') then -(debet) else 0 end) as hr22,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-23'),'DD-MM-IYYY') then -(debet) else 0 end) as hr23,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-24'),'DD-MM-IYYY') then -(debet) else 0 end) as hr24,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-25'),'DD-MM-IYYY') then -(debet) else 0 end) as hr25,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-26'),'DD-MM-IYYY') then -(debet) else 0 end) as hr26,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-27'),'DD-MM-IYYY') then -(debet) else 0 end) as hr27,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-28','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-28') and to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-28'),'DD-MM-IYYY') then -(debet) else 0 end) as hr28,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-29','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-29') and to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-29'),'DD-MM-IYYY') then -(debet) else 0 end) as hr29,
	sum(case when (TO_CHAR(TO_DATE($P{tahun1} || '-' || $P{bulan1} || '-30','yyyy-mm-dd'),'yyyy-mm-dd') = $P{tahun1} || '-' || $P{bulan1} || '-30') and to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-30'),'DD-MM-IYYY') then -(debet) else 0 end) as hr30

	from akunting.transaksi a
	inner join akunting.akun b on (a.akun = b.id)
	inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
	inner join (
		select
		a.kode
		from akunting.transaksi a
		inner join akunting.akun b on (a.akun = b.id)
		where b.id =  $P{akun}
	) c on (c.kode = a.kode)
	where b.id !=  $P{akun} and b.debit_credit = -1

	and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
	and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,a1.satuan_kerja,satuanKerjas} end
	and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end
	and a.posting_history is not null
	group by a.akun
) a
where
abs(hr1) > 0 or abs(hr2) > 0 or abs(hr3) > 0 or abs(hr4) > 0 or abs(hr5) > 0 or abs(hr6) > 0 or abs(hr7) > 0 or abs(hr8) > 0 or abs(hr9) > 0 or abs(hr10) > 0 or abs(hr11) > 0 or abs(hr12) > 0
or abs(hr13) > 0 or abs(hr14) > 0 or abs(hr15) > 0 or abs(hr16) > 0 or abs(hr17) > 0 or abs(hr18) > 0 or abs(hr19) > 0 or abs(hr20) > 0 or abs(hr21) > 0 or abs(hr22) > 0 or abs(hr23) > 0 or abs(hr24) > 0
or abs(hr25) > 0 or abs(hr26) > 0 or abs(hr27) > 0 or abs(hr28) > 0 or abs(hr29) > 0 or abs(hr30) > 0
order by a.jenis_jurnal desc, a.id]]>
	</queryString>

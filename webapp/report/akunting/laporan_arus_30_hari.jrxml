	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-02'),'DD-MM-IYYY') then (kredit) else 0 end) as hr2,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-03'),'DD-MM-IYYY') then (kredit) else 0 end) as hr3,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-04'),'DD-MM-IYYY') then (kredit) else 0 end) as hr4,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-05'),'DD-MM-IYYY') then (kredit) else 0 end) as hr5,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-06'),'DD-MM-IYYY') then (kredit) else 0 end) as hr6,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-07'),'DD-MM-IYYY') then (kredit) else 0 end) as hr7,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-08'),'DD-MM-IYYY') then (kredit) else 0 end) as hr8,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-09'),'DD-MM-IYYY') then (kredit) else 0 end) as hr9,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-10'),'DD-MM-IYYY') then (kredit) else 0 end) as hr10,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-11'),'DD-MM-IYYY') then (kredit) else 0 end) as hr11,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-12'),'DD-MM-IYYY') then (kredit) else 0 end) as hr12,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-13'),'DD-MM-IYYY') then (kredit) else 0 end) as hr13,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-14'),'DD-MM-IYYY') then (kredit) else 0 end) as hr14,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-15'),'DD-MM-IYYY') then (kredit) else 0 end) as hr15,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-16'),'DD-MM-IYYY') then (kredit) else 0 end) as hr16,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-17'),'DD-MM-IYYY') then (kredit) else 0 end) as hr17,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-18'),'DD-MM-IYYY') then (kredit) else 0 end) as hr18,
	sum(case when to_char(a.tanggal_transaksi,'DD-MM-IYYY') = to_char(date($P{tahun1} || '-' || $P{bulan1} || '-19'),'DD-MM-IYYY') then (kredit) else 0 end) as hr19,

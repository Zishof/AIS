	<queryString>
		<![CDATA[select
date(c.tanggal_transaksi) as tanggal_transaksi,
b.kode as kode_akun,
b.nama as nama_akun,
sum(a.debet) as debet,
sum(a.kredit) as kredit


from akunting.transaksi a
inner join akunting.akun b on (a.akun = b.id)
inner join akunting.grup_transaksi c on (c.id=a.grup_transaksi)


where c.posting_history is not null and a.akun is not null
and case when $P{bukti}='' then true else c.kode ilike '%'||$P{bukti}||'%' end
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=c.satuan_kerja end
and case when $X{IN,-1,akuns} then false else $X{IN,a.akun,akuns} end
and date(c.tanggal_transaksi) between date($P{mulai}) and date($P{sampai})
group by b.id,date(c.tanggal_transaksi)
order by b.id,date(c.tanggal_transaksi)]]>
	</queryString>
	<field name="tanggal_transaksi" class="java.sql.Date"/>
	<field name="kode_akun" class="java.lang.String"/>
	<field name="nama_akun" class="java.lang.String"/>
	<field name="debet" class="java.lang.Double"/>
	<field name="kredit" class="java.lang.Double"/>
	<variable name="total_debet" class="java.lang.Double" resetType="Group" resetGroup="kode_transaksi" calculation="Sum">
		<variableExpression><![CDATA[$F{debet}]]></variableExpression>
	</variable>
	<variable name="total_kredit" class="java.lang.Double" resetType="Group" resetGroup="kode_transaksi" calculation="Sum">
		<variableExpression><![CDATA[$F{kredit}]]></variableExpression>
	</variable>
	<variable name="saldoAkhir" class="java.lang.Double" resetType="Group" resetGroup="kode_transaksi" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{debet}.doubleValue() - $F{kredit}.doubleValue()))]]></variableExpression>
	</variable>

	<queryString>
		<![CDATA[select
b.kode as kode_akun,
b.nama as nama_akun,
sum(a.debet-a.kredit) as total


from akunting.transaksi a
inner join akunting.akun b on (a.akun = b.id)
inner join akunting.grup_transaksi c on (c.id=a.grup_transaksi)


where a.akun is not null
and case when $P{bukti}='' then true else c.kode ilike '%'||$P{bukti}||'%' end
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=c.satuan_kerja end
and case when $X{IN,-1,akuns} then false else $X{IN,a.akun,akuns} end
and date(c.tanggal_transaksi) between date($P{mulai}) and date($P{sampai})
group by b.id
order by b.kode]]>
	</queryString>
	<field name="kode_akun" class="java.lang.String"/>
	<field name="nama_akun" class="java.lang.String"/>
	<field name="total" class="java.lang.Double"/>

	<parameter name="tgl1_format" class="java.lang.String"/>
	<parameter name="tgl2_format" class="java.lang.String"/>
	<parameter name="tgl3_format" class="java.lang.String"/>
	<parameter name="tgl4_format" class="java.lang.String"/>
	<parameter name="tgl5_format" class="java.lang.String"/>
	<parameter name="tgl6_format" class="java.lang.String"/>
	<parameter name="tgl7_format" class="java.lang.String"/>
	<parameter name="tgl8_format" class="java.lang.String"/>
	<parameter name="tgl9_format" class="java.lang.String"/>
	<parameter name="tgl10_format" class="java.lang.String"/>
	<parameter name="tgl11_format" class="java.lang.String"/>
	<parameter name="tgl12_format" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
*
from
(
select
f.id as urut_laporan,
c.id as kelompok,
max(urut) as urut,
max(f.keterangan) as laporan,
max((trim(e.nama))) as jenis_laporan1,
max((trim(e.keterangan))) as jenis_laporan2,
max(c.keterangan) as kelompok_laporan,
max(d.nama) as akun,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl1_format}) then (debet-kredit) else 0 end)) as bln1,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl2_format}) then (debet-kredit) else 0 end)) as bln2,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl3_format}) then (debet-kredit) else 0 end)) as bln3,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl4_format}) then (debet-kredit) else 0 end)) as bln4,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl5_format}) then (debet-kredit) else 0 end)) as bln5,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl6_format}) then (debet-kredit) else 0 end)) as bln6,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl7_format}) then (debet-kredit) else 0 end)) as bln7,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl8_format}) then (debet-kredit) else 0 end)) as bln8,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl9_format}) then (debet-kredit) else 0 end)) as bln9,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl10_format}) then (debet-kredit) else 0 end)) as bln10,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl11_format}) then (debet-kredit) else 0 end)) as bln11,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tgl12_format}) then (debet-kredit) else 0 end)) as bln12,

c.tampilkanakunrinci as tampilkanakunrinci

from akunting.transaksi a
inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
inner join akunting.kelompok_laporan_punya_akun b on (a.akun = b.akun)
inner join akunting.kelompok_laporan c on (c.id = b.kelompok_laporan)
inner join akunting.akun d on (a.akun = d.id)
inner join akunting.master_grup_laporan e on (c.master_grup_laporan = e.id)
inner join akunting.jenis_laporan f on (f.id = c.jenis_laporan)

inner join akunting.grup_transaksi c1 on (c1.id=a.grup_transaksi)

where case when $P{kelompok} = -1 then true else b.kelompok_laporan = $P{kelompok} end
and case when $P{grup} = -1 then true else c.master_grup_laporan = $P{grup} end
and case when $P{nama} = '-1' then true else e.nama ilike $P{nama} end
and (c.aktif is null or c.aktif)
and a1.posting_history is not null
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=c1.satuan_kerja end
and case when $P{jenis_laporan} = -1 then true else $P{jenis_laporan}=c.jenis_laporan end
group by f.id,upper(trim(e.nama)),upper(trim(e.keterangan)),c.id,d.id
order by f.id,max(e.nomor_urut),upper(trim(e.nama)),upper(trim(e.keterangan)),c.id,max(b.nomorurut),urut, akun

) as a
where (abs(bln1) > 0 or abs(bln2) > 0 or abs(bln3) > 0 or abs(bln4) > 0 or abs(bln5) > 0 or abs(bln6) > 0 or abs(bln7) > 0 or abs(bln8) > 0 or abs(bln9) > 0 or abs(bln10) > 0 or abs(bln11) > 0 or abs(bln12) > 0)]]>
	</queryString>

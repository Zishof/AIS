	<queryString>
		<![CDATA[select
f.id as urut_laporan,
c.id as kelompok,
c.urut as urut,
max(f.keterangan) as laporan,
max((trim(e.nama))) as jenis_laporan1,
max((trim(e.keterangan))) as jenis_laporan2,
max(c.keterangan) as kelompok_laporan,
max(c.keterangan1) as kelompok_laporan1,
d.nama as akun,
(sum(case when date(a1.tanggal_transaksi) between date('2000-01-01') and date($P{tanggalSaldoAwal}) then (debet-kredit) else 0 end)) as saldo_awal,
(sum(case when date(a1.tanggal_transaksi) between date($P{tanggal1}) and date($P{tanggal2}) then (debet) else 0 end)) as debet,
(sum(case when date(a1.tanggal_transaksi) between date($P{tanggal1}) and date($P{tanggal2}) then (kredit) else 0 end)) as kredit,
(sum(case when date(a1.tanggal_transaksi) <= date($P{tanggal2}) then (debet-kredit) else 0 end)) as saldo_akhir,
c.tampilkanakunrinci as tampilkanakunrinci,
e.tampilkanakunrinci as tampil,
d.kode as kode_akun

from akunting.transaksi a
inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
inner join akunting.kelompok_laporan_punya_akun b on (a.akun = b.akun)
inner join akunting.kelompok_laporan c on (c.id = b.kelompok_laporan)
inner join akunting.akun d on (a.akun = d.id)
inner join akunting.master_grup_laporan e on (c.master_grup_laporan = e.id)
inner join akunting.jenis_laporan f on (f.id = c.jenis_laporan)

where case when $P{kelompok} = -1 then true else b.kelompok_laporan = $P{kelompok} end
and case when $P{grup} = -1 then true else c.master_grup_laporan = $P{grup} end
and case when $P{nama} = '-1' then true else e.nama ilike $P{nama} end
and (c.aktif is null or c.aktif)
and a1.posting_history is not null
and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end
and case when $P{jenis_laporan} = -1 then true else $P{jenis_laporan}=c.jenis_laporan end
and date(a1.tanggal_transaksi) between date('2000-01-01') and date($P{tanggal2})
group by f.id,e.id,c.id,d.id
order by f.id,e.nomor_urut,e.id,c.urut,c.id,max(b.nomorurut),urut, d.kode]]>
	</queryString>

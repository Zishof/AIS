	</parameter>
	<queryString>
		<![CDATA[select
id,
case when jenis_jurnal = 'Kas Masuk' then 'Masuk' else 'Keluar' end jenis_jurnal,
keterangan,
bln1,
bln2,
bln3,
bln4,
bln5,
bln6,
bln7,
bln8,
bln9,
bln10,
bln11,
bln12,
(select nama from akunting.akun where id = $P{akun}) as akun

from
(
	select
	-1 as id,
	'Kas Masuk' as jenis_jurnal,
	'Saldo' as keterangan,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-01-01') then (debet-kredit) else 0 end) as bln1,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-02-01') then (debet-kredit) else 0 end) as bln2,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-03-01') then (debet-kredit) else 0 end) as bln3,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-04-01') then (debet-kredit) else 0 end) as bln4,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-05-01') then (debet-kredit) else 0 end) as bln5,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-06-01') then (debet-kredit) else 0 end) as bln6,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-07-01') then (debet-kredit) else 0 end) as bln7,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-08-01') then (debet-kredit) else 0 end) as bln8,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-09-01') then (debet-kredit) else 0 end) as bln9,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-10-01') then (debet-kredit) else 0 end) as bln10,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-11-01') then (debet-kredit) else 0 end) as bln11,
	sum(case when date(a.tanggal_transaksi) < date($P{tahun1} || '-12-01') then (debet-kredit) else 0 end) as bln12

	from akunting.transaksi a
	inner join akunting.akun b on (a.akun = b.id)
	inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)

	where b.id = $P{akun}
	and a.posting_history is not null
	and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
	and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,a1.satuan_kerja,satuanKerjas} end
	and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end

	union all

	select
	max(a.id) as id,
	'Kas Masuk' as jenis_jurnal,
	max(b.nama) as keterangan,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-01-01'),'MM-IYYY') then (kredit) else 0 end) as bln1,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-02-01'),'MM-IYYY') then (kredit) else 0 end) as bln2,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-03-01'),'MM-IYYY') then (kredit) else 0 end) as bln3,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-04-01'),'MM-IYYY') then (kredit) else 0 end) as bln4,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-05-01'),'MM-IYYY') then (kredit) else 0 end) as bln5,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-06-01'),'MM-IYYY') then (kredit) else 0 end) as bln6,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-07-01'),'MM-IYYY') then (kredit) else 0 end) as bln7,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-08-01'),'MM-IYYY') then (kredit) else 0 end) as bln8,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-09-01'),'MM-IYYY') then (kredit) else 0 end) as bln9,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-10-01'),'MM-IYYY') then (kredit) else 0 end) as bln10,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-11-01'),'MM-IYYY') then (kredit) else 0 end) as bln11,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-12-01'),'MM-IYYY') then (kredit) else 0 end) as bln12


	from akunting.transaksi a
	inner join akunting.akun b on (a.akun = b.id)
	inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
	inner join (
		select
		a.kode
		from akunting.transaksi a
		inner join akunting.akun b on (a.akun = b.id)
		where b.id = $P{akun}
	) c on (c.kode = a.kode)
	where b.id != $P{akun} and b.debit_credit = -1

	and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
	and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,a1.satuan_kerja,satuanKerjas} end
	and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end
	and a.posting_history is not null
	group by a.akun


	union all

	select
	max(a.id) as id,
	'Kas Keluar' as jenis_jurnal,
	max(b.nama) as keterangan,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-01-01'),'MM-IYYY') then -(debet) else 0 end) as bln1,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-02-01'),'MM-IYYY') then -(debet) else 0 end) as bln2,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-03-01'),'MM-IYYY') then -(debet) else 0 end) as bln3,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-04-01'),'MM-IYYY') then -(debet) else 0 end) as bln4,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-05-01'),'MM-IYYY') then -(debet) else 0 end) as bln5,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-06-01'),'MM-IYYY') then -(debet) else 0 end) as bln6,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-07-01'),'MM-IYYY') then -(debet) else 0 end) as bln7,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-08-01'),'MM-IYYY') then -(debet) else 0 end) as bln8,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-09-01'),'MM-IYYY') then -(debet) else 0 end) as bln9,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-10-01'),'MM-IYYY') then -(debet) else 0 end) as bln10,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-11-01'),'MM-IYYY') then -(debet) else 0 end) as bln11,
	sum(case when to_char(a.tanggal_transaksi,'MM-IYYY') = to_char(date($P{tahun1} || '-12-01'),'MM-IYYY') then -(debet) else 0 end) as bln12

	from akunting.transaksi a
	inner join akunting.akun b on (a.akun = b.id)
	inner join akunting.grup_transaksi a1 on (a1.id=a.grup_transaksi)
	inner join (
		select
		a.kode
		from akunting.transaksi a
		inner join akunting.akun b on (a.akun = b.id)
		where b.id = $P{akun}
	) c on (c.kode = a.kode)
	where b.id != $P{akun} and b.debit_credit = -1

	and case when $X{IN,-1234567899999999999,workspace} then true else $X{IN,g.workspace,workspace} end
	and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,a1.satuan_kerja,satuanKerjas} end
	and case when $P{satuan_kerja} = -1 then true else $P{satuan_kerja}=a1.satuan_kerja end
	and a.posting_history is not null
	group by a.akun
) a
where
abs(bln1) > 0 or abs(bln2) > 0 or abs(bln3) > 0 or abs(bln4) > 0 or abs(bln5) > 0 or abs(bln6) > 0 or abs(bln7) > 0 or abs(bln8) > 0 or abs(bln9) > 0 or abs(bln10) > 0 or abs(bln11) > 0 or abs(bln12) > 0
order by a.jenis_jurnal desc, a.id]]>
	</queryString>

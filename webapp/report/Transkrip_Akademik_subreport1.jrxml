	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="sampai" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(30)]]></defaultValueExpression>
	</parameter>
	<parameter name="mulai" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="mahasiswa" class="java.lang.Long" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.nilai_angka, a.nilai_huruf, a.semester, b.nama, b.sks, b.kode, b.status

from konversi_temp a
left join matakuliah b on (b.id = a.matakuliah)
left join mahasiswa c on (c.id = a.mahasiswa)

where a.mahasiswa = $P{mahasiswa}
group by a.semester, a.nilai_angka, a.nilai_huruf, b.nama, b.sks, b.kode, b.status
order by a.semester]]>
	</queryString>
	<field name="nilai_angka" class="java.lang.Double"/>
	<field name="nilai_huruf" class="java.lang.String"/>
	<field name="semester" class="java.lang.Integer"/>
	<field name="nama" class="java.lang.String"/>
	<field name="sks" class="java.lang.Integer"/>
	<field name="kode" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<variable name="nomor" class="java.lang.Integer">
		<variableExpression><![CDATA[new Integer($P{mulai}.intValue()+$V{REPORT_COUNT}.intValue())]]></variableExpression>
	</variable>

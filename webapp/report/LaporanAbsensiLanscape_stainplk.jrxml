			</staticText>
			<staticText>
				<reportElement key="staticText-31" x="721" y="29" width="61" height="20" uuid="10ac3b6a-480a-4f0c-aeca-81ce9319f444"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>

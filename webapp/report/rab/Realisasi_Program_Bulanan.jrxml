	</parameter>
	<parameter name="keterangan" class="java.lang.String" isForPrompting="false"/>
	<parameter name="mulai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="selesai" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2012-10-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="satuanKerjas" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
(case when f.kode is null then (f.kode || '-' || f.nama) else f.nama end) as sasaran,
(case when g.kode is null then (g.kode || '-' || g.nama) else g.nama end) as indikator,
(d.nilai_target || ' ' || (case when h.nama is not null then h.nama else '' end)) as target,
(j.realisasi || ' ' || (case when h.nama is not null then h.nama else '' end)) as realisasi,
d.output,
i.nama as kendala,
a.keterangan

from rab.acara a
inner join rab.workspace b on (a.workspace = b.id)
left join rab.realisasi_workspace_punya_indikator c on (c.acara = a.id)
left join rab.workspace_punya_indikator d on (d.workspace = b.id)
left join rab.workspace_punya_sasaran e on (b.id = e.workspace)
left join rab.sasaran f on (f.id = e.sasaran)
left join rab.indikator g on (g.id = d.indikator)
left join rab.satuan h on (h.id = d.satuan)
left join rab.realisasi_workspace_punya_kendala i on (i.acara = a.id)
left join rab.realisasi_workspace_punya_indikator j on (j.workspace_punya_indikator = d.id)
where date(a.ppbegin) between date($P{mulai}) and date($P{selesai})
and case when $X{IN,-1234567899999999999,satuanKerjas} then true else $X{IN,b.satuan_kerja,satuanKerjas} end
and b.aktif
order by a.id asc]]>
	</queryString>

	<queryString language="SQL">
		<![CDATA[select
a.nama, a.sasaran, b.indikator, b.lokasi,
b.target1,b.target2,b.target3,b.target4,b.target5,
b.anggaran1,b.anggaran2,b.anggaran3,b.anggaran4,b.anggaran5,
(b.anggaran1+b.anggaran2+b.anggaran3+b.anggaran4+b.anggaran5) as total,
b.keterangan
from rab.renstra_program a
left join rab.renstra_program_punya_indikator b on (a.id = b.renstra_program)
order by a.nama]]>
	</queryString>

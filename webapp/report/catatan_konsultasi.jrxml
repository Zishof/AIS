	<parameter name="perkuliahan" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[436L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
b.catatan as catatan,
b.semester,
(case b.semester%2 when 1 then 'Ganjil' else 'Genap' end) as jenis_semester,
c.nama as nama_dosen,
c.code as code_dosen,
d.nama as mahasiswa,
e.nama as nama_jurusan,
f.nama as fakultas,
b.tahunakademik tahun_ajaran,
b.kelas,
i.code as nip_kaprodi,
i.nama as nama_kaprodi

from krs_mahasiswa b
inner join mahasiswa d on (b.mahasiswa=d.id)
left join dosen c on (b.dosen_pa = c.id)
left join jurusan e on e.id = d.jurusan
left join fakultas f on f.id = e.fakultas
left join dosen i on (e.kaprodi = i.id)

where b.mahasiswa=$P{perkuliahan} and b.semester >= 1 and trim(b.catatan) != '' and b.catatan is not null
order by b.semester ]]>
	</queryString>

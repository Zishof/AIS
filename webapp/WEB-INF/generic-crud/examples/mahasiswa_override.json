  "mandatoryParityWork": [
    "Create a complete method/button parity matrix from the current MahasiswaAction and its ZUL.",
    "Classify each action as reusable helper, refactor-required, legacy-only, or obsolete with approval.",
    "Do not expose password operations until masking, authorization, audit, and output policy are reviewed.",
    "Validate all academic/tenant scopes and role behavior on every list/detail/mutation/export/custom action.",
    "Keep the entity disabled until security, performance, photo, import/export, and parity tests pass.",
    "Create a tab/section/field/save-strategy parity matrix from the current MahasiswaAction complex form.",
    "Implement FULL_PAGE_TABS with conditional/lazy tabs and save-before-enter behavior before enabling the new form.",
    "Do not enable Hapus Data Ini for Mahasiswa through generic policy; use a reviewed domain-specific lifecycle/cancellation policy."
  ],
  "auditPolicy": {
    "enabled": true,
    "globalHistory": true,
    "rowHistory": true,
    "compareBeforeAfter": true,
    "fieldRestore": "REVIEW_REQUIRED_PER_FIELD",
    "manualFieldCorrection": "SUPER_ADMIN_AND_POLICY_ONLY",
    "fullRevisionRestore": "REVIEW_REQUIRED",
    "deepRestore": "REVIEW_REQUIRED_WITH_DEPENDENCY_LIMIT",
    "restoreLatestFromDate": false,
    "adminDeleteActiveRow": false,
    "reason": "Mahasiswa adalah aggregate sensitif dengan relasi akademik dan transaksi; admin delete tidak boleh diaktifkan generik."
  },

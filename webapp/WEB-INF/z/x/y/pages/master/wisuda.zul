<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.WisudaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Wisuda
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onGenerateNoKursi">
					Generate No Wisuda
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPesertaWisuda">
					Peserta Wisuda
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onAlbumWisuda">
					Album Wisuda
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onAlbumProfile">
					Profile Wisuda
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTranskipWisuda">
					Transkip Wisuda
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistik">
					Statistik
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;wisuda&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Wisuda Ke" />
									<textbox id="searchWisudaKe"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="50px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Wisuda Ke" sort="auto(wisudaKe)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Maksimal Quota"
									sort="auto(maksimalQuota)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="15%"
									label="Tanggal" sort="auto(tanggal)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Moto"
									sort="auto(moto)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="15%"
									label="Keterangan" sort="auto(keterangan)" />

									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Aktif" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="generateNoKursi"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="pesertaWisuda"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="albumWisuda"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="albumProfile"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="transkipWisuda"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik">

				</tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Data Wisuda" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="440px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

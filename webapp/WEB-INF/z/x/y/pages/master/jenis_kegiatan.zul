<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.JenisKegiatanAction" width="100%" height="100%">

		<borderlayout width="100%" height="100%">
			<center flex="true">
				<div id="mainContainer" style="width:100%;height:100%"/>
			</center>
		</borderlayout>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Pendataan Jenis Pembayaran" mode="popup" position="center,center" border="normal" width="1000px" height="90%" contentStyle="overflow:auto;">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page cacheable="false" language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>
<div sclass="ais-crud-portal"
	xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- ═══ KARTU FILTER ═══ -->
	<div sclass="ais-crud-filter-card">
		<div sclass="ais-crud-filter-head">
			<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
			<div sclass="ais-crud-filter-actions">
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;perguruan_tinggi&quot;, &quot;Bantuan&quot;);"/>
			</div>
		</div>
		<div sclass="ais-crud-filter-body">
			<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
				<columns>
					<column use="ais.ui.util.MyColumnConfig" width="150px"/>
					<column use="ais.ui.util.MyColumnConfig"/>
					<column use="ais.ui.util.MyColumnConfig" width="150px"/>
					<column use="ais.ui.util.MyColumnConfig"/>
				</columns>
				<rows>
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="Kode Yayasan"/>
						<textbox id="searchkodeyayasan" forward="onOK=onSearchDefault" width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Alamat"/>
						<textbox id="searchalamat" forward="onOK=onSearchDefault" width="95%"/>
					</row>
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="Kode Perguruan Tinggi"/>
						<textbox id="searchkodepergururantinggi" forward="onOK=onSearchDefault" width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Kota"/>
						<textbox id="searchkota" forward="onOK=onSearchDefault" width="95%"/>
					</row>
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="Nama"/>
						<textbox id="searchnama" forward="onOK=onSearchDefault" width="95%"/>
						<checkbox id="abaikanDomain"
							label="Abaikan Domain (tampilkan semua PT)"
							tooltiptext="Khusus super admin: tampilkan SEMUA perguruan tinggi tanpa difilter domain/URL"
							forward="onCheck=onSearchDefault" visible="false"/>
					</row>
				</rows>
			</grid>
		</div>
	</div>

	<!-- ═══ KARTU DATA ═══ -->
	<div sclass="ais-crud-data-card">
		<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
		<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
			<columns>
				<column use="ais.ui.util.MyColumnConfig" width="10%" label="Kode Yayasan" sort="auto(kodeYayasan)"/>
				<column use="ais.ui.util.MyColumnConfig" width="10%" label="Kode Lembaga" sort="auto(kodePerguruanTinggi)"/>
				<column use="ais.ui.util.MyColumnConfig" label="Nama" width="15%" sort="auto(nama)"/>
				<column use="ais.ui.util.MyColumnConfig" label="Alamat" sort="auto(alamat1)"/>
				<column use="ais.ui.util.MyColumnConfig" width="10%" label="Kota" sort="auto(kota)"/>
				<column use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%"/>
				<column use="ais.ui.util.MyColumnConfig" width="56px" label="" align="center"/>
			</columns>
		</grid>
		<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
	</div>

</div>

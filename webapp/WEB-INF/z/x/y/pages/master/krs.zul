<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">





	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.NewKrsAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					KRS
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMkRemedial">
					Remedial
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">


					<borderlayout>
															<north border="none" size="150px" autoscroll="true" flex="false" splittable="false">
				<div style="padding:12px;box-sizing:border-box;">
					<div sclass="ais-crud-filter-card">
						<div sclass="ais-crud-filter-head">
							<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
						<div sclass="ais-crud-filter-actions">
							<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;krs&quot;, &quot;Bantuan&quot;);"/>
						</div>
						</div>
						<div sclass="ais-crud-filter-body">

							<toolbar>
								<label use="ais.ui.util.MyLabelConfig"
									value="Semester" />
								<combobox cols="2"
									forward="onChange=onSearchDefault" id="semesterMulai" />
								<label use="ais.ui.util.MyLabelConfig"
									value="s.d" />
								<combobox cols="2"
									forward="onChange=onSearchDefault" id="semesterSampai" />

								<checkbox use="ais.ui.util.MyCheckboxConfig"
									id="cariSemesterPendek" label="Semester Pendek" />

							</toolbar>
						</div>
					</div>
				</div>
			</north>
						<center border="none"
							id="rowData" flex="true">

						</center>
					</borderlayout>

		</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="mkRemedial"></tabpanel>
			</tabpanels>
		</tabbox>


		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Dosen" visible="false" mode="popup"
			position="center,center" border="normal" width="550px"
			height="440px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.JadwalChecklistPenilaianUmumAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;jadwal_checklist_penilaian_umum&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Diperuntukkan" />
						<combobox id="searchDiperuntukkan"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Grup Angket Umum" />
						<combobox forward="onChange=onSearchDefault"
						id="searchgrupChecklistPenilaianUmum" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox forward="onChange=onSearchDefault"
						id="searchtahunakademik" width="95%" />

						</row>

						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="Grup Angket Dosen" />
						<combobox forward="onChange=onSearchDefault"
						id="searchgrupChecklistPenilaianDosen" width="95%" />


						<label use="ais.ui.util.MyLabelConfig"
						value="Grup Angket Guru" />
						<combobox forward="onChange=onSearchDefault"
						id="searchgrupChecklistPenilaianGuru" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />

						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="Tanggal Mulai"
						sort="auto(startDate)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tanggal Selesai"
						sort="auto(endDate)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Grup Angket"
						width="20%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Diperuntukkan" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Grup Kuosioner" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tahun Akademik"
						sort="auto(tahunAkademik)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Semester" width="10%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Keterangan"
						sort="auto(keterangan)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Jadwal Pembayaran" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="440px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

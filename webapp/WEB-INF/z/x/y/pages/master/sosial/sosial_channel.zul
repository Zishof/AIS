<?page id="sosialChannel" title="SosialChannel" cacheable="false" language="xul/html" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"><window use="ais.ui.util.MyWindow" border="none" id="window" apply="ais.action.master.sosial.SosialChannelAction" width="100%" height="100%"><tabbox width="100%" height="100%"><tabs><tab label="Dashboard"/><tab label="CRUD SosialChannel"/></tabs><tabpanels><tabpanel><vbox width="100%" spacing="12px"><label value="Dashboard SosialChannel" style="font-size:20px;font-weight:bold"/><hlayout spacing="20px"><groupbox mold="3d" width="220px"><caption label="Total Channel"/><label id="totalChannel" style="font-size:26px;font-weight:bold"/></groupbox><groupbox mold="3d" width="220px"><caption label="Channel Aktif"/><label id="totalAktif" style="font-size:26px;font-weight:bold"/></groupbox><groupbox mold="3d" width="220px"><caption label="Smartlink Aktif"/><label id="totalSmartlink" style="font-size:26px;font-weight:bold"/></groupbox></hlayout><label value="Credential tersimpan sekali pada master channel dan tidak ditampilkan kembali pada browser."/></vbox></tabpanel><tabpanel><vbox width="100%"><toolbar><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" forward="onClick=onAdd"/><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Cari" image="/img/search.gif" forward="onClick=onSearchDefault"/></toolbar><grid use="ais.ui.util.MyGrid" fixedLayout="true" width="100%"><columns><column width="120px"/><column/><column width="180px"/></columns><rows><row><label value="Nama Channel"/><textbox id="searchnama" forward="onOK=onSearchDefault"/><checkbox id="searchaktif" label="Hanya aktif" checked="true" forward="onClick=onSearchDefault"/></row></rows></grid><paging use="ais.ui.util.MyPagingKembar" id="paging" detailed="true"/><grid use="ais.ui.util.MyGrid" id="grid" fixedLayout="true" width="100%"><columns><column label="Kode"/><column label="Nama"/><column label="Akun Kas/Bank"/><column label="Mode" width="100px"/><column label="Smartlink" width="100px"/><column label="Aktif" width="70px"/><column label="Aksi" width="75px"/></columns></grid></vbox></tabpanel></tabpanels></tabbox><window use="ais.ui.util.MyWindow" id="addWindow" visible="false" mode="modal" position="center" border="normal" width="620px" height="95%"/></window></zk>

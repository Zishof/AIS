<?page id="socialWorkspace" title="Modul Sosial" cacheable="false" language="xul/html" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"><window use="ais.ui.util.MyWindow" border="none" id="window" apply="ais.action.master.sosial.SosialTransaksiAction" width="100%" height="100%"><custom-attributes kategoriSosial="${arg.kategori}"/><tabbox width="100%" height="100%"><tabs><tab label="Dashboard"/><tab label="CRUD Data"/></tabs><tabpanels><tabpanel><vbox width="100%" spacing="12px"><label id="dashboardJudul" style="font-size:20px;font-weight:bold"/><hlayout spacing="20px"><groupbox mold="3d" width="210px"><caption label="Total Transaksi"/><label id="totalTransaksi" style="font-size:26px;font-weight:bold"/></groupbox><groupbox mold="3d" width="240px"><caption label="Total Terealisasi"/><label id="totalNominal" style="font-size:22px;font-weight:bold"/></groupbox><groupbox mold="3d" width="210px"><caption label="Menunggu Pembayaran"/><label id="totalPending" style="font-size:26px;font-weight:bold"/></groupbox><groupbox mold="3d" width="210px"><caption label="Terbayar/Alokasi"/><label id="totalPaid" style="font-size:26px;font-weight:bold"/></groupbox></hlayout><label value="Dashboard dihitung dari transaksi tenant aktif. Record finansial selain DRAFT dikunci dari CRUD langsung."/></vbox></tabpanel><tabpanel><vbox width="100%"><toolbar><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" forward="onClick=onAdd"/><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Cari" image="/img/search.gif" forward="onClick=onSearchDefault"/></toolbar><grid use="ais.ui.util.MyGrid" fixedLayout="true" width="100%"><columns><column width="100px"/><column width="160px"/><column width="90px"/><column width="160px"/><column width="70px"/><column width="110px"/></columns><rows><row><label value="Nomor"/><textbox id="searchnomor" forward="onOK=onSearchDefault"/><label value="Donatur"/><textbox id="searchdonatur" forward="onOK=onSearchDefault"/><label value="Status"/><combobox id="searchstatus" readonly="true" forward="onChange=onSearchDefault"/></row></rows></grid><paging use="ais.ui.util.MyPagingKembar" id="paging" detailed="true"/><grid use="ais.ui.util.MyGrid" id="grid" fixedLayout="true" width="100%"><columns><column label="Nomor"/><column label="Donatur"/><column label="Jenis Dana"/><column label="Nominal"/><column label="Status" width="110px"/><column label="Tanggal" width="110px"/><column label="Aksi" width="75px"/></columns></grid></vbox></tabpanel></tabpanels></tabbox><window use="ais.ui.util.MyWindow" id="addWindow" visible="false" mode="modal" position="center" border="normal" width="580px"/></window></zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.DosenAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Dosen
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKegiatanKedosenan">
					Kegiatan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onLaporanRuangDosen">
					Ruang
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onDataSK">
					SK
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onDataDosen">
					Laporan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistik">
					Statistik
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKonfigurasiBiodataDosen">
					Konfigurasi
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="uploadFotoMassal" label="Upload Foto" image="/img/new.gif" tooltiptext="Upload banyak foto sekaligus (nama berkas = NIDN, mis. 12345.jpg) ATAU satu berkas ZIP berisi foto-foto ber-nama NIDN. Semua langsung terpasang ke dosen yang cocok." upload="true,maxsize=-1" forward="onUpload=onUploadFotoMassal"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="downloadFotoMassal" label="Download Foto Massal" image="/img/download.png" tooltiptext="Unduh SEMUA foto dosen sebagai satu berkas ZIP (nama tiap foto = NIDN). Pembacaan paralel maks 50 thread agar cepat." forward="onClick=onDownloadFotoMassal"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;dosen&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kode/NIP/NIDN" />
									<textbox id="searchcode"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchfakultas">
									</combobox>
									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchjurusan">
									</combobox>

									<label
									use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchstatus">
									</combobox>

									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Ikatan Kerja" />
									<combobox id="searchIkatanKerjaDosen"
									forward="onChange=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Jabatan Fungsional" />
									<combobox id="searchJabatanFungsionalDosen"
									forward="onChange=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis Tenaga Kependidikan" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchJenisPendidikDanTenagaKependidikan">
									</combobox>
									<label
									use="ais.ui.util.MyLabelConfig" value="Golongan" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchGolonganPegawai">
									</combobox>

									<label
									use="ais.ui.util.MyLabelConfig" value="Lembaga" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchLembagaPengangkat">
									</combobox>

									</row>

									<row spans="10">
									<hbox>
									<checkbox id="searchaktif"
									label="Tampilkan hanya yang ingin ditampilkan"
									checked="true" forward="onClick=onSearchDefault"
									width="95%" />

									<checkbox
									id="searchjugaTampilkanDosenYgBolehMengajarProdiLain"
									label="Jika prodi / fakultas dipilih, tampilkan juga dosen yang boleh mengajar prodi lain"
									checked="true" forward="onClick=onSearchDefault"
									width="95%" />
									</hbox>
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="70px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Kode/NIP"
									sort="auto(code)" />

									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="NIDN/NUPN" sort="auto(code)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Status"
									sort="auto(statusPegawai)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%" visible="false"
									label="Golongan" sort="auto(golongan)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Ikatan Dinas" sort="auto(tetap)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Email"
									sort="auto(email)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Telp."
									sort="auto(telp)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="0%" visible="false"
									label="Pangkat" sort="auto(pangkat)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="0%" visible="false"
									label="Jabatan" sort="auto(jabatan)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="0%"
									label="Fakultas" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Prodi" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Atasan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Aktif"
									id="label_aktif" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="kegiatanDosenan"></tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="ruangDosen"></tabpanel>
				
				<tabpanel use="ais.ui.util.MyTabpanel" id="skDosen"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">

					<tabbox width="100%" height="100%">

						<tabs>
							<tab use="ais.ui.util.MyTabConfig">
								Ekspor Data
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onLaporanDosenHarian">
								Jadwal Per Hari
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onLaporanPerDosen">
								Jadwal Per Dosen
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onLaporanSkDosen">
								SK Dosen
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapDosenTetapPerFakultasDanPerProdi">
								Jadwal Per Dosen Per Prodi
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onLaporanRekapDosenPerFakultasDanPerProdi">
								Rekap Dosen Per Prodi
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapDosenTetap">
								Rekap Dosen Tetap
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapDosenTidakTetap">
								Rekap Dosen Tidak Tetap
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapJumlahDosen">
								Rekap Jumlah Dosen
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapJumlahDosenPerPendidikan">
								Rekap Jumlah Dosen Per Pendidikan
							</tab>
						</tabs>

						<tabpanels>
							<tabpanel use="ais.ui.util.MyTabpanel" id="dataDosen"></tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanDosenHarian"></tabpanel>


							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanPerDosen"></tabpanel>
							
							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanSkDosen"></tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel"
								id="laporanRekapDosenTetapPerFakultasDanPerProdi">



							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel"
								id="laporanRekapDosenPerFakultasDanPerProdi">



							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanRekapDosenTetap">



							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel"
								id="laporanRekapDosenTidakTetap">



							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanRekapJumlahDosen">



							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel"
								id="laporanRekapJumlahDosenPerPendidikan">

							</tabpanel>
						</tabpanels>

					</tabbox>

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik">

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="konfigurasiBiodataDosen">



				</tabpanel>


			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Dosen" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.ParameterTambahanMahasiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onResetParameter" selected="true">
					Manajemen Form
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenKelompok">
					Manajemen Kelompok
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenParameter">
					Manajemen Parameter
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKonfigurasiBiodataMahasiswa">
					Konfigurasi Biodata Mahasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenKelompokAlumni">
					Manajemen Kelompok Alumni
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onAlumni">
					Manajemen Form Alumni
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;parameter_tambahan_mahasiswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Parameter" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Jenjang" />
									<combobox readonly="true"
									id="searchjenjang" forward="onChange=onSearchDefault"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Program" />
									<combobox readonly="true"
									id="searchprogram" forward="onChange=onSearchDefault"
									width="95%" />
									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kelompok" />
									<combobox readonly="true"
									id="searchkelompokParameterTambahanMahasiswa"
									forward="onChange=onSearchDefault" width="95%" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Kelompok" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Fakultas" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Prodi" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Program" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Angkatan" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Parameter"
									width="8%" sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Lampiran"
									width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Tipe" width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nilai" width="8%" />

									<column
									use="ais.ui.util.MyColumnConfig"
									label="Tampil di Tahun Angkatan" width="19%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="9%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenKelompok">



				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenParameter"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="konfigurasiBiodataMahasiswa">



				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenKelompokAlumni">



				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenAlumni">



				</tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Parameter" visible="false" mode="popup" position="center,center" border="normal" width="650px" height="300px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

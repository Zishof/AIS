<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.PostingBiayaAdministrasiPembayaranMahasiswaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;posting_biaya_administrasi_pembayaran_mahasiswa&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="NIM/No. Registrasi/No. Ujian" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<combobox forward="onChange=onSearchDefault"
						id="searchfakultas" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig"
						label="Hanya yang belum posting"
						forward="onCheck=onSearchDefault" id="searchtampil" width="95%" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" label="Telah posting" forward="onCheck=onSearchDefault" id="searchtelahtampil" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Jenis Pembayaran" />
						<combobox id="searchjenispembayaran"
						forward="onChange=onSearchDefault" width="95%" />

						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Jenis Semester" />
						<combobox forward="onChange=onSearchDefault"
						id="jenissemester" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Jenjang" />
						<combobox id="searchjenjang"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Angkatan" />
						<decimalbox id="searchtahun"
						forward="onOK=onSearchDefault" width="95%" />
						</row>
						<row>



						<label use="ais.ui.util.MyLabelConfig"
						value="Tanggal Mulai" />
						<datebox id="tglMulai"
						use="ais.ui.util.MyDatebox" readonly="true"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Tanggal Sampai" />
						<datebox id="tglSampai"
						use="ais.ui.util.MyDatebox" readonly="true"
						forward="onChange=onSearchDefault" width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<!-- Aksi massal: Posting / Batalkan Posting seluruh transaksi yang tampil di daftar -->
				<div sclass="ais-bulk-posting-actions" style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; align-items:center; padding:8px 6px 2px 6px;">
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Posting Semua" image="/img/svg/check2-circle.svg" style="font-weight:700; color:#15803d;" tooltiptext="Catat ke jurnal semua transaksi yang sudah valid dan tampil di daftar" forward="onClick=onPostingSemua"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Batalkan Posting Semua" image="/img/svg/warning-outline.svg" style="font-weight:700; color:#b45309;" tooltiptext="Tarik kembali dari jurnal semua transaksi yang tampil di daftar" forward="onClick=onBatalkanPostingSemua"/>
				</div>
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>


						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Ref" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="NIM" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Nama" />

						<column
						use="ais.ui.util.MyColumnConfig" width="8%" align="right"
						label="Nilai" />

						<column
						use="ais.ui.util.MyColumnConfig" label="Prodi" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Fakultas" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="Semester" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Waktu" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Validator" />
						<column
						use="ais.ui.util.MyColumnConfig" width="20%"
						label="Transaksi" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Posting" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Posting" />


					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.koperasi.DepositoAroKoperasiAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Perpanjangan Otomatis Deposito (ARO)</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="prosesAro" label="Proses ARO Sekarang" image="/img/refresh.gif"
							tooltiptext="Proses perpanjangan/penandaan jatuh tempo sekarang (selain otomatis harian)"
							forward="onClick=onProsesAro"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="segarkan" label="Segarkan" image="/img/refresh.gif"
							tooltiptext="Muat ulang daftar" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;deposito_aro_koperasi&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
			</div>

			<div sclass="ais-crud-data-card">
				<div id="ringkasanHost" width="100%"/>
			</div>

			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" label="Anggota"/>
						<column use="ais.ui.util.MyColumnConfig" label="Produk"/>
						<column use="ais.ui.util.MyColumnConfig" label="Nominal"/>
						<column use="ais.ui.util.MyColumnConfig" label="Jatuh Tempo"/>
						<column use="ais.ui.util.MyColumnConfig" width="110px" label="Perpanjangan"/>
						<column use="ais.ui.util.MyColumnConfig" width="80px" label="ARO"/>
						<column use="ais.ui.util.MyColumnConfig" width="150px" label="Status"/>
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

	</window>

</zk>

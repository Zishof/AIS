<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window border="none" id="window"
		apply="ais.action.master.koperasi.PembelianAnggotaKoperasiAction" width="100%"
		height="100%">


		<tabbox width="100%" height="100%">

			<tabs>
				<tab id="tab1" image="/img/user_male.png"
					label="Input Data Pembayaran">
				</tab>
				<tab id="tab2" image="/img/excel.png"
					label="Daftar Pembayaran">
				</tab>
			</tabs>
			<tabpanels>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tambahData" height="600px">



				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">

					<div sclass="ais-crud-portal">
							<div sclass="ais-crud-filter-card">
								<div sclass="ais-crud-filter-head">
									<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
									<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;pembelian_anggota_koperasi&quot;, &quot;Bantuan&quot;);"/></div>
								</div>
								<div sclass="ais-crud-filter-body">
									<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
										<columns>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
								</columns>
										<rows>
											<row>
										<label use="ais.ui.util.MyLabelConfig" value="Kode Anggota" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchkode" width="95%" />
										<label use="ais.ui.util.MyLabelConfig" value="Nama Anggota" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchnama" width="95%" />

										<label use="ais.ui.util.MyLabelConfig" value="Kode Pembayaran" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchmr" width="95%" />

									</row>
										</rows>
									</grid>
								</div>
							</div>
							<div sclass="ais-crud-data-card">
								<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
								<grid fixedLayout="true"
											id="grid" mold="paging" pageSize="25">
											<columns menupopup="auto">
												<column use="ais.ui.util.MyColumnConfig" label="Kode"
													width="7%" sort="auto(kode)" />
												<column use="ais.ui.util.MyColumnConfig" width="10%"
													label="Nama" />
												<column use="ais.ui.util.MyColumnConfig" width="7%"
													label="Wkt. Pem." />
												

												<column use="ais.ui.util.MyColumnConfig" width="15%"
													label="Alamat" />

												<column use="ais.ui.util.MyColumnConfig" width="7%"
													align="right" label="Total Tagihan" />

												
												<column use="ais.ui.util.MyColumnConfig" width="7%"
													align="right" label="Tunai" />

												<column use="ais.ui.util.MyColumnConfig" width="7%"
													align="right" label="Non Tunai" />

												<column use="ais.ui.util.MyColumnConfig" width="7%"
													align="right" label="Total Bayar" />

												<column use="ais.ui.util.MyColumnConfig" width="7%"
													align="right" label="Kembali" />

												<column use="ais.ui.util.MyColumnConfig" label="Posting" />
												<column use="ais.ui.util.MyColumnConfig" width="56px"
													label=""  align="center"/>
											</columns>

										</grid>
								<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
							</div>
						</div>

		

		


				</tabpanel>
			</tabpanels>

		</tabbox>


	</window>


</zk>
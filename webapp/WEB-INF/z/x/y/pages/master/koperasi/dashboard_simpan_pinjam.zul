<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.koperasi.DashboardSimpanPinjamAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU TINDAKAN ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Tindakan</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="refresh" label="Segarkan" image="/img/refresh.gif"
							tooltiptext="Muat ulang dasbor" forward="onClick=onRefresh"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="perbaruiKol" label="Perbarui Kolektibilitas" image="/img/svg/refresh.svg"
							tooltiptext="Perbarui otomatis kualitas pinjaman (Lancar s/d Macet) dari lama tunggakan"
							forward="onClick=onPerbaruiKolektibilitas"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;dashboard_simpan_pinjam&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
			</div>

			<!-- ═══ KARTU DATA (DASBOR) ═══ -->
			<div sclass="ais-crud-data-card">
				<div id="dashHost" width="100%"/>
			</div>

		</div>

	</window>

</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.koperasi.LaporanSimpanPinjamAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU TINDAKAN ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Tindakan</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="refresh" label="Segarkan" image="/img/refresh.gif"
							tooltiptext="Muat ulang laporan" forward="onClick=onRefresh"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="suratTeguran" label="Surat Teguran" image="/img/print.png"
							tooltiptext="Buat surat teguran untuk anggota yang menunggak (siap cetak)"
							forward="onClick=onSuratTeguran"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="bungaSimpanan" label="Bunga Simpanan" image="/img/Money-Calculator-icon.png"
							tooltiptext="Hitung perkiraan bunga simpanan anggota bulan berjalan (bisa diunduh Excel)"
							forward="onClick=onBungaSimpanan"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;laporan_simpan_pinjam&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
			</div>

			<!-- ═══ KARTU DATA (LAPORAN) ═══ -->
			<div sclass="ais-crud-data-card">
				<div id="dashHost" width="100%"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="suratWindow" title="Surat Teguran" visible="false" mode="popup" position="center,center" border="normal" width="820px" height="620px">
		</window>

	</window>

</zk>

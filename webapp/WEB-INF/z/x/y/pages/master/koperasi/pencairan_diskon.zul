<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.koperasi.PencairanDiskonAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Catat pencairan baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;pencairan_diskon&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="120px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
							<column use="ais.ui.util.MyColumnConfig" width="80px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
						</columns>
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Kode / Member"/>
								<textbox forward="onOK=onSearchDefault" id="searchnama" width="95%"
									tooltiptext="Ketik no. pencairan atau nama member lalu tekan Enter"/>
								<label use="ais.ui.util.MyLabelConfig" value="Status"/>
								<combobox id="searchstatus" width="95%" readonly="true"
									forward="onSelect=onSearchDefault"
									tooltiptext="Saring berdasarkan status pencairan"/>
							</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" width="14%" label="No. Pencairan" sort="auto(kodePencairan)"/>
						<column use="ais.ui.util.MyColumnConfig" label="Member"/>
						<column use="ais.ui.util.MyColumnConfig" width="12%" label="Toko"/>
						<column use="ais.ui.util.MyColumnConfig" width="12%" label="Nominal" align="right"/>
						<column use="ais.ui.util.MyColumnConfig" width="12%" label="Via"/>
						<column use="ais.ui.util.MyColumnConfig" width="9%" label="Status"/>
						<column use="ais.ui.util.MyColumnConfig" width="11%" label="Waktu"/>
						<column use="ais.ui.util.MyColumnConfig" width="10%" label=""/>
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Pencairan Diskon" visible="false" mode="popup"
			position="center,center" border="normal" width="680px" height="92%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

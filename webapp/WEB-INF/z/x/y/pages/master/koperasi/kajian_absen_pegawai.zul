<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.koperasi.KajianAbsenPegawaiAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU KETERANGAN ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Absen Kajian Saya (Voucher Pegawai)</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kajian_absen_pegawai&quot;, &quot;Bantuan&quot;);"/>
					</div>
				</div>
				<div sclass="ais-crud-filter-body">
					<label id="infoStatus" value="Memuat..." />
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" label="Kajian" />
						<column use="ais.ui.util.MyColumnConfig" label="Tanggal" width="18%" />
						<column use="ais.ui.util.MyColumnConfig" label="Status / Aksi" width="30%" />
					</columns>
				</grid>
			</div>

		</div>

	</window>

</zk>

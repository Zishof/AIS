<?page cacheable="false" language="xul/html" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
 <window use="ais.ui.util.MyWindow" border="none" apply="ais.action.master.koperasi.GrupAturanDiskonAction" width="100%" height="100%">
  <div sclass="ais-crud-portal">
   <div sclass="ais-crud-filter-card"><div sclass="ais-crud-filter-head"><span sclass="ais-crud-filter-title">Grup Aturan Diskon</span><div sclass="ais-crud-filter-actions"><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" forward="onClick=onAdd"/><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Muat Ulang" image="/img/search.gif" forward="onClick=onSearchDefault"/></div></div><div sclass="ais-crud-filter-body"><grid use="ais.ui.util.MyGrid"><rows><row><textbox id="searchnama" visible="false"/><checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Hanya aktif" checked="true" forward="onClick=onSearchDefault"/></row></rows></grid></div></div>
   <div sclass="ais-crud-data-card"><paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging"/><grid use="ais.ui.util.MyGrid" sclass="dgrid" id="grid"><columns><column use="ais.ui.util.MyColumnConfig" label="Nama Grup"/><column use="ais.ui.util.MyColumnConfig" label="ID Toko"/><column use="ais.ui.util.MyColumnConfig" label="Nilai"/><column use="ais.ui.util.MyColumnConfig" label="Prioritas &amp; Kombinasi"/><column use="ais.ui.util.MyColumnConfig" label="Aktif"/><column use="ais.ui.util.MyColumnConfig" label=""/></columns></grid><paging visible="false" id="paging2" use="ais.ui.util.MyPagingKembar"/></div>
  </div>
  <window use="ais.ui.util.MyWindow" id="addWindow" title="Grup Aturan Diskon" visible="false" mode="popup" position="center,center" border="normal" width="760px" height="95%"/>
 </window>
</zk>

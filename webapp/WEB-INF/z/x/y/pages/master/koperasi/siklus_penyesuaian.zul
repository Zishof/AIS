<?page id="siklusPenyesuaian" title="Jurnal Penyesuaian Berkala" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- Satu composer melayani tiga proses siklus akuntansi; jenisnya ditentukan atribut di bawah. -->
	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.koperasi.SiklusAkuntansiKantinAction" width="100%" height="100%">

		<custom-attributes jenis="penyesuaian"/>

		<div sclass="ais-crud-portal" id="siklusHost"></div>

	</window>
</zk>

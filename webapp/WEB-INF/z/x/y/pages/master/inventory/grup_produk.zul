<?page id="grupProdukZul" title="Grup Produk (Harga Terpusat)" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.inventory.GrupProdukAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- KARTU FILTER -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah grup baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari grup" forward="onClick=onSearchDefault"/>
					</div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="100px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
							<column use="ais.ui.util.MyColumnConfig" width="100px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
						</columns>
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Nama Grup"/>
								<textbox forward="onOK=onSearchDefault" id="searchnama" width="95%"
									tooltiptext="Ketik nama grup lalu tekan Enter"/>
								<label use="ais.ui.util.MyLabelConfig" value=""/>
								<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%"/>
							</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- KARTU DATA -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" label="Kode Grup" sort="auto(kode)"/>
						<column use="ais.ui.util.MyColumnConfig" label="Nama Grup" sort="auto(nama)"/>
						<column use="ais.ui.util.MyColumnConfig" label="HPP / Harga Beli"/>
						<column use="ais.ui.util.MyColumnConfig" label="Harga Jual"/>
						<column use="ais.ui.util.MyColumnConfig" width="10%" label="Produk Anggota"/>
						<column use="ais.ui.util.MyColumnConfig" width="56px" label="" align="center"/>
						<column use="ais.ui.util.MyColumnConfig" width="56px" label="" align="center"/>
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Grup Produk" visible="false" mode="popup"
			position="center,center" border="normal" width="580px" height="520px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>

</zk>

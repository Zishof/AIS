<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.BeasiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Beasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Persyaratan Beasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Seleksi Penerima Beasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig">Jenis Beasiswa</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPenerima">
					Laporan Penerima Beasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistik">
					Statistik
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;beasiswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Program" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Mahasiswa"
									id="label_mahasiswa" />
									<bandbox id="searchmahasiswa"
									use="ais.action.master.helper.AmbilDataMahasiswaBanbox"
									width="95%" />



									<label
									use="ais.ui.util.MyLabelConfig" value="Keterangan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchketerangan"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun" />
									<combobox id="searchtahun"
									forward="onChange=onSearchDefault" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="50px"
									visible="false" label="" />
									<column
									use="ais.ui.util.MyColumnConfig" width="6%" label="Tahun"
									sort="auto(tahun)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama" width="13%"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jenis" width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Tanggal Buka" sort="auto(tanggalBuka)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Tanggal Tutup" sort="auto(tanggalTutup)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="6%"
									label="Jenjang" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Fakultas" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Prodi" />
									<column
									use="ais.ui.util.MyColumnConfig" width="11%"
									label="Instansi/Sponsor/Perusahaan" sort="auto(instansi)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="4%" label="Dibuka" />
									<column
									use="ais.ui.util.MyColumnConfig" width="11%"
									label="IPK/SKS/Angka Kredit" />

									<column
									use="ais.ui.util.MyColumnConfig" width="9%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%"
						height="100%"
						src="/WEB-INF/z/x/y/pages/master/beasiswa/persyaratan_beasiswa.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%"
						height="100%"
						src="/WEB-INF/z/x/y/pages/master/beasiswa/seleksi_penerima_beasiswa.zul">
					</include>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%"
						height="100%"
						src="/WEB-INF/z/x/y/pages/master/jenis_penerima_beasiswa.zul">
					</include>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanPenerima"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik">

				</tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Beasiswa" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

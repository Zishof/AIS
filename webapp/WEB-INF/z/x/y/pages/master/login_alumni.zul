<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.maintenance.LoginAlumniAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;login_alumni&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="20%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Masukkan Nama Lengkap / Email / NIM" />
						<textbox use="ais.ui.util.MyTextbox"
						id="namaLengkap">
						</textbox>
						</row>



						<row id="tanggalLahirData">
						<label use="ais.ui.util.MyLabelConfig"
						value="Masukkan Tanggal Lahir Anda" />
						<grid fixedLayout="true" use="ais.ui.util.MyGrid" width="100%">
						<columns>
						<column
						use="ais.ui.util.MyColumnConfig">
						<vbox>
						<label
						use="ais.ui.util.MyLabelConfig" value="Tahun">
						</label>
						<combobox id="tahun"
						width="60px" readonly="true">
						</combobox>
						</vbox>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<vbox>
						<label
						use="ais.ui.util.MyLabelConfig" value="Bulan">
						</label>
						<combobox id="bulan"
						width="80px" readonly="true">
						</combobox>
						</vbox>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<vbox>
						<label
						use="ais.ui.util.MyLabelConfig" value="Tanggal">
						</label>
						<combobox id="tanggal"
						width="60px" readonly="true">
						</combobox>
						</vbox>
						</column>
						</columns>

						</grid>

						</row>
						<row>
						<box width="100%" align="end">
						<button use="ais.ui.util.MyButtonConfig"
						label="L O G I N" forward="onClick=onLogin" id="cari">
						</button>
						</box>
						<box width="100%" align="start">
						<button use="ais.ui.util.MyButtonConfig"
						label="R E S E T" forward="onClick=onReset" id="reset">
						</button>
						</box>
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="20%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

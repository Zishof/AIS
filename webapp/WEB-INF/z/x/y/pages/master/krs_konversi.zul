<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KrsKurikulumAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;krs_konversi&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="15%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="35%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="15%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="35%">
						</column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="NIM" />
						<label use="ais.ui.util.MyLabelConfig"
						id="searchnim" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						<label use="ais.ui.util.MyLabelConfig"
						id="searchjurusan" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama Mahasiswa" />
						<label use="ais.ui.util.MyLabelConfig"
						id="searchnama" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<label use="ais.ui.util.MyLabelConfig"
						id="searchfakultas" />
						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Angkatan" />
						<label use="ais.ui.util.MyLabelConfig"
						id="searchangkatan" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Program" />
						<label use="ais.ui.util.MyLabelConfig"
						id="searchprogram" />
						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Semester Mulai" />
						<combobox forward="onChange=onSearchDefault"
						id="semesterMulai" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Semester Sampai" />
						<combobox forward="onChange=onSearchDefault"
						id="semesterSampai" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="50px" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Tahun Akademik" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Semester"
						id="colSemester" />
						<column
						use="ais.ui.util.MyColumnConfig" width="0%" id="colTahapan"
						label="Tahapan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Status" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="IP/IPK" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="SKS/SKSK" />
						<column
						use="ais.ui.util.MyColumnConfig" width="22%"
						label="Keterangan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Komentar" />
						<column
						use="ais.ui.util.MyColumnConfig" width="20%"
						label="Catatan Dosen" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Dosen" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="440px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.bni.BniRequestAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;bni_request&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>


						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Trx#" />
						<textbox forward="onOK=onSearchDefault"
						id="searchtrxId" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox forward="onChange=onSearchDefault"
						id="tahunAkademik" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Status" />
						<combobox forward="onChange=onSearchDefault"
						id="status" width="95%" />




						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Mhs/Siswa" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnim" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Mulai" />
						<datebox use="ais.ui.util.MyDatebox"
						forward="onChange=onSearchDefault" id="searchmulai" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Sampai" />
						<datebox use="ais.ui.util.MyDatebox"
						forward="onChange=onSearchDefault" id="searchsampai"
						width="95%" />
						</row>


						<row id="hbFakultasLabel">

						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<combobox forward="onChange=onSearchDefault"
						id="searchfakultas" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>

						<row id="hbYayasan">

						<label use="ais.ui.util.MyLabelConfig"
						value="Yayasan" />
						<combobox forward="onChange=onSearchDefault"
						id="searchyayasan" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Sekolah" />
						<combobox id="searchsekolah"
						forward="onChange=onSearchDefault" width="95%" />


						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="" width="50px" />
						<column
						use="ais.ui.util.MyColumnConfig" label="#Trx" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Cus#" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Waktu" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nominal" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Biaya Admin"
						width="8%" id="biayaAdminCol" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Pemb#" />
						<column
						use="ais.ui.util.MyColumnConfig" label="TA/Smt" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Status" width="20%" />


					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

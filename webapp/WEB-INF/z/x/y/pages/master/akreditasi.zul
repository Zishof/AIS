<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.AkreditasiAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;akreditasi&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="95px" />
						<column use="ais.ui.util.MyColumnConfig" />
						<column use="ais.ui.util.MyColumnConfig" width="105px" />
						<column use="ais.ui.util.MyColumnConfig" />
						<column use="ais.ui.util.MyColumnConfig" width="80px" />
						<column use="ais.ui.util.MyColumnConfig" />

						</columns>
						<rows>
						<row spans="6">
						<html><![CDATA[
						<div class="dms-hero-zul">
						<div>
						<div class="dms-hero-title">Document Management System</div>
						<div class="dms-hero-subtitle">Kelola folder utama, subfolder, dan lampiran dokumen institusi dengan tampilan seperti explorer.</div>
						</div>
						</div>
						]]></html>
						</row>
						<row sclass="dms-filter-row">
						<label use="ais.ui.util.MyLabelConfig" value="Cari" />
						<textbox forward="onOK=onSearchDefault" id="searchnama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
						<bandbox use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox" id="searchparent" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Prodi" />
						<combobox id="searchjurusan" forward="onChange=onSearchDefault" width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig" width="42px" />
						<column use="ais.ui.util.MyColumnConfig" label="Folder Dokumen" />
						<column use="ais.ui.util.MyColumnConfig" label="Jenis" width="14%" />
						<column use="ais.ui.util.MyColumnConfig" label="Lembaga" width="14%" />
						<column use="ais.ui.util.MyColumnConfig" label="Lingkup" width="8%" />
						<column use="ais.ui.util.MyColumnConfig" label="Tingkat" width="9%" />
						<column use="ais.ui.util.MyColumnConfig" label="Periode" width="12%" />
						<column use="ais.ui.util.MyColumnConfig" label="Prodi" width="13%" />
						<column use="ais.ui.util.MyColumnConfig" label="Isi" width="9%" />
						<column use="ais.ui.util.MyColumnConfig" label="Aktif" width="75px" />
						<column use="ais.ui.util.MyColumnConfig" label="" width="56px"  align="center"/>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Folder Dokumen" visible="false" mode="popup" position="center,center" border="normal" width="620px" height="95%" />

		<zscript><![CDATA[addWindow.setVisible(false);]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.library.AnggotaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;anggota&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						</column>

						</columns>
						<rows>
						<row>
						<label
						use="ais.ui.util.MyLabelConfig" value="Anggota" />
						<textbox
						forward="onOK=onSearchDefault" id="searchkode" width="95%" />

						<label
						use="ais.ui.util.MyLabelConfig" value="Tipe Anggota" />
						<combobox
						forward="onChange=onSearchDefault" id="searchTipeAnggota"
						width="95%" />
						<label
						use="ais.ui.util.MyLabelConfig" value="Jenis Anggota" />
						<combobox
						forward="onChange=onSearchDefault" id="searchJenisAnggota"
						width="95%" />
						<label
						use="ais.ui.util.MyLabelConfig" value="Prodi" />
						<combobox
						forward="onChange=onSearchDefault" id="searchProdi"
						width="95%" />
						<label
						use="ais.ui.util.MyLabelConfig" value="Program" />
						<combobox
						forward="onChange=onSearchDefault" id="searchprogram"
						width="95%" />
						<label
						use="ais.ui.util.MyLabelConfig" value="Status" />
						<combobox
						forward="onChange=onSearchDefault" id="searchStatus"
						width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="65px" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Kode" width="10%" sort="auto(kode)" />

						<column use="ais.ui.util.MyColumnConfig"
						label="Nama" width="10%" sort="auto(nama)" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Jenis Identitas" sort="auto(jenisIdentitas)" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Identitas" sort="auto(kodeIdentitas)" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Jenis" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Tipe" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Telp." />
						<column use="ais.ui.util.MyColumnConfig"
						label="Hp" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Email" />
						<column use="ais.ui.util.MyColumnConfig"
						width="20%" label="Alamat" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Status" width="5%" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Tgl Daftar" width="8%" />
						<column use="ais.ui.util.MyColumnConfig"
						width="10%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Anggota" visible="false" mode="popup" position="center,center" border="normal" width="750px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.library.KaryaTulisItemAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<tabbox id="tabboxKarya" width="100%">
			<tabs>
			<tab label="Pendataan Karya Ilmiah" />
			<tab id="tabPenerbitanKarya" label="Penerbitan Katalog Publik"
			forward="onSelect=onSearchPublikasi" />
			</tabs>
			<tabpanels>
			<tabpanel>

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;karya_tulis_item&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>



						<label use="ais.ui.util.MyLabelConfig" value="Judul" />
						<textbox
						forward="onOK=onSearchDefault" id="searchnama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Title" />
						<textbox
						forward="onOK=onSearchDefault" id="searchtema" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Bahasa" />
						<textbox
						forward="onOK=onSearchDefault" id="searchbahasa"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Edisi" />
						<textbox
						forward="onOK=onSearchDefault" id="searchedisi" width="95%" />


						<label use="ais.ui.util.MyLabelConfig" value="Status" />
						<combobox
						forward="onChange=onSearchDefault" id="searchstatus" />

						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Pengarang" />
						<textbox
						forward="onOK=onSearchDefault" id="searchpengarang"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Catatan" />
						<textbox
						forward="onOK=onSearchDefault" id="searchcatatan"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Penerbit" />
						<bandbox
						use="ais.action.master.library.helper.AmbilDataPenerbitBanbox"
						forward="onOK=onSearchDefault" id="searchpenerbit"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Jenis Item" />
						<combobox
						forward="onChange=onSearchDefault" id="searchjenisItem"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
						<bandbox width="95%"
						use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
						id="satuanKerjaBanbox" />
						</row>
						
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="ISSN" />
						<textbox forward="onOK=onSearchDefault" id="searchissn" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Bukan Ambil Dari Google" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="bukanAmbilDariGoogle" forward="onCheck=onSearchDefault" label="Bukan ambil dari google"> </checkbox>
					</row>
					</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig" width="40px" label="" />
						<column use="ais.ui.util.MyColumnConfig" label="Judul/Title"
						width="20%" />
						<column use="ais.ui.util.MyColumnConfig" label="Domain" />
						<column use="ais.ui.util.MyColumnConfig" label="Pengaju"
						width="7%" />
						<column use="ais.ui.util.MyColumnConfig" label="Status"
						width="5%" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Pemeriksa" />
						<column use="ais.ui.util.MyColumnConfig" label="Direktori"
						width="10%" />
						<column use="ais.ui.util.MyColumnConfig" label="Pengarang"
						width="10%" />
						<column use="ais.ui.util.MyColumnConfig" label="Penerbit"
						width="10%" />
						<column use="ais.ui.util.MyColumnConfig" label="Tgl dibuat"
						width="7%" />
						<column use="ais.ui.util.MyColumnConfig" label="Tgl terbit"
						width="7%" />
						<column use="ais.ui.util.MyColumnConfig" width="5%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>


			</tabpanel>

			<!-- TAB PENERBITAN: menentukan karya ilmiah mana yang tampil di katalog publik -->
			<tabpanel>

			<div sclass="ais-crud-filter-card">
			<div sclass="ais-crud-filter-head">
			<span sclass="ais-crud-filter-title">Penerbitan Karya Ilmiah ke Katalog Publik</span>
			<div sclass="ais-crud-filter-actions">
			<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="findPublikasi"
			label="Cari" image="/img/search.gif" tooltiptext="Cari karya ilmiah"
			forward="onClick=onSearchPublikasi" />
			<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="pilihSemuaPublikasi"
			label="Pilih Semua" image="/img/svg/check2.svg"
			tooltiptext="Tandai seluruh baris pada halaman ini"
			forward="onClick=onPilihSemuaPublikasi" />
			<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="btnTerbitkan"
			label="Terbitkan" image="/img/svg/check2-circle.svg"
			tooltiptext="Tampilkan karya terpilih di katalog publik"
			forward="onClick=onTerbitkanTerpilih" />
			<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="btnTarikPublikasi"
			label="Tarik dari Publik" image="/img/svg/warning-outline.svg"
			tooltiptext="Sembunyikan karya terpilih dari katalog publik"
			forward="onClick=onTarikTerpilih" />
			</div>
			</div>

			<div sclass="ais-crud-filter-body">
			<grid use="ais.ui.util.MyGrid" sclass="ais-crud-filter-grid" fixedLayout="true">
			<columns>
			<column use="ais.ui.util.MyColumnConfig" width="110px" />
			<column use="ais.ui.util.MyColumnConfig" />
			<column use="ais.ui.util.MyColumnConfig" width="110px" />
			<column use="ais.ui.util.MyColumnConfig" />
			<column use="ais.ui.util.MyColumnConfig" width="110px" />
			<column use="ais.ui.util.MyColumnConfig" />
			</columns>
			<rows>
			<row>
			<label use="ais.ui.util.MyLabelConfig" value="Judul" />
			<textbox forward="onOK=onSearchPublikasi" id="searchPublikasiNama" width="95%" />
			<label use="ais.ui.util.MyLabelConfig" value="Penulis" />
			<textbox forward="onOK=onSearchPublikasi" id="searchPublikasiPengarang" width="95%" />
			<label use="ais.ui.util.MyLabelConfig" value="Status Terbit" />
			<combobox id="searchPublikasiStatus" width="95%" readonly="true"
			forward="onChange=onSearchPublikasi" />
			</row>
			</rows>
			</grid>
			</div>
			</div>

			<div sclass="ais-crud-data-card">
			<paging use="ais.ui.util.MyPagingKembar" visible="false" id="pagingPublikasi"
			detailed="true" />
			<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="gridPublikasi">
			<columns>
			<column use="ais.ui.util.MyColumnConfig" width="45px" label="" />
			<column use="ais.ui.util.MyColumnConfig" label="Judul" width="30%" />
			<column use="ais.ui.util.MyColumnConfig" label="Penulis" width="18%" />
			<column use="ais.ui.util.MyColumnConfig" label="Tipe" width="10%" />
			<column use="ais.ui.util.MyColumnConfig" label="Tahun" width="7%" />
			<column use="ais.ui.util.MyColumnConfig" label="Status Terbit" width="15%" />
			<column use="ais.ui.util.MyColumnConfig" label="" width="12%" />
			</columns>
			</grid>
			</div>

			</tabpanel>
			</tabpanels>
			</tabbox>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Item" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

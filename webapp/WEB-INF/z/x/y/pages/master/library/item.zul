<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.library.ItemAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;item&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="ISBN" />
						<textbox forward="onOK=onSearchDefault"
						id="searchisbn" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="ISSN" />
						<textbox forward="onOK=onSearchDefault"
						id="searchissn" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama/Judul" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Bahasa" />
						<textbox forward="onOK=onSearchDefault"
						id="searchbahasa" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Edisi" />
						<textbox forward="onOK=onSearchDefault"
						id="searchedisi" width="95%" />


						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Pengarang" />
						<textbox forward="onOK=onSearchDefault"
						id="searchpengarang" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Catatan" />
						<textbox forward="onOK=onSearchDefault"
						id="searchcatatan" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Penerbit" />
						<bandbox
						use="ais.action.master.library.helper.AmbilDataPenerbitBanbox"
						forward="onOK=onSearchDefault" id="searchpenerbit" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Jenis Item" />
						<combobox forward="onChange=onSearchDefault"
						id="searchjenisItem" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tipe Item" />
						<combobox forward="onChange=onSearchDefault"
						id="searchtipeItem" width="95%" />


						</row>

						<row spans="1,1,1,1,1,1,1,1,2">
						<label use="ais.ui.util.MyLabelConfig"
						value="Barcode" />
						<textbox forward="onOK=onSearchDefault"
						id="searchbarcode" width="95%" />


						<label id="labelsearchjurusan"
						use="ais.ui.util.MyLabelConfig" value="Jurusan" />
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Kategori" />
						<textbox forward="onOK=onSearchDefault"
						id="searchkategori" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun" />
						<intbox forward="onOK=onSearchDefault"
						id="searchtahun" width="95%" />
						<vbox>
						<checkbox id="searchaktif"
						label="Tampilkan hanya yang aktif" checked="true"
						forward="onClick=onSearchDefault" width="95%" />
						<checkbox
						use="ais.ui.util.MyCheckboxConfig" id="tampilkan"
						forward="onCheck=onSearchDefault"
						label="Hanya ada di perpustakaan">
						</checkbox>
						<checkbox
						use="ais.ui.util.MyCheckboxConfig" id="bukanAmbilDariGoogle"
						forward="onCheck=onSearchDefault"
						label="Bukan ambil dari google">
						</checkbox>
						</vbox>
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="40px" label="" />
						<column
						use="ais.ui.util.MyColumnConfig" width="70px" />
						<column
						use="ais.ui.util.MyColumnConfig" label="ISBN/ISSN" width="10%"
						sort="auto(isbn)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nama/Judul"
						width="10%" sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Jenis" width="6%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="Penerbit" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="Kategori" />
						<column
						use="ais.ui.util.MyColumnConfig" width="4%" label="Tipe" />
						<column
						use="ais.ui.util.MyColumnConfig" width="4%" label="Bahasa" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Pengarang"
						width="8%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Penaklikan" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tahun" width="4%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%"
						label="Tersedia di" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Item" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

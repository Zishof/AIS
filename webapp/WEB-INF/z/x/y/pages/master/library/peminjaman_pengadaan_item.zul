<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.library.PeminjamanPengadaanItemAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ STASIUN SCAN (PEMINJAMAN) ═══
			     Kotak besar untuk scan barcode buku / kode anggota. Tekan Enter setelah scan. -->
			<div sclass="ais-scan-hero ais-scan-hero-borrow">
				<div sclass="ais-scan-hero-head">
					<image src="/img/svg/journal-bookmark-white.svg" />
					<div>
						<div sclass="ais-scan-hero-title">Peminjaman Buku / Item</div>
						<div sclass="ais-scan-hero-sub">Scan barcode buku, atau ketik kode anggota, lalu tekan Enter.</div>
					</div>
				</div>
				<div sclass="ais-scan-input-wrap">
					<div sclass="ais-scan-input-ico" />
					<textbox forward="onOK=onKodeAnggota" id="searchkodeangota"
						style="font-size:26px;font-weight:800;height:50px;border:0;background:transparent;width:100%;box-sizing:border-box;" />
				</div>
				<div sclass="ais-scan-hint">
					<div sclass="ais-scan-hint-ico" />
					<label use="ais.ui.util.MyLabelConfig" value="Arahkan scanner ke barcode, atau ketik manual lalu tekan Enter." />
				</div>
			</div>

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Dashboard" image="/img/svg/dashboard-chart.svg" tooltiptext="Papan informasi sirkulasi perpustakaan" onClick="ais.action.master.library.helper.DasboardPerpustakaan.buka();"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;peminjaman_pengadaan_item&quot;, &quot;Bantuan&quot;);"/>
					</div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="110px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="110px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="110px" />
							<column use="ais.ui.util.MyColumnConfig" />
						</columns>
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Peminjaman#" />
								<textbox forward="onOK=onSearchDefault" id="searchkode" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="Perpustakaan" />
								<bandbox use="ais.action.master.library.helper.AmbilDataPerpustakaanBanbox" forward="onChange=onSearchDefault" id="searchperpustakaan" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="Anggota" />
								<bandbox use="ais.action.master.library.helper.AmbilDataAnggotaBanbox" forward="onChange=onSearchDefault" id="searchanggota" width="95%" />
							</row>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Mulai" />
								<datebox use="ais.ui.util.MyDatebox" forward="onChange=onSearchDefault" id="searchmulai" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="Sampai" />
								<datebox use="ais.ui.util.MyDatebox" forward="onChange=onSearchDefault" id="searchsampai" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="Barcode" />
								<textbox forward="onOK=onSearchDefault" id="searchbarkode" width="95%" />
							</row>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Judul Buku" />
								<textbox forward="onOK=onSearchDefault" id="searchjudul" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="ISBN Buku" />
								<textbox forward="onOK=onSearchDefault" id="searchisbn" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="" />
								<checkbox use="ais.ui.util.MyCheckboxConfig" label="Belum Dikembalikan" id="searchBelumDikembalikan" forward="onCheck=onSearchDefault" />
							</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" width="40px" label="" />
						<column use="ais.ui.util.MyColumnConfig" width="65px" />
						<column use="ais.ui.util.MyColumnConfig" label="Kode" sort="auto(kode)" />
						<column use="ais.ui.util.MyColumnConfig" label="Perpustakaan" />
						<column use="ais.ui.util.MyColumnConfig" label="Peminjam" />
						<column use="ais.ui.util.MyColumnConfig" label="Status" />
						<column use="ais.ui.util.MyColumnConfig" label="Dibuat Oleh" />
						<column use="ais.ui.util.MyColumnConfig" label="Dibuat Tgl" />
						<column use="ais.ui.util.MyColumnConfig" label="Ringkasan" width="20%" />
						<column use="ais.ui.util.MyColumnConfig" label="Disetujui Oleh" />
						<column use="ais.ui.util.MyColumnConfig" label="Disetujui Tgl" />
						<column use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Peminjaman Item" visible="false" mode="popup" position="center,center" border="normal" width="97%" height="97%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

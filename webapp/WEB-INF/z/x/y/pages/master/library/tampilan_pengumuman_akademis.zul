<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.library.TampilanPengumumanLibraryAction" width="100%"
		height="100%" contentStyle="overflow:auto">

		<borderlayout>
			<west id="menu" flex="true" width="300px"></west>
			<center border="none" flex="true">

				<tabbox width="100%" height="100%">

					<tabs id="tabs">
						<tab use="ais.ui.util.MyTabConfig" selected="true">Dafar Pengumuman</tab>
					</tabs>

					<tabpanels id="tabpanels">

						<tabpanel use="ais.ui.util.MyTabpanel">

							<panel use="ais.ui.util.MyPanel"
								width="100%" height="100%" id="panel"
								title="Pengumuman e-Library">
								<panelchildren>
									<borderlayout>

										<center border="none"
											flex="true">
											<borderlayout>
												<north border="none"
													open="true">
													<grid use="ais.ui.util.MyGrid"
														fixedLayout="true">
														<columns>
															<column use="ais.ui.util.MyColumnConfig"
																width="100px">
															</column>
															<column use="ais.ui.util.MyColumnConfig"></column>
															<column use="ais.ui.util.MyColumnConfig"
																width="100px">
															</column>
															<column use="ais.ui.util.MyColumnConfig"></column>

														</columns>
														<rows>

															<row>

																<label use="ais.ui.util.MyLabelConfig"
																	value="Pengumuman Tanggal Mulai" />
																<datebox
																	use="ais.ui.util.MyDatebox"
																	forward="onChange=onSearchDefault" id="searchmulai"
																	width="95%" />


																<label use="ais.ui.util.MyLabelConfig"
																	value="Pengumuman Tanggal Sampai" />
																<datebox
																	use="ais.ui.util.MyDatebox" id="searchsampai"
																	forward="onChange=onSearchDefault" width="95%" />

															</row>



															<row spans="4">

																<toolbar>

																	<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
																		tooltiptext="Cari data"
																		forward="onClick=onSearchDefault" id="find"
																		label="Cari" image="/img/search.gif">
																	</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;tampilan_pengumuman_akademis&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
															</row>
														</rows>
													</grid>

												</north>
												<center border="none" flex="true">

													<grid use="ais.ui.util.MyGrid"
														fixedLayout="true" id="grid" mold="paging"
														pageSize="10">
														<columns>
															<column use="ais.ui.util.MyColumnConfig"
																width="0px" />
															<column use="ais.ui.util.MyColumnConfig"
																width="100%" />
														</columns>

													</grid>


												</center>
												<south border="none">
													<paging
														visible="false" id="paging" />
												</south>
											</borderlayout>
										</center>
									</borderlayout>
								</panelchildren>
							</panel>


						</tabpanel>
					</tabpanels>
				</tabbox>

			</center>
		</borderlayout>


	</window>


</zk>
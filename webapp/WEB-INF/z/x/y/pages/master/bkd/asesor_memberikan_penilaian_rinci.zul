<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.bkd.PenilaianAsesorAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;asesor_memberikan_penilaian_rinci&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>


						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


						</columns>
						<rows>
						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="Belum dinilai : ">
						</label>
						<vbox>
						<checkbox
						use="ais.ui.util.MyCheckboxConfig" id="searchbelum"
						label="Tampil yg blm dinilai"
						forward="onClick=onSearchDefault">
						</checkbox>
						<checkbox
						forward="onCheck=onSearchDefault"
						use="ais.ui.util.MyCheckboxConfig" id="terdapatSksBeban"
						label="Terdapat SKS Beban" checked="true">
						</checkbox>
						</vbox>

						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox forward="onChange=onSearchDefault"
						id="searchTahunAjaran" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Semester" />
						<combobox forward="onChange=onSearchDefault"
						id="searchJenisSemester" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Jenis" />
						<combobox forward="onChange=onSearchDefault"
						id="searchJenisPenilaian" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Asesor" />
						<combobox forward="onChange=onSearchDefault"
						id="searchAsesorPenunjangKinerjaDosen" width="95%" />


						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" id="colPegawai"
						label="Pegawai" width="20%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Informasi" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Aksi" width="20%" />


					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Asesor Penunjang Kinerja Dosen" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.bkd.LaporanBKDAction" width="100%"
		height="100%">

		<borderlayout>

			<center border="none">
				<tabbox width="100%" height="100%">

					<tabs>
						<tab use="ais.ui.util.MyTabConfig"
							selected="true">
							Ringkasan
						</tab>
						<tab use="ais.ui.util.MyTabConfig"
							forward="onClick=onPeringkat">
							Peringkat berdasar Bidang
						</tab>
						<tab use="ais.ui.util.MyTabConfig"
							forward="onClick=onPeringkatSemua">
							Peringkat
						</tab>
					</tabs>

					<tabpanels>
						<tabpanel use="ais.ui.util.MyTabpanel" id="ringkasan"></tabpanel>
						<tabpanel use="ais.ui.util.MyTabpanel" id="peringkat"></tabpanel>
						<tabpanel use="ais.ui.util.MyTabpanel" id="peringkatSemua"></tabpanel>
					</tabpanels>
				</tabbox>
			</center>
		</borderlayout>

	</window>



</zk>
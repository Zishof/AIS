<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sirkulasisurat.KembaliSuratItemAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;pengembalian_surat&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


						</columns>
						<rows>
						<row spans="8" visible="false">
						<vbox align="center" pack="center"
						width="100%">


						<label use="ais.ui.util.MyLabelConfig"
						value="Untuk pengembalian scan nomor/agenda yang dipinjam atau scan barcode peminjam di sini">
						</label>
						<textbox
						forward="onOK=onKodePeminjamSurat" id="searchkodeangota"
						width="95%" />

						</vbox>

						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Kembali#" />
						<textbox forward="onOK=onSearchDefault"
						id="searchkode" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Peminjam" />
						<bandbox
						use="ais.action.master.sirkulasisurat.helper.AmbilDataPeminjamSuratBanbox"
						forward="onChange=onSearchDefault" id="searchpeminjamSurat"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Mulai" />
						<datebox use="ais.ui.util.MyDatebox"
						forward="onChange=onSearchDefault" id="searchmulai" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Sampai" />
						<datebox use="ais.ui.util.MyDatebox"
						forward="onChange=onSearchDefault" id="searchsampai"
						width="95%" />
						</row>


						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Nomor/Agenda" />
						<textbox forward="onOK=onSearchDefault"
						id="searchbarkode" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Perihal" />
						<textbox forward="onOK=onSearchDefault"
						id="searchjudul" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Satuan Kerja" />
						<bandbox
						use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
						id="searchparent" width="95%">
						</bandbox>
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="40px" label="" />

						<column
						use="ais.ui.util.MyColumnConfig" label="Kode"
						sort="auto(kode)" />

						<column
						use="ais.ui.util.MyColumnConfig" label="Peminjam" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Ringkasan"
						width="30%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Dibuat Oleh" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Dibuat Tgl" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Disetujui Oleh" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Disetujui Tgl" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Keterangan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Kembali Pengadaan Item" visible="false" mode="popup" position="center,center" border="normal" width="99%" height="99%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.PengecekanPendaftaranSidangKeuanganAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;cek_daftarsidang_keuangan&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="200px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Mahasiswa" id="label_mahasiswa" />
						<bandbox cols="50"
						use="ais.action.master.helper.AmbilDataMahasiswaDaftarSidangBanbox"
						id="bandboxMahasiswa" readonly="true" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<button use="ais.ui.util.MyButtonConfig"
						label="C H E C K" forward="onClick=onPilihMahasiswa">
						</button>
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>
						<row id="rowNama" visible="false">
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama Mahasiswa" />
						<textbox id="nama" cols="50" maxlength="100"
						readonly="true" />
						</row>
						<row id="rowFakultas" visible="false">
						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<textbox id="fakultas" cols="50"
						maxlength="100" readonly="true" />
						</row>
						<row id="rowJurusan" visible="false">
						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						<textbox id="jurusan" cols="50"
						maxlength="100" readonly="true" />
						</row>
						<row id="rowJudulSkripsi" visible="false">
						<label use="ais.ui.util.MyLabelConfig"
						value="Judul Skripsi" />
						<textbox id="judulSkripsi" cols="50"
						rows="5" maxlength="1000" readonly="true" />
						</row>
						<row id="rowDosenPembimbing1" visible="false">
						<label use="ais.ui.util.MyLabelConfig"
						value="Dosen Pembimbing 1" />
						<textbox id="dosenPembimbing1" cols="50"
						maxlength="100" readonly="true" />
						</row>
						<row id="rowDosenPembimbing2" visible="false">
						<label use="ais.ui.util.MyLabelConfig"
						value="Dosen Pembimbing 2" />
						<textbox id="dosenPembimbing2" cols="50"
						maxlength="100" readonly="true" />
						</row>
						<row id="rowCekKeuangan" visible="false">

						<label use="ais.ui.util.MyLabelConfig"
						value="Bagian Keuangan Menyetujui" id="labelCekKeuangan" />
						<checkbox use="ais.ui.util.MyCheckboxConfig"
						id="cekKeuangan" visible="false" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="200px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page cacheable="false" language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

<div sclass="ais-crud-portal">

	<!-- ═══ KARTU FILTER ═══ -->
	<div sclass="ais-crud-filter-card">
		<div sclass="ais-crud-filter-head">
			<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
			<div sclass="ais-crud-filter-actions">
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
			<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;jenis_kegiatan&quot;, &quot;Bantuan&quot;);"/></div>
		</div>
		<div sclass="ais-crud-filter-body">
			<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
				<columns>

				<column
				use="ais.ui.util.MyColumnConfig" width="150px">
				</column>
				<column
				use="ais.ui.util.MyColumnConfig">
				</column>
				<column
				use="ais.ui.util.MyColumnConfig">
				</column>
				<column
				use="ais.ui.util.MyColumnConfig">
				</column>

				</columns>
				<rows>
				<row>
				<label
				use="ais.ui.util.MyLabelConfig" value="Nama Pembayaran" />
				<textbox id="searchnama"
				forward="onOK=onSearchDefault" width="95%" />

				<checkbox id="searchaktif"
				label="Tampilkan hanya yg aktif" checked="true"
				forward="onClick=onSearchDefault" width="95%" />
				</row>
				</rows>
			</grid>
		</div>
	</div>

	<!-- ═══ KARTU DATA ═══ -->
	<div sclass="ais-crud-data-card">
		<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
		<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
			<columns>


				<column
				use="ais.ui.util.MyColumnConfig" width="5%" label="Kode Pembayaran"
				sort="auto(kode)" />
				<column
				use="ais.ui.util.MyColumnConfig" width="15%"
				label="Nama Pembayaran" sort="auto(namaKegiatan)" />
				<column
				use="ais.ui.util.MyColumnConfig" width="8%"
				label="Syarat KRS" />
				<column
				use="ais.ui.util.MyColumnConfig" width="8%"
				label="Syarat Ujian" />
				<column
				use="ais.ui.util.MyColumnConfig" width="8%"
				label="Syrt Lihat Nilai" />
				<column
				use="ais.ui.util.MyColumnConfig" width="8%"
				label="Syarat Aktif" />
				<column
				use="ais.ui.util.MyColumnConfig" width="8%"
				label="Syarat Login" />
				<column
				use="ais.ui.util.MyColumnConfig" width="13%"
				label="Keterangan Pembayaran" sort="auto(keterangan)" />
				<column
				use="ais.ui.util.MyColumnConfig" width="5%"
				label="Min smt" />

				<column
				use="ais.ui.util.MyColumnConfig" width="5%"
				label="Mks smt" />
				<column
				use="ais.ui.util.MyColumnConfig" width="0px"
				label="Pembayaran Lain" />
				<column
				use="ais.ui.util.MyColumnConfig" label="Default Pemb." />
				<column
				use="ais.ui.util.MyColumnConfig" label="Aktif" />
				<column
				use="ais.ui.util.MyColumnConfig" width="10%" label="" />

			</columns>
		</grid>
		<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
	</div>

</div>

</zk>

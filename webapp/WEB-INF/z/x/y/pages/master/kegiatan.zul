<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KegiatanAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Catatan Pembayaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onCicilan">
					Pembayaran Angsuran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onSejarah">
					Sejarah Pembayaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTunggakan">
					Tunggakan Pembayaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPerbandinganPembayaran">
					Perbandingan Pembayaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onBelumBayar">
					Sama Sekali Belum Bayar
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onSudahBayar">
					Data Pembayaran
				</tab>
			</tabs>
			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<tabbox width="100%" height="100%">
						<tabs>
							<tab use="ais.ui.util.MyTabConfig" selected="true">Dasbor</tab>
							<tab use="ais.ui.util.MyTabConfig">Data</tab>
						</tabs>
						<tabpanels>
							<tabpanel use="ais.ui.util.MyTabpanel">
								<vbox width="100%" height="100%">
									<html id="progressHtml" visible="false" />
									<html id="dashboardHtml">
										<![CDATA[
<div>
  <div>
    <div>Dasbor Catatan Pembayaran</div>
    <div>Ringkasan utama akan tampil otomatis setelah data selesai dimuat. Gunakan filter untuk melihat data yang lebih spesifik.</div>
  </div>
</div>
]]>
									</html>
								</vbox>
							</tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel">

					<borderlayout>
															<north border="none" size="256px" autoscroll="true" flex="false" splittable="false">
				<div style="padding:12px;box-sizing:border-box;">
					<div sclass="ais-crud-filter-card">
						<div sclass="ais-crud-filter-head">
							<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
						<div sclass="ais-crud-filter-actions">
							<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kegiatan&quot;, &quot;Bantuan&quot;);"/>
						</div>
						</div>
						<div sclass="ais-crud-filter-body">

							<grid use="ais.ui.util.MyGrid"
								fixedLayout="true" sclass="ais-crud-filter-grid">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="110px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="110px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>

									<column
										use="ais.ui.util.MyColumnConfig" width="110px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="110px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="110px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
								</columns>
								<rows>



									<row>
										<label
											use="ais.ui.util.MyLabelConfig"
											value="NIM/No. Reg./No. Ujian" />
										<textbox
											forward="onOK=onSearchDefault" id="searchnama" width="95%" />
										<label
											use="ais.ui.util.MyLabelConfig" value="Fakultas" />
										<combobox
											forward="onChange=onSearchDefault" id="searchfakultas"
											width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Prodi" />
										<hbox>
											<combobox id="searchjurusan"
												forward="onChange=onSearchDefault" cols="6" />
											<label use="ais.ui.util.MyLabelConfig" value="Jenjang"/>
											<combobox id="searchjenjang"
												forward="onChange=onSearchDefault" cols="6" />
										</hbox>
										<label
											use="ais.ui.util.MyLabelConfig" value="Thn Akademik" />

										<hbox>
											<combobox cols="5"
												forward="onChange=onSearchDefault" id="ta" width="95%" />
											<label use="ais.ui.util.MyLabelConfig" value="Semester"/>
											<combobox cols="5"
												forward="onChange=onSearchDefault" id="jenissemester"
												width="95%" />
										</hbox>

										<label
											use="ais.ui.util.MyLabelConfig" value="Jenis Pembayaran" />
										<combobox
											id="searchJenisPembayaran" forward="onChange=onSearchDefault"
											width="95%" />

									</row>
									<row spans="1,1,1,1,1,1,1,1,3">
										<label
											use="ais.ui.util.MyLabelConfig" value="Tahun Angkatan" />
										<decimalbox id="searchtahun"
											forward="onOK=onSearchDefault" width="95%" />
										<label
											use="ais.ui.util.MyLabelConfig" value="Program" />
										<combobox id="searchprogram"
											forward="onChange=onSearchDefault" width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Tanggal" />


										<hbox>
											<datebox
												use="ais.ui.util.MyDatebox" id="start"
												forward="onChange=onSearchDefault" cols="5" />
											<label use="ais.ui.util.MyLabelConfig" value="s.d"></label>
											<datebox
												use="ais.ui.util.MyDatebox" id="end"
												forward="onChange=onSearchDefault" cols="5" />
										</hbox>


										<label
											use="ais.ui.util.MyLabelConfig" value="Mahasiswa" />
										<hbox>
											<textbox
												forward="onOK=onSearchDefault" id="searchnamamhs"
												width="80px" />
											<label use="ais.ui.util.MyLabelConfig" value="PA"/>
											<bandbox id="searchdosen"
												use="ais.action.master.helper.AmbilDataDosenBanbox"
												width="80px" />
											<textbox visible="false"
												forward="onOK=onSearchDefault" id="searchrekon"
												width="60px" />
										</hbox>

										<hbox>
											<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchlunas"
												label="Lunas" forward="onClick=onSearchDefault" width="95%" />
											<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif"
												label="Blm lunas" forward="onClick=onSearchDefault"
												width="95%" />
											<checkbox use="ais.ui.util.MyCheckboxConfig" checked="true"
												id="searchTelahMembayar" label="Membayar"
												forward="onClick=onSearchDefault" width="95%" />
											<checkbox use="ais.ui.util.MyCheckboxConfig"
												id="searchKelebihan" label="Kelebihan"
												forward="onClick=onSearchDefault" width="95%" />
											<checkbox use="ais.ui.util.MyCheckboxConfig"
												id="searchBelumMembayar" label="Blm byr"
												forward="onClick=onSearchDefault" width="95%" />
										</hbox>
									</row>


									<row spans="10">

										<toolbar>
								<toolbarbutton
												use="ais.ui.util.MyToolbarbuttonConfig"
												tooltiptext="Cari data" forward="onClick=onSearchDefault"
												id="find" label="Cari" image="/img/search.gif">
											</toolbarbutton>

											

											<toolbarbutton
												use="ais.ui.util.MyToolbarbuttonConfig" upload="true"
												tooltiptext="Upload Data Pembayaran"
												forward="onUpload=onUploadData" id="uploadData"
												label="Upload Pembayaran" image="/img/edit.gif">
											</toolbarbutton>

											<toolbarbutton
												use="ais.ui.util.MyToolbarbuttonConfig"
												tooltiptext="Download Format Pembayaran"
												forward="onClick=onDownloadFormat"
												id="downloadFormatPembayaran" label="Download Format"
												image="/img/edit.gif">
											</toolbarbutton>

											<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktifAja"
												label="Hanya yang aktif" checked="true"
												forward="onClick=onSearchDefault" width="95%" />

										</toolbar>
									</row>
								</rows>
							</grid>
						</div>
					</div>
				</div>
			</north>
						<center border="none"
							flex="true">

							<grid use="ais.ui.util.MyGrid"
								sclass="fgrid">
								<rows>
									<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-atas" height="64px" /></row>
									<row>
										<paging use="ais.ui.util.MyPagingKembar" visible="false"
											id="paging" detailed="true" />
									</row>
									<row>
										<grid use="ais.ui.util.MyGrid"
											sclass="dgrid" fixedLayout="true" id="grid">
											<columns>
												<column
													use="ais.ui.util.MyColumnConfig" label="" width="50px"
													visible="false" />
												<column
													use="ais.ui.util.MyColumnConfig" width="10%"
													label="Ref/Reg/NIM" />
												<column
													use="ais.ui.util.MyColumnConfig" width="10%" label="Nama" />
												<column
													use="ais.ui.util.MyColumnConfig" width="7%" align="right"
													label="Dibayar" />
												<column
													use="ais.ui.util.MyColumnConfig" width="7%" align="right"
													label="Tagihan" />
												<column
													use="ais.ui.util.MyColumnConfig" width="5%" align="right"
													label="Denda" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Prodi" />

												<column
													use="ais.ui.util.MyColumnConfig" width="5%" label="Smt" />
												<column
													use="ais.ui.util.MyColumnConfig" width="0%" label="Bulan" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Terkahir Update" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Jns. Trs" />
												<column
													use="ais.ui.util.MyColumnConfig" width="5%" label="Lunas" />
												<column
													use="ais.ui.util.MyColumnConfig" width="5%" label="Aktif" />
												<column
													use="ais.ui.util.MyColumnConfig" width="14%" label="" />
											</columns>

										</grid>




									</row>
									<row><paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar" /></row>
									<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-bawah" height="128px" /></row>
								</rows>
							</grid>
						</center>
					</borderlayout>

		</tabpanel>
						</tabpanels>
					</tabbox>

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="cicilan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="sejarah"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tunggakan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="perbandinganPembayaran"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="belumBayar"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="sudahBayar"></tabpanel>


			</tabpanels>
		</tabbox>


	</window>


</zk>
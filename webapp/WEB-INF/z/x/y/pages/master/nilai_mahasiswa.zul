<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>


<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.NewNilaiMahasiswaAction" width="100%"
		height="100%">

		<tabbox width="100%" height="100%">

			<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Dasbor
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Nilai
				</tab>
			</tabs>

			<tabpanels>
			
				<tabpanel use="ais.ui.util.MyTabpanel" id="dasborPanel"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<tabbox width="100%" height="100%">

						<tabs>

							<tab use="ais.ui.util.MyTabConfig"
								selected="true">
								Nilai
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onTampilKHS">
								KHS
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onTampilTranskripAkademik">
								Transkrip
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onTampilRekamanNilai">
								IPK
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onAsisten">
								Sebagai Asisten Dosen
							</tab>


						</tabs>

						<tabpanels>

							<tabpanel use="ais.ui.util.MyTabpanel">

								<borderlayout>


									<center border="none" flex="true">
										<borderlayout>
											<north border="none"
												open="true">
												<toolbar>
													<label
														use="ais.ui.util.MyLabelConfig" value="Semester" />
													<combobox cols="2"
														forward="onChange=onSearchDefault" id="semesterMulai" />
													<label
														use="ais.ui.util.MyLabelConfig" value="s.d" />
													<combobox cols="2"
														forward="onChange=onSearchDefault" id="semesterSampai" />

													<checkbox
														use="ais.ui.util.MyCheckboxConfig"
														id="cariSemesterPendek" label="Semester Pendek" />

													<toolbarbutton
														use="ais.ui.util.MyToolbarbuttonConfig" label="Refresh"
														image="/img/options.png"
														forward="onClick=onSearchDefaultKeDatabase">
													</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;nilai_mahasiswa&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>

											</north>
											<center border="none" id="rowData" flex="true">

											</center>

										</borderlayout>
									</center>
								</borderlayout>






							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel" id="kartuHasilStudi"></tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="transkripAkademik"></tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="rekamanNilai"></tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="asisten"></tabpanel>
						</tabpanels>
					</tabbox>
				</tabpanel>
			</tabpanels>
		</tabbox>


		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Penilaian" visible="false" mode="popup"
			position="center,center" border="normal" width="550px"
			height="440px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.MonitorKRSMahasiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen KRS
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onKrsEkstrakurikuler">
					KRS Ekstrakurikuler
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRiwayat">
					Log KRS
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onSejarah">
					KRS Mhs
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onDashboardRekapPengambilanKRSMahasiswa">
					Rekap KRS
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistikPengambilanKRS">
					Statistik KRS
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPersetujuanKRS">
					Persetujuan KRS
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onDashboardKomentarMahasiswaKRS">
					Komentar-Komentar
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMaksimalSKSMahasiswa">
					Maksimal SKS Mahasiswa
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onSKSdanIPKMahasiswa">
					SKS dan IPK Mahasiswa
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatusMahasiswaAmbilMatakuliah">
					Status mahasiswa ambil matakuliah
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistik">
					Statistik
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onHistory">
					History
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										id="find" label="Cari" image="/img/search.gif"
										tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;monitor_krs_mahasiswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>

									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Angkatan" />
									<decimalbox id="searchtahun"
									forward="onOK=onSearchDefault" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Status"/>
									<combobox width="95%"
									id="searchstatus" forward="onChange=onSearchDefault" />
									<label use="ais.ui.util.MyLabelConfig" value="Thn. Ajaran"/>
									<combobox
									forward="onChange=onSearchDefault" id="searchTahunAjaran"
									width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Jns Sem."/>
									<combobox
									forward="onChange=onSearchDefault" id="searchJenisSemester"  width="95%"/>

									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Jenjang" />
									<combobox id="searchjenjang"
									forward="onChange=onSearchDefault" width="95%" />
									</row>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig"
									value="Status Awal Mahasiswa" />
									<combobox
									id="searchStatusAwalMahasiswa"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Kelas" />
									<bandbox
									use="ais.action.master.helper.AmbilDataKelasBanbox"
									forward="onChange=onSearchDefault" id="searchkelas"
									width="95%" />

									</row>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="NIM" />
									<textbox id="searchnim"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Program" />
									<combobox id="searchprogram"
									forward="onChange=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Dosen PA" />
									<bandbox id="searchdosen"
									use="ais.action.master.helper.AmbilDataDosenBanbox"
									width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" visible="false"
									value="Tidak Mempunyai Dosen PA" />
									<checkbox
									use="ais.ui.util.MyCheckboxConfig" id="searchdosenPA"
									visible="false" forward="onCheck=onSearchDefault" />


									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="70px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="NIM"
									sort="auto(nim)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="9%"
									label="Angkatan" sort="auto(tahunangkatan)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Kelas" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" visible="false"
									label="WNI/WNA" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Dosen PA" />

									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="Prodi" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Status/Awal" />

									<column
									use="ais.ui.util.MyColumnConfig" width="20%"
									label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="56px"
									label="⋯" align="center" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="krsEkstrakurikuler" visible="false"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="riwayatKrs"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="sejarahKrs"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapPengambilanKRSMahasiswa"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="statistikPengambilanKRSMahasiswa">
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="persetujuanKRS"></tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="dashboardKomentarMahasiswaKRS"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="dashboardMaksimalSKSMahasiswa"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="sksDanIPKMahasiswa"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="statusMahasiswaAmbilMatakuliah"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="history">

				</tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

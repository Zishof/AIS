<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.akunting.KelompokLaporanDanDetailAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Setup Laporan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJenisLaporan">
					Jenis Laporan
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										id="find" label="Cari" image="/img/search.gif"
										tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kelompok_laporan_dan_detail&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig"
									value="Keterangan" />
									<textbox forward="onOK=onSearchDefault"
									id="searchketerangan" cols="30" />
									<label use="ais.ui.util.MyLabelConfig" value="Jenis" />
									<combobox id="searchJenisLaporan"
									forward="onChange=onSearchDefault" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Nama Grup" />
									<combobox id="searchNamaMasterGrupLaporan"
									forward="onChange=onSearchDefault" width="95%" />
									<label use="ais.ui.util.MyLabelConfig"
									value="Grup Laporan" />
									<combobox id="searchMasterGrupLaporan"
									forward="onChange=onSearchDefault" width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig" width="40px" />
									<column use="ais.ui.util.MyColumnConfig" width="40px"
									label="No. Urut" sort="auto(urut)" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Jenis Laporan" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Grup Laporan" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Ket. Grup Laporan" />
									<column use="ais.ui.util.MyColumnConfig" width="20%"
									label="Sub Laporan" />
									<column use="ais.ui.util.MyColumnConfig" width="8%"
									label="Qty Akun" />
									<column use="ais.ui.util.MyColumnConfig" width="5%"
									label="Rinci" />
									<column use="ais.ui.util.MyColumnConfig" width="5%"
									label="Aktif" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="jenisLaporanTab"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.akunting.KasKecilAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Kas Kecil
				</tab>
				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onStatistik">
					Statistik
				</tab>
				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onMonitor">
					Monitor
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">
						<style><![CDATA[
.kk-bukti { display:block; max-width:150px; line-height:1.6; }
.kk-bukti a, .kk-bukti .z-a, .kk-bukti .z-label { display:inline-block; max-width:132px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; vertical-align:middle; }
.kk-bukti img { vertical-align:middle; margin-right:2px; }
]]></style>

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kas_kecil&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig"
									value="Judul Kas Kecil" />
									<textbox forward="onOK=onSearchDefault"
									id="serachnama" width="95%" />
									<label use="ais.ui.util.MyLabelConfig"
									value="Kode Kas Kecil" />
									<textbox forward="onOK=onSearchDefault"
									id="serachkode" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox forward="onChange=onSearchDefault"
									id="searchstatus" width="95%" />


									</row>

									<row>
									<label use="ais.ui.util.MyLabelConfig"
									value="Jenis Kas Kecil" />
									<textbox forward="onOK=onSearchDefault"
									id="serachjenis" width="95%" />

									<label use="ais.ui.util.MyLabelConfig"
									value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>
									<label></label>

									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />
									</row>
															<row>
							<label use="ais.ui.util.MyLabelConfig" value="Dari Tanggal" />
							<datebox use="ais.ui.util.MyDatebox" id="start" format="dd/MM/yyyy" forward="onChange=onSearchDefault" width="95%" />
							<label use="ais.ui.util.MyLabelConfig" value="Sampai Tanggal" />
							<datebox use="ais.ui.util.MyDatebox" id="end" format="dd/MM/yyyy" forward="onChange=onSearchDefault" width="95%" />
						</row>
</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column width="10%" use="ais.ui.util.MyColumnConfig"
									label="Kode/Nama" />
									<column width="10%" use="ais.ui.util.MyColumnConfig"
									label="Jenis" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									align="right" label="Saldo" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									align="right" label="Nilai Pengajuan" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									align="right" label="Sisa" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Pengajuan" />

									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Persetujuan" />

									<column use="ais.ui.util.MyColumnConfig"
									label="Keterangan" />
									<column use="ais.ui.util.MyColumnConfig" width="5%"
									label="Aktif" />
									<column use="ais.ui.util.MyColumnConfig" width="8%"
									label="Status" />
									<column use="ais.ui.util.MyColumnConfig" width="56px"
									label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="monitor"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Uang Muka" visible="false" mode="popup" position="center,center" border="normal" width="90%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

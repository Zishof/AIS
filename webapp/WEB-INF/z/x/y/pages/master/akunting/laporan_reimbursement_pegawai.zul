<?page title="Laporan Reimbursement" cacheable="false" language="xul/html" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
  <window apply="ais.action.master.akunting.ReimbursementLaporanAction" width="100%" height="100%" border="none">
    <style>.rl-wrap{padding:10px;background:#f4f7fb}.rl-hero{background:linear-gradient(120deg,#17396b,#087d8b);color:#fff;padding:18px;border-radius:12px}.rl-title{font-size:22px;font-weight:bold}.rl-card{background:#fff;border:1px solid #dfe7ef;border-radius:10px;padding:12px;margin-top:10px}.rl-info{color:#526b80}</style>
    <div sclass="rl-wrap">
      <div sclass="rl-hero"><label sclass="rl-title" value="Laporan Reimbursement Pegawai"/><separator/><label value="Detail transaksi, rekap status/kategori, aging SLA, dan workbook Excel siap audit."/></div>
      <div sclass="rl-card"><hbox align="center" spacing="7px"><label value="Mulai"/><datebox use="ais.ui.util.MyDatebox" id="start" format="dd/MM/yyyy"/><label value="Sampai"/><datebox use="ais.ui.util.MyDatebox" id="end" format="dd/MM/yyyy"/><label value="Status"/><combobox id="status" readonly="true" width="130px"/><label value="Kategori"/><combobox id="kategori" readonly="true" width="170px"/><label value="Pegawai"/><textbox id="pegawai" width="180px" forward="onOK=onSearch"/><button label="Tampilkan" image="/img/search.gif" forward="onClick=onSearch"/><button label="Export Excel" image="/img/download.gif" forward="onClick=onExport"/></hbox><separator/><label id="reportInfo" sclass="rl-info"/></div>
      <tabbox width="100%">
        <tabs><tab label="Detail Transaksi" selected="true"/><tab label="Aging &amp; SLA"/><tab label="Rekap Status"/><tab label="Rekap Kategori"/></tabs>
        <tabpanels>
          <tabpanel><div sclass="rl-card" style="overflow:auto"><grid fixedLayout="true" id="gridDetail" width="1650px"><columns><column label="Kode" width="120px"/><column label="Tgl Pengajuan" width="110px"/><column label="Pegawai" width="170px"/><column label="Kategori" width="130px"/><column label="Deskripsi" width="280px"/><column label="Nominal" width="120px"/><column label="Pajak" width="70px"/><column label="Status" width="100px"/><column label="Atasan" width="170px"/><column label="Tgl Akuntansi" width="110px"/><column label="Tgl Bayar" width="110px"/><column label="Metode" width="100px"/></columns></grid></div></tabpanel>
          <tabpanel><div sclass="rl-card"><label value="SLA operasional: pengajuan terbuka lebih dari 7 hari ditandai Lewat SLA." sclass="rl-info"/><grid fixedLayout="true" id="gridAging" width="100%"><columns><column label="Kode"/><column label="Pegawai"/><column label="Status"/><column label="Umur"/><column label="SLA"/><column label="Nominal"/></columns></grid></div></tabpanel>
          <tabpanel><div sclass="rl-card"><grid fixedLayout="true" id="gridStatus" width="100%"><columns><column label="Status"/><column label="Jumlah Dokumen"/><column label="Total Nominal"/></columns></grid></div></tabpanel>
          <tabpanel><div sclass="rl-card"><grid fixedLayout="true" id="gridKategori" width="100%"><columns><column label="Kategori"/><column label="Jumlah Dokumen"/><column label="Total Nominal"/></columns></grid></div></tabpanel>
        </tabpanels>
      </tabbox>
    </div>
  </window>
</zk>

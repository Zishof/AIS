<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.AbsensKehadiranPegawaiHarianAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Absensi Pegawai
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onLaporanAbsensiPegawai">
					Rekap Absensi
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onLaporanAbsensiPerPegawai">
					Laporan Absensi Per Pegawai
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										id="find" label="Cari" image="/img/search.gif"
										tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;absensi_kehadiran_pegawai_harian&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kode/NIP" />
									<textbox id="searchcode"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox id="searchstatus"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>

									</row>
									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Absensi" />
									<combobox id="searchPernahAbsen" readonly="true" value="Semua" forward="onChange=onSearchDefault" width="95%">
									<comboitem label="Semua" value="" />
									<comboitem label="Pernah Absen" value="pernah" />
									<comboitem label="Belum Pernah Absen" value="belum" />
									</combobox>
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="70px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="NIP"
									sort="auto(code)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Status"
									sort="auto(statusPegawai)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Pangkat / Golongan" sort="auto(golongan)" />

									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Email"
									sort="auto(email)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="TMT"
									sort="auto(telp)" />

									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Jabatan"
									sort="auto(jabatan)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Satuan Kerja" />

									<column
									use="ais.ui.util.MyColumnConfig" width="5%" />


								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAbsensiPegawai">



				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAbsensiPerPegawai">



				</tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

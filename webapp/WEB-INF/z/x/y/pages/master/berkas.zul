<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.BerkasAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

			<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">Berkas</tab>
				<tab use="ais.ui.util.MyTabConfig">Daftar Berkas</tab>
			</tabs>

			<tabpanels>

				<!-- ═══════════ TAB BERKAS (pohon) ═══════════ -->
				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Berkas</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="addBerkas" label="Tambah Berkas" image="/img/new.gif" tooltiptext="Tambah Berkas" forward="onClick=onAddBerkas"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;berkas&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
						</div>
						<div sclass="ais-crud-data-card">
							<tree width="100%" zclass="z-dottree" height="100%" id="tree">
								<treecols>
									<treecol width="40%" label="Berkas"></treecol>
									<treecol label="Fakultas"></treecol>
									<treecol label="Prodi"></treecol>
									<treecol label="Program"></treecol>
									<treecol label="Tahun Akademik"></treecol>
									<treecol label="Semester"></treecol>
									<treecol label="Keterangan"></treecol>
									<treecol width="15%"></treecol>
								</treecols>
							</tree>
						</div>
					</div>
				</tabpanel>

				<!-- ═══════════ TAB DAFTAR BERKAS (grid) ═══════════ -->
				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								</div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>
										<column use="ais.ui.util.MyColumnConfig" width="150px"/>
										<column use="ais.ui.util.MyColumnConfig"/>
										<column use="ais.ui.util.MyColumnConfig" width="150px"/>
										<column use="ais.ui.util.MyColumnConfig"/>
									</columns>
									<rows>
										<row>
											<label use="ais.ui.util.MyLabelConfig" value="Nama Berkas"/>
											<textbox forward="onOK=onSearchDefault" id="searchnama" width="95%"/>
										</row>
									</rows>
								</grid>
							</div>
						</div>
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns menupopup="auto">
									<column use="ais.ui.util.MyColumnConfig" label="Nama Berkas" sort="auto(nama)"/>
									<column use="ais.ui.util.MyColumnConfig" label="Fakultas"/>
									<column use="ais.ui.util.MyColumnConfig" label="Jurusan"/>
									<column use="ais.ui.util.MyColumnConfig" label="Program"/>
									<column use="ais.ui.util.MyColumnConfig" label="Tahun Akademik"/>
									<column use="ais.ui.util.MyColumnConfig" label="Semester"/>
									<column use="ais.ui.util.MyColumnConfig" label="Keterangan"/>
									<column use="ais.ui.util.MyColumnConfig" width="56px" label="" align="center"/>
								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>
					</div>
				</tabpanel>

			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Berkas" visible="false" mode="popup"
			position="center,center" border="normal" width="450px" height="440px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>

</zk>

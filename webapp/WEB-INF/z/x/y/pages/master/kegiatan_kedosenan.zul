<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KegiatanKedosenanAction" width="100%"
		height="100%">

		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onDasbor" selected="true">
					Dasbor
				</tab>

				<tab use="ais.ui.util.MyTabConfig">
					Kegiatan Dosen
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKelompokKegiatanKedosenan">
					Aspek Kegiatan
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRekapBerdasarJabatan">
					Rekap Berdasar Jabatan
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRekapBerdasarSkala">
					Rekap Berdasar Skala
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRekapBerdasarKelompok">
					Rekap Berdasar Kelompok
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRekapBerdasarDetailKelompok">
					Rekap Berdasar Aspek
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onForm">
					Form
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabDasbor"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">






					<div sclass="ais-crud-portal">
							<div sclass="ais-crud-filter-card">
								<div sclass="ais-crud-filter-head">
									<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
									<div sclass="ais-crud-filter-actions">
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kegiatan_kedosenan&quot;, &quot;Bantuan&quot;);"/></div>
								</div>
								<div sclass="ais-crud-filter-body">
									<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
										<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
								</columns>
										<rows>
											<row>
										<label
											use="ais.ui.util.MyLabelConfig" value="Nama Kegiatan" />
										<textbox
											forward="onOK=onSearchDefault" id="searchnama" width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Fakultas" />
										<combobox
											forward="onChange=onSearchDefault" id="searchfakultas"
											width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Prodi" />
										<combobox id="searchjurusan"
											forward="onChange=onSearchDefault" width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Status" />
										<combobox id="searchstatus"
											forward="onChange=onSearchDefault" width="95%" />

									</row>
										<row>

										<label
											use="ais.ui.util.MyLabelConfig" value="NIDN Dosen" />
										<textbox
											forward="onOK=onSearchDefault" id="searchnim" width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Nama Dosen" />
										<textbox
											forward="onOK=onSearchDefault" id="searchnamamhs"
											width="95%" />

									</row>
										</rows>
									</grid>
								</div>
							</div>
							<div sclass="ais-crud-data-card">
								<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
								<grid use="ais.ui.util.MyGrid" 
											sclass="dgrid" fixedLayout="true" id="grid">
											<columns>
												<column
													use="ais.ui.util.MyColumnConfig" width="50px" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Kode" width="4%"
													sort="auto(kode)" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Nama Kegiatan"
													width="15%" sort="auto(nama)" />
												<column
													use="ais.ui.util.MyColumnConfig" width="7%"
													label="Fakultas" />
												<column
													use="ais.ui.util.MyColumnConfig" width="7%" label="Prodi" />
												<column width="7%"
													use="ais.ui.util.MyColumnConfig" label="Aspek Kegiatan" />
												<column width="9%"
													use="ais.ui.util.MyColumnConfig" label="Aspek Rinci" />
												<column width="7%"
													use="ais.ui.util.MyColumnConfig" label="Mulai" />
												<column width="7%"
													use="ais.ui.util.MyColumnConfig" label="Sampai" />
												<column width="9%"
													use="ais.ui.util.MyColumnConfig" label="Diajukan oleh" />
												<column width="7%"
													use="ais.ui.util.MyColumnConfig" label="Sertifikat" />
												<column width="7%"
													use="ais.ui.util.MyColumnConfig" label="Status" />
												<column width="7%"
													use="ais.ui.util.MyColumnConfig" label="Keterangan"
													 />
												<column
													use="ais.ui.util.MyColumnConfig" width="7%" label="" />
											</columns>

										</grid>
								<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
							</div>
						</div>


</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="kelompokKegiatanKedosenanTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapBerdasarJabatanTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapBerdasarSkalaTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapBerdasarKelompokTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapBerdasarDetailKelompokTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="formTab"></tabpanel>
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Kegiatan Kedosenan" visible="false" mode="popup"
			position="center,center" border="normal" width="550px"
			height="95%">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
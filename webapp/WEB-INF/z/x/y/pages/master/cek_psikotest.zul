<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" id="generateNim"
		apply="ais.action.master.pmb.CekPsikotestAction" border="none"
		width="100%" height="1000px">


		<borderlayout id="inside">

			<north border="none" open="true">
				<grid use="ais.ui.util.MyGrid"
					fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="200px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
					</columns>
					<rows>
						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="Calon Mahasiswa" />
							<bandbox cols="50"
								use="ais.action.master.helper.AmbilDataCalonMahasiswaGenerateNimBanbox"
								id="bandboxCalonMahasiswa" readonly="true" />
						</row>
						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="" />
							<button use="ais.ui.util.MyButtonConfig"
								label="C H E C K" forward="onClick=onPilihCalonMahasiswa">
							</button>
						</row>

					</rows>
				</grid>

			</north>
			<center border="none" flex="true" id="center"
				title="Data Mahasiswa Baru">
				<grid use="ais.ui.util.MyGrid"
					id="grids" mold="paging" height="100%">

				</grid>
			</center>
			<south>
				<toolbar id="toolbar">

					<button use="ais.ui.util.MyButtonConfig"
						label="SIMPAN" tooltiptext="Simpan"
						forward="onClick=onSaveCekKesehatan" id="buttonSimpan">
					</button>

					<button use="ais.ui.util.MyButtonConfig"
						label="CETAK" tooltiptext="Simpan" forward="onClick=onCetak"
						id="buttonSimpanDanCetak">
					</button>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;cek_psikotest&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
			</south>
		</borderlayout>



	</window>
</zk>
<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.MahasiswaRequestTugasAkhirAction"
		width="100%" height="100%">

		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Proposal
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJadwal">
					Jadwal Seminar Proposal
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilSeminar1">
					Laporan Seminar Proposal
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilSeminar">
					Rekap Seminar Proposal
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">


					<tabbox width="100%" height="100%">

						<tabs>
							<tab use="ais.ui.util.MyTabConfig"
								selected="true">
								Manajemen Pengajuan
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onFormatNilai">
								Format Nilai
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onTahapan">
								Tahapan Pengerjaan
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onKomponenPenilaian">
								Komponen Penilaian
							</tab>
						</tabs>
						<tabpanels>

							<tabpanel use="ais.ui.util.MyTabpanel">
								<div sclass="ais-crud-portal">
							<div sclass="ais-crud-filter-card">
								<div sclass="ais-crud-filter-head">
									<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
									<div sclass="ais-crud-filter-actions">
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Pencarian Lanjut" image="/img/search.gif" tooltiptext="Filter lanjutan" onClick="filterLanjut.setVisible(!filterLanjut.isVisible());"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;mahasiswa_request_tugas_akhir&quot;, &quot;Bantuan&quot;);"/></div>
								</div>
								<div sclass="ais-crud-filter-body">
									<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
										<columns>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
											</columns>
										<rows>
											<row id="cari1">

													<label
														use="ais.ui.util.MyLabelConfig" value="Tahun Angkatan" />
													<decimalbox
														id="searchtahun" forward="onOK=onSearchDefault"
														width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig" value="Status" />
													<combobox
														id="searchstatus" forward="onChange=onSearchDefault"
														width="95%" />

													<label
														use="ais.ui.util.MyLabelConfig" value="Fakultas" />
													<combobox
														forward="onChange=onSearchDefault" id="searchfakultas"
														width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig" value="Jenjang" />
													<combobox
														id="searchjenjang" forward="onChange=onSearchDefault"
														width="95%" />

													<label
														use="ais.ui.util.MyLabelConfig" value="Req.Status" />
													<combobox
														id="searchreqstatus" forward="onChange=onSearchDefault"
														width="95%" />

												</row>
										</rows>
									</grid>
								</div>
							</div>
							<div sclass="ais-crud-data-card">
								<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
								<grid use="ais.ui.util.MyGrid"
														 sclass="dgrid" fixedLayout="true"
														id="grid">
														<columns>
															<column
																use="ais.ui.util.MyColumnConfig" width="40px" />
															<column
																use="ais.ui.util.MyColumnConfig" width="19%" />

															<column
																use="ais.ui.util.MyColumnConfig" width="9%"
																label="Status" />
															<column
																use="ais.ui.util.MyColumnConfig" width="65%"
																label="Judul / Dosen" />
															<column
																use="ais.ui.util.MyColumnConfig" width="7%" />
														</columns>

													</grid>
								<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
							</div>
						</div>

								<div id="filterLanjut" visible="false" sclass="ecampus-zul-filter-window ais-legacy-filter-overlay"><div sclass="ais-legacy-filter-backdrop" onClick="filterLanjut.setVisible(false);"></div><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" sclass="ais-legacy-filter-close" label="&#10005; Tutup" tooltiptext="Tutup pencarian lanjutan" onClick="filterLanjut.setVisible(false);"></toolbarbutton>
							<vbox width="100%" sclass="ecampus-zul-filter-window-body">
								<label use="ais.ui.util.MyLabelConfig" value="Filter lanjutan — atur lalu klik Cari untuk menampilkan data yang sesuai." sclass="ecampus-zul-filter-window-info"/>
								<separator/>
								<grid use="ais.ui.util.MyGrid" fixedLayout="true">
									<columns>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig" width="150px">
												</column>
												<column
													use="ais.ui.util.MyColumnConfig">
												</column>
											</columns>
									<rows>
										<row id="cari2">
													<label
														use="ais.ui.util.MyLabelConfig" value="Nama" />
													<textbox
														id="searchnama" forward="onOK=onSearchDefault"
														width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig"
														value="Status Awal Mahasiswa" />
													<combobox
														id="searchStatusAwalMahasiswa"
														forward="onChange=onSearchDefault" width="95%" />

													<label
														use="ais.ui.util.MyLabelConfig" value="Prodi" />
													<combobox
														id="searchjurusan" forward="onChange=onSearchDefault"
														width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig" value="Dosen Pembimbing" />
													<bandbox
														id="searchdosenPemimbing"
														use="ais.action.master.helper.AmbilDataDosenBanbox"
														width="95%" />

													<label
														use="ais.ui.util.MyLabelConfig" value="TA" />
													<combobox
														id="searchta" forward="onChange=onSearchDefault"
														width="95%" />

												</row>
										<row id="cari3">
													<label
														use="ais.ui.util.MyLabelConfig" value="NIM" />
													<textbox
														id="searchnim" forward="onOK=onSearchDefault" width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig" value="Program" />
													<combobox
														id="searchprogram" forward="onChange=onSearchDefault"
														width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig" value="Dosen PA" />
													<textbox
														id="searchdosen" forward="onOK=onSearchDefault"
														width="95%" />
													<label
														use="ais.ui.util.MyLabelConfig" value="Judul" />
													<textbox
														id="searchjudul" forward="onOK=onSearchDefault"
														width="95%" />

													<label
														use="ais.ui.util.MyLabelConfig" value="Semester" />
													<combobox
														id="searchsemester" forward="onChange=onSearchDefault"
														width="95%" />
												</row>
										<row spans="10">
											<toolbar>
												<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
											</toolbar>
										</row>
									</rows>
								</grid>
							</vbox>
						</div>

		

							</tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="formatNilaiTab"></tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="tahapanTab"></tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="komponenPenilaianTab"></tabpanel>
						</tabpanels>
					</tabbox>
				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenSeminar"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporan1Seminar"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanSeminar"></tabpanel>


			</tabpanels>
		</tabbox>


		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Agama" visible="false" mode="popup"
			position="center,center" border="normal" width="850px"
			height="98%">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>

</zk>
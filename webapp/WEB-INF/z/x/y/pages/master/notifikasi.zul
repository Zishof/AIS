<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.NotifikasiAction" width="100%"
		height="100%">


		<tabbox width="100%" height="100%">

			<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Dasbor
				</tab>

				<tab use="ais.ui.util.MyTabConfig">
					Notifikasi
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onWa">
					Notifikasi WA
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTanyaJawab">
					Tanya Jawab
				</tab>
			</tabs>

			<tabpanels>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<vbox width="100%" height="100%">
						<html id="progressHtml" visible="false" />
						<html id="dashboardHtml">
							<![CDATA[
<div>
  <div>
    <div>Dasbor</div>
    <div>Ringkasan utama akan tampil otomatis setelah data selesai dimuat. Gunakan filter untuk melihat data yang lebih spesifik.</div>
    <div>
      <div><b>Total Data</b><br/><span>Mengikuti filter aktif.</span></div>
      <div><b>Tren</b><br/><span>Perubahan aktivitas terbaru.</span></div>
      <div><b>Perlu Perhatian</b><br/><span>Data gagal atau bermasalah.</span></div>
      <div><b>Komposisi</b><br/><span>Kategori data utama.</span></div>
    </div>
  </div>
</div>
]]>
						</html>
					</vbox>
				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel">


					<div sclass="ais-crud-portal">
							<div sclass="ais-crud-filter-card">
								<div sclass="ais-crud-filter-head">
									<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
									<div sclass="ais-crud-filter-actions">
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;notifikasi&quot;, &quot;Bantuan&quot;);"/></div>
								</div>
								<div sclass="ais-crud-filter-body">
									<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
										<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
								</columns>
										<rows>
											<row>
										<label
											use="ais.ui.util.MyLabelConfig" value="Isi Notifikasi" />
										<textbox
											forward="onOK=onSearchDefault" id="searchnama" width="95%" />
										<label
											use="ais.ui.util.MyLabelConfig" value="Penerima Notifikasi" />
										<textbox
											forward="onOK=onSearchDefault" id="searchemails" width="95%" />

										<label
											use="ais.ui.util.MyLabelConfig" value="Tanggal" />


										<hbox>
											<datebox
												use="ais.ui.util.MyDatebox" id="start"
												forward="onChange=onSearchDefault" cols="6" />
											<label use="ais.ui.util.MyLabelConfig" value="s.d"></label>
											<datebox
												use="ais.ui.util.MyDatebox" id="end"
												forward="onChange=onSearchDefault" cols="6" />
										</hbox>

									</row>
										</rows>
									</grid>
								</div>
							</div>
							<div sclass="ais-crud-data-card">
								<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
								<grid use="ais.ui.util.MyGrid"
											sclass="dgrid" fixedLayout="true" id="grid">
											<columns>
												<column
													use="ais.ui.util.MyColumnConfig" label="User ID"
													width="20%" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Emails"
													width="20%" />
												<column
													use="ais.ui.util.MyColumnConfig" label="Keterangan" />
												<column
													use="ais.ui.util.MyColumnConfig" width="20%"
													label="Waktu/Hasil" />
												<column
													use="ais.ui.util.MyColumnConfig" width="10%" label="" />
											</columns>

										</grid>
								<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
							</div>
						</div>

		

		

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="chekWa"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tanyaJawab"></tabpanel>

			</tabpanels>

		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Notifikasi" visible="false" mode="popup"
			position="center,center" border="normal" width="550px"
			height="95%">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.LogHostToHostYangBelumReconsileAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;log_host_to_host_yang_belum_reconsile&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						<column use="ais.ui.util.MyColumnConfig" width="150px" />
						<column use="ais.ui.util.MyColumnConfig" />
						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Kode" />
<textbox id="searchkode" forward="onOK=onSearchDefault" width="95%" />
<label use="ais.ui.util.MyLabelConfig"
						value="Bank" />
						<textbox forward="onOK=onSearchDefault"
						id="searchbank" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Request" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Respons" />
						<textbox forward="onOK=onSearchDefault"
						id="searchketerangan" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Mulai" />
						<datebox use="ais.ui.util.MyDatebox"
						forward="onChange=onSearchDefault" id="searchmulai" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Sampai" />
						<datebox use="ais.ui.util.MyDatebox"
						forward="onChange=onSearchDefault" id="searchsampai"
						width="95%" />

						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="" width="50px" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="IP" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Bank" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="NIM" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Waktu" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Status" />
						<column
						use="ais.ui.util.MyColumnConfig" width="24%" label="Request" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Kode" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Nominal" />
						<column
						use="ais.ui.util.MyColumnConfig" width="12%" label="Item" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

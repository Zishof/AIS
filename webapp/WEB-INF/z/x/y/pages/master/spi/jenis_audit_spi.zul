<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.spi.JenisAuditSPIAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
                <tab use="ais.ui.util.MyTabConfig" selected="true">Jenis Audit</tab>
                <tab use="ais.ui.util.MyTabConfig" forward="onClick=onKriteria">Kriteria Audit</tab>
                <tab use="ais.ui.util.MyTabConfig" forward="onClick=onChecklist">Checklist Audit</tab>
            </tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<div sclass="ais-crud-page-desc">Di sini Anda menyusun kategori besar audit internal, seperti "Audit Keuangan" atau "Audit Pengadaan Barang/Jasa". Setiap kategori nantinya menjadi payung bagi kriteria dan langkah pemeriksaan yang lebih rinci pada dua tab di sebelah.</div>

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;jenis_audit_spi&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px" />
									<column use="ais.ui.util.MyColumnConfig" />
									<column use="ais.ui.util.MyColumnConfig" width="150px" />
									<column use="ais.ui.util.MyColumnConfig" />

									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Nama Jenis Audit" />
									<textbox forward="onOK=onSearchDefault" id="searchnama" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="" />
									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig"
									label="Kode Jenis Audit" sort="auto(kode)" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Nama Jenis Audit" sort="auto(nama)" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Keterangan" />
									<column use="ais.ui.util.MyColumnConfig"
									width="8%" label="Aktif" />
									<column use="ais.ui.util.MyColumnConfig"
									width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



                <!-- ===== TAB stubs (loaded lazily) ===== -->
                <tabpanel use="ais.ui.util.MyTabpanel" id="kriteriaTab" />
                <tabpanel use="ais.ui.util.MyTabpanel" id="checklistTab" />


			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Pendataan Jenis Audit SPI" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="350px" />

		<zscript><![CDATA[
addWindow.setVisible(false);
        ]]></zscript>

	</window>


</zk>

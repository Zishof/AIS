<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.DetailperkuliahanAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;detailperkuliahan&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Mahasiswa" />
						<textbox id="searchnama" width="95%"
						forward="onOK=onSearchDefault" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Matakuliah" />
						<textbox id="searchmk" width="95%"
						forward="onOK=onSearchDefault" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<combobox forward="onChange=onSearchDefault"
						id="searchfakultas" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						<combobox id="searchjurusan" width="95%"
						forward="onChange=onSearchDefault" />

						</row>


						<row>


						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox forward="onChange=onSearchDefault"
						id="searchTahunAjaran" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Semester" />
						<combobox id="searchJenisSemester"
						width="95%" forward="onChange=onSearchDefault" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Semester ke" />
						<combobox id="searchsemester" width="95%"
						forward="onChange=onSearchDefault" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Program" />
						<combobox id="searchprogram" width="95%"
						forward="onChange=onSearchDefault" />

						</row>
						
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Dosen"/>
						<bandbox id="searchdosen" use="ais.action.master.helper.AmbilDataDosenBanbox" width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Masuk Feeder" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchMasukFeeder" label="Msk Feeder" forward="onCheck=onSearchDefault"/>
						<label use="ais.ui.util.MyLabelConfig" value="Belum Masuk Feeder" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchBelumMasukFeeder" label="Belum Feeder" forward="onCheck=onSearchDefault"/>
					</row>
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchtdkaktif" label="Tdkaktif" forward="onClick=onSearchDefault" />
					</row>
					</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="100px"
						label="Setujui" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%" label="Kode"
						sort="auto(kode)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Nama"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="SKS"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="17%" label="Dosen" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Waktu/Hari"
						width="17%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="4%" label="Semester" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%" label="Kelas" />

						<column
						use="ais.ui.util.MyColumnConfig" width="9%"
						label="Tahun Akademik" />

						<column
						use="ais.ui.util.MyColumnConfig" width="9%"
						label="Kehadiran" />

						<column
						use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

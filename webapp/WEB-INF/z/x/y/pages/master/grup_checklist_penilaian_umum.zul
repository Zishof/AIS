<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.GrupChecklistPenilaianUmumAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;grup_checklist_penilaian_umum&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Grup" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnama" width="95%" />


						<label use="ais.ui.util.MyLabelConfig"
						value="Kode Angket" />
						<textbox forward="onOK=onSearchDefault"
						id="searchkodeangket" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Nama Angket" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnamaangket" width="95%" />

						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Diperuntukan" />
						<combobox forward="onChange=onSearchDefault"
						id="searchdiperuntukkan" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Program" />
						<combobox id="searchprogram"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig"
						id="searchhanyaAktif" label="Hanya yg aktif" checked="true"
						forward="onClick=onSearchDefault" width="95%" />

						</row>

						<row id="hbFakultasLabel">

						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<combobox forward="onChange=onSearchDefault"
						id="searchfakultas" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />

						</row>

						<row id="hbYayasan">

						<label use="ais.ui.util.MyLabelConfig"
						value="Yayasan" />
						<combobox forward="onChange=onSearchDefault"
						id="searchyayasan" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Sekolah" />
						<combobox id="searchsekolah"
						forward="onChange=onSearchDefault" width="95%" />


						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="Nama Angket"
						width="12%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nama Grup" width="20%"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Diperuntukkan"
						width="12%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Unit" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Sub/Unit" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Program" />

						<column
						use="ais.ui.util.MyColumnConfig" label="Keterangan"
						/>
						<column
						use="ais.ui.util.MyColumnConfig" width="15%"
						label="Aktif/Tidak" />
						<column
						use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Grup" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

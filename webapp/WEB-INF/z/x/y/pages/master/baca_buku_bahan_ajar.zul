<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.BacaBukuBahanAjarAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;baca_buku_bahan_ajar&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Judul Buku" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Pengarang" />
						<textbox forward="onOK=onSearchDefault"
						id="searchpengarang" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Penerbit" />
						<textbox forward="onOK=onSearchDefault"
						id="searchpenerbit" width="95%" />

						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="ISBN Buku" />
						<textbox forward="onOK=onSearchDefault"
						id="searchisbn" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun" />
						<doublebox forward="onOK=onSearchDefault"
						id="searchtahun" width="95%" />


						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="" width="40px" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nama Buku"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Pengarang" />
						<column
						use="ais.ui.util.MyColumnConfig" label="ISBN" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Penerbit" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Link" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Tahun" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Keterangan" />



					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Buku Bahan Ajar" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="440px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

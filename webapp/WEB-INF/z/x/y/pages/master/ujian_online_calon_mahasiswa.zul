<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.pmb.UjianOnlineCalonMahasiswaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;ujian_online_calon_mahasiswa&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="30%">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig" width="70%">
						</column>


						</columns>
						<rows>
						<row id="tampilanNoRegistrasi">
						<label
						use="ais.ui.util.MyLabelConfig"
						value="No. Pendaftaran / Ujian" />
						<textbox id="noRegistrasi"
						width="90%">
						</textbox>
						</row>



						<row>
						<label
						use="ais.ui.util.MyLabelConfig" value="Tanggal Lahir" />
						<grid fixedLayout="true" use="ais.ui.util.MyGrid" width="100%">
						<rows>
						<row>
						<vbox width="33%">
						<label
						use="ais.ui.util.MyLabelConfig" value="Tahun">
						</label>
						<combobox
						id="tahun" width="60px" readonly="true">
						</combobox>
						</vbox>

						<vbox width="33%">
						<label
						use="ais.ui.util.MyLabelConfig" value="Bulan">
						</label>
						<combobox
						id="bulan" width="80px" readonly="true">
						</combobox>
						</vbox>

						<vbox width="33%">
						<label
						use="ais.ui.util.MyLabelConfig" value="Tanggal">
						</label>
						<combobox
						id="tanggal" width="60px" readonly="true">
						</combobox>
						</vbox>
						</row>
						</rows>

						</grid>

						</row>

						<row spans="2">
						<hbox pack="center"
						align="center" width="100%">
						<button
						use="ais.ui.util.MyButtonConfig" label="L O G I N"
						forward="onClick=onLogin" id="cari">
						</button>
						<button
						use="ais.ui.util.MyButtonConfig" visible="false"
						label="R E S E T" forward="onClick=onReset" id="reset">
						</button>
						</hbox>
						</row>

						<row spans="2" id="labelInformasi">
						<label
						use="ais.ui.util.MyLabelConfig" id="infoLogin"
						value="Untuk dapat melakukan login, silahkan masukkan Nomor Registrasi yang anda dapatkan pada saat melakukan pendaftaran dan masukkan TANGGAL LAHIR.">
						</label>
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="30%">
						</column>
						<column
						use="ais.ui.util.MyColumnConfig" width="70%">
						</column>


					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

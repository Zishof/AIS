<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.MahasiswaRegistrasiWisudaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;mahasiswa_registrasi_wisuda&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="NIM" />
						<textbox id="searchnim"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama" id="label_mahasiswa" />
						<textbox id="searchmahasiswa"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Wisuda" />
						<combobox id="searchwisuda"
						forward="onChange=onSearchDefault" width="95%" />

						</row>

						<row
						spans="6">
						<hbox width="100%">
						<checkbox
						use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault" id="searchPersetujuanWisuda"
						label="Persetujuan Wisuda" />
						<checkbox
						use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault"
						id="searchPersetujuanAdministrasi"
						label="Persetujuan Administrasi" />
						<checkbox
						use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault"
						id="searchPersetujuanAdministrasiFakultas"
						label="Persetujuan Administrasi Fakultas" />
						<checkbox
						use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault"
						id="searchPersetujuanKeuangan" label="Persetujuan Keuangan" />
						<checkbox
						use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault"
						id="searchPersetujuanPerpustakaan"
						label="Persetujuan Perpustakaan" />
						<checkbox
						use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault"
						id="searchPersetujuanPerpustakaanFakultas"
						label="Persetujuan Perpustakaan Fakultas" />
						</hbox>
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="70px" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Wisuda " />
						<column
						use="ais.ui.util.MyColumnConfig" width="15%" label="NIM" />
						<column
						use="ais.ui.util.MyColumnConfig" width="15%" label="Nama " />
						<column
						use="ais.ui.util.MyColumnConfig">
						<label
						use="ais.ui.util.MyLabelConfig"
						id="labelPersetujuanWisuda">
						</label>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<label
						use="ais.ui.util.MyLabelConfig"
						id="labelPersetujuanAdministrasi">
						</label>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<label
						use="ais.ui.util.MyLabelConfig"
						id="labelPersetujuanAdministrasiFakultas">
						</label>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<label
						use="ais.ui.util.MyLabelConfig"
						id="labelPersetujuanKeuangan">
						</label>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<label
						use="ais.ui.util.MyLabelConfig"
						id="labelPersetujuanPerpustakaan">
						</label>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig">
						<label
						use="ais.ui.util.MyLabelConfig"
						id="labelPersetujuanPerpustakaanFakultas">
						</label>
						</column>
						<column
						use="ais.ui.util.MyColumnConfig" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Edit Mahasiswa Registrasi Wisuda " visible="false" mode="popup" position="center,center" border="normal" width="90%" height="97%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.GrupPertemuanAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Konsultasi Mahasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onSejarah">
					Bimbingan KRS
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onTugasAkhir">
					Bimbingan Skripsi atau Tugas Akhir
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onSidang">
					Sidang Skripsi atau Tugas Akhir
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onTampilJenisLayanan">
					Jenis Layanan Mahasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onTampilGrupPertemuan">
					Laporan Konsultasi Mahasiswa
				</tab>
				
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;grup_pertemuan&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Konsultasi" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Angkatan" />
									<textbox id="searchtahun"
									forward="onOK=onSearchDefault" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Program" />
									<combobox id="searchprogram"
									forward="onChange=onSearchDefault" width="95%" />

									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
									<combobox
									forward="onChange=onSearchDefault" id="searchtahunakademik"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Dosen" />
									<bandbox width="95%"
									id="searchdosen"
									use="ais.action.master.helper.AmbilDataDosenBanbox">
									</bandbox>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kelas" />
									<textbox id="searchkelas"
									forward="onOK=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis" />
									<combobox
									forward="onChange=onSearchDefault" id="searchjenis"
									width="95%" />
									<label></label>
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="50px" />
									<column width="12%"
									use="ais.ui.util.MyColumnConfig" label="Dosen"
									sort="auto(nama)" />
									<column width="15%"
									use="ais.ui.util.MyColumnConfig" label="Nama Konsultasi"
									sort="auto(nama)" />
									<column width="10%"
									use="ais.ui.util.MyColumnConfig" label="Tgl/Waktu/Ruang" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Fakultas" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Prodi" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Angkatan"
									sort="auto(tahunAngkatan)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Program"
									sort="auto(program)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%" />
									<column width="15%"
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>


									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="sejarahKrs" visible="false"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="bimbinganSkripsi" visible="false"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="sidangSkripsi" visible="false"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="jenisLayananMahasiswa" visible="false"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanGrupPertemuan"></tabpanel>
				
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah GrupPertemuan" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

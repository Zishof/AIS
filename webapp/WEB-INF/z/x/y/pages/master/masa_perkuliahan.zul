<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.MasaPerkuliahanAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;masa_perkuliahan&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama" />
						<textbox id="searchnama"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<combobox forward="onChange=onSearchDefault"
						id="searchfakultas" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox forward="onChange=onSearchDefault"
						id="searchtahunakademik" width="95%" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Keterangan" />
						<textbox id="searchketerangan"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Jurusan" />
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Program" />
						<combobox forward="onChange=onSearchDefault"
						id="searchprogram" width="95%" />

						</row>
						
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
					</row>
					</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="40px" />
						<column
						use="ais.ui.util.MyColumnConfig" width="13%" label="Nama"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%" label="Mulai"
						sort="auto(mulai)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%" label="Sampai"
						sort="auto(sampai)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%"
						label="Tahun Akademik" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%" label="Program" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%" label="Jurusan"
						sort="auto(jurusan)" />

						<column
						use="ais.ui.util.MyColumnConfig" width="5%"
						label="Jml. Jadwal" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%"
						label="Tanggal Mulai Sesuai Jadwal" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Aktif" />
						<column
						use="ais.ui.util.MyColumnConfig" width="14%"
						label="Keterangan" />

						<column
						use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Masa Perkuliahan" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="480px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

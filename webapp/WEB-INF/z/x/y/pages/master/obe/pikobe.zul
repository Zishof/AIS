	<!--
		PIKOBE — satu halaman untuk mengentry & memantau seluruh komponen OBE
		(Profesi, Profil, CPL, Bahan Kajian, CPMK, Mata Kuliah, matriks, dan
		ringkasan grafik). Seluruh logika & UI dibangun oleh PikobeAction.
	-->
	<window use="ais.action.master.obe.PikobeAction" border="none"
		width="100%" height="100%" />

</zk>

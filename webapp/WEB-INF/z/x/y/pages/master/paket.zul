<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.pmb.PaketAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Paket
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilkanParameter">
					Manajemen Form Tambahan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMatapelajaranSekolah">
					Mata Pelajaran Sekolah
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onParameterVerifikasi">
					Parameter Verifikasi
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKartuIdentitas">
					Kartu Identitas
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJenisSekolah">
					Jenis Pendidikan Sblmny
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJurusanSekolah">
					Jurusan Pendidikan Sblmny
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onNamaSekolah">
					Nama Pendidikan Sblmny
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPekerjaanOrtu">
					Pekerjaan Ortu
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPendapatanOrtu">
					Pendapatan Ortu
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPendidikanOrtu">
					Pedidikan Ortu
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;paket&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									<column
									use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Paket" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />
									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" label="" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama Paket"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Kode Paket"
									sort="auto(kode)" />
									<column
									use="ais.ui.util.MyColumnConfig"
									label="Jumlah pilihan yang boleh diambil" />
									<column
									use="ais.ui.util.MyColumnConfig"
									label="Semua gelombang pendaftaran" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Sama pilihan" />
									<column
									use="ais.ui.util.MyColumnConfig"
									label="Kelas Verifikasi Rapor" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									sort="auto(keterangan)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanParameter"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanMatapelajaranSekolah"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanParameterVerifikasi"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanKartuIdentitas"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanJenisSekolah"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanJurusanSekolah"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanNamaSekolah"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanPekerjaanOrtu"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanPendapatanOrtu"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tampilkanPedidikanOrtu"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Paket" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="470px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KknAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen KKN
				</tab>
				<tab use="ais.ui.util.MyTabConfig">Persyaratan KKN</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Komponen Penilaian KKN
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Seleksi Penerima KKN
				</tab>
				<tab use="ais.ui.util.MyTabConfig">Rekap KKN</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Pembagian Kelompok
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistik">
					Statistik
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kkn&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama KKN" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />



									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Mahasiswa"
									id="label_mahasiswa" />
									<bandbox id="searchmahasiswa"
									use="ais.action.master.helper.AmbilDataMahasiswaBanbox"
									width="95%" />
									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Keterangan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchketerangan"
									width="95%" />





									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />




									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>


									<column
									use="ais.ui.util.MyColumnConfig" width="15%"
									label="Nama KKN" sort="auto(nama_kelompok)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="15%"
									label="Fakultas" />
									<column
									use="ais.ui.util.MyColumnConfig" width="15%" label="Prodi" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Program" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Tanggal" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="TA/Smt" />
									<column
									use="ais.ui.util.MyColumnConfig" label="SKS dan IPK" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Atau SKS dan IPK" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Item Biaya" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/kkn/persyaratan_kkn.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/kkn/komponen_penilaian_kkn.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/kkn/seleksi_penerima_kkn.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<window height="100%" width="100%"
						use="ais.action.report.format1.akademik.LaporanRekapKkn">
					</window>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/kkn/kelompok_kkn.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik">

				</tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah KKN" visible="false" mode="popup" position="center,center" border="normal" width="950px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

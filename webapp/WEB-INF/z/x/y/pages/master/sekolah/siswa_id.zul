<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.SiswaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;siswa_id&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>


						</columns>
						<rows>
						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="NISN" />
						<textbox id="searchkode"
						forward="onOK=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Nama" />
						<textbox id="searchnama"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Kelas" />
						<textbox id="searchkelas"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Angkatan" />
						<decimalbox id="searchtahun"
						forward="onOK=onSearchDefault" width="95%" />
						
						<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
						<combobox
						forward="onChange=onSearchDefault" id="searchyayasan"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
						<combobox id="searchsekolah"
						forward="onChange=onSearchDefault"  width="95%"/>

						</row>


						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="Status Awal" />
						<combobox forward="onChange=onSearchDefault"
						id="searchstatusawal" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Status Keluar" />
						<combobox forward="onChange=onSearchDefault"
						id="searchstatuskeluar" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Guru Wali" />
						<bandbox id="searchguruPembina"
						use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Guru BK" />
						<bandbox id="searchguruBk"
						use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Penjurusan" />
						<combobox forward="onChange=onSearchDefault"
						id="searchPenjurusan" width="95%" />
						</row>
						
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Telp" />
						<textbox id="searchnamatelp" forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Email" />
						<textbox id="searchnamaemail" forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Agama" />
						<combobox forward="onChange=onSearchDefault" readonly="true" id="searchagama" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Nama Ortu" />
						<textbox id="searchnamaortu" forward="onOK=onSearchDefault" width="95%" />
					</row>
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="Jenis Kelamin" />
						<combobox forward="onChange=onSearchDefault" readonly="true" id="searchkelamin" width="95%" />
					</row>
					</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>


						<column
						use="ais.ui.util.MyColumnConfig" width="70px" />
						<column
						use="ais.ui.util.MyColumnConfig" width="15%" label="NISN" />
						<column
						use="ais.ui.util.MyColumnConfig" width="10%" label="Nama"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Angkatan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="4%" label="Kelas" />



						<column
						use="ais.ui.util.MyColumnConfig" width="0%" label="Yayasan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Sekolah" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Status" />

						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Guru.Wali" />
						<column
						use="ais.ui.util.MyColumnConfig" width="8%" label="Guru.BK" />
						<column width="10%"
						use="ais.ui.util.MyColumnConfig" label="Keterangan" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%" />

						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Siswa" visible="false" mode="popup" position="center,center" border="normal" width="90%" height="99%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

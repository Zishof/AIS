<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.AbsensiAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs id="tabsAbsensi">

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Absensi
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onLaporanKehadiranGuru">
					Rekap Dan Laporan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onProsesKehadiran">
					Proses Kehadiran
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										id="find" label="Cari" image="/img/search.gif"
										tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;absensi&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="8%">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="8%">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="8%">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									<column
									use="ais.ui.util.MyColumnConfig" width="8%">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Hari" />
									<combobox id="searchhari"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Ajaran" />
									<combobox
									forward="onChange=onSearchDefault" id="searchTahunAjaran"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Semester" />
									<combobox width="95%"
									forward="onChange=onSearchDefault" id="searchJenisSemester" />


									<label use="ais.ui.util.MyLabelConfig" value="Guru"/>
									<bandbox id="searchguru"
									use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Nama Dosen"/>
									<textbox
									forward="onOK=onSearchDefault" id="searchnamadsn"  width="95%"/>

									</row>
									<row>



									<label
									use="ais.ui.util.MyLabelConfig" value="Matapelajaran" />


									<textbox
									forward="onOK=onSearchDefault" id="searchnamamk" width="95%" />





									<label
									use="ais.ui.util.MyLabelConfig" value="Kelas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchkelas"
									width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Yayasan" />

									<combobox
									forward="onChange=onSearchDefault" id="searchyayasan"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Sekolah" />
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault" width="95%" />

									</row>


									<row>



									<label
									use="ais.ui.util.MyLabelConfig" value="Siswa" />

									<textbox
									forward="onOK=onSearchDefault" id="searchsiswa" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Ruang" />
									<bandbox
									use="ais.action.master.helper.AmbilDataRuangBanbox"
									forward="onChange=onSearchDefault" id="searchruang"
									width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Keterangan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchKeterangan"
									width="95%" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="50px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="25%"
									label="Hari/Jam/Ruang" />
									<column
									use="ais.ui.util.MyColumnConfig" width="15%"
									label="Matapelajaran" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Guru" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Kurikulum" />

									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Semester" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jmh. Siswa" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>




				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapDanLaporan">
					<tabbox width="100%" height="100%">

						<tabs>

							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onLaporanKehadiranGuru">
								Kehadiran Guru
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onLaporanKehadiranSiswa">
								Kehadiran Siswa
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapitulasiAbsensiSiswa">
								Per Siswa dan Matapelajaran
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapitulasiAbsensiPerSiswa">
								Per Siswa
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapitulasiAbsensiMatapelajaran">
								Per Matapelajaran
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapitulasiAbsensiKelas">
								Per Kelas
							</tab>
							<tab use="ais.ui.util.MyTabConfig"
								forward="onClick=onRekapitulasiAbsensiKelasDanMatapelajaran">
								Per Kelas dan Matapelajaran
							</tab>
						</tabs>

						<tabpanels>



							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAbsensiGuru"></tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="laporanRekapAbsensiSiswa">
							</tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel" id="rekapitulasiAbsensiSiswa">



							</tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel"
								id="rekapitulasiAbsensiPerSiswa">



							</tabpanel>
							<tabpanel use="ais.ui.util.MyTabpanel"
								id="rekapitulasiAbsensiMatapelajaran">

							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel" id="rekapitulasiAbsensiKelas">



							</tabpanel>

							<tabpanel use="ais.ui.util.MyTabpanel"
								id="rekapitulasiAbsensiKelasDanMatapelajaran">



							</tabpanel>


						</tabpanels>


					</tabbox>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="prosesKehadiranTab"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Guru" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="400px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.PostingPiutangDendaSiswaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;posting_piutang_denda&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
						width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>



						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Siswa/Calon" />
						<textbox forward="onOK=onSearchDefault"
						id="searchsiswa" width="95%" />

						
						<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
						<combobox
						forward="onChange=onSearchDefault" id="searchyayasan"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
						<combobox id="searchsekolah"
						forward="onChange=onSearchDefault"  width="95%"/>


						<label use="ais.ui.util.MyLabelConfig"
						value="Item Biaya" />
						<combobox forward="onChange=onSearchDefault"
						id="searchitembiaya" width="95%" />


						
						<label use="ais.ui.util.MyLabelConfig" value="Bulan"/>
						<decimalbox
						forward="onOK=onSearchDefault" id="searchbulan"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Tahun"/>
						<decimalbox id="searchtahun"
						forward="onOK=onSearchDefault"  width="95%"/>
						</row>
					<row spans="8">
						<hbox width="95%">
						<label use="ais.ui.util.MyLabelConfig"
						value="Bulan" />
						<label value="/"></label>
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun" />
						</hbox>
					</row>


						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Angkatan" />
						<decimalbox id="searchtahunMasuk"
						forward="onOK=onSearchDefault" width="95%" />



						<label use="ais.ui.util.MyLabelConfig"
						value="Tanggal Mulai" />
						<datebox id="tglMulai"
						use="ais.ui.util.MyDatebox" readonly="true"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Tanggal Sampai" />
						<datebox id="tglSampai"
						use="ais.ui.util.MyDatebox" readonly="true"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig"
						label="Hanya yang belum posting"
						forward="onCheck=onSearchDefault" id="searchtampil" width="95%" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" label="Telah posting" forward="onCheck=onSearchDefault" id="searchtelahtampil" width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<!-- Aksi massal: Posting / Batalkan Posting seluruh transaksi yang tampil di daftar -->
				<div sclass="ais-bulk-posting-actions" style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; align-items:center; padding:8px 6px 2px 6px;">
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Posting Semua" image="/img/svg/check2-circle.svg" style="font-weight:700; color:#15803d;" tooltiptext="Sahkan ke jurnal/buku besar semua transaksi yang belum diposting" forward="onClick=onPostingSemua"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Batalkan Posting Semua" image="/img/svg/warning-outline.svg" style="font-weight:700; color:#b45309;" tooltiptext="Tarik kembali dari jurnal/buku besar semua transaksi yang sudah diposting" forward="onClick=onBatalkanPostingSemua"/>
				</div>
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="Foto" width="70px" />
						<column
						use="ais.ui.util.MyColumnConfig" label="NIS/No.Reg"
						width="7%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nama" width="9%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="Item Biaya"
						sort="auto(nama)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nominal" align="right"
						width="7%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="Sekolah" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="Yayasan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Tahun" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Bulan" />
						<column
						use="ais.ui.util.MyColumnConfig" width="9%"
						label="Tanggal dan waktu" />

						<column
						use="ais.ui.util.MyColumnConfig" width="19%"
						label="Transaksi" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Posting" width="7%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="Posting" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Pembayaran" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

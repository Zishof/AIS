<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.SiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Siswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenKelas">
					Kelas
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenAsrama">
					Asrama
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenKelompokStatusKeluarSiswa">
					Status Keluar
				</tab>
				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onManajemenDosenPA">
					Guru BK
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onFormTambahan">
					Form Siswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKartuSiswa">
					Kartu Siswa
				</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilTranskripAkademik">
					Raport
				</tab>

				<tab use="ais.ui.util.MyTabConfig" visible="false"
					forward="onClick=onKegiatanKemahasiswaan">
					Kegiatan Siswa
				</tab>

				<tab use="ais.ui.util.MyTabConfig">
					Album Siswa
				</tab>

				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onStatistik">
					Statistik
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="uploadFotoMassal" label="Upload Foto (No. Induk)" image="/img/new.gif" tooltiptext="Upload banyak foto sekaligus (nama berkas = No. Induk/NIS, mis. 12345.jpg) ATAU satu berkas ZIP berisi foto-foto ber-nama No. Induk. Semua langsung terpasang ke siswa yang No. Induk-nya cocok." upload="true,maxsize=-1" forward="onUpload=onUploadFotoMassal"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="downloadFotoMassal" label="Download Foto Massal" image="/img/download.png" tooltiptext="Unduh SEMUA foto siswa sebagai satu berkas ZIP (nama tiap foto = No. Induk). Pembacaan paralel maks 50 thread agar cepat." forward="onClick=onDownloadFotoMassal"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;siswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>

									<label use="ais.ui.util.MyLabelConfig" value="NIS/Nama" />
									<textbox id="searchkode"
									forward="onOK=onSearchDefault" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Jalur" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Kelas" />
									<bandbox id="searchkelas"
									use="ais.action.master.sekolah.helper.AmbilDataKelasSiswaBanbox"
									width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Thn Masuk Mulai" />
									<decimalbox id="searchtahunMulai"
									forward="onOK=onSearchDefault" width="95%" />
									
									<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
									<combobox forward="onChange=onSearchDefault"
									id="searchyayasan"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault"  width="95%"/>

									</row>


									<row>

									<label use="ais.ui.util.MyLabelConfig"
									value="Status Awal" />
									<combobox forward="onChange=onSearchDefault"
									id="searchstatusawal" width="95%" />

									<label use="ais.ui.util.MyLabelConfig"
									value="Status Keluar" />
									<combobox forward="onChange=onSearchDefault"
									id="searchstatuskeluar" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Guru Wali" />
									<bandbox id="searchguruPembina"
									use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"
									width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Guru BK" />
									<bandbox id="searchguruBk"
									use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"
									width="95%" />
									<label use="ais.ui.util.MyLabelConfig"
									value="Penjurusan" />
									<combobox forward="onChange=onSearchDefault"
									id="searchPenjurusan" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Thn Masuk Sampai" />
									<decimalbox id="searchtahunSampai"
									forward="onOK=onSearchDefault" width="95%" />
									</row>


									<row>

									<label use="ais.ui.util.MyLabelConfig"
									value="Jenis Kelamin" />
									<combobox forward="onChange=onSearchDefault" readonly="true"
									id="searchkelamin" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Agama" />
									<combobox forward="onChange=onSearchDefault" readonly="true"
									id="searchagama" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Nama Ortu" />
									<textbox id="searchnamaortu"
									forward="onOK=onSearchDefault" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Telp" />
									<textbox id="searchnamatelp"
									forward="onOK=onSearchDefault" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Email" />
									<textbox id="searchnamaemail"
									forward="onOK=onSearchDefault" width="95%" />

									</row>
									
					<row>
									<label use="ais.ui.util.MyLabelConfig" value="Sudah Keluar" />
									<combobox forward="onChange=onSearchDefault"
									id="searchSudahKeluar" width="95%" readonly="true" />
									<label use="ais.ui.util.MyLabelConfig" value="Punya Kelas" />
									<combobox forward="onChange=onSearchDefault"
									id="searchPunyaKelas" width="95%" readonly="true" />
					</row>
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
					</row>
					</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>


									<column use="ais.ui.util.MyColumnConfig" width="70px" />
									<column use="ais.ui.util.MyColumnConfig" width="15%"
									label="Kode/NISN" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Nama" sort="auto(nama)" />
									<column use="ais.ui.util.MyColumnConfig" width="5%"
									label="Angkatan" />
									<column use="ais.ui.util.MyColumnConfig" width="6%"
									label="Kelas" />



									<column use="ais.ui.util.MyColumnConfig" width="0%"
									label="Yayasan" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Sekolah" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Status" />

									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Guru.Wali" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Guru.BK" />
									<column width="10%" use="ais.ui.util.MyColumnConfig"
									label="Keterangan" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Aktif" width="5%" />

									<column use="ais.ui.util.MyColumnConfig" width="7%"
									label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenKelas">



				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenAsrama"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenKelompokStatusKeluarSiswa"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenDosenPA"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenFormTambahan"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenKartuSiswa"></tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="transkripAkademik"></tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" visible="false" id="kegiatanSiswaan"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<window width="100%" height="100%"
						use="ais.action.report.format1.sekolah.LaporanAlbumSiswa">
					</window>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik"></tabpanel>


			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Siswa" visible="false" mode="popup" position="center,center" border="normal" width="90%" height="99%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

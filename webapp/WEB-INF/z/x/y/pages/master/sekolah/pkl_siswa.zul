<?page id="pklSiswaZul" title="PKL Siswa" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.PklSiswaAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah Kelompok PKL" image="/img/new.gif" tooltiptext="Tambah kelompok PKL untuk siswa" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					</div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="150px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="150px" />
							<column use="ais.ui.util.MyColumnConfig" />
						</columns>
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Sekolah" />
								<combobox id="searchsekolah" forward="onChange=onSearchDefault" width="95%" />
								<label use="ais.ui.util.MyLabelConfig" value="Nama Kelompok" />
								<textbox id="searchnama" forward="onOK=onSearchDefault" width="95%" />
							</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" width="22%" label="Nama Kelompok" sort="auto(nama_kelompok)" />
						<column use="ais.ui.util.MyColumnConfig" width="20%" label="Sekolah" />
						<column use="ais.ui.util.MyColumnConfig" width="18%" label="Tanggal" />
						<column use="ais.ui.util.MyColumnConfig" width="12%" label="Anggota" />
						<column use="ais.ui.util.MyColumnConfig" label="Aksi" width="56px" align="center" />
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Kelompok PKL Siswa" visible="false" mode="popup" position="center,center" border="normal" width="620px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>

</zk>

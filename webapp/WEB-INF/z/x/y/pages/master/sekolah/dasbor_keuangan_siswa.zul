<?page cacheable="false" language="xul/html" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" width="100%" height="100%"
		apply="ais.action.master.sekolah.DasborKeuanganSiswaAction">
		<div id="rootContainer" width="100%"
			style="height:100%;overflow-y:auto;overflow-x:hidden;box-sizing:border-box;"/>
	</window>

</zk>

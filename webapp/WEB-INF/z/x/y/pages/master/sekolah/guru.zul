<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.GuruAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Manajemen Guru
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Penugasan Mengajar
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					SK Mengajar
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Jenis SK
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKonfigurasiBiodataGuru">
					Konfigurasi
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="uploadFotoMassal" label="Upload Foto" image="/img/new.gif" tooltiptext="Upload banyak foto sekaligus (nama berkas = NIP, mis. 12345.jpg) ATAU satu berkas ZIP berisi foto-foto ber-nama NIP. Semua langsung terpasang ke guru yang cocok." upload="true,maxsize=-1" forward="onUpload=onUploadFotoMassal"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="downloadFotoMassal" label="Download Foto Massal" image="/img/download.png" tooltiptext="Unduh SEMUA foto guru sebagai satu berkas ZIP (nama tiap foto = NIP). Pembacaan paralel maks 50 thread agar cepat." forward="onClick=onDownloadFotoMassal"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;guru&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>



									</columns>
									<rows>
									<row>

									<label use="ais.ui.util.MyLabelConfig"
									value="Kode/NUPTK" />
									<textbox id="searchkode"
									forward="onOK=onSearchDefault" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Nama" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />

									
									<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
									<combobox forward="onChange=onSearchDefault"
									id="searchyayasan"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault"  width="95%"/>



									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig" width="40px" />
									<column use="ais.ui.util.MyColumnConfig" width="70px" />
									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Kode" />

									<column use="ais.ui.util.MyColumnConfig" width="10%"
									label="Nama" sort="auto(nama)" />


									<column use="ais.ui.util.MyColumnConfig" width="0%"
									label="Yayasan" />
									<column use="ais.ui.util.MyColumnConfig" width="8%"
									label="Sekolah" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Status" />

									<column use="ais.ui.util.MyColumnConfig"
									label="Keterangan" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Aktif" width="5%" />
									<column use="ais.ui.util.MyColumnConfig" width="7%"
									label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel">
					<include
						src="/WEB-INF/z/x/y/pages/master/sekolah/penugasan_guru_mengajar.zul">
					</include>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<window
						use="ais.action.report.format1.sekolah.LaporanSKGuru" width="100%"
						height="100%">
					</window>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include
						src="/WEB-INF/z/x/y/pages/master/sekolah/jenis_sk_guru.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="konfigurasiBiodataGuru"></tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Mahasiswa" visible="false" mode="popup" position="center,center" border="normal" width="90%" height="99%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.KegiatanSiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Kegiatan Siswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					id="parameterJenisKegiatanTab">
					Parameter Jenis Kegiatan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					id="jenisKegiatanTab">
					Jenis Kegiatan
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="parameterTab">
					Parameter
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="pembinaTab">
					Pembina
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRekapData">
					Rekap Data
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kegiatan_siswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Siswa" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Pembina" />
									<bandbox
									use="ais.action.master.helper.AmbilDataTbmuserBanbox"
									readonly="true" forward="onOK=onSearchDefault"
									id="searchpembina" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis" />
									<combobox
									forward="onChange=onSearchDefault" id="searchjenis"
									width="95%" />

									
									<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
									<combobox
									forward="onChange=onSearchDefault" id="searchyayasan"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault"  width="95%"/>
									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column width="18%"
									use="ais.ui.util.MyColumnConfig" label="Siswa" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Jenis" />
									<column width="12%"
									use="ais.ui.util.MyColumnConfig" label="Pembina" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Waktu" width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="TA" width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>

									<column width="25%"
									use="ais.ui.util.MyColumnConfig" label="Data Kegiatan" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/sekolah/parameter_tambahan_kegiatan_siswa.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/sekolah/kelompok_kegiatan_siswa.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/parameter_tambahan.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/sekolah/pembina_siswa.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapDataPanel"></tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Kegiatan Siswa" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

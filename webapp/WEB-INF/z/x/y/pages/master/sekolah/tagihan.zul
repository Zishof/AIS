<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.TagihanAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;tagihan&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						
										<columns>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
										</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Siswa" />
						<bandbox use="ais.action.master.sekolah.helper.AmbilDataSiswaBanbox" id="banboxSiswa" width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Calon Siswa" />
						<bandbox use="ais.action.master.sekolah.helper.AmbilDataCalonSiswaBanbox" id="banboxCalonSiswa" width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Tahun Ajaran" />
						<combobox id="searchTahunAjaran" forward="onChange=onSearchDefault" width="95%" readonly="true"/>
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Cari Nama" />
						<textbox forward="onOK=onSearchDefault" id="searchnama"
						width="95%" />

						<label use="ais.ui.util.MyLabelConfig" value="Bulan"/>
						<textbox forward="onOK=onSearchDefault" id="searchbulan"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Tahun"/>
						<textbox forward="onOK=onSearchDefault" id="searchtahun"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Item Biaya" />
						<textbox forward="onOK=onSearchDefault"
						id="searchitembiaya" width="95%" />

						
						<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
						<combobox forward="onChange=onSearchDefault"
						id="searchyayasan"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
						<combobox id="searchsekolah"
						forward="onChange=onSearchDefault"  width="95%"/>
						<checkbox id="searchaktif"
						label="Tampilkan hanya yang aktif" checked="true"
						forward="onClick=onSearchDefault" width="95%" />
						<checkbox id="searchbelumlunas"
						label="Tampilkan hanya yang belum lunas" checked="true"
						forward="onClick=onSearchDefault" width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig" label="Siswa" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Item Biaya" />
						<column use="ais.ui.util.MyColumnConfig" label="Bulan"
						width="10%" />
						<column use="ais.ui.util.MyColumnConfig" label="Tahun"
						width="10%" />
						<column use="ais.ui.util.MyColumnConfig" label="T/A"
						width="10%" />
						<column use="ais.ui.util.MyColumnConfig" label="Lunas"
						width="5%" />
						<column use="ais.ui.util.MyColumnConfig" align="right"
						label="Nominal" width="8%" />
						<column use="ais.ui.util.MyColumnConfig" align="right"
						label="Denda" width="8%" />
						<column use="ais.ui.util.MyColumnConfig" label="Info"
						/>
						<column use="ais.ui.util.MyColumnConfig" label="Aktif"
						width="5%" />
						<column use="ais.ui.util.MyColumnConfig" width="5%" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Jenis Guru" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="350px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

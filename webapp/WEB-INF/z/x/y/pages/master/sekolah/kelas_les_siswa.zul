<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.KelasLesSiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Kelas Les
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMasa">
					Masa Pembelajaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onSertifikat">
					Sertifikat
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kelas_les_siswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									
										<columns>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
										</columns>
									<rows>
									<row>

									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Kelas" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Tingkat" />
									<intbox
									use="ais.ui.util.MyIntbox" forward="onOK=onSearchDefault"
									id="searchtingkat" width="95%" />



									<label
									use="ais.ui.util.MyLabelConfig" value="Siswa" />
									<textbox
									forward="onOK=onSearchDefault" id="searchsiswa" width="95%" />


									</row>

									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
									<combobox
									forward="onChange=onSearchDefault" id="searchyayasan"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault"  width="95%"/>

									<label
									use="ais.ui.util.MyLabelConfig" value="Pembina" />
									<bandbox id="searchguruPembina"
									use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"
									width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Ruang" />
									<textbox
									forward="onOK=onSearchDefault" id="searchruang" width="95%" />

									</row>
									
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
					</row>
					</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Nama Kelas"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Ruang" width="10%" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Sertifikat"
									width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Tingkat"
									width="8%" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Matapelajaran"
									width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Masa" width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Wajib Bayar"
									width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Pembina"
									width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jml Peserta"
									width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="masa"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="sertifikat"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah KelasLesSiswa" visible="false" mode="popup" position="center,center" border="normal" width="750px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

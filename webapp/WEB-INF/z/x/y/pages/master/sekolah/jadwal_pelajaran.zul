<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.JadwalPelajaranAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Jadwal Pelajaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMasa">
					Masa Pembelajaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onLaporanJadwalPelajaran">
					Laporan Jadwal Pelajaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Laporan Kehadiran di Pelajaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Timetable
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;jadwal_pelajaran&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									
									<label use="ais.ui.util.MyLabelConfig" value="Ta"/>
									<combobox
									forward="onChange=onSearchDefault" id="searchta"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Smt"/>
									<combobox id="searchsmt"
									forward="onChange=onSearchDefault"  width="95%"/>
									<label
									use="ais.ui.util.MyLabelConfig" value="Mata Pelajaran" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Kelas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchkelas"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Guru" />
									<bandbox
									use="ais.action.master.sekolah.helper.AmbilDataGuruBanbox"
									id="searchguru" width="95%" />

									
									<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
									<combobox
									forward="onChange=onSearchDefault" id="searchyayasan"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault"  width="95%"/>

									</row>
								<row spans="8">
									<hbox width="95%">
									<label
									use="ais.ui.util.MyLabelConfig" value="TA" />
									<label value="/"></label>
									<label
									use="ais.ui.util.MyLabelConfig" value="Smt" />
									</hbox>
								</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Hari" />
									<combobox
									forward="onChange=onSearchDefault" id="searchhari"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Ruangan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnamaruang"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Siswa" />
									<textbox
									forward="onOK=onSearchDefault" id="searchsiswa" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Keterangan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchketerangan"
									width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Tahun Ajaran"
									width="8%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Mata Pelajaran" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Sekolah" width="0px" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Kelas" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Guru" width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Hari, Jam, Ruang"
									width="35%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>
									<column
									use="ais.ui.util.MyColumnConfig" label="Pert." width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="16%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="masa"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanJadwalPelajaran"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<window width="100%" height="100%"
						use="ais.action.report.format1.sekolah.LaporanRekapAbsenSiswaPerTgl">
					</window>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<window width="100%" height="100%"
						use="ais.action.master.sekolah.helper.TimetableJadwalPelajaranWindow">
					</window>
				</tabpanel>

			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Jenis Guru" visible="false" mode="popup" position="center,center" border="normal" width="750px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

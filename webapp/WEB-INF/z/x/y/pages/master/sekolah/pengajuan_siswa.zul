<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.PengajuanSiswaAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Pengajuan Siswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilAsrama">
					Laporan Per Pengajuan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilAsrama1">
					Laporan Per Siswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilAsrama2">
					Rekap Per Siswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilAsrama3">
					Rekap Total
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJenisPengajuan">
					Jenis Pengajuan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenParameter">
					Manajemen Parameter
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onLaporan">
					Laporan
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;pengajuan_siswa&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="NIM" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnim" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Siswa" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Yayasan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchyayasan"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Sekolah" />
									<combobox
									forward="onChange=onSearchDefault" id="searchsekolah"
									width="95%" />
									</row>
									<row>

									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
									<combobox
									forward="onChange=onSearchDefault" id="searchTahunAjaran"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Semester" />
									<combobox
									forward="onChange=onSearchDefault" id="jenisSemester"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis Pengajuan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchJenisPengajuan"
									width="95%" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>


									<column
									use="ais.ui.util.MyColumnConfig" width="15%" label="Siswa" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jenis Pengajuan" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Semester"
									width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Tahun Akademik"
									width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Sekolah" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Yayasan" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Tanggal" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Persetujuan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="15%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAsrama"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAsrama1"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAsrama2"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="laporanAsrama3"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="jenisPengajuanTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tabManajemenParameter"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tabLaporan"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Pendaftaran Cuti Siswa" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

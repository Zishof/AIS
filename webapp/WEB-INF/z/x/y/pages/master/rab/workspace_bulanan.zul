<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.rab.WorkspaceBulananAction" width="100%"
		height="100%">

		<borderlayout>
									<north border="none" size="152px" autoscroll="true" flex="false" splittable="false">
				<div style="padding:12px;box-sizing:border-box;">
					<div sclass="ais-crud-filter-card">
						<div sclass="ais-crud-filter-head">
							<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
						<div sclass="ais-crud-filter-actions">
							<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;workspace_bulanan&quot;, &quot;Bantuan&quot;);"/>
						</div>
						</div>
						<div sclass="ais-crud-filter-body">

				<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">

					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
							width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
							width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column width="40%"
							use="ais.ui.util.MyColumnConfig">
						</column>
					</columns>
					<rows>

						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="Tahun Anggaran" />
							<combobox forward="onChange=onReloadTab"
								readonly="true" id="tahunWorkspace" width="95%" />
							<label use="ais.ui.util.MyLabelConfig"
								value="Satuan Kerja" />
							<bandbox
								use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
								readonly="true" id="satuanKerja" width="95%" />

							<label use="ais.ui.util.MyLabelConfig"
								visible="false" id="sumberDanaLabel" value="Sumber Dana" />
							<combobox id="sumberDana" width="95%"
								visible="false" />

							<hbox>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig"
									tooltiptext="Buat Revisi Baru" id="addNewRevisi"
									forward="onClick=onCreateNewRevisi" label="Buat Revisi Baru"
									image="/img/new.gif">
								</toolbarbutton>
							</hbox>
						</row>


					</rows>
				</grid>
						</div>
					</div>
				</div>
			</north>
			<center border="none" flex="true">

				<tabbox height="100%" width="100%" id="tabbox">
					<tabs id="tabs"></tabs>
					<tabpanels id="tabpanels"></tabpanels>

				</tabbox>



			</center>

		</borderlayout>

		</window>


</zk>
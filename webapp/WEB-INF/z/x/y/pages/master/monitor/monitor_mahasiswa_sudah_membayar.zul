<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.monitor.MonitorMahasiswaSudahMembayarAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;monitor_mahasiswa_sudah_membayar&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Angkatan" />
						<decimalbox id="searchtahun"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Status" />
						<combobox id="searchstatus"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig" value="Fakultas"
						/>
						<combobox
						forward="onChange=onSearchDefault" id="searchfakultas"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Jenjang" />
						<combobox id="searchjenjang"
						forward="onChange=onSearchDefault" width="95%" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Nama" />
						<textbox id="searchnama"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Status Awal Mahasiswa" />
						<combobox
						id="searchStatusAwalMahasiswa"
						forward="onChange=onSearchDefault" width="95%" />

						<label use="ais.ui.util.MyLabelConfig" value="Prodi"
						/>
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tidak Mempunyai Dosen PA" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchdosenPA"
						forward="onCheck=onSearchDefault" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="NIM" />
						<textbox id="searchnim"
						forward="onOK=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Program" />
						<combobox id="searchprogram"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Konsentrasi" />
						<combobox
						forward="onChange=onSearchDefault" id="searchkonsentrasi"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Dosen PA" />
						<bandbox id="searchdosen"
						use="ais.action.master.helper.AmbilDataDosenBanbox"
						width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>


						<column use="ais.ui.util.MyColumnConfig" width="10%" label="NIM" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Nama" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Angkatan" />
						<column use="ais.ui.util.MyColumnConfig" width="5%"
						label="WNI/WNA" />
						<column use="ais.ui.util.MyColumnConfig" width="5%"
						label="Mulai" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Fakultas"  />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Prodi"  />

						<column use="ais.ui.util.MyColumnConfig" label="Tahun Akademik" />
						<column use="ais.ui.util.MyColumnConfig" label="Semester" />
						<column use="ais.ui.util.MyColumnConfig" label="Tunggakan"
						align="right" />

						<column use="ais.ui.util.MyColumnConfig" label="Dibayar"
						align="right" />


					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

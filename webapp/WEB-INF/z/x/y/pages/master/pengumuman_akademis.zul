<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.PengumumanAkademisAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Pengumuman Akademik
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKategoriPengumuman">
					Kategori Pengumuman
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTeksBerjalan">
					Teks Berjalan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPengumumanPerkuliahan">
					Pengumuman Perkuliahan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onPenumumanWebsite">
					Berita Website
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;pengumuman_akademis&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>

									<label use="ais.ui.util.MyLabelConfig" value="Judul" />
									<textbox forward="onOK=onSearchDefault"
									id="searchjudul" width="95%" />


									<label use="ais.ui.util.MyLabelConfig" value="Diperuntukkan"/>
									<combobox id="searchDiperuntukkan"
									forward="onChange=onSearchDefault"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Kategori Pengumuman"/>
									<combobox id="searchKategoriPengumuman"
									forward="onChange=onSearchDefault"  width="95%"/>



									<label use="ais.ui.util.MyLabelConfig" value="Fakultas"/>
									<combobox forward="onChange=onSearchDefault"
									id="searchfakultas" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Prodi"/>
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />


									<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
									<combobox forward="onChange=onSearchDefault"
									id="searchyayasan" width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault" width="95%" />



									</row>

									<row>
									<label use="ais.ui.util.MyLabelConfig"
									value="Isi Pengumuman" />
									<textbox forward="onOK=onSearchDefault" id="searchisi"
									width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Unit/PT" />
									<combobox forward="onChange=onSearchDefault"
									id="searchPerguruanTinggi" width="95%" />

									<label use="ais.ui.util.MyLabelConfig"
									id="value_tahun_akademik" value="Tahun Akademik" />
									<combobox id="searchTahunAjaran"
									forward="onChange=onSearchDefault" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Program" />
									<combobox id="searchprogram"
									forward="onChange=onSearchDefault" width="95%" />
									</row>
									
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
					</row>
					</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig" width="50px" />
									<column use="ais.ui.util.MyColumnConfig" width="9%"
									id="label_tahun_akademik" label="Tahun Akademik" />
									<column use="ais.ui.util.MyColumnConfig" width="9%"
									label="Diperuntukkan" />
									<column use="ais.ui.util.MyColumnConfig" width="9%"
									label="Mulai" sort="auto(tanggal)" />
									<column use="ais.ui.util.MyColumnConfig" width="9%"
									label="Sampai" sort="auto(sampai)" />
									<column use="ais.ui.util.MyColumnConfig" width="19%"
									label="Judul" sort="auto(judul)" />
									<column use="ais.ui.util.MyColumnConfig" width="0%"
									label="Oleh" sort="auto(oleh)" />
									<column use="ais.ui.util.MyColumnConfig" width="14%"
									label="Digunakan oleh" />
									<column use="ais.ui.util.MyColumnConfig" width="7%"
									label="Program" />
									<column use="ais.ui.util.MyColumnConfig" width="7%"
									label="Waktu" />
									<column use="ais.ui.util.MyColumnConfig" width="5%"
									label="Aktif" />
									<column use="ais.ui.util.MyColumnConfig" width="5%"
									label="Komentar" />
									<column use="ais.ui.util.MyColumnConfig" width="7%"
									label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="kategoriPengumumanTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="teksBerjalanTab"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="pengumumanPerkuliahan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="penumumanWebsiteTab"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Pengumuman" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
	org.zkoss.zk.ui.Component awa = addWindow.getFellowIfAny("addWindowAttachment");
	if (awa != null) awa.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.TemplatePerkuliahanDetailAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;template_perkuliahan_detail&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="10%"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="10%"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="10%"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="10%"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>


						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Hari" />
						<combobox id="searchhari"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Waktu Perkuliahan" />
						<combobox id="searchwaktu"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Paralel" />
						<checkbox use="ais.ui.util.MyCheckboxConfig"
						forward="onCheck=onSearchDefault" id="searchparalel" />

						<label use="ais.ui.util.MyLabelConfig" value="Ruang" />
						<bandbox
						use="ais.action.master.helper.AmbilDataRuangBanbox"
						forward="onChange=onSearchDefault" id="searchruang"
						width="95%" />

						</row>
						<row>

						<label use="ais.ui.util.MyLabelConfig" value="Dosen"
						id="label_dosen" />
						<bandbox id="searchdosen"
						use="ais.action.master.helper.AmbilDataDosenBanbox"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Matakuliah"
						id="label_matakuliah" />
						<bandbox
						use="ais.action.master.helper.AmbilDataMatakuliahBanbox"
						forward="onChange=onSearchDefault" id="searchmatakuliah"
						width="95%" />

						<label use="ais.ui.util.MyLabelConfig" value="Fakultas"
						/>
						<combobox
						forward="onChange=onSearchDefault" id="searchfakultas"
						width="95%" />

						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Program" />
						<combobox id="searchprogram"
						forward="onChange=onSearchDefault" width="95%" />




						<label use="ais.ui.util.MyLabelConfig" value="Kelas" />
						<textbox
						forward="onOK=onSearchDefault" id="searchkelas" width="95%" />

						<label use="ais.ui.util.MyLabelConfig" value="Prodi"
						/>
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault" width="95%" />


						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>



						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Hari" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Waktu" />
						<column use="ais.ui.util.MyColumnConfig" width="10%" label="Jam" />
						<column use="ais.ui.util.MyColumnConfig" label="Matakuliah"
						/>
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Dosen 1" id="label_dosen_1" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Dosen 2" id="label_dosen_2" />
						<column use="ais.ui.util.MyColumnConfig" width="10%"
						label="Ruangan" />
						<column use="ais.ui.util.MyColumnConfig" width="5%" label="Kap" />
						<column use="ais.ui.util.MyColumnConfig" width="5%"
						label="Kelas" />

						<column use="ais.ui.util.MyColumnConfig" width="10%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Perkuliahan" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="480px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.TunggakanMahasiswaAction" width="100%"
		height="100%">



		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">Tunggakan Mahasiswa</tab>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilRekapTunggakanMahasiswa">
					Rekap Tunggakan Mahasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTampilRekapTunggakanMahasiswaDetail">
					Rekap Tunggakan Mahasiswa Detail
				</tab>
				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onProsesUlangTunggakan">
					Proses Ulang Tunggakan / Tagihan Mahasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onProsesUlangTunggakanMahasiswaBaru">
					Proses Ulang Tunggakan / Tagihan Mahasiswa Baru
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">



					<panel use="ais.ui.util.MyPanel" width="100%"
						height="100%" id="panel" title="Data Tunggakan Mahasiswa">
						<panelchildren>
							<borderlayout>

								<center border="none" flex="true">
									<borderlayout>
										<north border="none"
											open="true">
											<grid use="ais.ui.util.MyGrid"  fixedLayout="true">
												<columns>
													<column use="ais.ui.util.MyColumnConfig"
														width="100px">
													</column>
													<column use="ais.ui.util.MyColumnConfig"></column>
													<column use="ais.ui.util.MyColumnConfig"
														width="100px">
													</column>
													<column use="ais.ui.util.MyColumnConfig"></column>
													<column use="ais.ui.util.MyColumnConfig"
														width="100px">
													</column>
													<column use="ais.ui.util.MyColumnConfig"></column>
													<column use="ais.ui.util.MyColumnConfig"
														width="100px">
													</column>
													<column use="ais.ui.util.MyColumnConfig"></column>
												</columns>
												<rows>

													<row>

														<label use="ais.ui.util.MyLabelConfig"
															value="Tahun Angkatan" />
														<decimalbox
															id="searchtahun" forward="onOK=onSearchDefault"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Status" />
														<combobox
															id="searchstatus" forward="onChange=onSearchDefault"
															width="95%" />

														<label use="ais.ui.util.MyLabelConfig"
															value="Fakultas"  />
														<combobox
															forward="onChange=onSearchDefault" id="searchfakultas"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Jenjang" />
														<combobox
															id="searchjenjang" forward="onChange=onSearchDefault"
															width="95%" />
													</row>
													<row>
														<label use="ais.ui.util.MyLabelConfig"
															value="Nama" />
														<textbox
															id="searchnama" forward="onOK=onSearchDefault"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Status Awal Mahasiswa" />
														<combobox
															id="searchStatusAwalMahasiswa"
															forward="onChange=onSearchDefault" width="95%" />

														<label use="ais.ui.util.MyLabelConfig"
															value="Prodi"  />
														<combobox
															id="searchjurusan" forward="onChange=onSearchDefault"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Tidak Mempunyai Dosen PA" />
														<checkbox use="ais.ui.util.MyCheckboxConfig"
															id="searchdosenPA" forward="onCheck=onSearchDefault" />
													</row>
													<row>
														<label use="ais.ui.util.MyLabelConfig"
															value="NIM" />
														<textbox
															id="searchnim" forward="onOK=onSearchDefault"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Program" />
														<combobox
															id="searchprogram" forward="onChange=onSearchDefault"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Konsentrasi" />
														<combobox
															forward="onChange=onSearchDefault" id="searchkonsentrasi"
															width="95%" />
														<label use="ais.ui.util.MyLabelConfig"
															value="Dosen PA" />
														<bandbox
															id="searchdosen"
															use="ais.action.master.helper.AmbilDataDosenBanbox"
															width="95%" />
													</row>

													<row spans="8">

														<toolbar>

															<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
																tooltiptext="Cari data"
																forward="onClick=onSearchDefault" id="find" label="Cari"
																image="/img/search.gif">
															</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;tunggakan_mahasiswa&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
													</row>
												</rows>
											</grid>

										</north>
										<center border="none" flex="true">

											<grid use="ais.ui.util.MyGrid"  fixedLayout="true"
												id="grid" mold="paging" pageSize="25">
												<columns>
													<column use="ais.ui.util.MyColumnConfig"
														width="40px" />
													<column use="ais.ui.util.MyColumnConfig" width="10%"
														label="NIM" />
													<column use="ais.ui.util.MyColumnConfig" width="10%"
														label="Nama" />
													<column use="ais.ui.util.MyColumnConfig" width="10%"
														label="Angkatan" />
													<column use="ais.ui.util.MyColumnConfig" width="5%"
														label="WNI/WNA" />
													<column use="ais.ui.util.MyColumnConfig" width="5%"
														label="Mulai" />
													<column use="ais.ui.util.MyColumnConfig" width="10%"
														label="Fakultas"  />
													<column use="ais.ui.util.MyColumnConfig" width="10%"
														label="Prodi"  />

													<column use="ais.ui.util.MyColumnConfig"
														label="Tahun Akademik" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Semester" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Tunggakan" align="right" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Sisa Tunggakan" align="right" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Status" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Dibayar" align="right" />
													<column use="ais.ui.util.MyColumnConfig" width="4%" />
												</columns>

											</grid>


										</center>
										<south border="none">
											<paging visible="false"
												id="paging" />
										</south>
									</borderlayout>
								</center>
							</borderlayout>
						</panelchildren>
					</panel>



				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapTunggakan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapTunggakanDetail"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="prosesUlangTunggakan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="prosesUlangTunggakanMahasiswaBaru"></tabpanel>
			</tabpanels>
		</tabbox>

	</window>


</zk>
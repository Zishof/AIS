<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.employ.UsulanPegawaiHabisKontrakAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;usulan_pegawai_habis_kontrak&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Kode/NIP" />
						<textbox id="searchcode" forward="onOK=onSearchDefault"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Nama" />
						<textbox id="searchnama" forward="onOK=onSearchDefault"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Status" />
						<combobox id="searchstatus"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Selisih Bulan habis kontrak" />
						<combobox id="searchselisih"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
						<bandbox
						use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
						id="searchparent" width="95%">
						</bandbox>

						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig" width="70px" />
						<column use="ais.ui.util.MyColumnConfig" width="9%"
						label="NIP" sort="auto(code)" />
						<column use="ais.ui.util.MyColumnConfig" label="Nama"
						width="20%" sort="auto(nama)" />
						<column use="ais.ui.util.MyColumnConfig" width="11%"
						label="Masa Kerja" />
						<column use="ais.ui.util.MyColumnConfig" width="11%"
						label="Sisa Masa Kerja" />
						<column use="ais.ui.util.MyColumnConfig" width="9%"
						label="Status" />
						<column use="ais.ui.util.MyColumnConfig" width="9%"
						label="Jabatan" />
						<column use="ais.ui.util.MyColumnConfig" width="9%"
						label="Satuan Kerja" />

						<column use="ais.ui.util.MyColumnConfig" width="11%"
						label="Tanggal Masuk" />
						<column use="ais.ui.util.MyColumnConfig" width="11%"
						label="Tanggal Keluar" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

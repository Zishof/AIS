<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.employ.GajiPokokAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true"
					label="Gaji Pokok">
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onInsentif" label="Insentif">
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMakan" label="Makan">
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTransport" label="Transport">
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKodeTunjangan" label="Kode Tunjangan">
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;gaji_pokok&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>


									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>

									<label
									use="ais.ui.util.MyLabelConfig" value="Golongan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchgolongan"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Peraturan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchperaturan"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Masa Kerja" />
									<intbox
									forward="onOK=onSearchDefault" id="searchmasakerja"
									width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>


									<column
									use="ais.ui.util.MyColumnConfig" label="Golongan"
									sort="auto(golongan)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Peraturan"
									sort="auto(peraturan)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Masa Kerja (MK)"
									width="8%" sort="auto(masaKerja)" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Gaji Pokok (GAPOK)"
									align="right" width="10%" />



									<column
									use="ais.ui.util.MyColumnConfig"
									label="Lain-lain (LAIN_LAIN)" align="right" width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Tanggal Efektif"
									width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenInsentif"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenMakan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenTransport"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenKodeTunjangan"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Gaji Pokok" visible="false" mode="popup" position="center,center" border="normal" width="650px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

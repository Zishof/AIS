<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.employ.KenaikanPangkatAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kenaikan_pangkat&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig"
						width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama Pegawai" />
						<bandbox forward="onOK=onSearchDefault"
						id="searchpegawai" width="95%"
						use="ais.action.master.akunting.helper.AmbilDataPegawaiBanbox" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Satuan Kerja" />
						<bandbox
						use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
						id="searchparent" width="95%">
						</bandbox>
						<label use="ais.ui.util.MyLabelConfig"
						value="Status Persetujuan" />
						<combobox id="searchstatus" width="95%"
						forward="onChange=onSearchDefault">
						</combobox>
						<label use="ais.ui.util.MyLabelConfig"
						value="Status Ubah" />
						<combobox id="searchJenisPerubahan"
						forward="onChange=onSearchDefault" width="95%">
						</combobox>
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" label="Pegawai" width="10%"
						sort="auto(pegawai)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Jabatan" />
						<column
						use="ais.ui.util.MyColumnConfig" label="No/Tgl. usul"
						width="7%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Golongan/Gaji"
						width="7%" align="right" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Insentif" width="7%"
						align="right" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Peraturan" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tgl/No. SK"
						width="7%" />

						<column
						use="ais.ui.util.MyColumnConfig" label="Mulai/Sampai"
						width="7%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Pejabat" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Aktif / Dijabat" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Status" width="5%" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Keterangan"
						width="10%" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah data" visible="false" mode="popup" position="center,center" border="normal" width="750px" height="97%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

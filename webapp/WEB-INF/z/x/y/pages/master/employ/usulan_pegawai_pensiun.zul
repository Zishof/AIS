<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.employ.UsulanPegawaiPensiunAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Pensiun
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKontrak">
					Kontrak
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										id="find" label="Cari" image="/img/search.gif"
										tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;usulan_pegawai_pensiun&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									
										<columns>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
										</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kode/NIP" />
									<textbox id="searchcode"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama" />
									<textbox id="searchnama"
									forward="onOK=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox id="searchstatus"
									forward="onChange=onSearchDefault" width="95%" />


									</row>

									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Tahun"/>
									<decimalbox id="searchtahun"  width="95%"/>
									<label use="ais.ui.util.MyLabelConfig" value="Bulan"/>
									<decimalbox id="searchbulan"  width="95%"/>

									<label
									use="ais.ui.util.MyLabelConfig" value="Selisih Usia Pensiun" />
									<combobox id="searchselisih"
									forward="onChange=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="70px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="NIP"
									sort="auto(code)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="7%"
									label="Usia Pensiun" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Tanggal Lahir" />

									<column
									use="ais.ui.util.MyColumnConfig" width="7%" label="Umur" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="TMT" />

									<column
									use="ais.ui.util.MyColumnConfig" width="5%" label="Jabatan"
									sort="auto(jabatan)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%"
									label="Satuan Kerja" />

									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="panelKontrak"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

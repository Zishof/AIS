<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.surat.KlasifikasiSuratKeluarAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Klasifikasi Surat Keluar
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onNomorSurat">
					Nomor Surat
				</tab>
				
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;klasifikasi_surat_keluar&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

						<column use="ais.ui.util.MyColumnConfig" width="150px" />
						<column use="ais.ui.util.MyColumnConfig" />
									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Kode" />
<textbox id="searchkode" forward="onOK=onSearchDefault" width="95%" />
<label
									use="ais.ui.util.MyLabelConfig"
									value="Nama Klasifikasi Surat Keluar" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Kelompok" />
									<combobox
									id="searchkelompokNomorSurat"
									forward="onChange=onSearchDefault" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>

									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />
									</row>


									<row id="hbFakultasLabel">

									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />

									</row>

									<row id="hbYayasan">

									<label
									use="ais.ui.util.MyLabelConfig" value="Yayasan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchyayasan"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Sekolah" />
									<combobox id="searchsekolah"
									forward="onChange=onSearchDefault" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Kode"
									sort="auto(kode)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama Klasifikasi"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Diperuntukkan"
									width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nomor Surat"
									width="15%" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Persetujuan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Sifat" />

									<column
									use="ais.ui.util.MyColumnConfig" width="15%" label="Unit" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Pengguna" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>
									<column
									use="ais.ui.util.MyColumnConfig" width="7%" label="Aktif" />
									<column
									use="ais.ui.util.MyColumnConfig" width="7%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenNomorSurat">



				</tabpanel>


			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Klasifikasi Surat Keluar" visible="false" mode="popup" position="center,center" border="normal" width="97%" height="97%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

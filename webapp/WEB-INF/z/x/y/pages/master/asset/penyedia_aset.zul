<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.asset.PenyediaAssetAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true"
					forward="onClick=onDashboardVendor">
					Dashboard
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Penyedia
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJenisPenyedia">
					Jenis Penyedia
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKategoriPenyedia">
					Kategori Penyedia
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatusPenyedia">
					Status Penyedia
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onDokumenPenyedia">
					Dokumen Penyedia
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onCheck">
					Verifikasi Dokumen
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onJenisPekerjaan">
					Jenis Pekerjaan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onCalonVendor">
					Calon Vendor
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel" id="dashboardVendor" style="overflow:auto;"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;penyedia_aset&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

						<column use="ais.ui.util.MyColumnConfig" width="150px" />
						<column use="ais.ui.util.MyColumnConfig" />
									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Kode" />
<textbox id="searchkode" forward="onOK=onSearchDefault" width="95%" />
<label
									use="ais.ui.util.MyLabelConfig" value="Nama / Kode / NPWP" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<checkbox id="searchaktif"
									label="Tampilkan hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />

									</row>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kategori" />
									<combobox id="searchKategori" width="95%" readonly="true"
									forward="onSelect=onSearchDefault" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis" />
									<combobox id="searchJenis" width="95%" readonly="true"
									forward="onSelect=onSearchDefault" />
									</row>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox id="searchStatus" width="95%" readonly="true"
									forward="onSelect=onSearchDefault" />
									<label
									use="ais.ui.util.MyLabelConfig" value="" />
									<checkbox id="searchBelumLengkap"
									label="Hanya yang belum lengkap"
									forward="onClick=onSearchDefault" width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Kode"
									sort="auto(kode)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="12%"
									label="Nama Penyedia" sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Jenis" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Kategori" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="Status" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Alamat" width="15%"
									sort="auto(alamat)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jenis" width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%" label="" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="jenisPenyedia"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="kategoriPenyedia"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="statusPenyedia"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="dokumenPenyedia"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="verifikasiDokumen"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="jenisPekerjaan"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="calonVendor" style="overflow:auto;"></tabpanel>

			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Penyedia" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

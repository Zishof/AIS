<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.asset.AssetAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Inventaris
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onInventaris">
					Rekap Inventaris
				</tab>


			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;asset&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>


									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Asset" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis Asset" />
									<combobox
									forward="onChange=onSearchDefault" id="searchjenisAsset"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Kelompok Asset" />
									<combobox
									forward="onChange=onSearchDefault" id="searchkelompokAsset"
									width="95%" />



									</row>

									<row>

									<label
									use="ais.ui.util.MyLabelConfig" value="Ruang" />
									<bandbox
									use="ais.action.master.helper.AmbilDataRuangBanbox"
									id="searchruang" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Lokasi" />
									<combobox
									forward="onChange=onSearchDefault" id="searchLokasi"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>


									<column
									use="ais.ui.util.MyColumnConfig" width="40px" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Kode Asset" />

									<column
									use="ais.ui.util.MyColumnConfig" width="18%"
									label="Nama Asset"  />

									<column
									use="ais.ui.util.MyColumnConfig" label="Jenis"
									sort="auto(jenisAsset)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Kelompok"
									sort="auto(kelompokAsset)" />


									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jml" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="rekapInventaris"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Asset" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="200px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

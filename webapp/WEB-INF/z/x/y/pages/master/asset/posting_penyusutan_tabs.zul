<?page id="postingPenyusutanTabs" title="Posting Penyusutan" cacheable="false" language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.akunting.PostingPenyusutanTabsAction" width="100%" height="100%">
		<tabbox width="100%" height="100%">
			<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true" forward="onClick=onFixAset">Fix Aset (Jurnal Saat BAST)</tab>
				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onPekerjaan">Aset dalam Pekerjaan (Jurnal Saat BAST)</tab>
				<tab use="ais.ui.util.MyTabConfig" forward="onClick=onPenyusutan">Penyusutan</tab>
			</tabs>
			<tabpanels>
				<tabpanel use="ais.ui.util.MyTabpanel" id="panelFixAset" />
				<tabpanel use="ais.ui.util.MyTabpanel" id="panelPekerjaan" />
				<tabpanel use="ais.ui.util.MyTabpanel" id="panelPenyusutan" />
			</tabpanels>
		</tabbox>
	</window>
</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.asset.PermintaanPengadaanMasterAssetAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Permintaan Barang/Jasa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onStatistik">
					Statistik
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onRiwayatHargaBarangJasa">
					Riwayat Harga Barang/Jasa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onTraceStatusBarangJasa">
					Trace Status Barang / Jasa
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;permintaan_asset&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Kode " />
									<textbox
									forward="onOK=onSearchDefault" id="searchkode" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Lokasi" />
									<combobox
									forward="onChange=onSearchDefault" id="searchlokasi"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>

									<label
									use="ais.ui.util.MyLabelConfig" value="Anggaran" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataWorkspaceBanbox"
									id="searchAnggaran" width="95%" />

									</row>


									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Anggaran" />
									<textbox
									forward="onOK=onSearchDefault" id="searchanggaran"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Keterangan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchketerangan"
									width="95%" />

									<checkbox
									use="ais.ui.util.MyCheckboxConfig" label="Belum Disetujui"
									checked="true" forward="onCheck=onSearchDefault"
									id="blmDisetujui">
									</checkbox>


									<checkbox
									use="ais.ui.util.MyCheckboxConfig" label="Disetujui"
									checked="true" forward="onCheck=onSearchDefault"
									id="disetujui">
									</checkbox>


									<checkbox id="searchtutup"
									label="Hanya yang belum tutup" checked="true"
									forward="onClick=onSearchDefault" width="95%" />

									<checkbox id="searchaktif"
									label="Hanya yang aktif" checked="true"
									forward="onClick=onSearchDefault" width="95%" />
									</row>
															<row>
							<label use="ais.ui.util.MyLabelConfig" value="Dari Tanggal" />
							<datebox use="ais.ui.util.MyDatebox" id="start" format="dd/MM/yyyy" forward="onChange=onSearchDefault" width="95%" />
							<label use="ais.ui.util.MyLabelConfig" value="Sampai Tanggal" />
							<datebox use="ais.ui.util.MyDatebox" id="end" format="dd/MM/yyyy" forward="onChange=onSearchDefault" width="95%" />
						</row>
						<row>
							<label use="ais.ui.util.MyLabelConfig" value="Status Persetujuan" />
							<combobox id="searchStatusPersetujuan" width="95%" readonly="true" value="Semua" forward="onChange=onSearchDefault">
								<comboitem label="Semua" />
								<comboitem label="Belum Disetujui" />
								<comboitem label="Telah Disetujui" />
							</combobox>
						</row>
</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="40px" label="" />
									<column width="15%"
									use="ais.ui.util.MyColumnConfig" label="Kode"
									sort="auto(kode)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Anggaran"
									align="right" width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Permintaan"
									align="right" width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Saldo"
									align="right" width="10%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Pemilik"
									width="0px" sort="auto(pemilikAsset)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Lokasi" width="10%"
									sort="auto(lokasi)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Ruang" width="0px"
									sort="auto(ruang)" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Diajukan" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Disetujui" />
									<column
									use="ais.ui.util.MyColumnConfig" width="5%"
									label="Wajib PKS" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="statistik"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="riwayatHargaBarangJasa"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="traceStatusBarangJasa"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Pemakaian" visible="false" mode="popup" position="center,center" border="normal" width="95%" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

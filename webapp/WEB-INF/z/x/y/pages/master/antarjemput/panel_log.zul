<zk xmlns="http://www.zkoss.org/2005/zul">
	<borderlayout>
		<north border="none" size="110px">
			<div>
				<html><![CDATA[<div class="aj-panel-info">
					<strong>Log Notifikasi Soundbox</strong> &mdash;
					Setiap kali sistem mengirimkan suara panggilan ke soundbox kelas, rekaman pengirimannya
					tercatat di sini lengkap dengan status berhasil atau gagal dan jumlah percobaan pengiriman.
					Log ini sangat berguna untuk memastikan soundbox berfungsi normal dan tidak ada panggilan yang terlewat.
				</div>]]></html>
				<toolbar sclass="aj-filter">
					<label use="ais.ui.util.MyLabelConfig" value="Cari:" style="font-size:12px;color:#475569;font-weight:600;" />
					<textbox id="searchLog" width="220px"
						forward="onOK=onSearchLog"
						tooltiptext="Cari berdasarkan perangkat tujuan atau isi pesan" />
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
						label="Cari" image="/img/search.gif"
						forward="onClick=onSearchLog"
						tooltiptext="Cari log notifikasi" />
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
						label="Refresh" image="/img/refresh.gif"
						forward="onClick=onRefresh"
						tooltiptext="Muat ulang log notifikasi soundbox" />
				</toolbar>
			</div>
		</north>
		<center border="none">
			<grid use="ais.ui.util.MyGrid" id="gridLog" sclass="dgrid" fixedLayout="true">
				<columns>
					<column use="ais.ui.util.MyColumnConfig" label="Kanal"      width="110px" />
					<column use="ais.ui.util.MyColumnConfig" label="Perangkat"  width="180px" />
					<column use="ais.ui.util.MyColumnConfig" label="Pesan" />
					<column use="ais.ui.util.MyColumnConfig" label="Status"     width="120px" />
					<column use="ais.ui.util.MyColumnConfig" label="Percobaan"  width="80px"  align="center" />
					<column use="ais.ui.util.MyColumnConfig" label="Waktu"      width="150px" />
				</columns>
			</grid>
		</center>
		<south border="none" size="32px">
			<paging id="pagingLog" detailed="true" />
		</south>
	</borderlayout>
</zk>

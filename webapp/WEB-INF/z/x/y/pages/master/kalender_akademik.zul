<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KalenderAkademikAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;kalender_akademik&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						
										<columns>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
											<column use="ais.ui.util.MyColumnConfig" width="90px"/>
											<column use="ais.ui.util.MyColumnConfig"/>
										</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama Konfigurasi" />
						<textbox forward="onOK=onSearchDefault"
						id="searchkonfigurasi" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Jenjang" />
						<combobox id="searchJenjang"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tanggal Mulai" />
						<datebox use="ais.ui.util.MyDatebox"
						id="searchTanggalMulai" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Ganjil/Genap" />
						<combobox forward="onChange=onSearchDefault"
						id="searchGanjilGenap" width="95%" />
						</row>

						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="Semester" />
						<combobox forward="onChange=onSearchDefault"
						id="searchSemester" width="95%" />

						<label use="ais.ui.util.MyLabelConfig"
						value="Tanggal Selesai" />
						<datebox use="ais.ui.util.MyDatebox"
						id="searchTanggalSelesai" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Nama/Keterangan" />
						<textbox forward="onOK=onSearchDefault"
						id="searchnama" width="95%" />


						
						<label use="ais.ui.util.MyLabelConfig" value="Fakultas"/>
						<combobox
						forward="onChange=onSearchDefault" id="searchfakultas"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Prodi"/>
						<combobox id="searchjurusan"
						forward="onChange=onSearchDefault"  width="95%"/>

						</row>
					<row spans="8">
						<hbox width="95%" id="hbFakultasLabel">
						<label use="ais.ui.util.MyLabelConfig"
						value="Fakultas" />
						<label value="/"></label>
						<label use="ais.ui.util.MyLabelConfig"
						value="Prodi" />
						</hbox>
					</row>

						<row>

						<label use="ais.ui.util.MyLabelConfig"
						value="Program" />
						<combobox id="searchProgram"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox forward="onChange=onSearchDefault"
						id="searchTahunAjaran" width="95%" />

						
						<label use="ais.ui.util.MyLabelConfig" value="Yayasan"/>
						<combobox
						forward="onChange=onSearchDefault" id="searchyayasan"  width="95%"/>
						<label use="ais.ui.util.MyLabelConfig" value="Sekolah"/>
						<combobox id="searchsekolah"
						forward="onChange=onSearchDefault"  width="95%"/>

						</row>
						
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="" />
						<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Tampilkan hanya yang aktif" checked="true" forward="onClick=onSearchDefault" width="95%" />
					</row>
					</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column
						use="ais.ui.util.MyColumnConfig" width="40px" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Nama Kegiatan" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Deskripsi" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tahun Akademik"
						sort="auto(tahunAjaran)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Status" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tanggal Mulai"
						sort="auto(tanggalMulai)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Tanggal Selesai"
						sort="auto(tanggalSelesai)" />
						<column width="0px"
						use="ais.ui.util.MyColumnConfig" label="DiTetapkan Oleh"
						sort="auto(ditetapkanOleh)" />
						<column width="0px"
						use="ais.ui.util.MyColumnConfig" label="Unit" />
						<column width="0px"
						use="ais.ui.util.MyColumnConfig" label="Prodi" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Semester"
						sort="auto(semester)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Jenjang"
						sort="auto(jenjang)" />
						<column
						use="ais.ui.util.MyColumnConfig" label="Program"
						sort="auto(program)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%"
						label="Ganjil/Genap" sort="auto(ganjilGenap)" />
						<column
						use="ais.ui.util.MyColumnConfig" width="5%" label="" />
						<column
						use="ais.ui.util.MyColumnConfig" width="7%" label="" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Kalender Akademik" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

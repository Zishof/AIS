<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window" width="100%" height="100%">

		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">Fakultas</tab>
				<tab use="ais.ui.util.MyTabConfig">Jurusan</tab>
				<tab use="ais.ui.util.MyTabConfig">Program Studi</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<include height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/fakultas.zul">
					</include>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<include height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/grup_jurusan.zul">
					</include>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<include height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/jurusan.zul">
					</include>
				</tabpanel>


			</tabpanels>
		</tabbox>


	</window>


</zk>
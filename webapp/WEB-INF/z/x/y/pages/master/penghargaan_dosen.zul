<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.PenghargaanDosenAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Karya Dosen
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onKategoriPenghargaan">
					Bentuk Penghargaan
				</tab>


			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;penghargaan_dosen&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Kejuaraan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Dosen" />
									<bandbox
									use="ais.action.master.helper.AmbilDataDosenBanbox"
									forward="onChange=onSearchDefault" id="searchdosen"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Tgl. Mulai" />
									<datebox
									use="ais.ui.util.MyDatebox"
									forward="onChange=onSearchDefault" id="searchmulai"
									width="95%" />
									<label
									use="ais.ui.util.MyLabelConfig" value="Tgl. Sampai" />
									<datebox
									use="ais.ui.util.MyDatebox"
									forward="onChange=onSearchDefault" id="searchsampai"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox id="searchstatus"
									forward="onChange=onSearchDefault" width="95%" />

									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Penyelenggara" />
									<textbox
									forward="onOK=onSearchDefault" id="searchpenyelenggara"
									width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Fakultas"/>
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />
									<label use="ais.ui.util.MyLabelConfig" value="Prodi"/>
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
									<combobox id="searchta"
									forward="onChange=onSearchDefault" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Kategori" />
									<combobox
									id="searchkategoriPenghargaan"
									forward="onChange=onSearchDefault" width="95%" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" label="" width="0%" />
									<column id="colNama"
									use="ais.ui.util.MyColumnConfig" label="Dosen" width="11%" />
									<column width="15%"
									use="ais.ui.util.MyColumnConfig" label="Nama Karya"
									sort="auto(nama)" />
									<column width="13%"
									use="ais.ui.util.MyColumnConfig"
									label="Tempat/Penyelenggara/Smt" />
									<column width="13%"
									use="ais.ui.util.MyColumnConfig"
									label="Bentuk Penghargaan" />
									<column width="13%"
									use="ais.ui.util.MyColumnConfig" label="Capaian" />
									<column width="8%"
									use="ais.ui.util.MyColumnConfig" label="No. Sertifikat" />
									<column width="8%"
									use="ais.ui.util.MyColumnConfig" label="Status" />
									<column width="8%"
									use="ais.ui.util.MyColumnConfig" label="Fakultas/Prodi" />
									<column width="0px"
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>
									<column
									use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>





				<tabpanel use="ais.ui.util.MyTabpanel" id="kategoriPenghargaanTab"></tabpanel>



			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Kejuaraan" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

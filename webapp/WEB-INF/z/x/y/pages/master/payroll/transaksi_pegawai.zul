<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>


<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window border="none" id="window"
		apply="ais.action.master.payroll.TransaksiPegawaiAction" width="100%"
		height="100%">

		<tabbox width="100%" height="100%">
			<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Dasbor
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Data Transaksi Pegawai
				</tab>
			</tabs>
			<tabpanels>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<div use="ais.action.master.payroll.helper.DasborTransaksiPegawai"
						width="100%" height="100%" />
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">

		<div sclass="ais-crud-portal">
							<div sclass="ais-crud-filter-card">
								<div sclass="ais-crud-filter-head">
									<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
									<div sclass="ais-crud-filter-actions">
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;transaksi_pegawai&quot;, &quot;Bantuan&quot;);"/></div>
								</div>
								<div sclass="ais-crud-filter-body">
									<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
										<columns>
						<column width="150px"></column>
						<column></column>
						<column width="150px"></column>
						<column></column>
						<column width="150px"></column>
						<column width="200px"></column>
						<column width="150px"></column>
						<column></column>
					</columns>
										<rows>
											<row>

							<label use="ais.ui.util.MyLabelConfig" value="Pegawai" />
							<bandbox
								use="ais.action.master.akunting.helper.AmbilDataPegawaiNotDefaultBanbox"
								forward="onOK=onSearchDefault" id="searchpegawai" width="95%" />

							<label use="ais.ui.util.MyLabelConfig" value="Jenis Transaksi" />
							<combobox forward="onChange=onSearchDefault"
								id="searchJenisTransaksi" width="95%" />

							<label use="ais.ui.util.MyLabelConfig" value="Tanggal Transaksi" />

							<hbox>

								<datebox use="ais.ui.util.MyDatebox"
									forward="onChange=onSearchDefault" id="searchMulai"
									width="80px" />
								<label use="ais.ui.util.MyLabelConfig" value="s.d"></label>
								<datebox use="ais.ui.util.MyDatebox"
									forward="onChange=onSearchDefault" id="searchSampai"
									width="80px" />
							</hbox>



							<label use="ais.ui.util.MyLabelConfig" value="Keterangan" />
							<textbox use="ais.ui.util.MyTextbox"
								forward="onOK=onSearchDefault" id="searchnama" width="95%" />

						</row>
										</rows>
									</grid>
								</div>
							</div>
							<div sclass="ais-crud-data-card">
								<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
								<grid use="ais.ui.util.MyGrid"
								sclass="dgrid" fixedLayout="true" id="grid">
								<columns menupopup="auto">
									<column use="ais.ui.util.MyColumnConfig" label="Pegawai" />
									<column use="ais.ui.util.MyColumnConfig" label="Jenis Transaksi" />
									<column use="ais.ui.util.MyColumnConfig" label="Nilai" align="right" />
									<column use="ais.ui.util.MyColumnConfig" label="Waktu dan tanggal" />
									<column use="ais.ui.util.MyColumnConfig" label="Status Posting"
										width="15%" />
									<column use="ais.ui.util.MyColumnConfig" label="Keterangan"
										 />
									<column width="56px" label=""  align="center"/>
								</columns>

							</grid>
								<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
							</div>
						</div>

				</tabpanel>
			</tabpanels>
		</tabbox>

		

		


		<window use="ais.ui.util.MyWindowJudul" id="addWindow" title="Tambah Transaksi Pegawai"
			visible="false" mode="popup" position="center,center" border="normal"
			width="550px" height="440px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
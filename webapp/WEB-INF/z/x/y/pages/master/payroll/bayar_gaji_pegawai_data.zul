<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window border="none" id="window"
		apply="ais.action.master.payroll.BayarGajiPegawaiAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pembayaran Gaji Pegawai</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Tampilkan" image="/img/search.gif" tooltiptext="Muat ulang data" forward="onClick=onReloadTree"/>
<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;bayar_gaji_pegawai_data&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="90px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
							<column use="ais.ui.util.MyColumnConfig" width="90px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
							<column use="ais.ui.util.MyColumnConfig" width="90px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
							<column use="ais.ui.util.MyColumnConfig" width="90px"/>
							<column use="ais.ui.util.MyColumnConfig"/>
						</columns>
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Pegawai"/>
								<bandbox use="ais.action.master.akunting.helper.AmbilDataPegawaiNotDefaultBanbox" id="searchPegawai" width="95%"/>
								<label use="ais.ui.util.MyLabelConfig" value="Bulan"/>
								<combobox id="bulan" width="95%" forward="onChange=onReloadTree"/>
								<label use="ais.ui.util.MyLabelConfig" value="Tahun"/>
								<intbox id="tahun" width="95%" forward="onChange=onReloadTree"/>
								<label use="ais.ui.util.MyLabelConfig" value="Tgl.Bayar"/>
								<datebox id="tanggalBayar" forward="onChange=onReloadTree" use="ais.ui.util.MyDatebox" width="95%"/>
							</row>
										<row>
							<label use="ais.ui.util.MyLabelConfig" value="Cara"/>
							<combobox id="caraBayar" width="60%"/>
						</row>
										<row>
							<label use="ais.ui.util.MyLabelConfig" value="Format"/>
							<combobox id="pilihFormat" width="60%"/>
						</row>
										<row>
							<label use="ais.ui.util.MyLabelConfig" value=""/>
							<checkbox use="ais.ui.util.MyCheckboxConfig" id="tampilkanRumus" label="Tampilkan Formula" forward="onClick=onReloadTree"/>
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<hbox pack="center" align="start" width="100%">
					<label use="ais.ui.util.MyLabelBolder" value="Periode: "/>
					<label use="ais.ui.util.MyLabelBolder" id="periode"/>
				</hbox>
				<tree width="100%" zclass="z-dottree" height="100%" id="tree">
				</tree>
				<hbox id="spaceBayar" pack="center" align="center" width="100%">
					<button use="ais.ui.util.MyButtonConfig" label="BAYAR" width="300px" height="55px" image="/img/Money-icon_kecil.png" id="save"/>
				</hbox>
			</div>

		</div>

		<!-- ═══ POPUP FILTER LANJUTAN (ZK-native) ═══ -->

</window>

</zk>

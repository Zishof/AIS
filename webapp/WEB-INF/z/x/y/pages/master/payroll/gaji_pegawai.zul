<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.payroll.GajiPegawaiAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onResetParameter" selected="true">
					Manajemen Gaji
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenJenis">
					Manajemen Jenis Gaji
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenParameter">
					Manajemen Parameter Gaji
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onManajemenParameter">
					Bank
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										id="find" label="Cari" image="/img/search.gif"
										tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;gaji_pegawai&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column width="150px"></column>
									<column></column>
									<column width="150px"></column>
									<column></column>
									<column width="150px"></column>
									<column></column>
									<column width="150px"></column>
									<column></column>

									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Kode" />
									<textbox
									use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
									id="searchkode" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Nama" />
									<textbox
									use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
									id="searchnama" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
									<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
									</bandbox>

									<label use="ais.ui.util.MyLabelConfig" value="Jabatan" />
									<textbox
									use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
									id="searchjabatan" width="95%" />

									</row>

									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Cabang" />
									<combobox
									forward="onChange=onSearchDefault" id="searchcabang"
									width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Departemen" />
									<combobox
									forward="onChange=onSearchDefault" id="searchdepartemen"
									width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Level Jabatan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchlevelJabatan"
									width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox
									forward="onChange=onSearchDefault" id="searchstatus"
									width="95%" />


									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig" label="Foto"
									width="70px" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Nama Pegawai" sort="auto(nama)" />
									<column use="ais.ui.util.MyColumnConfig" label="NIP/Kode"
									sort="auto(kode)" width="10%" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Masa Kerja" width="15%" />
									<column use="ais.ui.util.MyColumnConfig" label="Satker"
									width="10%" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Bank Transfer" width="10%" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Format Gaji" width="10%" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Nilai Gaji" align="right" width="10%" />

									<column width="10%"
									label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenJenis"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel" id="manajemenParameter"></tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyInclude" height="100%" width="100%"
						src="/WEB-INF/z/x/y/pages/master/bank.zul">
					</include>
				</tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindowJudul" id="addWindow" title="Tambah Pegawai" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sirs.MonitorKadaluarsaItemAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							id="find" label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;monitor_kadaluarsa_item&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Kode" />
						<textbox use="ais.ui.util.MyTextbox"
						id="searchkode" forward="onOK=onSearchDefault" cols="20" />
						<label use="ais.ui.util.MyLabelConfig" value="Jenis Item" />
						<combobox id="searchjenisItem"
						forward="onChange=onSearchDefault" cols="20" />
						<label use="ais.ui.util.MyLabelConfig" value="Satuan Item" />
						<combobox id="searchsatuanItem"
						forward="onChange=onSearchDefault" cols="20" />
						</row>
						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Nama" />
						<textbox use="ais.ui.util.MyTextbox"
						id="searchnama" forward="onOK=onSearchDefault" cols="20" />
						<label use="ais.ui.util.MyLabelConfig" value="Barcode" />
						<textbox use="ais.ui.util.MyTextbox"
						id="searchbarcode" forward="onOK=onSearchDefault" cols="20" />
						<label use="ais.ui.util.MyLabelConfig" value="Lokasi" />
						<combobox id="searchlokasi"
						forward="onChange=onSearchDefault" cols="20" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig" label="" width="40px" />
						<column use="ais.ui.util.MyColumnConfig" label="Kode" />
						<column use="ais.ui.util.MyColumnConfig" label="Nama" />
						<column use="ais.ui.util.MyColumnConfig" label="Barcode" />
						<column use="ais.ui.util.MyColumnConfig" label="Satuan" />
						<column use="ais.ui.util.MyColumnConfig" label="Jenis" />
						<column use="ais.ui.util.MyColumnConfig" label="Tgl. Kadaluarsa" />
						<column use="ais.ui.util.MyColumnConfig" label="Jml hari" />
						<column use="ais.ui.util.MyColumnConfig" label="Lokasi" />

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

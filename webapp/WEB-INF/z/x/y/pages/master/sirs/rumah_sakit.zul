<?page id="rumahSakitZul" title="Profil Fasilitas Kesehatan" cacheable="false" language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window use="ais.ui.util.MyWindow" border="none" id="window" apply="ais.action.master.sirs.RumahSakitAction" width="100%" height="100%">
        <div sclass="ais-crud-portal">
            <div sclass="ais-crud-filter-card">
                <div sclass="ais-crud-filter-head">
                    <span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
                    <div sclass="ais-crud-filter-actions">
                        <toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah fasilitas kesehatan" forward="onClick=onAdd"/>
                        <toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
                    </div>
                </div>
                <div sclass="ais-crud-filter-body">
                    <grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
                        <columns><column width="150px"/><column/><column width="150px"/><column/></columns>
                        <rows>
                            <row><label value="Kode"/><textbox use="ais.ui.util.MyTextbox" id="searchkode" width="95%" forward="onOK=onSearchDefault"/><label value="Nama Fasilitas"/><textbox use="ais.ui.util.MyTextbox" id="searchnama" width="95%" forward="onOK=onSearchDefault"/></row>
                            <row><label value="Status"/><checkbox id="searchaktif" label="Hanya data aktif" checked="false"/><label/><label/></row>
                        </rows>
                    </grid>
                </div>
            </div>
            <div sclass="ais-crud-data-card">
                <paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
                <grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
                    <columns>
                        <column use="ais.ui.util.MyColumnConfig" width="100px" label="Kode" sort="auto(kode)"/>
                        <column use="ais.ui.util.MyColumnConfig" label="Nama Fasilitas" sort="auto(nama)"/>
                        <column use="ais.ui.util.MyColumnConfig" width="150px" label="Jenis" sort="auto(jenisFasilitas)"/>
                        <column use="ais.ui.util.MyColumnConfig" label="Domain" sort="auto(domain)"/>
                        <column use="ais.ui.util.MyColumnConfig" width="120px" label="Tampilan" sort="auto(pilihanTampilan)"/>
                        <column use="ais.ui.util.MyColumnConfig" width="90px" label="Status" sort="auto(aktif)"/>
                        <column use="ais.ui.util.MyColumnConfig" width="56px" label="" align="center"/>
                    </columns>
                </grid>
                <paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
            </div>
        </div>
        <window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Fasilitas Kesehatan" visible="false" mode="popup" position="center,center" border="normal" width="760px" height="680px"/>
    </window>
</zk>

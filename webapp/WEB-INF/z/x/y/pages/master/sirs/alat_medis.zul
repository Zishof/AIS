<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sirs.AlatMedisAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
				<tab id="tab1" image="/img/excel.png"
					label="Daftar Alat Medis">
				</tab>
				<tab id="tab3" image="/img/US-dollar-icon.png"
					label="Daftar Biaya Alat Medis">
				</tab>
				<tab id="tab2" image="/img/excel.png"
					label="Daftar Layanan Penggunaan Alat Medis">
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;alat_medis&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>

						<column use="ais.ui.util.MyColumnConfig" width="150px" />
						<column use="ais.ui.util.MyColumnConfig" />
									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig" value="Kode" />
<textbox id="searchkode" forward="onOK=onSearchDefault" width="95%" />
<label use="ais.ui.util.MyLabelConfig" value="Nama Alat Medis" />
									<textbox
									use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
									id="searchnama" width="95%" />

									<label
									value="Keterangan Alat Medis" />
									<textbox
									use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
									id="searchketerangan" width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Jenis Alat Medis" />
									<combobox
									forward="onChange=onSearchDefault" id="searchjenisAlatMedis"
									width="95%" />

									<label use="ais.ui.util.MyLabelConfig" value="Satuan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchsatuan"
									width="95%" />


									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig" label=""
									width="40px" />
									<column use="ais.ui.util.MyColumnConfig" label="Kode"
									width="10%" sort="auto(kode)" />
									<column use="ais.ui.util.MyColumnConfig" label="Nama"
									width="10%" sort="auto(nama)" />

									<column use="ais.ui.util.MyColumnConfig" label="Satuan"
									width="10%" sort="auto(per)" />

									<column
									label="Jenis Alat Medis" />

									<column use="ais.ui.util.MyColumnConfig" label="Layanan"
									width="25%" />
									<column use="ais.ui.util.MyColumnConfig" label="Aktif"
									width="5%" />
									<column
									label="Keterangan" width="10%" sort="keterangan" />
									<column use="ais.ui.util.MyColumnConfig" width="56px"
									label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>




				<tabpanel use="ais.ui.util.MyTabpanel" id="tabHarga">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabLayanan">

				</tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindowJudul" id="addWindow" title="Tambah Alat Medis" visible="false" mode="popup" position="center,center" border="normal" width="850px" height="520px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

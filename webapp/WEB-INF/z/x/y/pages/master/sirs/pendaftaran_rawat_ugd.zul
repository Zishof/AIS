<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window border="none" id="window"
		apply="ais.action.master.sirs.PendaftaranRawatUgdAction" width="100%"
		height="100%">


		<tabbox width="100%" height="100%">

			<tabs>
				<tab id="tab1" image="/img/user_male.png"
					label="Input Data ">
				</tab>
				<tab id="tab2" image="/img/excel.png"
					label="Daftar Pendaftaran UGD ">
				</tab>
			</tabs>
			<tabpanels>
				<tabpanel use="ais.ui.util.MyTabpanel" id="tambahData" height="600px" sclass="sirs-input-form">



				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">



					<div sclass="ais-crud-portal">
							<div sclass="ais-crud-filter-card">
								<div sclass="ais-crud-filter-head">
									<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
									<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;pendaftaran_rawat_ugd&quot;, &quot;Bantuan&quot;);"/></div>
								</div>
								<div sclass="ais-crud-filter-body">
									<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
										<columns>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
									<column></column>

								</columns>
										<rows>
											<row>
										<label use="ais.ui.util.MyLabelConfig" value="No. Reg" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchkode" width="95%" />
										<label use="ais.ui.util.MyLabelConfig" value="Nama Pasien" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchnama" width="95%" />
										<label use="ais.ui.util.MyLabelConfig" value="Nama Dokter" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchdokter" width="95%" />

										<label use="ais.ui.util.MyLabelConfig" value="Telp." />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchtelp" width="95%" />

									</row>
										<row>
										<label use="ais.ui.util.MyLabelConfig" value="MR" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchmr" width="95%" />



										<label use="ais.ui.util.MyLabelConfig" value="Jenis Pasien" />
										<combobox
											forward="onChange=onSearchDefault" id="searchjenisPasien"
											width="95%" />

										<label use="ais.ui.util.MyLabelConfig" value="Alamat" />
										<textbox
											use="ais.ui.util.MyTextbox" forward="onOK=onSearchDefault"
											id="searchalamat" width="95%" />


									</row>
										</rows>
									</grid>
								</div>
							</div>
							<div sclass="ais-crud-data-card">
								<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
								<grid fixedLayout="true"
											id="grid" mold="paging" pageSize="25">
											<columns menupopup="auto">
												<column use="ais.ui.util.MyColumnConfig" label="No. Reg"
													width="7%" sort="auto(kode)" />
												<column use="ais.ui.util.MyColumnConfig" width="9%"
													label="MR" />
												<column use="ais.ui.util.MyColumnConfig" width="10%"
													label="Nama Pasien" />
												<column use="ais.ui.util.MyColumnConfig" width="7%"
													label="Wkt. Reg." />
												<column use="ais.ui.util.MyColumnConfig" width="5%"
													label="Status" />
												<column use="ais.ui.util.MyColumnConfig" width="8%"
													label="Poli" />
												<column use="ais.ui.util.MyColumnConfig" width="13%"
													label="Alamat" />

												<column use="ais.ui.util.MyColumnConfig" label="No.Antr."
													width="5%" />
												<column use="ais.ui.util.MyColumnConfig" label="Dokter"
													width="8%" />
												<column use="ais.ui.util.MyColumnConfig" label="Dilayani"
													width="10%" />

												<column use="ais.ui.util.MyColumnConfig" width="5%"
													label="Telp" />
												<column use="ais.ui.util.MyColumnConfig" width="5%"
													label="Jenis" />
												<column use="ais.ui.util.MyColumnConfig" width="13%"
													label="" />
											</columns>

										</grid>
								<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
							</div>
						</div>


</tabpanel>
			</tabpanels>

		</tabbox>


	</window>


</zk>
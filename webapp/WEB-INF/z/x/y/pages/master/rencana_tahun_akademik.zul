<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.RencanaTahunAkademikAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Rencana Tahun Akademik
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onHariLibur">
					Tanggal Merah Nasional / Hari Libur
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;rencana_tahun_akademik&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>



									</columns>
									<rows>
									<row>

									<label
									use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Angkatan" />
									<textbox
									id="searchTahunAngkatan" forward="onOK=onSearchDefault"
									width="95%" />

									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
									<combobox readonly="true"
									forward="onChange=onSearchDefault" id="searchnama"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Status" />
									<combobox
									id="searchStatusAwalMahasiswa"
									forward="onChange=onSearchDefault" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Program" />
									<combobox id="searchprogram"
									forward="onChange=onSearchDefault" width="95%" />

									</row>
									
					<!-- ais-auto-filter: field pencarian dari initCriteria yang belum ada di .zul -->
					<row>
						<label use="ais.ui.util.MyLabelConfig" value="Yayasan" />
						<combobox forward="onChange=onSearchDefault" id="searchyayasan" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Sekolah" />
						<combobox id="searchsekolah" forward="onChange=onSearchDefault" width="95%" />
					</row>
					</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" label="Tahun Akademik"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Semester"
									sort="auto(semester)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Mulai" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Sampai" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Awal KBM" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Unit" />

									<column
									use="ais.ui.util.MyColumnConfig" label="Program" id="col1" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Status" id="col2" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Angkatan"
									id="col3" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>
									<column
									use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>



				<tabpanel use="ais.ui.util.MyTabpanel" id="hariLiburNasional"></tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Rencana Tahun Akademik" visible="false" mode="popup" position="center,center" border="normal" width="750px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.NilaiObeAction" width="100%" height="100%">


		<borderlayout>
			<north border="none" open="true" flex="true">
				<grid use="ais.ui.util.MyGrid" fixedLayout="true">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="150px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
					</columns>
					<rows>

						

						<row spans="4">

							<toolbar id="toolbar">
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" tooltiptext="Cetak Nilai"
									forward="onClick=onCetak" id="cetak" label="Cetak"
									image="/img/svg/printer.svg">
								</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;nilai_obe&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
						</row>


					</rows>
				</grid>

			</north>
			<center border="none" flex="true">

				<grid fixedLayout="true" use="ais.ui.util.MyGrid" sclass="fgrid">
					<rows>
						<row>
							<grid use="ais.ui.util.MyGrid"
								sclass="fgrid" fixedLayout="true" id="grid">

								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>
									<column
										use="ais.ui.util.MyColumnConfig" label=""  width="56px" align="center"/>
								</columns>

								<rows id="rowsUtama"></rows>
							</grid>


						</row>

					</rows>
				</grid>
			</center>
		</borderlayout>



	</window>


</zk>
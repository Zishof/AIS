<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.JudusiumAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Predikat Kelulusan
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Status Keluar dari Kampus
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Status Setelah Lulus
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Status Pekerjaan Setelah Lulus
				</tab>
				<tab use="ais.ui.util.MyTabConfig">
					Status Domisili Setelah Lulus
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;judisium&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Judisium" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" label="Nama Judisium"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nilai Mulai"
									sort="auto(nilaiMulai)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nilai Sampai"
									sort="auto(nilaiSampai)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Maks Masa Studi" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nilai yg tdk ada" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nilai yg hrs ada" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Status" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Min. SKS" />
									<column
									use="ais.ui.util.MyColumnConfig" width="8%"
									label="Min. IPK" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Jenjang" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Keterangan"
									/>

									<column
									use="ais.ui.util.MyColumnConfig" label="Aktif" width="5%" />
									<column
									use="ais.ui.util.MyColumnConfig" width="10%" label="" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel">
					<include width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/status_keluar.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/status_setelah_lulus.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/status_pekerjaan_setelah_lulus.zul">
					</include>
				</tabpanel>
				<tabpanel use="ais.ui.util.MyTabpanel">
					<include width="100%" height="100%"
						src="/WEB-INF/z/x/y/pages/master/status_domisili_setelah_lulus.zul">
					</include>
				</tabpanel>
			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Judisium" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

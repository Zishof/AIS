<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.MatakuliahBerbayarAction" width="100%" height="100%">

		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;matakuliah_berbayar&quot;, &quot;Bantuan&quot;);"/></div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
						<columns>

						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>
						<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
						<column use="ais.ui.util.MyColumnConfig"></column>

						</columns>
						<rows>
						<row>
						<label use="ais.ui.util.MyLabelConfig"
						value="Jenis Kegiatan" />
						<combobox
						forward="onChange=onSearchDefault" id="searchKegiatan"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Jenjang" />
						<combobox id="searchJenjang"
						forward="onChange=onSearchDefault" width="95%" />

						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Fakultas"
						/>
						<combobox
						forward="onChange=onSearchDefault" id="searchFakultas"
						width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Semester" />
						<combobox
						forward="onChange=onSearchDefault" id="searchSemester"
						width="95%" />


						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Prodi"
						/>
						<combobox id="searchJurusan"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig" value="Program" />
						<combobox id="searchProgram"
						forward="onChange=onSearchDefault" width="95%" />
						<label use="ais.ui.util.MyLabelConfig"
						value="Tahun Akademik" />
						<combobox
						forward="onChange=onSearchDefault" id="searchTahunAjaran"
						width="95%" />

						</row>

						<row>
						<label use="ais.ui.util.MyLabelConfig" value="Ganjil/Genap" />
						<combobox
						forward="onChange=onSearchDefault" id="searchGanjilGenap"
						width="95%" />
						</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
					<columns>

						<column use="ais.ui.util.MyColumnConfig" width="40px" />
						<column use="ais.ui.util.MyColumnConfig"
						label="Nama Matakuliah Berbayar" />
						<column use="ais.ui.util.MyColumnConfig" label="Deskripsi" />
						<column use="ais.ui.util.MyColumnConfig" label="Tahun Akademik"
						sort="auto(tahunAjaran)" />

						<column use="ais.ui.util.MyColumnConfig" label="Fakultas"
						sort="auto(fakultas)" />
						<column use="ais.ui.util.MyColumnConfig" label="Prodi"
						sort="auto(jurusan)" />
						<column use="ais.ui.util.MyColumnConfig" label="Semester"
						sort="auto(semester)" />
						<column use="ais.ui.util.MyColumnConfig" label="Jenjang"
						sort="auto(jenjang)" />
						<column use="ais.ui.util.MyColumnConfig" label="Program"
						sort="auto(program)" />
						<column use="ais.ui.util.MyColumnConfig" width="7%"
						label="Ganjil/Genap" sort="auto(ganjilGenap)" />
						<column use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>

					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Matakuliah Berbayar" visible="false" mode="popup" position="center,center" border="normal" width="550px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

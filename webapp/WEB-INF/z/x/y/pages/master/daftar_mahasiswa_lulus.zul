<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.DaftarMahasiswaLulusAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Verifikasi Berkas dan Kelulusan
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onCheck">
					Upload/Check Berkas dan Kelulusan
				</tab>

			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;daftar_mahasiswa_lulus&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>
									<column
									use="ais.ui.util.MyColumnConfig">
									</column>

									</columns>
									<rows>
									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Nama Lengkap" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnama" width="95%" />


									<label
									use="ais.ui.util.MyLabelConfig" value="Nomor Pendaftaran" />
									<textbox
									forward="onOK=onSearchDefault" id="searchnoreg" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="No Ujian" />
									<textbox
									forward="onOK=onSearchDefault" id="searchujian" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
									<combobox
									forward="onChange=onSearchDefault" id="searchTahunAjaran"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Gelombang" />
									<combobox
									forward="onChange=onSearchDefault" id="searchGelombang"
									width="95%" />

									</row>

									<row>
									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis Seleksi" />
									<combobox
									forward="onChange=onSearchDefault" id="searchJenisSeleksi"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Jenis Sekolah" />
									<combobox
									forward="onChange=onSearchDefault"
									id="searchJenisSekolahMahasiswaBaru" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Jurusan Sekolah" />
									<combobox
									forward="onChange=onSearchDefault"
									id="searchJurusanSekolahMahasiswaBaru" width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Paket" />
									<combobox
									forward="onChange=onSearchDefault" id="searchPaket"
									width="95%" />

									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi Pilihan" />
									<combobox
									forward="onChange=onSearchDefault" id="searchProdiPilihan"
									width="95%" />
									</row>


									<row spans="1,1,8">

									<label
									use="ais.ui.util.MyLabelConfig" value="Prodi Lulus" />
									<combobox
									forward="onChange=onSearchDefault" id="searchProdiLulus"
									width="95%" />

									<hbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Bayar reg." forward="onCheck=onSearchDefault"
									id="tampilkanYgSudahBayar">
									</checkbox>


									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm byr reg." forward="onCheck=onSearchDefault"
									id="tampilkanYgBelumBayar">
									</checkbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Bayar daf. ulg" forward="onCheck=onSearchDefault"
									id="tampilkanYgSudahBayarDaftarUlang">
									</checkbox>


									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm byr daf. ulg" forward="onCheck=onSearchDefault"
									id="tampilkanYgBelumBayarDaftarUlang">
									</checkbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Lunas.daf.ulg" forward="onCheck=onSearchDefault"
									id="tampilkanYgSudahLunasDaftarUlang">
									</checkbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm.Lunas.daf.ulg" forward="onCheck=onSearchDefault"
									id="tampilkanYgBelumLunasDaftarUlang">
									</checkbox>
									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Tlh dpt NIM" forward="onCheck=onSearchDefault"
									id="tampilkanYgSudahdapatNIM">
									</checkbox>


									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm dpt NIM" forward="onCheck=onSearchDefault"
									id="tampilkanYgBelumdapatNIM">
									</checkbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Mengisi Form Tambahan"
									forward="onCheck=onSearchDefault"
									id="mengisiFormTambahan">
									</checkbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Tlh Login" forward="onCheck=onSearchDefault"
									id="telahLogin">
									</checkbox>

									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm Upld.Bekas" forward="onCheck=onSearchDefault"
									id="belumUploadBerkas">
									</checkbox>
									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Tlh Upld.Bekas" forward="onCheck=onSearchDefault"
									id="telahUploadBerkas">
									</checkbox>
									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm Lolos.Bekas" forward="onCheck=onSearchDefault"
									id="belumLolosBerkas">
									</checkbox>
									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Tlh Lolos.Bekas" forward="onCheck=onSearchDefault"
									id="telahLolosBerkas">
									</checkbox>
									<checkbox use="ais.ui.util.MyCheckboxConfig"
									label="Blm Diterima" forward="onCheck=onSearchDefault"
									id="blmDiterima">
									</checkbox>

									</hbox>

									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column
									use="ais.ui.util.MyColumnConfig" label="" width="0px" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Foto" width="80px" />
									<column
									use="ais.ui.util.MyColumnConfig" label="No registrasi"
									sort="auto(noRegistrasi)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="No Ujian"
									sort="auto(noUjian)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Nama"
									sort="auto(nama)" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Prodi Pilihan" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Lulus di Prodi" />
									<column
									use="ais.ui.util.MyColumnConfig" label="Program" />
									<column label="Ubah"
									use="ais.ui.util.MyColumnConfig" width="15%">

									</column>
									<column
									use="ais.ui.util.MyColumnConfig" width="80px" />

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

				</tabpanel>


				<tabpanel use="ais.ui.util.MyTabpanel" id="chekUpload"></tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Kelulusan" visible="false" mode="popup" position="center,center" border="normal" width="750px" height="95%">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

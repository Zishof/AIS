<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.message.MessageAction" width="100%" height="100%">

		<tabbox width="100%" height="100%">

<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">Pesan Masuk</tab>
				<tab use="ais.ui.util.MyTabConfig">Pesan Keluar</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">
					<panel use="ais.ui.util.MyPanel" width="100%"
						height="100%" id="panel" title="Data Message">
						<panelchildren>
					<div sclass="ais-crud-portal">

						<!-- ═══ KARTU FILTER ═══ -->
						<div sclass="ais-crud-filter-card">
							<div sclass="ais-crud-filter-head">
								<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
								<div sclass="ais-crud-filter-actions">
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add" label="Tambah" image="/img/new.gif" tooltiptext="Tambah data baru" forward="onClick=onAdd"/>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find" label="Cari" image="/img/search.gif" tooltiptext="Cari data" forward="onClick=onSearchDefault"/>
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;message&quot;, &quot;Bantuan&quot;);"/></div>
							</div>
							<div sclass="ais-crud-filter-body">
								<grid use="ais.ui.util.MyGrid" fixedLayout="true" sclass="ais-crud-filter-grid">
									<columns>

									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig"></column>
									<column use="ais.ui.util.MyColumnConfig" width="150px">
									</column>
									<column use="ais.ui.util.MyColumnConfig"></column>

									</columns>
									<rows>
									<row>
									<label use="ais.ui.util.MyLabelConfig"
									value="Judul Pesan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchjudul"
									width="95%" />
									<label use="ais.ui.util.MyLabelConfig"
									value="Isi Pesan" />
									<textbox
									forward="onOK=onSearchDefault" id="searchisi" width="95%" />
									</row>
									</rows>
								</grid>
							</div>
						</div>

						<!-- ═══ KARTU DATA ═══ -->
						<div sclass="ais-crud-data-card">
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging" detailed="true"/>
							<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true" id="grid">
								<columns>

									<column use="ais.ui.util.MyColumnConfig"
									label="Pengirim" width="25%" />
									<column use="ais.ui.util.MyColumnConfig"
									label="Judul" sort="judul" />
									<column use="ais.ui.util.MyColumnConfig" width="56px"
									label=""  align="center"/>

								</columns>
							</grid>
							<paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar"/>
						</div>

					</div>

					</panelchildren>
					</panel>

					<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Message"
						visible="false" mode="popup" position="center,center"
						border="normal" width="90%" height="95%">

					</window>

					<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>
				</tabpanel>




				<tabpanel use="ais.ui.util.MyTabpanel">
					<include use="ais.ui.util.MyIframe"
						src="/WEB-INF/z/x/y/pages/master/message/message_terkirim.zul">
					</include>
				</tabpanel>

			
			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="" visible="false" mode="popup" position="center,center" border="normal" width="600px" height="500px">
		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

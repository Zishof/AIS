<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" id="window"
		apply="ais.action.master.psb.LoginCalonSiswaAction" border="none" sclass="pmb-zk-window ecampus-login-window"
		width="100%" height="100%">


		<borderlayout>

			<north id="kop" sclass="headerHbox" height="60px" border="none"></north>

			<center border="none" flex="true">
				<grid use="ais.ui.util.MyGrid"
					fixedLayout="true" id="grid" sclass="ecampus-login-card">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" width="40%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

					</columns>
					<rows>


						<row id="tampilanNoRegistrasi">
							<label use="ais.ui.util.MyLabelConfig"
								value="No. Pendaftaran / Ujian / Nama Lengkap" />
							<textbox id="nomorInduk" width="90%">
							</textbox>
						</row>



						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="Tanggal Lahir" />
							<grid use="ais.ui.util.MyGrid" width="100%" sclass="ecampus-login-tgl">
								<rows>
									<row>
										<vbox width="33%">
											<label use="ais.ui.util.MyLabelConfig" value="Tahun">
											</label>
											<combobox id="tahun" width="96px" readonly="true">
											</combobox>
										</vbox>

										<vbox width="33%">
											<label use="ais.ui.util.MyLabelConfig" value="Bulan">
											</label>
											<combobox id="bulan" width="120px" readonly="true">
											</combobox>
										</vbox>

										<vbox width="33%">
											<label use="ais.ui.util.MyLabelConfig" value="Tanggal">
											</label>
											<combobox id="tanggal" width="96px" readonly="true">
											</combobox>
										</vbox>
									</row>
								</rows>

							</grid>

						</row>

						<row>
							<box width="100%" align="end">
								<button use="ais.ui.util.MyButtonConfig"
									label="L O G I N" forward="onClick=onLogin" id="cari">
								</button>
							</box>
							<box width="100%" align="start">
								<button use="ais.ui.util.MyButtonConfig"
									label="R E S E T" forward="onClick=onReset" id="reset">
								</button>
							</box>
						</row>
						<row spans="2" id="labelInformasi" visible="false">
							<label use="ais.ui.util.MyLabelConfig" id="infoLogin" sclass="ecampus-login-info"
								value="Untuk dapat melakukan login, silahkan masukkan Nomor Registrasi yang anda dapatkan pada saat melakukan pendaftaran dan masukkan TANGGAL LAHIR.">
							</label>
						</row>



					</rows>
				</grid>

			</center>


		</borderlayout>

	</window>
</zk>
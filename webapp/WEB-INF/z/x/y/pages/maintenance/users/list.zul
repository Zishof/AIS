<?page id="testZul" title=" Penyerapan Anggaran" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.maintenance.TbmuserAction" width="100%"
		height="100%">

		<!-- Layout filter DISERAGAMKAN dengan mahasiswa.zul:
		     ais-crud-portal -> ais-crud-filter-card (kepala: judul + aksi, badan: field filter inline)
		     + ais-crud-data-card (paging + grid). Pola lama "Pencarian Lebih Lanjut" (launcher
		     borderlayout/north + popup addWindowPencarian) diganti agar seragam seluruh CRUD. -->
		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add"
							label="Tambah" image="/img/new.gif"
							tooltiptext="Tambah data baru" forward="onClick=onAdd" />
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find"
							label="Cari" image="/img/search.gif"
							tooltiptext="Cari data pengguna" forward="onClick=onSearchDefault" />
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="uploadFotoMassal" label="Upload Foto" image="/img/new.gif" tooltiptext="Upload banyak foto sekaligus (nama berkas = User ID) ATAU satu berkas ZIP. Semua langsung terpasang ke pengguna yang User ID-nya cocok." upload="true,maxsize=-1" forward="onUpload=onUploadFotoMassal" />
					<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="downloadFotoMassal" label="Download Foto Massal" image="/img/download.png" tooltiptext="Unduh SEMUA foto pengguna sebagai satu berkas ZIP (nama tiap foto = User ID). Pembacaan paralel maks 50 thread agar cepat." forward="onClick=onDownloadFotoMassal" />
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							label="Bantuan" image="/img/help.gif"
							tooltiptext="Panduan penggunaan halaman ini"
							onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;tbmuser&quot;, &quot;Bantuan&quot;);" />
					</div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true"
						sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
						</columns>
						<rows>

							<!-- Baris 1 -->
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Nama / Email" />
								<textbox forward="onOK=onSearchDefault" id="searchnama"
									width="95%" />

								<label use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
								<bandbox
									use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
									id="searchparent" width="95%">
								</bandbox>

								<label use="ais.ui.util.MyLabelConfig" value="Grup Pengguna" />
								<combobox forward="onChange=onSearchDefault"
									id="searchrole" width="95%" />

								<hbox width="95%" id="hbFakultasLabel">
									<label use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<label value="/"></label>
									<label use="ais.ui.util.MyLabelConfig" value="Prodi" />
								</hbox>
								<hbox width="95%" id="hbFakultas">
									<combobox forward="onChange=onSearchDefault"
										id="searchfakultas" cols="4" />
									<combobox id="searchjurusan"
										forward="onChange=onSearchDefault" cols="4" />
								</hbox>
							</row>

							<!-- Baris 2 -->
							<row id="rowMediaSosial" spans="1,1,6">
								<hbox width="95%" id="hbYayasanLabel">
									<label use="ais.ui.util.MyLabelConfig" value="Yayasan" />
									<label value="/"></label>
									<label use="ais.ui.util.MyLabelConfig" value="Sekolah" />
								</hbox>
								<hbox width="95%" id="hbYayasan">
									<combobox forward="onChange=onSearchDefault"
										id="searchyayasan" cols="4" />
									<combobox id="searchsekolah"
										forward="onChange=onSearchDefault" cols="4" />
								</hbox>

								<hbox style="flex-wrap:wrap;gap:4px 16px;padding:4px 2px">
									<checkbox use="ais.ui.util.MyCheckboxConfig"
										forward="onClick=onSearchDefault" id="searchFacebook"
										label="Facebook" />
									<checkbox use="ais.ui.util.MyCheckboxConfig"
										forward="onClick=onSearchDefault" id="searchGoogle"
										label="Google" />
									<checkbox use="ais.ui.util.MyCheckboxConfig"
										forward="onClick=onSearchDefault" id="searchTwitter"
										label="Twitter" />
									<checkbox use="ais.ui.util.MyCheckboxConfig"
										forward="onClick=onSearchDefault" id="searchLinkedin"
										label="LinkedIn" />
								</hbox>
							</row>

							<!-- Baris 3: opsi tampilan -->
							<row spans="8">
								<hbox style="flex-wrap:wrap;gap:4px 16px;padding:4px 2px">
									<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif"
										label="Tampilkan hanya yang aktif" checked="true"
										forward="onClick=onSearchDefault" />
								</hbox>
							</row>

						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging"
					detailed="true" />
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true"
					id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" width="70px" />
						<column use="ais.ui.util.MyColumnConfig"
							label="Username" sort="auto(userId)" />
						<column use="ais.ui.util.MyColumnConfig"
							label="Nama lengkap" sort="auto(userNama)" />
						<column use="ais.ui.util.MyColumnConfig" label="Email"
							sort="auto(email)" />
						<column use="ais.ui.util.MyColumnConfig"
							label="Jenis Pengguna" />
						<column use="ais.ui.util.MyColumnConfig" label="Unit" />
						<column use="ais.ui.util.MyColumnConfig"
							label="Sub.Unit" />
						<column use="ais.ui.util.MyColumnConfig" label="Pegawai" />
						<column use="ais.ui.util.MyColumnConfig"
							label="Satuan Kerja" />
						<column use="ais.ui.util.MyColumnConfig" width="5%"
							label="Aktif" />
						<column use="ais.ui.util.MyColumnConfig" width="8%"
							label="" />
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true"
					use="ais.ui.util.MyPagingKembar" />
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah User" visible="false" mode="popup"
			position="center,center" border="none" width="850px" height="95%">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.maintenance.MenuAction" width="100%"
		height="100%">


		<tabbox width="100%" height="100%">

			<tabs>

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Tree Menu
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					forward="onClick=onMenu">
					Daftar Menu
				</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">


					<borderlayout>
						<north border="none" title="Menu" open="true">
							<grid fixedLayout="true">

								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="200px">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>

								</columns>
								<rows>



									<row spans="2">

										<toolbar>

											<toolbarbutton
												use="ais.ui.util.MyToolbarbuttonConfig"
												tooltiptext="Modul Baru" forward="onClick=onAdd"
												label="Modul Baru" image="/img/new.gif">
											</toolbarbutton>

											<toolbarbutton
												use="ais.ui.util.MyToolbarbuttonConfig"
												tooltiptext="Cari data" forward="onClick=onReloadTree"
												label="Refresh" image="/img/search.gif">
											</toolbarbutton>
										</toolbar>
									</row>
								</rows>
							</grid>

						</north>
						<center border="none"
							flex="true">

							<tree width="100%" zclass="z-dottree"
								height="100%" id="tree">

							</tree>


						</center>

					</borderlayout>
				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="menuTab"></tabpanel>
			</tabpanels>
		</tabbox>
		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Menu" visible="false" mode="popup"
			position="center,center" border="normal" width="650px"
			height="480px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">



	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.TampilanPengumumanAkademisAction"
		width="100%" height="100%" contentStyle="overflow:auto">

		<borderlayout id="utamaLagi">
			<center border="none" flex="true">

				<borderlayout id="utama">
					<center id="centerPengumuman" border="none"
						flex="true">
						
					</center>
					

					<east title="Menu Pintas" id="menuPintas"
						border="none" width="300px">
					</east>

				</borderlayout>
			</center>
			<north border="none">
				<html id="textBerjalan"></html>
			</north>
		</borderlayout>

	</window>

	<style src="/css/slide.css" />
	
</zk>
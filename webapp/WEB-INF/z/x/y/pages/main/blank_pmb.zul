<?page id="testZul" title=" Penyerapan Anggaran" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:n="http://www.zkoss.org/2005/zk/native"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<style>
		.pmb_info *{background:#d8edf6; font: bold 12px 'Palatino Linotype', 'Book Antiqua', Palatino, serif; text-decoration: none; color: #00f;} 
		.pmb_info_size {font-size: 16px;}
	</style>

	<window use="ais.ui.util.MyWindow" apply="ais.action.maintenance.BlankPMBAction" mode="embedded"
		title="" border="none" width="100%" height="100%">

		<tabbox width="100%" height="100%">

			<tabs id="mytabs">
				<tab use="ais.ui.util.MyTabConfig" id="defaultHome" selected="true" label="Welcome"></tab>
			</tabs>

			<tabpanels id="mytabpanels">
				<tabpanel use="ais.ui.util.MyTabpanel">
					<borderlayout width="100%" height="100%">
						<north visible="false" id="north">

							<box id="pmb_home_info" width="100%"
								align="center" sclass="pmb_info">
								<n:marquee scrolldelay="110">
									<a target="_blank"
										id="pmb_home_info_link">
										<label use="ais.ui.util.MyLabelConfig" id="pmb_home_info_text"
											sclass="pmb_info_size" />

									</a>
								</n:marquee>
							</box>



						</north>
						<center autoscroll="true">

							<box width="100%" align="center">

								<a href="/img/alur-pendaftaran-s2.jpg">
									<image id="utama_image"
										align="center"
										src="/img/alur-pendaftaran-s2.jpg" />
								</a>

							</box>
						</center>

						<south id="south" visible="false">

							<box id="pmb_home_sekret" align="center"
								width="100%" sclass="pmb_info">
								<label use="ais.ui.util.MyLabelConfig" id="pmb_home_sekret_text" />
							</box>
						</south>
					</borderlayout>
				</tabpanel>
			</tabpanels>

		</tabbox>



	</window>

</zk>
<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>



<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.pmb.CariDataPembayaranAction" width="100%"
		height="100%">



		<borderlayout>
			<center border="none" flex="true">
				<borderlayout>
					<north border="none" flex="true" id="menuLogin" visible="false"><div sclass="ecampus-bantuan-north-wrap" style="width:100%; height:100%; display:flex; align-items:center; gap:8px;">
				<toolbar style="background:transparent;border:0;padding:0;"><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;cari_data_pembayaran&quot;, &quot;Bantuan&quot;);"/></toolbar> 
						<grid use="ais.ui.util.MyGrid" fixedLayout="true">
							<columns>
								<column use="ais.ui.util.MyColumnConfig"
									width="30%">
								</column>
								<column use="ais.ui.util.MyColumnConfig"
									width="70%">
								</column>

							</columns>
							<rows>

								<row id="tampilanNoRegistrasi">
									<label
										use="ais.ui.util.MyLabelConfig"
										value="No. Pendaftaran / Ujian" />
									<textbox id="noRegistrasi"
										width="90%">
									</textbox>
								</row>



								<row>
									<label
										use="ais.ui.util.MyLabelConfig" value="Tanggal Lahir" />
									<grid fixedLayout="true" use="ais.ui.util.MyGrid"
										width="100%">
										<rows>
											<row>
												<vbox width="33%">
													<label
														use="ais.ui.util.MyLabelConfig" value="Tahun">
													</label>
													<combobox id="tahun"
														width="60px" readonly="true">
													</combobox>
												</vbox>

												<vbox width="33%">
													<label
														use="ais.ui.util.MyLabelConfig" value="Bulan">
													</label>
													<combobox id="bulan"
														width="80px" readonly="true">
													</combobox>
												</vbox>

												<vbox width="33%">
													<label
														use="ais.ui.util.MyLabelConfig" value="Tanggal">
													</label>
													<combobox
														id="tanggal" width="60px" readonly="true">
													</combobox>
												</vbox>
											</row>
										</rows>

									</grid>

								</row>

								<row>
									<box width="100%" align="end">
										<button
											use="ais.ui.util.MyButtonConfig" label="L O G I N"
											forward="onClick=onLogin" id="cari">
										</button>
									</box>

								</row>
								<row spans="2" id="labelInformasi">
									<label
										use="ais.ui.util.MyLabelConfig" id="infoLogin"
										value="Untuk dapat melakukan login, silahkan masukkan Nomor Registrasi yang anda dapatkan pada saat melakukan pendaftaran dan masukkan TANGGAL LAHIR.">
									</label>
								</row>



							</rows>
						</grid>

					</div></north>
					<center border="none"
						flex="true">

						<grid fixedLayout="true" use="ais.ui.util.MyGrid" sclass="fgrid">
							<rows>
								<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-atas" height="64px" /></row>
								<row>
									<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging"
										detailed="true" />
								</row>
								<row>
									<grid use="ais.ui.util.MyGrid"
										sclass="dgrid" fixedLayout="true" id="grid">
										<columns>
											<column
												use="ais.ui.util.MyColumnConfig" width="70px" label="Foto" />
											<column
												use="ais.ui.util.MyColumnConfig" label="Nomor Pendaftaran" />
											<column
												use="ais.ui.util.MyColumnConfig" label="No Ujian" />
											<column
												use="ais.ui.util.MyColumnConfig" label="Nama" />
											<column
												use="ais.ui.util.MyColumnConfig" width="40%"
												label="Informasi Pembayaran" />
											<column
												use="ais.ui.util.MyColumnConfig" label="Cetak Struk" />
										</columns>

									</grid>


								</row>
								<row><paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar" /></row>
								<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-bawah" height="128px" /></row>
							</rows>
						</grid>
					</center>
				</borderlayout>
			</center>

			<north id="uploadMenu" border="none">

			</north>

		</borderlayout>




	</window>
</zk>
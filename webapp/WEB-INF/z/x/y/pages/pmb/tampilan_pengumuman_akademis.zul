<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">



	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.pmb.TampilanPengumumanPMBAction" width="100%"
		height="100%" contentStyle="overflow:auto" sclass="pmb-announcement-window">



		<borderlayout id="layoutUtama" sclass="pmb-announcement-layout">
			<center border="none" flex="true" sclass="pmb-announcement-content">

				<tabbox width="100%" height="100%" sclass="pmb-announcement-tabs">

					<tabs id="tabs">

					</tabs>

					<tabpanels id="tabpanels">


					</tabpanels>
				</tabbox>

			</center>
		</borderlayout>


	</window>
	<style><![CDATA[
/* Portal PMB - ruang baca pengumuman. */
.pmb-announcement-window,
.pmb-announcement-layout,
.pmb-announcement-content {
	background: #f8fafc !important;
}

.pmb-announcement-window .z-west {
	background: #ffffff !important;
	border: 1px solid #d9e2ec !important;
	border-radius: 8px;
	box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
	margin: 8px 12px 8px 8px;
	overflow: hidden;
}

.pmb-announcement-window .z-west-body,
.pmb-announcement-menu,
.pmb-announcement-menu .z-borderlayout {
	overflow: hidden !important;
}

.pmb-announcement-search {
	background: #f1f5f9 !important;
	border-bottom: 1px solid #d9e2ec !important;
	padding: 7px 8px !important;
}

.pmb-announcement-search .z-textbox {
	box-sizing: border-box;
	height: 32px;
	padding: 6px 9px;
	border: 1px solid #b9c8d8;
	border-radius: 6px;
	font-size: 12px;
}

.pmb-announcement-search-button {
	min-width: 34px !important;
	height: 32px;
	box-sizing: border-box;
	border-radius: 6px !important;
}

.pmb-announcement-list,
.pmb-announcement-list .z-grid-body,
.pmb-announcement-list .z-rows {
	width: 100% !important;
}

.pmb-announcement-list .z-group {
	background: #087dcc !important;
	color: #ffffff !important;
	font-size: 11px;
	font-weight: 700;
}

.pmb-announcement-row,
.pmb-announcement-row .z-row-inner {
	height: auto !important;
	min-height: 38px;
	padding: 0 !important;
	border: 0 !important;
	background: transparent !important;
}

.pmb-announcement-link,
.pmb-announcement-link:visited {
	display: block;
	box-sizing: border-box;
	width: calc(100% - 12px);
	margin: 4px 6px;
	padding: 8px 9px;
	border: 1px solid #d8e2ee;
	border-radius: 6px;
	background: #ffffff;
	color: #17375e !important;
	font-size: 11px !important;
	font-weight: 600;
	line-height: 1.35;
	white-space: normal !important;
	overflow-wrap: anywhere;
	word-break: break-word;
	text-decoration: none !important;
}

.pmb-announcement-link:hover,
.pmb-announcement-link:focus {
	background: #eaf5ff;
	border-color: #63a9dd;
	color: #075b9a !important;
}

.pmb-announcement-tabs {
	box-sizing: border-box;
	padding: 8px 8px 12px;
	background: #ffffff;
	border: 1px solid #d9e2ec;
	border-radius: 8px;
	box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
}

.pmb-announcement-tabs .z-tabs {
	border-bottom: 1px solid #d9e2ec;
}

.pmb-announcement-tabs .z-tabpanel {
	box-sizing: border-box;
	padding: 10px !important;
	overflow: auto !important;
}

.pmb-announcement-tabs iframe,
.pmb-announcement-tabs object,
.pmb-announcement-tabs embed {
	display: block;
	width: 100% !important;
	max-width: 100% !important;
	min-height: 620px;
	border: 0;
}

@media (max-width: 980px) {
	.pmb-announcement-window .z-north {
		box-sizing: border-box;
		max-height: 300px;
		margin: 6px 6px 10px;
		border: 1px solid #d9e2ec !important;
		border-radius: 8px;
		overflow: auto !important;
	}

	.pmb-announcement-tabs {
		margin: 0 6px 8px;
		padding: 6px;
	}

	.pmb-announcement-tabs iframe,
	.pmb-announcement-tabs object,
	.pmb-announcement-tabs embed {
		min-height: 70vh;
	}
}

@media (max-width: 600px) {
	.pmb-announcement-link,
	.pmb-announcement-link:visited {
		font-size: 12px !important;
		padding: 9px 10px;
	}

	.pmb-announcement-tabs .z-tabpanel {
		padding: 5px !important;
	}
}
]]></style>
	
</zk>

<?page id="testZul" title=" New ZUL Title" cacheable="false"
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.pmb.CetakRegistrasiSederhanaAction"
		width="100%" height="100%">

		<!-- Layout filter DISERAGAMKAN dengan mahasiswa.zul: ais-crud-portal ->
		     ais-crud-filter-card + ais-crud-data-card. -->
		<div sclass="ais-crud-portal">

			<!-- ═══ KARTU FILTER ═══ -->
			<div sclass="ais-crud-filter-card">
				<div sclass="ais-crud-filter-head">
					<span sclass="ais-crud-filter-title">Pencarian &amp; Filter</span>
					<div sclass="ais-crud-filter-actions">
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="add"
							label="Tambah Peserta" image="/img/new.gif"
							tooltiptext="Tambah data" forward="onClick=onAdd" />
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" id="find"
							label="Cari" image="/img/search.gif"
							tooltiptext="Cari data" forward="onClick=onSearchDefault" />
						<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
							label="Bantuan" image="/img/help.gif"
							tooltiptext="Panduan penggunaan halaman ini"
							onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;cetak_registrasi_sederhana&quot;, &quot;Bantuan&quot;);" />
					</div>
				</div>
				<div sclass="ais-crud-filter-body">
					<grid use="ais.ui.util.MyGrid" fixedLayout="true"
						sclass="ais-crud-filter-grid">
						<columns>
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
							<column use="ais.ui.util.MyColumnConfig" width="90px" />
							<column use="ais.ui.util.MyColumnConfig" />
						</columns>
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Nama Lengkap" />
								<textbox forward="onOK=onSearchDefault" id="searchnama" width="95%" />

								<label use="ais.ui.util.MyLabelConfig" value="Nomor Pendaftaran" />
								<textbox forward="onOK=onSearchDefault" id="searchnoreg" width="95%" />

								<label use="ais.ui.util.MyLabelConfig" value="No Ujian" />
								<textbox forward="onOK=onSearchDefault" id="searchujian" width="95%" />

								<label use="ais.ui.util.MyLabelConfig" value="Gelombang" />
								<combobox forward="onChange=onSearchDefault" id="searchGelombang"
									width="95%" />
							</row>
						</rows>
					</grid>
				</div>
			</div>

			<!-- ═══ KARTU DATA ═══ -->
			<div sclass="ais-crud-data-card">
				<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging"
					detailed="true" />
				<grid use="ais.ui.util.MyGrid" sclass="dgrid" fixedLayout="true"
					id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig" width="70px" />
						<column use="ais.ui.util.MyColumnConfig" label="Nama Peserta" />
						<column use="ais.ui.util.MyColumnConfig" width="15%"
							label="Tanggal Lahir" />
						<column use="ais.ui.util.MyColumnConfig" width="15%"
							label="Asal Sekolah/Kampus" />
						<column use="ais.ui.util.MyColumnConfig" width="15%"
							label="No. Registrasi" />
						<column use="ais.ui.util.MyColumnConfig" label="Gelombang" />
						<column use="ais.ui.util.MyColumnConfig" width="10%" label="" />
					</columns>
				</grid>
				<paging visible="false" id="paging2" detailed="true"
					use="ais.ui.util.MyPagingKembar" />
			</div>

		</div>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			visible="false" mode="popup" position="center,center" border="normal"
			width="550px" height="500px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>

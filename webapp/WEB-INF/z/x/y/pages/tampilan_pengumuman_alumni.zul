<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">



	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.TampilanPengumumanAlumniAction" width="100%"
		height="100%" contentStyle="overflow:auto">
		
		<style src="/css/slide.css" />

		<borderlayout id="layoutUtama">
			<center border="none" flex="true">

				<tabbox width="100%" height="100%">

					<tabs id="tabs">
						
					</tabs>

					<tabpanels id="tabpanels">

						
					</tabpanels>
				</tabbox>

			</center>
		</borderlayout>


	</window>

	

</zk>
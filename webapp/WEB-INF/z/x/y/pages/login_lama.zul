<?page id="testZul" title="Login Admin ais" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">
	<window use="ais.ui.util.MyWindow" mode="modal" title="Login Pengguna" border="none" position="center"
		apply="ais.action.maintenance.LoginAction" width="700px"
		height="490px">

		<borderlayout>
			<north border="none">
				<image align="center" src="/img/welcome_image.png" />

			</north>
			<center border="none" flex="true">
				<vbox>
					<label use="ais.ui.util.MyLabelConfig"
						value="Isilah data pengguna" />
					<grid use="ais.ui.util.MyGrid"    width="100%"
						height="440px">
						<rows>
							<row>
								<label use="ais.ui.util.MyLabelConfig" id="pengguna" value="Pengguna" />
								<textbox forward="onOK=onLogin" cols="35" type="text"
									id="username" focus="true" width="50">
								</textbox>
							</row>
							<row>
								<label use="ais.ui.util.MyLabelConfig" id="kataSandi"
									value="Kata Sandi" />
								<textbox forward="onOK=onLogin" cols="35" type="password"
									id="password" width="50">
								</textbox>
							</row>
							<row>
								<label use="ais.ui.util.MyLabelConfig" value="Sebagai Mahasiswa" />
								<checkbox use="ais.ui.util.MyCheckboxConfig" id="mahasiswa"></checkbox>
							</row>

						</rows>

					</grid>

				</vbox>

			</center>



			<south border="none">

				<toolbar>
					<button use="ais.ui.util.MyButtonConfig" forward="onClick=onLogin" label="Login">


					</button>

				</toolbar>

			</south>

		</borderlayout>



	</window>
</zk>
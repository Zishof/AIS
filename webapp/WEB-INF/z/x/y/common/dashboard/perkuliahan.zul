<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">




	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.PerkuliahanAction" width="100%"
		height="100%">

		<borderlayout>
			<north border="none" open="true" flex="true"
				visible="false">
				<grid use="ais.ui.util.MyGrid" fixedLayout="true">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="6%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="6%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="6%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

						<column use="ais.ui.util.MyColumnConfig"
							width="6%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

						<column use="ais.ui.util.MyColumnConfig"
							width="6%">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>

					</columns>
					<rows>


						<row spans="1,1,1,1,1,1,2,1,1">
							<label use="ais.ui.util.MyLabelConfig"
								value="Hari" />

							<hbox width="95%">
								<combobox id="searchhari"
									forward="onChange=onSearchDefault" cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Jml Dsn"/>
								<combobox id="searchjmldosen"
									forward="onChange=onSearchDefault" cols="4" />
							</hbox>
							<label use="ais.ui.util.MyLabelConfig"
								value="Tahun Akademik" />
							<combobox forward="onChange=onSearchDefault"
								id="searchTahunAjaran" width="95%" />
							<label use="ais.ui.util.MyLabelConfig"
								value="Jenis Smt" />
							<hbox width="95%">
								<combobox cols="4"
									forward="onChange=onSearchDefault" id="searchJenisSemester" />
								<label use="ais.ui.util.MyLabelConfig" value="Semester"/>
								<combobox cols="3"
									forward="onChange=onSearchDefault" id="searchsemester" />
							</hbox>



							<hbox>
								<checkbox label="Paralel"
									use="ais.ui.util.MyCheckboxConfig"
									forward="onCheck=onSearchDefault" id="searchparalel" />
								<checkbox label="Tanpa Kelas"
									use="ais.ui.util.MyCheckboxConfig"
									forward="onCheck=onSearchDefault" id="searchtanpakelas" />
								<checkbox label="Remedial"
									use="ais.ui.util.MyCheckboxConfig"
									forward="onCheck=onSearchDefault" id="merupakanRemedial" />

							</hbox>

							<label use="ais.ui.util.MyLabelConfig"
								value="Kurikulum" />
							<bandbox id="searchkurikulum"
								use="ais.action.master.helper.AmbilDataKurikulumBanbox"
								width="95%" />

						</row>
						<row spans="1,1,1,1,1,1,2,1,1">

							<label use="ais.ui.util.MyLabelConfig"
								value="Dosen" />
							<hbox width="95%">
								<bandbox id="searchdosen"
									use="ais.action.master.helper.AmbilDataDosenBanbox" cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Nama"/>
								<textbox forward="onOK=onSearchDefault"
									id="searchnamadsn" cols="7" />
							</hbox>
							<label use="ais.ui.util.MyLabelConfig"
								value="Matakuliah" />
							<hbox width="95%">
								<bandbox
									use="ais.action.master.helper.AmbilDataMatakuliahBanbox"
									forward="onChange=onSearchDefault" id="searchmatakuliah"
									cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Nama MK"/>
								<textbox forward="onOK=onSearchDefault"
									id="searchnamamk" cols="7" />
							</hbox>

							<hbox width="95%">
								<label use="ais.ui.util.MyLabelConfig"
									value="Fakultas" />
								<label value="/"></label>
								<label use="ais.ui.util.MyLabelConfig"
									value="Prodi" />
							</hbox>
							<hbox width="95%">
								<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									cols="4" />
								<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" cols="4" />
							</hbox>


							<hbox visible="false">
								<checkbox label="Blm Msk Feeder"
									use="ais.ui.util.MyCheckboxConfig"
									forward="onCheck=onSearchDefault" id="searchbelummasukFeeder" />
								<checkbox label="Msk Feeder"
									use="ais.ui.util.MyCheckboxConfig"
									forward="onCheck=onSearchDefault" id="searchmasukFeeder" />

							</hbox>





							<label use="ais.ui.util.MyLabelConfig"
								value="NIM" />
							<hbox>
								<textbox forward="onOK=onSearchDefault"
									id="searchnim" cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Nama Mhs"/>
								<textbox forward="onOK=onSearchDefault"
									id="searchnamamhs" cols="4" />
							</hbox>


						</row>
						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="Program" />
							<combobox id="searchprogram"
								forward="onChange=onSearchDefault" width="95%" />




							<label use="ais.ui.util.MyLabelConfig"
								value="Masa Perkuliahan" />
							<bandbox id="searchmasaperkulaiahan"
								use="ais.action.master.helper.AmbilDataMasaPerkuliahanBanbox"
								width="95%" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Keterangan" />
							<textbox forward="onOK=onSearchDefault"
								id="searchKeterangan" width="95%" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Kelas" />
							<hbox>
								<bandbox
									use="ais.action.master.helper.AmbilDataKelasBanbox"
									forward="onChange=onSearchDefault" id="searchkelas" cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Ruang"/>
								<bandbox
									use="ais.action.master.helper.AmbilDataRuangBanbox"
									forward="onChange=onSearchDefault" id="searchruang" cols="4" />
							</hbox>

							<label use="ais.ui.util.MyLabelConfig"
								value="Asisten Dosen" />
							<hbox width="95%">
								<bandbox
									use="ais.action.master.helper.AmbilDataMahasiswaBanbox"
									forward="onChange=onSearchDefault" id="searchasisten" cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Nama"/>
								<textbox forward="onOK=onSearchDefault"
									id="searchnamaasisten" cols="7" />
							</hbox>


						</row>
						<!-- Filter Tampilan Kurikulum (OBE / bukan OBE) -->
						<row>
							<label use="ais.ui.util.MyLabelConfig" value="Tampilan Kurikulum" />
							<combobox id="searchObe" readonly="true" width="95%"
								forward="onChange=onSearchDefault"
								tooltiptext="Saring perkuliahan berdasarkan jenis kurikulum">
								<comboitem label="Tampilkan Semua" value="" />
								<comboitem label="Hanya Tampilkan Kurikulum OBE" value="OBE" />
								<comboitem label="Hanya Tampilkan Kurikulum Bukan OBE" value="NONOBE" />
							</combobox>
						</row>



						
					</rows>
				</grid>

			</north>
			<center border="none" flex="true">

				<grid fixedLayout="true" use="ais.ui.util.MyGrid" sclass="fgrid">
					<rows>

						<row>
							<toolbar>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" visible="false" disabled="true"
									tooltiptext="Tambah data" forward="onClick=onAdd" id="add"
									label="Tambah Jadwal" image="/img/new.gif">
								</toolbarbutton>

								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" visible="false" disabled="true"
									tooltiptext="Berdasar Kurikulum"
									forward="onClick=onInitJadwalKurikulum" id="addJadwalKurikulum"
									label="Tambah Berdasar Kurikulum" image="/img/new.gif">
								</toolbarbutton>

								<label use="ais.ui.util.MyLabelConfig" value="Kode/Nama:" />
								<textbox id="cariCepatPerkuliahan" width="220px"
									tooltiptext="Kode / nama matakuliah" forward="onOK=onSearchDefault" />
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" tooltiptext="Cari berdasarkan kode/nama matakuliah"
									forward="onClick=onSearchDefault" id="find" label="Cari"
									image="/img/search.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" label="Copy Semua"  disabled="true"
									forward="onClick=onCopyPerkuliahan" id="copy" visible="false"
									image="/img/copy.png">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" label="Hapus Semua"  disabled="true"
									forward="onClick=onDeletePerkuliahan" id="hapus"
									visible="false" image="/img/delete.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" visible="false"  disabled="true"
									label="Laporan Dosen Pembina Matakuliah"
									forward="onClick=onCetakLaporanDosenPembinaMatakuliah"
									image="/img/print.png">
								</toolbarbutton>


							</toolbar>
						</row>

						<row>

							<grid use="ais.ui.util.MyGrid"
								fixedLayout="true" id="grid" mold="paging" pageSize="25">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="0px" />
									<column
										use="ais.ui.util.MyColumnConfig" width="20%"
										label="Hari/Jam/Ruang" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%" id="colwaktu"
										label="Waktu" />
									<column
										use="ais.ui.util.MyColumnConfig" width="15%"
										label="Perkuliahan" />
									<column
										use="ais.ui.util.MyColumnConfig" width="18%"
										label="Dosen/Asisten" />
									<column
										use="ais.ui.util.MyColumnConfig" width="5%" label="Kap" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" id="colMinggu"
										label="Minggu" />
									<column
										use="ais.ui.util.MyColumnConfig" width="5%" label="Smt" />
									<column
										use="ais.ui.util.MyColumnConfig" width="25%" label="Jml Mhs" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%" label="" />
								</columns>

							</grid>

						</row>
						<row>
							<paging visible="false" id="paging"
								detailed="true" />
						</row>
					</rows>
				</grid>


			</center>

		</borderlayout>


	</window>




</zk>
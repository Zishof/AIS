<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KurikulumAction" width="100%"
		height="100%">



		<borderlayout>
			<north border="none" open="true" visible="false">

				<grid use="ais.ui.util.MyGrid" fixedLayout="true">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
					</columns>
					<rows>

						<row>

							<label use="ais.ui.util.MyLabelConfig"
								value="Matakuliah" />
							<textbox id="searchmk"
								forward="onOK=onSearchDefault" width="95%" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Fakultas" />
							<hbox width="95%">
								<combobox
									forward="onChange=onSearchDefault" id="searchfakultas"
									cols="4" />
								<label use="ais.ui.util.MyLabelConfig" value="Prodi"/>
								<combobox id="searchjurusan"
									forward="onChange=onSearchDefault" cols="5" />
							</hbox>

							<label use="ais.ui.util.MyLabelConfig"
								value="Program" />
							<combobox id="searchprogram"
								forward="onChange=onSearchDefault" width="95%" />



							<label use="ais.ui.util.MyLabelConfig"
								value="Jenjang" />
							<combobox id="searchjenjang"
								forward="onChange=onSearchDefault" width="95%" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Tahun" />
							<intbox width="95%"
								forward="onChange=onSearchDefault" id="searchtahun">
							</intbox>

							<checkbox use="ais.ui.util.MyCheckboxConfig" id="searchaktif" label="Yg aktif"
								checked="true" forward="onClick=onSearchDefault" width="95%" />
						</row>


						<row
							spans="11">

							<toolbar>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig"
									tooltiptext="Tambah data" forward="onClick=onAdd" id="add"
									label="Tambah Data" image="/img/new.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" tooltiptext="Cari data"
									forward="onClick=onSearchDefault" id="find" label="Cari"
									image="/img/search.gif">
								</toolbarbutton>

							</toolbar>
						</row>
					</rows>
				</grid>

			</north>
			<center border="none" flex="true">

				<grid fixedLayout="true" use="ais.ui.util.MyGrid" sclass="fgrid">
					<rows>
						<row>

							<grid use="ais.ui.util.MyGrid"
								fixedLayout="true" id="grid" mold="paging" pageSize="25">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="50px" />

									<column
										use="ais.ui.util.MyColumnConfig" width="5%" label="Tahun"
										sort="auto(tahun)" />
									<column
										use="ais.ui.util.MyColumnConfig" label="Nama" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%" label="Prodi" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%" label="Jenjang" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%" label="Program" />
									<column
										use="ais.ui.util.MyColumnConfig" width="15%" label="Aturan" />
									<column
										use="ais.ui.util.MyColumnConfig" width="15%"
										label="Realisasi" />
									<column
										use="ais.ui.util.MyColumnConfig" label="OBE" width="5%" />
									<column
										use="ais.ui.util.MyColumnConfig" label="Aktif" width="0%" />

									<column
										use="ais.ui.util.MyColumnConfig" width="10%"
										label="Mulai Berlaku" />



									<column
										use="ais.ui.util.MyColumnConfig" width="0%" label="" />
								</columns>

							</grid>

						</row>
						<row>
							<paging visible="false" id="paging"
								detailed="true" />
						</row>
					</rows>
				</grid>

			</center>

		</borderlayout>


	</window>


</zk>
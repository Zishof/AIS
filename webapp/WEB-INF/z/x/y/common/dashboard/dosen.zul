<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.DosenAction" width="100%" height="100%">





		<borderlayout>
			<north border="none" open="true" flex="true" visible="false">
				<grid use="ais.ui.util.MyGrid" fixedLayout="true"
					height="70px">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="100px">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig">
						</column>
					</columns>
					<rows>

						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="Kode/NIP" />
							<textbox id="searchcode"
								forward="onOK=onSearchDefault" width="95%" />
							<label use="ais.ui.util.MyLabelConfig"
								value="Nama" />
							<textbox id="searchnama"
								forward="onOK=onSearchDefault" width="95%" />


							<label use="ais.ui.util.MyLabelConfig"
								value="Status" />
							<combobox width="95%"
								forward="onChange=onSearchDefault" id="searchstatus">
							</combobox>
							<checkbox id="searchaktif" visible="false"
								label="Tampilkan yang aktif" checked="true"
								forward="onClick=onSearchDefault" width="95%" />


							<label visible="false"
								use="ais.ui.util.MyLabelConfig" value="Fakultas" />
							<combobox width="95%" visible="false"
								forward="onChange=onSearchDefault" id="searchfakultas">
							</combobox>
							<label visible="false"
								use="ais.ui.util.MyLabelConfig" value="Prodi" />
							<combobox width="95%" visible="false"
								forward="onChange=onSearchDefault" id="searchjurusan">
							</combobox>
						</row>


						<row
							spans="11">

							<toolbar>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" tooltiptext="Cari data"
									forward="onClick=onSearchDefault" id="find" label="Cari"
									image="/img/search.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig"
									tooltiptext="Tambah data" forward="onClick=onAdd" id="add"
									label="Tambah Data" image="/img/new.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" disabled="true"
									visible="false" tooltiptext="Download Format Dosen"
									forward="onClick=onDownloadFormatDosen"
									id="downloadFormatDosen" label="Download Format Lama"
									image="/img/edit.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" visible="false"
									disabled="true" upload="true" tooltiptext="Upload Format Lama"
									forward="onUpload=onUploadDosen" id="uploadData"
									label="Upload Data Dosen" image="/img/edit.gif">
								</toolbarbutton>
								<toolbarbutton
									use="ais.ui.util.MyToolbarbuttonConfig" visible="false"
									upload="true" tooltiptext="Upload TBDOS.DBF"
									forward="onUpload=onUploadDBF" id="uploadDBF"
									label="Upload TBDOS.DBF" image="/img/edit.gif">
								</toolbarbutton>



							</toolbar>
						</row>
					</rows>
				</grid>

			</north>
			<center border="none" flex="true">

				<grid fixedLayout="true" use="ais.ui.util.MyGrid" sclass="fgrid">
					<rows>
						<row>

							<grid use="ais.ui.util.MyGrid"
								fixedLayout="true" id="grid" mold="paging" pageSize="25">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="40px" />
									<column
										use="ais.ui.util.MyColumnConfig" width="70px" />
									<column
										use="ais.ui.util.MyColumnConfig" width="8%" label="NIP"
										sort="auto(code)" />

									<column
										use="ais.ui.util.MyColumnConfig" width="8%" label="NIDN/NUPN"
										sort="auto(code)" />
									<column
										use="ais.ui.util.MyColumnConfig" label="Nama"
										sort="auto(nama)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="8%" label="Status"
										sort="auto(statusPegawai)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="5%" visible="false"
										label="Golongan" sort="auto(golongan)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%"
										label="Ikatan Dinas" sort="auto(tetap)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="5%" label="Email"
										sort="auto(email)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="8%" label="Telp."
										sort="auto(telp)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="5%" visible="false"
										label="Pangkat" sort="auto(pangkat)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="5%" visible="false"
										label="Jabatan" sort="auto(jabatan)" />
									<column
										use="ais.ui.util.MyColumnConfig" width="8%" label="Fakultas" />
									<column
										use="ais.ui.util.MyColumnConfig" width="8%" label="Prodi" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" label="Aktif"
										id="label_aktif" />
									<column
										use="ais.ui.util.MyColumnConfig" width="56px" label=""  align="center"/>
								</columns>

							</grid>

						</row>
						<row>
							<paging visible="false" id="paging"
								detailed="true" />
						</row>
					</rows>
				</grid>


			</center>

		</borderlayout>


	</window>


</zk>
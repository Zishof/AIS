<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" id="window"
		apply="ais.action.master.DaftarUlangMahasiswaBaruAction" border="none"
		width="100%" height="100%">





		<borderlayout>

			<north border="none" height="75px" flex="true"><div sclass="ecampus-bantuan-north-wrap" style="width:100%; height:100%; display:flex; align-items:center; gap:8px;">
				<toolbar style="background:transparent;border:0;padding:0;"><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;daftarulang_mahasiswa_baru&quot;, &quot;Bantuan&quot;);"/></toolbar>
				<grid use="ais.ui.util.MyGrid"
					fixedLayout="true" id="grid">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="0%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="0%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="20%" />
						<column width="10%"
							use="ais.ui.util.MyColumnConfig">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="10%" />
					</columns>
					<rows>
						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="Mahasiswa Baru" />
							<bandbox cols="50"
								disabled="true"
								use="ais.action.master.helper.AmbilDataCalonMahasiswaDaftarUlangBaruBanbox"
								id="pilihCalon" readonly="true" />
							<label use="ais.ui.util.MyLabelConfig"
								value="Semester" />
							<combobox width="95%" readonly="true"
								forward="onChange=onCariMahasiswa" id="semesterPilihan" />
							<button use="ais.ui.util.MyButtonConfig"
								label="Refresh" visible="false" id="tombolRefresh" height="25px"
								image="/img/options.png" forward="onClick=onCariMahasiswa">
							</button>
						</row>
					</rows>
				</grid>

			</div></north>

			<center>

				<!-- WADAH: harus <div> (blok, regang penuh), BUKAN <vbox>.
				     ZK Box dirender sebagai <table> dgn sel shrink-to-fit →
				     width:100% portalHost resolve melingkar ke lebar konten →
				     kolom portal 50% jatuh ke min-content (strip tipis). -->
				<div width="100%" height="100%">
					<div id="portalHost" width="100%" sclass="ais-portal-host" />
					<vbox id="center" width="100%">
						<grid use="ais.ui.util.MyGrid" sclass="fgrid" fixedLayout="true" width="100%" id="grids">
							<columns>
								<column use="ais.ui.util.MyColumnConfig"
									width="25%">
								</column>
								<column
									use="ais.ui.util.MyColumnConfig">
								</column>
							</columns>
							<rows>

								<row id="rowNim" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Mahasiswa Baru" />

									<hbox align="start" pack="center">
										<vbox id="labelFotoMahasiswa" />
										<vbox pack="center">

											<label
												id="labelNoUjianMahasiswa" />
											<label
												id="labelNamaMahasiswa" />
											<label
												use="ais.ui.util.MyLabelBoldAja" id="labelTabungan" />
										</vbox>
									</hbox>
								</row>
								<row id="rowJenisKuliah" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Jenis Kuliah" />
									<label id="jenisKuliah" />
								</row>
								<row id="rowProdi" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<label id="prodi" />
								</row>
								<row id="rowSemester" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Semester" />
									<label id="semester" />
								</row>
								<row id="rowTahunMasuk" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Tahun Masuk" />
									<label id="labelTahunMasuk" />
								</row>
								<row id="rowTahunAkademik"
									visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
									<label id="labelTahunAkademik" />
								</row>
								<row id="rowTanggalValidasi"
									visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Tanggal Validasi" />
									<label width="100px"
										id="tanggalValidasi" />
								</row>
								<row id="rowValidator" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Validator" />
									<label id="validator" />
								</row>
								<row id="rowKeteranganValidasi"
									visible="false">
									<label visible="false"
										use="ais.ui.util.MyLabelConfig" value="Keterangan Validasi" />
									<label visible="false"
										id="labelKeteranganValidasi" />
								</row>
								<row id="rowButton" visible="false">

									<button
										use="ais.ui.util.MyButtonConfig"
										label="Refresh Daftar Item Biaya"
										forward="onRefreshDaftarItemBiaya" />

								</row>

								<row id="rowListBiaya" visible="false" spans="2">

								</row>




								<row id="rowPengurangan" visible="false">

								</row>

								<row id="rowKeterangan" visible="false">
									<label
										use="ais.ui.util.MyLabelConfig" value="Keterangan" />

									<textbox id="keterangan" width="95%"
										rows="3">
									</textbox>

								</row>
								<row spans="2" id="rowMobile"></row>
							</rows>
						</grid>
					</vbox>

				</div>


			</center>





		</borderlayout>




	</window>
</zk>
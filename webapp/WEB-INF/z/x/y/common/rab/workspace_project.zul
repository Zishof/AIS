<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.rab.WorkspaceProjectAction" width="100%"
		height="100%">

		<!-- 
			<tabbox width="100%" height="100%">
			
			<tabs>
			
			<tab use="ais.ui.util.MyTabConfig" selected="true">Manajemen Jadwal Realisasi</tab>
			<tab use="ais.ui.util.MyTabConfig" forward="onClick=onTimeline">
			Timeline Jadwal Realisasi
			</tab>
			<tab use="ais.ui.util.MyTabConfig" forward="onClick=onTimeplot">
			Timeplot Realisasi Anggaran
			</tab>
			
			</tabs>
			
			<tabpanels>
			
			<tabpanel use="ais.ui.util.MyTabpanel">
		-->


		<panel use="ais.ui.util.MyPanel" width="100%" height="100%"
			framable="true" title="Data Workspace">
			<panelchildren>



				<borderlayout>

					<center border="none" flex="true">
						<borderlayout>
							<north border="none" open="true" flex="true"><div sclass="ecampus-bantuan-north-wrap" style="width:100%; height:100%; display:flex; align-items:center; gap:8px;">
				<toolbar style="background:transparent;border:0;padding:0;"><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;workspace_project&quot;, &quot;Bantuan&quot;);"/></toolbar>
								<grid use="ais.ui.util.MyGrid"  fixedLayout="true">

									<columns>
										<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
										<column use="ais.ui.util.MyColumnConfig"></column>
										<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
										<column use="ais.ui.util.MyColumnConfig"></column>
										<column use="ais.ui.util.MyColumnConfig" width="150px"></column>
										<column use="ais.ui.util.MyColumnConfig"></column>
										<column use="ais.ui.util.MyColumnConfig"></column>
									</columns>
									<rows>

										<row>
											<label use="ais.ui.util.MyLabelConfig"
												value="Tahun Anggaran" />
											<combobox
												forward="onChange=onReloadTab" id="tahunWorkspace"
												width="95%" />
											<label use="ais.ui.util.MyLabelConfig" value="Satuan Kerja" />
											<bandbox
												use="ais.action.master.rab.helper.AmbilDataSatuanKerjaBanbox"
												id="satuanKerja" width="95%" />

											<label use="ais.ui.util.MyLabelConfig" id="sumberDanaLabel"
												visible="false" value="Sumber Dana" />
											<bandbox visible="false"
												use="ais.action.master.rab.helper.AmbilDataSumberDanaBanbox"
												id="sumberDana" width="95%" />


										</row>


									</rows>
								</grid>

							</div></north>
							<center border="none"
								flex="true">

								<tabbox height="100%" width="100%"
									id="tabbox">
									<tabs id="tabs"></tabs>
									<tabpanels id="tabpanels">
									</tabpanels>

								</tabbox>



							</center>

						</borderlayout>
					</center>
				</borderlayout>
			</panelchildren>
		</panel>

		<!-- 
			</tabpanel>
			
			<tabpanel use="ais.ui.util.MyTabpanel" id="laporanTimeline">
			
			
			
			</tabpanel>
			
			
			<tabpanel use="ais.ui.util.MyTabpanel" id="laporanTimeplot">
			
			
			
			</tabpanel>
			
			</tabpanels>
			
			</tabbox>
		-->

	</window>


</zk>
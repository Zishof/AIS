<?page id="testZul" title=" New ZUL Title" cacheable="false" 
	language="xul/html" zscriptLanguage="Java" contentType="text/html;charset=UTF-8"?>




<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.akunting.AkunAction" width="100%"
		height="100%">


		<tabbox width="100%" height="100%">

			<tabs>
				<tab use="ais.ui.util.MyTabConfig" selected="true">Akun</tab>
				<tab use="ais.ui.util.MyTabConfig">Daftar Akun</tab>
			</tabs>

			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">


					<panel use="ais.ui.util.MyPanel" width="100%"
						height="100%" framable="true" title="Data Akun">
						<panelchildren>



							<borderlayout>

								<center border="none" flex="true">
									<borderlayout>
										<north border="none"    open="true">
											<grid use="ais.ui.util.MyGrid"  fixedLayout="true">

												<rows>



													<row>

														<toolbar>

															<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
																tooltiptext="Cari data" forward="onClick=onReloadTree"
																label="Refresh" image="/img/search.gif">
															</toolbarbutton>

															<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
																tooltiptext="Tambah Akun" forward="onClick=onAddAkun"
																id="addAkun" label="Tambah Akun" image="/img/new.gif">
															</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;akun&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
													</row>
												</rows>
											</grid>

										</north>
										<center border="none" flex="true">

											<tree width="100%"
												zclass="z-dottree" height="100%" id="tree">
												<treecols>
													<treecol width="40%"
														label="Akun">
													</treecol>
													<treecol
														label="Debet/Credit">
													</treecol>
													<treecol
														label="Keterangan">
													</treecol>
													<treecol
														label="Grup Akun">
													</treecol>

													<treecol
														width="15%">
													</treecol>
												</treecols>
											</tree>



										</center>

									</borderlayout>
								</center>
							</borderlayout>
						</panelchildren>
					</panel>



				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel">


					<panel use="ais.ui.util.MyPanel" width="100%"
						height="100%" id="panel" framable="true" title="Data Akun">
						<panelchildren>



							<borderlayout>

								<center border="none" flex="true">
									<borderlayout>
										<north border="none"    open="true">
											<grid use="ais.ui.util.MyGrid"  fixedLayout="true">
												<columns>
													<column use="ais.ui.util.MyColumnConfig"
														width="100px">
													</column>
													<column use="ais.ui.util.MyColumnConfig"></column>
													<column use="ais.ui.util.MyColumnConfig"
														width="100px">
													</column>
													<column use="ais.ui.util.MyColumnConfig"></column>
												</columns>
												<rows>

													<row>
														<label use="ais.ui.util.MyLabelConfig"
															value="Nama Akun" />
														<textbox
															forward="onOK=onSearchDefault" id="searchnama" cols="30" />

													</row>

													<row spans="4">

														<toolbar>
															<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
																tooltiptext="Tambah data" forward="onClick=onAdd"
																id="add" label="Tambah Data" image="/img/new.gif">
															</toolbarbutton>
															<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
																tooltiptext="Cari data"
																forward="onClick=onSearchDefault" id="find" label="Cari"
																image="/img/search.gif">
															</toolbarbutton>

														</toolbar>
													</row>
												</rows>
											</grid>

										</north>
										<center border="none" flex="true">


											<grid use="ais.ui.util.MyGrid"  fixedLayout="true"
												id="grid" mold="paging" pageSize="25">
												<columns
													menupopup="auto">
													<column use="ais.ui.util.MyColumnConfig"
														label="Kode Akun" sort="auto(kode)" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Nama Akun" sort="auto(nama)" />

													<column use="ais.ui.util.MyColumnConfig"
														label="Debit/Credit" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Keterangan" />
													<column use="ais.ui.util.MyColumnConfig"
														label="Grup Akun" />
													<column use="ais.ui.util.MyColumnConfig" width="56px"
														label=""  align="center"/>
												</columns>

											</grid>


										</center>
										<south border="none"></south>
									</borderlayout>
								</center>
							</borderlayout>
						</panelchildren>
					</panel>



				</tabpanel>

			</tabpanels>
		</tabbox>

		<window use="ais.ui.util.MyWindow" id="addWindow" title="Tambah Akun" visible="false"
			mode="popup" position="center,center" border="normal" width="450px"
			height="440px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" id="window"
		apply="ais.action.master.DaftarUlangMahasiswaLamaAction" border="none"
		width="100%" height="100%">


		<tabbox width="100%" height="100%">

			<tabs id="tabsUtama">

				<tab use="ais.ui.util.MyTabConfig" selected="true">
					Pembayaran Mahasiswa
				</tab>
				<tab use="ais.ui.util.MyTabConfig"
					id="tabTagihanMahasiswaBaru"
					forward="onClick=onTagihanMahasiswaBaru">
					Pembayaran Mahasiswa Baru
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="keranjang"
					visible="false" forward="onClick=onKeranjangPembayaran">
					Keranjang Pembayaran
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabFinpay"
					forward="onClick=onFinpay">
					Sejarah Transaksi via Finpay
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabIpaymu"
					forward="onClick=onIpaymu">
					Sejarah Transaksi via Ipaymu
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabFaspay"
					forward="onClick=onFaspay">
					Sejarah Transaksi via Faspay
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabJatelindo"
					forward="onClick=onJatelindo">
					Sejarah Transaksi via Mandiri
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabCimb"
					forward="onClick=onCimb">
					Sejarah Transaksi via Cimb
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabBni"
					forward="onClick=onBni">
					Sejarah Transaksi via Bni
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabBsi"
					forward="onClick=onBsi">
					Sejarah Transaksi via Bsi
				</tab>
				<tab use="ais.ui.util.MyTabConfig" id="tabBri"
					forward="onClick=onBri">
					Sejarah Transaksi via Bri
				</tab>
			</tabs>


			<tabpanels>

				<tabpanel use="ais.ui.util.MyTabpanel">




					<borderlayout>

						<north border="none" flex="true"
							height="40px"><div sclass="ecampus-bantuan-north-wrap" style="width:100%; height:100%; display:flex; align-items:center; gap:8px;">
				<toolbar style="background:transparent;border:0;padding:0;"><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;daftarulang_mahasiswa_lama&quot;, &quot;Bantuan&quot;);"/></toolbar>
							<grid use="ais.ui.util.MyGrid" fixedLayout="true"
								sclass="fgrid" id="grid">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="15%" />
									<column
										use="ais.ui.util.MyColumnConfig">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%">
									</column>
									<column
										use="ais.ui.util.MyColumnConfig" width="15%" />
									<column width="8%"
										use="ais.ui.util.MyColumnConfig">
									</column>

									<column
										use="ais.ui.util.MyColumnConfig" width="10%" />
								</columns>
								<rows>
									<row>
										<label
											use="ais.ui.util.MyLabelConfig" value="Jenis Pembayaran" />
										<combobox width="95%" readonly="true"
											forward="onChange=onCariMahasiswa" id="jenisPembayaran" />
										<label
											use="ais.ui.util.MyLabelConfig" value="Pilih Mahasiswa" />
										<bandbox disabled="true"
											use="ais.action.master.helper.AmbilDataMahasiswaBanbox"
											width="95%" id="nim" />
										<label
											use="ais.ui.util.MyLabelConfig" value="Semester" />
										<combobox width="95%"
											readonly="true" forward="onChange=onCariMahasiswa"
											id="semesterPilihan" />

										<button
											use="ais.ui.util.MyButtonConfig" label="Refresh"
											visible="false" id="tombolRefresh" width="95%"
											image="/img/options.png" forward="onClick=onCariMahasiswa">
										</button>
									</row>





								</rows>
							</grid>

						</div></north>
						<center>

							<!-- WADAH: harus <div> (blok, regang penuh), BUKAN <vbox>.
							     ZK Box dirender sebagai <table> dgn sel shrink-to-fit →
							     width:100% portalHost resolve melingkar ke lebar konten →
							     kolom portal 50% jatuh ke min-content (strip tipis). -->
							<div width="100%" height="100%">
								<div id="portalHost" width="100%" sclass="ais-portal-host" />
								<vbox id="center" width="100%">


									<grid use="ais.ui.util.MyGrid"
										sclass="fgrid" fixedLayout="true"
										width="100%" id="grids">
										<columns>
											<column
												use="ais.ui.util.MyColumnConfig" width="25%">
											</column>
											<column
												use="ais.ui.util.MyColumnConfig">
											</column>
										</columns>
										<rows>

											<row id="rowInfoTunggakan"
												spans="2" visible="false">

											</row>

											<row id="rowNim"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Mahasiswa" />
												<hbox align="start"
													pack="center">
													<vbox
														id="labelFotoMahasiswa" />
													<vbox>

														<label
															id="labelNimMahasiswa" />
														<label
															id="labelNamaMahasiswa" />
														<label
															use="ais.ui.util.MyLabelBoldAja" id="labelTabungan" />
													</vbox>
												</hbox>

											</row>
											<row id="rowJenisKuliah"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Jenis Kuliah" />
											<vbox id="jenisKuliah" width="100%" spacing="2px" />
										</row>
										<row id="rowJenjang" visible="false">
											<label use="ais.ui.util.MyLabelConfig" value="Jenjang" />
											<label id="labelJenjang" />
										</row>
										<row id="rowProdi"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Prodi" />
												<label id="prodi" />
											</row>
											<row id="rowSemester"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Semester" />

												<hbox>
													<label id="semester"
														width="100px" />
													<hbox
														id="informasi">
													</hbox>
												</hbox>
											</row>
											<row id="rowTahunMasuk"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Tahun Masuk" />
												<label
													id="labelTahunMasuk" />
											</row>
											<row id="rowTahunAkademik"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Tahun Akademik" />
												<label
													id="labelTahunAkademik" />
											</row>
											<row id="rowTanggalValidasi"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Tanggal Validasi" />
												<label width="100px"
													id="tanggalValidasi" />
											</row>
											<row id="rowValidator"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Validator" />
												<label id="validator" />
											</row>
											<row id="rowButton"
												visible="false">

												<button
													use="ais.ui.util.MyButtonConfig"
													label="Refresh Daftar Item Biaya"
													forward="onRefreshDaftarItemBiaya" />

											</row>

											<row id="rowListBiaya"
												visible="false"
												spans="2">

											</row>

											<row id="rowPengurangan"
												visible="false">

											</row>

											<row id="rowKeterangan"
												visible="false">
												<label
													use="ais.ui.util.MyLabelConfig" value="Keterangan" />

												<textbox id="keterangan"
													width="95%" rows="3">
												</textbox>

											</row>

											<row spans="2"
												id="rowMobile">
											</row>

										</rows>
									</grid>

								</vbox>

							</div>

						</center>

					</borderlayout>



				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelTagihanMahasiswaBaru">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelKeranjangPembayaran"></tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelFinpay">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelIpaymu">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelFaspay">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelJatelindo">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelCimb">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelBni">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelBsi">

				</tabpanel>

				<tabpanel use="ais.ui.util.MyTabpanel" id="tabpanelBri">

				</tabpanel>

			</tabpanels>
		</tabbox>




	</window>
</zk>

<zk>
	<!--
	  e_learning_mobile.zul — Tampilan e-Learning versi MOBILE (pilot Tier-1).
	  Tipis: seluruh isi dibangun oleh ais.action.master.TampilanELearningActionMobile
	  yang MEMAKAI-ULANG helper data lama (RekapitulasiPerkuliahanHelper, dst.) tanpa
	  mengubah TampilanELearningAction desktop. Dibuka oleh cangkang mobile (MobileAction)
	  di dalam overlay layar penuh; gaya .ais-m-* berasal dari ais_mobile.css halaman induk.
	-->
	<div apply="ais.action.master.TampilanELearningActionMobile"
		width="100%" sclass="ais-m-elearning" style="padding:10px 10px 24px 10px;box-sizing:border-box;" />
</zk>

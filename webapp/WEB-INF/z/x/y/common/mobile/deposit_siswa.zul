<?page title="Pembelian" contentType="text/html;charset=UTF-8"?>
<?meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" ?>
<?meta name="description" content="E-Pembayaran" ?>
<?meta name="author" content="Mohammad Fauzi Murtadho" ?>


<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.sekolah.DepositSiswaAction" width="100%"
		height="100%">


		<borderlayout>
			<north border="none" open="true" flex="true">

				<hbox
					width="100%">
					<grid use="ais.ui.util.MyGrid"  fixedLayout="true"
						visible="true">
						<columns>
							<column use="ais.ui.util.MyColumnConfig"
								width="100%">
							</column>
						</columns>
						<rows>

							<row width="100%">
								<label use="ais.ui.util.MyLabelConfig"
									id="siswatampil" />
							</row>
							<row>
								<label use="ais.ui.util.MyLabelConfig"
									id="nimsiswatampil" />

							</row>
							<row>
								<label use="ais.ui.util.MyLabelConfig"
									id="kelassiswatampil" />

							</row>

						</rows>


					</grid>

					<grid use="ais.ui.util.MyGrid"  fixedLayout="true"
						visible="false">
						<columns>
							<column use="ais.ui.util.MyColumnConfig"
								width="100px">
							</column>
							<column use="ais.ui.util.MyColumnConfig">
							</column>
							<column use="ais.ui.util.MyColumnConfig"
								width="100px">
							</column>
							<column use="ais.ui.util.MyColumnConfig">
							</column>
							<column use="ais.ui.util.MyColumnConfig"
								width="100px">
							</column>
							<column use="ais.ui.util.MyColumnConfig">
							</column>
							<column use="ais.ui.util.MyColumnConfig"
								width="100px">
							</column>
							<column use="ais.ui.util.MyColumnConfig">
							</column>
							<column use="ais.ui.util.MyColumnConfig"
								width="100px">
							</column>
							<column use="ais.ui.util.MyColumnConfig">
							</column>

						</columns>
						<rows>

							<row>
								<label use="ais.ui.util.MyLabelConfig"
									value="Siswa" />
								<textbox forward="onOK=onSearchDefault"
									id="searchsiswa" width="95%" />

								<hbox width="95%">
									<label
										use="ais.ui.util.MyLabelConfig" value="Yayasan" />
									<label value="/"></label>
									<label
										use="ais.ui.util.MyLabelConfig" value="Sekolah" />
								</hbox>
								<hbox width="95%">
									<combobox
										forward="onChange=onSearchDefault" id="searchyayasan"
										cols="4" />
									<combobox id="searchsekolah"
										forward="onChange=onSearchDefault" cols="4" />
								</hbox>


								<label use="ais.ui.util.MyLabelConfig"
									value="Cara Pembayaran" />
								<combobox
									forward="onChange=onSearchDefault" id="searchjenis"
									width="95%" />


							</row>

							<row spans="10">

								<toolbar>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										
										tooltiptext="Tambah data" forward="onClick=onAdd" id="add"
										label="Tambah Data" image="/img/new.gif">
									</toolbarbutton>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
										
										tooltiptext="Cari data" forward="onClick=onSearchDefault"
										id="find" label="Cari" image="/img/search.gif">
									</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;deposit_siswa&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
							</row>
						</rows>
					</grid>
				</hbox>
			</north>
			<center border="none" flex="true">

				<grid fixedLayout="true" use="ais.ui.util.MyGrid" sclass="fgrid">
					<rows>
						<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-atas" height="64px" /></row>
						<row>
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging"
								detailed="true" />
						</row>
						<row>
							<grid use="ais.ui.util.MyGrid" 
								sclass="dgrid" fixedLayout="true" id="grid">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" label="Foto" width="0px" />
									<column
										use="ais.ui.util.MyColumnConfig" label="NIS" width="0%" />
									<column
										use="ais.ui.util.MyColumnConfig" label="Info Deposit" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%"
										label="Waktu Pembayaran" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%"
										label="Cara Pembayaran" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" label="Nominal"
										align="right" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" label="Keterangan"
										 />

									<column
										use="ais.ui.util.MyColumnConfig" width="0%" label="" />
								</columns>

							</grid>


						</row>
						<row><paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar" /></row>
						<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-bawah" height="128px" /></row>
					</rows>
				</grid>
			</center>
		</borderlayout>


		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Deposit" visible="false" mode="popup"
			position="center,center" border="normal" width="550px"
			height="300px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
<?page title="KRS" contentType="text/html;charset=UTF-8"?>
<?meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" ?>
<?meta name="description" content="E-KRS" ?>
<?meta name="author" content="Mohammad Fauzi Murtadho" ?>


<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.KrsAction" width="100%" height="100%">




		<borderlayout>
			<north border="none" open="true" flex="true"><div sclass="ecampus-bantuan-north-wrap" style="width:100%; height:100%; display:flex; align-items:center; gap:8px;">
				<toolbar style="background:transparent;border:0;padding:0;"><toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;krs&quot;, &quot;Bantuan&quot;);"/></toolbar>
				<grid use="ais.ui.util.MyGrid"  fixedLayout="true">
					<columns>
						<column use="ais.ui.util.MyColumnConfig"
							width="35%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="65%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="0%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="0%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="0%">
						</column>
						<column use="ais.ui.util.MyColumnConfig"
							width="0%">
						</column>
					</columns>
					<rows>

						<row>
							<label use="ais.ui.util.MyLabelConfig"
								value="NIM" />
							<label use="ais.ui.util.MyLabelConfig"
								id="searchnim" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Tahun Angkatan" />
							<label use="ais.ui.util.MyLabelConfig"
								id="searchangkatan" />

						</row>
						<row>

							<label use="ais.ui.util.MyLabelConfig"
								value="Nama Mahasiswa" />
							<label use="ais.ui.util.MyLabelConfig"
								id="searchnama" />


						</row>
						<row visible="false">

							<label use="ais.ui.util.MyLabelConfig"
								value="Program" />
							<label use="ais.ui.util.MyLabelConfig"
								id="searchprogram" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Prodi" />
							<label use="ais.ui.util.MyLabelConfig"
								id="searchjurusan" />

							<label use="ais.ui.util.MyLabelConfig"
								value="Fakultas" />
							<label use="ais.ui.util.MyLabelConfig"
								id="searchfakultas" />
						</row>


						<row visible="false">
							<label use="ais.ui.util.MyLabelConfig"
								value="Semester Mulai" />
							<combobox forward="onChange=onSearchDefault"
								id="semesterMulai" />
							<label use="ais.ui.util.MyLabelConfig"
								value="Semester Sampai" />
							<combobox forward="onChange=onSearchDefault"
								id="semesterSampai" />

							<button use="ais.ui.util.MyButtonConfig"
								label="Hitung IP/IPK" height="25px" image="/img/options.png"
								forward="onClick=onSearchDefaultKeDatabase">
							</button>
							<checkbox forward="onClick=onSearchDefault"
								use="ais.ui.util.MyCheckboxConfig" id="searchtampilin"
								checked="true" label="Tampilkan Rinci / IPK">
							</checkbox>

						</row>

					</rows>
				</grid>

			</div></north>
			<center border="none" flex="true">

				<grid use="ais.ui.util.MyGrid" sclass="fgrid">
					<rows>
						<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-atas" height="64px" /></row>
						<row>
							<paging use="ais.ui.util.MyPagingKembar" visible="false" id="paging"
								detailed="true" />
						</row>
						<row>
							<grid use="ais.ui.util.MyGrid" 
								sclass="dgrid" fixedLayout="true" id="grid">
								<columns>
									<column
										use="ais.ui.util.MyColumnConfig" width="50px" />
									<column
										use="ais.ui.util.MyColumnConfig" label="Tahun Akademik" />
									<column
										use="ais.ui.util.MyColumnConfig" width="10%" id="colSemester"
										label="SMT" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" id="colTahapan"
										label="Tahapan" />
									<column
										use="ais.ui.util.MyColumnConfig" width="0%" label="Status" />
									<column id="colIpk"
										use="ais.ui.util.MyColumnConfig" width="0%" label="IP/IPK" />
									<column id="colSks"
										use="ais.ui.util.MyColumnConfig" width="0%" label="SKS/SKSK" />

									<column id="colKet"
										use="ais.ui.util.MyColumnConfig" label="Keterangan" />
									<column id="colKomen"
										use="ais.ui.util.MyColumnConfig" width="0%" label="Komentar" />
									<column id="colCatatan"
										use="ais.ui.util.MyColumnConfig" width="0%"
										label="Catatan Dosen" />
								</columns>

							</grid>


						</row>
						<row><paging visible="false" id="paging2" detailed="true" use="ais.ui.util.MyPagingKembar" /></row>
						<row sclass="ecampus-grid-gap-row"><div sclass="ecampus-grid-gap-bawah" height="128px" /></row>
					</rows>
				</grid>
			</center>
		</borderlayout>

		<window use="ais.ui.util.MyWindow" id="addWindow"
			title="Tambah Dosen" visible="false" mode="popup"
			position="center,center" border="normal" width="550px"
			height="440px">

		</window>

		<zscript><![CDATA[
	addWindow.setVisible(false);
]]></zscript>

	</window>


</zk>
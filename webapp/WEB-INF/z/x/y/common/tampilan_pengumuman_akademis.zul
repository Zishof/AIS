<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<style>body { overflow: hidden; }</style>

	<window use="ais.ui.util.MyWindow" border="none" id="window"
		apply="ais.action.master.TampilanPengumumanAkademisAction"
		width="100%" height="100%"
		contentStyle="overflow:auto;padding: 15px;">

		<borderlayout>

			<center border="none" flex="true">



				<borderlayout>
					<north border="none" visible="false" id="mynorth"
						open="true">
						<grid use="ais.ui.util.MyGrid"  fixedLayout="true">
							<columns>
								<column use="ais.ui.util.MyColumnConfig"
									width="100px">
								</column>
								<column
									use="ais.ui.util.MyColumnConfig">
								</column>
								<column use="ais.ui.util.MyColumnConfig"
									width="100px">
								</column>
								<column
									use="ais.ui.util.MyColumnConfig">
								</column>

							</columns>
							<rows>

								<row>
									<label
										use="ais.ui.util.MyLabelConfig" value="Fakultas" />
									<combobox
										forward="onChange=onSearchDefault" id="searchfakultas"
										width="95%" />
									<label
										use="ais.ui.util.MyLabelConfig" value="Tanggal Mulai" />
									<datebox use="ais.ui.util.MyDatebox"
										forward="onChange=onSearchDefault" id="searchmulai"
										width="95%" />

								</row>

								<row>
									<label
										use="ais.ui.util.MyLabelConfig" value="Prodi" />
									<combobox id="searchjurusan"
										forward="onChange=onSearchDefault" width="95%" />

									<label
										use="ais.ui.util.MyLabelConfig" value="Tanggal Sampai" />
									<datebox use="ais.ui.util.MyDatebox"
										id="searchsampai" forward="onChange=onSearchDefault"
										width="95%" />

								</row>



								<row spans="4">

									<toolbar>

										<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"
											
											tooltiptext="Cari data" forward="onClick=onSearchDefault"
											id="find" label="Cari" image="/img/search.gif">
										</toolbarbutton>
				<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig" label="Bantuan" image="/img/help.gif" tooltiptext="Panduan penggunaan halaman ini" onClick="ais.action.master.helper.BantuanHelper.tampilkanDariResource(self, &quot;tampilan_pengumuman_akademis&quot;, &quot;Bantuan&quot;);"/>
			</toolbar>
								</row>
							</rows>
						</grid>

					</north>
					<center border="none"
						flex="true">

						<tabbox width="100%" height="100%">

							<tabs id="tabspeng"></tabs>

							<tabpanels id="tabpanelspeng"> 
							</tabpanels>
						</tabbox>


					</center>
					<south border="none">
						<paging visible="false" id="paging"
							detailed="true" />
					</south>



				</borderlayout>




			</center>
		</borderlayout>


	</window>

</zk>
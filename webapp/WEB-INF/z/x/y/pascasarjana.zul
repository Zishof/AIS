<?page title="AIS Pascasarjana UIN Jakarta" contentType="text/html;charset=UTF-8"?>
<zk>

	<borderlayout
		apply="ais.action.maintenance.PascasarjanaAction">

		<north size="80px" border="0" id="mycenter">

			<image id="header" height="80px"
				width="100%" src="/img/header__pasca.jpg" align="left" />
		</north>
		<zscript>
	// AIS_RESET_DEFAULT_ZKOSS_STYLE mycenter.setStyle(null);
</zscript>
		<west width="220px" border="0" flex="true" splittable="true" margins="0,5,0,0">
			<vlayout spacing="0">
				<panel width="100%" border="normal"
					title="Navigation">
					<panelchildren>
						<vbox>
							<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"   label="Home" />
							<a href="http://www.uinjkt.ac.id" target="blank">
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"   label="UIN Jakarta" />
							</a>
							<a href="http://graduate.uinjkt.ac.id" target="blank">
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
									label="Pascasarjana UIN Jakarta" />
							</a>
							<a href="http://kemenag.go.id" target="blank">
								<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
									label="Kementerian Agama RI" />
							</a>

							<!-- <toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"   label="Login" id="initBtn"
								forward="onClick=onClickPMB" /> -->
							<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"   label="Forgot Password" />
						</vbox>
					</panelchildren>
				</panel>


				<panel width="100%" border="normal" title="Calendar">
					<panelchildren>
						<calendar></calendar>
					</panelchildren>
				</panel>

				<panel width="100%" border="normal"
					title="Contact Information">
					<panelchildren>
						<grid use="ais.ui.util.MyGrid">


							<rows>
								<row spans="2">
									<vbox>
										<html>





											
											<![CDATA[ <p><b> Kampus
											Sekolah Pascasarjana UIN
											Syarif Hidayatullah
											Jakarta</b> </br> </br>
											JL.Kertamukti No.5 Pisangan
											Barat, Cireundeu Ciputat
											15419 </br> </br> Phone:
											(+62-21) 740 1472,
											74709260</br> Fax: (+62-21)
											74700919 </br>Mail:
											spsuinjkt@gmail.com </p>

											]]>
											
											
											
											
																				
														
														
													</html>

									</vbox>
								</row>
							</rows>
						</grid>
					</panelchildren>
				</panel>

			</vlayout>
		</west>
		<center>
			<vbox pack="center" align="center" width="100%"
				height="100%">
				<!-- <image 
					width="100%" src="/img/bg-pasca.png" align="left" /> -->
				<panel use="ais.ui.util.MyPanel" height="100%"
					width="100%" border="none" title="">
					<panelchildren
						id="mycenterr">
						<vbox>
							<html
								if="${not empty param.login_error}">








								
								<![CDATA[ Your login attempt was not
								successful, try again.<br/><br/> Reason:
								${SPRING_SECURITY_LAST_EXCEPTION.message}
								]]>
								
								
								
								
								
								
								
																
								</html>

							<groupbox width="400px" left="500px">


								<grid use="ais.ui.util.MyGrid"  width="100%"
									fixedLayout="true">
									<columns>
										<column use="ais.ui.util.MyColumnConfig" width="35%"></column>
										<column use="ais.ui.util.MyColumnConfig" width="65%"></column>
									</columns>
									<rows>
										<row>
											<label use="ais.ui.util.MyLabelConfig" value="Username">
											</label>
											<textbox id="username"
												width="85%" />
										</row>
										<row>
											<label use="ais.ui.util.MyLabelConfig" value="Password">
											</label>
											<textbox id="password"
												width="85%" type="password" />
										</row>
										<row spans="2">
											<hbox>
												<button use="ais.ui.util.MyButtonConfig" label="Login"
													id="login" forward="onClick=onLogin">
												</button>
												<button use="ais.ui.util.MyButtonConfig" label="Reset"
													id="reset" forward="onClick=onReset">
												</button>
											</hbox>
										</row>

										<row spans="2">
											<label use="ais.ui.util.MyLabelConfig" id="information"></label>
										</row>
										<row spans="2">
											<vbox>
												<html id="pemberitahuan">



													
													<![CDATA[


													<ol> <li>Gunakan
													browser Mozilla
													Firefox untuk hasil
													terbaik</li>
													<li>Khusus
													mahasiswa, demi
													alasan kemanan,
													segera ganti
													password lama
													anda</li> <li>Pada
													saat memasukkan
													biodata, masukkan
													alamat email secara
													lengkap, alamat
													email ini digunakan
													untuk melakukan
													verifikasi (misalnya
													lupa password)</li>
													<li>Jika terjadi
													masalah, harap
													segera hubungi
													puskom@uinjkt.ac.id</li>
													</ol>

													]]>
													
													
													
														
													</html>

											</vbox>
										</row>
										<row spans="5">
											<a
												forward="onClick=onForgotPassword">
												Apakah Anda Lupa
												Password ?
											</a>
										</row>
									</rows>
								</grid>


								<caption>
									<toolbarbutton use="ais.ui.util.MyToolbarbuttonConfig"  
										forward="onClick=onLihatOnline"
										id="usersOnline" label="Online user(s): 0" />
									<timer id="timer" delay="100000"
										repeats="true" forward="onTimer=onUpdateUserOnline" />
								</caption>

							</groupbox>
						</vbox>
					</panelchildren>
				</panel>
			</vbox>

		</center>



	</borderlayout>


</zk>
<?init class="ais.ui.util.MyInit"?>
<?link rel="shortcut icon" type="image/x-icon" href="${myFavicon}"?>
<?link rel="icon" type="image/x-icon" href="${myFavicon}"?>
<?page title="Sistem Informasi Penerimaan Mahasiswa Baru" contentType="text/html;charset=UTF-8"?>
<?meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" ?>
<?meta name="description" content="Seleksi Penerimaan Mahasiswa Baru" ?>
<?meta name="author" content="Mohammad Fauzi Murtadho" ?>
<zk>
	<window use="ais.ui.util.MyWindow" width="100%" height="100%" sclass="pmb-zk-window"
		id="main" forward="onClientInfo=onInfo"
		apply="ais.action.maintenance.PMBAction" border="none">

		<borderlayout height="100%" width="100%" id="myborder">
			<center border="none" flex="true" sclass="main-scroll-center">
				<grid fixedLayout="true" width="100%" sclass="pmb-zk-shell">
					<rows>
						<row>
							<hbox id="bahasaBox" width="100%" pack="end" align="center" sclass="pmb-bahasa-box">
							</hbox>
						</row>
						<row>
							<div id="kopBox" sclass="headerHbox" width="100%">
							</div>
						</row>
						<row>
							<toolbar id="menubar" width="100%" sclass="pmb-zk-toolbar">
							</toolbar>
						</row>
						<row>
							<div id="container" sclass="container pmb-zk-container" width="100%">
							</div>
						</row>
						<row>
							<div id="footer" sclass="headerHbox" width="100%">
							</div>
						</row>
					</rows>
				</grid>
			</center>
		</borderlayout>

		<div id="wacontainer"></div>

		<zscript><![CDATA[
	// Tombol "Mode Desktop" / "Mode HP" (muncul otomatis di layar kecil ≤980px) —
	// me-reload halaman ini dengan flag is_mobile agar bisa pindah tampilan.
	ais.ui.util.ModeTampilanUtil.injectReloadDiri(execution, "/pmb");
	// Pemilih Bahasa (Indonesia/English/Arab) — bilah paling atas portal PMB.
	try {
		bahasaBox.appendChild(ais.ui.util.BahasaSwitchHelper.buatComboBahasa());
	} catch (Exception eLang) {
	}
]]></zscript>

	<style><![CDATA[
/* =====================================================================
   PMB Portal — ZKoss shell styles
   Scope: .pmb-zk-window, .pmb-zk-toolbar, .pmb-zk-container
   Kompatibel: ZK 5.0.13, Bootstrap 5, mobile & desktop
   ===================================================================== */

/* ----- Toolbar navigasi utama ----- */
.pmb-zk-toolbar .z-toolbar {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d6a9f 100%) !important;
    border: none !important;
    box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    padding: 4px 8px;
}

/* ----- Tombol toolbar: Tampilan inline-flex modern ----- */
.pmb-zk-container .z-toolbarbutton,
.pmb-zk-toolbar .z-toolbarbutton {
    display: inline-flex !important;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.12);
    color: #fff !important;
    cursor: pointer;
    transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.1s ease;
    margin: 2px 2px;
    text-shadow: none;
}
.pmb-zk-container .z-toolbarbutton a,
.pmb-zk-toolbar .z-toolbarbutton a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: inherit !important;
}
.pmb-zk-container .z-toolbarbutton:hover,
.pmb-zk-toolbar .z-toolbarbutton:hover {
    background: rgba(255,255,255,0.22) !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    transform: translateY(-1px);
}
.pmb-zk-container .z-toolbarbutton:active,
.pmb-zk-toolbar .z-toolbarbutton:active {
    transform: translateY(0);
    box-shadow: none;
    background: rgba(255,255,255,0.08) !important;
}

/* ----- Tombol toolbar di area konten (non-header) ----- */
.pmb-zk-container .z-toolbarbutton {
    background: #f0f4f8 !important;
    color: #1e3a5f !important;
    border: 1px solid #cdd8e8;
}
.pmb-zk-container .z-toolbarbutton a {
    color: #1e3a5f !important;
}
.pmb-zk-container .z-toolbarbutton:hover {
    background: #ddeaf7 !important;
    border-color: #2d6a9f;
}

/* ----- Konten utama ----- */
.pmb-zk-container {
    padding: 8px 4px;
    min-height: 200px;
}

/* ----- Grid shell tidak menambahkan border/spacing ----- */
.pmb-zk-shell .z-row,
.pmb-zk-shell .z-row-inner {
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
}
.pmb-zk-shell {
    border: none !important;
}

/* ----- Scroll area tengah ----- */
.main-scroll-center {
    overflow-y: auto !important;
    overflow-x: hidden !important;
}

/* ----- Focus accessibility ----- */
.pmb-zk-container .z-toolbarbutton:focus,
.pmb-zk-toolbar .z-toolbarbutton:focus {
    outline: 2px solid #7fb3e0;
    outline-offset: 1px;
}

/* ----- Ikon kecil di dalam tombol (img tag) ----- */
.pmb-zk-container .z-toolbarbutton img,
.pmb-zk-toolbar .z-toolbarbutton img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    flex-shrink: 0;
}

/* ----- Popup / MyWindow interview ----- */
.z-window-modal {
    border-radius: 10px !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.22) !important;
    overflow: hidden !important;
}
.z-window-modal .z-window-header {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d6a9f 100%) !important;
    color: #fff !important;
    font-weight: 600;
    padding: 10px 16px;
}

/* ----- Groupbox / Panel ----- */
.z-groupbox {
    border-radius: 8px !important;
    overflow: hidden;
}
.z-groupbox-header {
    background: #f0f4f8 !important;
    font-weight: 600;
    color: #1e3a5f;
}

/* ----- Responsive: layar kecil (≤600px) ----- */
@media (max-width: 600px) {
    .pmb-zk-container .z-toolbarbutton,
    .pmb-zk-toolbar .z-toolbarbutton {
        font-size: 11px;
        padding: 5px 8px;
        gap: 3px;
    }
    .pmb-zk-container .z-toolbarbutton img,
    .pmb-zk-toolbar .z-toolbarbutton img {
        width: 14px;
        height: 14px;
    }
}

/* ----- Responsive: layar sangat kecil (≤400px) ----- */
@media (max-width: 400px) {
    .pmb-zk-container .z-toolbarbutton span:not([class*="img"]) {
        display: none;
    }
    .pmb-zk-container .z-toolbarbutton img,
    .pmb-zk-toolbar .z-toolbarbutton img {
        width: 18px;
        height: 18px;
    }
}
]]></style>
	</window>

</zk>

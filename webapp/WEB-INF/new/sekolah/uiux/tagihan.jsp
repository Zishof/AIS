<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!
private String th(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String tt(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%
String tc=(String)session.getAttribute("newUiCsrfToken");if(tc==null){tc=tt();session.setAttribute("newUiCsrfToken",tc);}NewUiPermission tp=NewUiRouteGuard.permissionFor(request,"sekolah","tagihan");boolean tu=tp!=null&&tp.isCanUpdate(),td=tp!=null&&tp.isCanDelete();String tm=request.getParameter("menuId"),te=request.getContextPath()+"/new?service=1&module=sekolah&page=tagihan"+(tm==null?"":"&menuId="+th(tm));%>
<style>.tg-person{display:flex;gap:10px;align-items:center}.tg-photo{width:42px;height:42px;border-radius:12px;object-fit:cover;background:#edf2ff}.tg-actions{display:flex;gap:5px;flex-wrap:wrap}.tg-modal{position:fixed;inset:0;background:#0b17334d;display:none;align-items:center;justify-content:center;z-index:9999;padding:16px}.tg-modal.open{display:flex}.tg-dialog{background:#fff;border-radius:18px;width:min(720px,100%);max-height:85vh;overflow:auto;padding:20px;box-shadow:0 24px 80px #0a18394d}.tg-dialog-head{display:flex;justify-content:space-between;align-items:center;gap:12px}.tg-switch{position:relative;display:inline-flex;align-items:center;gap:6px}.tg-status-paid{color:#08783c}.tg-status-open{color:#b45100}</style>
<section class="nui-page" id="nuiBills" data-endpoint="<%=th(te)%>" data-csrf="<%=th(tc)%>" data-update="<%=tu%>" data-delete="<%=td%>">
 <header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">eSchool / Keuangan / Tagihan</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-file-invoice-dollar"></i> STUDENT BILLING</p><h1>Tagihan Siswa</h1><p>Kelola pembentukan, status lunas, sinkronisasi, pemindahan pembayaran, dan audit tagihan sesuai aturan aplikasi lama.</p></div><div class="tg-actions"><button id="tgExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-excel"></i> Ekspor</button><button id="tgGenerate" class="nui-btn nui-btn-hero" <%=tu?"":"disabled"%>><i class="fa-solid fa-wand-magic-sparkles"></i> Bentuk Tagihan Hilang</button><button id="tgSync" class="nui-btn nui-btn-hero" <%=tu?"":"disabled"%>><i class="fa-solid fa-arrows-rotate"></i> Sinkronkan</button></div></header>
 <div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Total Hasil</small><strong id="tgTotal">0</strong></article><article class="nui-card"><small>Lunas di Halaman</small><strong id="tgPaid">0</strong></article><article class="nui-card"><small>Belum Lunas di Halaman</small><strong id="tgOpen">0</strong></article><article class="nui-card"><small>Nominal di Halaman</small><strong id="tgAmount">Rp 0</strong></article></div>
 <article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="tgSearch" class="nui-input" type="search" placeholder="Nama, NIS, atau nomor registrasi..."><input id="tgFee" class="nui-input" type="search" placeholder="Kode/nama biaya..."><select id="tgStudent" class="nui-input"><option value="">Semua siswa</option></select><select id="tgCandidate" class="nui-input"><option value="">Semua calon siswa</option></select><select id="tgYearAcademic" class="nui-input"><option value="">Semua tahun ajaran</option></select></div><div class="nui-toolbar"><input id="tgMonth" class="nui-input" type="number" min="1" max="12" placeholder="Bulan"><input id="tgYear" class="nui-input" type="number" min="2000" max="2200" placeholder="Tahun"><label><input id="tgUnpaid" type="checkbox"> Belum lunas/kedaluwarsa</label><label><input id="tgActive" type="checkbox" checked> Hanya aktif</label><select id="tgSize" class="nui-input"><option>20</option><option>50</option><option>100</option></select><button id="tgRefresh" class="nui-btn"><i class="fa-solid fa-magnifying-glass"></i> Terapkan</button></div>
 <div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Siswa / Calon</th><th>Biaya</th><th>Periode</th><th>Status</th><th>Nominal</th><th>Denda</th><th>Informasi</th><th>Aktif</th><th>Aksi</th></tr></thead><tbody id="tgRows"><tr><td colspan="9">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="tgPrev" class="nui-btn">← Sebelumnya</button><span id="tgPage">Halaman 1</span><button id="tgNext" class="nui-btn">Berikutnya →</button></div></article>
</section>
<div id="tgModal" class="tg-modal" role="dialog" aria-modal="true"><div class="tg-dialog"><div class="tg-dialog-head"><h2 id="tgModalTitle">Detail</h2><button id="tgModalClose" class="nui-btn" aria-label="Tutup">×</button></div><div id="tgModalBody"></div></div></div>
<script>(function(){var root=document.getElementById('nuiBills'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canU=root.dataset.update==='true',canD=root.dataset.delete==='true',page=0,total=0,last=[],loadedOptions=false,money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function values(p,z){return{q:tgSearch.value,fee:tgFee.value,studentId:tgStudent.value,candidateId:tgCandidate.value,academicYear:tgYearAcademic.value,month:tgMonth.value,year:tgYear.value,unpaidOnly:tgUnpaid.checked,activeOnly:tgActive.checked,page:p==null?page:p,size:z||tgSize.value}}async function call(a,b,p){var o={credentials:'same-origin'},url=endpoint+'&action='+a;if(b){o.method='POST';o.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};o.body=new URLSearchParams(b)}else url+='&'+new URLSearchParams(p||values());var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}function option(select,items,placeholder){var keep=select.value;select.innerHTML='<option value="">'+placeholder+'</option>'+items.map(function(x){return'<option value="'+x.id+'">'+esc((x.code?x.code+' · ':'')+x.name)+'</option>'}).join('');select.value=keep}function setOptions(j){if(loadedOptions)return;option(tgStudent,j.students,'Semua siswa');option(tgCandidate,j.candidates,'Semua calon siswa');tgYearAcademic.innerHTML='<option value="">Semua tahun ajaran</option>'+j.academicYears.map(function(x){return'<option>'+esc(x)+'</option>'}).join('');loadedOptions=true}function row(x){var img=x.photo?'<img class="tg-photo" src="'+esc(x.photo)+'" alt="" onerror="this.style.display=\'none\'">':'<span class="tg-photo"></span>',status=x.settled?'<strong class="tg-status-paid">Lunas</strong>':'<strong class="tg-status-open">Belum</strong>',buttons='<button class="nui-btn tg-history" data-id="'+x.id+'" title="Riwayat"><i class="fa-solid fa-clock-rotate-left"></i></button>';if(x.canMove&&canD)buttons+='<button class="nui-btn tg-move" data-id="'+x.id+'" title="Pindah pembayaran"><i class="fa-solid fa-arrow-right-arrow-left"></i></button>';if(canD)buttons+='<button class="nui-btn tg-delete" data-id="'+x.id+'" title="Hapus"><i class="fa-solid fa-trash"></i></button>';return'<tr><td><div class="tg-person">'+img+'<div><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.code)+' · '+esc(x.school)+'</small></div></div></td><td><strong>'+esc(x.item)+'</strong>'+(x.installment&&x.installment>1?'<br><small>Cicilan ke-'+x.installment+'</small>':'')+'</td><td>'+esc(x.month||'-')+'/'+esc(x.year||'-')+'<br><small>'+esc(x.academicYear)+'</small></td><td>'+status+'<br><small>Terbayar '+money.format(x.paid)+'</small></td><td><strong>'+money.format(x.nominal)+'</strong></td><td>'+money.format(x.fine)+'</td><td>'+esc(x.information)+'</td><td>'+(x.canToggle&&canU?'<label class="tg-switch"><input class="tg-toggle" data-id="'+x.id+'" type="checkbox" '+(x.active?'checked':'')+'> '+(x.active?'Ya':'Tidak')+'</label>':(x.active?'Ya':'Tidak'))+'</td><td><div class="tg-actions">'+buttons+'</div></td></tr>'}async function load(){try{tgRows.innerHTML='<tr><td colspan="9">Memuat data...</td></tr>';var j=await call('list');last=j.rows;total=j.total;setOptions(j);tgSync.style.display=j.syncEnabled?'':'none';tgRows.innerHTML=j.rows.map(row).join('')||'<tr><td colspan="9">Tidak ada tagihan sesuai filter.</td></tr>';tgTotal.textContent=j.total;tgPaid.textContent=j.rows.filter(function(x){return x.settled}).length;tgOpen.textContent=j.rows.filter(function(x){return!x.settled}).length;tgAmount.textContent=money.format(j.rows.reduce(function(n,x){return n+x.nominal+x.fine},0));tgPage.textContent='Halaman '+(page+1);tgPrev.disabled=page===0;tgNext.disabled=(page+1)*Number(tgSize.value)>=total}catch(e){tgRows.innerHTML='<tr><td colspan="9">'+esc(e.message)+'</td></tr>'}}function modal(title,html){tgModalTitle.textContent=title;tgModalBody.innerHTML=html;tgModal.classList.add('open')}tgModalClose.onclick=function(){tgModal.classList.remove('open')};tgModal.onclick=function(e){if(e.target===tgModal)tgModal.classList.remove('open')};tgRefresh.onclick=function(){page=0;load()};tgPrev.onclick=function(){if(page){page--;load()}};tgNext.onclick=function(){page++;load()};tgSize.onchange=function(){page=0;load()};var timer;[tgSearch,tgFee].forEach(function(x){x.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},350)}});[tgStudent,tgCandidate,tgYearAcademic,tgMonth,tgYear,tgUnpaid,tgActive].forEach(function(x){x.onchange=function(){if(x===tgStudent&&x.value)tgCandidate.value='';if(x===tgCandidate&&x.value)tgStudent.value='';page=0;load()}});tgGenerate.onclick=function(){if(!tgStudent.value){alert('Pilih satu siswa terlebih dahulu.');return}if(confirm('Bentuk seluruh tagihan bulanan yang belum ada untuk siswa terpilih?'))call('generate',{studentId:tgStudent.value}).then(function(j){alert((j.generated||0)+' tagihan baru dibentuk.');load()}).catch(function(e){alert(e.message)})};tgSync.onclick=function(){if(confirm('Sinkronkan seluruh tagihan sesuai filter aktif?'))call('sync',values()).then(function(j){alert((j.synchronized||0)+' tagihan disinkronkan.');load()}).catch(function(e){alert(e.message)})};tgRows.onclick=async function(e){var b=e.target.closest('button');if(!b)return;var id=b.dataset.id;try{if(b.classList.contains('tg-delete')){if(confirm('Hapus tagihan ini? Relasi database dapat menolak bila data masih dipakai.')){await call('delete',{id:id});load()}}else if(b.classList.contains('tg-move')){var j=await call('move_targets',null,{id:id}),opts=j.targets.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('');modal('Pindahkan Pembayaran',j.targets.length?'<p>Pilih tagihan tujuan yang belum lunas.</p><select id="tgMoveTarget" class="nui-input">'+opts+'</select><div style="height:12px"></div><button id="tgMoveSave" class="nui-btn nui-btn-primary">Pindahkan</button>':'<p>Tidak ada tagihan tujuan yang memenuhi syarat.</p>');var save=document.getElementById('tgMoveSave');if(save)save.onclick=async function(){if(confirm('Yakin memindahkan relasi pembayaran?')){await call('move',{id:id,targetId:tgMoveTarget.value});tgModal.classList.remove('open');load()}}}else if(b.classList.contains('tg-history')){var h=await call('history',null,{id:id}),html='<div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Revisi</th><th>Waktu</th><th>Oleh</th><th>Perubahan</th><th>Nilai</th></tr></thead><tbody>'+h.history.map(function(x){return'<tr><td>#'+x.revision+' · '+(['Ubah','Tambah','Hapus'][x.type]||x.type)+'</td><td>'+(x.timestamp?new Date(x.timestamp).toLocaleString('id-ID'):'-')+'</td><td>'+esc(x.by)+'</td><td>'+esc(x.information)+'</td><td>'+money.format(x.nominal)+'<br><small>Denda '+money.format(x.fine)+'</small></td></tr>'}).join('')+'</tbody></table></div>';modal('Riwayat Tagihan',html)}}catch(x){alert(x.message)}};tgRows.onchange=function(e){if(e.target.classList.contains('tg-toggle')){var old=!e.target.checked;call('toggle',{id:e.target.dataset.id,active:e.target.checked}).then(load).catch(function(x){e.target.checked=old;alert(x.message)})}};tgExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,values(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['code','name','school','item','month','year','academicYear','settled','nominal','fine','paid','active','information'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='tagihan-siswa.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};load()})();</script>

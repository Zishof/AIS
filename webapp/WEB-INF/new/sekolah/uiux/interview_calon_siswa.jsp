<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %>
<%!private String ivH(Object v){if(v==null)return "";return String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String ivToken(){SecureRandom r=new SecureRandom();byte[]b=new byte[24];r.nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%>
<%String ivCsrf=(String)session.getAttribute("newUiCsrfToken");if(ivCsrf==null){ivCsrf=ivToken();session.setAttribute("newUiCsrfToken",ivCsrf);}NewUiPermission ivP=NewUiRouteGuard.permissionFor(request,"sekolah","interview_calon_siswa");boolean ivC=ivP!=null&&ivP.isCanCreate(),ivU=ivP!=null&&ivP.isCanUpdate(),ivD=ivP!=null&&ivP.isCanDelete();String ivMenu=request.getParameter("menuId"),ivEndpoint=request.getContextPath()+"/new?service=1&module=sekolah&page=interview_calon_siswa"+(ivMenu==null?"":"&menuId="+ivH(ivMenu));%>
<section class="nui-page" id="ivPage" data-endpoint="<%=ivH(ivEndpoint)%>" data-csrf="<%=ivH(ivCsrf)%>" data-create="<%=ivC%>" data-update="<%=ivU%>" data-delete="<%=ivD%>">
 <header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">eSchool / PSB / Interview Calon Siswa</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-comments"></i> WORKFLOW NATIVE</p><h1>Sesi Wawancara Calon Siswa</h1><p>Kelola jadwal, pewawancara, platform konferensi, kapasitas, dan peserta sesuai sekolah aktif.</p></div><button id="ivAdd" class="nui-btn nui-btn-hero" type="button" <%=ivC?"":"disabled"%>><i class="fa-solid fa-plus"></i> Buat Sesi</button></header>
 <article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="ivSearch" class="nui-input" type="search" placeholder="Cari sesi, TA, pewawancara, gelombang..."><select id="ivWaveFilter" class="nui-input"><option value="">Semua gelombang</option></select><span id="ivCount" class="nui-chip">0 sesi</span></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Sesi</th><th>Jadwal</th><th>Pewawancara</th><th>Gelombang</th><th>Peserta</th><th>Konferensi</th><th>Aksi</th></tr></thead><tbody id="ivRows"><tr><td colspan="7">Memuat data...</td></tr></tbody></table></div></article>
 <dialog id="ivSessionDialog" class="nui-dialog"><form id="ivSessionForm" method="dialog"><input type="hidden" name="id"><header><h2 id="ivSessionTitle">Sesi Wawancara</h2></header><div class="nui-form-grid"><label class="nui-field">Nama sesi *<input class="nui-input" name="name" required></label><label class="nui-field">Tahun ajaran<input class="nui-input" name="academicYear" maxlength="9" placeholder="2026/2027"></label><label class="nui-field">Mulai *<input class="nui-input" type="datetime-local" name="start" required></label><label class="nui-field">Selesai *<input class="nui-input" type="datetime-local" name="end" required></label><label class="nui-field">Platform<select class="nui-input" name="platform"><option value="0">Tatap Muka</option><option value="1">Jitsi Meet</option><option value="2">Google Meet</option><option value="3">Zoom</option><option value="4">BigBlueButton</option><option value="5">Skype</option><option value="6">WhatsApp</option><option value="7">Lainnya</option></select></label><label class="nui-field">Kapasitas<input class="nui-input" type="number" min="0" name="capacity"></label><label class="nui-field">Pewawancara<select class="nui-input" name="employeeId"><option value="">Belum ditentukan</option></select></label><label class="nui-field">Gelombang PSB<select class="nui-input" name="waveId"><option value="">Semua gelombang</option></select></label><label class="nui-field">Link Zoom<input class="nui-input" name="zoom"></label><label class="nui-field">Link BigBlueButton<input class="nui-input" name="bbb"></label><label class="nui-field">Link Skype<input class="nui-input" name="skype"></label><label class="nui-field">No./Link WhatsApp<input class="nui-input" name="wa"></label><label class="nui-field" style="grid-column:1/-1">Link Google Meet / lainnya<input class="nui-input" name="other"></label><label class="nui-field" style="grid-column:1/-1">Keterangan<textarea class="nui-input" name="note" rows="3"></textarea></label></div><footer><button class="nui-btn" type="button" data-close="ivSessionDialog">Batal</button><button class="nui-btn nui-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Simpan</button></footer></form></dialog>
 <dialog id="ivParticipantDialog" class="nui-dialog"><form id="ivParticipantForm" method="dialog"><input type="hidden" name="sessionId"><header><h2 id="ivParticipantTitle">Peserta Wawancara</h2></header><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Calon Siswa</th><th>No. Registrasi</th><th>Waktu Khusus</th><th>Siap</th><th>Catatan</th><th>Aksi</th></tr></thead><tbody id="ivParticipantRows"></tbody></table></div><h3>Tambah Peserta</h3><div class="nui-form-grid"><label class="nui-field">No. registrasi *<input class="nui-input" name="registration" required></label><label class="nui-field">Mulai khusus<input class="nui-input" type="datetime-local" name="start"></label><label class="nui-field">Selesai khusus<input class="nui-input" type="datetime-local" name="end"></label><label class="nui-field">Catatan<input class="nui-input" name="note"></label></div><footer><button class="nui-btn" type="button" data-close="ivParticipantDialog">Tutup</button><button class="nui-btn nui-btn-primary" type="submit" <%=ivC?"":"disabled"%>><i class="fa-solid fa-user-plus"></i> Tambahkan</button></footer></form></dialog>
</section>
<script>(function(){var root=document.getElementById('ivPage'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canCreate=root.dataset.create==='true',canUpdate=root.dataset.update==='true',canDelete=root.dataset.delete==='true',data={sessions:[],employees:[],waves:[]},selected=null,platforms=['Tatap Muka','Jitsi Meet','Google Meet','Zoom','BigBlueButton','Skype','WhatsApp','Lainnya'];function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function local(v){if(!v)return'';var d=new Date(v),p=function(x){return String(x).padStart(2,'0')};return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes())}function display(v){return v?new Date(v).toLocaleString('id-ID'):'-'}function safeLink(v){return /^https?:\/\//i.test(v||'')?v:''}function opts(rows,selected){return rows.map(function(o){return'<option value="'+o.id+'"'+(String(o.id)===String(selected)?' selected':'')+'>'+esc(o.label)+'</option>'}).join('')}function paintOptions(){document.getElementById('ivWaveFilter').innerHTML='<option value="">Semua gelombang</option>'+opts(data.waves,'');document.querySelector('[name=employeeId]').innerHTML='<option value="">Belum ditentukan</option>'+opts(data.employees,'');document.querySelector('[name=waveId]').innerHTML='<option value="">Semua gelombang</option>'+opts(data.waves,'')}function paint(){var q=document.getElementById('ivSearch').value.toLowerCase(),wave=document.getElementById('ivWaveFilter').value,rows=data.sessions.filter(function(r){return(!wave||String(r.waveId)===wave)&&[r.name,r.academicYear,r.employee,r.wave].join(' ').toLowerCase().indexOf(q)>=0});document.getElementById('ivRows').innerHTML=rows.map(function(r){var link=safeLink(r.conference),cap=r.capacity>0?r.participantCount+' / '+r.capacity:r.participantCount;return'<tr><td><strong>'+esc(r.name)+'</strong><br><small>'+esc(r.academicYear)+'</small></td><td>'+display(r.start)+'<br>'+display(r.end)+'</td><td>'+esc(r.employee)+'</td><td>'+esc(r.wave)+'</td><td><button class="nui-btn iv-participants" data-id="'+r.id+'" type="button"><i class="fa-solid fa-users"></i> '+cap+'</button></td><td>'+(link?'<a class="nui-btn" target="_blank" rel="noopener" href="'+esc(link)+'"><i class="fa-solid fa-video"></i> '+platforms[r.platform]+'</a>':esc(platforms[r.platform]))+'</td><td>'+(canUpdate?'<button class="nui-btn iv-edit" data-id="'+r.id+'" type="button"><i class="fa-solid fa-pen"></i></button> ':'')+(canDelete?'<button class="nui-btn iv-delete" data-id="'+r.id+'" type="button"><i class="fa-solid fa-trash"></i></button>':'')+'</td></tr>'}).join('')||'<tr><td colspan="7">Tidak ada sesi yang cocok.</td></tr>';document.getElementById('ivCount').textContent=rows.length+' sesi'}async function call(action,body){var opt={credentials:'same-origin'};if(body){opt.method='POST';opt.headers={'X-CSRF-Token':csrf,'Content-Type':'application/x-www-form-urlencoded'};opt.body=new URLSearchParams(body)}var r=await fetch(endpoint+'&action='+action,opt),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');data=j;paintOptions();paint();return j}function openSession(r){var f=document.getElementById('ivSessionForm');f.reset();Array.from(f.elements).forEach(function(e){if(e.name&&r&&Object.prototype.hasOwnProperty.call(r,e.name))e.value=r[e.name]==null?'':r[e.name]});f.id.value=r?r.id:'';f.start.value=r?local(r.start):'';f.end.value=r?local(r.end):'';f.employeeId.value=r&&r.employeeId?r.employeeId:'';f.waveId.value=r&&r.waveId?r.waveId:'';document.getElementById('ivSessionTitle').textContent=r?'Edit Sesi Wawancara':'Buat Sesi Wawancara';document.getElementById('ivSessionDialog').showModal()}function openParticipants(r){selected=r;document.getElementById('ivParticipantForm').reset();document.querySelector('[name=sessionId]').value=r.id;document.getElementById('ivParticipantTitle').textContent='Peserta: '+r.name;document.getElementById('ivParticipantRows').innerHTML=(r.participants||[]).map(function(p){return'<tr><td>'+esc(p.name)+'</td><td>'+esc(p.registration)+'</td><td>'+display(p.start)+'<br>'+display(p.end)+'</td><td>'+(p.ready?'Ya':'Belum')+'</td><td>'+esc(p.note)+'</td><td>'+(canDelete?'<button class="nui-btn iv-remove" data-id="'+p.id+'" type="button"><i class="fa-solid fa-trash"></i></button>':'')+'</td></tr>'}).join('')||'<tr><td colspan="6">Belum ada peserta.</td></tr>';document.getElementById('ivParticipantDialog').showModal()}document.getElementById('ivAdd').onclick=function(){openSession(null)};document.getElementById('ivRows').onclick=function(e){var b=e.target.closest('button');if(!b)return;var r=data.sessions.find(function(x){return String(x.id)===b.dataset.id});if(b.classList.contains('iv-edit'))openSession(r);if(b.classList.contains('iv-participants'))openParticipants(r);if(b.classList.contains('iv-delete')&&confirm('Hapus sesi dan seluruh pesertanya?'))call('delete_session',{id:r.id}).catch(function(x){alert(x.message)})};document.getElementById('ivSessionForm').onsubmit=function(e){e.preventDefault();call('save_session',Object.fromEntries(new FormData(e.target))).then(function(){document.getElementById('ivSessionDialog').close()}).catch(function(x){alert(x.message)})};document.getElementById('ivParticipantForm').onsubmit=function(e){e.preventDefault();call('add_participant',Object.fromEntries(new FormData(e.target))).then(function(){document.getElementById('ivParticipantDialog').close()}).catch(function(x){alert(x.message)})};document.getElementById('ivParticipantRows').onclick=function(e){var b=e.target.closest('.iv-remove');if(b&&confirm('Hapus peserta dari sesi ini?'))call('remove_participant',{id:b.dataset.id}).then(function(){document.getElementById('ivParticipantDialog').close()}).catch(function(x){alert(x.message)})};document.querySelectorAll('[data-close]').forEach(function(b){b.onclick=function(){document.getElementById(b.dataset.close).close()}});document.getElementById('ivSearch').oninput=paint;document.getElementById('ivWaveFilter').onchange=paint;call('list').catch(function(x){document.getElementById('ivRows').innerHTML='<tr><td colspan="7">'+esc(x.message)+'</td></tr>'})})();</script>

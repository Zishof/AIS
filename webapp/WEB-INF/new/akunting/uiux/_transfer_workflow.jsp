<style>.tw-tabs{display:flex;gap:8px;flex-wrap:wrap}.tw-tab[aria-selected=true]{background:#2563eb;color:#fff}.tw-hidden{display:none!important}.tw-kpis{display:grid;grid-template-columns:repeat(5,minmax(120px,1fr));gap:10px;margin:14px 0}.tw-kpis strong{display:block;font-size:1.55rem;margin-top:4px}.tw-filter-grid{display:grid;grid-template-columns:minmax(220px,2fr) repeat(3,minmax(140px,1fr));gap:8px}.tw-checks{display:flex;gap:12px;flex-wrap:wrap;padding-top:10px}.tw-process{margin-top:10px;border:1px solid #dbe3ef;border-radius:12px;padding:14px}.tw-process-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.tw-actions{display:flex;gap:6px;flex-wrap:wrap}.tw-dialog{border:0;border-radius:16px;box-shadow:0 24px 70px #0f172a55;max-width:850px;width:calc(100% - 30px)}.tw-dialog::backdrop{background:#0f172a88}.tw-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tw-form label{display:grid;gap:5px}.tw-span{grid-column:1/-1}.tw-status{font-size:.75rem;font-weight:700;padding:3px 8px;border-radius:999px;background:#e8f0ff;color:#2456ba}.tw-toast{position:fixed;right:24px;bottom:24px;z-index:9999;background:#0f172a;color:#fff;padding:12px 16px;border-radius:10px;max-width:420px}.tw-item-pick{max-height:320px;overflow:auto;border:1px solid #dbe3ef;border-radius:10px;padding:8px}.tw-item-pick label{display:flex;gap:8px;padding:7px;border-bottom:1px solid #eef2f7}@media(max-width:900px){.tw-kpis{grid-template-columns:repeat(2,1fr)}.tw-filter-grid,.tw-form{grid-template-columns:1fr}.tw-span{grid-column:auto}.tw-process-head{display:block}.tw-actions{margin-top:10px}}</style>
<section class="nui-page" id="twRoot" data-endpoint="<%=twH(twEndpoint)%>" data-csrf="<%=twH(twCsrf)%>" data-tab="<%=twH(twTab)%>" data-user="<%=twH(twUser)%>" data-create="<%=twP.isCanCreate()%>" data-update="<%=twP.isCanUpdate()%>" data-delete="<%=twP.isCanDelete()%>" data-approve="<%=twP.isCanApprove()%>" data-reject="<%=twP.isCanReject()%>">
 <header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Akuntansi / Transfer</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-money-bill-transfer"></i> WORKFLOW TRANSFER</p><h1>Pengajuan &amp; Proses Transfer</h1><p>Monitor sumber terotorisasi, ajukan pembayaran, setujui, realisasikan, arahkan ke transfer/transitori, dan kelola cara transfer.</p></div><div class="tw-actions"><button id="twSync" class="nui-btn nui-btn-hero" <%=twP.isCanUpdate()?"":"disabled"%>><i class="fa-solid fa-arrows-rotate"></i> Sinkronkan</button><button id="twExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-excel"></i> Ekspor</button></div></header>
 <nav class="tw-tabs nui-card" style="margin-top:14px;padding:10px" aria-label="Bagian workflow"><button class="nui-btn tw-tab" data-tab="dashboard">Dasbor</button><button class="nui-btn tw-tab" data-tab="requests">Daftar Transfer</button><button class="nui-btn tw-tab" data-tab="processes">Proses Transfer</button><button class="nui-btn tw-tab" data-tab="transitory">Transitori</button><button class="nui-btn tw-tab" data-tab="methods">Cara Transfer</button></nav>
 <div class="tw-kpis"><article class="nui-card"><small>Belum Diproses</small><strong id="twWaiting">0</strong></article><article class="nui-card"><small>Sudah Diajukan</small><strong id="twSubmitted">0</strong></article><article class="nui-card"><small>Transitori</small><strong id="twTransitory">0</strong></article><article class="nui-card"><small>Sudah Transfer</small><strong id="twTransferred">0</strong></article><article class="nui-card"><small>Total Nominal</small><strong id="twAmount">Rp0</strong></article></div>
 <article class="nui-card" style="padding:12px;margin-bottom:14px"><div class="tw-filter-grid"><input id="twSearch" class="nui-input" type="search" placeholder="Cari kode, nama, keterangan..."><input id="twStart" class="nui-input" type="date"><input id="twEnd" class="nui-input" type="date"><select id="twWorkUnit" class="nui-input"><option value="">Semua satuan kerja</option></select></div><div class="tw-checks"><label><input id="twActive" type="checkbox" checked> Aktif</label><label><input class="tw-status-filter" data-key="waiting" type="checkbox"> Belum</label><label><input class="tw-status-filter" data-key="submitted" type="checkbox"> Diajukan</label><label><input class="tw-status-filter" data-key="transitory" type="checkbox"> Transitori</label><label><input class="tw-status-filter" data-key="transferred" type="checkbox"> Transfer</label><details><summary>Filter jenis</summary><div class="tw-checks"><label><input class="tw-kind" data-key="advance" type="checkbox"> Uang Muka</label><label><input class="tw-kind" data-key="accountability" type="checkbox"> LPJ</label><label><input class="tw-kind" data-key="bigCash" type="checkbox"> Kas Besar</label><label><input class="tw-kind" data-key="smallCash" type="checkbox"> Kas Kecil</label><label><input class="tw-kind" data-key="procurement" type="checkbox"> Pengadaan</label><label><input class="tw-kind" data-key="termin" type="checkbox"> Termin</label><label><input class="tw-kind" data-key="downPayment" type="checkbox"> DP</label><label><input class="tw-kind" data-key="tax" type="checkbox"> Pajak</label><label><input class="tw-kind" data-key="employee" type="checkbox"> Pegawai</label><label><input class="tw-kind" data-key="cooperative" type="checkbox"> Koperasi</label></div></details></div></article>
 <section id="twDashboard" class="tw-panel"><div class="nui-card" style="padding:18px"><h2>Ringkasan Proses</h2><p>Angka mengikuti filter aktif dan seluruh sumber transfer yang lolos gating existing.</p><div id="twBars"></div><h3 style="margin-top:18px">Ringkasan Jenis</h3><div id="twKinds" class="tw-kpis"></div></div></section>
 <section id="twRequests" class="tw-panel"><div class="nui-card"><div class="nui-toolbar"><button id="twNewProcess" class="nui-btn nui-btn-primary" <%=twP.isCanCreate()?"":"disabled"%>><i class="fa-solid fa-plus"></i> Buat Proses dari Pilihan</button><span id="twSelected">0 dipilih</span></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th></th><th>Pengajuan</th><th>Waktu / Unit</th><th>Akun &amp; Rekening</th><th>Nominal</th><th>Status</th><th>Keterangan</th><th>SOP</th></tr></thead><tbody id="twRows"><tr><td colspan="8">Memuat...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="twPrev" class="nui-btn">← Sebelumnya</button><span id="twPage">Halaman 1</span><button id="twNext" class="nui-btn">Berikutnya →</button></div></div></section>
 <section id="twProcesses" class="tw-panel"><div class="nui-toolbar nui-card"><button id="twOpenProcess" class="nui-btn nui-btn-primary" <%=twP.isCanCreate()?"":"disabled"%>><i class="fa-solid fa-plus"></i> Tambah Proses Transfer</button><button id="twRefreshProcesses" class="nui-btn"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button></div><div id="twProcessRows"><div class="nui-card">Memuat...</div></div></section>
 <section id="twTransitoryPanel" class="tw-panel"><div class="nui-card" style="padding:18px"><h2>Monitoring Transitori</h2><p>Item berstatus transitori ditampilkan dari data workflow yang sama; ubah status tujuan dari detail proses setelah realisasi.</p><div id="twTransitoryRows"></div></div></section>
 <section id="twMethods" class="tw-panel"><div class="nui-card"><div class="nui-toolbar"><input id="twMethodSearch" class="nui-input" type="search" placeholder="Cari cara transfer..."><button id="twAddMethod" class="nui-btn nui-btn-primary" <%=twP.isCanCreate()?"":"disabled"%>><i class="fa-solid fa-plus"></i> Tambah Cara Transfer</button></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Kode</th><th>Nama</th><th>Akun Utama</th><th>Akun Transitori</th><th>Satuan Kerja</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="twMethodRows"></tbody></table></div></div></section>
</section>
<dialog id="twProcessDialog" class="tw-dialog"><form method="dialog"><div class="tw-process-head"><h2 id="twProcessTitle">Buat Proses Transfer</h2><button class="nui-btn">✕</button></div></form><form id="twProcessForm" class="tw-form"><input id="twProcessId" type="hidden"><label>Judul Transfer *<input id="twProcessName" class="nui-input" required></label><label>Tanggal Pengajuan *<input id="twProcessDate" class="nui-input" type="date" required></label><label class="tw-span">Cara Transfer *<select id="twProcessMethod" class="nui-input" required></select></label><label class="tw-span">Keterangan<textarea id="twProcessNote" class="nui-input" rows="3"></textarea></label><div class="tw-span"><strong>Daftar Transfer</strong><div id="twItemPick" class="tw-item-pick"></div></div><div class="tw-span tw-actions"><button class="nui-btn nui-btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Simpan / Ajukan</button><button class="nui-btn" type="button" onclick="twProcessDialog.close()">Batal</button></div></form></dialog>
<dialog id="twMethodDialog" class="tw-dialog"><form method="dialog"><div class="tw-process-head"><h2>Cara Transfer</h2><button class="nui-btn">✕</button></div></form><form id="twMethodForm" class="tw-form"><input id="twMethodId" type="hidden"><label>Kode<input id="twMethodCode" class="nui-input"></label><label>Nama *<input id="twMethodName" class="nui-input" required></label><label class="tw-span">Deskripsi<textarea id="twMethodDescription" class="nui-input"></textarea></label><label>Akun Utama *<select id="twMethodAccount" class="nui-input" required></select></label><label>Akun Transitori<select id="twMethodTransitory" class="nui-input"></select></label><label>Satuan Kerja<select id="twMethodWorkUnit" class="nui-input"></select></label><div><label><input id="twMethodActive" type="checkbox" checked> Aktif</label><label><input id="twMethodDefault" type="checkbox"> Jadikan default</label></div><div class="tw-span tw-actions"><button class="nui-btn nui-btn-primary" type="submit">Simpan</button><button class="nui-btn" type="button" onclick="twMethodDialog.close()">Batal</button></div></form></dialog><div id="twToast" class="tw-toast tw-hidden" role="status"></div>
<script>(function(){
var root=document.getElementById('twRoot'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,currentUser=root.dataset.user,canC=root.dataset.create==='true',canU=root.dataset.update==='true',canD=root.dataset.delete==='true',canA=root.dataset.approve==='true',canR=root.dataset.reject==='true',page=0,size=20,total=0,rows=[],processRows=[],methods=[],options={methods:[],accounts:[],workUnits:[]},selected={},activeTab=root.dataset.tab||'requests',money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function toast(v,bad){twToast.textContent=v;twToast.style.background=bad?'#991b1b':'#0f172a';twToast.classList.remove('tw-hidden');setTimeout(function(){twToast.classList.add('tw-hidden')},4500)}function status(v){return{WAITING:'Belum diproses',SUBMITTED:'Sudah diajukan',TRANSITORY:'Transitori',TRANSFERRED:'Sudah transfer',REALIZED:'Terealisasi',WAITING_APPROVAL:'Menunggu persetujuan',APPROVED:'Disetujui'}[v]||v}function qparams(p,z){var x={q:twSearch.value,start:twStart.value,end:twEnd.value,workUnitId:twWorkUnit.value,active:twActive.checked,page:p==null?page:p,size:z||size};document.querySelectorAll('.tw-status-filter,.tw-kind').forEach(function(e){x[e.dataset.key]=e.checked});return x}async function call(action,data,params){var o={credentials:'same-origin'},url=endpoint+'&action='+action;if(data){o.method='POST';o.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};o.body=new URLSearchParams(data)}else url+='&'+new URLSearchParams(params||qparams());var r=await fetch(url,o),j=await r.json();if(!r.ok||j.ok===false)throw new Error(j.message||'Operasi gagal');return j}
function switchTab(tab){activeTab=tab;document.querySelectorAll('.tw-panel').forEach(function(x){x.classList.add('tw-hidden')});document.querySelectorAll('.tw-tab').forEach(function(x){x.setAttribute('aria-selected',x.dataset.tab===tab)});var ids={dashboard:'twDashboard',requests:'twRequests',processes:'twProcesses',transitory:'twTransitoryPanel',methods:'twMethods'};document.getElementById(ids[tab]).classList.remove('tw-hidden');if(tab==='processes')loadProcesses();if(tab==='methods')loadMethods();if(tab==='transitory')renderTransitory()}
function renderRows(){twRows.innerHTML=rows.map(function(x){var disabled=x.status!=='WAITING';return'<tr><td><input class="tw-pick" type="checkbox" data-id="'+x.id+'" '+(selected[x.id]?'checked':'')+' '+(disabled?'disabled':'')+'></td><td><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.code)+'</small> <span class="tw-status">'+esc(x.kind)+'</span></td><td>'+esc(x.time||'-')+'<br><small>'+esc(x.workUnit)+'</small></td><td>'+esc(x.account)+'<br><small>'+esc(x.bank)+' · '+esc(x.accountName)+' · '+esc(x.accountNumber)+'</small></td><td><strong>'+money.format(x.amount)+'</strong></td><td><span class="tw-status">'+esc(status(x.status))+'</span><br><small>'+esc(x.processCode)+'</small></td><td><textarea class="nui-input tw-note" data-id="'+x.id+'" '+(!canU?'disabled':'')+'>'+esc(x.note)+'</textarea></td><td>'+(x.sopId?'<span title="'+esc(x.sop)+'">SOP #'+x.sopId+'</span>':'-')+'</td></tr>'}).join('')||'<tr><td colspan="8">Tidak ada data.</td></tr>';twPage.textContent='Halaman '+(page+1);twPrev.disabled=page===0;twNext.disabled=(page+1)*size>=total;twSelected.textContent=Object.keys(selected).length+' dipilih';renderDashboard()}
function renderDashboard(){var counts={},amounts={};rows.forEach(function(x){counts[x.kind]=(counts[x.kind]||0)+1;amounts[x.kind]=(amounts[x.kind]||0)+x.amount});twKinds.innerHTML=Object.keys(counts).sort().map(function(k){return'<article class="nui-card"><small>'+esc(k)+'</small><strong>'+counts[k]+'</strong><small>'+money.format(amounts[k])+'</small></article>'}).join('')||'<p>Tidak ada data pada halaman ini.</p>';var vals=[['Belum',+twWaiting.textContent],['Diajukan',+twSubmitted.textContent],['Transitori',+twTransitory.textContent],['Transfer',+twTransferred.textContent]],max=Math.max.apply(null,vals.map(function(x){return x[1]}).concat([1]));twBars.innerHTML=vals.map(function(x){return'<div style="margin:10px 0"><div>'+x[0]+' <strong>'+x[1]+'</strong></div><div style="height:10px;background:#e5e7eb;border-radius:8px"><div style="width:'+(x[1]*100/max)+'%;height:100%;background:#2563eb;border-radius:8px"></div></div></div>'}).join('')}
async function load(){try{var j=await call('list');rows=j.rows;total=j.total;twWaiting.textContent=j.waiting;twSubmitted.textContent=j.submitted;twTransitory.textContent=j.transitory;twTransferred.textContent=j.transferred;twAmount.textContent=money.format(j.amount);renderRows();if(activeTab==='transitory')renderTransitory()}catch(e){twRows.innerHTML='<tr><td colspan="8">'+esc(e.message)+'</td></tr>';toast(e.message,true)}}
function processHtml(x){var actions='<a class="nui-btn" target="_blank" href="'+endpoint+'&action=receipt&id='+x.id+'"><i class="fa-solid fa-print"></i> Cetak</a>';if(canU&&x.status==='WAITING_APPROVAL')actions+='<button class="nui-btn tw-edit-process" data-id="'+x.id+'">Edit</button><button class="nui-btn tw-add-selected" data-id="'+x.id+'">Tambah Pilihan</button><button class="nui-btn tw-action" data-action="set_process_active" data-id="'+x.id+'" data-active="'+(!x.active)+'">'+(x.active?'Nonaktifkan':'Aktifkan')+'</button>';if(canD&&x.status==='WAITING_APPROVAL')actions+='<button class="nui-btn tw-action" data-action="delete_process" data-id="'+x.id+'">Hapus</button>';if(canA&&x.status==='WAITING_APPROVAL')actions+='<button class="nui-btn tw-action" data-action="approve" data-id="'+x.id+'">Setujui</button>';if(canR&&x.status==='APPROVED')actions+='<button class="nui-btn tw-action" data-action="reject" data-id="'+x.id+'">Batalkan Persetujuan</button>';if(canA&&x.status==='APPROVED')actions+='<button class="nui-btn nui-btn-primary tw-action" data-action="realize" data-id="'+x.id+'">Realisasikan</button>';if(canR&&x.status==='REALIZED'&&x.realizedUserId===currentUser)actions+='<button class="nui-btn tw-action" data-action="cancel_realization" data-id="'+x.id+'">Batalkan Realisasi</button>';var items=x.items.map(function(y){var destination=x.status==='REALIZED'&&canU?'<select class="nui-input tw-destination" data-id="'+y.id+'"><option value="">Terealisasi</option><option value="transfer" '+(y.status==='TRANSFERRED'?'selected':'')+'>Transfer</option><option value="transitory" '+(y.status==='TRANSITORY'?'selected':'')+'>Transitori</option></select>':'';var remove=canU&&x.status==='WAITING_APPROVAL'?'<button class="nui-btn tw-remove" data-process="'+x.id+'" data-id="'+y.id+'">Lepas</button>':'';return'<tr><td>'+esc(y.code)+'<br><small>'+esc(y.name)+'</small></td><td>'+esc(y.kind)+'</td><td>'+money.format(y.amount)+'</td><td>'+destination+'</td><td>'+remove+'</td></tr>'}).join('');return'<article class="tw-process nui-card"><div class="tw-process-head"><div><strong>'+esc(x.code)+' · '+esc(x.title)+'</strong><br><small>'+esc(x.date)+' · '+esc(x.method)+' · '+esc(x.note)+'</small><p><span class="tw-status">'+esc(status(x.status))+'</span> '+money.format(x.amount)+(x.active?'':' · Nonaktif')+(x.approvedBy?' · Disetujui '+esc(x.approvedBy):'')+(x.realizedBy?' · Direalisasi '+esc(x.realizedBy):'')+'</p></div><div class="tw-actions">'+actions+'</div></div><details><summary>'+x.items.length+' daftar transfer</summary><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Pengajuan</th><th>Jenis</th><th>Nominal</th><th>Tujuan</th><th></th></tr></thead><tbody>'+items+'</tbody></table></div></details></article>'}
async function loadProcesses(){try{var j=await call('processes');processRows=j.rows;twProcessRows.innerHTML=j.rows.map(processHtml).join('')||'<div class="nui-card">Tidak ada proses transfer.</div>'}catch(e){twProcessRows.innerHTML='<div class="nui-card">'+esc(e.message)+'</div>';toast(e.message,true)}}
function renderTransitory(){var v=rows.filter(function(x){return x.status==='TRANSITORY'});twTransitoryRows.innerHTML=v.map(function(x){return'<article class="tw-process"><strong>'+esc(x.code)+' · '+esc(x.name)+'</strong><p>'+money.format(x.amount)+' · '+esc(x.bank)+' '+esc(x.accountNumber)+'</p></article>'}).join('')||'<p>Tidak ada data transitori pada filter/halaman ini.</p>'}
async function loadMethods(){try{var j=await call('payment_methods',null,{q:twMethodSearch.value,active:false});methods=j.rows;twMethodRows.innerHTML=methods.map(function(x){return'<tr><td>'+esc(x.code)+'</td><td><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.description)+'</small></td><td>'+esc(x.account)+'</td><td>'+esc(x.transitoryAccount)+'</td><td>'+esc(x.workUnit)+'</td><td>'+(x.defaultPayment?'<span class="tw-status">Default</span> ':'')+(x.active?'Aktif':'Nonaktif')+'</td><td><button class="nui-btn tw-edit-method" data-id="'+x.id+'">Edit</button> <button class="nui-btn tw-toggle-method" data-id="'+x.id+'" data-active="'+(!x.active)+'" '+(!canU?'disabled':'')+'>'+(x.active?'Nonaktifkan':'Aktifkan')+'</button></td></tr>'}).join('')||'<tr><td colspan="7">Tidak ada data.</td></tr>'}catch(e){toast(e.message,true)}}
function fillOptions(){function put(el,v,empty){el.innerHTML=(empty?'<option value="">'+empty+'</option>':'')+v.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('')}put(twProcessMethod,options.methods,'Pilih cara transfer');put(twMethodAccount,options.accounts,'Pilih akun');put(twMethodTransitory,options.accounts,'Tanpa akun transitori');put(twWorkUnit,options.workUnits,'Semua satuan kerja');put(twMethodWorkUnit,options.workUnits,'Global / semua unit')}
async function openProcess(ids){if(!canC)return;twProcessId.value='';twProcessName.value='';twProcessDate.value=new Date().toISOString().slice(0,10);twProcessNote.value='';twItemPick.innerHTML=rows.filter(function(x){return x.status==='WAITING'}).map(function(x){return'<label><input type="checkbox" value="'+x.id+'" '+(ids&&ids.indexOf(String(x.id))>=0?'checked':'')+'> <span><strong>'+esc(x.code)+'</strong> '+esc(x.name)+' · '+money.format(x.amount)+'</span></label>'}).join('')||'<p>Tidak ada pengajuan siap diproses pada halaman ini.</p>';twProcessDialog.showModal()}
function openMethod(x){x=x||{};twMethodId.value=x.id||'';twMethodCode.value=x.code||'';twMethodName.value=x.name||'';twMethodDescription.value=x.description||'';twMethodAccount.value=x.accountId||'';twMethodTransitory.value=x.transitoryAccountId||'';twMethodWorkUnit.value=x.workUnitId||'';twMethodActive.checked=x.id?x.active:true;twMethodDefault.checked=!!x.defaultPayment;twMethodDialog.showModal()}
function editProcess(x){twProcessId.value=x.id;twProcessName.value=x.title||'';twProcessDate.value=x.date||new Date().toISOString().slice(0,10);twProcessMethod.value=x.methodId||'';twProcessNote.value=x.note||'';twItemPick.innerHTML='<p>Gunakan tombol <strong>Tambah Pilihan</strong> atau <strong>Lepas</strong> untuk mengubah daftar transfer.</p>';twProcessDialog.showModal()}
document.querySelectorAll('.tw-tab').forEach(function(x){x.onclick=function(){switchTab(x.dataset.tab)}});var timer;twSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[twStart,twEnd,twWorkUnit,twActive].forEach(function(x){x.onchange=function(){page=0;load()}});document.querySelectorAll('.tw-status-filter,.tw-kind').forEach(function(x){x.onchange=function(){page=0;load()}});twPrev.onclick=function(){if(page){page--;load()}};twNext.onclick=function(){page++;load()};twRows.onchange=function(e){if(e.target.classList.contains('tw-pick')){if(e.target.checked)selected[e.target.dataset.id]=true;else delete selected[e.target.dataset.id];twSelected.textContent=Object.keys(selected).length+' dipilih'}if(e.target.classList.contains('tw-note'))call('save_note',{id:e.target.dataset.id,note:e.target.value}).then(function(){toast('Keterangan tersimpan.')}).catch(function(x){toast(x.message,true)})};twNewProcess.onclick=function(){openProcess(Object.keys(selected))};twOpenProcess.onclick=function(){openProcess([])};twRefreshProcesses.onclick=loadProcesses;
twProcessRows.onclick=function(e){var b=e.target.closest('.tw-action,.tw-remove,.tw-edit-process,.tw-add-selected');if(!b)return;if(b.classList.contains('tw-remove')){if(confirm('Lepaskan pengajuan dari proses ini?'))call('remove_item',{processId:b.dataset.process,itemId:b.dataset.id}).then(loadProcesses).catch(function(x){toast(x.message,true)});return}var process=processRows.filter(function(x){return String(x.id)===b.dataset.id})[0];if(b.classList.contains('tw-edit-process')){editProcess(process);return}if(b.classList.contains('tw-add-selected')){var ids=Object.keys(selected);if(!ids.length){toast('Pilih pengajuan berstatus Belum Diproses pada tab Daftar Transfer.',true);return}call('add_items',{processId:b.dataset.id,ids:ids.join(',')}).then(function(){selected={};toast('Pengajuan ditambahkan.');loadProcesses();load()}).catch(function(x){toast(x.message,true)});return}var data={id:b.dataset.id};if(b.dataset.action==='realize')data.date=prompt('Tanggal realisasi (YYYY-MM-DD)',new Date().toISOString().slice(0,10))||'';if(b.dataset.action==='set_process_active')data.active=b.dataset.active;if(confirm('Lanjutkan aksi '+b.textContent.trim()+'?'))call(b.dataset.action,data).then(function(){toast('Status berhasil diperbarui.');loadProcesses();load()}).catch(function(x){toast(x.message,true)})};twProcessRows.onchange=function(e){if(!e.target.classList.contains('tw-destination'))return;call('set_disposition',{id:e.target.dataset.id,transfer:e.target.value==='transfer',transitory:e.target.value==='transitory'}).then(function(){toast('Tujuan transfer diperbarui.');loadProcesses();load()}).catch(function(x){toast(x.message,true)})};
twProcessForm.onsubmit=function(e){e.preventDefault();var updating=!!twProcessId.value,itemIds=Array.prototype.slice.call(twItemPick.querySelectorAll('input:checked')).map(function(x){return+x.value}),payload={id:twProcessId.value||null,title:twProcessName.value,date:twProcessDate.value,methodId:+twProcessMethod.value,note:twProcessNote.value,itemIds:itemIds};call(updating?'update_process':'create_process',{payload:JSON.stringify(payload)}).then(function(j){twProcessDialog.close();selected={};toast('Proses transfer tersimpan.');if(!updating&&j.id)window.open(endpoint+'&action=receipt&id='+j.id,'_blank');load();switchTab('processes')}).catch(function(x){toast(x.message,true)})};
twAddMethod.onclick=function(){openMethod()};twMethodRows.onclick=function(e){var b=e.target.closest('.tw-edit-method,.tw-toggle-method');if(!b)return;var x=methods.filter(function(v){return String(v.id)===b.dataset.id})[0];if(b.classList.contains('tw-edit-method'))openMethod(x);else call('set_payment_method_active',{id:b.dataset.id,active:b.dataset.active}).then(loadMethods).catch(function(z){toast(z.message,true)})};twMethodForm.onsubmit=function(e){e.preventDefault();var p={id:twMethodId.value||null,code:twMethodCode.value,name:twMethodName.value,description:twMethodDescription.value,accountId:+twMethodAccount.value,transitoryAccountId:twMethodTransitory.value?+twMethodTransitory.value:null,workUnitId:twMethodWorkUnit.value?+twMethodWorkUnit.value:null,active:twMethodActive.checked,makeDefault:twMethodDefault.checked};call('save_payment_method',{payload:JSON.stringify(p)}).then(function(){twMethodDialog.close();toast('Cara transfer tersimpan.');return Promise.all([loadMethods(),loadOptions()])}).catch(function(x){toast(x.message,true)})};twMethodSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(loadMethods,300)};
twSync.onclick=function(){if(confirm('Sinkronkan 15 sumber pengajuan yang memenuhi persetujuan? Proses dapat memerlukan waktu.')){twSync.disabled=true;call('sync',{}).then(function(j){toast('Sinkron selesai: '+j.success+' berhasil, '+j.skipped+' dilewati, '+j.failed+' gagal.');load()}).catch(function(x){toast(x.message,true)}).then(function(){twSync.disabled=!canU})}};twExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,qparams(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['code','name','kind','time','workUnit','account','bank','accountName','accountNumber','amount','status','processCode','note'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='daftar-pengajuan-transfer.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){toast(e.message,true)}};
async function loadOptions(){var j=await call('options',null,{});options=j;fillOptions()}Promise.all([loadOptions(),load()]).then(function(){switchTab(activeTab)}).catch(function(e){toast(e.message,true)});
})();</script>

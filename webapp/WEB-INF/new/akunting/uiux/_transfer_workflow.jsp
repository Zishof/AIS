private String twH(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String twToken(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}
%><%
String twPage="daftar_pengajuan_transfer";String twTab=String.valueOf(request.getAttribute("transferInitialTab"));if("processes".equals(twTab))twPage="proses_transfer";else if("methods".equals(twTab))twPage="cara_pembayaran_transfer";
String twCsrf=(String)session.getAttribute("newUiCsrfToken");if(twCsrf==null){twCsrf=twToken();session.setAttribute("newUiCsrfToken",twCsrf);}NewUiPermission twP=NewUiRouteGuard.permissionFor(request,"akunting",twPage);if(twP==null)twP=NewUiPermission.none();String twMenu=request.getParameter("menuId");String twEndpoint=request.getContextPath()+"/new?service=1&module=akunting&page="+twPage+(twMenu==null?"":"&menuId="+twH(twMenu));String twUser=ais.common.Common.getCurrentUser(request)==null?"":ais.common.Common.getCurrentUser(request).getUserId();

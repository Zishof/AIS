<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String trH(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String trToken(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String trCsrf=(String)session.getAttribute("newUiCsrfToken");if(trCsrf==null){trCsrf=trToken();session.setAttribute("newUiCsrfToken",trCsrf);}NewUiPermission trP=NewUiRouteGuard.permissionFor(request,"akunting","transitori");boolean trU=trP!=null&&trP.isCanUpdate();String trMenu=request.getParameter("menuId"),trEndpoint=request.getContextPath()+"/new?service=1&module=akunting&page=transitori"+(trMenu==null?"":"&menuId="+trH(trMenu));%>
<section class="nui-page" id="nuiTransitory" data-endpoint="<%=trH(trEndpoint)%>" data-csrf="<%=trH(trCsrf)%>" data-update="<%=trU%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Akuntansi / Transitori</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-building-columns"></i> TRANSFER MONITOR</p><h1>Monitoring Transitori</h1><p>Pantau pengajuan, proses transfer, rekening sumber, SOP, dan status realisasi keuangan.</p></div><div style="display:flex;gap:8px"><button id="trExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-excel"></i> Ekspor</button><button id="trRepair" class="nui-btn nui-btn-hero" <%=trU?"":"disabled"%>><i class="fa-solid fa-link"></i> Perbaiki Relasi</button><button id="trRefresh" class="nui-btn nui-btn-hero"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button></div></header>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Belum Diproses</small><strong id="trWaiting">0</strong></article><article class="nui-card"><small>Diajukan</small><strong id="trSubmitted">0</strong></article><article class="nui-card"><small>Sudah Transfer</small><strong id="trTransferred">0</strong></article><article class="nui-card"><small>Total Hasil</small><strong id="trTotal">0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="trSearch" class="nui-input" type="search" placeholder="Cari kode atau nama..."><input id="trStart" class="nui-input" type="date"><input id="trEnd" class="nui-input" type="date"><label><input id="trActive" type="checkbox" checked> Aktif</label><label><input id="trFW" type="checkbox"> Belum</label><label><input id="trFS" type="checkbox"> Diajukan</label><label><input id="trFT" type="checkbox"> Transfer</label></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Transitori</th><th>Waktu / Proses</th><th>Akun</th><th>Rekening Sumber</th><th>Nominal</th><th>Status</th><th>Keterangan</th><th>SOP</th></tr></thead><tbody id="trRows"><tr><td colspan="8">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="trPrev" class="nui-btn">← Sebelumnya</button><span id="trPage">Halaman 1</span><button id="trNext" class="nui-btn">Berikutnya →</button></div></article></section>
<script>(function(){var root=document.getElementById('nuiTransitory'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canU=root.dataset.update==='true',page=0,size=20,total=0,last=[],money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function params(p,z){return{q:trSearch.value,start:trStart.value,end:trEnd.value,active:trActive.checked,waiting:trFW.checked,submitted:trFS.checked,transferred:trFT.checked,page:p==null?page:p,size:z||size}}async function call(a,b,p){var o={credentials:'same-origin'},url=endpoint+'&action='+a;if(b){o.method='POST';o.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};o.body=new URLSearchParams(b)}else url+='&'+new URLSearchParams(p||params());var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}async function load(){try{var j=await call('list');last=j.rows;total=j.total;trWaiting.textContent=j.waiting;trSubmitted.textContent=j.submitted;trTransferred.textContent=j.transferred;trTotal.textContent=j.total;trRows.innerHTML=j.rows.map(function(x){return'<tr><td><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.code)+'</small>'+(x.sourceMissing?'<br><span class="nui-chip">Sumber hilang</span>':'')+'</td><td>'+(x.time?new Date(x.time).toLocaleDateString('id-ID'):'-')+'<br><small>'+esc(x.processCode)+'</small></td><td>'+esc(x.account)+'</td><td>'+esc(x.bank)+'<br>'+esc(x.accountName)+'<br>'+esc(x.accountNumber)+'</td><td><strong>'+money.format(x.amount)+'</strong></td><td><span class="nui-chip">'+esc(x.status)+'</span></td><td><textarea class="nui-input tr-note" data-id="'+x.id+'" '+(!canU?'disabled':'')+'>'+esc(x.note)+'</textarea></td><td>'+(x.sopId?'<span class="nui-chip" title="'+esc(x.sop)+'">SOP #'+x.sopId+'</span>':'-')+'</td></tr>'}).join('')||'<tr><td colspan="8">Tidak ada data.</td></tr>';trPage.textContent='Halaman '+(page+1);trPrev.disabled=page===0;trNext.disabled=(page+1)*size>=total}catch(e){trRows.innerHTML='<tr><td colspan="8">'+esc(e.message)+'</td></tr>'}}var t;trSearch.oninput=function(){clearTimeout(t);t=setTimeout(function(){page=0;load()},300)};[trStart,trEnd,trActive,trFW,trFS,trFT].forEach(function(x){x.onchange=function(){page=0;load()}});trRefresh.onclick=load;trPrev.onclick=function(){if(page){page--;load()}};trNext.onclick=function(){page++;load()};trRows.onchange=function(e){if(e.target.classList.contains('tr-note'))call('save_note',{id:e.target.dataset.id,note:e.target.value}).catch(function(x){alert(x.message)})};trRepair.onclick=function(){if(confirm('Perbaiki referensi balik pengajuan transfer?'))call('repair',{}).then(function(j){alert((j.repaired||0)+' relasi diperbaiki.');load()}).catch(function(x){alert(x.message)})};trExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,params(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['code','name','time','processCode','account','bank','accountName','accountNumber','amount','status','note','sop'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='transitori.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};load()})();</script>

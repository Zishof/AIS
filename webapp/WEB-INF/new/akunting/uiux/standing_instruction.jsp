<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String siH(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String siToken(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String siCsrf=(String)session.getAttribute("newUiCsrfToken");if(siCsrf==null){siCsrf=siToken();session.setAttribute("newUiCsrfToken",siCsrf);}NewUiPermission siP=NewUiRouteGuard.permissionFor(request,"akunting","standing_instruction");boolean siU=siP!=null&&siP.isCanUpdate();String siMenu=request.getParameter("menuId"),siEndpoint=request.getContextPath()+"/new?service=1&module=akunting&page=standing_instruction"+(siMenu==null?"":"&menuId="+siH(siMenu));%>
<section class="nui-page" id="nuiSi" data-endpoint="<%=siH(siEndpoint)%>" data-csrf="<%=siH(siCsrf)%>" data-update="<%=siU%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Akuntansi / Standing Instruction</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-money-bill-transfer"></i> TRANSFER CONTROL</p><h1>Standing Instruction</h1><p>Pantau instruksi transfer, rekening sumber, status proses, unit kerja, dan alur SOP secara aman.</p></div><button id="siRefresh" class="nui-btn nui-btn-hero"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button></header>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Belum diproses</small><strong id="siPending">0</strong></article><article class="nui-card"><small>Dalam proses</small><strong id="siApproved">0</strong></article><article class="nui-card"><small>Sudah ditransfer</small><strong id="siTransferred">0</strong></article><article class="nui-card"><small>Total hasil</small><strong id="siTotal">0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="siSearch" class="nui-input" placeholder="Cari kode atau nama..." type="search"><select id="siUnit" class="nui-input"><option value="">Semua satuan kerja</option></select><input id="siStart" class="nui-input" type="date"><input id="siEnd" class="nui-input" type="date"><label><input id="siFP" type="checkbox"> Belum</label><label><input id="siFA" type="checkbox"> Proses</label><label><input id="siFT" type="checkbox"> Transfer</label></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Instruksi</th><th>Waktu / Unit</th><th>Akun</th><th>Rekening Sumber</th><th>Nominal</th><th>Status Transfer</th><th>Keterangan</th><th>SOP</th></tr></thead><tbody id="siRows"><tr><td colspan="8">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="siPrev" class="nui-btn">← Sebelumnya</button><span id="siPage">Halaman 1</span><button id="siNext" class="nui-btn">Berikutnya →</button></div></article>
<article class="nui-card" style="margin-top:14px"><h3>Statistik per Jenis Pengajuan</h3><div id="siTypes" class="nui-dashboard-kpis"></div></article></section>
<script>(function(){var root=document.getElementById('nuiSi'),button=document.createElement('button');button.className='nui-btn nui-btn-hero';button.innerHTML='<i class="fa-solid fa-file-excel"></i> Ekspor';root.querySelector('.nui-module-dashboard-hero').appendChild(button);button.onclick=async function(){button.disabled=true;try{var endpoint=root.dataset.endpoint,all=[],page=0,total=1;while(all.length<total){var p={action:'list',q:siSearch.value,unitId:siUnit.value,start:siStart.value,end:siEnd.value,pending:siFP.checked,approved:siFA.checked,transferred:siFT.checked,page:page,size:100},r=await fetch(endpoint+'&'+new URLSearchParams(p),{credentials:'same-origin'}),j=await r.json();if(!r.ok)throw new Error(j.message||'Ekspor gagal');total=j.total;all=all.concat(j.rows);page++;}var cols=['code','name','time','unit','account','bank','accountName','accountNumber','amount','status','transfer','note'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='standing-instruction.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}finally{button.disabled=false}}})();</script>
<script>(function(){var root=document.getElementById('nuiSi'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canU=root.dataset.update==='true',page=0,size=20,total=0,money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function params(){return{q:siSearch.value,unitId:siUnit.value,start:siStart.value,end:siEnd.value,pending:siFP.checked,approved:siFA.checked,transferred:siFT.checked,page:page,size:size}}async function call(a,b){var o={credentials:'same-origin'},url=endpoint+'&action='+a;if(b){o.method='POST';o.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};o.body=new URLSearchParams(b)}else url+='&'+new URLSearchParams(params());var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}async function load(){try{var keep=siUnit.value,j=await call('list');total=j.total;siUnit.innerHTML='<option value="">Semua satuan kerja</option>'+j.units.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('');siUnit.value=keep;siPending.textContent=j.status.PENDING||0;siApproved.textContent=j.status.APPROVED||0;siTransferred.textContent=j.status.TRANSFERRED||0;siTotal.textContent=j.total;siRows.innerHTML=j.rows.map(function(x){return'<tr><td><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.code)+'</small></td><td>'+(x.time?new Date(x.time).toLocaleDateString('id-ID'):'-')+'<br><small>'+esc(x.unit)+'</small></td><td>'+esc(x.account)+'</td><td>'+esc(x.bank)+'<br>'+esc(x.accountName)+'<br>'+esc(x.accountNumber)+'</td><td><strong>'+money.format(x.amount)+'</strong></td><td><span class="nui-chip">'+esc(x.status)+'</span><br><small>'+esc(x.transfer)+'</small></td><td><textarea class="nui-input si-note" data-id="'+x.id+'" '+(!canU?'disabled':'')+'>'+esc(x.note)+'</textarea></td><td>'+(x.sopId?'<span class="nui-chip">SOP #'+x.sopId+'</span>':'-')+'</td></tr>'}).join('')||'<tr><td colspan="8">Tidak ada data.</td></tr>';siTypes.innerHTML=Object.keys(j.types).map(function(k){return'<div class="nui-card"><small>'+esc(k)+'</small><strong>'+j.types[k]+'</strong></div>'}).join('');siPage.textContent='Halaman '+(page+1);siPrev.disabled=page===0;siNext.disabled=(page+1)*size>=total}catch(e){siRows.innerHTML='<tr><td colspan="8">'+esc(e.message)+'</td></tr>'}}var timer;siSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[siUnit,siStart,siEnd,siFP,siFA,siFT].forEach(function(x){x.onchange=function(){page=0;load()}});siRefresh.onclick=load;siPrev.onclick=function(){if(page){page--;load()}};siNext.onclick=function(){page++;load()};siRows.onchange=function(e){if(e.target.classList.contains('si-note'))call('save_note',{id:e.target.dataset.id,note:e.target.value}).catch(function(x){alert(x.message)})};load()})();</script>

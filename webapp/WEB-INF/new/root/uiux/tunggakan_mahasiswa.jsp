<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String h(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String token(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String csrf=(String)session.getAttribute("newUiCsrfToken");if(csrf==null){csrf=token();session.setAttribute("newUiCsrfToken",csrf);}NewUiPermission p=NewUiRouteGuard.permissionFor(request,"root","tunggakan_mahasiswa");String menu=request.getParameter("menuId"),endpoint=request.getContextPath()+"/new?service=1&module=root&page=tunggakan_mahasiswa"+(menu==null?"":"&menuId="+h(menu));%>
<section class="nui-page" id="nuiArrears" data-endpoint="<%=h(endpoint)%>" data-csrf="<%=h(csrf)%>" data-update="<%=p!=null&&p.isCanUpdate()%>" data-delete="<%=p!=null&&p.isCanDelete()%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Keuangan Mahasiswa / Tunggakan</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-file-invoice-dollar"></i> STUDENT RECEIVABLES</p><h1>Tunggakan Mahasiswa</h1><p>Daftar tunggakan, rincian komponen biaya, pembayaran, rekap, status lunas, dan proses ulang tagihan.</p></div><div class="nui-toolbar"><button id="arExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-export"></i> Ekspor</button><button id="arProcess" class="nui-btn nui-btn-hero" <%=p!=null&&p.isCanUpdate()?"":"disabled"%>><i class="fa-solid fa-arrows-rotate"></i> Proses Ulang</button></div></header>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="arSearch" class="nui-input" type="search" placeholder="Cari NIM atau nama mahasiswa..."><input id="arCohort" class="nui-input" type="number" placeholder="Angkatan"><input id="arAcademicYear" class="nui-input" placeholder="Tahun akademik"><select id="arSemester" class="nui-input"><option value="">Semua semester</option><option value="1">Ganjil</option><option value="2">Genap</option></select><select id="arProgram" class="nui-input"><option value="">Semua program</option><option>Reguler</option><option>Ekstensi</option><option>Karyawan</option></select><select id="arCitizenship" class="nui-input"><option value="">WNI/WNA</option><option>WNI</option><option>WNA</option></select><label><input id="arUnpaid" type="checkbox"> Belum bayar</label><label><input id="arSettled" type="checkbox"> Dianggap lunas</label><button id="arRefresh" class="nui-btn"><i class="fa-solid fa-magnifying-glass"></i> Cari</button></div><details style="margin-top:12px"><summary>Filter lanjutan seperti versi existing</summary><div class="nui-toolbar" style="margin-top:10px"><select id="arStatus" class="nui-input"><option value="">Semua status aktif</option></select><select id="arInitialStatus" class="nui-input"><option value="">Semua status awal</option></select><select id="arFaculty" class="nui-input"><option value="">Semua fakultas</option></select><select id="arStudyProgram" class="nui-input"><option value="">Semua program studi</option></select><select id="arConcentration" class="nui-input"><option value="">Semua konsentrasi</option></select><select id="arLevel" class="nui-input"><option value="">Semua jenjang</option></select><input id="arAdvisor" class="nui-input" type="number" placeholder="ID dosen PA"><label><input id="arAdvisorMissing" type="checkbox"> Tanpa dosen PA</label></div></details></article>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Jumlah data</small><strong id="arTotal">0</strong></article><article class="nui-card"><small>Total tunggakan</small><strong id="arDebt">Rp0</strong></article><article class="nui-card"><small>Terlihat di halaman</small><strong id="arVisible">0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Mahasiswa</th><th>Fakultas / Prodi</th><th>Periode</th><th>Tunggakan</th><th>Sisa / Terbayar</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="arRows"><tr><td colspan="7">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="arPrev" class="nui-btn">← Sebelumnya</button><span id="arPager">Halaman 1</span><button id="arNext" class="nui-btn">Berikutnya →</button></div></article>
<dialog id="arDetailDialog" style="border:0;border-radius:16px;padding:24px;max-width:900px;width:calc(100% - 32px)"><div class="nui-toolbar"><h2 style="flex:1">Rincian Tunggakan dan Pembayaran</h2><button id="arDetailClose" class="nui-btn">Tutup</button></div><div class="nui-grid nui-grid-2"><section><h3>Detail biaya tagihan</h3><div id="arCharges"></div></section><section><h3>Detail biaya terbayar</h3><div id="arPayments"></div></section></div></dialog>
<dialog id="arProcessDialog" style="border:0;border-radius:16px;padding:24px;max-width:640px;width:calc(100% - 32px)"><form id="arProcessForm"><h2>Proses Ulang Tunggakan</h2><label>Jenis<select id="arKind" class="nui-input"><option value="existing">Daftar ulang / mahasiswa lama</option><option value="new">Mahasiswa baru</option></select></label><label>Tahun akademik<input id="arProcessYear" class="nui-input" required placeholder="2026/2027"></label><label id="arProcessSemesterWrap">Jenis semester<select id="arProcessSemester" class="nui-input"><option>Ganjil</option><option>Genap</option></select></label><label><input id="arReloadDetails" type="checkbox" checked> Muat ulang detail tunggakan</label><div id="arProgress" class="nui-alert">Processor siap dijalankan.</div><div class="nui-toolbar"><button id="arProcessClose" type="button" class="nui-btn">Tutup</button><button class="nui-btn nui-btn-primary" type="submit">Mulai Proses</button></div></form></dialog></section>
<script>(function(){var root=document.getElementById('nuiArrears'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canU=root.dataset.update==='true',canD=root.dataset.delete==='true',page=0,size=20,total=0,last=[],money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function params(p,z){return{q:arSearch.value,year:arCohort.value,academicYear:arAcademicYear.value,semester:arSemester.value,program:arProgram.value,citizenship:arCitizenship.value,studentStatusId:arStatus.value,initialStatusId:arInitialStatus.value,facultyId:arFaculty.value,studyProgramId:arStudyProgram.value,concentrationId:arConcentration.value,levelId:arLevel.value,advisorId:arAdvisor.value,advisorMissing:arAdvisorMissing.checked,unpaidOnly:arUnpaid.checked,settledOnly:arSettled.checked,page:p==null?page:p,size:z||size}}async function call(action,body,query,id){var url=endpoint+'&action='+action+(id?'&id='+encodeURIComponent(id):'')+'&'+new URLSearchParams(query||{}),options={credentials:'same-origin'};if(body){options.method='POST';options.headers={'X-CSRF-Token':csrf,'Content-Type':'application/x-www-form-urlencoded'};options.body=new URLSearchParams(body)}var response=await fetch(url,options),json=await response.json();if(!response.ok)throw new Error(json.message||'Operasi gagal');return json}function fill(select,rows){rows.forEach(function(x){var o=document.createElement('option');o.value=x.id;o.textContent=x.label;if(x.parentId!=null)o.dataset.parent=x.parentId;select.appendChild(o)})}async function loadOptions(){try{var j=await call('options');fill(arStatus,j.statuses);fill(arInitialStatus,j.initialStatuses);fill(arFaculty,j.faculties);fill(arStudyProgram,j.studyPrograms);fill(arConcentration,j.concentrations);fill(arLevel,j.levels)}catch(e){console.error(e)}}async function load(){arRows.innerHTML='<tr><td colspan="7">Memuat data...</td></tr>';try{var j=await call('list',null,params());last=j.rows;total=j.total;arTotal.textContent=j.total;arDebt.textContent=money.format(j.debt);arVisible.textContent=j.rows.length;arRows.innerHTML=j.rows.map(function(x){return'<tr><td><strong>'+esc(x.nim)+'</strong><br>'+esc(x.name)+'<br><small>Angkatan '+esc(x.cohort)+' · '+esc(x.citizenship)+'</small></td><td>'+esc(x.faculty)+'<br>'+esc(x.studyProgram)+'</td><td>'+esc(x.academicYear)+'<br>Semester '+esc(x.semester)+'</td><td>'+money.format(x.debt)+'</td><td>'+money.format(x.remaining)+'<br><small>Terbayar '+money.format(x.paid)+' ('+x.paidPercent+'%)</small></td><td><label><input class="ar-settle" data-id="'+x.id+'" type="checkbox" '+(x.settled?'checked':'')+' '+(!canU||!x.hasPayment?'disabled':'')+'> Dianggap lunas</label><br><span class="nui-chip">'+(x.hasPayment?'Ada pembayaran':'Belum bayar')+'</span></td><td><div class="nui-toolbar"><button class="nui-btn ar-detail" data-id="'+x.id+'" title="Rincian"><i class="fa-solid fa-list"></i></button><button class="nui-btn ar-delete" data-id="'+x.id+'" '+(!canD?'disabled':'')+' title="Hapus"><i class="fa-solid fa-trash"></i></button></div></td></tr>'}).join('')||'<tr><td colspan="7">Tidak ada tunggakan.</td></tr>';arPager.textContent='Halaman '+(page+1);arPrev.disabled=page===0;arNext.disabled=(page+1)*size>=total}catch(e){arRows.innerHTML='<tr><td colspan="7">'+esc(e.message)+'</td></tr>'}}arRows.onchange=function(e){if(e.target.classList.contains('ar-settle'))call('settle',{id:e.target.dataset.id,value:e.target.checked},{},e.target.dataset.id).catch(function(x){alert(x.message);load()})};arRows.onclick=async function(e){var b=e.target.closest('button');if(!b)return;if(b.classList.contains('ar-delete')&&confirm('Hapus data tunggakan ini?'))call('delete',{id:b.dataset.id},{},b.dataset.id).then(load).catch(function(x){alert(x.message)});if(b.classList.contains('ar-detail')){arDetailDialog.showModal();arCharges.textContent=arPayments.textContent='Memuat...';try{var j=await call('details',null,{id:b.dataset.id});function cards(a){return a.map(function(x){return'<article class="nui-card" style="margin-top:8px;padding:12px"><strong>'+esc(x.name)+'</strong><br>'+money.format(x.amount)+'</article>'}).join('')||'<p>Tidak ada data.</p>'}arCharges.innerHTML=cards(j.charges);arPayments.innerHTML=cards(j.payments)}catch(x){arCharges.textContent=x.message;arPayments.textContent=''}}};arDetailClose.onclick=function(){arDetailDialog.close()};arProcess.onclick=function(){arProcessDialog.showModal();status()};arProcessClose.onclick=function(){arProcessDialog.close()};arKind.onchange=function(){arProcessSemesterWrap.hidden=arKind.value==='new'};arProcessForm.onsubmit=async function(e){e.preventDefault();if(!confirm('Jalankan proses ulang tunggakan?'))return;try{await call('reprocess',{kind:arKind.value,academicYear:arProcessYear.value,semester:arProcessSemester.value,reloadDetails:arReloadDetails.checked});status()}catch(x){alert(x.message)}};async function status(){try{var j=await call('job'),x=arKind.value==='new'?j.newStudents:j.existing,p=x.total?Math.round(x.done*100/x.total):0;arProgress.textContent=x.running?'Memproses '+x.done+' dari '+x.total+' data ('+p+'%)':'Processor tidak berjalan. Terakhir '+x.done+' dari '+x.total+'.';if(x.running)setTimeout(status,1000);else load()}catch(e){arProgress.textContent=e.message}}var timer;arSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[arCohort,arAcademicYear,arSemester,arProgram,arCitizenship,arStatus,arInitialStatus,arFaculty,arStudyProgram,arConcentration,arLevel,arAdvisor,arAdvisorMissing,arUnpaid,arSettled].forEach(function(x){x.onchange=function(){page=0;load()}});arFaculty.onchange=function(){Array.prototype.forEach.call(arStudyProgram.options,function(o,i){if(i)o.hidden=arFaculty.value&&o.dataset.parent!==arFaculty.value});arStudyProgram.value='';page=0;load()};arRefresh.onclick=load;arPrev.onclick=function(){if(page){page--;load()}};arNext.onclick=function(){page++;load()};arExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,params(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['nim','name','cohort','citizenship','faculty','studyProgram','academicYear','semester','debt','remaining','paid','paidPercent','settled'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='rekap-tunggakan-mahasiswa.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};loadOptions();load()})();</script>

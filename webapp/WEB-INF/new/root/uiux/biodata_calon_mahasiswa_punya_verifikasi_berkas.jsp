<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String vh(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String vt(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String vc=(String)session.getAttribute("newUiCsrfToken");if(vc==null){vc=vt();session.setAttribute("newUiCsrfToken",vc);}NewUiPermission vp=NewUiRouteGuard.permissionFor(request,"root","biodata_calon_mahasiswa_punya_verifikasi_berkas");boolean vu=vp!=null&&vp.isCanUpdate();String vm=request.getParameter("menuId"),ve=request.getContextPath()+"/new?service=1&module=root&page=biodata_calon_mahasiswa_punya_verifikasi_berkas"+(vm==null?"":"&menuId="+vh(vm));%>
<style>.cv-person{display:flex;gap:10px;align-items:center}.cv-photo{width:44px;height:44px;border-radius:12px;object-fit:cover;background:#edf2ff}.cv-status{display:flex;gap:5px;flex-wrap:wrap}.cv-note{min-width:180px}.cv-file{display:flex;gap:6px;flex-wrap:wrap;align-items:center}</style>
<section class="nui-page" id="cvPage" data-endpoint="<%=vh(ve)%>" data-csrf="<%=vh(vc)%>" data-update="<%=vu%>" data-context="<%=vh(request.getContextPath())%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">PMB / Verifikasi Berkas</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-folder-open"></i> ADMISSION DOCUMENTS</p><h1>Verifikasi Berkas Calon Mahasiswa</h1><p>Periksa unggahan, kelulusan dokumen wajib, catatan verifikator, pembayaran, NIM, program studi, dan gelombang.</p></div><div><button id="cvZip" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-zipper"></i> Unduh Semua Lampiran</button><button id="cvExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-excel"></i> Ekspor</button></div></header>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Total Hasil</small><strong id="cvTotal">0</strong></article><article class="nui-card"><small>Terunggah di Halaman</small><strong id="cvUploaded">0</strong></article><article class="nui-card"><small>Lolos di Halaman</small><strong id="cvVerified">0</strong></article><article class="nui-card"><small>Belum Lolos</small><strong id="cvPending">0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="cvCandidate" class="nui-input" type="search" placeholder="Nama, no registrasi, no ujian..."><input id="cvDocument" class="nui-input" type="search" placeholder="Nama berkas..."><select id="cvAcademic" class="nui-input"><option value="">Semua tahun akademik</option></select><select id="cvWave" class="nui-input"><option value="">Semua gelombang</option></select><select id="cvSelection" class="nui-input"><option value="">Semua jenis seleksi</option></select><select id="cvPackage" class="nui-input"><option value="">Semua paket</option></select></div><div class="nui-toolbar"><select id="cvChoice" class="nui-input"><option value="">Semua prodi pilihan</option></select><select id="cvPassed" class="nui-input"><option value="">Semua prodi lulus</option></select><select id="cvUpload" class="nui-input"><option value="">Semua status unggah</option><option value="true">Sudah unggah</option><option value="false">Belum unggah</option></select><select id="cvVerify" class="nui-input"><option value="">Semua status verifikasi</option><option value="true">Sudah lolos</option><option value="false">Belum lolos</option></select><label><input id="cvHasNim" type="checkbox"> Sudah NIM</label><label><input id="cvNoNim" type="checkbox"> Belum NIM</label><label><input id="cvExtra" type="checkbox"> Form tambahan</label><select id="cvSize" class="nui-input"><option>20</option><option>50</option><option>100</option></select></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Calon Mahasiswa</th><th>Berkas</th><th>Status</th><th>Lampiran</th><th>Catatan / Verifikasi</th></tr></thead><tbody id="cvRows"><tr><td colspan="5">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="cvPrev" class="nui-btn">← Sebelumnya</button><span id="cvPageNo">Halaman 1</span><button id="cvNext" class="nui-btn">Berikutnya →</button></div></article></section>
<script>(function(){var root=document.getElementById('cvPage'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canU=root.dataset.update==='true',ctx=root.dataset.context,page=0,total=0,last=[],once=false;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function val(p,z){return{candidate:cvCandidate.value,document:cvDocument.value,academicYear:cvAcademic.value,waveId:cvWave.value,selectionId:cvSelection.value,packageId:cvPackage.value,programChoiceId:cvChoice.value,programPassedId:cvPassed.value,uploaded:cvUpload.value,verified:cvVerify.value,hasNim:cvHasNim.checked,noNim:cvNoNim.checked,extraForm:cvExtra.checked,page:p==null?page:p,size:z||cvSize.value}}async function call(a,b,p,multipart){var o={credentials:'same-origin'},url=endpoint+'&action='+a;if(b){o.method='POST';o.headers={'X-CSRF-Token':csrf};if(multipart)o.body=b;else{o.headers['Content-Type']='application/x-www-form-urlencoded';o.body=new URLSearchParams(b)}}else url+='&'+new URLSearchParams(p||val());var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}function opts(rows,blank){return'<option value="">'+blank+'</option>'+rows.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('')}function options(j){if(once)return;cvAcademic.innerHTML='<option value="">Semua tahun akademik</option>'+j.academicYears.map(function(x){return'<option>'+esc(x)+'</option>'}).join('');cvWave.innerHTML=opts(j.waves,'Semua gelombang');cvSelection.innerHTML=opts(j.selections,'Semua jenis seleksi');cvPackage.innerHTML=opts(j.packages,'Semua paket');cvChoice.innerHTML=opts(j.programs,'Semua prodi pilihan');cvPassed.innerHTML=opts(j.programs,'Semua prodi lulus');once=true}function row(x){var photo=x.photo?'<img class="cv-photo" src="'+esc(x.photo)+'" alt="" onerror="this.style.display=\'none\'">':'<span class="cv-photo"></span>',download=x.hasAttachment?'<a class="nui-btn" target="_blank" href="'+ctx+'/AmbilLampiranLain?ref='+x.id+'&jenis='+encodeURIComponent('ais.database.model.BiodataCalonMahasiswaPunyaVerifikasiBerkas')+'"><i class="fa-solid fa-download"></i> Unduh</a>':'Belum ada',upload=canU&&!x.verified&&!x.expired?'<label class="nui-btn"><i class="fa-solid fa-upload"></i> Unggah<input class="cv-upload" data-id="'+x.id+'" type="file" hidden></label>':'';return'<tr><td><div class="cv-person">'+photo+'<div><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.registration)+' · '+esc(x.exam)+'</small><br><small>'+esc(x.academicYear)+' · '+esc(x.wave)+'</small><br><small>'+esc(x.phone)+' · '+esc(x.email)+'</small></div></div></td><td><strong>'+esc(x.document)+'</strong><div class="cv-status">'+(x.required?'<span class="nui-chip">Wajib</span>':'')+(x.needsVerification?'<span class="nui-chip">Perlu verifikasi</span>':'')+'</div></td><td>'+(x.uploaded?'<strong>Terunggah</strong>':'Belum unggah')+'<br>'+(x.verified?'<strong style="color:#08783c">Sesuai</strong>':'Belum sesuai')+(x.expired?'<br><span class="nui-chip">Batas unggah lewat</span>':'')+'</td><td><div class="cv-file">'+download+upload+'</div><small>'+esc(x.fileName)+'</small></td><td><textarea class="nui-input cv-note" data-id="'+x.id+'" '+(!canU||x.verified?'disabled':'')+'>'+esc(x.note)+'</textarea><br>'+(canU?'<label><input class="cv-check" data-id="'+x.id+'" type="checkbox" '+(x.verified?'checked':'')+'> Sesuai</label>':'')+'</td></tr>'}async function load(){try{var j=await call('list');last=j.rows;total=j.total;options(j);cvRows.innerHTML=j.rows.map(row).join('')||'<tr><td colspan="5">Tidak ada data sesuai filter.</td></tr>';cvTotal.textContent=j.total;cvUploaded.textContent=j.rows.filter(function(x){return x.uploaded}).length;cvVerified.textContent=j.rows.filter(function(x){return x.verified}).length;cvPending.textContent=j.rows.filter(function(x){return!x.verified}).length;cvPageNo.textContent='Halaman '+(page+1);cvPrev.disabled=page===0;cvNext.disabled=(page+1)*Number(cvSize.value)>=total}catch(e){cvRows.innerHTML='<tr><td colspan="5">'+esc(e.message)+'</td></tr>'}}var timer;[cvCandidate,cvDocument].forEach(function(x){x.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},350)}});[cvAcademic,cvWave,cvSelection,cvPackage,cvChoice,cvPassed,cvUpload,cvVerify,cvHasNim,cvNoNim,cvExtra,cvSize].forEach(function(x){x.onchange=function(){if(x===cvHasNim&&x.checked)cvNoNim.checked=false;if(x===cvNoNim&&x.checked)cvHasNim.checked=false;page=0;load()}});cvPrev.onclick=function(){if(page){page--;load()}};cvNext.onclick=function(){page++;load()};cvRows.onchange=async function(e){try{if(e.target.classList.contains('cv-check')){var note=e.target.closest('td').querySelector('.cv-note').value;await call('verify',{id:e.target.dataset.id,verified:e.target.checked,note:note});load()}else if(e.target.classList.contains('cv-note'))await call('verify',{id:e.target.dataset.id,verified:false,note:e.target.value});else if(e.target.classList.contains('cv-upload')){var f=e.target.files[0];if(!f)return;var d=new FormData();d.append('id',e.target.dataset.id);d.append('file',f);await call('upload',d,null,true);load()}}catch(x){alert(x.message);load()}};cvZip.onclick=function(){location.href=endpoint+'&action=download_zip&'+new URLSearchParams(val())};cvExport.onclick=async function(){var all=[],p=0,n=1;try{while(all.length<n){var j=await call('list',null,val(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['registration','exam','name','academicYear','wave','document','required','needsVerification','uploaded','verified','fileName','note'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='verifikasi-berkas-pmb.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};load()})();</script>

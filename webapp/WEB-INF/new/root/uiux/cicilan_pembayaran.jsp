<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String h(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String token(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String csrf=(String)session.getAttribute("newUiCsrfToken");if(csrf==null){csrf=token();session.setAttribute("newUiCsrfToken",csrf);}NewUiPermission p=NewUiRouteGuard.permissionFor(request,"root","cicilan_pembayaran");String menu=request.getParameter("menuId"),endpoint=request.getContextPath()+"/new?service=1&module=root&page=cicilan_pembayaran"+(menu==null?"":"&menuId="+h(menu));%>
<section class="nui-page" id="nuiInstallments" data-endpoint="<%=h(endpoint)%>" data-csrf="<%=h(csrf)%>" data-delete="<%=p!=null&&p.isCanDelete()%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Keuangan / Pembayaran Mahasiswa</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-money-check-dollar"></i> PAYMENT LEDGER</p><h1>Cicilan Pembayaran</h1><p>Pembayaran mahasiswa dan calon mahasiswa, bukti bayar, histori audit, deposit, rekap, dan reversal terotorisasi.</p></div><div class="nui-toolbar"><button id="ipExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-excel"></i> Rekap Pembayaran</button><button id="ipBillingExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-invoice"></i> Rekap Tagihan & Pembayaran</button></div></header>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="ipSearch" class="nui-input" type="search" placeholder="NIM, nomor registrasi, nomor ujian, atau nama..."><input id="ipAcademicYear" class="nui-input" placeholder="Tahun akademik"><select id="ipSemester" class="nui-input"><option value="">Semua semester</option><option value="odd">Ganjil</option><option value="even">Genap</option></select><input id="ipCohort" class="nui-input" type="number" placeholder="Angkatan"><select id="ipFaculty" class="nui-input"><option value="">Semua fakultas</option></select><select id="ipStudyProgram" class="nui-input"><option value="">Semua prodi</option></select><label>Mulai <input id="ipStart" class="nui-input" type="date"></label><label>s.d. <input id="ipEnd" class="nui-input" type="date"></label><label><input id="ipDeposit" type="checkbox"> Deposit saja</label><button id="ipRefresh" class="nui-btn"><i class="fa-solid fa-magnifying-glass"></i> Cari</button></div><details style="margin-top:10px"><summary>Filter item biaya</summary><select id="ipItems" class="nui-input" multiple size="7" style="width:100%;margin-top:8px"></select><small>Tanpa pilihan berarti seluruh item biaya.</small></details></article>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Jumlah transaksi</small><strong id="ipTotal">0</strong></article><article class="nui-card"><small>Nominal pembayaran</small><strong id="ipAmount">Rp0</strong></article><article class="nui-card"><small>Deposit</small><strong id="ipDepositTotal">Rp0</strong></article><article class="nui-card"><small>Denda</small><strong id="ipPenalty">Rp0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Mahasiswa / calon</th><th>Fakultas / prodi</th><th>Kegiatan / periode</th><th>Pembayaran</th><th>Tanggal</th><th>Nominal</th><th>Deposit / denda</th><th>Keterangan</th><th>Aksi</th></tr></thead><tbody id="ipRows"><tr><td colspan="9">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="ipPrev" class="nui-btn">← Sebelumnya</button><span id="ipPager">Halaman 1</span><button id="ipNext" class="nui-btn">Berikutnya →</button></div></article>
<dialog id="ipHistoryDialog" style="border:0;border-radius:16px;padding:24px;max-width:900px;width:calc(100% - 32px)"><div class="nui-toolbar"><h2 style="flex:1">History Perubahan Pembayaran</h2><button id="ipHistoryClose" class="nui-btn">Tutup</button></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Revisi</th><th>Tanggal</th><th>User</th><th>Jenis</th><th>Nominal</th><th>Deposit</th><th>Keterangan</th></tr></thead><tbody id="ipHistory"></tbody></table></div></dialog></section>
<script>(function(){var root=document.getElementById('nuiInstallments'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,page=0,size=20,total=0,last=[],canReverse=false,money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}),today=new Date(),start=new Date();start.setDate(today.getDate()-21);ipStart.value=start.toISOString().slice(0,10);ipEnd.value=today.toISOString().slice(0,10);function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function selected(){return Array.prototype.filter.call(ipItems.options,function(x){return x.selected}).map(function(x){return x.value}).join(',')}function params(p,z){return{q:ipSearch.value,academicYear:ipAcademicYear.value,semester:ipSemester.value,cohort:ipCohort.value,facultyId:ipFaculty.value,studyProgramId:ipStudyProgram.value,start:ipStart.value,end:ipEnd.value,depositOnly:ipDeposit.checked,itemIds:selected(),page:p==null?page:p,size:z||size}}async function call(action,body,q,id){var url=endpoint+'&action='+action+(id?'&id='+encodeURIComponent(id):'')+'&'+new URLSearchParams(q||{}),o={credentials:'same-origin'};if(body){o.method='POST';o.headers={'X-CSRF-Token':csrf,'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(body)}var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}function fill(s,a){a.forEach(function(x){var o=document.createElement('option');o.value=x.id;o.textContent=x.label;if(x.parentId!=null)o.dataset.parent=x.parentId;s.appendChild(o)})}async function options(){try{var j=await call('options');fill(ipItems,j.items);fill(ipFaculty,j.faculties);fill(ipStudyProgram,j.studyPrograms);canReverse=j.canReverse&&root.dataset.delete==='true'}catch(e){console.error(e)}}async function load(){ipRows.innerHTML='<tr><td colspan="9">Memuat data...</td></tr>';try{var j=await call('list',null,params());last=j.rows;total=j.total;ipTotal.textContent=j.total;ipAmount.textContent=money.format(j.amount);ipDepositTotal.textContent=money.format(j.deposit);ipPenalty.textContent=money.format(j.penalty);ipRows.innerHTML=last.map(function(x){return'<tr><td><strong>'+esc(x.identifier)+'</strong><br>'+esc(x.name)+'</td><td>'+esc(x.faculty)+'<br>'+esc(x.studyProgram)+'</td><td>'+esc(x.activity)+'<br>'+esc(x.academicYear)+' / smt '+esc(x.semester)+(x.stage?' / tahap '+x.stage:'')+'</td><td>'+esc(x.paymentType)+'<br><small>'+esc(x.item)+'</small></td><td>'+esc(x.date)+'<br><small>Kwitansi '+esc(x.receiptDate)+'</small></td><td>'+money.format(x.amount)+'</td><td>'+money.format(x.deposit)+'<br><small>Denda '+money.format(x.penalty)+'</small></td><td>'+esc(x.note)+'</td><td><div class="nui-toolbar"><a class="nui-btn" target="_blank" href="'+endpoint+'&action=receipt&id='+x.id+'" title="Cetak bukti"><i class="fa-solid fa-print"></i></a><button class="nui-btn ip-history" data-id="'+x.id+'" title="History"><i class="fa-solid fa-clock-rotate-left"></i></button><button class="nui-btn ip-reverse" data-id="'+x.id+'" '+(!canReverse?'disabled':'')+' title="Reversal"><i class="fa-solid fa-rotate-left"></i></button></div></td></tr>'}).join('')||'<tr><td colspan="9">Tidak ada pembayaran.</td></tr>';ipPager.textContent='Halaman '+(page+1);ipPrev.disabled=page===0;ipNext.disabled=(page+1)*size>=total}catch(e){ipRows.innerHTML='<tr><td colspan="9">'+esc(e.message)+'</td></tr>'}}ipRows.onclick=async function(e){var b=e.target.closest('button');if(!b)return;if(b.classList.contains('ip-reverse')&&confirm('Lakukan reversal pada pembayaran ini? Data pembayaran akan dihapus sesuai perilaku existing.')){try{await call('reverse',{id:b.dataset.id},{},b.dataset.id);load()}catch(x){alert(x.message)}}if(b.classList.contains('ip-history')){ipHistoryDialog.showModal();ipHistory.innerHTML='<tr><td colspan="7">Memuat...</td></tr>';try{var j=await call('history',null,{},b.dataset.id);ipHistory.innerHTML=j.rows.map(function(x){return'<tr><td>'+x.revision+'</td><td>'+esc(x.date)+'</td><td>'+esc(x.user)+'</td><td>'+esc(x.type)+'</td><td>'+money.format(x.amount)+'</td><td>'+money.format(x.deposit)+'</td><td>'+esc(x.note)+'</td></tr>'}).join('')||'<tr><td colspan="7">Belum ada histori.</td></tr>'}catch(x){ipHistory.innerHTML='<tr><td colspan="7">'+esc(x.message)+'</td></tr>'}}};ipHistoryClose.onclick=function(){ipHistoryDialog.close()};var timer;ipSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[ipAcademicYear,ipSemester,ipCohort,ipFaculty,ipStudyProgram,ipStart,ipEnd,ipDeposit,ipItems].forEach(function(x){x.onchange=function(){page=0;load()}});ipFaculty.onchange=function(){Array.prototype.forEach.call(ipStudyProgram.options,function(o,i){if(i)o.hidden=ipFaculty.value&&o.dataset.parent!==ipFaculty.value});ipStudyProgram.value='';page=0;load()};ipRefresh.onclick=load;ipPrev.onclick=function(){if(page){page--;load()}};ipNext.onclick=function(){page++;load()};async function allRows(){var a=[],p=0,n=1;while(a.length<n){var j=await call('list',null,params(p,100));n=j.total;a=a.concat(j.rows);p++}return a}function csv(rows,cols,name){var data=[cols.join(',')].concat(rows.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+data],{type:'text/csv;charset=utf-8'}));a.download=name;a.click();URL.revokeObjectURL(a.href)}ipExport.onclick=async function(){try{csv(await allRows(),['identifier','name','faculty','studyProgram','academicYear','semester','activity','paymentType','item','date','receiptDate','amount','deposit','penalty','note'],'rekap-pembayaran.csv')}catch(e){alert(e.message)}};ipBillingExport.onclick=async function(){try{var rows=await allRows(),seen={},out=[];rows.forEach(function(x){if(!seen[x.activityId]){seen[x.activityId]=true;out.push(x)}});csv(out,['identifier','name','faculty','studyProgram','academicYear','semester','activity','billed','activityPaid','remaining'],'rekap-tagihan-dan-pembayaran.csv')}catch(e){alert(e.message)}};options().then(load)})();</script>

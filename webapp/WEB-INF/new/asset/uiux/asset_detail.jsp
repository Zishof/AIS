<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String h(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String token(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String csrf=(String)session.getAttribute("newUiCsrfToken");if(csrf==null){csrf=token();session.setAttribute("newUiCsrfToken",csrf);}NewUiPermission p=NewUiRouteGuard.permissionFor(request,"asset","asset_detail");String menu=request.getParameter("menuId"),endpoint=request.getContextPath()+"/new?service=1&module=asset&page=asset_detail"+(menu==null?"":"&menuId="+h(menu));%>
<section class="nui-page" id="nuiAssetDepreciation" data-endpoint="<%=h(endpoint)%>" data-csrf="<%=h(csrf)%>" data-update="<%=p!=null&&p.isCanUpdate()%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Aset & Pengadaan / Detail Aset</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-chart-line"></i> INVENTORY DEPRECIATION</p><h1>Detail Aset & Penyusutan</h1><p>Unit aset fisik, lokasi, nilai perolehan, umur ekonomis, nilai buku, dan histori penyusutan bulanan.</p></div><div class="nui-toolbar"><button id="adExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-excel"></i> Ekspor</button><button id="adSync" class="nui-btn nui-btn-hero" <%=p!=null&&p.isCanUpdate()?"":"disabled"%>><i class="fa-solid fa-arrows-rotate"></i> Sinkronkan Penyusutan</button></div></header>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="adSearch" class="nui-input" type="search" placeholder="Cari nama atau barcode..."><input id="adBrand" class="nui-input" placeholder="Merk"><select id="adType" class="nui-input"><option value="">Semua jenis aset</option></select><select id="adRoom" class="nui-input"><option value="">Semua ruang</option></select><select id="adUnit" class="nui-input"><option value="">Semua satuan kerja</option></select><label>Dibeli mulai <input id="adStart" class="nui-input" type="date"></label><label>s.d. <input id="adEnd" class="nui-input" type="date"></label><label>Nilai per <input id="adAsOf" class="nui-input" type="date"></label><button id="adRefresh" class="nui-btn"><i class="fa-solid fa-magnifying-glass"></i> Cari</button></div></article>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Total unit sesuai filter</small><strong id="adTotal">0</strong></article><article class="nui-card"><small>Nilai perolehan halaman</small><strong id="adPurchase">Rp0</strong></article><article class="nui-card"><small>Akumulasi penyusutan halaman</small><strong id="adAccumulated">Rp0</strong></article><article class="nui-card"><small>Nilai buku halaman</small><strong id="adBook">Rp0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Unit aset</th><th>Jenis / merk</th><th>Lokasi / unit kerja</th><th>Bulan / umur</th><th>Tanggal beli / terakhir</th><th>Perolehan</th><th>Akumulasi</th><th>Nilai buku</th><th></th></tr></thead><tbody id="adRows"><tr><td colspan="9">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="adPrev" class="nui-btn">← Sebelumnya</button><span id="adPager">Halaman 1</span><button id="adNext" class="nui-btn">Berikutnya →</button></div></article>
<dialog id="adDetailDialog" style="border:0;border-radius:16px;padding:24px;max-width:1100px;width:calc(100% - 32px)"><div class="nui-toolbar"><h2 style="flex:1">Histori Penyusutan Bulanan</h2><button id="adDetailClose" class="nui-btn">Tutup</button></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Bulan</th><th>Tanggal</th><th>Nilai Perolehan</th><th>Penyusutan/Bulan</th><th>Akumulasi</th><th>Nilai Buku</th><th>Keterangan</th></tr></thead><tbody id="adDetails"></tbody></table></div></dialog>
<dialog id="adSyncDialog" style="border:0;border-radius:16px;padding:24px;max-width:600px;width:calc(100% - 32px)"><form id="adSyncForm"><h2>Sinkronisasi Penyusutan Aset</h2><p>Membuat periode bulanan yang belum tersedia dengan rumus penyusutan existing.</p><label>Tanggal penyusutan *<input id="adTarget" class="nui-input" type="date" required></label><div id="adProgress" class="nui-alert" style="margin-top:12px">Processor siap dijalankan.</div><div class="nui-toolbar"><button id="adSyncClose" type="button" class="nui-btn">Tutup</button><button type="submit" class="nui-btn nui-btn-primary">Mulai Sinkronisasi</button></div></form></dialog></section>
<script>(function(){var root=document.getElementById('nuiAssetDepreciation'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,page=0,size=20,total=0,last=[],money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}),today=new Date().toISOString().slice(0,10);adAsOf.value=adTarget.value=today;var past=new Date();past.setMonth(past.getMonth()-6);adStart.value=past.toISOString().slice(0,10);adEnd.value=today;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function query(p,z){return{q:adSearch.value,brand:adBrand.value,assetTypeId:adType.value,roomId:adRoom.value,workUnitId:adUnit.value,start:adStart.value,end:adEnd.value,asOf:adAsOf.value,page:p==null?page:p,size:z||size}}async function call(action,body,q,id){var url=endpoint+'&action='+action+(id?'&id='+encodeURIComponent(id):'')+'&'+new URLSearchParams(q||{}),o={credentials:'same-origin'};if(body){o.method='POST';o.headers={'X-CSRF-Token':csrf,'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(body)}var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}function fill(s,a){a.forEach(function(x){var o=document.createElement('option');o.value=x.id;o.textContent=x.label;if(x.parentId!=null)o.dataset.parent=x.parentId;s.appendChild(o)})}async function options(){try{var j=await call('options');fill(adType,j.assetTypes);fill(adRoom,j.rooms);fill(adUnit,j.workUnits)}catch(e){console.error(e)}}async function load(){adRows.innerHTML='<tr><td colspan="9">Memuat data...</td></tr>';try{var j=await call('list',null,query());last=j.rows;total=j.total;adTotal.textContent=total;adPurchase.textContent=money.format(last.reduce(function(n,x){return n+x.purchaseValue},0));adAccumulated.textContent=money.format(last.reduce(function(n,x){return n+x.accumulated},0));adBook.textContent=money.format(last.reduce(function(n,x){return n+x.bookValue},0));adRows.innerHTML=last.map(function(x){return'<tr><td><strong>'+esc(x.name)+'</strong><br><code>'+esc(x.barcode)+'</code><br><small>'+esc(x.note)+'</small></td><td>'+esc(x.assetType)+'<br>'+esc(x.masterAsset)+' · '+esc(x.brand)+'</td><td>'+esc(x.room)+'<br>'+esc(x.workUnit)+'</td><td>'+esc(x.month)+' / '+esc(x.economicLife)+'</td><td>'+esc(x.purchaseDate)+'<br>'+esc(x.lastDate)+'</td><td>'+money.format(x.purchaseValue)+'</td><td>'+money.format(x.accumulated)+'<br><small>'+money.format(x.monthlyDepreciation)+'/bulan</small></td><td>'+money.format(x.bookValue)+'</td><td><button class="nui-btn ad-detail" data-id="'+x.id+'" title="Histori"><i class="fa-solid fa-clock-rotate-left"></i></button></td></tr>'}).join('')||'<tr><td colspan="9">Tidak ada detail aset.</td></tr>';adPager.textContent='Halaman '+(page+1);adPrev.disabled=page===0;adNext.disabled=(page+1)*size>=total}catch(e){adRows.innerHTML='<tr><td colspan="9">'+esc(e.message)+'</td></tr>'}}adRows.onclick=async function(e){var b=e.target.closest('.ad-detail');if(!b)return;adDetailDialog.showModal();adDetails.innerHTML='<tr><td colspan="7">Memuat...</td></tr>';try{var j=await call('details',null,{},b.dataset.id);adDetails.innerHTML=j.rows.map(function(x){return'<tr><td>'+esc(x.month)+'</td><td>'+esc(x.date)+'</td><td>'+money.format(x.purchaseValue)+'</td><td>'+money.format(x.monthly)+'</td><td>'+money.format(x.accumulated)+'</td><td>'+money.format(x.bookValue)+'</td><td>'+esc(x.note)+'</td></tr>'}).join('')||'<tr><td colspan="7">Belum ada periode penyusutan.</td></tr>'}catch(x){adDetails.innerHTML='<tr><td colspan="7">'+esc(x.message)+'</td></tr>'}};adDetailClose.onclick=function(){adDetailDialog.close()};adSync.onclick=function(){adSyncDialog.showModal();status()};adSyncClose.onclick=function(){adSyncDialog.close()};adSyncForm.onsubmit=async function(e){e.preventDefault();if(!confirm('Sinkronkan penyusutan sampai tanggal '+adTarget.value+'?'))return;try{await call('sync',{targetDate:adTarget.value});status()}catch(x){alert(x.message)}};async function status(){try{var j=await call('job'),x=j.job,p=x.total?Math.round(x.done*100/x.total):0;adProgress.textContent=x.running?'Memproses '+x.done+' dari '+x.total+' unit ('+p+'%), gagal '+x.failed:'Selesai '+x.done+' dari '+x.total+' unit, gagal '+x.failed;if(x.running)setTimeout(status,1000);else load()}catch(e){adProgress.textContent=e.message}}var timer;adSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[adBrand,adType,adRoom,adUnit,adStart,adEnd,adAsOf].forEach(function(x){x.onchange=function(){page=0;load()}});adRefresh.onclick=load;adPrev.onclick=function(){if(page){page--;load()}};adNext.onclick=function(){page++;load()};adExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,query(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['barcode','name','assetType','masterAsset','brand','room','workUnit','purchaseDate','lastDate','month','economicLife','purchaseValue','monthlyDepreciation','accumulated','bookValue','note'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='laporan-penyusutan-aset.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};options();load()})();</script>

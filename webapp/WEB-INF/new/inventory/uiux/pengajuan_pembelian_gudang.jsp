<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %>
<%!
private String pgH(Object v){if(v==null)return "";return String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String pgToken(){SecureRandom r=new SecureRandom();byte[] b=new byte[24];r.nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}
%><%
String pgCsrf=(String)session.getAttribute("newUiCsrfToken");if(pgCsrf==null){pgCsrf=pgToken();session.setAttribute("newUiCsrfToken",pgCsrf);}
NewUiPermission pgPermission=NewUiRouteGuard.permissionFor(request,"inventory","pengajuan_pembelian_gudang");boolean pgCanUpdate=pgPermission!=null&&pgPermission.isCanUpdate();
String pgMenuId=request.getParameter("menuId");String pgEndpoint=request.getContextPath()+"/new?service=1&module=inventory&page=pengajuan_pembelian_gudang"+(pgMenuId==null?"":"&menuId="+pgH(pgMenuId));
%>
<section class="nui-page" id="nuiPurchaseRequest" data-endpoint="<%=pgH(pgEndpoint)%>" data-csrf="<%=pgH(pgCsrf)%>" data-update="<%=pgCanUpdate%>">
 <header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Persediaan / Pengajuan Pembelian Gudang</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-warehouse"></i> WORKFLOW NATIVE</p><h1>Ambang Stok &amp; Pengajuan Pembelian</h1><p>Atur ambang minimum per produk dan gudang. Pengajuan otomatis diterbitkan ketika stok menyentuh ambang.</p></div><button class="nui-btn nui-btn-hero" id="pgRun" type="button" <%=pgCanUpdate?"":"disabled"%>><i class="fa-solid fa-arrows-rotate"></i> Jalankan Sekarang</button></header>
 <article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><strong>Ambang Stok per Produk &amp; Gudang</strong><span style="flex:1"></span><button class="nui-btn nui-btn-primary" id="pgAdd" type="button" <%=pgCanUpdate?"":"disabled"%>><i class="fa-solid fa-plus"></i> Tambah Ambang</button></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Produk</th><th>Gudang</th><th>Ambang Minimum</th><th>Aktif</th><th>Keterangan</th><th>Aksi</th></tr></thead><tbody id="pgThresholdRows"><tr><td colspan="6">Memuat data...</td></tr></tbody></table></div></article>
 <article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><strong>Pengajuan Pembelian</strong><input id="pgSearch" class="nui-input" type="search" placeholder="Cari produk, gudang, status..." style="max-width:360px"><span id="pgCount" class="nui-chip">0 pengajuan</span></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Produk</th><th>Gudang Asal</th><th>Tujuan</th><th>Qty / Stok</th><th>Dibuat</th><th>Sumber</th><th>Status</th><th>Keterangan</th></tr></thead><tbody id="pgRequestRows"><tr><td colspan="8">Memuat data...</td></tr></tbody></table></div></article>
</section>
<script>(function(){var root=document.getElementById('nuiPurchaseRequest'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canUpdate=root.dataset.update==='true',data={thresholds:[],requests:[],products:[],warehouses:[]};function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function options(items,selected){return items.map(function(o){return'<option value="'+o.id+'"'+(String(o.id)===String(selected)?' selected':'')+'>'+esc(o.label)+'</option>'}).join('')}function thresholdRow(r){return'<tr data-id="'+(r.id||'')+'"><td><select class="nui-input pg-product" '+(!canUpdate?'disabled':'')+'><option value="">Pilih produk</option>'+options(data.products,r.productId)+'</select></td><td><select class="nui-input pg-warehouse" '+(!canUpdate?'disabled':'')+'><option value="">Pilih gudang</option>'+options(data.warehouses,r.warehouseId)+'</select></td><td><input class="nui-input pg-min" type="number" min="0" step="0.01" value="'+(r.minimum||0)+'" '+(!canUpdate?'disabled':'')+'></td><td><input class="pg-active" type="checkbox" '+(r.active!==false?'checked':'')+' '+(!canUpdate?'disabled':'')+'></td><td><input class="nui-input pg-note" value="'+esc(r.note)+'" '+(!canUpdate?'disabled':'')+'></td><td>'+(canUpdate?'<button class="nui-btn pg-save" type="button"><i class="fa-solid fa-floppy-disk"></i> Simpan</button> '+(r.id?'<button class="nui-btn pg-delete" type="button"><i class="fa-solid fa-trash"></i></button>':''):'Hanya baca')+'</td></tr>'}function paint(){document.getElementById('pgThresholdRows').innerHTML=data.thresholds.map(thresholdRow).join('')||'<tr><td colspan="6">Belum ada ambang stok.</td></tr>';filter()}function filter(){var q=document.getElementById('pgSearch').value.toLowerCase(),rows=data.requests.filter(function(r){return[r.product,r.source,r.destination,r.status,r.note].join(' ').toLowerCase().indexOf(q)>=0}),html=rows.map(function(r){var date=r.created?new Date(r.created).toLocaleString('id-ID'):'-';return'<tr><td><strong>'+esc(r.product)+'</strong></td><td>'+esc(r.source)+'</td><td>'+esc(r.destination)+'</td><td>'+r.quantity+' / '+r.stock+'</td><td>'+esc(date)+'</td><td>'+(r.automatic?'Otomatis':'Manual')+'</td><td><select class="nui-input pg-status" data-id="'+r.id+'" '+(!canUpdate?'disabled':'')+'>'+['BARU','DIPROSES','SELESAI','DIBATALKAN'].map(function(s){return'<option'+(s===r.status?' selected':'')+'>'+s+'</option>'}).join('')+'</select></td><td>'+esc(r.note)+'</td></tr>'}).join('');document.getElementById('pgRequestRows').innerHTML=html||'<tr><td colspan="8">Tidak ada pengajuan yang cocok.</td></tr>';document.getElementById('pgCount').textContent=rows.length+' pengajuan'}async function call(action,body){var opt={credentials:'same-origin'};if(body){opt.method='POST';opt.headers={'X-CSRF-Token':csrf,'Content-Type':'application/x-www-form-urlencoded'};opt.body=new URLSearchParams(body)}var r=await fetch(endpoint+'&action='+encodeURIComponent(action),opt),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');data=j;paint();return j}document.getElementById('pgAdd').onclick=function(){data.thresholds.unshift({id:null,minimum:0,active:true,note:''});paint()};document.getElementById('pgThresholdRows').onclick=function(e){var tr=e.target.closest('tr');if(!tr)return;if(e.target.closest('.pg-save')){call('save_threshold',{id:tr.dataset.id,productId:tr.querySelector('.pg-product').value,warehouseId:tr.querySelector('.pg-warehouse').value,minimum:tr.querySelector('.pg-min').value,active:tr.querySelector('.pg-active').checked,note:tr.querySelector('.pg-note').value}).catch(function(x){alert(x.message)})}if(e.target.closest('.pg-delete')&&confirm('Yakin hapus ambang stok ini?'))call('delete_threshold',{id:tr.dataset.id}).catch(function(x){alert(x.message)})};document.getElementById('pgRequestRows').onchange=function(e){if(e.target.classList.contains('pg-status'))call('update_status',{id:e.target.dataset.id,status:e.target.value}).catch(function(x){alert(x.message)})};document.getElementById('pgRun').onclick=function(){if(confirm('Jalankan pengecekan ambang stok sekarang?'))call('run_now',{}).then(function(j){alert((j.created||0)+' pengajuan baru diterbitkan.')}).catch(function(x){alert(x.message)})};document.getElementById('pgSearch').oninput=filter;call('list').catch(function(x){document.getElementById('pgRequestRows').innerHTML='<tr><td colspan="8">'+esc(x.message)+'</td></tr>'})})();</script>

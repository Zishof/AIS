<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.Common" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %>
<%!private String pbH(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String pbToken(){SecureRandom r=new SecureRandom();byte[] b=new byte[24];r.nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%>
<%String pbCsrf=(String)session.getAttribute("newUiCsrfToken");if(pbCsrf==null){pbCsrf=pbToken();session.setAttribute("newUiCsrfToken",pbCsrf);}NewUiPermission pbP=NewUiRouteGuard.permissionFor(request,"inventory","pembelian");boolean pbStudent=Common.getCurrentUser(request)!=null&&Common.getCurrentUser(request).getSiswa()!=null;boolean pbC=!pbStudent&&pbP!=null&&pbP.isCanCreate(),pbU=!pbStudent&&pbP!=null&&pbP.isCanUpdate(),pbD=!pbStudent&&pbP!=null&&pbP.isCanDelete();String pbMenu=request.getParameter("menuId"),pbEndpoint=request.getContextPath()+"/new?service=1&module=inventory&page=pembelian"+(pbMenu==null?"":"&menuId="+pbH(pbMenu));%>
<section class="nui-page" id="nuiPurchase" data-endpoint="<%=pbH(pbEndpoint)%>" data-csrf="<%=pbH(pbCsrf)%>" data-create="<%=pbC%>" data-update="<%=pbU%>" data-delete="<%=pbD%>">
 <header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Persediaan / Pembelian</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-cash-register"></i> POS NATIVE</p><h1>Dashboard Pembelian POS</h1><p>Riwayat invoice, pelanggan, toko, produk, dan total belanja dengan validasi saldo serta batas harian.</p></div><button class="nui-btn nui-btn-hero" id="pbAdd" type="button" <%=pbC?"":"disabled"%>><i class="fa-solid fa-cart-plus"></i> Transaksi Baru</button></header>
 <article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="pbSearch" class="nui-input" type="search" placeholder="Cari invoice, pelanggan, atau produk..." style="min-width:260px"><select id="pbShopFilter" class="nui-input"><option value="">Semua toko</option></select><input id="pbStart" class="nui-input" type="date"><input id="pbEnd" class="nui-input" type="date"><button id="pbRefresh" class="nui-btn" type="button"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button><span style="flex:1"></span><span id="pbSummary" class="nui-chip">Memuat...</span></div>
 <div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Invoice / Waktu</th><th>Produk</th><th>Qty</th><th>Harga</th><th>Total</th><th>Pelanggan</th><th>Toko</th><th>Keterangan</th><th>Aksi</th></tr></thead><tbody id="pbRows"><tr><td colspan="9">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="pbPrev" class="nui-btn" type="button">← Sebelumnya</button><span id="pbPage">Halaman 1</span><button id="pbNext" class="nui-btn" type="button">Berikutnya →</button></div></article>
 <dialog id="pbDialog" class="nui-dialog" style="width:min(980px,96vw)"><form method="dialog"><div class="nui-toolbar"><h2 id="pbTitle" style="margin:0">Transaksi Pembelian</h2><span style="flex:1"></span><button class="nui-btn" value="cancel" type="submit"><i class="fa-solid fa-xmark"></i></button></div></form><div class="nui-form-grid"><label>Invoice *<input id="pbInvoice" class="nui-input"></label><label>Toko / Penjual *<select id="pbShop" class="nui-input"></select></label><label>Jenis Pelanggan<select id="pbMemberType" class="nui-input"><option value="student">Siswa</option><option value="college">Mahasiswa</option><option value="general">Umum</option></select></label><label>Cari Pelanggan<input id="pbMemberSearch" class="nui-input" placeholder="NIS/NIM atau nama"></label><label style="grid-column:span 2">Pelanggan<select id="pbMember" class="nui-input"><option value="">Pilih pelanggan</option></select></label><label style="grid-column:span 2">Keterangan<textarea id="pbNote" class="nui-input" rows="2"></textarea></label></div>
 <div class="nui-toolbar" style="margin-top:12px"><strong>Item yang dibeli</strong><input id="pbProductSearch" class="nui-input" placeholder="Kode, barcode, atau nama produk" style="min-width:280px"><select id="pbProduct" class="nui-input"><option value="">Pilih produk</option></select><input id="pbQty" class="nui-input" type="number" value="1" min="0.01" step="0.01" style="width:100px"><button id="pbAddLine" class="nui-btn nui-btn-primary" type="button"><i class="fa-solid fa-plus"></i> Tambah</button></div><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Kode</th><th>Produk</th><th>Harga</th><th>Qty</th><th>Jumlah</th><th></th></tr></thead><tbody id="pbCart"></tbody></table></div><div class="nui-toolbar"><strong id="pbCartTotal">TOTAL: Rp0</strong><span style="flex:1"></span><button id="pbCancel" class="nui-btn" type="button">Batal</button><button id="pbSave" class="nui-btn nui-btn-primary" type="button"><i class="fa-solid fa-floppy-disk"></i> Simpan</button></div></dialog>
</section>
<script>(function(){var f=document.getElementById('pbShopFilter');f.dataset.selected='';f.addEventListener('change',function(){f.dataset.selected=f.value});new MutationObserver(function(){if(f.dataset.selected)f.value=f.dataset.selected}).observe(f,{childList:true});})();</script>
<style>#pbDialog::backdrop{background:rgba(15,23,42,.55)}#pbDialog{border:0;border-radius:18px;padding:20px;box-shadow:0 24px 60px rgba(15,23,42,.3)}.nui-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.nui-form-grid label{display:grid;gap:5px;font-weight:700}@media(max-width:700px){.nui-form-grid{grid-template-columns:1fr}.nui-form-grid label{grid-column:auto!important}}</style>
<script>(function(){var root=document.getElementById('nuiPurchase'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canC=root.dataset.create==='true',canU=root.dataset.update==='true',canD=root.dataset.delete==='true',state={page:0,size:20,total:0,shops:[],rows:[],cart:[],products:[],edit:null},money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function shopOptions(blank){return(blank?'<option value="">Semua toko</option>':'<option value="">Pilih toko</option>')+state.shops.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('')}async function call(action,body,query){var url=endpoint+'&action='+action+(query?'&'+new URLSearchParams(query):''),opt={credentials:'same-origin'};if(body){opt.method='POST';opt.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};opt.body=new URLSearchParams(body)}var r=await fetch(url,opt),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}function filters(){return{q:pbSearch.value,shopId:pbShopFilter.value,start:pbStart.value,end:pbEnd.value,page:state.page,size:state.size}}async function load(){pbRows.innerHTML='<tr><td colspan="9">Memuat data...</td></tr>';try{var j=await call('list',null,filters());state.rows=j.rows;state.shops=j.shops;state.total=j.total;pbShopFilter.innerHTML=shopOptions(true);pbShop.innerHTML=shopOptions(false);paintRows(j)}catch(e){pbRows.innerHTML='<tr><td colspan="9">'+esc(e.message)+'</td></tr>'}}function paintRows(j){pbRows.innerHTML=j.rows.map(function(r){return'<tr><td><strong>'+esc(r.invoice)+'</strong><br><small>'+(r.time?new Date(r.time).toLocaleString('id-ID'):'-')+'</small></td><td>'+esc(r.productCode)+' '+esc(r.product)+'</td><td>'+r.quantity+'</td><td>'+money.format(r.unitPrice)+'</td><td><strong>'+money.format(r.amount)+'</strong></td><td>'+esc(r.member)+'</td><td>'+esc(r.shop)+'</td><td>'+esc(r.note)+'</td><td>'+(canU?'<button class="nui-btn pb-edit" data-id="'+r.id+'"><i class="fa-solid fa-pen"></i></button> ':'')+(canD?'<button class="nui-btn pb-delete" data-id="'+r.id+'"><i class="fa-solid fa-trash"></i></button>':'')+'</td></tr>'}).join('')||'<tr><td colspan="9">Belum ada transaksi.</td></tr>';pbSummary.textContent=j.total+' baris · '+money.format(j.grandTotal);pbPage.textContent='Halaman '+(state.page+1);pbPrev.disabled=state.page===0;pbNext.disabled=(state.page+1)*state.size>=j.total}function reset(row){state.edit=row||null;state.cart=[];pbTitle.textContent=row?'Ubah Pembelian':'Transaksi Pembelian Baru';pbInvoice.value=row?row.invoice:'INV-'+Date.now();pbInvoice.disabled=!!row;pbNote.value=row?row.note:'';pbShop.value=row?row.shopId:'';pbMemberType.value=row&&row.collegeStudentId?'college':row&&row.studentId?'student':'general';pbMember.innerHTML='<option value="">'+esc(row?row.member:'Pilih pelanggan')+'</option>';pbMember.value='';if(row){pbMember.innerHTML='<option value="'+(row.studentId||row.collegeStudentId||'')+'">'+esc(row.member)+'</option>';pbMember.value=row.studentId||row.collegeStudentId||'';state.cart=[{productId:row.productId,code:row.productCode,label:row.product,price:row.unitPrice,quantity:row.quantity}]}paintCart();pbDialog.showModal()}function paintCart(){pbCart.innerHTML=state.cart.map(function(x,i){return'<tr><td>'+esc(x.code)+'</td><td>'+esc(x.label)+'</td><td>'+money.format(x.price)+'</td><td><input class="nui-input pb-line-qty" data-i="'+i+'" type="number" min="0.01" step="0.01" value="'+x.quantity+'" style="width:90px"></td><td>'+money.format(x.price*x.quantity)+'</td><td><button class="nui-btn pb-line-remove" data-i="'+i+'"><i class="fa-solid fa-trash"></i></button></td></tr>'}).join('')||'<tr><td colspan="6">Scan/cari produk lalu tambahkan ke transaksi.</td></tr>';pbCartTotal.textContent='TOTAL: '+money.format(state.cart.reduce(function(a,x){return a+x.price*x.quantity},0))}async function products(){if(!pbShop.value)return;var j=await call('products',null,{shopId:pbShop.value,q:pbProductSearch.value});state.products=j.options;pbProduct.innerHTML='<option value="">Pilih produk</option>'+j.options.map(function(x){return'<option value="'+x.id+'">'+esc((x.code||x.barcode||'')+' · '+x.label+' · '+money.format(x.price))+'</option>'}).join('')}async function members(){if(pbMemberType.value==='general'){pbMember.innerHTML='<option value="">Masyarakat umum</option>';return}var j=await call('members',null,{type:pbMemberType.value,q:pbMemberSearch.value});pbMember.innerHTML='<option value="">Pilih pelanggan</option>'+j.options.map(function(x){return'<option value="'+x.id+'">'+esc((x.code||'')+' · '+x.label)+'</option>'}).join('')}pbAdd.onclick=function(){reset(null)};pbRefresh.onclick=function(){state.page=0;load()};pbSearch.oninput=debounce(function(){state.page=0;load()},350);pbShopFilter.onchange=pbStart.onchange=pbEnd.onchange=function(){state.page=0;load()};pbPrev.onclick=function(){if(state.page>0){state.page--;load()}};pbNext.onclick=function(){state.page++;load()};pbRows.onclick=function(e){var id=e.target.closest('[data-id]');if(!id)return;var row=state.rows.find(function(x){return String(x.id)===id.dataset.id});if(e.target.closest('.pb-edit'))reset(row);if(e.target.closest('.pb-delete')&&confirm('Hapus baris pembelian ini?'))call('delete',{id:id.dataset.id}).then(load).catch(function(x){alert(x.message)})};pbShop.onchange=function(){pbProductSearch.value='';products()};pbProductSearch.oninput=debounce(products,250);pbMemberSearch.oninput=debounce(members,250);pbMemberType.onchange=members;pbAddLine.onclick=function(){var p=state.products.find(function(x){return String(x.id)===pbProduct.value}),q=parseFloat(pbQty.value);if(!p||!(q>0))return alert('Pilih produk dan qty yang valid.');var old=state.cart.find(function(x){return x.productId===p.id});if(old)old.quantity+=q;else state.cart.push({productId:p.id,code:p.code||p.barcode,label:p.label,price:p.price,quantity:q});paintCart()};pbCart.oninput=function(e){if(e.target.classList.contains('pb-line-qty')){state.cart[+e.target.dataset.i].quantity=parseFloat(e.target.value)||0;paintCart()}};pbCart.onclick=function(e){var b=e.target.closest('.pb-line-remove');if(b){state.cart.splice(+b.dataset.i,1);paintCart()}};pbCancel.onclick=function(){pbDialog.close()};pbSave.onclick=async function(){if(!state.cart.length)return alert('Minimal satu barang wajib dipilih.');var type=pbMemberType.value,body={id:state.edit?state.edit.id:'',invoice:pbInvoice.value,shopId:pbShop.value,studentId:type==='student'?pbMember.value:'',collegeStudentId:type==='college'?pbMember.value:'',note:pbNote.value,items:JSON.stringify(state.cart.map(function(x){return{productId:x.productId,quantity:x.quantity}}))};try{pbSave.disabled=true;await call('save',body);pbDialog.close();await load()}catch(e){alert(e.message)}finally{pbSave.disabled=false}};function debounce(f,n){var t;return function(){clearTimeout(t);t=setTimeout(f,n)}}load()})();</script>

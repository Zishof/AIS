<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String paH(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String paToken(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String paCsrf=(String)session.getAttribute("newUiCsrfToken");if(paCsrf==null){paCsrf=paToken();session.setAttribute("newUiCsrfToken",paCsrf);}NewUiPermission paP=NewUiRouteGuard.permissionFor(request,"rab","penggunaan_anggaran");boolean paU=paP!=null&&paP.isCanUpdate();String paMenu=request.getParameter("menuId"),paEndpoint=request.getContextPath()+"/new?service=1&module=rab&page=penggunaan_anggaran"+(paMenu==null?"":"&menuId="+paH(paMenu));%>
<section class="nui-page" id="nuiBudgetUse" data-endpoint="<%=paH(paEndpoint)%>" data-csrf="<%=paH(paCsrf)%>" data-update="<%=paU%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">RAB &amp; Anggaran / Penggunaan Anggaran</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-chart-line"></i> REALISASI ANGGARAN</p><h1>Penggunaan Anggaran</h1><p>Pantau realisasi dari seluruh rantai transaksi, status transfer, SOP, dan workspace anggaran.</p></div><div class="nui-toolbar"><button id="paExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-export"></i> Ekspor</button><button id="paReprocess" class="nui-btn nui-btn-hero" <%=paU?"":"disabled"%>><i class="fa-solid fa-arrows-rotate"></i> Proses Ulang</button></div></header>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Total transaksi</small><strong id="paTotal">0</strong></article><article class="nui-card"><small>Nilai penggunaan</small><strong id="paAmount">Rp0</strong></article><article class="nui-card"><small>Aktif</small><strong id="paActive">0</strong></article><article class="nui-card"><small>Nonaktif</small><strong id="paInactive">0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="paSearch" class="nui-input" type="search" placeholder="Cari kode atau nama penggunaan..."><select id="paWorkspace" class="nui-input"><option value="">Semua workspace</option></select><input id="paStart" class="nui-input" type="date" title="Tanggal mulai"><input id="paEnd" class="nui-input" type="date" title="Tanggal akhir"><label><input id="paActiveOnly" type="checkbox" checked> Hanya aktif</label><button id="paRefresh" class="nui-btn"><i class="fa-solid fa-magnifying-glass"></i> Cari</button></div>
<details style="margin-top:10px" open><summary><strong>Jenis sumber transaksi</strong></summary><div id="paSources" class="nui-toolbar" style="margin-top:8px"><label><input data-source="jurnal" type="checkbox" checked> Jurnal Umum</label><label><input data-source="pengadaan" type="checkbox" checked> Pengadaan</label><label><input data-source="uang_muka" type="checkbox" checked> Uang Muka</label><label><input data-source="pertanggungjawaban" type="checkbox" checked> Pertanggungjawaban</label><label><input data-source="saldo_awal" type="checkbox" checked> Saldo Awal</label><label><input data-source="gaji" type="checkbox" checked> Gaji</label><label><input data-source="kas_kecil" type="checkbox" checked> Kas Kecil</label><label><input data-source="kas_besar" type="checkbox" checked> Kas Besar</label></div></details></article>
<article class="nui-card" style="margin-top:14px"><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Transaksi</th><th>Waktu / Sumber</th><th>Workspace</th><th>Anggaran</th><th>Penggunaan</th><th>Keterangan / Transfer</th><th>SOP</th><th>Status</th></tr></thead><tbody id="paRows"><tr><td colspan="8">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="paPrev" class="nui-btn">← Sebelumnya</button><span id="paPage">Halaman 1</span><button id="paNext" class="nui-btn">Berikutnya →</button></div></article>
<article class="nui-card" style="margin-top:14px"><h3>Komposisi sumber</h3><div id="paComposition" class="nui-dashboard-kpis"></div></article>
<jsp:include page="/WEB-INF/new/rab/uiux/penggunaan_anggaran_history_script.jsp" />
<dialog id="paProgress" style="border:0;border-radius:16px;padding:24px;max-width:520px;width:calc(100% - 32px)"><h3>Proses Ulang Penggunaan Anggaran</h3><p id="paProgressText">Menyiapkan proses...</p><progress id="paProgressBar" max="100" value="0" style="width:100%"></progress><div id="paProgressResult" style="margin-top:12px"></div><div class="nui-toolbar" style="margin-top:16px"><button id="paProgressClose" class="nui-btn" disabled>Tutup</button></div></dialog><dialog id="paHistory" style="border:0;border-radius:16px;padding:24px;max-width:720px;width:calc(100% - 32px)"><h3>Riwayat Perubahan</h3><div id="paHistoryRows">Memuat riwayat...</div><div class="nui-toolbar" style="margin-top:16px"><button id="paHistoryClose" class="nui-btn">Tutup</button></div></dialog></section>
<script>(function(){var root=document.getElementById('nuiBudgetUse'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,canU=root.dataset.update==='true',page=0,size=20,total=0,last=[],money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function params(p,z){var x={q:paSearch.value,workspaceId:paWorkspace.value,start:paStart.value,end:paEnd.value,active:paActiveOnly.checked,page:p==null?page:p,size:z||size};paSources.querySelectorAll('[data-source]').forEach(function(e){x['source_'+e.dataset.source]=e.checked});return x}async function call(action,body,query){var o={credentials:'same-origin'},url=endpoint+'&action='+action;if(body){o.method='POST';o.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};o.body=new URLSearchParams(body)}else url+='&'+new URLSearchParams(query||params());var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}async function load(){try{var keep=paWorkspace.value,j=await call('list');last=j.rows;total=j.total;paWorkspace.innerHTML='<option value="">Semua workspace</option>'+j.workspaces.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('');paWorkspace.value=keep;paTotal.textContent=j.total;paAmount.textContent=money.format(j.totalAmount);paActive.textContent=j.active;paInactive.textContent=j.inactive;paRows.innerHTML=j.rows.map(function(x){return'<tr><td><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.code)+' · '+esc(x.ref)+'</small></td><td>'+(x.time?new Date(x.time).toLocaleString('id-ID'):'-')+'<br><span class="nui-chip">'+esc(x.source)+'</span></td><td>'+esc(x.workspace)+'</td><td>'+money.format(x.budget)+'</td><td><strong>'+money.format(x.amount)+'</strong></td><td>'+esc(x.note)+(x.transferStatus?'<br><span class="nui-chip">'+esc(x.transferStatus)+'</span>':'')+'</td><td>'+(x.sopId?'<button class="nui-btn pa-sop" data-id="'+x.sopId+'" title="'+esc(x.sop)+'">'+esc(x.sopName||('SOP #'+x.sopId))+'</button>':'-')+'</td><td><span class="nui-chip">'+(x.active?'Aktif':'Nonaktif')+'</span></td></tr>'}).join('')||'<tr><td colspan="8">Tidak ada penggunaan anggaran sesuai filter.</td></tr>';paComposition.innerHTML=Object.keys(j.sourceCounts).map(function(k){return'<article class="nui-card"><small>'+esc(k)+'</small><strong>'+j.sourceCounts[k]+'</strong></article>'}).join('')||'<p>Belum ada data.</p>';paPage.textContent='Halaman '+(page+1);paPrev.disabled=page===0;paNext.disabled=(page+1)*size>=total}catch(e){paRows.innerHTML='<tr><td colspan="8">'+esc(e.message)+'</td></tr>'}}var timer;paSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[paWorkspace,paStart,paEnd,paActiveOnly].forEach(function(x){x.onchange=function(){page=0;load()}});paSources.onchange=function(){page=0;load()};paRefresh.onclick=function(){page=0;load()};paPrev.onclick=function(){if(page){page--;load()}};paNext.onclick=function(){page++;load()};paRows.onclick=function(e){var b=e.target.closest('.pa-sop');if(b)alert('SOP #'+b.dataset.id+'\n'+b.title)};
paExport.onclick=async function(){paExport.disabled=true;try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,params(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['code','name','time','source','workspace','budget','amount','note','transferStatus','sopName','active'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='penggunaan-anggaran.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}finally{paExport.disabled=false}};
paReprocess.onclick=async function(){if(!canU||!confirm('Proses ulang seluruh sumber yang dipilih untuk rentang tanggal ini? Proses dapat memerlukan waktu.'))return;try{var j=await call('reprocess_start',params());paProgress.showModal();paProgressClose.disabled=true;paProgressBar.value=0;paProgressResult.textContent='';poll(j.jobId)}catch(e){alert(e.message)}};async function poll(id){try{var j=await call('reprocess_status',null,{jobId:id});paProgressBar.value=j.percent||0;paProgressText.textContent=(j.percent||0)+'% · '+j.message;if(j.state==='DONE'){paProgressResult.textContent=(j.processed||0)+' sumber transaksi diproses; '+(j.duplicatesRemoved||0)+' duplikat dibersihkan.';paProgressClose.disabled=false;load();return}if(j.state==='FAILED'){paProgressResult.textContent=j.message;paProgressClose.disabled=false;return}setTimeout(function(){poll(id)},1200)}catch(e){paProgressResult.textContent=e.message;paProgressClose.disabled=false}}paProgressClose.onclick=function(){paProgress.close()};function ymd(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}var now=new Date(),old=new Date(now.getFullYear()-20,now.getMonth(),now.getDate()),tomorrow=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1);paStart.value=ymd(old);paEnd.value=ymd(tomorrow);load()})();</script>

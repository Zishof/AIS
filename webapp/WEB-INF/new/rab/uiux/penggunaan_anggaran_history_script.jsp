<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<script>(function(){function start(){var root=document.getElementById('nuiBudgetUse'),rows=document.getElementById('paRows'),dialog=document.getElementById('paHistory'),body=document.getElementById('paHistoryRows'),close=document.getElementById('paHistoryClose');if(!root||!rows||!dialog)return;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function query(){var p={action:'list',q:paSearch.value,workspaceId:paWorkspace.value,start:paStart.value,end:paEnd.value,active:paActiveOnly.checked,page:Math.max(0,parseInt((paPage.textContent.match(/\d+/)||['1'])[0],10)-1),size:20};paSources.querySelectorAll('[data-source]').forEach(function(e){p['source_'+e.dataset.source]=e.checked});return p}function decorate(){rows.querySelectorAll('tr td:first-child strong').forEach(function(x){x.style.cursor='pointer';x.style.textDecoration='underline';x.title='Klik untuk melihat riwayat perubahan'})}new MutationObserver(decorate).observe(rows,{childList:true,subtree:true});decorate();rows.addEventListener('click',async function(e){var name=e.target.closest('td:first-child strong');if(!name)return;var tr=name.closest('tr'),index=Array.prototype.indexOf.call(rows.children,tr);if(index<0)return;dialog.showModal();body.textContent='Memuat riwayat...';try{var lr=await fetch(root.dataset.endpoint+'&'+new URLSearchParams(query()),{credentials:'same-origin'}),list=await lr.json();if(!lr.ok||!list.rows[index])throw new Error(list.message||'Data penggunaan tidak ditemukan.');var hr=await fetch(root.dataset.endpoint+'&action=history&id='+encodeURIComponent(list.rows[index].id),{credentials:'same-origin'}),j=await hr.json();if(!hr.ok)throw new Error(j.message||'Riwayat gagal dimuat.');body.innerHTML=j.history.map(function(x){return'<article class="nui-card" style="margin-top:8px;padding:12px"><strong>Revisi '+x.revision+' · '+(['Tambah','Ubah','Hapus'][x.type]||x.type)+'</strong><br><small>'+(x.timestamp?new Date(x.timestamp).toLocaleString('id-ID'):'-')+' · '+esc(x.by)+'</small><p>'+esc(x.code)+' · '+esc(x.name)+' · '+new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(x.amount)+'</p><small>'+esc(x.note)+'</small></article>'}).join('')||'<p>Belum ada riwayat audit.</p>'}catch(x){body.textContent=x.message}});close.onclick=function(){dialog.close()}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else setTimeout(start,0)})();</script>

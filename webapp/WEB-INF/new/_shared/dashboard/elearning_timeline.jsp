<%@ page import="ais.common.Common" %><%@ page import="ais.database.model.Tbmuser" %>
<%!
private String eltH(Object value){if(value==null)return "";return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
%>
<%
Tbmuser eltUser=null;try{eltUser=Common.getCurrentUser(request);}catch(Exception ignored){}
String eltName=eltUser==null?"Pengguna":eltUser.getUserNama();if(eltName==null||eltName.trim().length()==0)eltName="Pengguna";
String eltInitial=eltName.substring(0,1).toUpperCase();String eltApi=request.getContextPath()+"/api";String eltDashboard=request.getContextPath()+"/new?frame=1&dashboard=elearning";
%>
<style>
.elt-page{max-width:1480px;margin:0 auto;padding:20px 18px 44px;color:#17223b}.elt-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.elt-head h1{margin:4px 0 3px;font-size:28px}.elt-head p{margin:0;color:#65728a}.elt-layout{display:grid;grid-template-columns:260px minmax(0,720px) 290px;gap:18px;align-items:start}.elt-sticky{position:sticky;top:16px}.elt-panel,.elt-card{background:#fff;border:1px solid #dfe5ee;border-radius:16px;box-shadow:0 2px 10px rgba(19,33,68,.05)}.elt-panel{padding:15px}.elt-panel h2{font-size:15px;margin:0 0 12px}.elt-back{display:inline-flex;gap:8px;align-items:center;color:#3153ca;text-decoration:none;font-weight:700}.elt-search{display:flex;align-items:center;gap:9px;border:1px solid #ced7e5;border-radius:22px;padding:9px 13px;background:#f7f9fc}.elt-search input{border:0;outline:0;background:transparent;width:100%}.elt-filter-list{display:grid;gap:7px;margin-top:12px}.elt-filter{display:flex;align-items:center;gap:9px;padding:9px 10px;border:0;border-radius:10px;background:transparent;text-align:left;color:#31415d}.elt-filter:hover,.elt-filter.is-active{background:#eaf0ff;color:#2454d8}.elt-filter i{width:20px;text-align:center}.elt-date-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.elt-field label{display:block;font-size:11px;color:#68758b;margin-bottom:4px}.elt-field input,.elt-field select{width:100%;border:1px solid #ced7e5;border-radius:9px;padding:8px;background:#fff}.elt-profile{display:flex;align-items:center;gap:10px}.elt-avatar{width:42px;height:42px;border-radius:50%;object-fit:cover;background:#e7ecff;color:#3153ca;display:grid;place-items:center;font-weight:800;flex:0 0 auto}.elt-composer{padding:14px;margin-bottom:14px}.elt-composer-row{display:flex;gap:10px;align-items:center}.elt-composer button{flex:1;text-align:left;border:0;border-radius:22px;padding:11px 15px;background:#f0f2f5;color:#667085}.elt-quick{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #e7ebf1;margin-top:12px;padding-top:9px}.elt-quick button{border:0;background:transparent;padding:8px 4px;text-align:center;color:#4d5e78;font-weight:700;font-size:12px}.elt-quick i{margin-right:5px}.elt-feed{display:grid;gap:14px}.elt-card{overflow:hidden}.elt-card-head{display:flex;gap:10px;padding:15px 16px 10px}.elt-card-head-main{min-width:0;flex:1}.elt-card-head strong{display:block}.elt-meta{font-size:12px;color:#6f7b91;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.elt-type{font-size:11px;font-weight:800;padding:4px 8px;border-radius:999px;background:#eaf0ff;color:#2759d7}.elt-body{padding:0 16px 13px}.elt-body h3{font-size:17px;margin:2px 0 7px}.elt-body p{margin:0;color:#3f4c63;line-height:1.55;white-space:pre-wrap}.elt-stats{display:flex;gap:14px;padding:0 16px 10px;color:#65728a;font-size:12px}.elt-actions{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #e5e9f0;padding:5px 8px}.elt-actions button,.elt-actions a{border:0;background:transparent;color:#536078;padding:9px 3px;text-decoration:none;text-align:center;font-weight:700;font-size:12px;border-radius:8px}.elt-actions button:hover,.elt-actions a:hover{background:#f0f3f8}.elt-action-hidden{display:none!important}.elt-assets{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.elt-pill{border-radius:8px;padding:6px 9px;background:#f1f4f9;font-size:12px}.elt-empty,.elt-error,.elt-loading{padding:34px;text-align:center}.elt-error{color:#b42318}.elt-pagination{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:16px}.elt-btn{border:1px solid #ccd5e3;background:#fff;border-radius:9px;padding:9px 12px;font-weight:700;color:#34425b}.elt-btn-primary{background:#2f5bd5;color:#fff;border-color:#2f5bd5}.elt-summary{display:grid;grid-template-columns:1fr 1fr;gap:9px}.elt-summary div{padding:12px;border-radius:11px;background:#f5f7fb}.elt-summary strong{display:block;font-size:20px}.elt-dialog{width:min(720px,calc(100vw - 28px));border:0;border-radius:16px;padding:0;box-shadow:0 20px 70px rgba(0,0,0,.28)}.elt-dialog::backdrop{background:rgba(15,23,42,.52)}.elt-dialog header{display:flex;align-items:center;justify-content:space-between;padding:15px 18px;border-bottom:1px solid #e5e9f0}.elt-dialog header h2{font-size:18px;margin:0}.elt-dialog-content{padding:16px;max-height:65vh;overflow:auto}.elt-dialog textarea{width:100%;min-height:115px;border:1px solid #ccd5e3;border-radius:10px;padding:11px}.elt-dialog footer{display:flex;justify-content:flex-end;gap:8px;padding:12px 16px;border-top:1px solid #e5e9f0}.elt-detail-list{display:grid;gap:10px}.elt-detail-item{border:1px solid #e0e6ef;border-radius:11px;padding:11px}.elt-detail-item strong{display:block}.elt-comment{display:flex;gap:9px;margin:8px 0}.elt-comment-body{background:#f0f2f5;border-radius:14px;padding:9px 12px;flex:1}.elt-comment-children{margin-left:26px}.elt-mobile-filter{display:none}.elt-skeleton{height:160px;border-radius:16px;background:linear-gradient(90deg,#eef1f5 25%,#f8f9fb 40%,#eef1f5 60%);background-size:300% 100%;animation:eltShimmer 1.2s infinite}@keyframes eltShimmer{to{background-position:-100% 0}}
@media(max-width:1100px){.elt-layout{grid-template-columns:230px minmax(0,1fr)}.elt-right{display:none}}@media(max-width:760px){.elt-page{padding:12px 10px 34px}.elt-head{align-items:flex-start}.elt-layout{display:block}.elt-left{display:none}.elt-mobile-filter{display:inline-flex}.elt-actions{grid-template-columns:repeat(2,1fr)}.elt-quick{grid-template-columns:1fr}.elt-head h1{font-size:23px}}
</style>
<section class="elt-page" id="eltApp" data-api="<%=eltH(eltApi)%>">
  <header class="elt-head"><div><a class="elt-back" href="<%=eltH(eltDashboard)%>"><i class="fa-solid fa-arrow-left"></i> Dashboard e-Learning</a><h1>Linimasa Pembelajaran</h1><p>Aktivitas kelas berdasarkan logika dan hak akses e-Learning existing.</p></div><button type="button" class="elt-btn elt-mobile-filter" id="eltMobileFilter"><i class="fa-solid fa-sliders"></i> Filter</button></header>
  <div class="elt-layout">
    <aside class="elt-left elt-sticky"><div class="elt-panel"><h2>Temukan aktivitas</h2><div class="elt-search"><i class="fa-solid fa-magnifying-glass"></i><input id="eltSearch" type="search" placeholder="Cari topik pertemuan..."></div><div class="elt-filter-list" id="eltFilters">
      <button class="elt-filter is-active" data-filter="all"><i class="fa-solid fa-layer-group"></i> Semua aktivitas</button><button class="elt-filter" data-filter="tdpMateri"><i class="fa-solid fa-file-lines"></i> Materi</button><button class="elt-filter" data-filter="tdpTugas"><i class="fa-solid fa-list-check"></i> Tugas</button><button class="elt-filter" data-filter="tdpUjian"><i class="fa-solid fa-clipboard-question"></i> Ujian</button><button class="elt-filter" data-filter="tdpDiskusi"><i class="fa-solid fa-comments"></i> Diskusi</button><button class="elt-filter" data-filter="tdpVideo"><i class="fa-solid fa-circle-play"></i> Video</button><button class="elt-filter" data-filter="tdpAudio"><i class="fa-solid fa-headphones"></i> Audio</button><button class="elt-filter" data-filter="tdpCatatan"><i class="fa-solid fa-note-sticky"></i> Catatan</button><button class="elt-filter" data-filter="tdpOnline"><i class="fa-solid fa-video"></i> Kelas online</button>
    </div><div class="elt-date-grid"><div class="elt-field"><label>Dari</label><input id="eltFrom" type="date"></div><div class="elt-field"><label>Sampai</label><input id="eltUntil" type="date"></div></div><div class="elt-field" style="margin-top:9px"><label>Urutan</label><select id="eltOrder"><option value="desc">Terbaru</option><option value="asc">Terlama</option></select></div></div></aside>
    <main><article class="elt-card elt-composer"><div class="elt-composer-row"><div class="elt-avatar"><%=eltH(eltInitial)%></div><button type="button" id="eltComposer">Tambahkan info pada pertemuan yang dipilih...</button></div><div class="elt-quick"><button type="button" data-quick="tdpMateri"><i class="fa-solid fa-file-arrow-down" style="color:#24a148"></i> Materi &amp; media</button><button type="button" data-quick="tdpTugas"><i class="fa-solid fa-list-check" style="color:#e85d04"></i> Tugas</button><button type="button" data-quick="tdpUjian"><i class="fa-solid fa-clipboard-question" style="color:#7c3aed"></i> Ujian</button></div></article><div id="eltFeed" class="elt-feed"><div class="elt-skeleton"></div><div class="elt-skeleton"></div></div><nav class="elt-pagination" aria-label="Halaman linimasa"><button class="elt-btn" id="eltPrev"><i class="fa-solid fa-chevron-left"></i> Sebelumnya</button><span id="eltPageInfo">Halaman 1</span><button class="elt-btn" id="eltNext">Berikutnya <i class="fa-solid fa-chevron-right"></i></button></nav></main>
    <aside class="elt-right elt-sticky"><div class="elt-panel"><h2>Ringkasan halaman</h2><div class="elt-summary"><div><strong id="eltMeetingCount">0</strong><span>Pertemuan</span></div><div><strong id="eltTaskCount">0</strong><span>Tugas</span></div><div><strong id="eltExamCount">0</strong><span>Ujian</span></div><div><strong id="eltMaterialCount">0</strong><span>Materi</span></div></div></div><div class="elt-panel" style="margin-top:14px"><h2>Fungsi existing</h2><p style="font-size:13px;color:#65728a;line-height:1.55;margin:0">Feed ini memakai LinimasaApi, data Pertemuan, filter DashboardTimelinePertemuan, diskusi, materi, tugas, ujian, presensi, dan kelas online existing.</p><button id="eltRefresh" class="elt-btn elt-btn-primary" style="width:100%;margin-top:12px"><i class="fa-solid fa-rotate"></i> Muat ulang</button></div></aside>
  </div>
</section>
<dialog id="eltDialog" class="elt-dialog"><header><h2 id="eltDialogTitle">Detail</h2><button class="elt-btn" data-close aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button></header><div id="eltDialogContent" class="elt-dialog-content"></div><footer><button class="elt-btn" data-close>Tutup</button><button class="elt-btn elt-btn-primary" id="eltDialogSubmit" hidden>Simpan</button></footer></dialog>
<script>
(function(){'use strict';var app=document.getElementById('eltApp');if(!app)return;var api=app.getAttribute('data-api'),feed=document.getElementById('eltFeed'),dialog=document.getElementById('eltDialog'),content=document.getElementById('eltDialogContent'),title=document.getElementById('eltDialogTitle'),submit=document.getElementById('eltDialogSubmit');var state={page:0,size:10,filter:'all',data:[],selected:null,total:0};
function el(tag,cls,text){var node=document.createElement(tag);if(cls)node.className=cls;if(text!==undefined&&text!==null)node.textContent=String(text);return node}function icon(name){var i=el('i',name);i.setAttribute('aria-hidden','true');return i}function n(v){var x=parseInt(v,10);return isNaN(x)?0:x}function arr(v){return Array.isArray(v)?v:[]}function clean(v){return v===null||v===undefined?'':String(v).replace(/<br\s*\/?>/gi,'\n').replace(/<[^>]*>/g,'').trim()}function safeUrl(value){try{var u=new URL(String(value),window.location.href);return u.protocol==='http:'||u.protocol==='https:'?u.href:''}catch(e){return ''}}function toast(message){if(window.nuiToast){window.nuiToast(message);return}alert(message)}
function call(payload){return fetch(api,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)}).then(function(r){return r.json()}).then(function(j){if(j.status!=='00')throw new Error(j.description||'Permintaan gagal');return j})}
function apiDate(value){if(!value)return '';var p=value.split('-');return p.length===3?p[2]+'-'+p[1]+'-'+p[0]:value}function request(refresh){var payload={action:'linimasa',token:'new-ui-session',displayPerPage:String(state.size),activePage:String(state.page),order:document.getElementById('eltOrder').value,sd:'3',refresh:refresh?'true':'false'};var q=document.getElementById('eltSearch').value.trim();if(q)payload.cariTopik=q;var from=document.getElementById('eltFrom').value,until=document.getElementById('eltUntil').value;if(from)payload.mulai=apiDate(from);if(until)payload.sampai=apiDate(until);if(state.filter!=='all')payload[state.filter]='true';return payload}
function load(refresh){feed.innerHTML='<div class="elt-skeleton"></div><div class="elt-skeleton"></div>';call(request(refresh)).then(function(j){state.data=arr(j.data);state.total=n(j.totalSize);state.page=n(j.activePage);render();}).catch(function(e){feed.innerHTML='';var box=el('div','elt-card elt-error');box.appendChild(icon('fa-solid fa-triangle-exclamation'));box.appendChild(document.createTextNode(' '+e.message));feed.appendChild(box);})}
function avatarFor(item){var people=arr(item.dosen).concat(arr(item.guru));if(item['dosenPengganti.foto'])people.unshift({foto:item['dosenPengganti.foto'],nama:item['dosenPengganti.nama']});var a=el('div','elt-avatar',people.length&&people[0].nama?String(people[0].nama).charAt(0).toUpperCase():'K');if(people.length&&people[0].foto){var img=el('img','elt-avatar');img.src=people[0].foto;img.alt=people[0].nama||'Pengajar';img.onerror=function(){this.replaceWith(a)};return img}return a}
function countType(item){return {task:arr(item.tugas).length,exam:arr(item.ujian).length,material:n(item.materi)+n(item.audio)+n(item.video)}}
function actionButton(label,ico,handler,hidden){var b=el('button',hidden?'elt-action-hidden':'');b.type='button';b.appendChild(icon(ico));b.appendChild(document.createTextNode(' '+label));if(handler)b.addEventListener('click',handler);return b}
function render(){feed.innerHTML='';var task=0,exam=0,material=0;if(!state.data.length){var empty=el('div','elt-card elt-empty','Belum ada aktivitas yang cocok dengan filter ini.');feed.appendChild(empty)}state.data.forEach(function(item){var counts=countType(item);task+=counts.task;exam+=counts.exam;material+=counts.material;var card=el('article','elt-card');var head=el('div','elt-card-head');head.appendChild(avatarFor(item));var hm=el('div','elt-card-head-main');hm.appendChild(el('strong','',item.namaDosen||item.namaGuru||'Aktivitas pembelajaran'));hm.appendChild(el('div','elt-meta',(item.waktu||'-')+(item.rinci?' • '+clean(item.rinci):'')));head.appendChild(hm);head.appendChild(el('span','elt-type','Pertemuan '+(item.ke||'')));card.appendChild(head);var body=el('div','elt-body');body.appendChild(el('h3','',item.topik||'Pertemuan pembelajaran'));var note=clean(item.catatan||item.info);if(note)body.appendChild(el('p','',note));var assets=el('div','elt-assets');if(counts.material)assets.appendChild(el('span','elt-pill',counts.material+' materi/media'));if(counts.task)assets.appendChild(el('span','elt-pill',counts.task+' tugas'));if(counts.exam)assets.appendChild(el('span','elt-pill',counts.exam+' ujian'));if(n(item.diskusi))assets.appendChild(el('span','elt-pill',n(item.diskusi)+' diskusi'));if(assets.children.length)body.appendChild(assets);card.appendChild(body);var stats=el('div','elt-stats');stats.appendChild(el('span','',n(item.akses)+' akses'));stats.appendChild(el('span','',arr(item.absensi_data).length+' peserta'));stats.appendChild(el('span','',n(item.diskusi)+' diskusi'));card.appendChild(stats);var actions=el('div','elt-actions');actions.appendChild(actionButton('Diskusi','fa-regular fa-comment',function(){showDiscussions(item)},!n(item.diskusi)));actions.appendChild(actionButton('Materi','fa-solid fa-paperclip',function(){showMaterials(item)},!counts.material));actions.appendChild(actionButton('Tugas / Ujian','fa-solid fa-list-check',function(){showAcademic(item)},!(counts.task||counts.exam)));actions.appendChild(actionButton('Presensi','fa-solid fa-user-check',function(){showDetail(item)},!arr(item.absensi_data).length));actions.appendChild(actionButton('Detail','fa-regular fa-eye',function(){showDetail(item)},false));var online=safeUrl(item.onlineLink);if(online){var a=el('a','');a.href=online;a.target='_blank';a.rel='noopener noreferrer';a.appendChild(icon('fa-solid fa-video'));a.appendChild(document.createTextNode(' Kelas online'));actions.appendChild(a)}actions.appendChild(actionButton('Tambah info','fa-regular fa-pen-to-square',function(){openComposer(item)},false));actions.appendChild(actionButton('Muat ulang','fa-solid fa-rotate',function(){refreshItem(item)},false));card.appendChild(actions);feed.appendChild(card)});document.getElementById('eltMeetingCount').textContent=state.data.length;document.getElementById('eltTaskCount').textContent=task;document.getElementById('eltExamCount').textContent=exam;document.getElementById('eltMaterialCount').textContent=material;var pages=Math.max(1,Math.ceil(state.total/state.size));document.getElementById('eltPageInfo').textContent='Halaman '+(state.page+1)+' dari '+pages;document.getElementById('eltPrev').disabled=state.page<=0;document.getElementById('eltNext').disabled=state.page+1>=pages}
function refreshItem(item){call({action:'refreshPertemuan',token:'new-ui-session',id:String(item.id)}).then(function(updated){for(var i=0;i<state.data.length;i++)if(String(state.data[i].id)===String(item.id)){state.data[i]=updated;break}render();toast('Pertemuan berhasil dimuat ulang')}).catch(function(e){toast(e.message)})}
function openDialog(label,node){title.textContent=label;content.innerHTML='';content.appendChild(node);submit.hidden=true;dialog.showModal()}
function showDetail(item){var list=el('div','elt-detail-list');[['Topik',item.topik],['Waktu',item.waktu],['Pengajar',item.namaDosen||item.namaGuru],['Kelas / rincian',clean(item.rinci)],['Peserta presensi',arr(item.absensi_data).length],['Sedang online',item.online],['Moderator',item.moderator]].forEach(function(row){if(!row[1]&&row[1]!==0)return;var x=el('div','elt-detail-item');x.appendChild(el('strong','',row[0]));x.appendChild(el('span','',row[1]));list.appendChild(x)});var attendance=arr(item.absensi_data);if(attendance.length){var x=el('div','elt-detail-item');x.appendChild(el('strong','','Presensi peserta'));attendance.slice(0,100).forEach(function(a){x.appendChild(el('div','',((a.nim||'')+' '+(a.nama||'')).trim()+' — '+(a.nama_status||'Belum absen')))});list.appendChild(x)}openDialog('Detail pertemuan',list)}
function showDiscussions(item){var loading=el('div','elt-loading','Memuat diskusi...');openDialog('Diskusi pertemuan',loading);call({action:'semuaDikusi',token:'new-ui-session',id:String(item.id),urut:'true'}).then(function(j){content.innerHTML='';var rows=arr(j.data);if(!rows.length){content.appendChild(el('div','elt-empty','Belum ada diskusi.'));return}rows.forEach(function(row){content.appendChild(commentNode(row,0))})}).catch(function(e){content.textContent=e.message})}
function commentNode(row,depth){var wrap=el('div',depth?'elt-comment-children':'');var line=el('div','elt-comment');var av=el('div','elt-avatar',(row.nama||row.user||'P').charAt(0).toUpperCase());line.appendChild(av);var b=el('div','elt-comment-body');b.appendChild(el('strong','',row.nama||row.user||row.jenis||'Pengguna'));b.appendChild(el('div','',clean(row.isi||row.komentar||row.keterangan||row.catatan)));if(row.waktu||row.tanggal)b.appendChild(el('small','elt-meta',row.waktu||row.tanggal));line.appendChild(b);wrap.appendChild(line);arr(row.child||row.children||row.balasan||row.data).forEach(function(c){wrap.appendChild(commentNode(c,depth+1))});return wrap}
function showMaterials(item){var loading=el('div','elt-loading','Memuat materi dan media...');openDialog('Materi & media',loading);Promise.all([call({action:'daftar_materi',token:'new-ui-session',refresh:'false',activePage:'0',displayPerPage:'500'}),call({action:'daftar_video',token:'new-ui-session',refresh:'false',activePage:'0',displayPerPage:'500'}),call({action:'daftar_audio',token:'new-ui-session',refresh:'false',activePage:'0',displayPerPage:'500'})]).then(function(all){content.innerHTML='';var rows=[];all.forEach(function(j){rows=rows.concat(arr(j.data))});rows=rows.filter(function(r){return r.info_pertemuan&&String(r.info_pertemuan.id)===String(item.id)});if(!rows.length){content.appendChild(el('div','elt-empty','Tidak ada materi/media pada pertemuan ini.'));return}rows.forEach(function(r){var x=el('div','elt-detail-item');x.appendChild(el('strong','',r.nama||r.keterangan||'Materi'));if(r.keterangan_tambahan)x.appendChild(el('div','',clean(r.keterangan_tambahan)));var download=safeUrl(r.link_download);if(download){var a=el('a','elt-btn');a.href=download;a.target='_blank';a.rel='noopener noreferrer';a.textContent='Buka / unduh';x.appendChild(a)}content.appendChild(x)})}).catch(function(e){content.textContent=e.message})}
function showAcademic(item){var list=el('div','elt-detail-list');arr(item.tugas).forEach(function(t){var x=el('div','elt-detail-item');x.appendChild(el('strong','',t.judulTugas||'Tugas'));x.appendChild(el('div','',clean(t.isiTugas)));x.appendChild(el('span','elt-pill',(t.boleh_upload?'Boleh upload':'Tidak dapat upload')+' • '+n(t.uploadTugas)+' unggahan'));list.appendChild(x)});arr(item.ujian).forEach(function(u){var x=el('div','elt-detail-item');x.appendChild(el('strong','',u.judul||'Ujian'));x.appendChild(el('div','',clean(u.isiUjian||u.waktu)));x.appendChild(el('span','elt-pill',n(u.jumlahPeserta)+' peserta'));list.appendChild(x)});if(!list.children.length)list.appendChild(el('div','elt-empty','Tidak ada tugas atau ujian.'));openDialog('Tugas & ujian',list)}
function openComposer(item){state.selected=item;title.textContent='Tambahkan info pertemuan';content.innerHTML='';var p=el('p','',item.topik||'Pertemuan');var ta=el('textarea','');ta.id='eltInfoText';ta.placeholder='Tulis informasi untuk pertemuan ini...';content.appendChild(p);content.appendChild(ta);submit.hidden=false;submit.onclick=function(){var value=ta.value.trim();if(!value)return;submit.disabled=true;call({action:'masukkanInfoKePertemuan',token:'new-ui-session',id:String(item.id),info:value}).then(function(){dialog.close();toast('Informasi berhasil disimpan');load(true)}).catch(function(e){toast(e.message)}).then(function(){submit.disabled=false})};dialog.showModal()}
document.querySelectorAll('[data-close]').forEach(function(b){b.addEventListener('click',function(){dialog.close()})});document.getElementById('eltRefresh').addEventListener('click',function(){load(true)});document.getElementById('eltPrev').addEventListener('click',function(){if(state.page>0){state.page--;load(false)}});document.getElementById('eltNext').addEventListener('click',function(){state.page++;load(false)});document.getElementById('eltOrder').addEventListener('change',function(){state.page=0;load(false)});['eltFrom','eltUntil'].forEach(function(id){document.getElementById(id).addEventListener('change',function(){state.page=0;load(false)})});var timer;document.getElementById('eltSearch').addEventListener('input',function(){clearTimeout(timer);timer=setTimeout(function(){state.page=0;load(false)},450)});document.querySelectorAll('[data-filter],[data-quick]').forEach(function(b){b.addEventListener('click',function(){state.filter=b.getAttribute('data-filter')||b.getAttribute('data-quick');document.querySelectorAll('[data-filter]').forEach(function(x){x.classList.toggle('is-active',x.getAttribute('data-filter')===state.filter)});state.page=0;load(false)})});document.getElementById('eltComposer').addEventListener('click',function(){if(!state.data.length){toast('Belum ada pertemuan untuk dipilih');return}openComposer(state.data[0])});document.getElementById('eltMobileFilter').addEventListener('click',function(){document.querySelector('.elt-left').style.display=document.querySelector('.elt-left').style.display==='block'?'none':'block'});load(false);
})();
</script>

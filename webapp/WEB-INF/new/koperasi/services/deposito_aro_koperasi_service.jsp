response.setHeader("Cache-Control","no-store");JSONObject root=new JSONObject();String action=request.getParameter("action");if(action==null)action="list";
try{if(!NewUiRouteGuard.isActionAuthorized(request,"koperasi","deposito_aro_koperasi",action)){response.setStatus(403);root.put("ok",false);root.put("code","ACTION_FORBIDDEN");root.put("message","Role aktif tidak memiliki hak untuk aksi ini.");out.print(root.toString());return;}if("update".equalsIgnoreCase(action)){if(!"POST".equalsIgnoreCase(request.getMethod())){response.setStatus(405);throw new IllegalArgumentException("Mutasi wajib memakai POST.");}if(!NewUiCsrfUtil.isValid(request)){response.setStatus(403);throw new IllegalArgumentException("Token CSRF tidak valid.");}String operation=request.getParameter("operation");if("toggle".equals(operation)){Long id=Long.valueOf(request.getParameter("id"));boolean enabled=Boolean.parseBoolean(request.getParameter("enabled"));NewUiDepositoAroService.toggle(id,enabled);root.put("ok",true);root.put("message","Status ARO berhasil diperbarui.");}else if("process".equals(operation)){int[] result=NewUiDepositoAroService.processNow();root.put("ok",true);root.put("registered",result[0]);root.put("extended",result[1]);root.put("due",result[2]);root.put("message","Proses ARO selesai. Didaftarkan: "+result[0]+", diperpanjang: "+result[1]+", jatuh tempo: "+result[2]+".");}else{response.setStatus(400);throw new IllegalArgumentException("Operasi ARO tidak dikenali.");}}else{Dashboard data=NewUiDepositoAroService.load();JSONArray items=new JSONArray();SimpleDateFormat format=new SimpleDateFormat("yyyy-MM-dd");List<Row> rows=data.getRows();for(int i=0;i<rows.size();i++){Row row=rows.get(i);JSONObject item=new JSONObject();item.put("id",row.id);item.put("member",row.member);item.put("product",row.product);item.put("nominal",row.nominal);item.put("dueDate",row.dueDate==null?JSONObject.NULL:format.format(row.dueDate));item.put("extensionCount",row.extensionCount);item.put("automatic",row.automatic);item.put("status",row.statusLabel);items.put(item);}root.put("ok",true);root.put("items",items);root.put("automaticCount",data.automaticCount);root.put("automaticValue",data.automaticValue);root.put("dueCount",data.dueCount);root.put("dueValue",data.dueValue);}}catch(Exception error){if(response.getStatus()<400)response.setStatus(500);root=new JSONObject();root.put("ok",false);root.put("code","ARO_OPERATION_FAILED");root.put("message",error.getMessage()==null?"Operasi ARO gagal.":error.getMessage());try{ais.common.ErrorAuditUtil.record(error,"New UI service deposito ARO koperasi");}catch(Exception ignored){}}out.print(root.toString());

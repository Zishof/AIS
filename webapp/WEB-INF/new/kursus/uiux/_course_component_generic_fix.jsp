<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><script>(function(){var root=document.getElementById('nuiCourseComponent'),rows=document.getElementById('ccRows'),dialog=document.getElementById('ccMeetDialog'),body=document.getElementById('ccMeetingRows'),generate=document.getElementById('ccGenerate'),csrf=root.dataset.csrf,current=null,currentType=null;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function render(a){body.innerHTML=a.map(function(x){return'<article class="nui-card" style="margin-top:8px;padding:12px"><strong>Pertemuan '+x.number+' · '+esc(x.topic)+'</strong><br><small>'+(x.date?new Date(x.date).toLocaleDateString('id-ID'):'-')+' · '+esc(x.start)+'–'+esc(x.end)+' · '+esc(x.status)+'</small></article>'}).join('')||'<p>Agenda belum dibuat.</p>'}async function request(action,post){var url=root.dataset.endpoint+'&action='+action+'&id='+encodeURIComponent(current)+'&type='+encodeURIComponent(currentType),o={credentials:'same-origin'};if(post){o.method='POST';o.headers={'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrf};o.body=new URLSearchParams({id:current,type:currentType})}var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Agenda gagal dimuat.');return j}rows.addEventListener('click',function(e){var b=e.target.closest('.cc-meet');if(!b)return;e.preventDefault();e.stopImmediatePropagation();current=b.dataset.id;var tr=b.closest('tr'),chip=tr&&tr.querySelector('td:nth-child(2) .nui-chip');currentType=chip?chip.textContent.trim():'';dialog.showModal();body.textContent='Memuat agenda...';request('meetings',false).then(function(j){render(j.meetings)}).catch(function(x){body.textContent=x.message})},true);generate.onclick=function(){request('generate_meetings',true).then(function(j){render(j.meetings)}).catch(function(x){alert(x.message)})}})();</script>

<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String ccH(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String ccToken(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String ccPage=(String)request.getAttribute("ccPage"),ccType=(String)request.getAttribute("ccType"),ccTitle=(String)request.getAttribute("ccTitle");String ccCsrf=(String)session.getAttribute("newUiCsrfToken");if(ccCsrf==null){ccCsrf=ccToken();session.setAttribute("newUiCsrfToken",ccCsrf);}NewUiPermission ccP=NewUiRouteGuard.permissionFor(request,"kursus",ccPage);String ccMenu=request.getParameter("menuId"),ccEndpoint=request.getContextPath()+"/new?service=1&module=kursus&page="+ccH(ccPage)+(ccMenu==null?"":"&menuId="+ccH(ccMenu));%>
<section class="nui-page" id="nuiCourseComponent" data-endpoint="<%=ccH(ccEndpoint)%>" data-csrf="<%=ccH(ccCsrf)%>" data-type="<%=ccH(ccType)%>" data-create="<%=ccP!=null&&ccP.isCanCreate()%>" data-update="<%=ccP!=null&&ccP.isCanUpdate()%>" data-delete="<%=ccP!=null&&ccP.isCanDelete()%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">Kursus &amp; Pelatihan / Komponen Produk</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-graduation-cap"></i> COURSE CONTENT</p><h1><%=ccH(ccTitle)%></h1><p>Kelola materi, buku, ujian, tutor, harga, lampiran, dan agenda pertemuan dengan aturan yang sama seperti modul existing.</p></div><div class="nui-toolbar"><label class="nui-btn nui-btn-hero" <%=ccP!=null&&ccP.isCanCreate()?"":"hidden"%>><i class="fa-solid fa-file-import"></i> Impor CSV<input id="ccImport" type="file" accept=".csv,text/csv" hidden></label><button id="ccExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-export"></i> Ekspor</button><button id="ccAdd" class="nui-btn nui-btn-hero" <%=ccP!=null&&ccP.isCanCreate()?"":"disabled"%>><i class="fa-solid fa-plus"></i> Tambah</button></div></header>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="ccSearch" class="nui-input" type="search" placeholder="Cari kode atau nama komponen..."><select id="ccTypeFilter" class="nui-input"><option value="">Semua jenis</option><option>Video</option><option>Buku</option><option>Ebook</option><option>Latihan Soal</option><option>Ujian</option><option>Pembelajaran Tatap Muka</option><option>Pembelajaran Jarak Jauh</option><option>Ekstra Kurikuler</option></select><select id="ccUnitFilter" class="nui-input"><option value="">Semua satuan kerja</option></select><label><input id="ccActive" type="checkbox" checked> Hanya aktif</label><button id="ccRefresh" class="nui-btn"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button></div></article>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Total komponen</small><strong id="ccTotal">0</strong></article><article class="nui-card"><small>Jenis aktif</small><strong id="ccKind"><%=ccH(ccType==null?"Semua":ccType)%></strong></article><article class="nui-card"><small>Halaman</small><strong id="ccPageNo">1</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Komponen</th><th>Jenis / Unit</th><th>Harga</th><th>Pertemuan / Mulai</th><th>Tutor / Referensi</th><th>Lampiran</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="ccRows"><tr><td colspan="8">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="ccPrev" class="nui-btn">← Sebelumnya</button><span id="ccPager">Halaman 1</span><button id="ccNext" class="nui-btn">Berikutnya →</button></div></article>
<dialog id="ccFormDialog" style="border:0;border-radius:16px;padding:0;max-width:820px;width:calc(100% - 32px)"><form id="ccForm" style="padding:24px"><h2 id="ccFormTitle">Tambah Komponen</h2><input id="ccId" name="id" type="hidden"><div class="nui-grid nui-grid-2"><label>Jenis *<select id="ccType" name="type" class="nui-input"><option>Video</option><option>Buku</option><option>Ebook</option><option>Latihan Soal</option><option>Ujian</option><option>Pembelajaran Tatap Muka</option><option>Pembelajaran Jarak Jauh</option><option>Ekstra Kurikuler</option></select></label><label>Kode<input id="ccCode" name="code" class="nui-input"></label><label>Nama *<input id="ccName" name="name" class="nui-input"></label><label id="ccItemWrap">Buku *<select id="ccItem" name="itemId" class="nui-input"></select></label><label id="ccExamWrap">Ujian *<select id="ccExam" name="examId" class="nui-input"></select></label><label>Satuan kerja<select id="ccUnit" name="unitId" class="nui-input"></select></label><label>Harga ikut default <input id="ccDefaultPrice" name="defaultPrice" type="checkbox" checked></label><label id="ccPriceWrap">Harga<input id="ccPrice" name="price" type="number" min="0" step="0.01" class="nui-input"></label><label id="ccMeetingsWrap">Jumlah pertemuan *<input id="ccMeetings" name="meetings" type="number" min="1" class="nui-input" value="10"></label><label id="ccStartWrap">Tanggal mulai *<input id="ccStart" name="start" type="date" class="nui-input"></label><label id="ccDurationWrap">Durasi video<input id="ccDuration" name="duration" type="time" class="nui-input"></label><label>Tutor I<select id="ccTutor1" name="tutor1" class="nui-input"></select></label><label>Tutor II<select id="ccTutor2" name="tutor2" class="nui-input"></select></label><label>Tutor III<select id="ccTutor3" name="tutor3" class="nui-input"></select></label><label>Tutor IV<select id="ccTutor4" name="tutor4" class="nui-input"></select></label><label>Tutor V<select id="ccTutor5" name="tutor5" class="nui-input"></select></label><label class="nui-grid-span-2">Keterangan<textarea id="ccNote" name="note" class="nui-input" rows="3"></textarea></label><label id="ccFileWrap">File<input id="ccFile" name="file" type="file" class="nui-input"></label><label id="ccLinkWrap">Atau tautan<input id="ccLink" name="link" type="url" class="nui-input"></label><label>Aktif <input id="ccFormActive" name="active" type="checkbox" checked></label></div><div id="ccFormError" class="nui-alert" hidden></div><div class="nui-toolbar" style="margin-top:16px"><button id="ccCancel" type="button" class="nui-btn">Batal</button><button id="ccSave" type="submit" class="nui-btn nui-btn-primary">Simpan</button></div></form></dialog>
<dialog id="ccMeetDialog" style="border:0;border-radius:16px;padding:24px;max-width:820px;width:calc(100% - 32px)"><div class="nui-toolbar"><h2 style="flex:1">Agenda Pertemuan</h2><button id="ccGenerate" class="nui-btn"><i class="fa-solid fa-calendar-plus"></i> Lengkapi Agenda</button><button id="ccMeetClose" class="nui-btn">Tutup</button></div><div id="ccMeetingRows">Memuat agenda...</div></dialog><dialog id="ccHistoryDialog" style="border:0;border-radius:16px;padding:24px;max-width:820px;width:calc(100% - 32px)"><div class="nui-toolbar"><h2 style="flex:1">Riwayat Revisi</h2><button id="ccHistoryClose" class="nui-btn">Tutup</button></div><div id="ccHistoryRows">Memuat riwayat...</div></dialog></section>
<script>(function(){var root=document.getElementById('nuiCourseComponent'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,fixed=root.dataset.type,canC=root.dataset.create==='true',canU=root.dataset.update==='true',canD=root.dataset.delete==='true',page=0,size=20,total=0,last=[],options={},currentMeetingId=null,money=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function type(){return fixed||ccTypeFilter.value}if(fixed){ccTypeFilter.value=fixed;ccTypeFilter.disabled=true}function params(p,z){return{type:type(),q:ccSearch.value,unitId:ccUnitFilter.value,active:ccActive.checked,page:p==null?page:p,size:z||size}}async function call(action,body,query,id){var o={credentials:'same-origin'},url=endpoint+'&action='+action+(id?'&id='+encodeURIComponent(id):'');if(body){o.method='POST';o.headers={'X-CSRF-Token':csrf};o.body=body instanceof FormData?body:new URLSearchParams(body);if(!(body instanceof FormData))o.headers['Content-Type']='application/x-www-form-urlencoded'}else url+='&'+new URLSearchParams(query||params());var r=await fetch(url,o),j=await r.json();if(!r.ok)throw new Error(j.message||'Operasi gagal');return j}function select(id,a,blank){var e=document.getElementById(id),keep=e.value;e.innerHTML=(blank?'<option value="">— Tidak dipilih —</option>':'')+a.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('');e.value=keep}function setup(j){options=j;var keep=ccUnitFilter.value;ccUnitFilter.innerHTML='<option value="">Semua satuan kerja</option>'+j.units.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('');ccUnitFilter.value=keep;select('ccUnit',j.units,true);select('ccItem',j.items,true);select('ccExam',j.exams,true);for(var i=1;i<=5;i++)select('ccTutor'+i,j.employees,true)}async function load(){try{var j=await call('list');last=j.rows;total=j.total;setup(j);ccTotal.textContent=j.total;ccPageNo.textContent=page+1;ccRows.innerHTML=j.rows.map(function(x){var scheduled=/Pembelajaran|Ekstra/.test(x.type);return'<tr><td><strong>'+esc(x.name)+'</strong><br><small>'+esc(x.code)+'</small><br><small>'+esc(x.note)+'</small></td><td><span class="nui-chip">'+esc(x.type)+'</span><br>'+esc(x.unit)+'</td><td>'+(x.defaultPrice?'Default':money.format(x.price))+'</td><td>'+x.meetings+'<br>'+(x.start?new Date(x.start).toLocaleDateString('id-ID'):'-')+'</td><td>'+esc(x.tutors.join(', ')||x.item||x.exam)+'</td><td>'+(x.hasAttachment?'<a class="nui-btn" target="_blank" rel="noopener" href="'+esc(x.attachmentUrl)+'">'+esc(x.attachmentName||'Buka')+'</a>':'-')+'</td><td><label><input class="cc-active" data-id="'+x.id+'" type="checkbox" '+(x.active?'checked':'')+' '+(!canU?'disabled':'')+'> Aktif</label></td><td><div class="nui-toolbar">'+(scheduled?'<button class="nui-btn cc-meet" data-id="'+x.id+'"><i class="fa-solid fa-calendar-days"></i></button>':'')+'<button class="nui-btn cc-edit" data-i="'+j.rows.indexOf(x)+'" '+(!canU?'disabled':'')+'><i class="fa-solid fa-pen"></i></button><button class="nui-btn cc-delete" data-id="'+x.id+'" '+(!canD?'disabled':'')+'><i class="fa-solid fa-trash"></i></button></div></td></tr>'}).join('')||'<tr><td colspan="8">Tidak ada komponen.</td></tr>';ccPager.textContent='Halaman '+(page+1);ccPrev.disabled=page===0;ccNext.disabled=(page+1)*size>=total}catch(e){ccRows.innerHTML='<tr><td colspan="8">'+esc(e.message)+'</td></tr>'}}function showFields(){var t=ccType.value,book=t==='Buku'||t==='Ebook',exam=t==='Ujian'||t==='Latihan Soal',schedule=/Pembelajaran|Ekstra/.test(t),file=t==='Video'||t==='Ebook';ccItemWrap.hidden=!book;ccExamWrap.hidden=!exam;ccMeetingsWrap.hidden=ccStartWrap.hidden=!schedule;ccDurationWrap.hidden=t!=='Video';ccFileWrap.hidden=ccLinkWrap.hidden=!file;ccCode.closest('label').hidden=book||exam;ccName.closest('label').hidden=book||exam;ccPriceWrap.hidden=ccDefaultPrice.checked}function open(row){ccForm.reset();ccId.value=row?row.id:'';ccType.value=row?row.type:(fixed||'Video');ccType.disabled=!!fixed;ccCode.value=row?row.code||'':'';ccName.value=row?row.name||'':'';ccNote.value=row?row.note||'':'';ccDefaultPrice.checked=row?row.defaultPrice:true;ccPrice.value=row?row.price||0:0;ccMeetings.value=row?row.meetings||10:10;ccStart.value=row&&row.start?new Date(row.start).toISOString().slice(0,10):new Date().toISOString().slice(0,10);ccDuration.value=row&&row.duration?new Date(row.duration).toISOString().slice(11,16):'00:00';ccUnit.value=row&&row.unitId||'';ccItem.value=row&&row.itemId||'';ccExam.value=row&&row.examId||'';for(var i=1;i<=5;i++)document.getElementById('ccTutor'+i).value=row&&row.tutorIds[i-1]||'';ccFormActive.checked=row?row.active:true;ccFile.value='';ccLink.value='';ccFormTitle.textContent=row?'Edit Komponen':'Tambah Komponen';ccFormError.hidden=true;showFields();ccFormDialog.showModal()}ccAdd.onclick=function(){if(canC)open(null)};ccCancel.onclick=function(){ccFormDialog.close()};ccType.onchange=showFields;ccDefaultPrice.onchange=showFields;ccForm.onsubmit=async function(e){e.preventDefault();ccSave.disabled=true;try{var fd=new FormData(ccForm);fd.set('type',ccType.value);fd.set('active',ccFormActive.checked);fd.set('defaultPrice',ccDefaultPrice.checked);await call('save',fd,null,ccId.value);ccFormDialog.close();load()}catch(x){ccFormError.textContent=x.message;ccFormError.hidden=false}finally{ccSave.disabled=false}};ccRows.onchange=function(e){if(e.target.classList.contains('cc-active'))call('active',{type:type(),id:e.target.dataset.id,value:e.target.checked},null,e.target.dataset.id).catch(function(x){alert(x.message);load()})};ccRows.onclick=function(e){var b=e.target.closest('button');if(!b)return;if(b.classList.contains('cc-edit'))open(last[parseInt(b.dataset.i,10)]);if(b.classList.contains('cc-delete')&&confirm('Nonaktifkan komponen ini?'))call('delete',{type:type(),id:b.dataset.id},null,b.dataset.id).then(load).catch(function(x){alert(x.message)});if(b.classList.contains('cc-meet'))openMeet(b.dataset.id)};async function openMeet(id){currentMeetingId=id;ccMeetDialog.showModal();ccMeetingRows.textContent='Memuat agenda...';try{var j=await call('meetings',null,{type:type(),id:id});renderMeet(j.meetings)}catch(e){ccMeetingRows.textContent=e.message}}function renderMeet(a){ccMeetingRows.innerHTML=a.map(function(x){return'<article class="nui-card" style="margin-top:8px;padding:12px"><strong>Pertemuan '+x.number+' · '+esc(x.topic)+'</strong><br><small>'+(x.date?new Date(x.date).toLocaleDateString('id-ID'):'-')+' · '+esc(x.start)+'–'+esc(x.end)+' · '+esc(x.status)+'</small></article>'}).join('')||'<p>Agenda belum dibuat.</p>'}ccGenerate.onclick=function(){if(!canU)return;call('generate_meetings',{type:type(),id:currentMeetingId},null,currentMeetingId).then(function(j){renderMeet(j.meetings)}).catch(function(x){alert(x.message)})};ccMeetClose.onclick=function(){ccMeetDialog.close()};var timer;ccSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[ccTypeFilter,ccUnitFilter,ccActive].forEach(function(x){x.onchange=function(){page=0;load()}});ccRefresh.onclick=load;ccPrev.onclick=function(){if(page){page--;load()}};ccNext.onclick=function(){page++;load()};ccExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,params(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['code','name','type','unit','price','meetings','start','tutors','item','exam','active'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='komponen-produk-kursus.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};load()})();</script>

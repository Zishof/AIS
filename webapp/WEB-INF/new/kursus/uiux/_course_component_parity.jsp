<script>(function(){var root=document.getElementById('nuiCourseComponent'),rows=document.getElementById('ccRows'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,fixed=root.dataset.type,canCreate=root.dataset.create==='true';function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function rowType(button){var row=button.closest('tr'),chip=row&&row.querySelector('.nui-chip');return fixed||(chip?chip.textContent.trim():document.getElementById('ccTypeFilter').value)}async function request(action,id,type,body){var url=endpoint+'&action='+action+'&id='+encodeURIComponent(id||'')+'&type='+encodeURIComponent(type||'');var options={credentials:'same-origin'};if(body){options.method='POST';options.headers={'X-CSRF-Token':csrf};options.body=body}var response=await fetch(url,options),json=await response.json();if(!response.ok)throw new Error(json.message||'Operasi gagal');return json}function enhance(){Array.prototype.forEach.call(rows.querySelectorAll('.cc-delete'),function(del){var toolbar=del.parentElement;if(toolbar.querySelector('.cc-history'))return;var id=del.dataset.id,type=rowType(del),copy=document.createElement('button'),history=document.createElement('button');copy.type='button';copy.className='nui-btn cc-copy';copy.dataset.id=id;copy.dataset.type=type;copy.title='Duplikat';copy.disabled=!canCreate;copy.innerHTML='<i class="fa-solid fa-copy"></i>';history.type='button';history.className='nui-btn cc-history';history.dataset.id=id;history.dataset.type=type;history.title='Riwayat revisi';history.innerHTML='<i class="fa-solid fa-clock-rotate-left"></i>';toolbar.insertBefore(copy,del);toolbar.insertBefore(history,del)})}new MutationObserver(enhance).observe(rows,{childList:true,subtree:true});enhance();rows.addEventListener('click',async function(event){var button=event.target.closest('.cc-copy,.cc-history');if(!button)return;event.preventDefault();event.stopImmediatePropagation();try{if(button.classList.contains('cc-copy')){if(confirm('Buat salinan komponen ini?')){await request('copy',button.dataset.id,button.dataset.type,new URLSearchParams({id:button.dataset.id,type:button.dataset.type}));document.getElementById('ccRefresh').click()}}else{var json=await request('history',button.dataset.id,button.dataset.type),target=document.getElementById('ccHistoryRows');target.innerHTML=json.history.map(function(x){return'<article class="nui-card" style="margin-top:8px;padding:12px"><strong>Revisi '+x.revision+' · '+esc(x.name)+'</strong><br><small>'+new Date(x.timestamp).toLocaleString('id-ID')+' · '+esc(x.by||'Sistem')+' · '+esc(x.componentType)+' · '+(x.type===2?'Dihapus':x.type===0?'Dibuat':'Diubah')+'</small><p>'+esc(x.note)+'</p></article>'}).join('')||'<p>Riwayat belum tersedia.</p>';document.getElementById('ccHistoryDialog').showModal()}}catch(e){alert(e.message)}});document.getElementById('ccHistoryClose').onclick=function(){document.getElementById('ccHistoryDialog').close()};var input=document.getElementById('ccImport');if(input)input.onchange=async function(){if(!this.files.length)return;var form=new FormData();form.append('file',this.files[0]);try{var json=await request('import_csv','',fixed||document.getElementById('ccTypeFilter').value,form);alert(json.imported+' baris berhasil diimpor.');document.getElementById('ccRefresh').click()}catch(e){alert(e.message)}finally{this.value=''}}})();</script>

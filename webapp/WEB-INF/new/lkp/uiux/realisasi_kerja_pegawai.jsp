<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.security.SecureRandom" %><%@ page import="java.util.Calendar" %><%@ page import="ais.common.newui.NewUiPermission" %><%@ page import="ais.common.newui.NewUiRouteGuard" %><%!private String h(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}private String token(){byte[]b=new byte[24];new SecureRandom().nextBytes(b);StringBuilder s=new StringBuilder();for(int i=0;i<b.length;i++)s.append(Integer.toHexString((b[i]&255)|256).substring(1));return s.toString();}%><%String csrf=(String)session.getAttribute("newUiCsrfToken");if(csrf==null){csrf=token();session.setAttribute("newUiCsrfToken",csrf);}NewUiPermission permission=NewUiRouteGuard.permissionFor(request,"lkp","realisasi_kerja_pegawai");String menu=request.getParameter("menuId"),endpoint=request.getContextPath()+"/new?service=1&module=lkp&page=realisasi_kerja_pegawai"+(menu==null?"":"&menuId="+h(menu));int year=Calendar.getInstance().get(Calendar.YEAR),month=Calendar.getInstance().get(Calendar.MONTH);%>
<section class="nui-page" id="nuiWorkRealization" data-endpoint="<%=h(endpoint)%>" data-csrf="<%=h(csrf)%>"><header class="nui-module-dashboard-hero"><div><div class="nui-breadcrumb">LKP / Realisasi Kerja</div><p class="nui-dashboard-eyebrow"><i class="fa-solid fa-list-check"></i> PERFORMANCE</p><h1>Realisasi Kerja Pegawai</h1><p>Pantau target, bukti realisasi, capaian kuantitas/waktu, kualitas, dan verifikasi asesor sesuai lingkup akses.</p></div><button id="wrExport" class="nui-btn nui-btn-hero"><i class="fa-solid fa-file-export"></i> Ekspor</button></header>
<article class="nui-card" style="margin-top:14px"><div class="nui-toolbar"><input id="wrSearch" class="nui-input" type="search" placeholder="Cari nama kegiatan..."><select id="wrEmployee" class="nui-input"><option value="">Semua pegawai</option></select><select id="wrUnit" class="nui-input"><option value="">Semua satuan kerja</option></select><select id="wrMonth" class="nui-input"><option value="0">Januari</option><option value="1">Februari</option><option value="2">Maret</option><option value="3">April</option><option value="4">Mei</option><option value="5">Juni</option><option value="6">Juli</option><option value="7">Agustus</option><option value="8">September</option><option value="9">Oktober</option><option value="10">November</option><option value="11">Desember</option></select><input id="wrYear" class="nui-input" type="number" min="2000" max="2100" value="<%=year%>"><button id="wrRefresh" class="nui-btn"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button></div></article>
<div class="nui-dashboard-kpis" style="margin-top:14px"><article class="nui-card"><small>Total target</small><strong id="wrTotal">0</strong></article><article class="nui-card"><small>Sudah diverifikasi</small><strong id="wrVerified">0</strong></article><article class="nui-card"><small>Menunggu asesor</small><strong id="wrPending">0</strong></article></div>
<article class="nui-card" style="margin-top:14px"><div class="nui-table-wrap"><table class="nui-table"><thead><tr><th>Pegawai / Kegiatan</th><th>Kuantitas</th><th>Kualitas</th><th>Waktu</th><th>Status</th><th>Catatan</th><th>Aksi</th></tr></thead><tbody id="wrRows"><tr><td colspan="7">Memuat data...</td></tr></tbody></table></div><div class="nui-toolbar"><button id="wrPrev" class="nui-btn">← Sebelumnya</button><span id="wrPager">Halaman 1</span><button id="wrNext" class="nui-btn">Berikutnya →</button></div></article>
<dialog id="wrDetailDialog" style="border:0;border-radius:16px;padding:24px;max-width:900px;width:calc(100% - 32px)"><div class="nui-toolbar"><h2 style="flex:1">Detail Realisasi</h2><button id="wrDetailClose" class="nui-btn">Tutup</button></div><div id="wrDetails">Memuat detail...</div></dialog>
<dialog id="wrVerifyDialog" style="border:0;border-radius:16px;padding:24px;max-width:620px;width:calc(100% - 32px)"><form id="wrVerifyForm"><h2>Verifikasi Target Kerja</h2><input id="wrId" type="hidden"><label>Kualitas realisasi (0–100)<input id="wrQuality" class="nui-input" type="number" min="0" max="100" step="0.01" required></label><label><input id="wrVerifiedInput" type="checkbox"> Sesuai / terverifikasi</label><label>Catatan<textarea id="wrNote" class="nui-input" rows="4"></textarea></label><p id="wrError" class="nui-alert" hidden></p><div class="nui-toolbar"><button id="wrVerifyCancel" type="button" class="nui-btn">Batal</button><button class="nui-btn nui-btn-primary" type="submit" <%=permission!=null&&permission.isCanUpdate()?"":"disabled"%>>Simpan</button></div></form></dialog></section>
<script>(function(){var root=document.getElementById('nuiWorkRealization'),endpoint=root.dataset.endpoint,csrf=root.dataset.csrf,page=0,size=20,total=0,last=[],month=<%=month%>;wrMonth.value=month;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function query(p,z){return{q:wrSearch.value,employeeId:wrEmployee.value,unitId:wrUnit.value,month:wrMonth.value,year:wrYear.value,page:p==null?page:p,size:z||size}}async function call(action,body,params){var url=endpoint+'&action='+action+'&'+new URLSearchParams(params||{}),options={credentials:'same-origin'};if(body){options.method='POST';options.headers={'X-CSRF-Token':csrf,'Content-Type':'application/x-www-form-urlencoded'};options.body=new URLSearchParams(body)}var response=await fetch(url,options),json=await response.json();if(!response.ok)throw new Error(json.message||'Operasi gagal');return json}function options(select,values,label){var keep=select.value;select.innerHTML='<option value="">'+label+'</option>'+values.map(function(x){return'<option value="'+x.id+'">'+esc(x.label)+'</option>'}).join('');select.value=keep}async function load(){wrRows.innerHTML='<tr><td colspan="7">Memuat data...</td></tr>';try{var j=await call('list',null,query());last=j.rows;total=j.total;options(wrEmployee,j.employees,'Semua pegawai');options(wrUnit,j.units,'Semua satuan kerja');var verified=j.rows.filter(function(x){return x.verified}).length;wrTotal.textContent=j.total;wrVerified.textContent=verified;wrPending.textContent=j.rows.length-verified;wrRows.innerHTML=j.rows.map(function(x,i){var qp=x.quantity?Math.min(100,x.realizedQuantity/x.quantity*100):0,tp=x.time?Math.min(100,x.realizedTime/x.time*100):0;return'<tr><td><strong>'+esc(x.employee)+'</strong><br>'+esc(x.activity)+'<br><small>'+esc(x.unit)+'</small></td><td>'+x.realizedQuantity+' / '+x.quantity+' '+esc(x.quantityUnit)+'<progress max="100" value="'+qp+'"></progress></td><td>'+x.realizedQuality+' / '+x.quality+'</td><td>'+x.realizedTime+' / '+x.time+' '+esc(x.timeUnit)+'<progress max="100" value="'+tp+'"></progress></td><td><span class="nui-chip">'+(x.verified?'Terverifikasi':'Belum')+'</span></td><td>'+esc(x.note)+'</td><td><div class="nui-toolbar"><button class="nui-btn wr-detail" data-id="'+x.id+'" title="Detail"><i class="fa-solid fa-list"></i></button><button class="nui-btn wr-verify" data-i="'+i+'" '+(!x.canAssess?'disabled':'')+' title="Verifikasi"><i class="fa-solid fa-user-check"></i></button></div></td></tr>'}).join('')||'<tr><td colspan="7">Tidak ada target kerja pada filter ini.</td></tr>';wrPager.textContent='Halaman '+(page+1);wrPrev.disabled=page===0;wrNext.disabled=(page+1)*size>=total}catch(e){wrRows.innerHTML='<tr><td colspan="7">'+esc(e.message)+'</td></tr>'}}wrRows.onclick=async function(e){var b=e.target.closest('button');if(!b)return;if(b.classList.contains('wr-detail')){wrDetailDialog.showModal();wrDetails.textContent='Memuat detail...';try{var j=await call('details',null,{id:b.dataset.id});wrDetails.innerHTML=j.details.map(function(x){return'<article class="nui-card" style="margin-top:8px;padding:12px"><strong>'+esc(x.description||'Realisasi kerja')+'</strong><br><small>'+(x.from?new Date(x.from).toLocaleString('id-ID'):'-')+' · Kuantitas '+x.quantity+' · Waktu '+x.time+' · Biaya '+x.cost+'</small><p>'+esc(x.note)+'</p></article>'}).join('')||'<p>Belum ada detail realisasi.</p>'}catch(x){wrDetails.textContent=x.message}}if(b.classList.contains('wr-verify')){var x=last[parseInt(b.dataset.i,10)];wrId.value=x.id;wrQuality.value=x.realizedQuality;wrVerifiedInput.checked=x.verified;wrNote.value=x.note||'';wrError.hidden=true;wrVerifyDialog.showModal()}};wrVerifyForm.onsubmit=async function(e){e.preventDefault();try{await call('verify',{id:wrId.value,quality:wrQuality.value,verified:wrVerifiedInput.checked,note:wrNote.value},{id:wrId.value});wrVerifyDialog.close();load()}catch(x){wrError.textContent=x.message;wrError.hidden=false}};wrVerifyCancel.onclick=function(){wrVerifyDialog.close()};wrDetailClose.onclick=function(){wrDetailDialog.close()};var timer;wrSearch.oninput=function(){clearTimeout(timer);timer=setTimeout(function(){page=0;load()},300)};[wrEmployee,wrUnit,wrMonth,wrYear].forEach(function(x){x.onchange=function(){page=0;load()}});wrRefresh.onclick=load;wrPrev.onclick=function(){if(page){page--;load()}};wrNext.onclick=function(){page++;load()};wrExport.onclick=async function(){try{var all=[],p=0,n=1;while(all.length<n){var j=await call('list',null,query(p,100));n=j.total;all=all.concat(j.rows);p++}var cols=['employee','activity','unit','quantity','realizedQuantity','quality','realizedQuality','time','realizedTime','verified','note'],csv=[cols.join(',')].concat(all.map(function(x){return cols.map(function(k){return'"'+String(x[k]==null?'':x[k]).replace(/"/g,'""')+'"'}).join(',')})).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='realisasi-kerja-pegawai.csv';a.click();URL.revokeObjectURL(a.href)}catch(e){alert(e.message)}};load()})();</script>

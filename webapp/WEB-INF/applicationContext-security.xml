<?xml version="1.0" encoding="UTF-8"?>

<beans:beans xmlns="http://www.springframework.org/schema/security" 
	xmlns:beans="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation=
	"http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
	 http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-3.0.xsd
	 http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-3.1.xsd">

 	<!--  HTTP configuration sample -->
	<http auto-config="true">
		<!-- ZK AU requests -->
		<intercept-url pattern="/zkau/**" access="IS_AUTHENTICATED_ANONYMOUSLY" />
		<intercept-url pattern="/pages/maintenance/job/**"
			access="ROLE_SUPERVISOR" />
		<intercept-url pattern="/desktop" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/desktop/**" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/main" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/dashboard" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/common/tampilan_dashboard.zul" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/main/**" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/AmbilFile*" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/AmbilFile" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="*reset_password*" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/main2" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/main2/**" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/q/**" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/AmbilLampiran**" access="IS_AUTHENTICATED_REMEMBERED" />
		<!-- Portal ALUMNI / tracer study bersifat PUBLIK (sama seperti /ppdb dan /pmb):
			 dibuka alumni yang belum punya akun. Aturan ini WAJIB berada SEBELUM aturan
			 "/al" di bawah supaya niatnya terbaca jelas dan tidak ikut tertutup lagi bila
			 suatu saat pola di bawah diperlebar. -->
		<intercept-url pattern="/alumni" access="IS_AUTHENTICATED_ANONYMOUSLY" />
		<intercept-url pattern="/alumni.zul" access="IS_AUTHENTICATED_ANONYMOUSLY" />

		<!-- Alias "/al" memetakan ke servlet class yang sama dengan /AmbilLampiran
			 (lihat web.xml); wajib gerbang yang sama, jika tidak jatuh ke catch-all
			 IS_AUTHENTICATED_ANONYMOUSLY di bawah dan servlet bisa diakses tanpa login.

			 PERBAIKAN: pola sebelumnya "/al**" TERLALU LEBAR: ia ikut menangkap /alumni dan
			 /alumni.zul (satu-satunya url-pattern lain berawalan "al" di web.xml), sehingga
			 portal alumni yang seharusnya publik selalu dilempar ke halaman login dan tampak
			 "berputar" kembali ke login. Dipersempit menjadi path aliasnya saja; /al/** tetap
			 disertakan agar tidak ada celah lewat sub-path. Proteksi lampiran TIDAK berkurang. -->
		<!-- DIBUKA PUBLIK atas permintaan pemilik sistem (19-08-2026), sementara, supaya
			 gambar/lampiran yang tampil di halaman publik tidak lagi dilempar ke login.

			 CATATAN RISIKO (jangan dihapus sebelum ditindaklanjuti): servlet AmbilLampiran
			 TIDAK memiliki pengecekan hak akses apa pun, dan selain token terenkripsi "d" ia
			 juga menerima parameter polos ?ref=&amp;clazz= yang bisa ditebak berurutan. Dengan
			 aturan ini SIAPA PUN dapat mengunduh lampiran apa pun tanpa login, termasuk KK,
			 akte, ijazah, dan gambar TANDA TANGAN (TTD_*) yang dipakai mengesahkan dokumen.

			 Rencana pengamanan yang disepakati untuk menyusul: endpoint publik terpisah yang
			 (a) WAJIB memakai token "d" dan (b) hanya melayani jenis lampiran dalam daftar
			 putih, sementara /al dikembalikan menjadi IS_AUTHENTICATED_REMEMBERED. -->
		<intercept-url pattern="/al" access="IS_AUTHENTICATED_ANONYMOUSLY" />
		<intercept-url pattern="/al/**" access="IS_AUTHENTICATED_ANONYMOUSLY" />
		<intercept-url pattern="/pascasarjana/**" access="IS_AUTHENTICATED_ANONYMOUSLY" />
		<intercept-url pattern="/jalankan-laporan" access="IS_AUTHENTICATED_REMEMBERED" />
		<!-- Pertahanan berlapis untuk temuan broken access control AiGenerateServlet: gerbang
			 utama (session login) sudah ditambal di kode servlet itu sendiri (lihat Javadoc
			 kelasnya), aturan ini hanya jaring pengaman tambahan di lapisan Spring Security agar
			 /Ai tidak lagi jatuh pada aturan tangkap-semua anonim di bawah. -->
		<intercept-url pattern="/Ai" access="IS_AUTHENTICATED_REMEMBERED" />
		<intercept-url pattern="/**" access="IS_AUTHENTICATED_ANONYMOUSLY" />
	
		
		<form-login login-page="/" default-target-url="/main" 
			login-processing-url="/j_spring_security_check"
			authentication-failure-url="/login?login_error=ID+pengguna+atau+kata+sandi+tidak+sesuai,+coba+ulangi+kembali. " />

		<logout success-handler-ref="logoutListener" logout-url="/logoff" />
		
		<!-- Following is list of ZK Spring Security custom filters. They needs 
			to be exactly in the same order as shown below in order to work. -->
		<custom-filter ref="securityFilter" before="FORM_LOGIN_FILTER" />
	</http> 	  
	
	<beans:bean id="logoutListener" class="ais.common.LogoutListener">
	</beans:bean>

	<beans:bean id="securityFilter" class="ais.common.SecurityFilter">
	</beans:bean>

	<beans:bean id="userDetailsService" class="ais.common.UserDetailsServiceImpl">
	</beans:bean>
 	

	<authentication-manager>
		<authentication-provider user-service-ref="userDetailsService">
			<password-encoder hash="plaintext" />
		</authentication-provider>
	</authentication-manager>

	<!-- In-Memory Authentication sample
	<authentication-manager>
		<authentication-provider>
			<user-service>
				<user name="rod" password="1234" authorities="ROLE_USER, ROLE_EDITOR" />
				<user name="dianne" password="1234" authorities="ROLE_USER, ROLE_EDITOR" />
				<user name="scott" password="1234" authorities="ROLE_USER" />
				<user name="peter" password="1234" authorities="ROLE_USER" />
			</user-service>
		</authentication-provider>
	</authentication-manager>
	 -->

	<global-method-security secured-annotations="enabled" />
</beans:beans>



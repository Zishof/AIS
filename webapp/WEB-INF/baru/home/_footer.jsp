<footer class="home-footer" id="kontak"><div class="home-shell"><div class="home-footer-grid"><div class="home-footer-brand"><div><img src="<%=h(vm.institution.logoUrl)%>" width="58" height="58" alt=""><span><strong><%=h(vm.institution.name)%></strong><small><%=h(vm.institution.motto)%></small></span></div><p><%=h(vm.institution.address)%></p></div><nav aria-label="Jelajahi"><strong>Jelajahi</strong><a href="#profil">Profil</a><% if (vm.showPrograms) { %><a href="#program"><%=h(vm.terminology.programLabel)%></a><% } %><% if (vm.showAdmission) { %><a href="#penerimaan">Penerimaan</a><% } %><a href="#layanan">Layanan Digital</a></nav><div><strong>Hubungi</strong><% if (vm.institution.phone != null && vm.institution.phone.length() > 0) { %><a href="tel:<%=h(vm.institution.phone)%>"><%=h(vm.institution.phone)%></a><% } %><% if (vm.institution.email != null && vm.institution.email.length() > 0) { %><a href="mailto:<%=h(vm.institution.email)%>"><%=h(vm.institution.email)%></a><% } %><a href="#beranda">Kembali ke atas</a></div><div><strong>Aplikasi</strong><a href="<%=h(vm.androidUrl)%>" target="_blank" rel="noopener noreferrer">Google Play</a><a href="<%=h(vm.iosUrl)%>" target="_blank" rel="noopener noreferrer">App Store</a><a href="<%=h(vm.desktopUrl)%>" target="_blank" rel="noopener noreferrer">Versi Desktop</a></div></div><div class="home-footer-bottom"><small>&copy; <%=java.util.Calendar.getInstance().get(java.util.Calendar.YEAR)%> <%=h(vm.institution.name)%>. Seluruh hak cipta dilindungi.</small><small>Website resmi institusi &middot; Aksesibilitas &middot; Privasi</small></div></div></footer>

 var(--line);border-radius:20px;background:#fff;box-shadow:var(--shadow)}.mobile-menu a{padding:12px 14px;border-radius:11px;text-decoration:none;font-weight:750}.mobile-menu a:hover{background:var(--surface)}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border:1px solid transparent;border-radius:999px;text-decoration:none;font-weight:850;transition:transform .2s ease}.button:hover{transform:translateY(-2px)}.button-primary{color:#fff;background:var(--primary);box-shadow:0 12px 26px rgba(29,78,216,.24)}.button-light{color:var(--dark);background:#fff}.button-outline{border-color:rgba(255,255,255,.38);color:#fff;background:rgba(255,255,255,.08)}.hero{position:relative;min-height:690px;overflow:hidden;color:#fff;background:var(--dark)}.hero-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(16,42,67,.98),rgba(16,42,67,.9) 50%,rgba(16,42,67,.38))}.hero::after{content:"";position:absolute;inset:0;z-index:1;opacity:.16;background-image:radial-gradient(circle at 20px 20px,#fff 1.4px,transparent 1.7px);background-size:40px 40px;mask-image:linear-gradient(to right,#000,transparent 78%)}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center;min-height:690px;padding:86px 0}.eyebrow{display:inline-flex;align-items:center;gap:10px;color:#ffd77a;font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.eyebrow::before{content:"";width:34px;height:1px;background:currentColor}h1{max-width:760px;margin:18px 0 22px;font-size:clamp(44px,6vw,76px);line-height:1.04;letter-spacing:-.035em}.hero-lead{max-width:700px;margin:0 0 30px;color:rgba(255,255,255,.84);font-size:20px}.actions{display:flex;flex-wrap:wrap;gap:12px}.hero-card{padding:30px;border:1px solid rgba(255,255,255,.18);border-radius:32px;background:rgba(255,255,255,.1);backdrop-filter:blur(14px);box-shadow:0 28px 80px rgba(0,0,0,.25)}.hero-card img{width:82px;height:82px;object-fit:contain;padding:7px;border-radius:20px;background:#fff}.hero-card h2{margin:20px 0 8px;font-size:30px;line-height:1.15}.hero-card p{margin:0;color:rgba(255,255,255,.76)}.facts{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:24px}.fact{padding:14px;border-radius:16px;background:rgba(0,0,0,.17)}.fact small{display:block;color:rgba(255,255,255,.66)}.fact strong{color:#ffd77a}.identity-strip{position:relative;z-index:3;margin-top:-38px}.identity-grid{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border-radius:24px;background:#fff;box-shadow:var(--shadow)}.identity-item{padding:23px;text-align:center;border-right:1px solid var(--line)}.identity-item:last-child{border-right:0}.identity-item strong{display:block;color:var(--primary);font:700 21px Georgia,serif}.identity-item span{color:var(--muted);font-size:12px;font-weight:750}section{padding:94px 0}.section-head{display:grid;grid-template-columns:.85fr 1.15fr;gap:58px;align-items:end;margin-bottom:44px}.section-head h2{margin:9px 0 0;font-size:clamp(35px,4vw,54px);line-height:1.08}.section-head p{margin:0;color:var(--muted);font-size:18px}.kicker{color:var(--primary);font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.profile-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:24px}.profile-copy,.leader-card{padding:34px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:0 12px 34px rgba(16,42,67,.06)}.profile-copy p{color:var(--muted);font-size:18px}.leader-card h3{margin:0 0 20px;font-size:26px}.leader-row{padding:14px 0;border-top:1px solid var(--line)}.leader-row span{display:block;color:var(--muted);font-size:12px}.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.four{grid-template-columns:repeat(4,1fr)}.card{position:relative;min-height:220px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:0 12px 34px rgba(16,42,67,.06)}.card::before{content:"";display:block;width:42px;height:5px;margin-bottom:38px;border-radius:5px;background:linear-gradient(90deg,var(--primary),var(--secondary))}.card h3{margin:0 0 10px;font-size:23px;line-height:1.18}.card p{margin:0;color:var(--muted);font-size:14px}.soft{background:#eaf1fb}.dark{color:#fff;background:var(--dark)}.dark .section-head p{color:rgba(255,255,255,.73)}.dark .kicker{color:#ffd77a}.dark .card{border-color:rgba(255,255,255,.13);background:rgba(255,255,255,.07);box-shadow:none}.dark .card p{color:rgba(255,255,255,.7)}.gallery-grid{display:grid;grid-template-columns:1.25fr .875fr .875fr;grid-auto-rows:330px;gap:18px}.gallery-item{position:relative;overflow:hidden;border-radius:26px;background:linear-gradient(135deg,var(--dark),var(--primary))}.gallery-item img{width:100%;height:100%;object-fit:cover}.gallery-copy{position:absolute;inset:auto 0 0;padding:65px 24px 23px;color:#fff;background:linear-gradient(transparent,rgba(16,42,67,.94))}.gallery-copy h3{margin:0 0 4px;font-size:22px}.gallery-copy p{margin:0;color:rgba(255,255,255,.76);font-size:13px}.gallery-placeholder{display:grid;place-items:center;height:100%;padding:28px;color:rgba(255,255,255,.78);text-align:center}.news time{color:#a46500;font-size:12px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.empty{padding:42px;border:1px dashed rgba(29,78,216,.3);border-radius:24px;color:var(--muted);text-align:center}.contact{padding-top:0}.contact-card{display:grid;grid-template-columns:1.15fr .85fr;gap:44px;padding:54px;border-radius:34px;color:#fff;background:linear-gradient(135deg,var(--primary),var(--dark));box-shadow:var(--shadow)}.contact-card h2{margin:8px 0 16px;font-size:44px;line-height:1.06}.contact-card p{color:rgba(255,255,255,.8)}.contact-list{display:grid;gap:10px;align-content:center;font-style:normal}.contact-list a,.contact-list span{padding:12px 16px;border-radius:14px;background:rgba(255,255,255,.1);text-decoration:none}.warning{margin:20px auto 0;padding:14px 18px;border:1px solid #e7c764;border-radius:14px;background:#fff7d4;color:#59470a}footer{padding:38px 0;border-top:1px solid var(--line);color:var(--muted);background:#fff}.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-links{display:flex;gap:14px;flex-wrap:wrap}.footer-links a{color:var(--ink);text-underline-offset:4px}

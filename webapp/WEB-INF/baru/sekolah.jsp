<a class="skip" href="#konten">Lewati ke konten utama</a>
<% if (announcement.optBoolean("enabled", false) && !t(announcement,"text","").isEmpty()) { %><div class="announcement"><strong><%=e(t(announcement,"label","Informasi"))%>:</strong> <a href="<%=href(t(announcement,"url","#berita"),"#berita")%>"><%=e(t(announcement,"text",""))%></a></div><% } %>
<header class="topbar"><div class="wrap topbar-inner">
    <a class="brand" href="#awal" aria-label="Beranda <%=e(school.getName())%>"><img src="<%=e(image(school.getLogo(),root+"/img/logo.png"))%>" alt="Logo <%=e(school.getName())%>"><span><strong><%=e(school.getName())%></strong><span><%=e(school.getType())%></span></span></a>
    <nav class="desktop-nav" aria-label="Navigasi utama"><% for(int i=0;i<navigation.length();i++){JSONObject menu=item(navigation,i);%><a href="<%=href(t(menu,"url","#"),"#")%>"><%=e(t(menu,"label","Menu"))%></a><%}%><a class="button button-primary" href="<%=href(t(loginAction,"url",root+"/login"),root+"/login")%>"><%=e(t(loginAction,"label","Masuk eSchool"))%></a></nav>
    <details class="mobile-nav"><summary aria-label="Buka navigasi">Menu</summary><nav class="mobile-menu" aria-label="Navigasi seluler"><% for(int i=0;i<navigation.length();i++){JSONObject menu=item(navigation,i);%><a href="<%=href(t(menu,"url","#"),"#")%>"><%=e(t(menu,"label","Menu"))%></a><%}%><a class="button button-primary" href="<%=href(t(loginAction,"url",root+"/login"),root+"/login")%>"><%=e(t(loginAction,"label","Masuk eSchool"))%></a></nav></details>
</div></header>
<% if(Boolean.TRUE.equals(request.getAttribute("schoolContentWarning"))){%><div class="wrap warning" role="status">Sebagian informasi dinamis sedang tidak tersedia. Informasi utama sekolah tetap dapat digunakan.</div><%}%>
<main id="konten">
<section class="hero" id="awal"><img class="hero-media" src="<%=e(image(school.getHero(),root+"/img/main.jpg"))%>" alt="" aria-hidden="true" fetchpriority="high" decoding="async"><div class="wrap hero-grid"><div><span class="eyebrow"><%=e(t(hero,"eyebrow","Sekolah yang bertumbuh bersama setiap peserta didik"))%></span><h1><%=e(school.getName())%></h1><p class="hero-lead"><%=e(school.getMotto().isEmpty()?school.getDescription():school.getMotto())%></p><div class="actions"><a class="button button-primary" href="<%=href(t(heroPrimary,"url",root+"/psb"),root+"/psb")%>"><%=e(t(heroPrimary,"label","Pendaftaran Siswa"))%></a><a class="button button-light" href="<%=href(t(heroSecondary,"url","#profil"),"#profil")%>"><%=e(t(heroSecondary,"label","Jelajahi Sekolah"))%></a></div></div><aside class="hero-card"><img src="<%=e(image(school.getLogo(),root+"/img/logo.png"))%>" alt=""><h2><%=e(school.getType())%></h2><p><%=e(school.getFoundation().isEmpty()?school.getDescription():"Bernaung di bawah "+school.getFoundation())%></p><div class="facts"><div class="fact"><small>NPSN</small><strong><%=e(school.getNpsn().isEmpty()?"—":school.getNpsn())%></strong></div><div class="fact"><small>Kepala sekolah</small><strong><%=e(school.getPrincipal().isEmpty()?"Informasi sekolah":school.getPrincipal())%></strong></div></div></aside></div></section>
<div class="identity-strip"><div class="wrap identity-grid"><div class="identity-item"><strong><%=e(school.getType())%></strong><span>Jenis sekolah</span></div><div class="identity-item"><strong><%=e(school.getNpsn().isEmpty()?"Terverifikasi":school.getNpsn())%></strong><span>NPSN</span></div><div class="identity-item"><strong>Terpadu</strong><span>Layanan digital</span></div><div class="identity-item"><strong>Inklusif</strong><span>Lingkungan belajar</span></div></div></div>
<%if(SchoolWebsiteConfig.visible(site,"profile",true)){%><section id="profil"><div class="wrap"><div class="section-head"><div><span class="kicker"><%=e(t(profileSection,"eyebrow","Tentang sekolah"))%></span><h2><%=e(t(profileSection,"title","Pendidikan bermutu dan berpusat pada peserta didik"))%></h2></div><p>Informasi identitas berikut selalu mengikuti data master sekolah.</p></div><div class="profile-grid"><article class="profile-copy"><h3>Profil <%=e(school.getName())%></h3><p><%=e(school.getDescription().isEmpty()?school.getMotto():school.getDescription())%></p><p><strong>Alamat:</strong> <%=e(school.getAddress())%></p></article><aside class="leader-card"><h3>Pimpinan sekolah</h3><div class="leader-row"><span>Kepala sekolah</span><strong><%=e(school.getPrincipal().isEmpty()?"Belum dipublikasikan":school.getPrincipal())%></strong></div><%if(!school.getVicePrincipal().isEmpty()){%><div class="leader-row"><span>Wakil kepala sekolah</span><strong><%=e(school.getVicePrincipal())%></strong></div><%}%><%if(!school.getNss().isEmpty()){%><div class="leader-row"><span>NSS/NIS/NDS</span><strong><%=e(school.getNss())%></strong></div><%}%></aside></div></div></section><%}%>
<%if(SchoolWebsiteConfig.visible(site,"values",true)){%><section class="soft"><div class="wrap"><div class="section-head"><div><span class="kicker"><%=e(t(valuesSection,"eyebrow","Nilai utama"))%></span><h2><%=e(t(valuesSection,"title","Budaya sekolah yang membentuk karakter"))%></h2></div><p><%=e(t(valuesSection,"body","Nilai diterapkan dalam pembelajaran dan kehidupan sekolah."))%></p></div><div class="card-grid four"><%for(int i=0;i<values.length();i++){JSONObject value=item(values,i);%><article class="card"><h3><%=e(t(value,"title","Nilai sekolah"))%></h3><p><%=e(t(value,"body",""))%></p></article><%}%></div></div></section><%}%>
<%if(SchoolWebsiteConfig.visible(site,"programs",true)){%><section id="program"><div class="wrap"><div class="section-head"><div><span class="kicker"><%=e(t(programsSection,"eyebrow","Program pendidikan"))%></span><h2><%=e(t(programsSection,"title","Pengalaman belajar yang utuh"))%></h2></div><p><%=e(t(programsSection,"body","Program dapat disesuaikan dengan kekhasan sekolah."))%></p></div><div class="card-grid"><%for(int i=0;i<programs.length();i++){JSONObject program=item(programs,i);%><article class="card"><h3><%=e(t(program,"title","Program sekolah"))%></h3><p><%=e(t(program,"body",""))%></p></article><%}%></div></div></section><%}%>
<%if(SchoolWebsiteConfig.visible(site,"studentLife",true)){%><section class="dark" id="kehidupan"><div class="wrap"><div class="section-head"><div><span class="kicker"><%=e(t(studentLifeSection,"eyebrow","Kehidupan sekolah"))%></span><h2><%=e(t(studentLifeSection,"title","Ruang aman untuk belajar dan bertumbuh"))%></h2></div><p><%=e(t(studentLifeSection,"body","Kolaborasi sekolah dan keluarga menjadi bagian proses pendidikan."))%></p></div><div class="card-grid"><%for(int i=0;i<studentLife.length();i++){JSONObject life=item(studentLife,i);%><article class="card"><h3><%=e(t(life,"title","Layanan siswa"))%></h3><p><%=e(t(life,"body",""))%></p></article><%}%></div></div></section><%}%>
<%if(SchoolWebsiteConfig.visible(site,"facilities",true)){%><section id="fasilitas"><div class="wrap"><div class="section-head"><div><span class="kicker"><%=e(t(facilitiesSection,"eyebrow","Fasilitas"))%></span><h2><%=e(t(facilitiesSection,"title","Lingkungan belajar yang mendukung"))%></h2></div><p><%=e(t(facilitiesSection,"body","Fasilitas sekolah mendukung pembelajaran, kegiatan, dan kesejahteraan siswa."))%></p></div><div class="gallery-grid"><%for(int i=0;i<gallery.length();i++){JSONObject photo=item(gallery,i);String src=t(photo,"image","");%><article class="gallery-item"><%if(!src.isEmpty()){%><img src="<%=e(image(src,root+"/img/main.jpg"))%>" alt="<%=e(t(photo,"title","Fasilitas sekolah"))%>" loading="lazy" decoding="async"><%}else{%><div class="gallery-placeholder">Foto fasilitas dapat ditambahkan dari tab Website Sekolah.</div><%}%><div class="gallery-copy"><h3><%=e(t(photo,"title","Fasilitas sekolah"))%></h3><p><%=e(t(photo,"caption",""))%></p></div></article><%}%></div></div></section><%}%>
<%if(SchoolWebsiteConfig.visible(site,"news",true)){%><section class="soft" id="berita"><div class="wrap"><div class="section-head"><div><span class="kicker"><%=e(t(newsSection,"eyebrow","Kabar sekolah"))%></span><h2><%=e(t(newsSection,"title","Berita dan pengumuman terbaru"))%></h2></div><p><%=e(t(newsSection,"body","Informasi resmi yang aktif dan ditujukan untuk umum."))%></p></div><%if(news.isEmpty()){%><div class="empty">Belum ada berita atau pengumuman umum yang dipublikasikan.</div><%}else{%><div class="card-grid"><%for(NewsItem entry:news){%><article class="card news"><time><%=e(entry.getDate())%></time><h3><%=e(entry.getTitle())%></h3><p><%=e(entry.getSummary())%></p></article><%}%></div><%}%></div></section><%}%>
<%if(SchoolWebsiteConfig.visible(site,"contact",true)){%><section class="contact" id="kontak"><div class="wrap"><div class="contact-card"><div><span class="eyebrow"><%=e(t(cta,"eyebrow","Terhubung dengan sekolah"))%></span><h2>Informasi resmi <%=e(school.getName())%></h2><p><%=e(school.getAddress())%></p><div class="actions"><a class="button button-light" href="<%=href(t(cta,"primaryUrl",root+"/psb"),root+"/psb")%>"><%=e(t(cta,"primaryLabel","Daftar Sekarang"))%></a><%if(!wa.isEmpty()){%><a class="button button-outline" href="https://wa.me/<%=e(wa)%>"><%=e(t(cta,"secondaryLabel","Hubungi WhatsApp"))%></a><%}%></div></div><address class="contact-list"><%if(!school.getPhone().isEmpty()){%><a href="tel:<%=e(digits(school.getPhone()))%>">Telepon · <%=e(school.getPhone())%></a><%}%><%if(!school.getWhatsapp().isEmpty()){%><a href="https://wa.me/<%=e(wa)%>">WhatsApp · <%=e(school.getWhatsapp())%></a><%}%><%if(!school.getEmail().isEmpty()){%><a href="mailto:<%=e(school.getEmail())%>">Email · <%=e(school.getEmail())%></a><%}%><%if(!school.getFax().isEmpty()){%><span>Faks · <%=e(school.getFax())%></span><%}%><span>Identitas dan kontak selalu mengikuti data master Sekolah.</span></address></div></div></section><%}%>
</main>
<footer><div class="wrap footer-inner"><span>© <%=new java.text.SimpleDateFormat("yyyy").format(new java.util.Date())%> <%=e(school.getName())%></span><nav class="footer-links" aria-label="Informasi situs"><a href="<%=root%>/web/privasi">Privasi</a><a href="<%=root%>/web/aksesibilitas">Aksesibilitas</a><a href="<%=root%>/web/perlindungan-anak">Perlindungan Anak</a></nav><span><%=e(t(footer,"right","Didukung eSchool · CV. Zishof"))%></span></div></footer>
</body></html>

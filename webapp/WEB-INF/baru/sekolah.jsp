<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.Collections"%>
<%@ page import="java.util.List"%>
<%@ page import="org.apache.commons.lang.StringEscapeUtils"%>
<%@ page import="org.json.JSONArray"%>
<%@ page import="org.json.JSONObject"%>
<%@ page import="ais.action.servlet.landing.SchoolLandingService.SchoolProfile"%>
<%@ page import="ais.action.servlet.landing.SchoolLandingService.NewsItem"%>
<%@ page import="ais.action.servlet.landing.SchoolWebsiteConfig"%>
<%!
private static String e(Object value) { return StringEscapeUtils.escapeHtml(value == null ? "" : String.valueOf(value)); }
private static String href(String value, String fallback) {
    String v = value == null ? "" : value.trim();
    if (v.startsWith("https://") || v.startsWith("http://") || (v.startsWith("/") && !v.startsWith("//"))
            || v.startsWith("#") || v.startsWith("mailto:") || v.startsWith("tel:")) return e(v);
    return e(fallback == null ? "#" : fallback);
}
private static String image(String value, String fallback) {
    String v = value == null ? "" : value.trim();
    if (v.startsWith("https://") || v.startsWith("http://") || (v.startsWith("/") && !v.startsWith("//"))) return v;
    return fallback == null ? "" : fallback;
}
private static String digits(String value) { return value == null ? "" : value.replaceAll("[^0-9]", ""); }
private static JSONObject item(JSONArray values, int index) {
    JSONObject value = values == null ? null : values.optJSONObject(index);
    return value == null ? new JSONObject() : value;
}
private static String t(JSONObject value, String key, String fallback) { return SchoolWebsiteConfig.text(value, key, fallback); }
private static String color(JSONObject value, String key, String fallback) {
    String candidate = t(value, key, fallback);
    return candidate.matches("#[0-9a-fA-F]{6}") ? candidate : fallback;
}
private static String jsonScript(JSONObject value) {
    return value.toString().replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e");
}
private static void putJson(JSONObject target, String key, Object value) {
    try { target.put(key, value); } catch (Exception ignored) { }
}
%>
<%
SchoolProfile school = (SchoolProfile) request.getAttribute("schoolProfile");
if (school == null) { response.sendError(HttpServletResponse.SC_NOT_FOUND); return; }
JSONObject site = (JSONObject) request.getAttribute("schoolWebsite");
if (site == null) site = new JSONObject();
List<NewsItem> news = (List<NewsItem>) request.getAttribute("schoolNews");
if (news == null) news = Collections.emptyList();
String root = request.getContextPath();
String nonce = String.valueOf(request.getAttribute("websiteCspNonce"));
if ("null".equals(nonce)) nonce = "";
String canonical = String.valueOf(request.getAttribute("schoolCanonical"));
if ("null".equals(canonical) || canonical.trim().isEmpty()) canonical = root + "/sekolah/" + school.getId();
JSONObject metadata = SchoolWebsiteConfig.object(site, "metadata");
JSONObject theme = SchoolWebsiteConfig.object(site, "theme");
JSONObject announcement = SchoolWebsiteConfig.object(site, "announcement");
JSONArray navigation = SchoolWebsiteConfig.array(site, "navigation");
JSONObject hero = SchoolWebsiteConfig.object(site, "hero");
JSONObject heroPrimary = SchoolWebsiteConfig.object(hero, "primaryAction");
JSONObject heroSecondary = SchoolWebsiteConfig.object(hero, "secondaryAction");
JSONObject loginAction = SchoolWebsiteConfig.object(hero, "loginAction");
JSONObject profileSection = SchoolWebsiteConfig.object(site, "profile");
JSONObject valuesSection = SchoolWebsiteConfig.object(site, "valuesSection");
JSONArray values = SchoolWebsiteConfig.array(site, "values");
JSONObject programsSection = SchoolWebsiteConfig.object(site, "programsSection");
JSONArray programs = SchoolWebsiteConfig.array(site, "programs");
JSONObject studentLifeSection = SchoolWebsiteConfig.object(site, "studentLifeSection");
JSONArray studentLife = SchoolWebsiteConfig.array(site, "studentLife");
JSONObject facilitiesSection = SchoolWebsiteConfig.object(site, "facilitiesSection");
JSONArray gallery = SchoolWebsiteConfig.array(site, "gallery");
JSONObject newsSection = SchoolWebsiteConfig.object(site, "newsSection");
JSONObject cta = SchoolWebsiteConfig.object(site, "cta");
JSONObject footer = SchoolWebsiteConfig.object(site, "footer");
String language = t(metadata, "language", "id").toLowerCase(java.util.Locale.ENGLISH);
if (!language.matches("[a-z]{2,8}(-[a-z0-9]{2,8})*")) language = "id";
String baseLanguage = language.contains("-") ? language.substring(0, language.indexOf('-')) : language;
String direction = ("ar".equals(baseLanguage) || "fa".equals(baseLanguage) || "he".equals(baseLanguage)
        || "ur".equals(baseLanguage)) ? "rtl" : "ltr";
String title = school.getName() + " - Website Resmi Sekolah";
String description = school.getDescription().isEmpty()
        ? "Website resmi " + school.getName() + ". Informasi profil, program, kegiatan, berita, dan penerimaan siswa."
        : school.getDescription();
String wa = digits(school.getWhatsapp()); if (wa.startsWith("0")) wa = "62" + wa.substring(1);
JSONObject schema = new JSONObject();
putJson(schema,"@context","https://schema.org"); putJson(schema,"@type","School");
putJson(schema,"name",school.getName()); putJson(schema,"description",description); putJson(schema,"url",canonical);
putJson(schema,"logo",image(school.getLogo(),root+"/img/logo.png"));
if (!school.getAddress().isEmpty()) putJson(schema,"address",school.getAddress());
if (!school.getPhone().isEmpty()) putJson(schema,"telephone",school.getPhone());
if (!school.getEmail().isEmpty()) putJson(schema,"email",school.getEmail());
%>
<!doctype html>
<html lang="<%=e(language)%>" dir="<%=direction%>">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%=e(title)%></title>
    <meta name="description" content="<%=e(description)%>"><meta name="robots" content="index,follow,max-image-preview:large">
    <link rel="canonical" href="<%=e(canonical)%>"><link rel="icon" href="<%=e(image(school.getLogo(), root + "/img/logo.png"))%>">
    <meta name="theme-color" content="<%=e(color(theme, "primary", "#1d4ed8"))%>">
    <meta property="og:type" content="website"><meta property="og:title" content="<%=e(title)%>">
    <meta property="og:description" content="<%=e(description)%>"><meta property="og:url" content="<%=e(canonical)%>">
    <meta property="og:image" content="<%=e(image(school.getHero(), root + "/img/main.jpg"))%>">
    <meta property="og:site_name" content="<%=e(school.getName())%>"><meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" nonce="<%=e(nonce)%>"><%=jsonScript(schema)%></script>
    <style nonce="<%=e(nonce)%>">

<%@page import="java.util.UUID"%>
<%@page import="ais.common.Common"%>
<%@page import="ais.database.model.Tbmuser"%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
Tbmuser apotikUser = Common.getCurrentUser(request);
if (apotikUser == null || !apotikUser.getAktif()) { response.sendError(403); return; }
String apotikView = (String) request.getAttribute("apotikView");
if (apotikView == null) apotikView = "kasir";
String apotikHelpKey = "apotik_" + apotikView;
String csrf = (String) session.getAttribute("apotikJspCsrf");
if (csrf == null) { csrf = UUID.randomUUID().toString(); session.setAttribute("apotikJspCsrf", csrf); }
%>
<style>
.apt{--a:#2563eb;--b:#0891b2}.apt .card{border:0;box-shadow:0 4px 18px rgba(15,23,42,.08)}.apt .apt-head{background:linear-gradient(135deg,var(--a),var(--b));color:#fff;border-radius:14px;padding:20px}.apt .table{font-size:.88rem}.apt .result-row{cursor:pointer}.apt .result-row:hover{background:#eff6ff}.apt .money{text-align:right;font-variant-numeric:tabular-nums}.apt .pill{display:inline-block;padding:.2rem .5rem;border-radius:999px;background:#e0f2fe;color:#075985;font-size:.75rem}.apt .danger{background:#fee2e2;color:#991b1b}.apt .sticky-actions{position:sticky;bottom:0;background:#fff;padding:12px 0;border-top:1px solid #e5e7eb}
</style>
<div class="apt container-fluid pb-4" data-view="<%= apotikView %>">
<div class="apt-head mb-3 d-flex justify-content-between align-items-center"><div><h4 class="m-0" id="apt-title">POS Apotik</h4><small id="apt-subtitle">Layanan farmasi native JSP</small></div><div class="d-flex gap-2"><a class="btn btn-success btn-sm" href="<%=request.getContextPath()%>/baru?p=apotik&amp;s=help&amp;mode=qa&amp;menu=<%=apotikHelpKey%>"><i class="fas fa-comments"></i> Tanya Jawab</a><a class="btn btn-warning btn-sm" href="<%=request.getContextPath()%>/baru?p=apotik&amp;s=help&amp;menu=<%=apotikHelpKey%>"><i class="fas fa-question-circle"></i> Bantuan</a><a class="btn btn-light btn-sm" href="<%=request.getContextPath()%>/main"><i class="fas fa-home"></i> Beranda</a></div></div>
  <div id="apt-alert"></div><div id="apt-content"><div class="text-center py-5"><span class="spinner-border text-primary"></span></div></div>
</div>
<script>
(function(){
const view='<%=apotikView%>', endpoint='<%=request.getContextPath()%>/baru?p=apotik&s=service', csrf='<%=csrf%>';
const content=document.getElementById('apt-content'), alertBox=document.getElementById('apt-alert');
let items=[], cart=[];
const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=v=>Number(v||0), rup=v=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(num(v));
const today=()=>new Date().toISOString().slice(0,10), ago=n=>{let d=new Date();d.setDate(d.getDate()-n);return d.toISOString().slice(0,10)};
function msg(text,type='success'){alertBox.innerHTML='<div class="alert alert-'+type+' alert-dismissible fade show">'+esc(text)+'<button class="btn-close" data-bs-dismiss="alert"></button></div>';window.scrollTo({top:0,behavior:'smooth'})}
async function api(action,data={}){const r=await fetch(endpoint,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-Apotik-CSRF':csrf},body:JSON.stringify(Object.assign({action},data))});let j;try{j=await r.json()}catch(e){throw Error('Respons server tidak valid')};if(!r.ok||j.status!=='success')throw Error(j.message||j.description||'Permintaan ditolak');return j}
function title(a,b){document.getElementById('apt-title').textContent=a;document.getElementById('apt-subtitle').textContent=b}
function searchBox(label='Cari obat / barcode'){return '<div class="input-group mb-3"><input id="apt-search" class="form-control" placeholder="'+label+'"><button id="apt-search-btn" class="btn btn-primary"><i class="fas fa-search"></i> Cari</button></div><div id="apt-results"></div>'}
async function search(render){const q=document.getElementById('apt-search').value.trim();const r=await api('apotik_item_cari',{keyword:q,page_size:50});items=r.data||[];render(items)}
function bindSearch(render){document.getElementById('apt-search-btn').onclick=()=>search(render).catch(e=>msg(e.message,'danger'));document.getElementById('apt-search').onkeydown=e=>{if(e.key==='Enter')document.getElementById('apt-search-btn').click()}}
function itemTable(rows,onClick){return '<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Kode</th><th>Obat</th><th>Satuan</th><th>Golongan</th><th class="money">Stok</th><th class="money">Harga</th></tr></thead><tbody>'+rows.map((x,i)=>'<tr class="result-row" data-i="'+i+'"><td>'+esc(x.kode)+'</td><td><b>'+esc(x.nama)+'</b>'+(x.lasa?' <span class="pill danger">LASA</span>':'')+'</td><td>'+esc(x.satuan)+'</td><td><span class="pill">'+esc(x.golonganObat)+'</span></td><td class="money">'+num(x.stok)+'</td><td class="money">'+rup(x.hargaJual)+'</td></tr>').join('')+'</tbody></table></div>'}
async function addCart(it,qty){qty=num(qty||1);if(qty<=0)return;let batches=(await api('apotik_item_batch',{item_id:it.id})).data||[],need=qty,picked=[];for(const b of batches){if(b.kedaluwarsa||num(b.sisa)<=0)continue;let q=Math.min(need,num(b.sisa));if(q>0){picked.push({kadaluarsa_id:b.kadaluarsaId,qty:q,tanggal:b.tanggalKadaluarsa});need-=q}if(need<=0)break}if(batches.length&&need>0)throw Error('Batch valid tidak cukup untuk '+it.nama);let old=cart.find(x=>x.item_id===it.id);if(old){old.qty+=qty;old.batch=(old.batch||[]).concat(picked)}else cart.push({item_id:it.id,nama:it.nama,qty,harga_satuan:num(it.hargaJual),diskon:0,batch:picked,terkendali:!!it.terkendali});renderCart()}
function renderCart(){let box=document.getElementById('apt-cart');if(!box)return;box.innerHTML='<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Obat</th><th>Qty</th><th>Harga</th><th>Diskon</th><th>Total</th><th></th></tr></thead><tbody>'+cart.map((x,i)=>'<tr><td>'+esc(x.nama)+(x.terkendali?' <span class="pill danger">TERKENDALI</span>':'')+'</td><td><input class="form-control form-control-sm cart-qty" data-i="'+i+'" type="number" min=".01" step=".01" value="'+x.qty+'"></td><td><input class="form-control form-control-sm cart-harga" data-i="'+i+'" type="number" value="'+x.harga_satuan+'"></td><td><input class="form-control form-control-sm cart-disc" data-i="'+i+'" type="number" value="'+x.diskon+'"></td><td class="money">'+rup(x.qty*x.harga_satuan-x.diskon)+'</td><td><button class="btn btn-sm btn-outline-danger cart-del" data-i="'+i+'">×</button></td></tr>').join('')+'</tbody></table></div><div class="text-end fs-5 fw-bold">Total: '+rup(cart.reduce((s,x)=>s+x.qty*x.harga_satuan-x.diskon,0))+'</div>';box.querySelectorAll('.cart-del').forEach(b=>b.onclick=()=>{cart.splice(+b.dataset.i,1);renderCart()});[['.cart-qty','qty'],['.cart-harga','harga_satuan'],['.cart-disc','diskon']].forEach(z=>box.querySelectorAll(z[0]).forEach(el=>el.onchange=()=>{cart[+el.dataset.i][z[1]]=num(el.value);renderCart()}))}
function kasir(){title(view==='resep'?'Tebus Resep':'Kasir Apotik','Transaksi aman dengan validasi stok, batch FEFO, dan obat terkendali');content.innerHTML='<div class="row g-3"><div class="col-lg-7"><div class="card p-3">'+searchBox()+'<div id="apt-results"></div></div></div><div class="col-lg-5"><div class="card p-3"><div class="d-flex justify-content-between"><h5>Keranjang</h5>'+(view==='resep'?'<button id="resep-btn" class="btn btn-sm btn-outline-primary">Pilih Resep</button>':'')+'</div><div id="apt-cart" class="my-2"></div><input id="buyer" class="form-control mb-2" placeholder="Nama pembeli/pasien"><input id="address" class="form-control mb-2" placeholder="Alamat pembeli"><input id="doctor" class="form-control mb-2" placeholder="Nama dokter"><textarea id="note" class="form-control mb-2" placeholder="Keterangan"></textarea><button id="pay" class="btn btn-success w-100"><i class="fas fa-check"></i> Simpan & Bayar Tunai</button></div></div></div>';bindSearch(rows=>{document.getElementById('apt-results').innerHTML=itemTable(rows);document.querySelectorAll('.result-row').forEach(tr=>tr.onclick=()=>addCart(rows[+tr.dataset.i],1).catch(e=>msg(e.message,'danger')))});renderCart();document.getElementById('pay').onclick=async()=>{if(!cart.length)return msg('Keranjang masih kosong.','warning');try{let r=await api('apotik_bayar',{kode:'JSPAPT'+Date.now(),resep_id:window._resepId||undefined,pembeli:{nama:document.getElementById('buyer').value,alamat:document.getElementById('address').value},nama_dokter:document.getElementById('doctor').value,keterangan:document.getElementById('note').value,items:cart});msg('Transaksi '+r.kode+' tersimpan. Total '+rup(r.total));cart=[];renderCart()}catch(e){msg(e.message,'danger')}};if(view==='resep')document.getElementById('resep-btn').onclick=async()=>{try{let r=await api('apotik_resep_list',{hanya_menunggu:true,page_size:50});let list=r.data||[],kode=prompt('Kode resep tersedia:\n'+list.map(x=>x.kode+' ('+x.jumlahBaris+' item)').join('\n')+'\n\nMasukkan kode:');let resep=list.find(x=>x.kode===kode);if(!resep)return;let d=await api('apotik_resep_detail',{resep_id:resep.id});window._resepId=resep.id;for(const x of d.data||[])if(!x.racikan)await addCart({id:x.itemId,nama:x.nama,hargaJual:x.hargaJual,terkendali:x.terkendali},x.jumlah);if(d.adaRacikan)msg('Resep memuat racikan. Lengkapi pada menu Racikan sebelum penyerahan.','warning')}catch(e){msg(e.message,'danger')}}}
function formularium(){title('Formularium & Obat','Cari obat lalu ubah golongan dan penanda LASA');content.innerHTML='<div class="card p-3">'+searchBox()+'</div>';bindSearch(rows=>{document.getElementById('apt-results').innerHTML=itemTable(rows);document.querySelectorAll('.result-row').forEach(tr=>tr.onclick=async()=>{let x=rows[+tr.dataset.i],g=prompt('Golongan: BEBAS, BEBAS_TERBATAS, KERAS, NARKOTIKA, PSIKOTROPIKA',x.golonganObat);if(!g)return;try{await api('apotik_item_profil_simpan',{item_id:x.id,golongan_obat:g.toUpperCase(),lasa:confirm('Tandai sebagai obat LASA?')});msg('Profil '+x.nama+' diperbarui.');search(rows=>{})}catch(e){msg(e.message,'danger')}})})}
function batch(){title('Batch & Kedaluwarsa','Monitor FEFO dan sisa batch');content.innerHTML='<div class="card p-3"><div class="input-group mb-3"><span class="input-group-text">Hari ke depan</span><input id="days" type="number" class="form-control" value="90"><button id="load" class="btn btn-primary">Muat</button></div><div id="grid"></div></div>';document.getElementById('load').onclick=async()=>{try{let r=await api('apotik_batch_monitor',{hari_ke_depan:+document.getElementById('days').value,page_size:100}),d=r.data||[];document.getElementById('grid').innerHTML='<div class="table-responsive"><table class="table"><thead><tr><th>Obat</th><th>Batch/ED</th><th>Lokasi</th><th>Sisa</th><th>Status</th></tr></thead><tbody>'+d.map(x=>'<tr><td>'+esc(x.nama||x.itemNama)+'</td><td>'+esc(x.tanggalKadaluarsa)+'</td><td>'+esc(x.lokasi||x.lokasiNama)+'</td><td>'+num(x.sisa)+'</td><td>'+(x.kedaluwarsa?'<span class="pill danger">Kedaluwarsa</span>':'<span class="pill">Aktif</span>')+'</td></tr>').join('')+'</tbody></table></div>'}catch(e){msg(e.message,'danger')}};document.getElementById('load').click()}
function mutation(kind){let cfg={pengadaan:['Penerimaan PBF','apotik_terima_barang','qty'],stok_opname:['Stok Opname','apotik_opname_simpan','qty_fisik'],retur:['Retur Obat','apotik_retur_simpan','qty']}[kind];title(cfg[0],'Pencatatan persediaan dengan validasi server');content.innerHTML='<div class="row g-3"><div class="col-lg-6"><div class="card p-3">'+searchBox()+'</div></div><div class="col-lg-6"><div class="card p-3"><h5>Daftar Item</h5><div id="lines"></div>'+(kind==='pengadaan'?'<input id="supplier" class="form-control mb-2" placeholder="Penyedia / PBF"><input id="invoice" class="form-control mb-2" placeholder="Nomor faktur">':'')+(kind==='retur'?'<select id="ret-type" class="form-select mb-2"><option value="MASUK">Retur dari pembeli (masuk)</option><option value="KELUAR">Retur ke PBF (keluar)</option></select><input id="ret-note" class="form-control mb-2" placeholder="Keterangan">':'')+'<button id="save" class="btn btn-success w-100">Simpan</button></div></div></div>';let lines=[];function draw(){document.getElementById('lines').innerHTML=lines.map((x,i)=>'<div class="row g-2 mb-2"><div class="col-6">'+esc(x.nama)+'</div><div class="col-3"><input data-i="'+i+'" class="form-control form-control-sm line-qty" type="number" step=".01" value="'+x[cfg[2]]+'"></div>'+(kind==='pengadaan'?'<div class="col-3"><input data-i="'+i+'" class="form-control form-control-sm line-price" type="number" placeholder="Harga" value="'+(x.harga_beli||0)+'"><input data-i="'+i+'" class="form-control form-control-sm line-ed mt-1" type="date" value="'+(x.tanggal_kadaluarsa||'')+'"></div>':'')+'</div>').join('');document.querySelectorAll('.line-qty').forEach(e=>e.onchange=()=>lines[+e.dataset.i][cfg[2]]=num(e.value));document.querySelectorAll('.line-price').forEach(e=>e.onchange=()=>lines[+e.dataset.i].harga_beli=num(e.value));document.querySelectorAll('.line-ed').forEach(e=>e.onchange=()=>lines[+e.dataset.i].tanggal_kadaluarsa=e.value)}bindSearch(rows=>{document.getElementById('apt-results').innerHTML=itemTable(rows);document.querySelectorAll('.result-row').forEach(tr=>tr.onclick=()=>{let x=rows[+tr.dataset.i];if(!lines.some(y=>y.item_id===x.id)){let y={item_id:x.id,nama:x.nama};y[cfg[2]]=kind==='stok_opname'?x.stok:1;lines.push(y);draw()}})});document.getElementById('save').onclick=async()=>{if(!lines.length)return msg('Tambahkan item terlebih dahulu.','warning');let data={items:lines.map(x=>{let y={item_id:x.item_id};y[cfg[2]]=x[cfg[2]];if(kind==='pengadaan'){y.harga_beli=x.harga_beli||0;if(x.tanggal_kadaluarsa)y.tanggal_kadaluarsa=x.tanggal_kadaluarsa}return y})};if(kind==='pengadaan'){data.penyedia=document.getElementById('supplier').value;data.no_faktur=document.getElementById('invoice').value}if(kind==='retur'){data.jenis=document.getElementById('ret-type').value;data.keterangan=document.getElementById('ret-note').value}try{let r=await api(cfg[1],data);msg(cfg[0]+' berhasil disimpan ('+(r.jumlahBaris||data.items.length)+' baris).');lines=[];draw()}catch(e){msg(e.message,'danger')}}}
function laporan(onlyControlled){
  title(onlyControlled?'Register Obat Terkendali':'Laporan Apotik','Penjualan, register obat terkendali, serta batch kedaluwarsa');
  content.innerHTML='<div class="card p-3"><div class="row g-2 mb-3">'
    +(onlyControlled?'':'<div class="col-md-3"><select id="report-type" class="form-select"><option value="penjualan">Penjualan</option><option value="kedaluwarsa">Kedaluwarsa</option></select></div>')
    +'<div class="col"><input id="from" type="date" class="form-control" value="'+ago(30)+'"></div><div class="col"><input id="to" type="date" class="form-control" value="'+today()+'"></div>'
    +'<div class="col-md-2"><input id="expiry-days" type="number" min="0" class="form-control d-none" value="90" title="Hari ke depan"></div>'
    +'<div class="col-auto"><button id="load" class="btn btn-primary">Muat</button></div></div><div id="report"></div></div>';
  const type=document.getElementById('report-type'),expiryDays=document.getElementById('expiry-days'),from=document.getElementById('from'),to=document.getElementById('to');
  function toggleFilter(){const expiry=!onlyControlled&&type.value==='kedaluwarsa';expiryDays.classList.toggle('d-none',!expiry);from.classList.toggle('d-none',expiry);to.classList.toggle('d-none',expiry)}
  if(type){type.onchange=toggleFilter;toggleFilter()}
  document.getElementById('load').onclick=async()=>{try{
    const kind=onlyControlled?'terkendali':type.value;
    const action=kind==='terkendali'?'apotik_laporan_terkendali':(kind==='kedaluwarsa'?'apotik_laporan_kedaluwarsa':'apotik_laporan_penjualan');
    const payload=kind==='kedaluwarsa'?{hari_ke_depan:num(expiryDays.value)}:{dari:from.value,sampai:to.value};
    const r=await api(action,payload),rows=kind==='penjualan'?(r.perItem||[]):(r.data||[]);
    let kpi='<div class="row g-2 mb-3">';
    if(kind==='kedaluwarsa')kpi+='<div class="col-md-4"><div class="card p-3"><small>Sudah Kedaluwarsa</small><b class="fs-4 text-danger">'+num(r.jumlahKedaluwarsa)+'</b></div></div><div class="col-md-4"><div class="card p-3"><small>Segera Kedaluwarsa</small><b class="fs-4">'+num(r.jumlahSegera)+'</b></div></div>';
    else kpi+='<div class="col-md-4"><div class="card p-3"><small>Total Qty</small><b class="fs-4">'+num(r.totalQty)+'</b></div></div>';
    if(kind!=='terkendali')kpi+='<div class="col-md-4"><div class="card p-3"><small>Total Nilai</small><b class="fs-4">'+rup(r.totalNilai)+'</b></div></div>';
    kpi+='</div>';
    const keys=Object.keys(rows[0]||{});
    document.getElementById('report').innerHTML=kpi+(rows.length?'<div class="table-responsive"><table class="table"><thead><tr>'+keys.map(k=>'<th>'+esc(k)+'</th>').join('')+'</tr></thead><tbody>'+rows.map(x=>'<tr>'+keys.map(k=>'<td>'+esc(x[k])+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>':'<div class="alert alert-info">Belum ada data untuk filter tersebut.</div>');
  }catch(e){msg(e.message,'danger')}};
  document.getElementById('load').click()
}
if(view==='kasir'||view==='resep')kasir();else if(view==='formularium')formularium();else if(view==='batch')batch();else if(view==='pengadaan'||view==='stok_opname'||view==='retur')mutation(view);else if(view==='narkotika')laporan(true);else laporan(false);
})();
</script>

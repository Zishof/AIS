  function suggestions(){clearTimeout(suggestionTimer);var q=value('query'),key=q.toLowerCase(),box=el('librarySuggestions');if(q.length<2){box.hidden=true;box.innerHTML='';return;}function paint(rows){var last='';box.innerHTML=rows.map(function(x){var type=x.type||'TITLE',heading=type!==last?'<span class="library-suggestion-group">'+esc({TITLE:'<%=Common.getBahasaConfigJS("Judul")%>',AUTHOR:'<%=Common.getBahasaConfigJS("Penulis")%>',SUBJECT:'<%=Common.getBahasaConfigJS("Subjek")%>',CALL_NUMBER:'<%=Common.getBahasaConfigJS("Nomor panggil")%>',ISBN:'ISBN'}[type]||type)+'</span>':'';last=type;return heading+'<button type="button" role="option" data-suggestion="'+esc(x.value||x.title)+'" data-suggestion-type="'+esc(type)+'"><strong>'+esc(x.value||x.title)+'</strong><span>'+esc(x.meta||x.authors||'')+'</span></button>';}).join('');box.hidden=!rows.length;box.querySelectorAll('[data-suggestion]').forEach(function(b){b.onclick=function(){el('libraryQuery').value=b.getAttribute('data-suggestion');el('librarySearchField').value=b.getAttribute('data-suggestion-type')||'ALL';box.hidden=true;page=1;load();};});}if(suggestionCache[key]){paint(suggestionCache[key]);return;}suggestionTimer=setTimeout(function(){if(suggestionController)suggestionController.abort();suggestionController=window.AbortController?new AbortController():null;LibraryModern.fetchJson(api,{action:'suggestions',query:q},suggestionController?{signal:suggestionController.signal}:{}).then(function(d){var rows=d.items||[];suggestionCache[key]=rows;if(Object.keys(suggestionCache).length>30)suggestionCache={};paint(rows);}).catch(function(e){if(!e||e.name!=='AbortError')box.hidden=true;});},280);}

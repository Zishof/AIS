  el('libraryMobileMode').onclick=function(){setView(el('libraryResults').classList.contains('library-grid-mode')?'list':'grid');};el('libraryScan').onclick=function(){if(!window.BarcodeDetector)return notify('<%=Common.getBahasaConfigJS("Pemindaian barcode belum didukung browser ini. Ketik ISBN pada kotak pencarian.")%>','warning');el('libraryScanInput').click();};el('libraryScanInput').onchange=function(){var file=this.files&&this.files[0];if(!file)return;createImageBitmap(file).then(function(bitmap){return new BarcodeDetector({formats:['ean_13','ean_8','code_128','qr_code']}).detect(bitmap);}).then(function(rows){if(!rows.length)throw new Error('<%=Common.getBahasaConfigJS("Barcode tidak terbaca. Coba foto yang lebih jelas.")%>');el('libraryQuery').value=rows[0].rawValue;el('librarySearchField').value='ISBN';page=1;load();}).catch(function(e){notify(e.message,'warning');});};

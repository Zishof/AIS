  if(window.IntersectionObserver){var stickyOffset=parseInt(getComputedStyle(el('libraryCatalog')).getPropertyValue('--library-fixed-header-offset'),10)||76;new IntersectionObserver(function(entries){var visible=!entries[0].isIntersecting,bar=el('libraryStickySearch');bar.classList.toggle('is-visible',visible);bar.setAttribute('aria-hidden',String(!visible));if(visible)el('libraryStickyQuery').value=value('query');},{rootMargin:(-stickyOffset)+'px 0px 0px 0px',threshold:0.05}).observe(el('libraryQuickSearch'));}

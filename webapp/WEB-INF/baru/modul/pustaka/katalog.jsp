  el('libraryFilterToggle').onclick=openFacets;el('libraryMobileFilter').onclick=openFacets;el('libraryFacetClose').onclick=closeFacets;el('libraryFacetBackdrop').onclick=closeFacets;el('libraryShelfClose').onclick=function(){el('libraryShelfDialog').close();};el('libraryMobileSort').onclick=function(){el('librarySort').focus();el('librarySort').scrollIntoView({behavior:'smooth',block:'center'});};el('libraryListMode').onclick=function(){setView('list');};el('libraryGridMode').onclick=function(){setView('grid');};el('librarySaveSearch').onclick=saveSearch;el('libraryShareSearch').onclick=function(){var url=location.href;if(navigator.share)navigator.share({title:'Perpustakaan Digital',url:url}).catch(function(){});else copyText(url).then(function(){notify('<%=Common.getBahasaConfigJS("Tautan pencarian disalin")%>','success');});};
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeFacets();el('librarySuggestions').hidden=true;}if(e.key==='Tab'&&el('libraryFacets').classList.contains('is-open')){var nodes=el('libraryFacets').querySelectorAll('button,input,select,summary'),first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}});window.addEventListener('online',function(){notify('<%=Common.getBahasaConfigJS("Koneksi kembali tersedia")%>','success');});window.addEventListener('offline',function(){notify('<%=Common.getBahasaConfigJS("Koneksi internet terputus")%>','warning');});
  function bindQuickSearches(){document.querySelectorAll('#libraryCatalog'+suffix+' [data-quick-query]').forEach(function(b){b.onclick=function(){el('libraryQuery').value=b.getAttribute('data-quick-query');el('librarySearchField').value='ALL';page=1;load();};});document.querySelectorAll('#libraryCatalog'+suffix+' [data-quick-availability]').forEach(function(b){b.onclick=function(){el('libraryAvailability').value=b.getAttribute('data-quick-availability');page=1;load();};});}
  var bulkSelected={};
  function bulkRows(){return Object.keys(bulkSelected).map(function(id){return bulkSelected[id];});}
  function refreshBulk(){var rows=bulkRows(),bar=el('libraryBulkBar');bar.hidden=!rows.length;el('libraryBulkCount').textContent=rows.length;}
  function enableBulkSelection(){el('libraryResults').querySelectorAll('.library-result-v2').forEach(function(card){if(card.querySelector('[data-bulk-select]'))return;var cite=card.querySelector('[data-cite]');if(!cite)return;var id=cite.getAttribute('data-cite'),title=(card.querySelector('h3')||{}).textContent||'',meta=(card.querySelector('.library-meta')||{}).textContent||'',hold=card.querySelector('[data-hold]'),favorite=card.querySelector('[data-favorite]');var label=document.createElement('label');label.className='library-result-select';label.title='<%=Common.getBahasaConfigJS("Pilih koleksi")%>';label.innerHTML='<input type="checkbox" data-bulk-select="'+esc(id)+'" aria-label="<%=Common.getBahasaConfigJS("Pilih koleksi")%> '+esc(title.trim())+'">';card.insertBefore(label,card.firstChild);label.querySelector('input').onchange=function(){if(this.checked)bulkSelected[id]={id:id,title:title.trim(),meta:meta.trim(),hold:hold,favorite:favorite};else delete bulkSelected[id];refreshBulk();};});}
  function downloadBulkCitation(rows){var ris=rows.map(function(x){return 'TY  - BOOK\nTI  - '+x.title+'\nN1  - '+x.meta+'\nUR  - '+location.origin+root+'/pustaka?id='+x.id+'\nER  - \n';}).join('\n'),blob=new Blob([ris],{type:'application/x-research-info-systems'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='sitasi-koleksi-terpilih.ris';a.click();setTimeout(function(){URL.revokeObjectURL(a.href);},500);}
  function bulkAction(action){var rows=bulkRows();if(!rows.length)return;if(action==='clear'){bulkSelected={};el('libraryResults').querySelectorAll('[data-bulk-select]').forEach(function(x){x.checked=false;});return refreshBulk();}if(action==='cite')return downloadBulkCitation(rows);if(action==='share')return copyText(rows.map(function(x){return location.origin+root+'/pustaka?id='+x.id;}).join('\n')).then(function(){notify('<%=Common.getBahasaConfigJS("Tautan koleksi terpilih disalin")%>','success');});if(action==='list'){if(!capabilities.favorite)return notify('<%=Common.getBahasaConfigJS("Masuk sebagai anggota untuk membuat daftar bacaan")%>','warning');rows.forEach(function(x){if(x.favorite)x.favorite.click();});return;}if(action==='hold'){var eligible=rows.filter(function(x){return x.hold;});if(!eligible.length)return notify('<%=Common.getBahasaConfigJS("Tidak ada koleksi terpilih yang dapat direservasi")%>','warning');eligible.forEach(function(x){x.hold.click();});return;}if(action==='compare'){el('libraryCompareContent').innerHTML='<table class="library-table"><thead><tr><th><%=Common.getBahasaConfigJS("Judul")%></th><th><%=Common.getBahasaConfigJS("Metadata")%></th><th><%=Common.getBahasaConfigJS("Tindakan")%></th></tr></thead><tbody>'+rows.map(function(x){return '<tr><td>'+esc(x.title)+'</td><td>'+esc(x.meta)+'</td><td><a href="'+root+'/pustaka?id='+encodeURIComponent(x.id)+'"><%=Common.getBahasaConfigJS("Detail")%></a></td></tr>';}).join('')+'</tbody></table>';var d=el('libraryCompareDialog');if(d.showModal)d.showModal();else d.setAttribute('open','open');}}
  el('libraryBulkBar').querySelectorAll('[data-bulk-action]').forEach(function(b){b.onclick=function(){bulkAction(b.getAttribute('data-bulk-action'));};});
  function hideUnconfiguredShelfMaps(){el('libraryResults').querySelectorAll('.library-result-v2').forEach(function(card){var configured=Array.from(card.querySelectorAll('.library-holding small')).some(function(x){return x.textContent.trim().indexOf('<%=Common.getBahasaConfigJS("Rak")%> ')===0;});if(!configured)card.querySelectorAll('[data-shelf]').forEach(function(x){x.remove();});});}
  function routeDigitalReaders(){el('libraryResults').querySelectorAll('.library-result-v2').forEach(function(card){var id=(card.querySelector('[data-cite]')||{}).getAttribute&&card.querySelector('[data-cite]').getAttribute('data-cite');card.querySelectorAll('.library-action-link .fa-book').forEach(function(icon){if(id)icon.closest('a').href=root+'/pustaka?s=reader&id='+encodeURIComponent(id);});});}
  function highlightSnippets(){var q=value('query');if(!q)return;var words=q.split(/\s+/).filter(function(x){return x.length>2;}).slice(0,5);if(!words.length)return;var pattern=new RegExp('('+words.map(function(x){return x.replace(/[.*+?^$(){}|[\]\\]/g,'\\$&');}).join('|')+')','ig');el('libraryResults').querySelectorAll('.library-summary').forEach(function(node){if(node.dataset.highlighted)return;node.dataset.highlighted='true';var text=node.textContent,parts=text.split(pattern);node.innerHTML=parts.map(function(x){return words.some(function(w){return w.toLowerCase()===x.toLowerCase();})?'<mark>'+esc(x)+'</mark>':esc(x);}).join('');});}
  function enhanceEmptyState(){var box=el('libraryResults'),state=box.querySelector('.library-state'),q=value('query');if(!state||!q||state.dataset.enhanced)return;state.dataset.enhanced='true';LibraryModern.fetchJson(api,{action:'suggestions',query:q.slice(0,Math.max(2,q.length-1))}).then(function(d){var alternatives=(d.items||[]).map(function(x){return x.value||x.title;}).filter(function(x,i,a){return x&&x.toLowerCase()!==q.toLowerCase()&&a.indexOf(x)===i;}).slice(0,3);var extra=document.createElement('div');extra.className='library-empty-suggestions';extra.innerHTML=(alternatives.length?'<strong><%=Common.getBahasaConfigJS("Apakah yang Anda maksud")%>?</strong> '+alternatives.map(function(x){return '<button type="button" data-empty-query="'+esc(x)+'">'+esc(x)+'</button>';}).join(' '):'<span><%=Common.getBahasaConfigJS("Periksa ejaan atau gunakan kata yang lebih umum.")%></span>')+' <a href="'+root+'/pustaka?s=layanan_anggota"><%=Common.getBahasaConfigJS("Ajukan usulan koleksi")%></a>';state.appendChild(extra);extra.querySelectorAll('[data-empty-query]').forEach(function(b){b.onclick=function(){el('libraryQuery').value=b.getAttribute('data-empty-query');page=1;load();};});}).catch(function(){});}
  new MutationObserver(function(){enableBulkSelection();hideUnconfiguredShelfMaps();routeDigitalReaders();highlightSnippets();enhanceEmptyState();}).observe(el('libraryResults'),{childList:true});
  el('libraryCompareClose').onclick=function(){el('libraryCompareDialog').close();};el('librarySaveClose').onclick=function(){el('librarySaveDialog').close();};

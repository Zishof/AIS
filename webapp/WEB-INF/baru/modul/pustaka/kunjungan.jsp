<%@page import="ais.common.Common"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%String rnd=Common.getGeneratedBarCode(7);String root=Common.ROOT;%>
<link rel="stylesheet" href="<%=root%>/assets/library-modern/library.css"><script src="<%=root%>/assets/library-modern/library.js"></script>
<section class="library-modern library-page"><div class="library-container">
 <header class="library-page-head"><div><div class="library-eyebrow"><%=Common.getBahasaConfig("Privasi terjaga")%></div><h1><%=Common.getBahasaConfig("Kunjungan Perpustakaan")%></h1><p class="library-muted"><%=Common.getBahasaConfig("Pengunjung publik melihat agregat; anggota melihat riwayat sendiri; identitas lengkap hanya untuk petugas berwenang.")%></p></div></header>
 <article class="library-card library-card-pad"><div class="library-toolbar"><div class="library-toolbar-field"><label for="visitQuery<%=rnd%>"><%=Common.getBahasaConfig("Cari anggota (khusus petugas)")%></label><input class="library-input" id="visitQuery<%=rnd%>" maxlength="100"></div><div class="library-toolbar-field"><label for="visitLibrary<%=rnd%>"><%=Common.getBahasaConfig("Cabang")%></label><select class="library-select" id="visitLibrary<%=rnd%>"><option value=""><%=Common.getBahasaConfig("Semua cabang")%></option></select></div><button class="library-button library-button-primary" id="visitApply<%=rnd%>" type="button"><%=Common.getBahasaConfig("Terapkan")%></button></div>
 <div class="library-muted" id="visitInfo<%=rnd%>" aria-live="polite"></div><div class="library-table-wrap"><table class="library-table"><thead><tr><th><%=Common.getBahasaConfig("Tanggal")%></th><th><%=Common.getBahasaConfig("Perpustakaan")%></th><th><%=Common.getBahasaConfig("Anggota / Jumlah")%></th><th><%=Common.getBahasaConfig("Keterangan")%></th></tr></thead><tbody id="visitRows<%=rnd%>"></tbody></table></div><nav class="library-pagination"><button class="library-button" id="visitPrev<%=rnd%>" type="button"><%=Common.getBahasaConfig("Sebelumnya")%></button><span id="visitPage<%=rnd%>">1</span><button class="library-button" id="visitNext<%=rnd%>" type="button"><%=Common.getBahasaConfig("Selanjutnya")%></button></nav></article>
</div></section>
<script>(function(){'use strict';var s='<%=rnd%>',root='<%=root%>',api=root+'/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_workspace_api',catalog=root+'/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_catalog_api',page=1,size=20,total=0;function e(id){return document.getElementById(id+s);}LibraryModern.fetchJson(catalog,{action:'references'}).then(function(d){(d.libraries||[]).forEach(function(x){e('visitLibrary').appendChild(new Option(x.nama,x.id));});});function load(){LibraryModern.fetchJson(api,{action:'visits',page:page,pageSize:size,query:e('visitQuery').value,libraryId:e('visitLibrary').value}).then(function(d){total=Number(d.total||0);var rows=d.data||[];e('visitInfo').textContent=(d.scope==='aggregate'?'<%=Common.getBahasaConfigJS("Data agregat publik")%>':'<%=Common.getBahasaConfigJS("Data sesuai scope akun")%>')+(total?' · '+total.toLocaleString('id-ID')+' <%=Common.getBahasaConfigJS("baris")%>':'');e('visitRows').innerHTML=rows.length?rows.map(function(x){var member=x.memberName?LibraryModern.escapeHtml(x.memberCode+' — '+x.memberName):(x.count!=null?Number(x.count).toLocaleString('id-ID')+' <%=Common.getBahasaConfigJS("kunjungan")%>':'<%=Common.getBahasaConfigJS("Riwayat Anda")%>');return '<tr><td>'+LibraryModern.escapeHtml(x.date)+'</td><td>'+LibraryModern.escapeHtml(x.library)+'</td><td>'+member+'</td><td>'+LibraryModern.escapeHtml(x.note||'-')+'</td></tr>';}).join(''):'<tr><td colspan="4"><div class="library-state"><%=Common.getBahasaConfigJS("Belum ada data kunjungan.")%></div></td></tr>';e('visitPrev').disabled=page<=1;e('visitNext').disabled=total? page*size>=total : rows.length<size;e('visitPage').textContent='<%=Common.getBahasaConfigJS("Halaman")%> '+page;}).catch(function(){e('visitRows').innerHTML='<tr><td colspan="4"><div class="library-state"><%=Common.getBahasaConfigJS("Data kunjungan belum dapat dimuat.")%></div></td></tr>';});}e('visitApply').addEventListener('click',function(){page=1;load();});e('visitPrev').addEventListener('click',function(){if(page>1){page--;load();}});e('visitNext').addEventListener('click',function(){page++;load();});load();}());</script>

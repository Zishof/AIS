<%@page import="ais.common.Common"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%String root=Common.ROOT;String rnd=Common.getGeneratedBarCode(7);%>
<link rel="stylesheet" href="<%=root%>/assets/library-modern/library.css?v=20260825a"><script src="<%=root%>/assets/library-modern/library.js?v=20260825a"></script>
<section class="library-modern library-page"><div class="library-container"><header class="library-page-head"><div><div class="library-eyebrow">Ledger</div><h1>Denda &amp; Penyelesaian</h1><p class="library-muted">Pembayaran, pembebasan, dan reversal dicatat sebagai peristiwa audit; nilai denda awal tetap dipertahankan.</p></div><button class="library-button" id="fineRefresh<%=rnd%>" type="button">Muat ulang</button></header><article class="library-card library-card-pad"><div class="library-table-wrap"><table class="library-table"><thead><tr><th>Anggota</th><th>Koleksi</th><th>Denda</th><th>Terbayar</th><th>Tindakan</th></tr></thead><tbody id="fineRows<%=rnd%>"></tbody></table></div><div class="library-muted" id="fineInfo<%=rnd%>" aria-live="polite"></div></article></div></section>
<script>(function(){'use strict';var s='<%=rnd%>',api='<%=root%>/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_operations_api',csrf='';function e(x){return document.getElementById(x+s);}function money(v){return Number(v||0).toLocaleString('id-ID');}function load(){LibraryModern.fetchJson(api,{action:'fine_list'}).then(function(d){csrf=d.csrf||csrf;e('fineRows').innerHTML=(d.data||[]).map(function(x){return '<tr><td>'+LibraryModern.escapeHtml(x.member)+'</td><td>'+LibraryModern.escapeHtml(x.item)+'</td><td>Rp '+money(x.assessed)+'</td><td>Rp '+money(x.paid)+(x.settled?' · selesai':'')+'</td><td><button class="library-button" data-fine="fine_payment:'+x.id+'">Bayar</button> <button class="library-button" data-fine="fine_waive:'+x.id+'">Bebaskan</button> <button class="library-button" data-fine="fine_reverse:'+x.id+'">Reversal</button></td></tr>';}).join('')||'<tr><td colspan="5">Belum ada denda.</td></tr>';});}e('fineRows').addEventListener('click',function(v){var raw=v.target.getAttribute('data-fine');if(!raw)return;var p=raw.split(':'),amount=p[0]==='fine_payment'?window.prompt('Nominal pembayaran:','0'):'0',reason=window.prompt('Alasan wajib dicatat:');if(!reason)return;LibraryModern.postJson(api,{action:p[0],id:p[1],amount:amount,reason:reason,nui_csrf:csrf}).then(function(d){csrf=d.csrf||csrf;e('fineInfo').textContent=d.message;load();}).catch(function(x){e('fineInfo').textContent=x.message;});});e('fineRefresh').addEventListener('click',load);load();}());</script>

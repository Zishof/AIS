<%@page import="ais.common.Common"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%String rnd=Common.getGeneratedBarCode(7);String root=Common.ROOT;%>
<link rel="stylesheet" href="<%=root%>/assets/library-modern/library.css"><script src="<%=root%>/assets/library-modern/library.js"></script>
<section class="library-modern library-page"><div class="library-container">
 <header class="library-page-head"><div><div class="library-eyebrow"><%=Common.getBahasaConfig("Sirkulasi")%></div><h1><%=Common.getBahasaConfig("Aktivitas Peminjaman & Pengembalian")%></h1><p class="library-muted"><%=Common.getBahasaConfig("Anggota hanya melihat aktivitas sendiri. Petugas berwenang memperoleh drill-down operasional.")%></p></div><a class="library-button library-button-primary" href="<%=root%>/perpustakaan"><%=Common.getBahasaConfig("Buka workspace petugas")%></a></header>
 <article class="library-card library-card-pad"><div class="library-toolbar"><div class="library-toolbar-field"><label for="circulationType<%=rnd%>"><%=Common.getBahasaConfig("Jenis aktivitas")%></label><select class="library-select" id="circulationType<%=rnd%>"><option value=""><%=Common.getBahasaConfig("Semua aktivitas")%></option><option value="Peminjaman"><%=Common.getBahasaConfig("Peminjaman")%></option><option value="Pengembalian"><%=Common.getBahasaConfig("Pengembalian")%></option></select></div><button class="library-button" id="circulationRefresh<%=rnd%>" type="button"><%=Common.getBahasaConfig("Muat ulang")%></button></div>
 <div class="library-muted" id="circulationInfo<%=rnd%>" aria-live="polite"></div><div class="library-table-wrap"><table class="library-table"><thead><tr><th><%=Common.getBahasaConfig("Waktu")%></th><th><%=Common.getBahasaConfig("Aktivitas")%></th><th><%=Common.getBahasaConfig("Koleksi")%></th><th><%=Common.getBahasaConfig("Anggota")%></th><th></th></tr></thead><tbody id="circulationRows<%=rnd%>"></tbody></table></div><nav class="library-pagination"><button class="library-button" id="circulationPrev<%=rnd%>" type="button"><%=Common.getBahasaConfig("Sebelumnya")%></button><span id="circulationPage<%=rnd%>">1</span><button class="library-button" id="circulationNext<%=rnd%>" type="button"><%=Common.getBahasaConfig("Selanjutnya")%></button></nav></article>
</div></section>
<script>(function(){'use strict';var s='<%=rnd%>',root='<%=root%>',api=root+'/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_workspace_api',page=1,size=20,total=0,all=[];function e(id){return document.getElementById(id+s);}function render(){var type=e('circulationType').value,rows=type?all.filter(function(x){return x.type===type;}):all;e('circulationRows').innerHTML=rows.length?rows.map(function(x){var member=x.memberName?LibraryModern.escapeHtml(x.memberCode+' — '+x.memberName):'<%=Common.getBahasaConfigJS("Sesuai scope akun")%>';return '<tr><td>'+LibraryModern.escapeHtml(x.date)+'</td><td><span class="library-status">'+LibraryModern.escapeHtml(x.type)+'</span></td><td><strong>'+LibraryModern.escapeHtml(x.title)+'</strong><br><span class="library-muted">'+LibraryModern.escapeHtml(x.authors)+'</span></td><td>'+member+'</td><td><a class="library-button" href="'+root+'/pustaka?id='+encodeURIComponent(x.itemId)+'"><%=Common.getBahasaConfigJS("Detail")%></a></td></tr>';}).join(''):'<tr><td colspan="5"><div class="library-state"><%=Common.getBahasaConfigJS("Belum ada aktivitas sirkulasi.")%></div></td></tr>';}function load(){LibraryModern.fetchJson(api,{action:'circulation',page:page,pageSize:size}).then(function(d){all=d.data||[];total=Number(d.total||0);e('circulationInfo').textContent=total.toLocaleString('id-ID')+' <%=Common.getBahasaConfigJS("aktivitas sesuai scope akun")%>';render();e('circulationPrev').disabled=page<=1;e('circulationNext').disabled=page*size>=total;e('circulationPage').textContent='<%=Common.getBahasaConfigJS("Halaman")%> '+page;}).catch(function(err){e('circulationRows').innerHTML='<tr><td colspan="5"><div class="library-state"><strong>'+LibraryModern.escapeHtml(err.message||'<%=Common.getBahasaConfigJS("Silakan masuk untuk melihat aktivitas.")%>')+'</strong></div></td></tr>';});}e('circulationType').addEventListener('change',render);e('circulationRefresh').addEventListener('click',load);e('circulationPrev').addEventListener('click',function(){if(page>1){page--;load();}});e('circulationNext').addEventListener('click',function(){if(page*size<total){page++;load();}});load();}());</script>

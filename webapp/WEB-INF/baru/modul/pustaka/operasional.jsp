<%@page import="ais.common.Common"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%String root=Common.ROOT;String rnd=Common.getGeneratedBarCode(7);boolean admin=Common.getApakahAdmin();%>
<link rel="stylesheet" href="<%=root%>/assets/library-modern/library.css?v=20260821b"><script src="<%=root%>/assets/library-modern/library.js"></script>
<section class="library-modern library-page"><div class="library-container"><header class="library-page-head"><div><div class="library-eyebrow">Workflow</div><h1>Operasional Perpustakaan</h1><p class="library-muted">Satu pusat tindakan untuk serial, stocktake, moderasi, dan layanan personal.</p></div><button class="library-button" id="refresh<%=rnd%>" type="button">Muat ulang</button></header>
<%if(admin){%><div class="library-grid library-grid-3" id="opsCounts<%=rnd%>"></div>
<article class="library-card library-card-pad"><h2>Serial &amp; claiming</h2><div class="library-table-wrap"><table class="library-table"><thead><tr><th>Judul</th><th>Periode</th><th>Terbit berikutnya</th><th>Klaim</th></tr></thead><tbody id="serialRows<%=rnd%>"></tbody></table></div></article>
<article class="library-card library-card-pad"><h2>Stocktake / inventaris</h2><div class="library-toolbar"><input class="library-input" id="stockNote<%=rnd%>" maxlength="180" placeholder="Nama/lokasi sesi"><button class="library-button library-button-primary" id="stockCreate<%=rnd%>" type="button">Buat sesi</button></div><div class="library-toolbar"><input class="library-input" id="stockId<%=rnd%>" type="number" min="1" placeholder="ID sesi"><input class="library-input" id="stockBarcode<%=rnd%>" maxlength="100" placeholder="Scan kode / ISBN"><button class="library-button" id="stockScan<%=rnd%>" type="button">Catat scan</button><button class="library-button" id="stockClose<%=rnd%>" type="button">Tutup sesi</button></div><div id="stockInfo<%=rnd%>" class="library-muted" aria-live="polite"></div><div id="stockSessions<%=rnd%>"></div></article>
<article class="library-card library-card-pad"><h2>Moderasi komentar</h2><div id="commentModeration<%=rnd%>"></div></article><%}%>
<article class="library-card library-card-pad"><h2>Pencarian tersimpan</h2><div class="library-toolbar"><input class="library-input" id="searchLabel<%=rnd%>" maxlength="100" placeholder="Nama pencarian"><input class="library-input" id="searchQuery<%=rnd%>" maxlength="500" placeholder="Kata kunci / parameter"><button class="library-button" id="searchSave<%=rnd%>" type="button">Simpan</button></div><div id="savedSearches<%=rnd%>"></div></article>
<article class="library-card library-card-pad"><h2>Komentar koleksi</h2><div class="library-toolbar"><input class="library-input" id="commentItem<%=rnd%>" type="number" min="1" placeholder="ID item"><input class="library-input" id="commentBody<%=rnd%>" maxlength="240" placeholder="Komentar (menunggu moderasi)"><button class="library-button" id="commentAdd<%=rnd%>" type="button">Kirim</button></div><div id="approvedComments<%=rnd%>"></div></article>
</div></section>
<script>(function(){'use strict';var s='<%=rnd%>',api='<%=root%>/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_operations_api',csrf='',admin=<%=admin%>;function e(x){return document.getElementById(x+s);}function get(a,p){p=p||{};p.action=a;return LibraryModern.fetchJson(api,p).then(function(d){csrf=d.csrf||csrf;return d;});}function post(a,p){p=p||{};p.action=a;p.nui_csrf=csrf;return LibraryModern.postJson(api,p).then(function(d){csrf=d.csrf||csrf;return d;});}function note(m){if(e('stockInfo'))e('stockInfo').textContent=m||'';}function loadPersonal(){get('search_list').then(function(d){e('savedSearches').innerHTML=(d.data||[]).map(function(x){return '<div class="library-action-item"><a href="<%=root%>/baru?p=pustaka&s=katalog&q='+encodeURIComponent(x.query)+'">'+LibraryModern.escapeHtml(x.label)+'</a><button class="library-button" data-remove="'+x.id+'">Hapus</button></div>';}).join('')||'<div class="library-state">Belum ada pencarian tersimpan.</div>';});get('comment_list',{itemId:e('commentItem').value}).then(function(d){e('approvedComments').innerHTML=(d.data||[]).map(function(x){return '<div class="library-action-item"><span><b>'+LibraryModern.escapeHtml(x.item)+'</b><br>'+LibraryModern.escapeHtml(x.comment)+' — '+LibraryModern.escapeHtml(x.author)+'</span></div>';}).join('')||'<div class="library-state">Belum ada komentar terbit.</div>';});}function loadAdmin(){if(!admin)return;get('overview').then(function(d){var c=d.counts||{};e('opsCounts').innerHTML=Object.keys(c).map(function(k){return '<article class="library-card library-card-pad"><span class="library-muted">'+LibraryModern.escapeHtml(k)+'</span><h2>'+Number(c[k]||0).toLocaleString('id-ID')+'</h2></article>';}).join('');});get('serial_list').then(function(d){e('serialRows').innerHTML=(d.data||[]).map(function(x){return '<tr><td>'+LibraryModern.escapeHtml(x.title)+'</td><td>'+LibraryModern.escapeHtml(x.period||'Bulanan')+'</td><td>'+LibraryModern.escapeHtml(x.nextExpected)+'</td><td><button class="library-button" data-claim="'+x.id+'">Klaim</button> <button class="library-button" data-resolve="'+x.id+'">Selesai</button></td></tr>';}).join('')||'<tr><td colspan="4">Belum ada langganan serial.</td></tr>';});get('inventory_list').then(function(d){e('stockSessions').innerHTML=(d.data||[]).map(function(x){return '<div class="library-action-item"><span>'+LibraryModern.escapeHtml(x.code)+' · '+x.scanned+' scan · '+(x.closed?'Ditutup':'Aktif')+'</span><button class="library-button" data-stock="'+x.id+'">Pilih</button></div>';}).join('');});get('comment_list').then(function(d){e('commentModeration').innerHTML=(d.data||[]).filter(function(x){return x.status==='PENDING';}).map(function(x){return '<div class="library-action-item"><span><b>'+LibraryModern.escapeHtml(x.item)+'</b><br>'+LibraryModern.escapeHtml(x.comment)+'</span><span><button class="library-button" data-comment="APPROVED:'+x.id+'">Terbitkan</button> <button class="library-button" data-comment="REJECTED:'+x.id+'">Tolak</button></span></div>';}).join('')||'<div class="library-state">Tidak ada antrean moderasi.</div>';});}function load(){loadPersonal();loadAdmin();}e('searchSave').addEventListener('click',function(){post('search_save',{label:e('searchLabel').value,query:e('searchQuery').value}).then(loadPersonal);});e('savedSearches').addEventListener('click',function(v){var id=v.target.getAttribute('data-remove');if(id)post('search_remove',{id:id}).then(loadPersonal);});e('commentAdd').addEventListener('click',function(){post('comment_add',{itemId:e('commentItem').value,comment:e('commentBody').value}).then(function(d){e('commentBody').value='';loadPersonal();});});if(admin){e('stockCreate').addEventListener('click',function(){post('inventory_create',{note:e('stockNote').value}).then(function(d){e('stockId').value=d.id;note(d.message);loadAdmin();});});e('stockScan').addEventListener('click',function(){post('inventory_scan',{id:e('stockId').value,barcode:e('stockBarcode').value}).then(function(d){note(d.message+' '+d.item.title);e('stockBarcode').value='';e('stockBarcode').focus();loadAdmin();}).catch(function(x){note(x.message);});});e('stockClose').addEventListener('click',function(){post('inventory_close',{id:e('stockId').value}).then(function(d){note(d.message);loadAdmin();});});e('stockSessions').addEventListener('click',function(v){var id=v.target.getAttribute('data-stock');if(id)e('stockId').value=id;});e('serialRows').addEventListener('click',function(v){var id=v.target.getAttribute('data-claim')||v.target.getAttribute('data-resolve');if(!id)return;var reason=window.prompt('Alasan / catatan tindak lanjut:');if(!reason)return;post(v.target.hasAttribute('data-resolve')?'serial_resolve':'serial_claim',{id:id,reason:reason}).then(loadAdmin);});e('commentModeration').addEventListener('click',function(v){var raw=v.target.getAttribute('data-comment');if(!raw)return;var p=raw.split(':');post('comment_moderate',{status:p[0],id:p[1]}).then(loadAdmin);});}e('refresh').addEventListener('click',load);load();}());</script>

<%@page import="ais.common.Common"%><%@page import="ais.common.newui.NewUiCsrfUtil"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%String serviceRnd=Common.getGeneratedBarCode(7);String serviceCsrf=NewUiCsrfUtil.getToken(request.getSession());%>
<link rel="stylesheet" href="<%=Common.ROOT%>/assets/library-modern/library.css?v=20260822b"><script src="<%=Common.ROOT%>/assets/library-modern/library.js?v=20260822b"></script>
<section class="library-modern"><div class="library-container library-page"><header class="library-page-head"><div><span class="library-eyebrow"><%=Common.getBahasaConfig("Layanan anggota")%></span><h1><%=Common.getBahasaConfig("Bantuan, fasilitas, dan pengembangan koleksi")%></h1><p class="library-muted"><%=Common.getBahasaConfig("Semua permintaan dicatat pada entitas AIS yang telah diaudit dan dapat ditindaklanjuti petugas.")%></p></div></header>
<div id="serviceNotice<%=serviceRnd%>" class="library-state-banner" role="status" aria-live="polite" hidden></div>
<div class="library-service-grid">
 <article class="library-card library-card-pad"><h2><i class="fa fa-comments" aria-hidden="true"></i> <%=Common.getBahasaConfig("Tanya Pustakawan")%></h2><p class="library-muted"><%=Common.getBahasaConfig("Bantuan pencarian referensi, sitasi, penelitian, atau konsultasi.")%></p><form data-service-action="help_add"><label><%=Common.getBahasaConfig("Topik")%></label><select class="library-select" name="subject" required><option value="Pencarian referensi"><%=Common.getBahasaConfig("Pencarian referensi")%></option><option value="Bantuan sitasi"><%=Common.getBahasaConfig("Bantuan sitasi")%></option><option value="Konsultasi penelitian"><%=Common.getBahasaConfig("Konsultasi penelitian")%></option><option value="Masalah akses digital"><%=Common.getBahasaConfig("Masalah akses digital")%></option></select><label><%=Common.getBahasaConfig("Uraian")%></label><textarea class="library-input" name="message" rows="4" maxlength="1200" required></textarea><button class="library-button library-button-primary" type="submit"><%=Common.getBahasaConfig("Kirim pertanyaan")%></button></form></article>
 <article class="library-card library-card-pad"><h2><i class="fa fa-book" aria-hidden="true"></i> <%=Common.getBahasaConfig("Usulan Koleksi")%></h2><form data-service-action="acquisition_add"><label><%=Common.getBahasaConfig("Judul")%></label><input class="library-input" name="title" maxlength="180" required><label><%=Common.getBahasaConfig("Penulis")%></label><input class="library-input" name="author" maxlength="140"><label>ISBN</label><input class="library-input" name="isbn" maxlength="40"><label><%=Common.getBahasaConfig("Mata kuliah")%></label><input class="library-input" name="course" maxlength="120"><label><%=Common.getBahasaConfig("Urgensi")%></label><select class="library-select" name="urgency"><option value="NORMAL"><%=Common.getBahasaConfig("Normal")%></option><option value="HIGH"><%=Common.getBahasaConfig("Mendesak untuk penelitian")%></option><option value="COURSE"><%=Common.getBahasaConfig("Wajib mata kuliah")%></option></select><label><%=Common.getBahasaConfig("Tautan penerbit")%></label><input class="library-input" name="publisherUrl" type="url" maxlength="300"><label><%=Common.getBahasaConfig("Alasan")%></label><textarea class="library-input" name="reason" rows="3" maxlength="500" required></textarea><button class="library-button library-button-primary" type="submit"><%=Common.getBahasaConfig("Ajukan usulan")%></button></form></article>
 <article class="library-card library-card-pad"><h2><i class="fa fa-calendar" aria-hidden="true"></i> <%=Common.getBahasaConfig("Booking Fasilitas")%></h2><form data-service-action="booking_add"><label><%=Common.getBahasaConfig("Ruang / fasilitas")%></label><select class="library-select" name="roomId" id="serviceRoom<%=serviceRnd%>" required><option value=""><%=Common.getBahasaConfig("Pilih ruang")%></option></select><label><%=Common.getBahasaConfig("Mulai")%></label><input class="library-input" name="start" type="datetime-local" required><label><%=Common.getBahasaConfig("Selesai")%></label><input class="library-input" name="end" type="datetime-local" required><label><%=Common.getBahasaConfig("Tujuan penggunaan")%></label><textarea class="library-input" name="purpose" rows="3" maxlength="240" required></textarea><button class="library-button library-button-primary" type="submit"><%=Common.getBahasaConfig("Pesan fasilitas")%></button></form></article>
 <article class="library-card library-card-pad"><h2><i class="fa fa-exchange" aria-hidden="true"></i> <%=Common.getBahasaConfig("Pinjam Antarperpustakaan")%></h2><form data-service-action="ill_add"><label><%=Common.getBahasaConfig("Judul / identitas dokumen")%></label><input class="library-input" name="subject" maxlength="120" required><label><%=Common.getBahasaConfig("Detail kebutuhan, sumber, dan tenggat")%></label><textarea class="library-input" name="message" rows="5" maxlength="1200" required></textarea><button class="library-button library-button-primary" type="submit"><%=Common.getBahasaConfig("Ajukan permintaan")%></button></form></article>
</div>
<article class="library-card library-card-pad"><h2><%=Common.getBahasaConfig("Status permintaan saya")%></h2><div class="library-table-wrap"><table class="library-table"><thead><tr><th><%=Common.getBahasaConfig("Layanan")%></th><th><%=Common.getBahasaConfig("Kode")%></th><th><%=Common.getBahasaConfig("Uraian")%></th><th><%=Common.getBahasaConfig("Status")%></th></tr></thead><tbody id="serviceHistory<%=serviceRnd%>"><tr><td colspan="4"><%=Common.getBahasaConfig("Memuat...")%></td></tr></tbody></table></div></article>
</div></section>
<script>(function(){'use strict';var root='<%=Common.ROOT%>',api=root+'/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_engagement_api',csrf='<%=serviceCsrf%>',notice=document.getElementById('serviceNotice<%=serviceRnd%>'),history=document.getElementById('serviceHistory<%=serviceRnd%>');function esc(v){return LibraryModern.escapeHtml(v||'');}function show(m,error){notice.hidden=false;notice.className='library-state-banner is-'+(error?'error':'success');notice.textContent=m;}function get(action){return LibraryModern.fetchJson(api,{action:action});}function load(){get('requests').then(function(d){csrf=d.csrf||csrf;history.innerHTML=(d.data||[]).map(function(x){return '<tr><td>'+esc(x.type)+'</td><td>'+esc(x.code)+'</td><td>'+esc(x.description)+'</td><td><strong>'+esc(x.status)+'</strong></td></tr>';}).join('')||'<tr><td colspan="4"><%=Common.getBahasaConfigJS("Belum ada permintaan.")%></td></tr>';}).catch(function(e){history.innerHTML='<tr><td colspan="4">'+esc(e.message)+'</td></tr>';});}get('references').then(function(d){csrf=d.csrf||csrf;(d.rooms||[]).forEach(function(x){document.getElementById('serviceRoom<%=serviceRnd%>').appendChild(new Option(x.name+(x.capacity?' · '+x.capacity+' orang':''),x.id));});});document.querySelectorAll('[data-service-action]').forEach(function(form){form.onsubmit=function(e){e.preventDefault();var button=form.querySelector('button[type=submit]'),data={action:form.getAttribute('data-service-action'),nui_csrf:csrf};new FormData(form).forEach(function(v,k){data[k]=v;});button.disabled=true;LibraryModern.postJson(api,data).then(function(d){csrf=d.csrf||csrf;show(d.message,false);form.reset();load();}).catch(function(err){show(err.message,true);}).then(function(){button.disabled=false;});};});load();}());</script>

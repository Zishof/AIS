<%@page import="ais.common.Common"%><%@page import="ais.action.master.library.modern.LibraryItemDetailService"%><%@page import="ais.action.master.library.modern.LibraryMemberApi"%><%@page import="ais.action.master.library.modern.LibraryPermissionGuard"%><%@page import="org.apache.commons.lang.StringEscapeUtils"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%
Long readerId=null;try{readerId=Long.valueOf(request.getParameter("id"));}catch(Exception ignored){}LibraryItemDetailService.Detail readerItem=LibraryItemDetailService.find(readerId);boolean readerAuthorized=LibraryMemberApi.isActiveMember(request)||LibraryPermissionGuard.isStaff(request);String readerUrl=readerItem==null?null:(readerItem.getDigitalUrl()!=null?readerItem.getDigitalUrl():readerItem.getEbookUrl());String readerTitle=readerItem==null?Common.getBahasaConfig("Koleksi digital"):StringEscapeUtils.escapeHtml(readerItem.getTitle());String safeReaderUrl=readerUrl==null?"":StringEscapeUtils.escapeHtml(readerUrl);String lowerReader=safeReaderUrl.toLowerCase();
%><link rel="stylesheet" href="<%=Common.ROOT%>/assets/library-modern/library.css?v=20260822b"><section class="library-modern"><div class="library-container library-page"><header class="library-page-head"><div><span class="library-eyebrow"><%=Common.getBahasaConfig("Reader koleksi digital")%></span><h1><%=readerTitle%></h1><p class="library-muted"><%=readerItem==null?Common.getBahasaConfig("Koleksi tidak ditemukan atau berada di luar scope institusi."):StringEscapeUtils.escapeHtml(readerItem.getAuthors())%></p></div><a class="library-button" href="<%=Common.ROOT%>/pustaka?id=<%=readerId==null?"":readerId%>"><%=Common.getBahasaConfig("Kembali ke detail")%></a></header>
<%if(readerItem==null){%><div class="library-card library-state"><strong><%=Common.getBahasaConfig("Koleksi tidak ditemukan")%></strong></div><%}else if(!readerAuthorized){%><div class="library-card library-state"><strong><%=Common.getBahasaConfig("File digital tersedia, tetapi hanya dapat dibaca oleh anggota aktif atau petugas perpustakaan.")%></strong><br><a class="library-button library-button-primary" href="<%=Common.ROOT%>/pustaka?s=login_pustaka"><%=Common.getBahasaConfig("Masuk")%></a></div><%}else if(safeReaderUrl.isEmpty()){%><div class="library-card library-state"><strong><%=Common.getBahasaConfig("File digital belum tersedia")%></strong></div><%}else{%>
<div class="library-reader-tools"><button class="library-button" id="readerBookmark" type="button">☆ <%=Common.getBahasaConfig("Simpan posisi")%></button><label for="readerSpeed"><%=Common.getBahasaConfig("Kecepatan")%></label><select class="library-select" id="readerSpeed"><option>0.75</option><option selected>1</option><option>1.25</option><option>1.5</option><option>2</option></select><a class="library-button" href="<%=safeReaderUrl%>" target="_blank" rel="noopener noreferrer"><%=Common.getBahasaConfig("Buka sumber")%></a></div>
<div class="library-reader" id="readerFrame"><%if(lowerReader.matches(".*\\.(mp3|wav|ogg)(\\?.*)?$")){%><audio controls preload="metadata" src="<%=safeReaderUrl%>"><%=Common.getBahasaConfig("Browser tidak mendukung audio.")%></audio><%}else if(lowerReader.matches(".*\\.(mp4|webm|ogv)(\\?.*)?$")){%><video controls preload="metadata" src="<%=safeReaderUrl%>"><%=Common.getBahasaConfig("Browser tidak mendukung video.")%></video><%}else{%><iframe title="<%=Common.getBahasaConfig("Pembaca dokumen")%>: <%=readerTitle%>" src="<%=safeReaderUrl%>" loading="lazy"></iframe><%}%><span class="library-reader-watermark"><%=StringEscapeUtils.escapeHtml(Common.getCurrentUser(request).getUserId())%></span></div>
<aside class="library-card library-card-pad"><h2><%=Common.getBahasaConfig("Catatan pribadi")%></h2><textarea class="library-input" id="readerNotes" rows="5" maxlength="4000" placeholder="<%=Common.getBahasaConfig("Catatan tersimpan hanya pada perangkat ini.")%>"></textarea><div id="readerStatus" class="library-muted" role="status" aria-live="polite"></div></aside>
<script>(function(){var key='library-reader-<%=readerId%>',media=document.querySelector('#readerFrame audio,#readerFrame video'),notes=document.getElementById('readerNotes'),status=document.getElementById('readerStatus');try{var saved=JSON.parse(localStorage.getItem(key)||'{}');notes.value=saved.notes||'';if(media&&saved.position)media.currentTime=saved.position;}catch(e){}function save(){try{localStorage.setItem(key,JSON.stringify({position:media?media.currentTime:0,notes:notes.value,updatedAt:new Date().toISOString()}));status.textContent='<%=Common.getBahasaConfigJS("Posisi dan catatan disimpan pada perangkat ini.")%>';}catch(e){status.textContent='<%=Common.getBahasaConfigJS("Catatan belum dapat disimpan.")%>';}}document.getElementById('readerBookmark').onclick=save;notes.onchange=save;document.getElementById('readerSpeed').onchange=function(){if(media)media.playbackRate=Number(this.value);};if(media)media.addEventListener('pause',save);}());</script><%}%></div></section>

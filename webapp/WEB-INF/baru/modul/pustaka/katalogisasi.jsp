<%@page import="ais.common.Common"%><%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%String root=Common.ROOT;String rnd=Common.getGeneratedBarCode(7);%>
<link rel="stylesheet" href="<%=root%>/assets/library-modern/library.css?v=20260825a"><script src="<%=root%>/assets/library-modern/library.js?v=20260825a"></script>
<section class="library-modern library-page"><div class="library-container">
 <header class="library-page-head"><div><div class="library-eyebrow">Katalogisasi</div><h1>Impor &amp; Ekspor MARCXML</h1><p class="library-muted">Pratinjau memeriksa duplikasi ISBN atau judul–pengarang sebelum data disimpan. Maksimal 200 record / 2 MB.</p></div></header>
 <article class="library-card library-card-pad"><h2>Penerbitan Katalog Publik</h2><p class="library-muted">Hanya koleksi berstatus Terbit yang dapat ditemukan pada pencarian publik. Periksa jumlah koleksi sebelum menerbitkan.</p><div class="library-actions"><strong id="publicationSummary<%=rnd%>">Memuat status penerbitan...</strong><button class="library-button library-button-primary" id="publishAll<%=rnd%>" type="button" disabled>Publikasikan semua yang belum terbit</button><a class="library-button" href="<%=root%>/pustaka">Buka katalog publik</a></div><div class="library-muted" id="publicationInfo<%=rnd%>" role="status" aria-live="polite"></div></article>
 <article class="library-card library-card-pad"><label for="marcXml<%=rnd%>">MARCXML</label><textarea class="library-input" id="marcXml<%=rnd%>" rows="14" maxlength="2097152" placeholder="Tempel collection/record MARC21 XML di sini"></textarea><div class="library-actions"><button class="library-button" id="preview<%=rnd%>" type="button">Pratinjau</button><button class="library-button library-button-primary" id="import<%=rnd%>" type="button" disabled>Impor record tanpa duplikasi</button></div><div class="library-muted" id="marcInfo<%=rnd%>" aria-live="polite"></div><div class="library-table-wrap"><table class="library-table"><thead><tr><th>Judul</th><th>Pengarang</th><th>ISBN/ISSN</th><th>Tahun</th><th>Status</th></tr></thead><tbody id="marcRows<%=rnd%>"><tr><td colspan="5">Belum ada pratinjau.</td></tr></tbody></table></div></article>
 <article class="library-card library-card-pad"><h2>Ekspor satu record</h2><div class="library-toolbar"><div class="library-toolbar-field"><label for="exportId<%=rnd%>">ID item</label><input class="library-input" id="exportId<%=rnd%>" type="number" min="1"></div><button class="library-button" id="export<%=rnd%>" type="button">Ekspor MARCXML</button></div><textarea class="library-input" id="exportResult<%=rnd%>" rows="8" readonly aria-label="Hasil ekspor"></textarea></article>
</div></section>
<script>(function(){'use strict';var s='<%=rnd%>',api='<%=root%>/pustaka?hanya_tampil_jsp=true&p=pustaka&s=_marc_api',csrf='',ready=false;function e(x){return document.getElementById(x+s);}function rows(d){var a=d.data||[];e('marcRows').innerHTML=a.length?a.map(function(x){return '<tr><td>'+LibraryModern.escapeHtml(x.title)+'</td><td>'+LibraryModern.escapeHtml(x.author||'-')+'</td><td>'+LibraryModern.escapeHtml(x.isbn||x.issn||'-')+'</td><td>'+LibraryModern.escapeHtml(String(x.year||'-'))+'</td><td>'+(x.duplicateCount?'Duplikat ('+x.duplicateCount+')':LibraryModern.escapeHtml(x.status||'Siap'))+'</td></tr>';}).join(''):'<tr><td colspan="5">Tidak ada record.</td></tr>';}function publication(){return LibraryModern.fetchJson(api,{action:'publication_status'}).then(function(d){csrf=d.csrf||csrf;e('publicationSummary').textContent='Total '+Number(d.total||0).toLocaleString('id-ID')+' · Sudah terbit '+Number(d.published||0).toLocaleString('id-ID')+' · Belum terbit '+Number(d.pending||0).toLocaleString('id-ID');e('publishAll').disabled=Number(d.pending||0)<=0;}).catch(function(err){e('publicationSummary').textContent='Status penerbitan tidak dapat dimuat.';e('publicationInfo').textContent=err.message||'';});}function send(action){var b=e(action);b.disabled=true;return LibraryModern.postJson(api,{action:action,xml:e('marcXml').value,nui_csrf:csrf}).then(function(d){csrf=d.csrf||csrf;rows(d);e('marcInfo').textContent=action==='preview'?(d.total+' record · '+d.duplicates+' terindikasi duplikat'):(d.imported+' diimpor · '+d.skipped+' dilewati');ready=action==='preview';e('import').disabled=!ready;}).catch(function(err){e('marcInfo').textContent=err.message;}).then(function(){b.disabled=action==='import'?!ready:false;});}e('preview').addEventListener('click',function(){send('preview');});e('import').addEventListener('click',function(){if(ready)send('import');});e('export').addEventListener('click',function(){LibraryModern.fetchJson(api,{action:'export',itemId:e('exportId').value}).then(function(d){e('exportResult').value=d.xml||'';}).catch(function(err){e('exportResult').value=err.message;});});e('publishAll').addEventListener('click',function(){if(!window.confirm('Publikasikan seluruh koleksi aktif yang belum terbit pada scope perpustakaan ini?'))return;var b=this;b.disabled=true;e('publicationInfo').textContent='Memproses penerbitan...';LibraryModern.postJson(api,{action:'publish_all',nui_csrf:csrf}).then(function(d){csrf=d.csrf||csrf;e('publicationInfo').textContent=d.message||'Penerbitan selesai.';return publication();}).catch(function(err){e('publicationInfo').textContent=err.message||'Penerbitan gagal.';b.disabled=false;});});publication();}());</script>

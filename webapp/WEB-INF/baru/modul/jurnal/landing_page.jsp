<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<c:choose><c:when test="${jurnalView == 'article'}"><title><c:out value="${jurnalArticle.title}"/> — Jurnal Ilmiah eCampus</title><meta name="description" content="<c:out value='${jurnalArticle.abstractText}'/>"><meta name="citation_title" content="<c:out value='${jurnalArticle.title}'/>"><meta name="citation_author" content="<c:out value='${jurnalArticle.authors}'/>"><meta name="citation_doi" content="<c:out value='${jurnalArticle.doi}'/>"><meta name="DC.title" content="<c:out value='${jurnalArticle.title}'/>"><meta name="DC.creator" content="<c:out value='${jurnalArticle.authors}'/>"><meta property="og:type" content="article"><meta property="og:title" content="<c:out value='${jurnalArticle.title}'/>"><meta property="og:description" content="<c:out value='${jurnalArticle.abstractText}'/>"><link rel="canonical" href="${pageContext.request.contextPath}/jurnal/article/${jurnalArticle.id}"></c:when><c:otherwise><title>Jurnal Ilmiah eCampus</title><meta name="description" content="Portal jurnal ilmiah terpadu eCampus"><link rel="canonical" href="${pageContext.request.contextPath}/jurnal"></c:otherwise></c:choose><link rel="alternate" type="application/atom+xml" href="${pageContext.request.contextPath}/jurnal/feed" title="Jurnal Ilmiah eCampus">
<c:if test="${not empty jurnalAnalyticsMeasurementId}"><script async src="https://www.googletagmanager.com/gtag/js?id=${jurnalAnalyticsMeasurementId}"></script><script nonce="${jurnalAnalyticsNonce}">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${jurnalAnalyticsMeasurementId}',{'anonymize_ip':true});</script></c:if><style>:root{--primary:#3347b0;--accent:#087f78;--ink:#17233b;--muted:#60708a;--line:#dfe5ef;--bg:#f5f7fb;--focus:#f59e0b}*{box-sizing:border-box}body{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.6;margin:0;color:var(--ink);background:var(--bg)}header,main,footer{max-width:1120px;margin:auto;padding:24px}.hero{max-width:none;background:linear-gradient(125deg,#172554,var(--primary));color:white}.hero-inner{max-width:1120px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,360px);gap:32px;align-items:center}.hero-copy{min-width:0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}.card,.login-card{background:white;border:1px solid var(--line);border-radius:16px;padding:20px}.login-card{color:var(--ink);box-shadow:0 12px 30px rgba(8,20,58,.22)}.login-card h2{font-size:1.2rem;margin:0 0 4px}.login-card p{font-size:.9rem;margin:0 0 14px}.login-field{display:grid;gap:4px;margin-top:10px}.login-field input{width:100%}.login-actions{display:flex;align-items:center;gap:10px;margin-top:14px}.login-actions button{flex:1}.login-error{background:#fff1f2;border:1px solid #fecdd3;border-radius:8px;color:#9f1239;padding:9px 11px;margin:10px 0}.account-card{display:grid;gap:12px}.account-actions{display:flex;gap:8px;flex-wrap:wrap}.account-link{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #aebbd0;border-radius:8px;padding:8px 12px;text-decoration:none}.account-link-primary{background:var(--accent);border-color:var(--accent);color:#fff}a{color:#233b9f}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--focus);outline-offset:2px}input,button{font:inherit;min-height:44px;border-radius:8px;border:1px solid #aebbd0;padding:8px 12px}button{background:var(--accent);color:#fff}.muted{color:var(--muted)}@media(max-width:760px){.hero-inner{grid-template-columns:1fr}.login-card{max-width:none}}@media(max-width:390px){header,main,footer{padding:16px}.grid{grid-template-columns:1fr}.login-actions{align-items:stretch;flex-direction:column}.login-actions button{width:100%}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}</style></head><body>
<c:url var="jurnalLogoutUrl" value="/logoff"><c:param name="param" value="${pageContext.request.contextPath}/jurnal"/></c:url>
<header class="hero"><div class="hero-inner"><div class="hero-copy"><h1>Jurnal Ilmiah eCampus</h1><p>Pengajuan, review, penerbitan, dan diseminasi ilmiah dalam satu portal.</p><form action="${pageContext.request.contextPath}/jurnal/search" method="get"><label for="journal-search">Cari artikel</label> <input id="journal-search" name="q" type="search" maxlength="200"> <button type="submit">Cari</button></form></div><c:choose><c:when test="${jurnalAuthenticated}"><section class="login-card account-card" aria-labelledby="jurnal-account-title"><div><h2 id="jurnal-account-title">Akun jurnal</h2><p class="muted">Masuk sebagai <strong><c:out value="${jurnalCurrentUserName}"/></strong></p></div><div class="account-actions"><a class="account-link account-link-primary" href="${pageContext.request.contextPath}/jurnal/admin/dashboard">Ruang kerja jurnal</a><a class="account-link" href="${jurnalLogoutUrl}">Keluar</a></div></section></c:when><c:otherwise><section class="login-card" id="jurnal-login" aria-labelledby="jurnal-login-title"><h2 id="jurnal-login-title">Masuk Sistem</h2><p class="muted">Gunakan akun AIS untuk mengakses pengajuan, review, dan pengelolaan jurnal.</p><c:if test="${not empty jurnalLoginError}"><div class="login-error" role="alert"><c:out value="${jurnalLoginError}"/></div></c:if><form action="${pageContext.request.contextPath}/jurnal/login" method="post"><input type="hidden" name="nui_csrf" value="<c:out value='${jurnalLoginCsrf}'/>"><div class="login-field"><label for="jurnal-username">Nomor induk / nama pengguna</label><input id="jurnal-username" name="username" type="text" maxlength="120" autocomplete="username" required></div><div class="login-field"><label for="jurnal-password">Kata sandi</label><input id="jurnal-password" name="password" type="password" maxlength="512" autocomplete="current-password" required></div><div class="login-actions"><button type="submit">Masuk ke Sistem</button></div></form></section></c:otherwise></c:choose></div></header><main>
<c:choose><c:when test="${jurnalView == 'article'}"><article class="card"><h1><c:out value="${jurnalArticle.title}"/></h1><p><c:out value="${jurnalArticle.authors}"/></p><p><c:out value="${jurnalArticle.abstractText}"/></p><c:if test="${not empty jurnalArticle.doi}"><p>DOI: <c:out value="${jurnalArticle.doi}"/></p></c:if><c:if test="${not empty jurnalArticle.galleys}"><h2>Galley</h2><ul><c:forEach items="${jurnalArticle.galleys}" var="g"><li><c:choose><c:when test="${g.viewer == 'file'}"><a href="${pageContext.request.contextPath}/jurnal-file/${g.id}"><c:out value="${g.name}"/></a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/jurnal-galley/${g.viewer}/${g.id}"><c:out value="${g.name}"/></a></c:otherwise></c:choose> (<c:out value="${g.mimeType}"/>)</li></c:forEach></ul></c:if></article></c:when>
<c:when test="${jurnalView == 'announcement'}"><article class="card"><h1><c:out value="${jurnalAnnouncement.title}"/></h1><p><c:out value="${jurnalAnnouncement.abstractText}"/></p></article></c:when>
<c:when test="${jurnalView == 'staticPage'}"><article class="card"><h1><c:out value="${jurnalStaticPage.title}"/></h1><div class="static-page"><c:out value="${jurnalStaticPage.bodyText}"/></div></article></c:when>
<c:when test="${jurnalView == 'issue'}"><article class="card"><h1><c:out value="${jurnalIssue.title}"/></h1><ol><c:forEach items="${jurnalIssue.articles}" var="a"><li><a href="${pageContext.request.contextPath}/jurnal/article/${a.id}"><c:out value="${a.title}"/></a> — <c:out value="${a.authors}"/></li></c:forEach></ol></article></c:when>
<c:when test="${jurnalView == 'journal'}"><h1><c:out value="${jurnalJournal.name}"/></h1><p><c:out value="${jurnalJournal.description}"/></p><c:if test="${jurnalJournal.allowSubmissions}"><p><a href="${pageContext.request.contextPath}/jurnal/admin/submission">Buat pengajuan</a></p></c:if><c:if test="${jurnalAnalyticsConfigured}"><form action="${pageContext.request.contextPath}/jurnal/analytics-consent" method="post"><input type="hidden" name="nui_csrf" value="${jurnalCsrf}"><input type="hidden" name="journal" value="${jurnalJournal.slug}"><span>Analytics opsional:</span> <button name="choice" value="granted" type="submit">Izinkan</button> <button name="choice" value="denied" type="submit">Tolak</button></form></c:if><div class="grid"><c:if test="${not empty jurnalJournal.readerInfo}"><section class="card"><h2>Untuk Pembaca</h2><p><c:out value="${jurnalJournal.readerInfo}"/></p></section></c:if><c:if test="${not empty jurnalJournal.authorInfo}"><section class="card"><h2>Untuk Penulis</h2><p><c:out value="${jurnalJournal.authorInfo}"/></p></section></c:if><c:if test="${not empty jurnalJournal.librarianInfo}"><section class="card"><h2>Untuk Pustakawan</h2><p><c:out value="${jurnalJournal.librarianInfo}"/></p></section></c:if><c:if test="${not empty jurnalJournal.subscriptionInfo}"><section class="card"><h2>Langganan</h2><p><c:out value="${jurnalJournal.subscriptionInfo}"/></p></section></c:if><c:forEach items="${jurnalJournal.customBlocks}" var="b"><section class="card" data-block-key="${b.key}"><h2><c:out value="${b.title}"/></h2><p><c:out value="${b.bodyText}"/></p></section></c:forEach></div><h2>Arsip edisi</h2><div class="grid"><c:forEach items="${jurnalIssues}" var="i"><article class="card"><h3><a href="${pageContext.request.contextPath}/jurnal/issue/${i.id}"><c:out value="${i.title}"/></a></h3></article></c:forEach></div></c:when>
<c:when test="${jurnalView == 'search'}"><h1>Hasil pencarian</h1><p>Kata kunci: <c:out value="${jurnalSearchTerm}"/></p><div class="grid"><c:forEach items="${jurnalSearch}" var="a"><article class="card"><h3><a href="${pageContext.request.contextPath}/jurnal/article/${a.id}"><c:out value="${a.title}"/></a></h3><p><c:out value="${a.authors}"/></p></article></c:forEach></div></c:when>
<c:when test="${jurnalView == 'browse'}"><h1>Jelajah Subjek</h1><nav aria-label="Subjek"><ul><c:forEach items="${jurnalBrowseSubjects}" var="s"><c:url var="browseUrl" value="/jurnal/browse"><c:param name="subject" value="${s.name}"/></c:url><li><a href="${browseUrl}"><c:out value="${s.name}"/></a> (<c:out value="${s.count}"/>)</li></c:forEach></ul></nav><c:if test="${not empty jurnalBrowseSubject}"><h2><c:out value="${jurnalBrowseSubject}"/></h2><div class="grid"><c:forEach items="${jurnalBrowseArticles}" var="a"><article class="card"><h3><a href="${pageContext.request.contextPath}/jurnal/article/${a.id}"><c:out value="${a.title}"/></a></h3><p><c:out value="${a.authors}"/></p></article></c:forEach></div></c:if></c:when>
<c:otherwise><h2>Jurnal</h2><div class="grid"><c:forEach items="${jurnalHome.journals}" var="j"><section class="card"><h3><a href="${pageContext.request.contextPath}/jurnal/journal/${j.slug}"><c:out value="${j.name}"/></a></h3><p class="muted"><c:out value="${j.description}"/></p></section></c:forEach></div>
<h2>Artikel terbaru</h2><div class="grid"><c:forEach items="${jurnalHome.latest}" var="a"><article class="card"><h3><a href="${pageContext.request.contextPath}/jurnal/article/${a.id}"><c:out value="${a.title}"/></a></h3><p><c:out value="${a.authors}"/></p></article></c:forEach></div></c:otherwise></c:choose></main><footer>eCampus Integrated Journal · <a href="${pageContext.request.contextPath}/jurnal/browse">Jelajah</a> · <a href="${pageContext.request.contextPath}/jurnal/feed">Feed</a></footer></body></html>

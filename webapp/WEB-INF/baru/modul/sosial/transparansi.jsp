<%@ page import="org.json.JSONObject" %><% String socialTitle="Transparansi"; %><%@ include file="_header.jspf" %><% JSONObject summary=(JSONObject)request.getAttribute("summary"); %><section class="social-page-head"><div class="social-wrap"><span class="social-eyebrow">Data terkonfirmasi</span><h1>Transparansi Dana Sosial</h1><p>Pending payment tidak dihitung sebagai penerimaan dan draft penyaluran tidak dihitung sebagai dana tersalurkan.</p></div></section><section class="social-section"><div class="social-wrap social-four"><div class="social-kpi"><span>Diterima</span><strong><%=SocialHtml.money(new java.math.BigDecimal(summary.optString("received","0")))%></strong></div><div class="social-kpi"><span>Dialokasikan</span><strong><%=SocialHtml.money(new java.math.BigDecimal(summary.optString("allocated","0")))%></strong></div><div class="social-kpi"><span>Disalurkan</span><strong><%=SocialHtml.money(new java.math.BigDecimal(summary.optString("distributed","0")))%></strong></div><div class="social-kpi"><span>Saldo</span><strong><%=SocialHtml.money(new java.math.BigDecimal(summary.optString("balance","0")))%></strong></div></div></section><section class="social-section alt"><div class="social-wrap narrow"><h2>Metodologi</h2><p>Penerimaan menggunakan transaksi dengan pembayaran server-confirmed. Penyaluran menggunakan detail yang telah approved dan posted. Refund, reversal, dan correction event mengurangi agregat setelah diposting.</p></div></section><%@ include file="_footer.jspf" %>

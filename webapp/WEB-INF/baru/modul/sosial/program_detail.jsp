<%@ page import="ais.action.master.sosial.helper.*" %><% SocialProgramView program=(SocialProgramView)request.getAttribute("program");String socialTitle=program==null?"Program":program.name; %><%@ include file="_header.jspf" %><section class="social-page-head"><div class="social-wrap"><a class="social-link" href="<%=socialBase%>/program">← Semua program</a><div class="social-detail-grid"><article><span class="social-badge"><%=SocialHtml.e(program.fundType)%></span><h1><%=SocialHtml.e(program.name)%></h1><p class="social-lead"><%=SocialHtml.e(program.summary)%></p><% if(program.cover!=null&&!program.cover.isEmpty()){ %><img class="social-detail-cover" src="<%=SocialHtml.e(program.cover)%>" alt="" loading="eager"><% } %><h2>Cerita program</h2><div class="social-prose"><%=SocialHtml.e(program.story)%></div><h2>Penggunaan dan kemajuan dana</h2><p>Dana terkonfirmasi <strong><%=SocialHtml.money(program.collected)%></strong>, telah disalurkan <strong><%=SocialHtml.money(program.distributed)%></strong>, saldo <strong><%=SocialHtml.money(program.balance)%></strong>.</p></article><aside class="social-donate-panel"><span>Dukung program ini</span><strong><%=SocialHtml.money(program.collected)%></strong><small>terkumpul<% if(program.target!=null){ %> dari <%=SocialHtml.money(program.target)%><% } %></small><a class="social-button" href="<%=socialBase%>/checkout?program=<%=program.id%>">Lanjut Pembayaran</a><p class="social-note"><%=program.restricted?"Dana ini bersifat restricted dan hanya disalurkan sesuai tujuan program.":"Penggunaan dana mengikuti kebijakan program dan institusi."%></p></aside></div></div></section><%@ include file="_footer.jspf" %>

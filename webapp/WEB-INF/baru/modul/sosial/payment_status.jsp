<%@ page import="ais.database.model.sosial.PembayaranDonasi" %><% PembayaranDonasi payment=(PembayaranDonasi)request.getAttribute("payment");String socialTitle="Status Pembayaran"; %><%@ include file="_header.jspf" %><section class="social-page-head"><div class="social-wrap narrow"><span class="social-eyebrow">Status server</span><h1>Status Pembayaran</h1><% if(payment==null){ %><div class="social-empty">Payment attempt belum tersedia atau transaksi tidak ditemukan.</div><% }else{ %><div class="social-status" data-transaction="<%=SocialHtml.e(request.getPathInfo().substring("/pembayaran/".length()))%>"><span>Status</span><strong id="payment-state"><%=SocialHtml.e(payment.getPaymentStatus())%></strong><p>Total <%=SocialHtml.money(payment.getTotal())%></p><% if(payment.getPaymentUrl()!=null&&!("PAID".equals(payment.getPaymentStatus()))){ %><a class="social-button" href="<%=SocialHtml.e(payment.getPaymentUrl())%>" rel="noopener">Buka Halaman Pembayaran</a><% } %><p class="social-note">Halaman ini memeriksa status server. Redirect dari gateway tidak otomatis menandai pembayaran berhasil.</p></div><% } %></div></section><%@ include file="_footer.jspf" %>

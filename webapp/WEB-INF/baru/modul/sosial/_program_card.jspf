<article class="social-card program-card"><% if(p.cover!=null&&!p.cover.isEmpty()){ %><img src="<%=SocialHtml.e(p.cover)%>" alt="" loading="lazy"><% }else{ %><div class="social-cover-placeholder" aria-hidden="true">AIS</div><% } %><div class="social-card-body"><span class="social-badge"><%=SocialHtml.e(p.fundType)%></span><h3><a href="<%=socialBase%>/program/<%=SocialHtml.e(p.slug)%>"><%=SocialHtml.e(p.name)%></a></h3><p><%=SocialHtml.e(p.summary)%></p><div class="social-meta"><span><%=SocialHtml.money(p.collected)%> terkumpul</span><% if(p.target!=null){ %><span>dari <%=SocialHtml.money(p.target)%></span><% } %></div><% if(p.target!=null){ int progress=SocialHtml.progress(p.collected,p.target); %><div class="social-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%=progress%>"><span style="width:<%=progress%>%"></span></div><% } %><a class="social-link" href="<%=socialBase%>/program/<%=SocialHtml.e(p.slug)%>">Lihat Program →</a></div></article>

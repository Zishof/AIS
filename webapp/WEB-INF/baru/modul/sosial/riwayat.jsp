<%@ page import="java.util.*,ais.database.model.sosial.TransaksiDonasi" %><% String socialTitle="Riwayat Saya"; %><%@ include file="_header.jspf" %><% List<TransaksiDonasi> rows=(List<TransaksiDonasi>)request.getAttribute("history"); %><section class="social-page-head"><div class="social-wrap"><span class="social-eyebrow">Akun donatur</span><h1>Riwayat Saya</h1></div></section><section class="social-section"><div class="social-wrap"><div class="social-table-wrap"><table class="social-table"><thead><tr><th>Transaksi</th><th>Tanggal</th><th>Nominal</th><th>Status</th><th></th></tr></thead><tbody><% if(rows==null||rows.isEmpty()){ %><tr><td colspan="5">Belum ada transaksi.</td></tr><% }else for(TransaksiDonasi d:rows){ %><tr><td><%=SocialHtml.e(d.getTransactionNumber())%></td><td><%=SocialHtml.e(d.getCreatedAt())%></td><td><%=SocialHtml.money(d.getGrossDonationAmount())%></td><td><span class="social-badge"><%=SocialHtml.e(d.getStatus())%></span></td><td><a href="<%=socialBase%>/pembayaran/<%=SocialHtml.e(d.getTransactionNumber())%>">Rincian</a></td></tr><% } %></tbody></table></div></div></section><%@ include file="_footer.jspf" %>

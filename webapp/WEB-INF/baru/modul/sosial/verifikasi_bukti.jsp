<%@ page import="ais.database.model.sosial.BuktiSetorSosial" %><% BuktiSetorSosial receipt=(BuktiSetorSosial)request.getAttribute("receipt");String socialTitle="Verifikasi Bukti Setor"; %><%@ include file="_header.jspf" %><section class="social-page-head"><div class="social-wrap narrow"><span class="social-eyebrow">Verifikasi publik minimum</span><h1>Bukti Setor <%=receipt.getVoided()?"Tidak Berlaku":"Valid"%></h1><div class="social-card social-card-body"><p>Nomor: <strong><%=SocialHtml.e(receipt.getReceiptNumber())%></strong></p><p>Dibuat: <%=SocialHtml.e(receipt.getGeneratedAt())%></p><p>Jenis: <%=SocialHtml.e(receipt.getReceiptType())%></p><p>Status: <%=SocialHtml.e(receipt.getStatus())%></p><% if(!receipt.getVoided()){ %><a class="social-button" href="<%=request.getContextPath()%>/sosial-receipt-pdf?token=<%=SocialHtml.e(receipt.getVerificationToken())%>">Unduh PDF</a><% } %></div></div></section><%@ include file="_footer.jspf" %>

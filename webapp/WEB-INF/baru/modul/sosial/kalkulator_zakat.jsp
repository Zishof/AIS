<%@ page import="java.util.*,ais.database.model.sosial.JenisZakat" %><% String socialTitle="Kalkulator Zakat"; %><%@ include file="_header.jspf" %><% List<JenisZakat> types=(List<JenisZakat>)request.getAttribute("zakatTypes"); %><section class="social-page-head"><div class="social-wrap narrow"><span class="social-eyebrow">Estimasi berbasis policy</span><h1>Kalkulator Zakat</h1><p>Hasil merupakan panduan perhitungan. Untuk kondisi khusus, hubungi pengelola zakat institusi.</p></div></section><section class="social-section"><div class="social-wrap narrow"><form id="social-calculator" class="social-form" action="<%=request.getContextPath()%>/sosial-api" method="post"><input type="hidden" name="action" value="calculate"><label>Jenis zakat<select name="jenisZakatId" required><option value="">Pilih jenis zakat</option><% if(types!=null)for(JenisZakat z:types){ %><option value="<%=z.getId()%>" data-formula="<%=SocialHtml.e(z.getFormulaKey())%>"><%=SocialHtml.e(z.getNama())%></option><% } %></select></label><label id="social-value-label">Nilai harta atau penghasilan<input name="sourceValue" inputmode="decimal" autocomplete="off" required placeholder="Contoh: 10000000"></label><label>Pengurang yang diperbolehkan <span class="muted">(opsional)</span><input name="deductions" inputmode="decimal" autocomplete="off" placeholder="0"></label><button class="social-button" type="submit">Hitung Zakat</button><div id="calculator-result" class="social-result" aria-live="polite" hidden></div></form></div></section><%@ include file="_footer.jspf" %>

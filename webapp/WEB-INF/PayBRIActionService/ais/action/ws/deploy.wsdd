        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:tanggalBayar" type="tns:string"/>
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:jamBayar" type="tns:string"/>
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:userID" type="tns:string"/>
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:namaCabang" type="tns:string"/>
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:nominalTagihan" type="tns:string"/>

      </operation>
      <operation xmlns:operNS="http://ws.action.ais" xmlns:retNS="http://ws.action.ais" xmlns:rtns="http://model.ws.action.ais" name="reversal" qname="operNS:reversal" returnQName="retNS:reversalReturn" returnType="rtns:Response" soapAction="">
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:nim" type="tns:string"/>
      </operation>
      <operation xmlns:operNS="http://ws.action.ais" xmlns:retNS="http://ws.action.ais" xmlns:rtns="http://model.ws.action.ais" name="inquery" qname="operNS:inquery" returnQName="retNS:inqueryReturn" returnType="rtns:Response" soapAction="">
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:nim" type="tns:string"/>
      </operation>
      <operation xmlns:operNS="http://ws.action.ais" xmlns:retNS="http://ws.action.ais" xmlns:rtns="http://model.ws.action.ais" name="pay" qname="operNS:pay" returnQName="retNS:payReturn" returnType="rtns:Response" soapAction="">
        <parameter xmlns:pns="http://ws.action.ais" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:nim" type="tns:string"/>

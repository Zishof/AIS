        type="java:CIMB3rdParty.BillPaymentWS.CIMB3RdParty_EchoRs"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <arrayMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:ArrayOfBillDetail"
        type="java:CIMB3rdParty.BillPaymentWS.BillDetail[]"
        innerType="cmp-ns:BillDetail" xmlns:cmp-ns="http://CIMB3rdParty/BillPaymentWS"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:PaymentRq"
        type="java:CIMB3rdParty.BillPaymentWS.PaymentRq"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:PaymentRs"
        type="java:CIMB3rdParty.BillPaymentWS.PaymentRs"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:InquiryRq"
        type="java:CIMB3rdParty.BillPaymentWS.InquiryRq"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:BillDetail"
        type="java:CIMB3rdParty.BillPaymentWS.BillDetail"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:CIMB3rdParty_InquiryRs"
        type="java:CIMB3rdParty.BillPaymentWS.CIMB3RdParty_InquiryRs"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:CIMB3rdParty_PaymentRs"
        type="java:CIMB3rdParty.BillPaymentWS.CIMB3RdParty_PaymentRs"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:EchoMessage"
        type="java:java.lang.String"
        serializer="org.apache.axis.encoding.ser.SimpleSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.SimpleDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:CIMB3rdParty_InquiryRq"
        type="java:CIMB3rdParty.BillPaymentWS.CIMB3RdParty_InquiryRq"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""
      />
      <typeMapping
        xmlns:ns="http://CIMB3rdParty/BillPaymentWS"
        qname="ns:CIMB3rdParty_PaymentRq"
        type="java:CIMB3rdParty.BillPaymentWS.CIMB3RdParty_PaymentRq"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle=""

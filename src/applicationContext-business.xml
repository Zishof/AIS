	<bean id="jamPerkuliahanSyncrhonizerProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="60000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="jamPerkuliahanSyncrhonizerProcessor" />

	</bean>


	<bean id="masaPerkuliahanSyncrhonizerProcessor"
		class="ais.action.master.helper.util.MasaPerkuliahanSyncrhonizerProcessor">
	</bean>

	<bean id="masaPerkuliahanSyncrhonizerProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="80000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="masaPerkuliahanSyncrhonizerProcessor" />

	</bean>


	<bean id="reconsilePembayaranHostToHostSyncrhonizerProcessor"
		class="ais.action.master.helper.util.ReconsilePembayaranHostToHostSyncrhonizerProcessor">
	</bean>

	<bean
		id="reconsilePembayaranHostToHostSyncrhonizerProcessorProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="240000" />
		<!-- run every 1 day -->
		<property name="period" value="21600000" />
		<property name="timerTask"
			ref="reconsilePembayaranHostToHostSyncrhonizerProcessor" />

	</bean>


	<bean id="fotoMahasiswaSyncrhonizerProcessor"
		class="ais.action.master.helper.util.FotoMahasiswaSyncrhonizerProcessor">
	</bean>

	<bean id="fotoMahasiswaSyncrhonizerProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="fotoMahasiswaSyncrhonizerProcessor" />

	</bean>


	<bean id="konfigurasiKalenderAkademikProcessor"
		class="ais.action.master.helper.util.KonfigurasiKalenderAkademikProcessor">

<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:security="http://www.springframework.org/schema/security"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-3.0.xsd">



	<bean id="logCleanerProcessor" class="ais.action.master.helper.util.LogCleanerProcessor">
	</bean>

	<bean id="logCleanerProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 day before starting repeated execution -->
		<property name="delay" value="864000000" />
		<!-- run every 10 day -->
		<property name="period" value="864000000" />
		<property name="timerTask" ref="logCleanerProcessor" />

	</bean>

	<bean id="autoNotActivatingMahasiswaS1Processor"
		class="ais.action.master.helper.util.AutoNotActivatingMahasiswaS1Processor">
	</bean>

	<bean id="autoNotActivatingMahasiswaS1ProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 1 hour -->
		<property name="period" value="3600000" />
		<property name="timerTask" ref="autoNotActivatingMahasiswaS1Processor" />

	</bean>
	
	<!-- TAMBAHKAN BEAN INI UNTUK EVALUASI BELANJA -->
	<bean id="evaluasiBelanjaProcessor" class="ais.action.master.helper.util.EvaluasiBelanjaProcessor">
	</bean>
	<bean id="evaluasiBelanjaProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- Mulai setelah 5 menit server jalan -->
		<property name="delay" value="300000" />
		<!-- Berjalan setiap 3 Jam (10800000 ms) -->
		<property name="period" value="10800000" />
		<property name="timerTask" ref="evaluasiBelanjaProcessor" />
	</bean>



	<bean id="autoNotActivatingMahasiswaS2Processor"
		class="ais.action.master.helper.util.AutoNotActivatingMahasiswaS2Processor">
	</bean>

	<bean id="autoNotActivatingMahasiswaS2ProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 1 hour -->
		<property name="period" value="3600000" />
		<property name="timerTask" ref="autoNotActivatingMahasiswaS2Processor" />

	</bean>


	<bean id="autoNotActivatingMahasiswaS3Processor"
		class="ais.action.master.helper.util.AutoNotActivatingMahasiswaS3Processor">
	</bean>

	<bean id="autoNotActivatingMahasiswaS3ProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 1 hour -->
		<property name="period" value="3600000" />
		<property name="timerTask" ref="autoNotActivatingMahasiswaS3Processor" />

	</bean>


	<bean id="autoNotActivatingMahasiswaSemuaJenjangProcessor"
		class="ais.action.master.helper.util.AutoNotActivatingMahasiswaSemuaJenjangProcessor">
	</bean>

	<bean id="autoNotActivatingMahasiswaSemuaJenjangProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 1 hour -->
		<property name="period" value="3600000" />
		<property name="timerTask"
			ref="autoNotActivatingMahasiswaSemuaJenjangProcessor" />

	</bean>


	<bean id="tunggakanMahasiswaDaftarUlangProcessor"
		class="ais.action.master.helper.util.TunggakanMahasiswaDaftarUlangProcessor">
	</bean>

	<bean id="tunggakanMahasiswaDaftarUlangProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="1200000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="tunggakanMahasiswaDaftarUlangProcessor" />

	</bean>


	<bean id="jamPerkuliahanSyncrhonizerProcessor"
		class="ais.action.master.helper.util.JamPerkuliahanSyncrhonizerProcessor">

	<bean id="konfigurasiKalenderAkademikProcessorScheduledTask"
		class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="360000" />
		<!-- run every 1 hour -->
		<property name="period" value="3600000" />
		<property name="timerTask" ref="konfigurasiKalenderAkademikProcessor" />

	</bean>


	<bean id="radiusProcessor" class="ais.action.master.helper.util.RadiusProcessor">
	</bean>

	<bean id="radiusProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="360000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="radiusProcessor" />

	</bean>



	<bean id="loginCleanerProcessor" class="ais.action.master.helper.util.LoginCleanerProcessor">
	</bean>

	<bean id="loginCleanerProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="360000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="loginCleanerProcessor" />

	</bean>

	<bean id="googleBookSynchronized" class="ais.action.master.helper.util.GoogleBookSynchronized">
	</bean>

	<bean id="googleBookSynchronizedScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="10000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="googleBookSynchronized" />

	</bean>

	<bean id="authorImporterProcessor" class="ais.action.master.helper.util.AuthorImporterProcessor">
	</bean>

	<bean id="authorImporterProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->

	</bean>

	<bean id="itemImporterProcessor" class="ais.action.master.helper.util.ItemImporterProcessor">
	</bean>

	<bean id="itemImporterProcessorScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="50000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="itemImporterProcessor" />

	</bean>

	<bean id="ipaymuBackandProsess" class="ais.action.master.ipaymu.IpaymuBackandProsess">
	</bean>
	<bean id="ipaymuBackandProsessScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 10 minute -->
		<property name="period" value="60000" />
		<property name="timerTask" ref="ipaymuBackandProsess" />

	</bean>
	
	
	<bean id="briBackandProsess" class="ais.action.master.bri.BriBackandProsess">
	</bean>
	<bean id="briBackandProsessScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="100000" />
		<!-- run every 10 minute -->
		<property name="period" value="30000" />
		<property name="timerTask" ref="briBackandProsess" />

	</bean>
	
	
	<bean id="faspayBackandProsess" class="ais.action.master.faspay.FaspayBackandProsess">
	</bean>
	<bean id="faspayBackandProsessScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 10 seconds before starting repeated execution -->
		<property name="delay" value="300000" />
		<!-- run every 10 minute -->
		<property name="period" value="900000" />
		<property name="timerTask" ref="faspayBackandProsess" />

	</bean>
	
	<bean id="userOnlineProsess" class="ais.action.master.helper.UserOnlineCounter">
	</bean>
	<bean id="userOnlineScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 1 seconds before starting repeated execution -->
		<property name="delay" value="60000" />
		<!-- run every 1 minute -->
		<property name="period" value="60000" />
		<property name="timerTask" ref="userOnlineProsess" />

	</bean>
	
	<bean id="pembersihProsess" class="ais.action.master.helper.PembersihDataScheduller">
	</bean>
	<bean id="pembersihScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 1 seconds before starting repeated execution -->
		<property name="delay" value="60000" />
		<!-- run every 3 minute -->
		<property name="period" value="600000" />
		<property name="timerTask" ref="pembersihProsess" />

	</bean>
	
	<bean id="userhapusmedia" class="ais.action.master.helper.HapusMediaSheduler">
	</bean>
	<bean id="userhapusmediaScheduledTask" class="org.springframework.scheduling.timer.ScheduledTimerTask">
		<!-- wait 1 seconds before starting repeated execution -->
		<property name="delay" value="60000" />
		<!-- run every 1 day -->
		<property name="period" value="86400000" />
		<property name="timerTask" ref="userhapusmedia" />

	</bean>

	<bean id="timerFactory" class="org.springframework.scheduling.timer.TimerFactoryBean">
		<property name="scheduledTimerTasks">
			<list>
				<!-- see the example above -->
				<ref bean="userhapusmediaScheduledTask" />
				<ref bean="evaluasiBelanjaProcessorScheduledTask" />
				<ref bean="faspayBackandProsessScheduledTask" />
				<ref bean="ipaymuBackandProsessScheduledTask" />
				<ref bean="briBackandProsessScheduledTask" />
				<ref bean="logCleanerProcessorScheduledTask" />
				<ref bean="autoNotActivatingMahasiswaS1ProcessorScheduledTask" />
				<ref bean="autoNotActivatingMahasiswaS2ProcessorScheduledTask" />
				<ref bean="autoNotActivatingMahasiswaS3ProcessorScheduledTask" />
				<ref bean="autoNotActivatingMahasiswaSemuaJenjangProcessorScheduledTask" />
				<ref bean="tunggakanMahasiswaDaftarUlangProcessorScheduledTask" />
				<ref bean="jamPerkuliahanSyncrhonizerProcessorScheduledTask" />
				<ref bean="masaPerkuliahanSyncrhonizerProcessorScheduledTask" />
				<ref bean="fotoMahasiswaSyncrhonizerProcessorScheduledTask" />
				<ref bean="konfigurasiKalenderAkademikProcessorScheduledTask" />
				<ref bean="radiusProcessorScheduledTask" />
				<ref bean="loginCleanerProcessorScheduledTask" />
				<ref bean="googleBookSynchronizedScheduledTask" />
				<ref bean="authorImporterProcessorScheduledTask" />
				<ref bean="itemImporterProcessorScheduledTask" />
				<ref bean="userOnlineScheduledTask" />
				<ref bean="pembersihScheduledTask" />
				<ref
					bean="reconsilePembayaranHostToHostSyncrhonizerProcessorProcessorScheduledTask" />
			</list>
		</property>
	</bean>


</beans>
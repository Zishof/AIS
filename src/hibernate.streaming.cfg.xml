		<!-- CATATAN AUDIT STREAMING: AuditListener tetap dipertahankan agar logic lama tidak berubah. Jika upload/download/save file masih berat, evaluasi listener ini agar tidak membaca isi BLOB. -->
		<event type="post-insert">
			<listener class="ais.database.hibernate.AuditListener" />
		</event>
		<event type="post-update">
			<listener class="ais.database.hibernate.AuditListener" />
		</event>
		<event type="post-delete">
			<listener class="ais.database.hibernate.AuditListener" />
		</event>


